<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repo-pinned package sources. Central Package Management (CPM) is enabled
    (see Directory.Build.props / Directory.Packages.props), which requires an
    explicit package source mapping — otherwise every project emits NU1507.

    Both feeds are mapped to "*" so restore behaves exactly as it did with the
    machine-level config (try nuget.org, fall back to the Portima Azure Artifacts
    feed), just made reproducible and mapping-complete. Credentials for the
    tfsportima feed continue to come from the machine-level NuGet config /
    credential provider.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="tfsportima" value="https://pkgs.dev.azure.com/tfsportima/_packaging/tfsportima/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="tfsportima">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
