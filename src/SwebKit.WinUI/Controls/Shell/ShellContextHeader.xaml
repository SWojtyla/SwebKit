<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SwebKit.WinUI.Controls.Shell.ShellContextHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:shell="using:SwebKit.WinUI.Controls.Shell"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource SwebKitSurfaceCardStyle}">
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Spacing="8">
                <TextBlock Text="{Binding CurrentAreaGroupLabel}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                <TextBlock Text="{Binding CurrentAreaTitle}"
                           Style="{StaticResource SwebKitPageTitleTextBlockStyle}"/>
                <TextBlock Text="{Binding CurrentAreaSummary}"
                           Style="{StaticResource SwebKitPageSubtitleTextBlockStyle}"/>

                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Border Style="{StaticResource SwebKitShellBadgeStyle}"
                            Visibility="{Binding CurrentConnectionVisibility}">
                        <TextBlock Text="{Binding CurrentConnectionLabel}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </Border>

                    <Border Style="{StaticResource SwebKitShellBadgeStyle}"
                            Visibility="{Binding ProductionBadgeVisibility}">
                        <TextBlock Text="Production"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </Border>

                    <Border Style="{StaticResource SwebKitShellBadgeStyle}"
                            Visibility="{Binding DemoBadgeVisibility}">
                        <TextBlock Text="Demo"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="8"
                        VerticalAlignment="Top">
                <Button Content="{Binding WorkspaceButtonLabel}"
                        Style="{StaticResource SwebKitShellActionButtonStyle}">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <shell:WorkspaceHubPanel DataContext="{Binding ElementName=Root, Path=DataContext}"/>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Content="{Binding NotificationButtonLabel}"
                        Style="{StaticResource SwebKitShellActionButtonStyle}">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight"
                                Opening="NotificationFlyout_Opening">
                            <shell:NotificationHistoryPanel DataContext="{Binding ElementName=Root, Path=DataContext}"/>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Content="Command palette (Ctrl+K)"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="CommandPaletteButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>