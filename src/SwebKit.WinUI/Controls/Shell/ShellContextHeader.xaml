<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SwebKit.WinUI.Controls.Shell.ShellContextHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:shell="using:SwebKit.WinUI.Controls.Shell"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource SwebKitInsetCardStyle}">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="32"
                        Height="32"
                        CornerRadius="8"
                        Background="{ThemeResource SwebKitSurfaceCardBackgroundBrush}"
                        BorderBrush="{ThemeResource SwebKitSurfaceCardBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Image Width="20"
                           Height="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                        <Image.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/SwebKitLogo.svg"/>
                        </Image.Source>
                    </Image>
                </Border>

                <StackPanel Grid.Column="1"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <TextBlock Text="SwebKit"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="/"
                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                        <TextBlock Text="{Binding CurrentAreaTitle}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Border Style="{StaticResource SwebKitShellBadgeStyle}"
                                Visibility="{Binding CurrentConnectionVisibility}">
                            <TextBlock Text="{Binding CurrentConnectionLabel}"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Border>

                        <Border Style="{StaticResource SwebKitShellBadgeStyle}"
                                Visibility="{Binding ProductionBadgeVisibility}">
                            <TextBlock Text="Production"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Border>

                        <Border Style="{StaticResource SwebKitShellBadgeStyle}"
                                Visibility="{Binding DemoBadgeVisibility}">
                            <TextBlock Text="Demo"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource SwebKitShellIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding WorkspaceButtonLabel}">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <shell:WorkspaceHubPanel DataContext="{Binding ElementName=Root, Path=DataContext}"/>
                        </Flyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE8A9;"/>
                </Button>

                <Button Style="{StaticResource SwebKitShellIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding NotificationButtonLabel}">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight"
                                Opening="NotificationFlyout_Opening">
                            <shell:NotificationHistoryPanel DataContext="{Binding ElementName=Root, Path=DataContext}"/>
                        </Flyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE7F4;"/>
                </Button>

                <Button Style="{StaticResource SwebKitShellIconButtonStyle}"
                        ToolTipService.ToolTip="Command palette (Ctrl+K)"
                        Click="CommandPaletteButton_Click">
                    <FontIcon Glyph="&#xE721;"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>