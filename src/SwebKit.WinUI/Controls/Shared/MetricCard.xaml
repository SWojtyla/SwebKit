<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SwebKit.WinUI.Controls.Shared.MetricCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource SwebKitSurfaceCardStyle}">
        <StackPanel Spacing="6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextWrapping="WrapWholeWords"/>

                <TextBlock x:Name="GlyphTextBlock"
                           Grid.Column="1"
                           Text="{Binding Glyph, ElementName=Root}"
                           FontSize="18"
                           VerticalAlignment="Top"/>
            </Grid>

            <TextBlock Text="{Binding ValueText, ElementName=Root}"
                       Style="{StaticResource SwebKitMetricValueTextBlockStyle}"/>

            <TextBlock x:Name="ValueLabelTextBlock"
                       Text="{Binding ValueLabel, ElementName=Root}"
                       Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <TextBlock x:Name="DetailTextBlock"
                       Text="{Binding DetailText, ElementName=Root}"
                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                       TextWrapping="WrapWholeWords"/>

            <TextBlock x:Name="TimestampTextBlock"
                       Text="{Binding TimestampText, ElementName=Root}"
                       Visibility="{Binding TimestampVisibility, ElementName=Root}"
                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>

            <ContentPresenter x:Name="FooterPresenter"
                              Content="{Binding FooterContent, ElementName=Root}"/>
        </StackPanel>
    </Border>
</UserControl>