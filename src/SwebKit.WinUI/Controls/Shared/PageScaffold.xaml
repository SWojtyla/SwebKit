<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SwebKit.WinUI.Controls.Shared.PageScaffold"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="{StaticResource SwebKitPagePadding}"
          RowSpacing="{StaticResource SwebKitPageSectionSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="{StaticResource SwebKitPageSectionSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="{StaticResource SwebKitPageHeaderSpacing}">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Style="{StaticResource SwebKitPageTitleTextBlockStyle}"/>
                <TextBlock x:Name="SubtitleTextBlock"
                           Text="{Binding Subtitle, ElementName=Root}"
                           Style="{StaticResource SwebKitPageSubtitleTextBlockStyle}"/>
            </StackPanel>

            <ContentPresenter x:Name="HeaderPresenter"
                              Grid.Column="1"
                              Content="{Binding HeaderContent, ElementName=Root}"
                              VerticalAlignment="Top"/>
        </Grid>

        <ContentPresenter Grid.Row="1"
                          Content="{Binding BodyContent, ElementName=Root}"/>
    </Grid>
</UserControl>