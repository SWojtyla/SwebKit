<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SwebKit.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:shellControls="using:SwebKit.WinUI.Controls.Shell"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SwebKit">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource SwebKitShellWindowBackgroundBrush}">

        <NavigationView
            x:Name="NavView"
            Background="{ThemeResource SwebKitShellChromeBackgroundBrush}"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneOpen="{x:Bind ViewModel.IsNavExpanded, Mode=TwoWay}"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="dashboard"
                                    Content="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="service-bus"
                                    Content="Service Bus">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AB;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="aks"
                                    Content="AKS">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="redis"
                                    Content="Redis">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF1C7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="storage"
                                    Content="Storage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xED43;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="pipelines"
                                    Content="Pipelines">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="observability"
                                    Content="Observability">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="incident-timeline"
                                    Content="Incident Timeline">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="settings"
                                    Content="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="16,12,16,16"
                  RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <shellControls:ShellBannerStrip
                    Grid.Row="0"
                    DataContext="{x:Bind ShellChrome, Mode=OneWay}"/>

                <shellControls:ShellContextHeader
                    x:Name="ShellHeader"
                    Grid.Row="1"
                    DataContext="{x:Bind ShellChrome, Mode=OneWay}"
                    CommandPaletteRequested="ShellHeader_CommandPaletteRequested"/>

                <Frame x:Name="ContentFrame"
                       Grid.Row="2"
                       Background="{ThemeResource SwebKitPageBackgroundBrush}"/>

                <shellControls:ShellStatusStrip
                    Grid.Row="3"
                    DataContext="{x:Bind ShellChrome, Mode=OneWay}"/>
            </Grid>

        </NavigationView>

    </Grid>

</Window>
