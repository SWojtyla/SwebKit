<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SwebKitShellBadgeStyle"
           TargetType="Border">
        <Setter Property="CornerRadius"
                Value="999"/>
        <Setter Property="Background"
                Value="{ThemeResource SwebKitSurfaceInsetBackgroundBrush}"/>
        <Setter Property="BorderBrush"
                Value="{ThemeResource SwebKitSurfaceCardBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Padding"
                Value="8,2"/>
    </Style>

    <Style x:Key="SwebKitShellActionButtonStyle"
           TargetType="Button">
        <Setter Property="Padding"
                Value="10,6"/>
        <Setter Property="HorizontalAlignment"
                Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Left"/>
    </Style>

    <Style x:Key="SwebKitShellIconButtonStyle"
           TargetType="Button">
        <Setter Property="Width"
                Value="36"/>
        <Setter Property="Height"
                Value="36"/>
        <Setter Property="MinWidth"
                Value="36"/>
        <Setter Property="Padding"
                Value="0"/>
        <Setter Property="HorizontalAlignment"
                Value="Center"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
    </Style>
</ResourceDictionary>