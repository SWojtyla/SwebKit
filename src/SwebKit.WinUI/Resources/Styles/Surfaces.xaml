<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SwebKitSurfaceCardStyle"
           TargetType="Border">
        <Setter Property="CornerRadius"
                Value="{StaticResource SwebKitSurfaceCornerRadius}"/>
        <Setter Property="Background"
                Value="{ThemeResource SwebKitSurfaceCardBackgroundBrush}"/>
        <Setter Property="BorderBrush"
                Value="{ThemeResource SwebKitSurfaceCardBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Padding"
                Value="{StaticResource SwebKitSurfaceCardPadding}"/>
    </Style>

    <Style x:Key="SwebKitInsetCardStyle"
           TargetType="Border">
        <Setter Property="CornerRadius"
                Value="{StaticResource SwebKitInsetCornerRadius}"/>
        <Setter Property="Background"
                Value="{ThemeResource SwebKitSurfaceInsetBackgroundBrush}"/>
        <Setter Property="BorderBrush"
                Value="{ThemeResource SwebKitSurfaceCardBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Padding"
                Value="{StaticResource SwebKitInsetCardPadding}"/>
    </Style>
</ResourceDictionary>