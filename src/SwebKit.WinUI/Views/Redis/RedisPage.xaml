<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SwebKit.WinUI.Views.Redis.RedisPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:SwebKit.WinUI.Controls.Shared"
    xmlns:viewModels="using:SwebKit.WinUI.ViewModels.Redis"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    Background="{ThemeResource SwebKitPageBackgroundBrush}">

    <shared:PageScaffold
        Title="Redis">
        <shared:PageScaffold.BodyContent>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Style="{StaticResource SwebKitSurfaceCardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Spacing="6">
                                <TextBlock
                                    Text="Cache"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                                <ComboBox
                                    ItemsSource="{Binding CacheEntries}"
                                    SelectedItem="{Binding SelectedCache, Mode=TwoWay}"
                                    DisplayMemberPath="DisplayName"
                                    PlaceholderText="Select cache"
                                    IsEnabled="{Binding CanChangeCache}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="6">
                                <TextBlock
                                    Text="Pattern"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBox
                                    Text="{Binding PatternInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="*"
                                    IsEnabled="{Binding CanEditPatternInput}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Spacing="6">
                                <TextBlock
                                    Text="Group by"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBox
                                    Text="{Binding SeparatorInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    MaxLength="4"
                                    PlaceholderText="-"
                                    IsEnabled="{Binding CanEditSeparatorInput}"/>
                            </StackPanel>

                            <ProgressRing
                                Grid.Column="3"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Bottom"
                                IsActive="{Binding IsWorking}"/>

                            <Button
                                Grid.Column="4"
                                Content="Refresh"
                                Command="{Binding ReloadCommand}"
                                IsEnabled="{Binding CanReload}"
                                VerticalAlignment="Bottom"/>
                        </Grid>

                        <Grid Grid.Row="1"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding ScanSummary}"
                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                TextWrapping="WrapWholeWords"
                                VerticalAlignment="Center"/>

                            <Button
                                Grid.Column="1"
                                Content="{Binding LoadMoreKeysLabel}"
                                Command="{Binding LoadMoreKeysCommand}"
                                IsEnabled="{Binding CanLoadMoreKeys}"
                                VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <Button Content="{Binding SelectionModeButtonLabel}"
                                        Command="{Binding ToggleSelectionModeCommand}"
                                        IsEnabled="{Binding CanToggleSelectionMode}"/>

                                <Button Content="Select all loaded"
                                        Command="{Binding SelectAllLoadedCommand}"
                                        IsEnabled="{Binding CanSelectAllLoaded}"/>

                                <Button Content="Clear selection"
                                        Command="{Binding ClearSelectionCommand}"
                                        IsEnabled="{Binding CanClearSelection}"/>

                                <Button Content="Export JSON"
                                        Command="{Binding ExportLoadedKeysCommand}"
                                        IsEnabled="{Binding CanExportLoadedKeys}"/>

                                <Button Content="{Binding DeleteSelectedKeysLabel}"
                                        Command="{Binding DeleteSelectedKeysCommand}"
                                        IsEnabled="{Binding CanDeleteSelectedKeys}"/>

                                <TextBlock Text="{Binding SelectionSummaryText}"
                                           Visibility="{Binding SelectionSummaryVisibility}"
                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3"
                                    Spacing="8">
                            <InfoBar
                                IsOpen="{Binding ShowBulkDeleteConfirmation}"
                                Severity="Warning"
                                Title="Production bulk delete confirmation"
                                Message="Type CONFIRM before deleting selected keys from a production profile."/>

                            <TextBox
                                Text="{Binding BulkDeleteConfirmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Type CONFIRM"
                                Visibility="{Binding BulkDeleteConfirmationVisibility}"/>

                            <TextBlock
                                Text="{Binding ErrorMessage}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Visibility="{Binding ErrorVisibility}"
                                TextWrapping="WrapWholeWords"/>

                            <InfoBar
                                IsOpen="{Binding ShowNotConfiguredState}"
                                Severity="Informational"
                                Title="Redis is not configured"
                                Message="Configure at least one Redis cache connection in Settings before opening this workspace."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Style="{StaticResource SwebKitSurfaceCardStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock
                                Text="Key browser"
                                Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>

                            <InfoBar
                                Grid.Row="1"
                                IsOpen="{Binding ShowTreeEmptyState}"
                                Severity="Informational"
                                Title="No keys found"
                                Message="Refresh with a broader pattern or verify that the selected cache contains keys."/>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding TreeRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:RedisTreeRowViewModel">
                                            <Border
                                                Margin="0,0,0,8"
                                                CornerRadius="6"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="8,6">
                                                <Grid ColumnSpacing="8"
                                                      Margin="{x:Bind IndentMargin}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                                                            Content="{x:Bind ExpandGlyph}"
                                                            Visibility="{x:Bind ExpandVisibility}"
                                                            Command="{Binding ViewModel.ToggleTreeRowCommand, ElementName=PageRoot}"
                                                            CommandParameter="{x:Bind}"
                                                            Padding="0"
                                                            MinWidth="28"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind DisplayName}"
                                                               TextWrapping="WrapWholeWords"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="Selected"
                                                               Visibility="{x:Bind SelectedVisibility}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind SelectionStatusText}"
                                                               Visibility="{x:Bind SelectionStatusVisibility}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="WrapWholeWords"/>

                                                    <Border Grid.Column="3"
                                                            Visibility="{x:Bind KeyTypeVisibility}"
                                                            CornerRadius="999"
                                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                                            Padding="8,2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind KeyType}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="3"
                                                               Text="{x:Bind PrefixCountLabel}"
                                                               Visibility="{x:Bind PrefixCountVisibility}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <Button Grid.Column="4"
                                                            Content="{x:Bind SelectionActionLabel}"
                                                            Visibility="{x:Bind SelectionActionVisibility}"
                                                            Command="{Binding ViewModel.ToggleTreeSelectionCommand, ElementName=PageRoot}"
                                                            CommandParameter="{x:Bind}"/>

                                                    <Button Grid.Column="4"
                                                            Content="Inspect"
                                                            Visibility="{x:Bind InspectVisibility}"
                                                            Command="{Binding ViewModel.SelectTreeKeyCommand, ElementName=PageRoot}"
                                                            CommandParameter="{x:Bind}"/>

                                                    <Button Grid.Column="4"
                                                            Content="Filter"
                                                            Visibility="{x:Bind FilterVisibility}"
                                                            Command="{Binding ViewModel.FilterByPrefixCommand, ElementName=PageRoot}"
                                                            CommandParameter="{x:Bind}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Row="3"
                                    Content="{Binding LoadMoreKeysLabel}"
                                    Command="{Binding LoadMoreKeysCommand}"
                                    IsEnabled="{Binding CanLoadMoreKeys}"/>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource SwebKitSurfaceCardStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Spacing="4">
                                        <TextBlock
                                            Text="{Binding DetailTitle}"
                                            Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                        <TextBlock
                                            Text="{Binding DetailStatusText}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"/>
                                    </StackPanel>

                                    <ProgressRing Grid.Column="1"
                                                  Width="20"
                                                  Height="20"
                                                  IsActive="{Binding IsDetailLoading}"
                                                  VerticalAlignment="Top"/>
                                </Grid>

                                <InfoBar Grid.Row="1"
                                         IsOpen="{Binding ShowSelectionEmptyState}"
                                         Severity="Informational"
                                         Title="No key selected"
                                         Message="Choose a key from the browser to load metadata, TTL, and type-specific value details."/>

                                <TextBlock Grid.Row="2"
                                           Text="Loading key details..."
                                           Visibility="{Binding DetailLoadingVisibility}"
                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>

                                <StackPanel Grid.Row="3"
                                            Spacing="12"
                                            Visibility="{Binding DetailContentVisibility}">
                                    <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Spacing="4">
                                                    <TextBlock Text="Type"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding SelectedTypeText}"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Spacing="4">
                                                    <TextBlock Text="TTL"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding SelectedTtlText}"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            Spacing="4">
                                                    <TextBlock Text="Memory"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding SelectedMemoryText}"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="1"
                                                  ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Spacing="4">
                                                    <TextBlock Text="Encoding"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding SelectedEncodingText}"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               TextWrapping="WrapWholeWords"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Spacing="4">
                                                    <TextBlock Text="Frequency"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding SelectedFrequencyText}"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            Spacing="4">
                                                    <TextBlock Text="Idle"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding SelectedIdleText}"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Content="Refresh key"
                                                        Command="{Binding RefreshSelectedKeyCommand}"
                                                        IsEnabled="{Binding CanRefreshSelectedKey}"/>

                                                <TextBox Grid.Column="1"
                                                         Text="{Binding RenameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="Rename key"/>

                                                <Button Grid.Column="2"
                                                        Content="Rename"
                                                        Command="{Binding RenameSelectedKeyCommand}"
                                                        IsEnabled="{Binding CanRenameSelectedKey}"/>

                                                <Button Grid.Column="3"
                                                        Content="{Binding DeleteSelectedLabel}"
                                                        Command="{Binding DeleteSelectedKeyCommand}"
                                                        IsEnabled="{Binding CanDeleteSelectedKey}"/>

                                                <Button Grid.Column="4"
                                                        Content="Cancel"
                                                        Command="{Binding CancelDeleteSelectedCommand}"
                                                        Visibility="{Binding DeleteSelectedCancelVisibility}"/>
                                            </Grid>

                                            <Grid Grid.Row="1"
                                                  ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <NumberBox Grid.Column="0"
                                                           Value="{Binding TtlEditorSeconds, Mode=TwoWay}"
                                                           Minimum="1"
                                                           SmallChange="30"
                                                           SpinButtonPlacementMode="Inline"/>

                                                <Button Grid.Column="1"
                                                        Content="Set TTL"
                                                        Command="{Binding ApplyTtlCommand}"
                                                        IsEnabled="{Binding CanApplyTtl}"/>

                                                <Button Grid.Column="2"
                                                        Content="Remove TTL"
                                                        Command="{Binding RemoveTtlCommand}"
                                                        IsEnabled="{Binding CanRemoveTtl}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SwebKitInsetCardStyle}"
                                            Visibility="{Binding StringSectionVisibility}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="String value"
                                                       Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>

                                            <InfoBar IsOpen="{Binding IsSelectedStringBinary}"
                                                     Severity="Warning"
                                                     Title="Binary content"
                                                     Message="This string looks binary, so inline editing is disabled for safety."/>

                                            <TextBox Text="{Binding SelectedStringEditorValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="180"
                                                     Visibility="{Binding StringEditorVisibility}"/>

                                            <Button Content="Save value"
                                                    Command="{Binding SaveStringValueCommand}"
                                                    IsEnabled="{Binding CanSaveStringValue}"
                                                    Visibility="{Binding StringEditorVisibility}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SwebKitInsetCardStyle}"
                                            Visibility="{Binding HashSectionVisibility}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Hash fields"
                                                       Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>

                                            <InfoBar IsOpen="{Binding ShowHashEmptyState}"
                                                     Severity="Informational"
                                                     Title="No hash fields loaded"
                                                     Message="Use the editor below to add the first field to this hash."/>

                                            <ItemsControl ItemsSource="{Binding HashFields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:RedisHashFieldItemViewModel">
                                                        <Border Margin="0,0,0,8"
                                                                CornerRadius="6"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                Padding="10">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="220"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Field}"
                                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                           TextWrapping="WrapWholeWords"/>

                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind Value}"
                                                                           TextWrapping="WrapWholeWords"/>

                                                                <Button Grid.Column="2"
                                                                        Content="Edit"
                                                                        Command="{Binding ViewModel.BeginEditHashFieldCommand, ElementName=PageRoot}"
                                                                        CommandParameter="{x:Bind}"/>

                                                                <Button Grid.Column="3"
                                                                        Content="Delete"
                                                                        Command="{Binding ViewModel.DeleteHashFieldCommand, ElementName=PageRoot}"
                                                                        CommandParameter="{x:Bind}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBox Grid.Column="0"
                                                         Text="{Binding HashFieldEditorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="Field name"/>

                                                <TextBox Grid.Column="1"
                                                         Text="{Binding HashFieldEditorValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="Field value"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"/>

                                                <Button Grid.Column="2"
                                                        Content="Upsert field"
                                                        Command="{Binding UpsertHashFieldCommand}"
                                                        IsEnabled="{Binding CanUpsertHashField}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SwebKitInsetCardStyle}"
                                            Visibility="{Binding CollectionSectionVisibility}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{Binding CollectionSectionTitle}"
                                                       Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                            <TextBlock Text="{Binding CollectionSectionStatus}"
                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                       TextWrapping="WrapWholeWords"/>

                                            <ItemsControl ItemsSource="{Binding CollectionItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8"
                                                                CornerRadius="6"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                Padding="10">
                                                            <TextBlock Text="{Binding}"
                                                                       TextWrapping="WrapWholeWords"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="{Binding LoadMoreItemsLabel}"
                                                    Command="{Binding LoadMoreItemsCommand}"
                                                    IsEnabled="{Binding CanLoadMoreItems}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SwebKitInsetCardStyle}"
                                            Visibility="{Binding SortedSetSectionVisibility}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Sorted set members"
                                                       Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                            <TextBlock Text="{Binding SortedSetStatus}"
                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                       TextWrapping="WrapWholeWords"/>

                                            <ItemsControl ItemsSource="{Binding SortedSetEntries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:RedisSortedSetEntryItemViewModel">
                                                        <Border Margin="0,0,0,8"
                                                                CornerRadius="6"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                Padding="10">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="140"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Member}"
                                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                           TextWrapping="WrapWholeWords"/>

                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind ScoreText}"
                                                                           VerticalAlignment="Center"/>

                                                                <Button Grid.Column="2"
                                                                        Content="Edit"
                                                                        Command="{Binding ViewModel.BeginEditSortedSetEntryCommand, ElementName=PageRoot}"
                                                                        CommandParameter="{x:Bind}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBox Grid.Column="0"
                                                         Text="{Binding SortedSetMemberEditor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="Member"/>

                                                <NumberBox Grid.Column="1"
                                                           Value="{Binding SortedSetScoreEditor, Mode=TwoWay}"
                                                           SmallChange="1"
                                                           SpinButtonPlacementMode="Inline"/>

                                                <Button Grid.Column="2"
                                                        Content="Update score"
                                                        Command="{Binding ApplySortedSetScoreCommand}"
                                                        IsEnabled="{Binding CanApplySortedSetScore}"/>
                                            </Grid>

                                            <Button Content="{Binding LoadMoreItemsLabel}"
                                                    Command="{Binding LoadMoreItemsCommand}"
                                                    IsEnabled="{Binding CanLoadMoreItems}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Spacing="4">
                                                    <TextBlock Text="Keyspace health"
                                                               Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding HealthCoverageText}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                    <TextBlock Text="{Binding HealthSignalText}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                </StackPanel>

                                                <ProgressRing Grid.Column="1"
                                                              Width="20"
                                                              Height="20"
                                                              IsActive="{Binding IsAnalyzingHealth}"
                                                              VerticalAlignment="Top"/>

                                                <Button Grid.Column="2"
                                                        Content="Analyze"
                                                        Command="{Binding AnalyzeKeyspaceHealthCommand}"
                                                        IsEnabled="{Binding CanAnalyzeHealth}"
                                                        VerticalAlignment="Top"/>
                                            </Grid>

                                            <InfoBar IsOpen="{Binding ShowHealthEmptyState}"
                                                     Severity="Informational"
                                                     Title="Health analysis not loaded"
                                                     Message="Run Analyze to inspect TTL, size, prefix, and hot-key risk signals for the currently loaded keys."/>

                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        Visibility="{Binding HealthFiltersVisibility}">
                                                <Button Content="{Binding HealthAllFilterLabel}"
                                                        Command="{Binding ShowAllHealthFindingsCommand}"/>
                                                <Button Content="{Binding HealthCriticalFilterLabel}"
                                                        Command="{Binding FilterCriticalHealthFindingsCommand}"/>
                                                <Button Content="{Binding HealthWarningFilterLabel}"
                                                        Command="{Binding FilterWarningHealthFindingsCommand}"/>
                                                <Button Content="{Binding HealthInfoFilterLabel}"
                                                        Command="{Binding FilterInfoHealthFindingsCommand}"/>
                                            </StackPanel>

                                            <InfoBar IsOpen="{Binding ShowFilteredHealthEmptyState}"
                                                     Severity="Informational"
                                                     Title="No findings in this filter"
                                                     Message="The current health severity filter does not match any loaded finding."/>

                                            <ItemsControl ItemsSource="{Binding HealthFindings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:RedisHealthFindingItemViewModel">
                                                        <Border Margin="0,0,0,8"
                                                                CornerRadius="6"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                Padding="10">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120"/>
                                                                    <ColumnDefinition Width="140"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind SeverityText}"
                                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>

                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind RiskTypeText}"
                                                                           VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="{x:Bind Finding.Target}"
                                                                           TextWrapping="WrapWholeWords"
                                                                           VerticalAlignment="Center"/>

                                                                <StackPanel Grid.Column="3"
                                                                            Spacing="2">
                                                                    <TextBlock Text="{x:Bind Finding.Reason}"
                                                                               TextWrapping="WrapWholeWords"/>
                                                                    <TextBlock Text="{x:Bind MetricsText}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                               TextWrapping="WrapWholeWords"/>
                                                                </StackPanel>

                                                                <Button Grid.Column="4"
                                                                        Content="Open key"
                                                                        Visibility="{x:Bind OpenKeyVisibility}"
                                                                        Command="{Binding ViewModel.OpenHealthFindingCommand, ElementName=PageRoot}"
                                                                        CommandParameter="{x:Bind}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Spacing="4">
                                                    <TextBlock Text="Memory by prefix"
                                                               Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding PrefixMemorySummaryText}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                </StackPanel>

                                                <ProgressRing Grid.Column="1"
                                                              Width="20"
                                                              Height="20"
                                                              IsActive="{Binding IsAnalyzingMemory}"
                                                              VerticalAlignment="Top"/>

                                                <Button Grid.Column="2"
                                                        Content="Analyze"
                                                        Command="{Binding AnalyzePrefixMemoryCommand}"
                                                        IsEnabled="{Binding CanAnalyzePrefixMemory}"
                                                        VerticalAlignment="Top"/>
                                            </Grid>

                                            <InfoBar IsOpen="{Binding ShowPrefixMemoryEmptyState}"
                                                     Severity="Informational"
                                                     Title="Prefix analysis not loaded"
                                                     Message="Run Analyze to inspect memory distribution across the currently loaded key prefixes."/>

                                            <ItemsControl ItemsSource="{Binding PrefixMemoryBuckets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:PrefixMemoryBucketItemViewModel">
                                                        <Border Margin="0,0,0,8"
                                                                CornerRadius="6"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                Padding="10">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="200"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="90"/>
                                                                    <ColumnDefinition Width="110"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Prefix}"
                                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                           TextWrapping="WrapWholeWords"
                                                                           VerticalAlignment="Center"/>

                                                                <ProgressBar Grid.Column="1"
                                                                             Minimum="0"
                                                                             Maximum="100"
                                                                             Value="{x:Bind Percentage}"
                                                                             Height="12"
                                                                             VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="{x:Bind PercentageText}"
                                                                           VerticalAlignment="Center"/>

                                                                <StackPanel Grid.Column="3"
                                                                            Spacing="2">
                                                                    <TextBlock Text="{x:Bind TotalBytesText}"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{x:Bind KeyCountText}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Ops insights"
                                                       Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>

                                            <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    Spacing="4">
                                                            <TextBlock Text="Slowlog and hot keys"
                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                            <TextBlock Text="{Binding SlowLogSummaryText}"
                                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                       TextWrapping="WrapWholeWords"/>
                                                        </StackPanel>

                                                        <ProgressRing Grid.Column="1"
                                                                      Width="20"
                                                                      Height="20"
                                                                      IsActive="{Binding IsLoadingSlowLog}"
                                                                      VerticalAlignment="Top"/>

                                                        <Button Grid.Column="2"
                                                                Content="Refresh"
                                                                Command="{Binding LoadSlowLogCommand}"
                                                                IsEnabled="{Binding CanLoadSlowLog}"
                                                                VerticalAlignment="Top"/>
                                                    </Grid>

                                                    <InfoBar IsOpen="{Binding ShowSlowLogEmptyState}"
                                                             Severity="Informational"
                                                             Title="Slowlog not loaded"
                                                             Message="Refresh slowlog to inspect expensive Redis commands and execution timing."/>

                                                    <ItemsControl ItemsSource="{Binding SlowLogEntries}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:RedisSlowLogEntryItemViewModel">
                                                                <Border Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="10">
                                                                    <StackPanel Spacing="4">
                                                                        <Grid ColumnSpacing="12">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="170"/>
                                                                                <ColumnDefinition Width="110"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{x:Bind ExecutedAtText}"
                                                                                       VerticalAlignment="Center"/>

                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{x:Bind DurationText}"
                                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                                       VerticalAlignment="Center"/>

                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{x:Bind CommandText}"
                                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Grid>

                                                                        <TextBlock Text="{x:Bind ArgumentsText}"
                                                                                   TextWrapping="WrapWholeWords"/>

                                                                        <TextBlock Text="{x:Bind ClientNameText}"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                   TextWrapping="WrapWholeWords"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <InfoBar IsOpen="{Binding ShowHotKeySignalsEmptyState}"
                                                             Severity="Informational"
                                                             Title="Hot-key signals"
                                                             Message="Refresh slowlog to correlate recent expensive commands with loaded key metadata."/>

                                                    <ItemsControl ItemsSource="{Binding HotKeySignals}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:RedisHotKeySignalItemViewModel">
                                                                <Border Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="10">
                                                                    <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="200"/>
                                                                            <ColumnDefinition Width="180"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{x:Bind Signal.Key}"
                                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                                   TextWrapping="WrapWholeWords"
                                                                                   VerticalAlignment="Center"/>

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{x:Bind Signal.SignalSource}"
                                                                                   TextWrapping="WrapWholeWords"
                                                                                   VerticalAlignment="Center"/>

                                                                        <StackPanel Grid.Column="2"
                                                                                    Spacing="2">
                                                                            <TextBlock Text="{x:Bind Signal.Explanation}"
                                                                                       TextWrapping="WrapWholeWords"/>
                                                                            <TextBlock Text="{x:Bind MetricsText}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                       TextWrapping="WrapWholeWords"/>
                                                                        </StackPanel>

                                                                        <Button Grid.Column="3"
                                                                                Content="Open key"
                                                                                Command="{Binding ViewModel.OpenHotKeySignalCommand, ElementName=PageRoot}"
                                                                                CommandParameter="{x:Bind}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    Spacing="4">
                                                            <TextBlock Text="Pub/Sub"
                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                            <TextBlock Text="{Binding PubSubSummaryText}"
                                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                       TextWrapping="WrapWholeWords"/>
                                                        </StackPanel>

                                                        <ProgressRing Grid.Column="1"
                                                                      Width="20"
                                                                      Height="20"
                                                                      IsActive="{Binding IsLoadingPubSub}"
                                                                      VerticalAlignment="Top"/>

                                                        <Button Grid.Column="2"
                                                                Content="Refresh"
                                                                Command="{Binding LoadPubSubCommand}"
                                                                IsEnabled="{Binding CanLoadPubSub}"
                                                                VerticalAlignment="Top"/>
                                                    </Grid>

                                                    <InfoBar IsOpen="{Binding ShowPubSubEmptyState}"
                                                             Severity="Informational"
                                                             Title="Pub/Sub snapshot not loaded"
                                                             Message="Refresh Pub/Sub to inspect active channels and subscriber counts."/>

                                                    <ItemsControl ItemsSource="{Binding PubSubChannels}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:RedisPubSubChannelItemViewModel">
                                                                <Border Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="10">
                                                                    <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="160"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{x:Bind Channel}"
                                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                                   TextWrapping="WrapWholeWords"/>

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{x:Bind SubscriberCountText}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </shared:PageScaffold.BodyContent>
    </shared:PageScaffold>
</Page>