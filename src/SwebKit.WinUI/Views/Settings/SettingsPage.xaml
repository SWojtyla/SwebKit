<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SwebKit.WinUI.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:SwebKit.WinUI.Controls.Shared"
    xmlns:vm="using:SwebKit.WinUI.ViewModels.Settings"
    Background="{ThemeResource SwebKitPageBackgroundBrush}">

    <shared:PageScaffold
        Title="Settings"
        IsHeaderCompact="True">
        <shared:PageScaffold.HeaderContent>
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock
                    Text="Unsaved changes"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay}"/>

                <Button
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    IsEnabled="{x:Bind ViewModel.IsDirty, Mode=OneWay}"/>
            </StackPanel>
        </shared:PageScaffold.HeaderContent>

        <shared:PageScaffold.ContextContent>
            <Border Style="{StaticResource SwebKitInsetCardStyle}">
                <TextBlock
                    Text="Configure shell theme, startup warmup, and safety defaults while the broader settings surface continues to migrate into native WinUI workspaces."
                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                    TextWrapping="WrapWholeWords"/>
            </Border>
        </shared:PageScaffold.ContextContent>

        <shared:PageScaffold.BodyContent>
            <ScrollViewer>
                <StackPanel MaxWidth="820"
                            Spacing="16">

                    <shared:SectionCard Title="Appearance"
                                        Description="Choose the curated shell theme used across the native WinUI workspace.">
                        <shared:SectionCard.BodyContent>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                    <TextBlock Text="Theme"
                                               Style="{StaticResource BodyTextBlockStyle}"/>
                                    <TextBlock
                                        Text="Theme changes apply immediately after save so shell chrome and work surfaces stay aligned."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                        TextWrapping="Wrap"
                                        MaxWidth="520"/>
                                </StackPanel>

                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="220"
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                    SelectedValuePath="Key"
                                    SelectedValue="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                                    DisplayMemberPath="Label"/>
                            </Grid>
                        </shared:SectionCard.BodyContent>
                    </shared:SectionCard>

                    <shared:SectionCard Title="Runtime defaults"
                                        Description="Shape how the WinUI host starts up and how parity work is exercised when live backends are not the focus.">
                        <shared:SectionCard.BodyContent>
                            <StackPanel Spacing="12">
                                <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">
                                            <TextBlock Text="Warm up connections on startup"
                                                       Style="{StaticResource BodyTextBlockStyle}"/>
                                            <TextBlock
                                                Text="Pre-connect to Service Bus, AKS, and Redis when SwebKit starts so native pages reach working state faster."
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                TextWrapping="Wrap"
                                                MaxWidth="520"/>
                                        </StackPanel>

                                        <ToggleSwitch
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            OnContent=""
                                            OffContent=""
                                            IsOn="{x:Bind ViewModel.WarmupConnectionsOnStartup, Mode=TwoWay}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">
                                            <TextBlock Text="Demo mode"
                                                       Style="{StaticResource BodyTextBlockStyle}"/>
                                            <TextBlock
                                                Text="Use synthetic data across the migrated WinUI workspaces so the shell, dashboard, and native pages can be validated without live services."
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                TextWrapping="Wrap"
                                                MaxWidth="520"/>
                                        </StackPanel>

                                        <ToggleSwitch
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            OnContent=""
                                            OffContent=""
                                            IsOn="{x:Bind ViewModel.IsDemoModeEnabled, Mode=TwoWay}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </shared:SectionCard.BodyContent>
                    </shared:SectionCard>

                    <shared:SectionCard Title="Safety"
                                        Description="Keep destructive workflows explicit when the current profile points at production resources.">
                        <shared:SectionCard.BodyContent>
                            <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                        <TextBlock Text="Production environment"
                                                   Style="{StaticResource BodyTextBlockStyle}"/>
                                        <TextBlock
                                            Text="Enable extra confirmation dialogs for destructive actions such as DLQ resubmit or delete. Production prompts still require typing CONFIRM."
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="Wrap"
                                            MaxWidth="520"/>
                                    </StackPanel>

                                    <ToggleSwitch
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        OnContent=""
                                        OffContent=""
                                        IsOn="{x:Bind ViewModel.IsProduction, Mode=TwoWay}"/>
                                </Grid>
                            </Border>
                        </shared:SectionCard.BodyContent>
                    </shared:SectionCard>

                    <shared:StateView
                        Title="Settings migration is still in progress"
                        Message="Domain-specific settings continue to land in their parity waves. This page now owns the shell-wide defaults that the remaining native pages depend on."
                        Glyph="i"/>
                </StackPanel>
            </ScrollViewer>
        </shared:PageScaffold.BodyContent>
    </shared:PageScaffold>

</Page>
