<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SwebKit.WinUI.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:SwebKit.WinUI.Controls.Shared"
    xmlns:vm="using:SwebKit.WinUI.ViewModels.Settings"
    Background="{ThemeResource SwebKitPageBackgroundBrush}">

    <shared:PageScaffold
        Title="Settings"
        Subtitle="Configure shell theme, startup warmup, and safety defaults while the broader settings surface continues to migrate.">
        <shared:PageScaffold.BodyContent>
            <ScrollViewer>
                <StackPanel MaxWidth="720"
                            Spacing="{StaticResource SwebKitPageSectionSpacing}">

                    <TextBlock
                        Text="Appearance"
                        Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>

                    <Border Style="{StaticResource SwebKitSurfaceCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Theme"
                                           Style="{StaticResource BodyTextBlockStyle}"/>
                                <TextBlock
                                    Text="Choose a curated shell theme for the WinUI host."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="220"
                                VerticalAlignment="Center"
                                ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                SelectedValuePath="Key"
                                SelectedValue="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                                DisplayMemberPath="Label"/>
                        </Grid>
                    </Border>

                    <TextBlock
                        Text="General"
                        Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>

                    <Border Style="{StaticResource SwebKitSurfaceCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Warm up connections on startup"
                                           Style="{StaticResource BodyTextBlockStyle}"/>
                                <TextBlock
                                    Text="Pre-connect to Service Bus, AKS, and Redis when SwebKit starts."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                OnContent=""
                                OffContent=""
                                IsOn="{x:Bind ViewModel.WarmupConnectionsOnStartup, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <TextBlock
                        Text="Safety"
                        Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>

                    <Border Style="{StaticResource SwebKitSurfaceCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Production environment"
                                           Style="{StaticResource BodyTextBlockStyle}"/>
                                <TextBlock
                                    Text="Enables extra confirmation dialogs for destructive operations (e.g. DLQ resubmit/delete). Requires typing CONFIRM."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                    TextWrapping="Wrap"
                                    MaxWidth="480"/>
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                OnContent=""
                                OffContent=""
                                IsOn="{x:Bind ViewModel.IsProduction, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Unsaved changes"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay}"/>

                        <Button
                            Grid.Column="1"
                            Content="Save"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveCommand}"
                            IsEnabled="{x:Bind ViewModel.IsDirty, Mode=OneWay}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </shared:PageScaffold.BodyContent>
    </shared:PageScaffold>

</Page>
