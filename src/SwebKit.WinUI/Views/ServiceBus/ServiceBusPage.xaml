<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SwebKit.WinUI.Views.ServiceBus.ServiceBusPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SwebKit.Core.Models"
    xmlns:viewModels="using:SwebKit.WinUI.ViewModels.ServiceBus"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24,16,24,24"
          RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                Text="Service Bus"
                Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock
                Text="Connect namespaces, explore queues and subscriptions, and open active or DLQ workspaces from one native WinUI surface."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"/>
        </StackPanel>

        <Border
            Grid.Row="1"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="16">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="Add namespace"
                    Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBox
                    PlaceholderText="Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=..."
                    Text="{Binding ConnectionStringInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding CanMutate}"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding ErrorMessage}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"/>

                    <Button
                        Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding ReloadCommand}"
                        IsEnabled="{Binding CanMutate}"/>

                    <Button
                        Grid.Column="2"
                        Content="Add"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding AddNamespaceCommand}"
                        IsEnabled="{Binding CanMutate}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2"
              ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Namespaces"
                                Style="{StaticResource BodyStrongTextBlockStyle}"/>

                            <ProgressRing
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                IsActive="{Binding IsLoading}"/>
                        </Grid>

                        <InfoBar
                            IsOpen="{Binding ShowEmptyState}"
                            Severity="Informational"
                            Title="No namespaces connected"
                            Message="Add a namespace connection string to start browsing queues and subscriptions."/>

                        <ItemsControl ItemsSource="{Binding Namespaces}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ServiceBusNamespaceItemViewModel">
                                    <Border
                                        Margin="0,0,0,12"
                                        CornerRadius="8"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Padding="12">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Spacing="4">
                                                    <TextBlock Text="{x:Bind Alias}"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <TextBlock Text="{x:Bind FullyQualifiedNamespace}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{x:Bind StatusText}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="1"
                                                    Content="Remove"
                                                    Command="{x:Bind RemoveCommand}"
                                                    VerticalAlignment="Top"/>
                                            </Grid>

                                            <ProgressRing IsActive="{x:Bind IsEntityLoading}"
                                                          Width="20"
                                                          Height="20"/>

                                            <TextBlock Text="{x:Bind EntityLoadError}"
                                                       Visibility="{x:Bind HasEntityLoadError, Mode=OneWay}"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       TextWrapping="Wrap"/>

                                            <InfoBar
                                                IsOpen="{x:Bind ShowEntityEmptyState, Mode=OneWay}"
                                                Severity="Informational"
                                                Title="No entities found"
                                                Message="If you expect queues or topics here, verify the namespace and that the connection string has Manage rights."/>

                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Queues"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <ItemsControl ItemsSource="{x:Bind Queues}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:ServiceBusEntityItemViewModel">
                                                            <Border
                                                                Margin="0,0,0,8"
                                                                CornerRadius="6"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                Padding="10">
                                                                <StackPanel Spacing="8">
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0"
                                                                                    Spacing="2">
                                                                            <TextBlock Text="{x:Bind Name}"
                                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                            <TextBlock Text="{x:Bind ActiveCountText}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                            <TextBlock Text="{x:Bind DeadLetterCountText}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                            <TextBlock Text="{x:Bind StatusText}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                        </StackPanel>

                                                                        <Button Grid.Column="1"
                                                                                Content="Active"
                                                                                Command="{x:Bind OpenActiveCommand}"
                                                                                IsEnabled="{x:Bind SupportsMessageModes}"/>
                                                                        <Button Grid.Column="2"
                                                                                Content="DLQ"
                                                                                Command="{x:Bind OpenDlqCommand}"
                                                                                IsEnabled="{x:Bind SupportsMessageModes}"/>
                                                                        <Button Grid.Column="3"
                                                                                Content="{x:Bind ToggleEnabledLabel}"
                                                                                Command="{x:Bind ToggleEnabledCommand}"/>
                                                                    </Grid>

                                                                    <TextBlock Text="{x:Bind OperationMessage}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                               TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Topics"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <ItemsControl ItemsSource="{x:Bind Topics}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:ServiceBusEntityItemViewModel">
                                                            <Border
                                                                Margin="0,0,0,8"
                                                                CornerRadius="6"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                Padding="10">
                                                                <StackPanel Spacing="8">
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0"
                                                                                    Spacing="2">
                                                                            <TextBlock Text="{x:Bind Name}"
                                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                            <TextBlock Text="{x:Bind StatusText}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                        </StackPanel>

                                                                        <Button Grid.Column="1"
                                                                                Content="{x:Bind ExpandCollapseLabel}"
                                                                                Command="{x:Bind ToggleExpandedCommand}"/>
                                                                        <Button Grid.Column="2"
                                                                                Content="{x:Bind ToggleEnabledLabel}"
                                                                                Command="{x:Bind ToggleEnabledCommand}"/>
                                                                    </Grid>

                                                                    <TextBlock Text="{x:Bind OperationMessage}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                               TextWrapping="Wrap"/>

                                                                    <StackPanel Margin="20,0,0,0"
                                                                                Spacing="8"
                                                                                Visibility="{x:Bind ShowChildren, Mode=OneWay}">
                                                                        <ProgressRing IsActive="{x:Bind IsLoadingChildren}"
                                                                                      Width="20"
                                                                                      Height="20"/>

                                                                        <TextBlock Text="{x:Bind ChildLoadError}"
                                                                                   Visibility="{x:Bind HasChildLoadError, Mode=OneWay}"
                                                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                                   TextWrapping="Wrap"/>

                                                                        <InfoBar
                                                                            IsOpen="{x:Bind ShowEmptyChildrenState, Mode=OneWay}"
                                                                            Severity="Informational"
                                                                            Title="No subscriptions found"
                                                                            Message="This topic has no subscriptions available to browse."/>

                                                                        <ItemsControl ItemsSource="{x:Bind Children}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="viewModels:ServiceBusEntityItemViewModel">
                                                                                    <Border
                                                                                        Margin="0,0,0,8"
                                                                                        CornerRadius="6"
                                                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                                        BorderThickness="1"
                                                                                        Padding="10">
                                                                                        <StackPanel Spacing="8">
                                                                                            <Grid ColumnSpacing="8">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                </Grid.ColumnDefinitions>

                                                                                                <StackPanel Grid.Column="0"
                                                                                                            Spacing="2">
                                                                                                    <TextBlock Text="{x:Bind Name}"
                                                                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                                                    <TextBlock Text="{x:Bind ActiveCountText}"
                                                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                                                    <TextBlock Text="{x:Bind DeadLetterCountText}"
                                                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                                                    <TextBlock Text="{x:Bind StatusText}"
                                                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                                                </StackPanel>

                                                                                                <Button Grid.Column="1"
                                                                                                        Content="Active"
                                                                                                        Command="{x:Bind OpenActiveCommand}"
                                                                                                        IsEnabled="{x:Bind SupportsMessageModes}"/>
                                                                                                <Button Grid.Column="2"
                                                                                                        Content="DLQ"
                                                                                                        Command="{x:Bind OpenDlqCommand}"
                                                                                                        IsEnabled="{x:Bind SupportsMessageModes}"/>
                                                                                                <Button Grid.Column="3"
                                                                                                        Content="{x:Bind ToggleEnabledLabel}"
                                                                                                        Command="{x:Bind ToggleEnabledCommand}"/>
                                                                                            </Grid>

                                                                                            <TextBlock Text="{x:Bind OperationMessage}"
                                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                                       TextWrapping="Wrap"/>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Column="1"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="16">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="12">
                    <StackPanel Grid.Row="0"
                                Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Workspaces"
                                Style="{StaticResource BodyStrongTextBlockStyle}"/>

                            <Button
                                Grid.Column="1"
                                Content="Send"
                                Click="SendActiveMessage_Click"
                                IsEnabled="{Binding CanSendActiveMessage}"/>

                            <Button
                                Grid.Column="2"
                                Content="Resubmit DLQ"
                                Command="{Binding ResubmitSelectedDeadLetterCommand}"
                                IsEnabled="{Binding CanResubmitSelectedDeadLetter}"/>

                            <Button
                                Grid.Column="3"
                                Content="Complete DLQ"
                                Command="{Binding CompleteSelectedDeadLetterCommand}"
                                IsEnabled="{Binding CanCompleteSelectedDeadLetter}"/>

                            <Button
                                Grid.Column="4"
                                Content="Refresh current"
                                Command="{Binding RefreshActiveTabCommand}"
                                IsEnabled="{Binding CanRefreshActiveTab}"/>
                        </Grid>

                        <InfoBar
                            IsOpen="{Binding ShowTabEmptyState}"
                            Severity="Informational"
                            Title="No entity open"
                            Message="Open Active or DLQ for a queue or subscription from the left pane."/>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ServiceBusTabViewModel">
                                        <Border
                                            Margin="0,0,8,0"
                                            CornerRadius="6"
                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="8,4">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <Button
                                                    Content="{x:Bind HeaderText}"
                                                    Command="{Binding DataContext.SelectTabCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"/>
                                                <Button
                                                    Content="✕"
                                                    Command="{Binding DataContext.CloseTabCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <Grid Grid.Row="1"
                          ColumnSpacing="16"
                          Visibility="{Binding HasActiveTab}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            CornerRadius="8"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="12">
                            <Grid RowDefinitions="Auto,Auto,*"
                                  RowSpacing="12">
                                <StackPanel Grid.Row="0"
                                            Spacing="4">
                                    <TextBlock Text="{Binding ActiveTab.HeaderText}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{Binding ActiveTab.SummaryText}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding ActiveTab.MessageCountSummary}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <StackPanel Grid.Row="2"
                                            Spacing="8">
                                    <ProgressRing IsActive="{Binding ActiveTab.IsLoading}"
                                                  Width="20"
                                                  Height="20"/>

                                    <TextBlock Text="{Binding ActiveTab.ErrorMessage}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap"/>

                                    <InfoBar
                                        IsOpen="{Binding ActiveTab.ShowEmptyState}"
                                        Severity="Informational"
                                        Title="No messages available"
                                        Message="This workspace currently has no messages to display."/>

                                    <ListView ItemsSource="{Binding ActiveTab.Messages}"
                                              SelectedItem="{Binding ActiveTab.SelectedMessage, Mode=TwoWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:SbMessage">
                                                <Border
                                                    Margin="0,0,0,8"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="10">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind MessageId}"
                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{x:Bind Subject}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{x:Bind CorrelationId}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{x:Bind EnqueuedAt}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="1"
                            CornerRadius="8"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Message details"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                                    <InfoBar
                                        IsOpen="{Binding ActiveTab.ShowNoSelectionState}"
                                        Severity="Informational"
                                        Title="No message selected"
                                        Message="Select a message from the list to inspect its body and properties."/>

                                    <StackPanel Spacing="8"
                                                Visibility="{Binding ActiveTab.HasSelectedMessage}">
                                        <TextBlock Text="Message ID"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBox Text="{Binding ActiveTab.SelectedMessageId}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"/>

                                        <TextBlock Text="Subject"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBox Text="{Binding ActiveTab.SelectedMessageSubject}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"/>

                                        <TextBlock Text="Correlation ID"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBox Text="{Binding ActiveTab.SelectedMessageCorrelationId}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"/>

                                        <TextBlock Text="Session ID"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBox Text="{Binding ActiveTab.SelectedMessageSessionId}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"/>

                                        <TextBlock Text="System properties"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBox Text="{Binding ActiveTab.SelectedMessageSystemProperties}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"/>

                                        <TextBlock Text="Application properties"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBox Text="{Binding ActiveTab.SelectedMessageProperties}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"/>

                                        <TextBlock Text="Body"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBox Text="{Binding ActiveTab.SelectedMessageBody}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="220"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Page>