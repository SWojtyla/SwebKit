<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SwebKit.WinUI.Views.ServiceBus.ServiceBusPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SwebKit.Core.Models"
    xmlns:shared="using:SwebKit.WinUI.Controls.Shared"
    xmlns:viewModels="using:SwebKit.WinUI.ViewModels.ServiceBus"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    Background="{ThemeResource SwebKitPageBackgroundBrush}">

    <shared:PageScaffold
        Title="Service Bus"
        Subtitle="Select a namespace, browse queues and topics, and open active or DLQ workspaces."
        IsHeaderCompact="True">
        <shared:PageScaffold.BodyContent>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Style="{StaticResource SwebKitSurfaceCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">

                            <!-- Namespace selector -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox
                                    Grid.Column="0"
                                    ItemsSource="{Binding Namespaces}"
                                    SelectedItem="{Binding SelectedNamespace, Mode=TwoWay}"
                                    DisplayMemberPath="Alias"
                                    PlaceholderText="No namespaces configured"
                                    HorizontalAlignment="Stretch"/>

                                <ProgressRing
                                    Grid.Column="1"
                                    Width="20"
                                    Height="20"
                                    IsActive="{Binding IsLoading}"/>

                                <Button
                                    Grid.Column="2"
                                    Content="Refresh"
                                    Command="{Binding ReloadCommand}"
                                    IsEnabled="{Binding CanMutate}"/>
                            </Grid>

                            <!-- Status + Manage link -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding SelectedNamespace.StatusText}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"/>

                                <HyperlinkButton
                                    Grid.Column="1"
                                    Content="Manage"
                                    Click="ManageNamespaces_Click"
                                    VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Reload error -->
                            <TextBlock
                                Text="{Binding ErrorMessage}"
                                Visibility="{Binding ErrorVisibility}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="WrapWholeWords"/>

                            <!-- Empty state -->
                            <InfoBar
                                IsOpen="{Binding ShowEmptyState}"
                                Severity="Informational"
                                Title="No namespaces"
                                Message="Add namespace connection strings from Settings → Service Bus."/>

                            <!-- Scheduled messages shortcut -->
                            <Button
                                Content="Scheduled messages"
                                Command="{Binding SelectedNamespace.OpenScheduledCommand}"
                                IsEnabled="{Binding HasNamespaces}"
                                HorizontalAlignment="Stretch"/>

                            <!-- Entity loading indicator -->
                            <ProgressRing
                                IsActive="{Binding SelectedNamespace.IsEntityLoading}"
                                Width="20"
                                Height="20"/>

                            <!-- Entity load error -->
                            <TextBlock
                                Text="{Binding SelectedNamespace.EntityLoadError}"
                                Visibility="{Binding SelectedNamespace.HasEntityLoadError}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="Wrap"/>

                            <!-- Entity empty state -->
                            <InfoBar
                                IsOpen="{Binding SelectedNamespace.ShowEntityEmptyState}"
                                Severity="Informational"
                                Title="No entities found"
                                Message="If you expect queues or topics here, verify the namespace and that the connection string has Manage rights."/>

                            <!-- Queues -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="Queues"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <ItemsControl ItemsSource="{Binding SelectedNamespace.Queues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:ServiceBusEntityItemViewModel">
                                            <Border
                                                Margin="0,0,0,8"
                                                CornerRadius="6"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="10">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    Spacing="2">
                                                            <TextBlock Text="{x:Bind Name}"
                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                            <TextBlock Text="{x:Bind ActiveCountText}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{x:Bind DeadLetterCountText}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{x:Bind StatusText}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Content="Active"
                                                                Command="{x:Bind OpenActiveCommand}"
                                                                IsEnabled="{x:Bind SupportsMessageModes}"/>
                                                        <Button Grid.Column="2"
                                                                Content="DLQ"
                                                                Command="{x:Bind OpenDlqCommand}"
                                                                IsEnabled="{x:Bind SupportsMessageModes}"/>
                                                        <Button Grid.Column="3"
                                                                Content="{x:Bind ToggleEnabledLabel}"
                                                                Command="{x:Bind ToggleEnabledCommand}"/>
                                                    </Grid>

                                                    <TextBlock Text="{x:Bind OperationMessage}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Topics -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="Topics"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <ItemsControl ItemsSource="{Binding SelectedNamespace.Topics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:ServiceBusEntityItemViewModel">
                                            <Border
                                                Margin="0,0,0,8"
                                                CornerRadius="6"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="10">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    Spacing="2">
                                                            <TextBlock Text="{x:Bind Name}"
                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                            <TextBlock Text="{x:Bind StatusText}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Content="{x:Bind ExpandCollapseLabel}"
                                                                Command="{x:Bind ToggleExpandedCommand}"/>
                                                        <Button Grid.Column="2"
                                                                Content="{x:Bind ToggleEnabledLabel}"
                                                                Command="{x:Bind ToggleEnabledCommand}"/>
                                                    </Grid>

                                                    <TextBlock Text="{x:Bind OperationMessage}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap"/>

                                                    <StackPanel Margin="20,0,0,0"
                                                                Spacing="8"
                                                                Visibility="{x:Bind ShowChildren, Mode=OneWay}">
                                                        <ProgressRing IsActive="{x:Bind IsLoadingChildren}"
                                                                      Width="20"
                                                                      Height="20"/>

                                                        <TextBlock Text="{x:Bind ChildLoadError}"
                                                                   Visibility="{x:Bind HasChildLoadError, Mode=OneWay}"
                                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                   TextWrapping="Wrap"/>

                                                        <InfoBar
                                                            IsOpen="{x:Bind ShowEmptyChildrenState, Mode=OneWay}"
                                                            Severity="Informational"
                                                            Title="No subscriptions found"
                                                            Message="This topic has no subscriptions available to browse."/>

                                                        <ItemsControl ItemsSource="{x:Bind Children}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="viewModels:ServiceBusEntityItemViewModel">
                                                                    <Border
                                                                        Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="10">
                                                                        <StackPanel Spacing="8">
                                                                            <Grid ColumnSpacing="8">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <StackPanel Grid.Column="0"
                                                                                            Spacing="2">
                                                                                    <TextBlock Text="{x:Bind Name}"
                                                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                                    <TextBlock Text="{x:Bind ActiveCountText}"
                                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                                    <TextBlock Text="{x:Bind DeadLetterCountText}"
                                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                                    <TextBlock Text="{x:Bind StatusText}"
                                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                                </StackPanel>

                                                                                <Button Grid.Column="1"
                                                                                        Content="Active"
                                                                                        Command="{x:Bind OpenActiveCommand}"
                                                                                        IsEnabled="{x:Bind SupportsMessageModes}"/>
                                                                                <Button Grid.Column="2"
                                                                                        Content="DLQ"
                                                                                        Command="{x:Bind OpenDlqCommand}"
                                                                                        IsEnabled="{x:Bind SupportsMessageModes}"/>
                                                                                <Button Grid.Column="3"
                                                                                        Content="{x:Bind ToggleEnabledLabel}"
                                                                                        Command="{x:Bind ToggleEnabledCommand}"/>
                                                                            </Grid>

                                                                            <TextBlock Text="{x:Bind OperationMessage}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                       TextWrapping="Wrap"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource SwebKitSurfaceCardStyle}">
                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="12">
                        <StackPanel Grid.Row="0"
                                    Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="Workspaces"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"/>

                                <Button
                                    Grid.Column="1"
                                    Content="Send"
                                    Click="SendActiveMessage_Click"
                                    IsEnabled="{Binding CanSendActiveMessage}"/>

                                <Button
                                    Grid.Column="2"
                                    Content="Batch Send"
                                    Click="BatchSendActiveMessages_Click"
                                    IsEnabled="{Binding CanSendActiveMessage}"/>

                                <Button
                                    Grid.Column="3"
                                    Content="Resubmit DLQ"
                                    Click="ResubmitSelectedDeadLetter_Click"
                                    IsEnabled="{Binding CanResubmitSelectedDeadLetter}"/>

                                <Button
                                    Grid.Column="4"
                                    Content="Complete DLQ"
                                    Click="CompleteSelectedDeadLetter_Click"
                                    IsEnabled="{Binding CanCompleteSelectedDeadLetter}"/>

                                <Button
                                    Grid.Column="5"
                                    Content="Batch Replay DLQ"
                                    Click="BatchReplaySelectedDeadLetters_Click"
                                    IsEnabled="{Binding ActiveTab.CanBatchReplayDeadLetter}"/>

                                <Button
                                    Grid.Column="6"
                                    Content="Refresh current"
                                    Command="{Binding RefreshActiveTabCommand}"
                                    IsEnabled="{Binding CanRefreshActiveTab}"/>
                            </Grid>

                            <InfoBar
                                IsOpen="{Binding ShowTabEmptyState}"
                                Severity="Informational"
                                Title="No entity open"
                                Message="Open Active, DLQ, or Scheduled workspaces from the left pane."/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:ServiceBusTabViewModel">
                                            <Border
                                                Margin="0,0,8,0"
                                                CornerRadius="6"
                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="8,4">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8">
                                                    <Button
                                                        Content="{x:Bind HeaderText}"
                                                        Command="{Binding DataContext.SelectTabCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"/>
                                                    <Button
                                                        Content="✕"
                                                        Command="{Binding DataContext.CloseTabCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <Grid Grid.Row="1"
                              ColumnSpacing="16"
                              Visibility="{Binding HasActiveTab}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.ColumnSpan="2"
                                CornerRadius="8"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="12"
                                Visibility="{Binding ActiveTab.IsScheduled}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Padding="12">
                                        <Grid RowDefinitions="Auto,Auto,*"
                                              RowSpacing="12">
                                            <StackPanel Grid.Row="0"
                                                        Spacing="4">
                                                <TextBlock Text="{Binding ActiveTab.HeaderText}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <TextBlock Text="{Binding ActiveTab.SummaryText}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1"
                                                        Spacing="8">
                                                <TextBlock Text="{Binding ActiveTab.MessageCountSummary}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ActiveTab.ScheduledActionError}"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding ActiveTab.HasScheduledActionError}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2"
                                                        Spacing="8">
                                                <ProgressRing IsActive="{Binding ActiveTab.IsLoading}"
                                                              Width="20"
                                                              Height="20"/>

                                                <TextBlock Text="{Binding ActiveTab.ErrorMessage}"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                           TextWrapping="Wrap"/>

                                                <InfoBar
                                                    IsOpen="{Binding ActiveTab.ShowEmptyState}"
                                                    Severity="Informational"
                                                    Title="No scheduled messages"
                                                    Message="Schedule a message from an active workspace to populate this native scheduled-message manager."/>

                                                <ListView ItemsSource="{Binding ActiveTab.ScheduledMessages}"
                                                          SelectedItem="{Binding ActiveTab.SelectedScheduledMessage, Mode=TwoWay}">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:ScheduledMessageItemViewModel">
                                                            <Border
                                                                Margin="0,0,0,8"
                                                                CornerRadius="6"
                                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                Padding="10">
                                                                <StackPanel Spacing="8">
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0"
                                                                                    Spacing="4">
                                                                            <TextBlock Text="{x:Bind DisplayMessageId}"
                                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{x:Bind EntityPath}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{x:Bind ScheduledEnqueueTimeText}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                            <TextBlock Text="{x:Bind StatusText}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                        </StackPanel>

                                                                        <Button
                                                                            Grid.Column="1"
                                                                            Content="Cancel"
                                                                            Click="CancelScheduledMessage_Click"
                                                                            IsEnabled="{x:Bind CanCancel}"/>

                                                                        <Button
                                                                            Grid.Column="2"
                                                                            Content="Remove local"
                                                                            Click="RemoveScheduledMessage_Click"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Grid.Column="1"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Padding="12">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="Scheduled message details"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>

                                                <InfoBar
                                                    IsOpen="{Binding ActiveTab.ShowNoScheduledSelectionState}"
                                                    Severity="Informational"
                                                    Title="No scheduled message selected"
                                                    Message="Select a scheduled message from the list to inspect its metadata."/>

                                                <StackPanel Spacing="8"
                                                            Visibility="{Binding ActiveTab.HasSelectedScheduledMessage}">
                                                    <TextBlock Text="Message ID"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <TextBox Text="{Binding ActiveTab.SelectedScheduledMessageId}"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"/>

                                                    <TextBlock Text="Subject"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <TextBox Text="{Binding ActiveTab.SelectedScheduledSubject}"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"/>

                                                    <TextBlock Text="Correlation ID"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <TextBox Text="{Binding ActiveTab.SelectedScheduledCorrelationId}"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"/>

                                                    <TextBlock Text="Entity path"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <TextBox Text="{Binding ActiveTab.SelectedScheduledEntityPath}"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"/>

                                                    <TextBlock Text="Sequence number"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <TextBox Text="{Binding ActiveTab.SelectedScheduledSequenceNumber}"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"/>

                                                    <TextBlock Text="Scheduled enqueue time"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <TextBox Text="{Binding ActiveTab.SelectedScheduledEnqueueTime}"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"/>

                                                    <TextBlock Text="Status"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <TextBox Text="{Binding ActiveTab.SelectedScheduledStatus}"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="0"
                                CornerRadius="8"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="12"
                                Visibility="{Binding ActiveTab.IsMessageTab}">
                                <Grid RowDefinitions="Auto,Auto,*"
                                      RowSpacing="12">
                                    <StackPanel Grid.Row="0"
                                                Spacing="4">
                                        <TextBlock Text="{Binding ActiveTab.HeaderText}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{Binding ActiveTab.SummaryText}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ActiveTab.MessageCountSummary}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                            <Button
                                                Grid.Column="1"
                                                Content="{Binding ActiveTab.LoadMoreButtonLabel}"
                                                Command="{Binding LoadMoreActiveTabCommand}"
                                                IsEnabled="{Binding CanLoadMoreActiveTab}"
                                                Visibility="{Binding ActiveTab.LoadMoreVisibility}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding ActiveTab.BatchSelectionSummary}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding ActiveTab.IsDlq}"/>

                                        <Border
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="12">
                                            <StackPanel Spacing="12">
                                                <TextBox
                                                    Header="Filter messages"
                                                    PlaceholderText="Search loaded message IDs, subjects, correlation IDs, and bodies"
                                                    Text="{Binding ActiveTab.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ToggleSwitch
                                                        Grid.Column="0"
                                                        Header="Filters"
                                                        IsOn="{Binding ActiveTab.FiltersEnabled, Mode=TwoWay}"/>

                                                    <ToggleSwitch
                                                        Grid.Column="1"
                                                        Header="Advanced"
                                                        IsOn="{Binding ActiveTab.AdvancedFilterEnabled, Mode=TwoWay}"/>

                                                    <Button
                                                        Grid.Column="2"
                                                        Content="Add rule"
                                                        Command="{Binding ActiveTab.AddAdvancedRuleCommand}"
                                                        Visibility="{Binding ActiveTab.AdvancedFilterEnabled}"
                                                        VerticalAlignment="Bottom"/>

                                                    <StackPanel
                                                        Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Spacing="8"
                                                        VerticalAlignment="Bottom">
                                                        <Button
                                                            Content="Delete filtered"
                                                            Click="DeleteFilteredMessages_Click"
                                                            IsEnabled="{Binding ActiveTab.HasMessages}"/>
                                                        <Button
                                                            Content="Purge all"
                                                            Click="PurgeAllMessages_Click"
                                                            IsEnabled="{Binding ActiveTab.HasMessages}"/>
                                                        <Button
                                                            Content="Export JSON"
                                                            Click="ExportVisibleMessages_Click"
                                                            IsEnabled="{Binding ActiveTab.HasMessages}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ComboBox
                                                        Grid.Column="0"
                                                        ItemsSource="{Binding ActiveTab.SavedFilters}"
                                                        SelectedItem="{Binding ActiveTab.SelectedSavedFilter, Mode=TwoWay}"
                                                        DisplayMemberPath="Name"
                                                        PlaceholderText="Saved filters"
                                                        IsEnabled="{Binding ActiveTab.HasSavedFilters}"/>

                                                    <Button
                                                        Grid.Column="1"
                                                        Content="Apply"
                                                        Command="{Binding ActiveTab.ApplySelectedSavedFilterCommand}"
                                                        IsEnabled="{Binding ActiveTab.HasSelectedSavedFilter}"/>

                                                    <Button
                                                        Grid.Column="2"
                                                        Content="Delete"
                                                        Command="{Binding ActiveTab.DeleteSelectedSavedFilterCommand}"
                                                        IsEnabled="{Binding ActiveTab.HasSelectedSavedFilter}"/>
                                                </Grid>

                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox
                                                        Grid.Column="0"
                                                        Header="Save current filter as"
                                                        PlaceholderText="Filter name"
                                                        Text="{Binding ActiveTab.PendingFilterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <Button
                                                        Grid.Column="1"
                                                        Content="Save filter"
                                                        Command="{Binding ActiveTab.SaveCurrentFilterCommand}"
                                                        IsEnabled="{Binding ActiveTab.CanSaveCurrentFilter}"
                                                        VerticalAlignment="Bottom"/>
                                                </Grid>

                                                <Expander Header="Advanced rules"
                                                          Visibility="{Binding ActiveTab.AdvancedFilterEnabled}">
                                                    <StackPanel Margin="0,8,0,0"
                                                                Spacing="8">
                                                        <TextBlock Text="Enabled rules are combined with logical AND."
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="Wrap"/>

                                                        <ItemsControl ItemsSource="{Binding ActiveTab.AdvancedRules}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="viewModels:AdvancedFilterRuleViewModel">
                                                                    <Border
                                                                        Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="10">
                                                                        <StackPanel Spacing="8">
                                                                            <Grid ColumnSpacing="8">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <CheckBox Grid.Column="0"
                                                                                          Content="On"
                                                                                          IsChecked="{x:Bind Enabled, Mode=TwoWay}"/>

                                                                                <ComboBox Grid.Column="1"
                                                                                          ItemsSource="{x:Bind AvailableFields, Mode=OneWay}"
                                                                                          DisplayMemberPath="Label"
                                                                                          SelectedValuePath="Value"
                                                                                          SelectedValue="{x:Bind Field, Mode=TwoWay}"/>

                                                                                <ComboBox Grid.Column="2"
                                                                                          ItemsSource="{x:Bind AvailableOperators, Mode=OneWay}"
                                                                                          DisplayMemberPath="Label"
                                                                                          SelectedValuePath="Value"
                                                                                          SelectedValue="{x:Bind Operator, Mode=TwoWay}"/>

                                                                                <Button Grid.Column="3"
                                                                                        Content="Remove"
                                                                                        Command="{Binding DataContext.ActiveTab.RemoveAdvancedRuleCommand, ElementName=PageRoot}"
                                                                                        CommandParameter="{Binding}"/>
                                                                            </Grid>

                                                                            <TextBox PlaceholderText="Application property name"
                                                                                     Text="{x:Bind PropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                     Visibility="{x:Bind PropertyNameVisibility, Mode=OneWay}"/>

                                                                            <TextBox PlaceholderText="{x:Bind ValuePlaceholder, Mode=OneWay}"
                                                                                     Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>

                                                <Expander Header="Visible list fields">
                                                    <StackPanel Margin="0,8,0,0"
                                                                Spacing="8">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <Button Content="Compact"
                                                                    Command="{Binding ActiveTab.SetRowDensityCommand}"
                                                                    CommandParameter="compact"/>
                                                            <Button Content="Default"
                                                                    Command="{Binding ActiveTab.SetRowDensityCommand}"
                                                                    CommandParameter="default"/>
                                                            <Button Content="Comfort"
                                                                    Command="{Binding ActiveTab.SetRowDensityCommand}"
                                                                    CommandParameter="comfort"/>
                                                        </StackPanel>

                                                        <CheckBox Content="Message ID"
                                                                  IsChecked="{Binding ActiveTab.ShowMessageIdField, Mode=TwoWay}"/>
                                                        <CheckBox Content="Subject"
                                                                  IsChecked="{Binding ActiveTab.ShowSubjectField, Mode=TwoWay}"/>
                                                        <CheckBox Content="Correlation ID"
                                                                  IsChecked="{Binding ActiveTab.ShowCorrelationIdField, Mode=TwoWay}"/>
                                                        <CheckBox Content="Enqueued time"
                                                                  IsChecked="{Binding ActiveTab.ShowEnqueuedField, Mode=TwoWay}"/>
                                                        <CheckBox Content="Delivery count"
                                                                  IsChecked="{Binding ActiveTab.ShowDeliveryField, Mode=TwoWay}"/>
                                                        <CheckBox Content="Expires"
                                                                  IsChecked="{Binding ActiveTab.ShowExpiresField, Mode=TwoWay}"/>
                                                        <CheckBox Content="Content type"
                                                                  IsChecked="{Binding ActiveTab.ShowContentTypeField, Mode=TwoWay}"/>
                                                        <CheckBox Content="Session"
                                                                  IsChecked="{Binding ActiveTab.ShowSessionField, Mode=TwoWay}"/>
                                                        <CheckBox Content="Partition key"
                                                                  IsChecked="{Binding ActiveTab.ShowPartitionKeyField, Mode=TwoWay}"/>
                                                        <CheckBox Content="DLQ reason"
                                                                  IsChecked="{Binding ActiveTab.ShowDeadLetterReasonField, Mode=TwoWay}"/>

                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Column="0"
                                                                     Header="Custom property column"
                                                                     PlaceholderText="Application property key"
                                                                     Text="{Binding ActiveTab.NewCustomPropertyColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                            <Button Grid.Column="1"
                                                                    Content="Add"
                                                                    Command="{Binding ActiveTab.AddCustomPropertyColumnCommand}"
                                                                    IsEnabled="{Binding ActiveTab.CanAddCustomPropertyColumn}"
                                                                    VerticalAlignment="Bottom"/>
                                                        </Grid>

                                                        <ItemsControl ItemsSource="{Binding ActiveTab.CustomPropertyColumns}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Grid Margin="0,0,0,4"
                                                                          ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding}"
                                                                                   TextTrimming="CharacterEllipsis"/>

                                                                        <Button Grid.Column="1"
                                                                                Content="Remove"
                                                                                Command="{Binding DataContext.ActiveTab.RemoveCustomPropertyColumnCommand, ElementName=PageRoot}"
                                                                                CommandParameter="{Binding}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Button Content="Reset list preferences"
                                                                Command="{Binding ActiveTab.ResetMessageListPreferencesCommand}"/>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Spacing="8">
                                        <ProgressRing IsActive="{Binding ActiveTab.IsLoading}"
                                                      Width="20"
                                                      Height="20"/>

                                        <TextBlock Text="{Binding ActiveTab.ErrorMessage}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="Wrap"/>

                                        <InfoBar
                                            IsOpen="{Binding ActiveTab.ShowEmptyState}"
                                            Severity="Informational"
                                            Title="No messages available"
                                            Message="This workspace currently has no messages to display."/>

                                        <InfoBar
                                            IsOpen="{Binding ActiveTab.ShowFilteredEmptyState}"
                                            Severity="Informational"
                                            Title="No matches"
                                            Message="No loaded messages match the current search filter."/>

                                        <ListView ItemsSource="{Binding ActiveTab.VisibleMessages}"
                                                  SelectionMode="{Binding ActiveTab.MessageSelectionMode}"
                                                  SelectionChanged="VisibleMessages_SelectionChanged">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:ServiceBusVisibleMessageItemViewModel">
                                                    <Border
                                                        Margin="0,0,0,8"
                                                        CornerRadius="6"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Padding="{Binding DataContext.ActiveTab.MessageCardPadding, ElementName=PageRoot}">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{x:Bind MessageId}"
                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding DataContext.ActiveTab.MessageIdVisibility, ElementName=PageRoot}"/>
                                                            <TextBlock Text="{x:Bind Subject}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding DataContext.ActiveTab.SubjectVisibility, ElementName=PageRoot}"/>
                                                            <TextBlock Text="{x:Bind CorrelationId}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding DataContext.ActiveTab.CorrelationIdVisibility, ElementName=PageRoot}"/>
                                                            <TextBlock Text="{x:Bind EnqueuedAt}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       Visibility="{Binding DataContext.ActiveTab.EnqueuedVisibility, ElementName=PageRoot}"/>
                                                            <TextBlock Text="{x:Bind AdditionalFieldsText}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       Visibility="{x:Bind AdditionalFieldsVisibility}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{x:Bind CustomPropertyText}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       Visibility="{x:Bind CustomPropertyVisibility}"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="1"
                                CornerRadius="8"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="12"
                                Visibility="{Binding ActiveTab.IsMessageTab}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Message details"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>

                                        <InfoBar
                                            IsOpen="{Binding ActiveTab.ShowNoSelectionState}"
                                            Severity="Informational"
                                            Title="No message selected"
                                            Message="Select a message from the list to inspect its body and properties."/>

                                        <StackPanel Spacing="8"
                                                    Visibility="{Binding ActiveTab.HasSelectedMessage}">
                                            <Button Content="Investigate in Incident Timeline"
                                                    Command="{Binding InvestigateActiveMessageCommand}"
                                                    IsEnabled="{Binding CanInvestigateActiveMessage}"
                                                    HorizontalAlignment="Left"/>

                                            <Grid ColumnSpacing="8"
                                                  RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Row="0"
                                                        Grid.Column="0"
                                                        Content="Edit &amp; Resubmit"
                                                        Click="EditSelectedMessage_Click"/>
                                                <Button Grid.Row="0"
                                                        Grid.Column="1"
                                                        Content="Replay"
                                                        Click="ReplaySelectedMessage_Click"
                                                        IsEnabled="{Binding ActiveTab.SupportsReplay}"/>
                                                <Button Grid.Row="0"
                                                        Grid.Column="2"
                                                        Content="Schedule"
                                                        Click="ScheduleSelectedMessage_Click"/>
                                                <Button Grid.Row="1"
                                                        Grid.Column="2"
                                                        Content="Save as Template"
                                                        Click="SaveSelectedMessageAsTemplate_Click"/>

                                                <Button Grid.Row="1"
                                                        Grid.Column="0"
                                                        Content="Copy Body"
                                                        Click="CopySelectedMessageBody_Click"/>
                                                <Button Grid.Row="1"
                                                        Grid.Column="1"
                                                        Content="Copy Full Message"
                                                        Click="CopySelectedMessageJson_Click"/>
                                                <Button Grid.Row="2"
                                                        Grid.Column="2"
                                                        Grid.ColumnSpan="3"
                                                        Content="Filter to Session"
                                                        Click="FilterSelectedMessageSession_Click"
                                                        IsEnabled="{Binding ActiveTab.HasSelectedMessageSessionId}"/>
                                            </Grid>

                                            <TextBlock Text="Message ID"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBox Text="{Binding ActiveTab.SelectedMessageId}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"/>

                                            <TextBlock Text="Subject"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBox Text="{Binding ActiveTab.SelectedMessageSubject}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"/>

                                            <TextBlock Text="Correlation ID"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBox Text="{Binding ActiveTab.SelectedMessageCorrelationId}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"/>

                                            <TextBlock Text="Session ID"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBox Text="{Binding ActiveTab.SelectedMessageSessionId}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"/>

                                            <TextBlock Text="System properties"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBox Text="{Binding ActiveTab.SelectedMessageSystemProperties}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"/>

                                            <TextBlock Text="Application properties"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBox Text="{Binding ActiveTab.SelectedMessageProperties}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"/>

                                            <TextBlock Text="Body"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBox Text="{Binding ActiveTab.SelectedMessageBody}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="220"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </shared:PageScaffold.BodyContent>
    </shared:PageScaffold>

</Page>