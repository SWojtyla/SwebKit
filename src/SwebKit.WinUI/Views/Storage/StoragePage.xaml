<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SwebKit.WinUI.Views.Storage.StoragePage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:SwebKit.WinUI.Controls.Shared"
    xmlns:viewModels="using:SwebKit.WinUI.ViewModels.Storage"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    Background="{ThemeResource SwebKitPageBackgroundBrush}">

    <shared:PageScaffold
        Title="Storage"
        Subtitle="Browse configured storage accounts, move through containers and virtual folders, and preview text-friendly blobs without leaving the native workspace.">
        <shared:PageScaffold.BodyContent>
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Style="{StaticResource SwebKitSurfaceCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Spacing="4">
                                <TextBlock
                                    Text="Account connection"
                                    Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                <TextBlock
                                    Text="{Binding ConnectionSummary}"
                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                    TextWrapping="WrapWholeWords"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Top">
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    IsActive="{Binding IsRefreshing}"/>
                                <Button
                                    Content="Refresh"
                                    Command="{Binding ReloadCommand}"/>
                                <Button
                                    Content="Open Settings"
                                    Command="{Binding OpenSettingsCommand}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="{Binding ErrorMessage}"
                            Visibility="{Binding GlobalErrorVisibility}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="WrapWholeWords"/>

                        <InfoBar
                            IsOpen="{Binding ShowNotConfiguredState}"
                            Severity="Informational"
                            Title="Storage is not configured"
                            Message="Configure at least one Azure Blob Storage account in Settings before opening containers and blob detail views.">
                            <InfoBar.ActionButton>
                                <Button
                                    Content="Open Settings"
                                    Command="{Binding OpenSettingsCommand}"/>
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Spacing="6">
                                <TextBlock
                                    Text="Account"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                                <ComboBox
                                    ItemsSource="{Binding Accounts}"
                                    SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                    DisplayMemberPath="DisplayLabel"
                                    IsEnabled="{Binding HasMultipleAccounts}"/>
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Spacing="4">
                                    <TextBlock
                                        Text="Scope"
                                        Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="{Binding AccountCountLabel}"/>
                                    <TextBlock Text="{Binding ContainerCountLabel}"
                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Spacing="4">
                                    <TextBlock
                                        Text="Selection"
                                        Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="{Binding SelectedContainerTitle}"/>
                                    <TextBlock Text="{Binding SelectedContainerSubtitle}"
                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                               TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1"
                      ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Style="{StaticResource SwebKitSurfaceCardStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Spacing="4">
                                    <TextBlock
                                        Text="Containers"
                                        Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                    <TextBlock
                                        Text="Choose a container before opening folders or blob previews."
                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>

                                <ProgressRing
                                    Grid.Column="1"
                                    Width="20"
                                    Height="20"
                                    IsActive="{Binding IsLoadingContainers}"/>
                            </Grid>

                            <InfoBar
                                Grid.Row="1"
                                IsOpen="{Binding ShowContainerEmptyState}"
                                Severity="Informational"
                                Title="No containers found"
                                Message="The selected account returned no containers, or the current credential cannot enumerate them."/>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Containers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:StorageContainerItemViewModel">
                                            <Border
                                                Margin="0,0,0,10"
                                                CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="12">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    Spacing="4">
                                                            <TextBlock
                                                                Text="{x:Bind Name}"
                                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                TextWrapping="WrapWholeWords"/>
                                                            <TextBlock
                                                                Text="{x:Bind Subtitle}"
                                                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                TextWrapping="WrapWholeWords"/>
                                                        </StackPanel>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{x:Bind SelectionStateLabel}"
                                                            Visibility="{x:Bind SelectionStateVisibility, Mode=OneWay}"
                                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                            VerticalAlignment="Top"/>
                                                    </Grid>

                                                    <Button
                                                        Content="Open"
                                                        Command="{Binding ViewModel.SelectContainerCommand, ElementName=PageRoot}"
                                                        CommandParameter="{x:Bind}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1"
                          RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Style="{StaticResource SwebKitSurfaceCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Spacing="4">
                                        <TextBlock
                                            Text="Blob workspace"
                                            Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                        <TextBlock
                                            Text="{Binding BlobCountLabel}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        Content="Refresh current folder"
                                        Command="{Binding RefreshBlobsCommand}"
                                        IsEnabled="{Binding HasSelectedContainer}"/>
                                </Grid>

                                <StackPanel Visibility="{Binding DownloadVisibility}"
                                            Spacing="6">
                                    <TextBlock Text="{Binding ActiveDownloadLabel}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextWrapping="WrapWholeWords"/>
                                    <TextBlock Text="{Binding DownloadProgressText}"
                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                    <ProgressBar IsIndeterminate="{Binding IsDownloadIndeterminate}"
                                                 Value="{Binding DownloadProgressPercent}"
                                                 Minimum="0"
                                                 Maximum="100"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1"
                              ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource SwebKitSurfaceCardStyle}"
                                Visibility="{Binding BlobWorkspaceVisibility}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Spacing="4">
                                        <TextBlock
                                            Text="{Binding SelectedContainerTitle}"
                                            Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                        <TextBlock
                                            Text="{Binding SelectedContainerSubtitle}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"/>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{Binding BlobListErrorMessage}"
                                        Visibility="{Binding BlobListErrorVisibility}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        TextWrapping="WrapWholeWords"/>

                                    <ItemsControl Grid.Row="2"
                                                  ItemsSource="{Binding Breadcrumbs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:StorageBreadcrumbItemViewModel">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="6">
                                                    <TextBlock Text="/"
                                                               Visibility="{x:Bind SeparatorVisibility}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                    <Button Content="{x:Bind Label}"
                                                            Visibility="{x:Bind ButtonVisibility}"
                                                            Command="{Binding ViewModel.NavigateToBreadcrumbCommand, ElementName=PageRoot}"
                                                            CommandParameter="{x:Bind}"/>
                                                    <TextBlock Text="{x:Bind Label}"
                                                               Visibility="{x:Bind CurrentTextVisibility}"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ScrollViewer Grid.Row="3"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="10">
                                            <InfoBar
                                                IsOpen="{Binding ShowBlobEmptyState}"
                                                Severity="Informational"
                                                Title="No items in this folder"
                                                Message="Try another container, move back up the breadcrumb trail, or refresh the current folder."/>

                                            <ItemsControl ItemsSource="{Binding Blobs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:StorageBlobEntryViewModel">
                                                        <Border
                                                            Margin="0,0,0,10"
                                                            CornerRadius="8"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Padding="12">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0"
                                                                            Spacing="4">
                                                                    <TextBlock Text="{x:Bind DisplayName}"
                                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                               TextWrapping="WrapWholeWords"/>
                                                                    <TextBlock Text="{x:Bind DetailLine}"
                                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                               TextWrapping="WrapWholeWords"/>
                                                                    <TextBlock Text="{x:Bind SelectionStateLabel}"
                                                                               Visibility="{x:Bind SelectionStateVisibility, Mode=OneWay}"
                                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                                                </StackPanel>

                                                                <Button Grid.Column="1"
                                                                        Content="{x:Bind PrimaryActionLabel}"
                                                                        Command="{Binding ViewModel.OpenBlobEntryCommand, ElementName=PageRoot}"
                                                                        CommandParameter="{x:Bind}"/>

                                                                <Button Grid.Column="2"
                                                                        Content="Download"
                                                                        Visibility="{x:Bind DownloadVisibility, Mode=OneWay}"
                                                                        Command="{Binding ViewModel.DownloadBlobCommand, ElementName=PageRoot}"
                                                                        CommandParameter="{x:Bind}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Button Grid.Row="4"
                                            Content="Load more"
                                            Visibility="{Binding LoadMoreVisibility}"
                                            Command="{Binding LoadMoreCommand}"/>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource SwebKitSurfaceCardStyle}"
                                Visibility="{Binding SelectContainerHintVisibility}">
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        Text="Select a container"
                                        Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                    <TextBlock
                                        Text="Pick a container from the left pane to browse folders, page through blobs, and open blob previews."
                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource SwebKitSurfaceCardStyle}"
                                Visibility="{Binding BlobDetailVisibility}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Spacing="4">
                                                <TextBlock Text="{Binding SelectedBlobTitle}"
                                                           Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock Text="{Binding SelectedBlobSubtitle}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock Text="{Binding BlobDetailStatusText}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Download"
                                                    Command="{Binding DownloadSelectedBlobCommand}"/>
                                            <Button Grid.Column="2"
                                                    Content="Copy URL"
                                                    Command="{Binding CopySelectedBlobUrlCommand}"/>
                                            <Button Grid.Column="3"
                                                    Content="Copy SAS URL"
                                                    Command="{Binding CopySelectedBlobSasCommand}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding BlobDetailErrorMessage}"
                                                   Visibility="{Binding BlobDetailErrorVisibility}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="WrapWholeWords"/>

                                        <ProgressRing IsActive="{Binding IsLoadingBlobDetail}"
                                                      Width="20"
                                                      Height="20"/>

                                        <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Properties"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <ItemsControl ItemsSource="{Binding BlobPropertyRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:StoragePropertyRowViewModel">
                                                            <Grid ColumnSpacing="12"
                                                                  Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="140"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Label}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind Value}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Metadata"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <TextBlock Text="No metadata recorded for this blob."
                                                           Visibility="{Binding MetadataEmptyVisibility}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                <ItemsControl ItemsSource="{Binding MetadataRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:StorageKeyValueRowViewModel">
                                                            <Grid ColumnSpacing="12"
                                                                  Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="140"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Key}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind Value}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Tags"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <TextBlock Text="No blob index tags recorded for this blob."
                                                           Visibility="{Binding TagsEmptyVisibility}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                <ItemsControl ItemsSource="{Binding TagRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:StorageKeyValueRowViewModel">
                                                            <Grid ColumnSpacing="12"
                                                                  Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="140"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Key}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind Value}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Content preview"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <Button Grid.Column="1"
                                                            Content="Load full preview"
                                                            Visibility="{Binding LoadExpandedPreviewVisibility}"
                                                            Command="{Binding LoadFullPreviewCommand}"/>
                                                </Grid>

                                                <TextBlock Text="{Binding PreviewInfoMessage}"
                                                           Visibility="{Binding PreviewInfoVisibility}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>

                                                <TextBlock Text="Binary content is not previewed inline. Download this blob to inspect its full payload."
                                                           Visibility="{Binding BinaryPreviewVisibility}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>

                                                <TextBox Text="{Binding PreviewContent, Mode=OneWay}"
                                                         Visibility="{Binding PreviewVisibility}"
                                                         IsReadOnly="True"
                                                         AcceptsReturn="True"
                                                         TextWrapping="NoWrap"
                                                         FontFamily="Consolas"
                                                         MinHeight="280"
                                                         MaxHeight="420"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource SwebKitSurfaceCardStyle}"
                                Visibility="{Binding BlobDetailPlaceholderVisibility}">
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        Text="Select a blob"
                                        Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                    <TextBlock
                                        Text="Choose a blob from the list to inspect properties, metadata, tags, and a text-friendly preview."
                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </shared:PageScaffold.BodyContent>
    </shared:PageScaffold>
</Page>