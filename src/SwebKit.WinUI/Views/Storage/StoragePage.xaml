<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SwebKit.WinUI.Views.Storage.StoragePage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:SwebKit.WinUI.Controls.Shared"
    xmlns:viewModels="using:SwebKit.WinUI.ViewModels.Storage"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    Background="{ThemeResource SwebKitPageBackgroundBrush}">

    <shared:PageScaffold
        Title="Storage"
        IsHeaderCompact="True">
        <shared:PageScaffold.ContextContent>
            <Border Style="{StaticResource SwebKitSurfaceCardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Spacing="6">
                            <TextBlock
                                Text="Account"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                            <ComboBox
                                ItemsSource="{Binding Accounts}"
                                SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                DisplayMemberPath="DisplayLabel"
                                IsEnabled="{Binding HasMultipleAccounts}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ConnectionSummary}"
                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                   TextWrapping="WrapWholeWords"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    VerticalAlignment="Center">
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{Binding IsRefreshing}"/>
                            <Button
                                Content="Refresh"
                                Command="{Binding ReloadCommand}"/>
                            <Button
                                Content="Open Settings"
                                Command="{Binding OpenSettingsCommand}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="16">
                        <TextBlock Text="{Binding AccountCountLabel}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{Binding ContainerCountLabel}"
                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Spacing="8">
                        <TextBlock
                            Text="{Binding ErrorMessage}"
                            Visibility="{Binding GlobalErrorVisibility}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="WrapWholeWords"/>

                        <InfoBar
                            IsOpen="{Binding ShowNotConfiguredState}"
                            Severity="Informational"
                            Title="Storage is not configured"
                            Message="Configure at least one Azure Blob Storage account in Settings before opening containers and blob detail views.">
                            <InfoBar.ActionButton>
                                <Button
                                    Content="Open Settings"
                                    Command="{Binding OpenSettingsCommand}"/>
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </Grid>
            </Border>
        </shared:PageScaffold.ContextContent>
        <shared:PageScaffold.BodyContent>
            <Grid>
                <Grid
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Style="{StaticResource SwebKitSurfaceCardStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="Containers"
                                    Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"
                                    VerticalAlignment="Center"/>

                                <ProgressRing
                                    Grid.Column="1"
                                    Width="20"
                                    Height="20"
                                    IsActive="{Binding IsLoadingContainers}"/>
                            </Grid>

                            <TextBox Grid.Row="1"
                                     PlaceholderText="Filter containers"
                                     Text="{Binding ContainerFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <InfoBar
                                Grid.Row="2"
                                IsOpen="{Binding ShowContainerEmptyState}"
                                Severity="Informational"
                                Title="No containers found"
                                Message="The selected account returned no containers, or the current credential cannot enumerate them."/>

                            <ScrollViewer Grid.Row="3"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredContainers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:StorageContainerItemViewModel">
                                            <Border
                                                Margin="0,0,0,10"
                                                CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="12">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    Spacing="4">
                                                            <TextBlock
                                                                Text="{x:Bind Name}"
                                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                TextWrapping="WrapWholeWords"/>
                                                            <TextBlock
                                                                Text="{x:Bind Subtitle}"
                                                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                TextWrapping="WrapWholeWords"/>
                                                        </StackPanel>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{x:Bind SelectionStateLabel}"
                                                            Visibility="{x:Bind SelectionStateVisibility, Mode=OneWay}"
                                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                            VerticalAlignment="Top"/>
                                                    </Grid>

                                                    <Button
                                                        Content="Open"
                                                        Command="{Binding ViewModel.SelectContainerCommand, ElementName=PageRoot}"
                                                        CommandParameter="{x:Bind}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1"
                          RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Style="{StaticResource SwebKitSurfaceCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Spacing="4">
                                        <TextBlock
                                            Text="Blob workspace"
                                            Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                        <TextBlock
                                            Text="{Binding BlobCountLabel}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                        <Button Content="Copy container SAS"
                                                Command="{Binding CopySelectedContainerSasUrlCommand}"
                                                Visibility="{Binding ContainerSasActionVisibility}"
                                                IsEnabled="{Binding CanCopySelectedContainerSas}"/>
                                        <Button Content="Refresh current folder"
                                                Command="{Binding RefreshBlobsCommand}"
                                                IsEnabled="{Binding CanRefreshCurrentFolder}"/>
                                        <Button Content="Upload"
                                                Click="UploadBlob_Click"
                                                Visibility="{Binding UploadActionVisibility}"
                                                IsEnabled="{Binding CanUploadToSelectedContainer}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Visibility="{Binding DownloadVisibility}"
                                            Spacing="6">
                                    <TextBlock Text="{Binding ActiveDownloadLabel}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextWrapping="WrapWholeWords"/>
                                    <TextBlock Text="{Binding DownloadProgressText}"
                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                    <ProgressBar IsIndeterminate="{Binding IsDownloadIndeterminate}"
                                                 Value="{Binding DownloadProgressPercent}"
                                                 Minimum="0"
                                                 Maximum="100"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1"
                              ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource SwebKitSurfaceCardStyle}"
                                Visibility="{Binding BlobWorkspaceVisibility}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Spacing="4">
                                        <TextBlock
                                            Text="{Binding SelectedContainerTitle}"
                                            Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                        <TextBlock
                                            Text="{Binding SelectedContainerSubtitle}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"/>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{Binding BlobListErrorMessage}"
                                        Visibility="{Binding BlobListErrorVisibility}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        TextWrapping="WrapWholeWords"/>

                                    <ItemsControl Grid.Row="2"
                                                  ItemsSource="{Binding Breadcrumbs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:StorageBreadcrumbItemViewModel">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="6">
                                                    <TextBlock Text="/"
                                                               Visibility="{x:Bind SeparatorVisibility}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                    <Button Content="{x:Bind Label}"
                                                            Visibility="{x:Bind ButtonVisibility}"
                                                            Command="{Binding ViewModel.NavigateToBreadcrumbCommand, ElementName=PageRoot}"
                                                            CommandParameter="{x:Bind}"/>
                                                    <TextBlock Text="{x:Bind Label}"
                                                               Visibility="{x:Bind CurrentTextVisibility}"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Grid.Row="3"
                                                Spacing="8">
                                        <TextBox PlaceholderText="Filter blobs"
                                                 Text="{Binding BlobFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <Button Content="{Binding SelectionModeButtonLabel}"
                                                    Command="{Binding ToggleSelectionModeCommand}"
                                                    IsEnabled="{Binding CanToggleSelectionMode}"/>
                                            <Button Content="Select loaded"
                                                    Visibility="{Binding BulkToolbarVisibility}"
                                                    Command="{Binding SelectAllLoadedBlobsCommand}"
                                                    IsEnabled="{Binding CanSelectAllLoadedBlobs}"/>
                                            <Button Content="Clear"
                                                    Visibility="{Binding BulkToolbarVisibility}"
                                                    Command="{Binding ClearSelectedBlobsCommand}"
                                                    IsEnabled="{Binding CanClearSelectedBlobs}"/>
                                            <Button Content="{Binding BulkDownloadButtonLabel}"
                                                    Visibility="{Binding BulkToolbarVisibility}"
                                                    Command="{Binding DownloadSelectedBlobsZipCommand}"
                                                    IsEnabled="{Binding CanDownloadSelectedBlobs}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding BulkSelectionSummaryText}"
                                                   Visibility="{Binding BulkSelectionSummaryVisibility}"
                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                   TextWrapping="WrapWholeWords"/>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="4"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="10">
                                            <InfoBar
                                                IsOpen="{Binding ShowBlobEmptyState}"
                                                Severity="Informational"
                                                Title="No items in this folder"
                                                Message="Try another container, move back up the breadcrumb trail, or refresh the current folder."/>

                                            <ItemsControl ItemsSource="{Binding FilteredBlobs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:StorageBlobEntryViewModel">
                                                        <Border
                                                            Margin="0,0,0,10"
                                                            CornerRadius="8"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Padding="12">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0"
                                                                            Spacing="4">
                                                                    <TextBlock Text="{x:Bind DisplayName}"
                                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                               TextWrapping="WrapWholeWords"/>
                                                                    <TextBlock Text="{x:Bind DetailLine}"
                                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                               TextWrapping="WrapWholeWords"/>
                                                                    <TextBlock Text="{x:Bind SelectionStateLabel}"
                                                                               Visibility="{x:Bind SelectionStateVisibility, Mode=OneWay}"
                                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                                                </StackPanel>

                                                                <ToggleButton Grid.Column="1"
                                                                              Content="{x:Bind SelectionActionLabel}"
                                                                              IsChecked="{x:Bind IsBatchSelected, Mode=OneWay}"
                                                                              Visibility="{x:Bind SelectionToggleVisibility, Mode=OneWay}"
                                                                              IsEnabled="{Binding ViewModel.CanInteractWithBlobEntries, ElementName=PageRoot}"
                                                                              Command="{Binding ViewModel.ToggleBlobSelectionCommand, ElementName=PageRoot}"
                                                                              CommandParameter="{x:Bind}"/>

                                                                <Button Grid.Column="2"
                                                                        Content="{x:Bind PrimaryActionLabel}"
                                                                        IsEnabled="{Binding ViewModel.CanInteractWithBlobEntries, ElementName=PageRoot}"
                                                                        Command="{Binding ViewModel.OpenBlobEntryCommand, ElementName=PageRoot}"
                                                                        CommandParameter="{x:Bind}"/>

                                                                <Button Grid.Column="3"
                                                                        Content="Download"
                                                                        Visibility="{x:Bind DownloadVisibility, Mode=OneWay}"
                                                                        IsEnabled="{Binding ViewModel.CanInteractWithBlobEntries, ElementName=PageRoot}"
                                                                        Command="{Binding ViewModel.DownloadBlobCommand, ElementName=PageRoot}"
                                                                        CommandParameter="{x:Bind}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Button Grid.Row="5"
                                            Content="Load more"
                                            Visibility="{Binding LoadMoreVisibility}"
                                            Command="{Binding LoadMoreCommand}"/>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource SwebKitSurfaceCardStyle}"
                                Visibility="{Binding SelectContainerHintVisibility}">
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        Text="Select a container"
                                        Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                    <TextBlock
                                        Text="Pick a container from the left pane to browse folders, page through blobs, and open blob previews."
                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource SwebKitSurfaceCardStyle}"
                                Visibility="{Binding BlobDetailVisibility}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Spacing="4">
                                                <TextBlock Text="{Binding SelectedBlobTitle}"
                                                           Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock Text="{Binding SelectedBlobSubtitle}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock Text="{Binding BlobDetailStatusText}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Top">
                                                <Button Content="Download"
                                                        Command="{Binding DownloadSelectedBlobCommand}"/>
                                                <Button Content="Copy URL"
                                                        Command="{Binding CopySelectedBlobUrlCommand}"/>
                                                <Button Content="Copy SAS URL"
                                                        Command="{Binding CopySelectedBlobSasCommand}"/>
                                                <Button Content="Copy path"
                                                        Command="{Binding CopySelectedBlobPathCommand}"
                                                        Visibility="{Binding CopyBlobPathActionVisibility}"
                                                        IsEnabled="{Binding CanCopySelectedBlobPath}"/>
                                                <Button Content="Copy blob"
                                                        Click="CopyBlob_Click"
                                                        Visibility="{Binding CopyBlobActionVisibility}"
                                                        IsEnabled="{Binding CanCopySelectedBlob}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding BlobDetailErrorMessage}"
                                                   Visibility="{Binding BlobDetailErrorVisibility}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="WrapWholeWords"/>

                                        <ProgressRing IsActive="{Binding IsLoadingBlobDetail}"
                                                      Width="20"
                                                      Height="20"/>

                                        <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Properties"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <ItemsControl ItemsSource="{Binding BlobPropertyRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:StoragePropertyRowViewModel">
                                                            <Grid ColumnSpacing="12"
                                                                  Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="140"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Label}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind Value}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Metadata"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <Button Grid.Column="1"
                                                            Content="Edit metadata"
                                                            Click="EditMetadata_Click"
                                                            Visibility="{Binding EditMetadataActionVisibility}"
                                                            IsEnabled="{Binding CanEditSelectedBlobMetadata}"/>
                                                </Grid>
                                                <TextBlock Text="No metadata recorded for this blob."
                                                           Visibility="{Binding MetadataEmptyVisibility}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                <ItemsControl ItemsSource="{Binding MetadataRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:StorageKeyValueRowViewModel">
                                                            <Grid ColumnSpacing="12"
                                                                  Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="140"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Key}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind Value}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Tags"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <TextBlock Text="No blob index tags recorded for this blob."
                                                           Visibility="{Binding TagsEmptyVisibility}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                <ItemsControl ItemsSource="{Binding TagRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:StorageKeyValueRowViewModel">
                                                            <Grid ColumnSpacing="12"
                                                                  Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="140"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Key}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind Value}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Content preview"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="8">
                                                        <Button Content="Copy preview"
                                                                Visibility="{Binding CopyPreviewActionVisibility}"
                                                                Command="{Binding CopyPreviewContentCommand}"
                                                                IsEnabled="{Binding CanCopyPreviewContent}"/>
                                                        <Button Content="Load full preview"
                                                                Visibility="{Binding LoadExpandedPreviewVisibility}"
                                                                Command="{Binding LoadFullPreviewCommand}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding PreviewInfoMessage}"
                                                           Visibility="{Binding PreviewInfoVisibility}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>

                                                <TextBlock Text="Binary content is not previewed inline. Download this blob to inspect its full payload."
                                                           Visibility="{Binding BinaryPreviewVisibility}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>

                                                <TextBox Text="{Binding PreviewContent, Mode=OneWay}"
                                                         Visibility="{Binding PreviewVisibility}"
                                                         IsReadOnly="True"
                                                         AcceptsReturn="True"
                                                         TextWrapping="NoWrap"
                                                         FontFamily="Consolas"
                                                         MinHeight="280"
                                                         MaxHeight="420"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SwebKitInsetCardStyle}">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Spacing="4">
                                                        <TextBlock Text="Versions"
                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                        <TextBlock Text="{Binding VersionStatusText}"
                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                   TextWrapping="WrapWholeWords"/>
                                                    </StackPanel>

                                                    <ProgressRing Grid.Column="1"
                                                                  Width="20"
                                                                  Height="20"
                                                                  IsActive="{Binding IsLoadingVersions}"/>
                                                </Grid>

                                                <TextBlock Text="{Binding VersionErrorMessage}"
                                                           Visibility="{Binding VersionErrorVisibility}"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                           TextWrapping="WrapWholeWords"/>

                                                <TextBlock Text="No saved versions were returned for this blob."
                                                           Visibility="{Binding VersionEmptyVisibility}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>

                                                <ItemsControl ItemsSource="{Binding BlobVersions}"
                                                              Visibility="{Binding VersionListVisibility}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:StorageBlobVersionViewModel">
                                                            <Border Margin="0,0,0,8"
                                                                    Padding="12"
                                                                    CornerRadius="10"
                                                                    BorderThickness="1"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                                <StackPanel Spacing="8">
                                                                    <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0"
                                                                                    Spacing="2">
                                                                            <TextBlock Text="{x:Bind ShortVersionId}"
                                                                                       FontFamily="Consolas"
                                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                            <TextBlock Text="{x:Bind SummaryText}"
                                                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                                       TextWrapping="WrapWholeWords"/>
                                                                        </StackPanel>

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="Current"
                                                                                   Visibility="{x:Bind CurrentVersionVisibility}"
                                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Grid>

                                                                    <StackPanel Orientation="Horizontal"
                                                                                Spacing="8">
                                                                        <Button Content="Download"
                                                                                Command="{Binding ViewModel.DownloadVersionCommand, ElementName=PageRoot}"
                                                                                CommandParameter="{Binding}"/>
                                                                        <Button Content="Compare"
                                                                                Command="{Binding ViewModel.CompareVersionCommand, ElementName=PageRoot}"
                                                                                CommandParameter="{Binding}"/>
                                                                        <Button Content="Restore"
                                                                                Visibility="{Binding ViewModel.RestoreVersionActionVisibility, ElementName=PageRoot}"
                                                                                Command="{Binding ViewModel.RestoreVersionCommand, ElementName=PageRoot}"
                                                                                CommandParameter="{Binding}"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Style="{StaticResource SwebKitInsetCardStyle}"
                                                        Visibility="{Binding VersionComparisonVisibility}">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="Version comparison"
                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                            <ProgressRing Grid.Column="1"
                                                                          Width="20"
                                                                          Height="20"
                                                                          IsActive="{Binding IsLoadingVersionComparison}"/>
                                                        </Grid>

                                                        <TextBlock Text="{Binding VersionComparisonSummary}"
                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                   TextWrapping="WrapWholeWords"/>

                                                        <TextBox Text="{Binding VersionComparisonText, Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="NoWrap"
                                                                 FontFamily="Consolas"
                                                                 MinHeight="140"
                                                                 MaxHeight="280"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource SwebKitSurfaceCardStyle}"
                                Visibility="{Binding BlobDetailPlaceholderVisibility}">
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        Text="Select a blob"
                                        Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                    <TextBlock
                                        Text="Choose a blob from the list to inspect properties, metadata, tags, and a text-friendly preview."
                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </shared:PageScaffold.BodyContent>
    </shared:PageScaffold>
</Page>