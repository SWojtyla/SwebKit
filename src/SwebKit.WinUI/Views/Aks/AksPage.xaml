<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SwebKit.WinUI.Views.Aks.AksPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:SwebKit.WinUI.ViewModels.Aks"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24,16,24,24"
          RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                Text="AKS"
                Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock
                Text="Connect to the active cluster, switch contexts and namespaces, and browse pod health from the native WinUI workspace."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"/>
        </StackPanel>

        <Border
            Grid.Row="1"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="16">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Spacing="4">
                        <TextBlock
                            Text="Cluster connection"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock
                            Text="{Binding ConnectionSummary}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Top">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{Binding IsLoading}"/>
                        <Button
                            Content="Refresh"
                            Command="{Binding ReloadCommand}"/>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="WrapWholeWords"/>

                <InfoBar
                    IsOpen="{Binding ShowNotConfiguredState}"
                    Severity="Informational"
                    Title="AKS is not configured"
                    Message="Configure kubeconfig path, context, and default namespace in Settings before opening the AKS workspace.">
                    <InfoBar.ActionButton>
                        <Button
                            Content="Open Settings"
                            Command="{Binding OpenSettingsCommand}"/>
                    </InfoBar.ActionButton>
                </InfoBar>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Spacing="6">
                        <TextBlock
                            Text="Context"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                        <ComboBox
                            ItemsSource="{Binding ContextOptions}"
                            SelectedItem="{Binding SelectedContext, Mode=TwoWay}"
                            PlaceholderText="Select context"
                            IsEnabled="{Binding HasContextOptions}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Spacing="6">
                        <TextBlock
                            Text="Namespace"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                        <ComboBox
                            ItemsSource="{Binding NamespaceOptions}"
                            SelectedItem="{Binding SelectedNamespace, Mode=TwoWay}"
                            PlaceholderText="Select namespace"
                            IsEnabled="{Binding HasNamespaceOptions}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="16">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Spacing="4">
                        <TextBlock
                            Text="Pods"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock
                            Text="{Binding PodCountLabel}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Text="Health reflects readiness, restart pressure, and common failure states such as CrashLoopBackOff or ImagePullBackOff."
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords"
                        Width="320"/>
                </Grid>

                <InfoBar
                    Grid.Row="1"
                    IsOpen="{Binding ShowPodEmptyState}"
                    Severity="Informational"
                    Title="No pods found"
                    Message="The selected namespace currently has no pods to display."/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="6"
                        Padding="12,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                    Text="Health"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Column="1"
                                    Text="Pod"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Column="2"
                                    Text="Namespace"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Column="3"
                                    Text="Status"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Column="4"
                                    Text="Ready"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Column="5"
                                    Text="Restarts"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Column="6"
                                    Text="Node"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Grid>
                    </Border>

                    <ListView
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding Pods}"
                        SelectionMode="None"
                        IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:AksPodItemViewModel">
                                <Border
                                    Margin="0,0,0,8"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Padding="12,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                Text="{x:Bind Health}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                Text="{x:Bind Name}"
                                                TextWrapping="WrapWholeWords"/>
                                        <TextBlock Grid.Column="2"
                                                Text="{x:Bind Namespace}"
                                                TextWrapping="WrapWholeWords"/>
                                        <TextBlock Grid.Column="3"
                                                Text="{x:Bind Status}"
                                                TextWrapping="WrapWholeWords"/>
                                        <TextBlock Grid.Column="4"
                                                Text="{x:Bind Ready}"/>
                                        <TextBlock Grid.Column="5"
                                                Text="{x:Bind Restarts}"/>
                                        <TextBlock Grid.Column="6"
                                                Text="{x:Bind Node}"
                                                TextWrapping="WrapWholeWords"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>