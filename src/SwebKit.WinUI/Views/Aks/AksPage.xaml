<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SwebKit.WinUI.Views.Aks.AksPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:SwebKit.WinUI.Controls.Shared"
    xmlns:viewModels="using:SwebKit.WinUI.ViewModels.Aks"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    Background="{ThemeResource SwebKitPageBackgroundBrush}">

    <shared:PageScaffold
        Title="AKS"
        Subtitle="Connect to the active cluster, switch contexts and namespaces, and browse pod health from the native WinUI workspace.">
        <shared:PageScaffold.BodyContent>
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Style="{StaticResource SwebKitSurfaceCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Spacing="4">
                                <TextBlock
                                    Text="Cluster connection"
                                    Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                <TextBlock
                                    Text="{Binding ConnectionSummary}"
                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                    TextWrapping="WrapWholeWords"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Top">
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    IsActive="{Binding IsLoading}"/>
                                <Button
                                    Content="Refresh"
                                    Command="{Binding ReloadCommand}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="{Binding ErrorMessage}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="WrapWholeWords"/>

                        <InfoBar
                            IsOpen="{Binding ShowNotConfiguredState}"
                            Severity="Informational"
                            Title="AKS is not configured"
                            Message="Configure kubeconfig path, context, and default namespace in Settings before opening the AKS workspace.">
                            <InfoBar.ActionButton>
                                <Button
                                    Content="Open Settings"
                                    Command="{Binding OpenSettingsCommand}"/>
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Spacing="6">
                                <TextBlock
                                    Text="Context"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                                <ComboBox
                                    ItemsSource="{Binding ContextOptions}"
                                    SelectedItem="{Binding SelectedContext, Mode=TwoWay}"
                                    PlaceholderText="Select context"
                                    IsEnabled="{Binding HasContextOptions}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="6">
                                <TextBlock
                                    Text="Namespace"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                                <ComboBox
                                    ItemsSource="{Binding NamespaceOptions}"
                                    SelectedItem="{Binding SelectedNamespace, Mode=TwoWay}"
                                    PlaceholderText="Select namespace"
                                    IsEnabled="{Binding HasNamespaceOptions}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Style="{StaticResource SwebKitSurfaceCardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Spacing="4">
                                <TextBlock
                                    Text="Pods"
                                    Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                <TextBlock
                                    Text="{Binding PodCountLabel}"
                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Text="Health reflects readiness, restart pressure, and common failure states such as CrashLoopBackOff or ImagePullBackOff."
                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                TextWrapping="WrapWholeWords"
                                Width="320"/>
                        </Grid>

                        <InfoBar
                            Grid.Row="1"
                            IsOpen="{Binding ShowPodEmptyState}"
                            Severity="Informational"
                            Title="No pods found"
                            Message="The selected namespace currently has no pods to display."/>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Style="{StaticResource SwebKitInsetCardStyle}"
                                Padding="12,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Health"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Pod"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Namespace"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Grid.Column="3"
                                               Text="Status"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Grid.Column="4"
                                               Text="Ready"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Grid.Column="5"
                                               Text="Restarts"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Grid.Column="6"
                                               Text="Node"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Grid.Column="7"
                                               Text="Diagnostics"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                </Grid>
                            </Border>

                            <ListView
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                ItemsSource="{Binding Pods}"
                                SelectionMode="None"
                                IsItemClickEnabled="False">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:AksPodItemViewModel">
                                        <Border
                                            Margin="0,0,0,8"
                                            CornerRadius="6"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="12,10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Health}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Name}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind Namespace}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{x:Bind Status}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{x:Bind Ready}"/>
                                                <TextBlock Grid.Column="5"
                                                           Text="{x:Bind Restarts}"/>
                                                <TextBlock Grid.Column="6"
                                                           Text="{x:Bind Node}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <Button Grid.Column="7"
                                                        Content="Logs"
                                                        Command="{Binding ViewModel.SelectPodCommand, ElementName=PageRoot}"
                                                        CommandParameter="{x:Bind}"
                                                        IsEnabled="{x:Bind HasContainers}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Border Grid.Row="3"
                                Margin="0,12,0,0"
                                Style="{StaticResource SwebKitInsetCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Spacing="4">
                                        <TextBlock Text="{Binding SelectedPodLogsTitle}"
                                                   Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                        <TextBlock Text="{Binding SelectedPodLogsStatus}"
                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                   TextWrapping="WrapWholeWords"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding SelectedPodLogsActionsVisibility}">
                                        <ProgressRing Width="20"
                                                      Height="20"
                                                      IsActive="{Binding IsSelectedPodLogsLoading}"/>
                                        <Button Content="Open shell"
                                                Command="{Binding OpenSelectedPodShellCommand}"
                                                IsEnabled="{Binding CanOpenSelectedPodShell}"/>
                                        <Button Content="Port-forward"
                                                Command="{Binding OpenSelectedPodPortForwardCommand}"
                                                IsEnabled="{Binding CanStartSelectedPodPortForward}"/>
                                        <Button Content="Reload"
                                                Command="{Binding ReloadSelectedPodLogsCommand}"
                                                IsEnabled="{Binding CanReloadSelectedPodLogs}"/>
                                        <Button Content="Clear"
                                                Command="{Binding ClearSelectedPodSelectionCommand}"
                                                IsEnabled="{Binding CanClearSelectedPodSelection}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding SelectedPodLogsErrorMessage}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding SelectedPodLogsErrorVisibility}"
                                           TextWrapping="WrapWholeWords"/>

                                <InfoBar Grid.Row="1"
                                         IsOpen="{Binding ShowSelectPodLogsHint}"
                                         Severity="Informational"
                                         Title="No pod selected"
                                         Message="Select a pod from the list to open logs and diagnostics without taking over the whole page."/>

                                <Grid Grid.Row="2"
                                      ColumnSpacing="12"
                                      Visibility="{Binding SelectedPodLogsContentVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Spacing="6">
                                        <TextBlock Text="Container"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <ComboBox ItemsSource="{Binding SelectedPodContainerOptions}"
                                                  SelectedItem="{Binding SelectedPodLogContainer, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasMultipleSelectedPodContainers}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Spacing="6">
                                        <TextBlock Text="Range"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <ComboBox ItemsSource="{Binding LogRangeOptions}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Label"
                                                  SelectedValue="{Binding SelectedPodLogRange, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanInspectSelectedPodLogs}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Spacing="6">
                                        <TextBlock Text="Live"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <ToggleSwitch OnContent=""
                                                      OffContent=""
                                                      IsOn="{Binding FollowSelectedPodLogs, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanToggleSelectedPodLogsLive}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3"
                                                Spacing="6">
                                        <TextBlock Text="Filter"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <TextBox Text="{Binding LogFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Filter log output"
                                                 IsEnabled="{Binding CanInspectSelectedPodLogs}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBox Grid.Row="3"
                                         MinHeight="220"
                                         MaxHeight="360"
                                         Text="{Binding SelectedPodLogsText}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         Visibility="{Binding SelectedPodLogsContentVisibility}"
                                         FontFamily="Cascadia Mono"/>

                                <Border Grid.Row="4"
                                        Margin="0,12,0,0"
                                        Style="{StaticResource SwebKitInsetCardStyle}"
                                        Visibility="{Binding PortForwardFormVisibility}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Start port-forward"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{Binding PortForwardSelectedPodLabel}"
                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                   TextWrapping="WrapWholeWords"/>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Spacing="6">
                                                <TextBlock Text="Remote port"
                                                           Style="{StaticResource CaptionTextBlockStyle}"/>
                                                <TextBox Text="{Binding PortForwardRemotePortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         InputScope="Number"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Spacing="6">
                                                <TextBlock Text="Local port"
                                                           Style="{StaticResource CaptionTextBlockStyle}"/>
                                                <TextBox Text="{Binding PortForwardLocalPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         InputScope="Number"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding PortForwardValidationMessage}"
                                                   Visibility="{Binding PortForwardValidationVisibility}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="WrapWholeWords"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <Button Content="Start"
                                                    Command="{Binding StartSelectedPodPortForwardCommand}"
                                                    IsEnabled="{Binding CanStartSelectedPodPortForward}"/>
                                            <Button Content="Cancel"
                                                    Command="{Binding CancelSelectedPodPortForwardCommand}"
                                                    IsEnabled="{Binding IsPortForwardStarting, Converter={StaticResource InverseBooleanConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="5"
                                        Margin="0,12,0,0"
                                        Style="{StaticResource SwebKitInsetCardStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Spacing="4">
                                                <TextBlock Text="Port-forward sessions"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <TextBlock Text="{Binding PortForwardSummary}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Stop all"
                                                    Command="{Binding StopAllPortForwardSessionsCommand}"
                                                    IsEnabled="{Binding CanStopAllPortForwardSessions}"/>
                                        </Grid>

                                        <InfoBar IsOpen="{Binding ShowPortForwardSessionsEmptyState}"
                                                 Severity="Informational"
                                                 Title="No sessions yet"
                                                 Message="Start a pod port-forward from the diagnostics surface to keep the session visible in this native workspace."/>

                                        <ListView ItemsSource="{Binding PortForwardSessions}"
                                                  Visibility="{Binding PortForwardSessionsVisibility}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:AksPortForwardSessionItemViewModel">
                                                    <Border Margin="0,0,0,8"
                                                            CornerRadius="6"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Padding="12,10">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="110"/>
                                                                    <ColumnDefinition Width="150"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0"
                                                                            Spacing="2">
                                                                    <TextBlock Text="{x:Bind PodName}"
                                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                               TextWrapping="WrapWholeWords"/>
                                                                    <TextBlock Text="{x:Bind Namespace}"
                                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                               TextWrapping="WrapWholeWords"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind PortsLabel}"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Cascadia Mono"
                                                                           TextWrapping="WrapWholeWords"/>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="{x:Bind StatusLabel}"
                                                                           VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Column="3"
                                                                           Text="{x:Bind StartedText}"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>

                                                                <Button Grid.Column="4"
                                                                        Content="Stop"
                                                                        Command="{Binding ViewModel.StopPortForwardSessionCommand, ElementName=PageRoot}"
                                                                        CommandParameter="{x:Bind}"
                                                                        IsEnabled="{x:Bind CanStop}"/>
                                                            </Grid>

                                                            <TextBlock Text="{x:Bind ErrorText}"
                                                                       Visibility="{x:Bind ErrorVisibility}"
                                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                       TextWrapping="WrapWholeWords"
                                                                       FontFamily="Cascadia Mono"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </shared:PageScaffold.BodyContent>
    </shared:PageScaffold>
</Page>