<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SwebKit.WinUI.Views.Observability.ObservabilityPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:SwebKit.WinUI.Controls.Shared"
    xmlns:viewModels="using:SwebKit.WinUI.ViewModels.Observability"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    Background="{ThemeResource SwebKitPageBackgroundBrush}">

    <shared:PageScaffold
        Title="Observability"
        Subtitle="Discover Application Insights resources, activate a provider, and inspect overview, failures, performance, logs, and availability from one native WinUI baseline."
        IsHeaderCompact="True">
        <shared:PageScaffold.ContextContent>
            <Border Style="{StaticResource SwebKitSurfaceCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Spacing="4">
                            <TextBlock
                                Text="Resource discovery and provider activation"
                                Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                            <TextBlock
                                Text="{Binding ConnectionSummary}"
                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                TextWrapping="WrapWholeWords"/>
                            <TextBlock
                                Text="{Binding DiscoverySummary}"
                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                TextWrapping="WrapWholeWords"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    VerticalAlignment="Top">
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{Binding IsLoadingResources}"/>
                            <Button
                                Content="Refresh resources"
                                Command="{Binding ReloadResourcesCommand}"/>
                            <Button
                                Content="Refresh tab"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding HasActiveResource}"/>
                            <Button
                                Content="Investigate"
                                Command="{Binding InvestigateActiveResourceCommand}"
                                IsEnabled="{Binding CanInvestigateActiveResource}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{Binding ResourceErrorMessage}"
                        Visibility="{Binding ResourceErrorVisibility}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="WrapWholeWords"/>

                    <InfoBar
                        IsOpen="{Binding ShowReadinessState}"
                        Severity="Warning"
                        Title="{Binding ReadinessTitle}"
                        Message="{Binding ReadinessMessage}">
                        <InfoBar.ActionButton>
                            <Button
                                Content="Open Settings"
                                Command="{Binding OpenSettingsCommand}"/>
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Spacing="4">
                            <TextBlock
                                Text="{Binding ActiveResourceTitle}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock
                                Text="{Binding ActiveResourceSubtitle}"
                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                TextWrapping="WrapWholeWords"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4">
                            <TextBlock
                                Text="Provider"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Text="{Binding ProviderLabel}"/>
                            <TextBlock
                                Text="{Binding LastRefreshLabel}"
                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="6"
                                    MinWidth="200">
                            <TextBlock
                                Text="Time range"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                            <ComboBox
                                ItemsSource="{Binding TimeRangeOptions}"
                                SelectedItem="{Binding SelectedTimeRangeOption, Mode=TwoWay}"
                                DisplayMemberPath="Label"
                                HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{Binding ActiveTabErrorMessage}"
                        Visibility="{Binding ActiveTabErrorVisibility}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="WrapWholeWords"/>
                </StackPanel>
            </Border>
        </shared:PageScaffold.ContextContent>
        <shared:PageScaffold.BodyContent>
            <Grid>
                <Grid
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Style="{StaticResource SwebKitSurfaceCardStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Spacing="4">
                                    <TextBlock
                                        Text="Application Insights resources"
                                        Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                    <TextBlock
                                        Text="Select a discovered resource and activate it before running the native tabs."
                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>

                                <ProgressRing
                                    Grid.Column="1"
                                    Width="20"
                                    Height="20"
                                    IsActive="{Binding IsLoadingResources}"/>
                            </Grid>

                            <InfoBar
                                Grid.Row="1"
                                IsOpen="{Binding ShowNoResourcesState}"
                                Severity="Informational"
                                Title="No resources discovered"
                                Message="Run a scan with an authenticated Azure credential, or switch to demo mode to activate sample resources."/>

                            <ListView
                                Grid.Row="2"
                                ItemsSource="{Binding Resources}"
                                SelectedItem="{Binding SelectedDiscoveryResource, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ObservabilityResourceItemViewModel">
                                        <Border
                                            Margin="0,0,0,10"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="12">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Spacing="4">
                                                        <TextBlock
                                                            Text="{x:Bind Name}"
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            TextWrapping="WrapWholeWords"/>
                                                        <TextBlock
                                                            Text="{x:Bind ScopeLabel}"
                                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                            TextWrapping="WrapWholeWords"/>
                                                        <TextBlock
                                                            Text="{x:Bind LocationLabel}"
                                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                            TextWrapping="WrapWholeWords"/>
                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind ActiveStateLabel}"
                                                        Visibility="{x:Bind ActiveVisibility, Mode=OneWay}"
                                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                        VerticalAlignment="Top"/>
                                                </Grid>

                                                <Button
                                                    Content="Activate"
                                                    Command="{Binding ViewModel.ActivateResourceCommand, ElementName=PageRoot}"
                                                    CommandParameter="{x:Bind}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button
                                    Content="Activate selected"
                                    Command="{Binding ActivateSelectedResourceCommand}"
                                    IsEnabled="{Binding HasSelectedDiscoveryResource}"/>
                                <Button
                                    Content="Run logs"
                                    Command="{Binding RunLogsQueryCommand}"
                                    IsEnabled="{Binding HasActiveResource}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1"
                          RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Style="{StaticResource SwebKitSurfaceCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Spacing="4">
                                    <TextBlock
                                        Text="Tab status"
                                        Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                    <TextBlock
                                        Text="{Binding ActiveTabStatusText}"
                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>

                                <ProgressRing
                                    Grid.Column="1"
                                    Width="20"
                                    Height="20"
                                    IsActive="{Binding IsActivatingResource}"/>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Style="{StaticResource SwebKitSurfaceCardStyle}"
                            Visibility="{Binding EmptyStateVisibility}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Text="Activate a resource to open the native Observability tabs"
                                    Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                <TextBlock
                                    Text="This native workspace keeps discovery, provider activation, overview analysis, logs, failures, performance, and availability in one WinUI surface. Advanced logs remains text-first, while overview trends, deployment comparison, SLO status, dimension pivots, and the availability heatmap now render natively."
                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                    TextWrapping="WrapWholeWords"/>
                                <Button
                                    Content="Activate selected resource"
                                    Command="{Binding ActivateSelectedResourceCommand}"
                                    IsEnabled="{Binding HasSelectedDiscoveryResource}"/>
                            </StackPanel>
                        </Border>

                        <TabView
                            Grid.Row="1"
                            Visibility="{Binding ResourceWorkspaceVisibility}"
                            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                            <TabViewItem Header="Overview">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="16"
                                                Padding="0,4,0,0">
                                        <Grid ColumnSpacing="12"
                                              RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Row="0"
                                                    Grid.Column="0"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Requests"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding RequestCountText}"
                                                               Style="{StaticResource TitleTextBlockStyle}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="0"
                                                    Grid.Column="1"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Failure rate"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding FailureRateText}"
                                                               Style="{StaticResource TitleTextBlockStyle}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="0"
                                                    Grid.Column="2"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Availability"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding AvailabilityText}"
                                                               Style="{StaticResource TitleTextBlockStyle}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="1"
                                                    Grid.Column="0"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="P50 latency"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding P50ResponseTimeText}"
                                                               Style="{StaticResource TitleTextBlockStyle}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="1"
                                                    Grid.Column="1"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="P95 latency"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding P95ResponseTimeText}"
                                                               Style="{StaticResource TitleTextBlockStyle}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="1"
                                                    Grid.Column="2"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Exceptions"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding ExceptionCountText}"
                                                               Style="{StaticResource TitleTextBlockStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Visibility="{Binding OverviewRequestChartVisibility}"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="Request volume"
                                                               Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                    <TextBlock Text="Recent request trend returned for the active range."
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                    <Border MinHeight="220"
                                                            CornerRadius="8"
                                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Padding="12">
                                                        <lvc:CartesianChart Series="{Binding OverviewRequestSeries}"
                                                                            XAxes="{Binding OverviewRequestXAxes}"
                                                                            YAxes="{Binding OverviewRequestYAxes}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1"
                                                    Visibility="{Binding OverviewFailureChartVisibility}"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="Failure rate trend"
                                                               Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                    <TextBlock Text="Recent failure-rate trend returned for the active range."
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                    <Border MinHeight="220"
                                                            CornerRadius="8"
                                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Padding="12">
                                                        <lvc:CartesianChart Series="{Binding OverviewFailureSeries}"
                                                                            XAxes="{Binding OverviewFailureXAxes}"
                                                                            YAxes="{Binding OverviewFailureYAxes}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="Dependency health"
                                                               Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding DependencyHeadline}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                    <InfoBar IsOpen="{Binding ShowDependencyEmptyState}"
                                                             Severity="Informational"
                                                             Title="No dependency anomalies surfaced"
                                                             Message="The explainer seam is active, but this window returned no dependency rows yet."/>
                                                    <ItemsControl ItemsSource="{Binding DependencyHealthEntries}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:ObservabilityDependencyHealthItemViewModel">
                                                                <Border Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="10">
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{x:Bind DependencyName}"
                                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                        <TextBlock Text="{x:Bind SummaryText}"
                                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                        <TextBlock Text="{x:Bind HealthText}"
                                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="Dimension pivots"
                                                               Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding BreakdownHeadline}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                    <InfoBar IsOpen="{Binding ShowDimensionEmptyState}"
                                                             Severity="Informational"
                                                             Title="No dimension pivots returned"
                                                             Message="This window returned no high-signal cloud role or operation pivots for the active resource."/>
                                                    <ItemsControl ItemsSource="{Binding DimensionBreakdowns}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:ObservabilityDimensionBreakdownItemViewModel">
                                                                <Border Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="10">
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{x:Bind Label}"
                                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                        <TextBlock Text="{x:Bind SummaryText}"
                                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="Deployment comparison"
                                                               Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding DeploymentComparisonHeadline}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                    <TextBlock Text="{Binding DeploymentComparisonSummaryText}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>

                                                    <ComboBox ItemsSource="{Binding DeploymentAnchors}"
                                                              SelectedItem="{Binding SelectedDeploymentAnchor, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch"
                                                              PlaceholderText="Select a release anchor">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:ObservabilityDeploymentAnchorItemViewModel">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{x:Bind ReleaseName}"/>
                                                                    <TextBlock Text="{x:Bind AnchorTimeText}"
                                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <InfoBar IsOpen="{Binding ShowDeploymentAnchorEmptyState}"
                                                             Severity="Informational"
                                                             Title="No release anchors available"
                                                             Message="Deployment comparison needs release snapshots with deployed timestamps in the Releases workspace."/>

                                                    <InfoBar IsOpen="{Binding ShowDeploymentComparisonPlaceholder}"
                                                             Severity="Informational"
                                                             Title="Select a release anchor"
                                                             Message="Choose a recorded release to compare overview telemetry four hours before and after deployment."/>

                                                    <InfoBar IsOpen="{Binding ShowDeploymentComparisonEmptyState}"
                                                             Severity="Informational"
                                                             Title="No comparison loaded"
                                                             Message="{Binding DeploymentComparisonSummaryText}"/>

                                                    <Border Visibility="{Binding DeploymentComparisonBadgeVisibility}"
                                                            CornerRadius="999"
                                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Padding="10,4">
                                                        <TextBlock Text="{Binding DeploymentComparisonBadgeText}"
                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    </Border>

                                                    <TextBlock Text="{Binding DeploymentComparisonWindowText}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>

                                                    <ProgressRing Width="20"
                                                                  Height="20"
                                                                  IsActive="{Binding IsLoadingDeploymentComparison}"
                                                                  HorizontalAlignment="Left"/>

                                                    <ItemsControl ItemsSource="{Binding DeploymentComparisonDeltas}"
                                                                  Visibility="{Binding DeploymentComparisonContentVisibility}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:ObservabilityMetricDeltaItemViewModel">
                                                                <Border Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="10">
                                                                    <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0"
                                                                                    Spacing="2">
                                                                            <TextBlock Text="{x:Bind MetricLabel}"
                                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                            <TextBlock Text="{x:Bind BeforeText}"
                                                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                            <TextBlock Text="{x:Bind AfterText}"
                                                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="1"
                                                                                    HorizontalAlignment="Right"
                                                                                    Spacing="2">
                                                                            <TextBlock Text="{x:Bind ChangeText}"
                                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                            <TextBlock Text="{x:Bind ChangeDirectionLabel}"
                                                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="SLO status"
                                                               Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding SloStatusHeadline}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                    <TextBlock Text="{Binding SloStatusSummaryText}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>

                                                    <InfoBar IsOpen="{Binding ShowSloNotConfiguredState}"
                                                             Severity="Informational"
                                                             Title="No SLO definitions configured"
                                                             Message="Add SLO targets in Observability settings to track them in the native workspace."/>

                                                    <InfoBar IsOpen="{Binding ShowSloEmptyState}"
                                                             Severity="Informational"
                                                             Title="No SLO evaluation available"
                                                             Message="Configured SLOs did not return comparable overview metrics for this window."/>

                                                    <Border Visibility="{Binding SloStatusBadgeVisibility}"
                                                            CornerRadius="999"
                                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Padding="10,4">
                                                        <TextBlock Text="{Binding SloStatusBadgeText}"
                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    </Border>

                                                    <ProgressRing Width="20"
                                                                  Height="20"
                                                                  IsActive="{Binding IsLoadingSloStatus}"
                                                                  HorizontalAlignment="Left"/>

                                                    <ItemsControl ItemsSource="{Binding SloStatusEntries}"
                                                                  Visibility="{Binding SloStatusEntriesVisibility}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:ObservabilitySloStatusEntryItemViewModel">
                                                                <Border Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="10">
                                                                    <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0"
                                                                                    Spacing="2">
                                                                            <TextBlock Text="{x:Bind Name}"
                                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                            <TextBlock Text="{x:Bind MetricLabel}"
                                                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                            <TextBlock Text="{x:Bind CurrentValueText}"
                                                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                            <TextBlock Text="{x:Bind TargetValueText}"
                                                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                        </StackPanel>

                                                                        <Border Grid.Column="1"
                                                                                Background="{x:Bind StateBackgroundBrush}"
                                                                                CornerRadius="999"
                                                                                Padding="10,4"
                                                                                VerticalAlignment="Top">
                                                                            <TextBlock Text="{x:Bind StateLabel}"
                                                                                       Foreground="{x:Bind StateForegroundBrush}"
                                                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabViewItem>

                            <TabViewItem Header="Failures">
                                <Grid ColumnSpacing="16"
                                      Padding="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Exception groups"
                                                       Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                            <InfoBar IsOpen="{Binding ShowFailuresEmptyState}"
                                                     Severity="Informational"
                                                     Title="No failures returned"
                                                     Message="This time window returned no exception groups for the active resource."/>
                                            <ListView ItemsSource="{Binding Failures}"
                                                      SelectedItem="{Binding SelectedFailure, Mode=TwoWay}">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:ObservabilityFailureItemViewModel">
                                                        <Border Margin="0,0,0,8"
                                                                CornerRadius="6"
                                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                Padding="10">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="{x:Bind DetailLabel}"
                                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                                <TextBlock Text="{x:Bind CountText}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                <TextBlock Text="{x:Bind LastSeenText}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                <TextBlock Text="{x:Bind Message}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="12">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0"
                                                        Spacing="4">
                                                <TextBlock Text="{Binding SelectedFailureTitle}"
                                                           Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock Text="{Binding SelectedFailureSubtitle}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1"
                                                        Spacing="8">
                                                <TextBlock Text="{Binding SelectedFailureMessage}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8">
                                                    <Button Content="Drill to logs"
                                                            Command="{Binding DrillFailureToLogsCommand}"
                                                            IsEnabled="{Binding HasSelectedFailure}"/>
                                                    <Button Content="Trace sample"
                                                            Command="{Binding DrillFailureTraceToLogsCommand}"
                                                            IsEnabled="{Binding HasSelectedFailureSampleTrace}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedFailureSampleTraceLabel}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>

                                            <ScrollViewer Grid.Row="2"
                                                          VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding SelectedFailureStackTrace}"
                                                           FontFamily="Cascadia Mono"
                                                           TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabViewItem>

                            <TabViewItem Header="Performance">
                                <Grid ColumnSpacing="16"
                                      Padding="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Operation performance"
                                                       Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                            <InfoBar IsOpen="{Binding ShowPerformanceEmptyState}"
                                                     Severity="Informational"
                                                     Title="No performance rows returned"
                                                     Message="The active resource returned no operation performance summaries for this window."/>
                                            <ListView ItemsSource="{Binding PerformanceEntries}"
                                                      SelectedItem="{Binding SelectedPerformanceEntry, Mode=TwoWay}">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:ObservabilityPerformanceItemViewModel">
                                                        <Border Margin="0,0,0,8"
                                                                CornerRadius="6"
                                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                Padding="10">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="{x:Bind OperationName}"
                                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                                <TextBlock Text="{x:Bind RequestCountText}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                <TextBlock Text="{x:Bind FailureRateText}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                <TextBlock Text="{x:Bind P95Text}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                <TextBlock Text="{x:Bind P99Text}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{Binding SelectedPerformanceTitle}"
                                                       Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"
                                                       TextWrapping="WrapWholeWords"/>
                                            <TextBlock Text="{Binding SelectedPerformanceSubtitle}"
                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                       TextWrapping="WrapWholeWords"/>
                                            <TextBlock Text="{Binding PerformanceTrendSummary}"
                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                       TextWrapping="WrapWholeWords"/>
                                            <Border Visibility="{Binding PerformanceTrendChartVisibility}"
                                                    MinHeight="260"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <lvc:CartesianChart Series="{Binding PerformanceTrendSeries}"
                                                                    XAxes="{Binding PerformanceTrendXAxes}"
                                                                    YAxes="{Binding PerformanceTrendYAxes}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabViewItem>

                            <TabViewItem Header="Logs">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="16"
                                                Padding="0,4,0,0">
                                        <Border CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="12">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Spacing="4">
                                                        <TextBlock Text="Logs mode"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                                        <ComboBox ItemsSource="{Binding LogsWorkspace.LogsModeOptions}"
                                                                  SelectedItem="{Binding LogsWorkspace.SelectedLogsMode, Mode=TwoWay}"
                                                                  DisplayMemberPath="Label"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                Spacing="4">
                                                        <TextBlock Text="Preset"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                                        <ComboBox ItemsSource="{Binding LogsWorkspace.QueryPresets}"
                                                                  SelectedItem="{Binding LogsWorkspace.SelectedQueryPreset, Mode=TwoWay}"
                                                                  DisplayMemberPath="Name"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="2"
                                                            Content="Apply preset"
                                                            Command="{Binding ApplySelectedPresetCommand}"
                                                            VerticalAlignment="Bottom"/>

                                                    <Button Grid.Column="3"
                                                            Content="Run query"
                                                            Command="{Binding RunLogsQueryCommand}"
                                                            VerticalAlignment="Bottom"
                                                            IsEnabled="{Binding HasActiveResource}"/>
                                                </Grid>

                                                <TextBlock Text="{Binding LogsWorkspace.LogsModeDescription}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock Text="{Binding LogsWorkspace.SelectedPresetDescription}"
                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                           TextWrapping="WrapWholeWords"/>

                                                <Border CornerRadius="8"
                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Padding="12">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock Text="Saved queries"
                                                                   Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                        <TextBlock Text="{Binding LogsWorkspace.SavedQueriesSummary}"
                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                   TextWrapping="WrapWholeWords"/>

                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Column="0"
                                                                     Text="{Binding LogsWorkspace.SaveQueryName, Mode=TwoWay}"
                                                                     PlaceholderText="Name the current query before saving it"/>

                                                            <Button Grid.Column="1"
                                                                    Content="Save current query"
                                                                    Command="{Binding SaveCurrentQueryCommand}"
                                                                    IsEnabled="{Binding CanSaveQuery}"/>
                                                        </Grid>

                                                        <InfoBar IsOpen="{Binding LogsWorkspace.ShowSavedQueriesEmptyState}"
                                                                 Severity="Informational"
                                                                 Title="No saved queries yet"
                                                                 Message="Name the current query and save it to persist it in the Observability profile."/>

                                                        <ItemsControl ItemsSource="{Binding LogsWorkspace.SavedQueries}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="viewModels:ObservabilitySavedQueryItemViewModel">
                                                                    <Border Margin="0,0,0,8"
                                                                            CornerRadius="6"
                                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                            BorderThickness="1"
                                                                            Padding="10">
                                                                        <StackPanel Spacing="8">
                                                                            <StackPanel Spacing="4">
                                                                                <TextBlock Text="{x:Bind Name}"
                                                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                                           TextWrapping="WrapWholeWords"/>
                                                                                <TextBlock Text="{x:Bind Summary}"
                                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                                           TextWrapping="WrapWholeWords"/>
                                                                                <TextBlock Text="{x:Bind CreatedAtText}"
                                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                            </StackPanel>

                                                                            <StackPanel Orientation="Horizontal"
                                                                                        Spacing="8">
                                                                                <Button Content="Run"
                                                                                        Command="{Binding ViewModel.LoadSavedQueryCommand, ElementName=PageRoot}"
                                                                                        CommandParameter="{x:Bind}"/>
                                                                                <Button Content="Delete"
                                                                                        Command="{Binding ViewModel.DeleteSavedQueryCommand, ElementName=PageRoot}"
                                                                                        CommandParameter="{x:Bind}"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Visibility="{Binding LogsWorkspace.AdvancedModeVisibility}"
                                                            Spacing="8">
                                                    <TextBlock Text="Advanced KQL"
                                                               Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                    <TextBox Text="{Binding LogsWorkspace.AdvancedQueryText, Mode=TwoWay}"
                                                             KeyDown="OnAdvancedQueryTextBoxKeyDown"
                                                             AcceptsReturn="True"
                                                             TextWrapping="NoWrap"
                                                             FontFamily="Cascadia Mono"
                                                             MinHeight="160"/>
                                                </StackPanel>

                                                <StackPanel Visibility="{Binding LogsWorkspace.GuidedModeVisibility}"
                                                            Spacing="8">
                                                    <TextBlock Text="Guided draft"
                                                               Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                    <Grid ColumnSpacing="12"
                                                          RowSpacing="12">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    Spacing="4">
                                                            <TextBlock Text="Table"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                                            <TextBox Text="{Binding LogsWorkspace.GuidedTableName, Mode=TwoWay}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="0"
                                                                    Grid.Column="1"
                                                                    Spacing="4">
                                                            <TextBlock Text="Filter column"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                                            <TextBox Text="{Binding LogsWorkspace.GuidedFilterColumn, Mode=TwoWay}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="0"
                                                                    Grid.Column="2"
                                                                    Spacing="4">
                                                            <TextBlock Text="Operator"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                                            <ComboBox ItemsSource="{Binding LogsWorkspace.GuidedOperatorOptions}"
                                                                      SelectedItem="{Binding LogsWorkspace.SelectedGuidedOperator, Mode=TwoWay}"
                                                                      DisplayMemberPath="Label"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="0"
                                                                    Grid.Column="3"
                                                                    Spacing="4">
                                                            <TextBlock Text="Limit"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                                            <TextBox Text="{Binding LogsWorkspace.GuidedLimitText, Mode=TwoWay}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="1"
                                                                    Grid.Column="0"
                                                                    Grid.ColumnSpan="4"
                                                                    Spacing="4">
                                                            <TextBlock Text="Filter value"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                                            <TextBox Text="{Binding LogsWorkspace.GuidedFilterValue, Mode=TwoWay}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="{Binding LogsWorkspace.GuidedCompileSummary}"
                                                               Visibility="{Binding LogsWorkspace.GuidedCompileSummaryVisibility}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                    <TextBox Text="{Binding LogsWorkspace.GuidedCompiledQuery, Mode=OneWay}"
                                                             Visibility="{Binding LogsWorkspace.GuidedCompiledQueryVisibility}"
                                                             AcceptsReturn="True"
                                                             IsReadOnly="True"
                                                             TextWrapping="NoWrap"
                                                             FontFamily="Cascadia Mono"
                                                             MinHeight="120"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="Query results"
                                                               Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding LogsWorkspace.LogsResultSummary}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                    <InfoBar IsOpen="{Binding ShowLogsEmptyState}"
                                                             Severity="Informational"
                                                             Title="No log rows returned"
                                                             Message="Run a preset or enter a query to populate the native logs preview."/>
                                                    <ListView ItemsSource="{Binding LogRows}">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:ObservabilityLogRowItemViewModel">
                                                                <Border Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="10">
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{x:Bind PrimaryText}"
                                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                                   TextWrapping="WrapWholeWords"/>
                                                                        <TextBlock Text="{x:Bind SecondaryText}"
                                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                                   TextWrapping="WrapWholeWords"/>
                                                                        <TextBlock Text="{x:Bind DetailText}"
                                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                                   FontFamily="Cascadia Mono"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="Baseline notes"
                                                               Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                    <TextBlock Text="{Binding MaxRowsSummary}"
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                    <TextBlock Text="The current logs experience stays native and text-first. Press Ctrl+Enter to run the current KQL, or use presets and saved queries for repeat workflows while Monaco remains deferred to a later shared editor host wave."
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                    <TextBlock Text="Overview and availability now render native request, failure, bar-chart, and hourly heatmap visuals without returning to the MAUI host."
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabViewItem>

                            <TabViewItem Header="Availability">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12"
                                                Padding="0,4,0,0">
                                        <Border CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Availability checks"
                                                           Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                <InfoBar IsOpen="{Binding ShowAvailabilityEmptyState}"
                                                         Severity="Informational"
                                                         Title="No availability rows returned"
                                                         Message="The active resource returned no availability results for the current window."/>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Spacing="4">
                                                        <TextBlock Text="{Binding AvailabilityChartSummary}"
                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                   TextWrapping="WrapWholeWords"/>
                                                        <TextBlock Text="{Binding OverallAvailabilityText}"
                                                                   Style="{StaticResource TitleTextBlockStyle}"/>
                                                        <TextBlock Text="{Binding AvailabilityPassFailSummary}"
                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Content="{Binding AvailabilityViewToggleLabel}"
                                                            Command="{Binding ToggleAvailabilityViewCommand}"
                                                            VerticalAlignment="Top"
                                                            IsEnabled="{Binding HasAvailabilityResults}"/>
                                                </Grid>
                                                <Border Visibility="{Binding AvailabilityChartVisibility}"
                                                        MinHeight="240"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Padding="12">
                                                    <lvc:CartesianChart Series="{Binding AvailabilityChartSeries}"
                                                                        XAxes="{Binding AvailabilityChartXAxes}"
                                                                        YAxes="{Binding AvailabilityChartYAxes}"/>
                                                </Border>

                                                <StackPanel Visibility="{Binding AvailabilityHeatmapVisibility}"
                                                            Spacing="8">
                                                    <TextBlock Text="Hourly heatmap"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <TextBlock Text="The WinUI host now mirrors the existing availability heatmap by grouping pass rate per test and hour over the current window."
                                                               Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                               TextWrapping="WrapWholeWords"/>
                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                  VerticalScrollBarVisibility="Disabled">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="160"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Text="Test"
                                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                                           VerticalAlignment="Center"/>

                                                                <ItemsControl Grid.Column="1"
                                                                              ItemsSource="{Binding AvailabilityHeatmapHourLabels}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Width="88"
                                                                                    Margin="0,0,6,0"
                                                                                    Padding="6,0"
                                                                                    Background="Transparent">
                                                                                <TextBlock Text="{Binding}"
                                                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                                                           TextAlignment="Center"
                                                                                           TextWrapping="WrapWholeWords"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>

                                                            <ItemsControl ItemsSource="{Binding AvailabilityHeatmapRows}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="viewModels:ObservabilityAvailabilityHeatmapRowViewModel">
                                                                        <Grid ColumnSpacing="8"
                                                                              Margin="0,0,0,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="160"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <TextBlock Text="{x:Bind TestName}"
                                                                                       VerticalAlignment="Center"
                                                                                       TextWrapping="WrapWholeWords"/>

                                                                            <ItemsControl Grid.Column="1"
                                                                                          ItemsSource="{x:Bind Cells}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal"/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="viewModels:ObservabilityAvailabilityHeatmapCellViewModel">
                                                                                        <Border Width="88"
                                                                                                Height="52"
                                                                                                Margin="0,0,6,0"
                                                                                                CornerRadius="6"
                                                                                                Background="{x:Bind BackgroundBrush}"
                                                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                                                BorderThickness="1"
                                                                                                Padding="6">
                                                                                            <ToolTipService.ToolTip>
                                                                                                <ToolTip Content="{x:Bind TooltipText}"/>
                                                                                            </ToolTipService.ToolTip>
                                                                                            <StackPanel VerticalAlignment="Center"
                                                                                                        Spacing="2">
                                                                                                <TextBlock Text="{x:Bind ValueText}"
                                                                                                           Foreground="{x:Bind ForegroundBrush}"
                                                                                                           FontFamily="Cascadia Mono"
                                                                                                           HorizontalAlignment="Center"/>
                                                                                                <TextBlock Text="{x:Bind CountText}"
                                                                                                           Foreground="{x:Bind ForegroundBrush}"
                                                                                                           FontSize="11"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           TextWrapping="WrapWholeWords"/>
                                                                                            </StackPanel>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </StackPanel>

                                                <Grid Visibility="{Binding AvailabilityListVisibility}"
                                                      ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ListView Grid.Column="0"
                                                              ItemsSource="{Binding AvailabilityResults}"
                                                              SelectedItem="{Binding SelectedAvailabilityResult, Mode=TwoWay}">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:ObservabilityAvailabilityItemViewModel">
                                                                <Border Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="10">
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{x:Bind TestName}"
                                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                        <TextBlock Text="{x:Bind SummaryText}"
                                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                        <TextBlock Text="{x:Bind StatusText}"
                                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                        <TextBlock Text="{x:Bind DurationText}"
                                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                                   TextWrapping="WrapWholeWords"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>

                                                    <Border Grid.Column="1"
                                                            CornerRadius="8"
                                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Padding="12">
                                                        <Grid>
                                                            <StackPanel Visibility="{Binding AvailabilityDetailPlaceholderVisibility}"
                                                                        Spacing="8">
                                                                <TextBlock Text="Select an availability check"
                                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                <TextBlock Text="Choose a row from the list to inspect the selected test result without leaving the current tab."
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                            </StackPanel>

                                                            <StackPanel Visibility="{Binding AvailabilityDetailContentVisibility}"
                                                                        Spacing="8">
                                                                <TextBlock Text="{Binding SelectedAvailabilityTitle}"
                                                                           Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                                <TextBlock Text="{Binding SelectedAvailabilitySubtitle}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                           TextWrapping="WrapWholeWords"/>

                                                                <Grid ColumnSpacing="12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Grid.Column="0"
                                                                                Spacing="4">
                                                                        <TextBlock Text="Result"
                                                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                                                        <TextBlock Text="{Binding SelectedAvailabilityStatusLabel}"
                                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="1"
                                                                                Spacing="4">
                                                                        <TextBlock Text="Duration"
                                                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                                                        <TextBlock Text="{Binding SelectedAvailabilityDurationLabel}"
                                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <TextBlock Text="{Binding SelectedAvailabilityStatusSummary}"
                                                                           Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                                <TextBlock Text="{Binding SelectedAvailabilityFailureMessage}"
                                                                           Visibility="{Binding SelectedAvailabilityFailureVisibility}"
                                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                           TextWrapping="WrapWholeWords"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabViewItem>
                        </TabView>
                    </Grid>
                </Grid>
            </Grid>
        </shared:PageScaffold.BodyContent>
    </shared:PageScaffold>
</Page>