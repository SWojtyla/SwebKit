<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SwebKit.WinUI.Views.Pipelines.PipelinesPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:SwebKit.WinUI.Controls.Shared"
    xmlns:viewModels="using:SwebKit.WinUI.ViewModels.Pipelines"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    Background="{ThemeResource SwebKitPageBackgroundBrush}">

    <shared:PageScaffold
        Title="Pipelines"
        Subtitle="Track pipeline health, recent delivery activity, scoped releases, and pending approvals in the native workspace baseline.">
        <shared:PageScaffold.BodyContent>
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Style="{StaticResource SwebKitSurfaceCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Spacing="4">
                                <TextBlock
                                    Text="Delivery scope"
                                    Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                <TextBlock
                                    Text="{Binding ScopeSummary}"
                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                    TextWrapping="WrapWholeWords"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Top">
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    IsActive="{Binding IsRefreshing}"/>
                                <Button
                                    Content="Refresh"
                                    Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding CanRefreshWorkspace}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="{Binding ErrorMessage}"
                            Visibility="{Binding ErrorVisibility}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="WrapWholeWords"/>

                        <InfoBar
                            IsOpen="{Binding ShowReadinessState}"
                            Severity="Warning"
                            Title="{Binding ReadinessTitle}"
                            Message="{Binding ReadinessMessage}">
                            <InfoBar.ActionButton>
                                <Button
                                    Content="Open Settings"
                                    Command="{Binding OpenSettingsCommand}"/>
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <InfoBar
                            IsOpen="{Binding ShowNotConfiguredState}"
                            Severity="Informational"
                            Title="Azure DevOps is not configured"
                            Message="Configure an organization and personal access token before loading projects, pipelines, releases, and approvals in this native route."/>

                        <InfoBar
                            IsOpen="{Binding ShowNoProjectsState}"
                            Severity="Warning"
                            Title="No projects returned"
                            Message="The current DevOps scope returned no projects. Check pinned-project configuration or connection access."/>

                        <InfoBar
                            IsOpen="{Binding ShowDemoModeState}"
                            Severity="Success"
                            Title="Demo mode"
                            Message="This baseline is using the in-memory demo Azure DevOps client."/>

                        <Grid ColumnSpacing="12"
                              RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Spacing="6">
                                <TextBlock
                                    Text="Project"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                                <ComboBox
                                    ItemsSource="{Binding Projects}"
                                    SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                    DisplayMemberPath="DisplayLabel"
                                    PlaceholderText="No project loaded"
                                    IsEnabled="{Binding CanChangeApprovalAction}"/>
                                <TextBlock
                                    Text="{Binding SelectedProjectSummary}"
                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                    TextWrapping="WrapWholeWords"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Spacing="4">
                                <TextBlock
                                    Text="Connection"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock
                                    Text="{Binding ConnectionStateLabel}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock
                                    Text="{Binding ConnectionSummary}"
                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                    TextWrapping="WrapWholeWords"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="2"
                                        Spacing="4">
                                <TextBlock
                                    Text="Workspace"
                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock
                                    Text="{Binding MetricsSummary}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextWrapping="WrapWholeWords"/>
                                <TextBlock
                                    Text="{Binding LastRefreshLabel}"
                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                    TextWrapping="WrapWholeWords"/>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="Projects"
                                        Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock
                                        Text="{Binding ProjectCountText}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="Loaded pipelines"
                                        Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock
                                        Text="{Binding PipelineCountText}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="2"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    Padding="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Spacing="4">
                                        <TextBlock
                                            Text="Releases"
                                            Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <TextBlock
                                            Text="{Binding ReleaseWorkspace.ReleaseCountText}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Spacing="4">
                                        <TextBlock
                                            Text="Approvals"
                                            Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <TextBlock
                                            Text="{Binding ApprovalCountText}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <TabView
                    Grid.Row="1"
                    Visibility="{Binding WorkspaceVisibility}"
                    IsEnabled="{Binding CanChangeApprovalAction}"
                    IsAddTabButtonVisible="False"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    <TabViewItem Header="Pipelines">
                        <Grid ColumnSpacing="16"
                              Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource SwebKitSurfaceCardStyle}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Spacing="4">
                                            <TextBlock
                                                Text="Pipelines in scope"
                                                Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                            <TextBlock
                                                Text="{Binding PipelinesSummary}"
                                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                TextWrapping="WrapWholeWords"/>
                                        </StackPanel>

                                        <ProgressRing
                                            Grid.Column="1"
                                            Width="20"
                                            Height="20"
                                            IsActive="{Binding IsLoadingPipelines}"/>
                                    </Grid>

                                    <InfoBar
                                        Grid.Row="1"
                                        IsOpen="{Binding ShowPipelinesEmptyState}"
                                        Severity="Informational"
                                        Title="No pipelines found"
                                        Message="The selected project returned no pipelines for the current scope."/>

                                    <ListView Grid.Row="2"
                                              ItemsSource="{Binding Pipelines}"
                                              SelectedItem="{Binding SelectedPipeline, Mode=TwoWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:PipelinesPipelineItemViewModel">
                                                <StackPanel Padding="0,8"
                                                            Spacing="2">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        TextWrapping="WrapWholeWords"/>
                                                    <TextBlock
                                                        Text="{x:Bind FolderLabel}"
                                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                        TextWrapping="WrapWholeWords"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1"
                                  RowSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource SwebKitSurfaceCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Text="{Binding SelectedPipelineTitle}"
                                            Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"
                                            TextWrapping="WrapWholeWords"/>
                                        <TextBlock
                                            Text="{Binding SelectedPipelineSubtitle}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"/>
                                        <TextBlock
                                            Text="{Binding SelectedPipelineStatusText}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Visibility="{Binding SelectedPipelineDetailVisibility}"/>
                                        <TextBlock
                                            Text="{Binding SelectedPipelineRunSummary}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"
                                            Visibility="{Binding SelectedPipelineDetailVisibility}"/>
                                        <TextBlock
                                            Text="{Binding SelectedPipelineStageSummary}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"
                                            Visibility="{Binding SelectedPipelineDetailVisibility}"/>
                                        <TextBlock
                                            Text="Select a pipeline to load recent run activity and stage progression."
                                            Visibility="{Binding SelectedPipelinePlaceholderVisibility}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1"
                                        Style="{StaticResource SwebKitSurfaceCardStyle}">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Spacing="4">
                                                <TextBlock
                                                    Text="Recent run preview"
                                                    Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                                <TextBlock
                                                    Text="{Binding ActivitySummary}"
                                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                    TextWrapping="WrapWholeWords"/>
                                            </StackPanel>

                                            <ProgressRing
                                                Grid.Column="1"
                                                Width="20"
                                                Height="20"
                                                IsActive="{Binding IsLoadingActivity}"/>
                                        </Grid>

                                        <InfoBar
                                            Grid.Row="1"
                                            IsOpen="{Binding ShowActivityEmptyState}"
                                            Severity="Informational"
                                            Title="No recent runs"
                                            Message="The selected pipeline returned no recent run activity."/>

                                        <ListView Grid.Row="2"
                                                  ItemsSource="{Binding ActivityRuns}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:PipelinesRunItemViewModel">
                                                    <StackPanel Padding="0,8"
                                                                Spacing="2">
                                                        <TextBlock
                                                            Text="{x:Bind StatusSummary}"
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            TextWrapping="WrapWholeWords"/>
                                                        <TextBlock
                                                            Text="{x:Bind Name}"
                                                            TextWrapping="WrapWholeWords"/>
                                                        <TextBlock
                                                            Text="{x:Bind CreatedLabel}"
                                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                        <TextBlock
                                                            Text="{x:Bind BranchLabel}"
                                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                        <TextBlock
                                                            Text="{x:Bind StageSummary}"
                                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                            TextWrapping="WrapWholeWords"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabViewItem>

                    <TabViewItem Header="Activity">
                        <Border Margin="0,8,0,0"
                                Style="{StaticResource SwebKitSurfaceCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Spacing="4">
                                        <TextBlock
                                            Text="Recent run activity"
                                            Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                        <TextBlock
                                            Text="{Binding ActivitySummary}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"/>
                                    </StackPanel>

                                    <ProgressRing
                                        Grid.Column="1"
                                        Width="20"
                                        Height="20"
                                        IsActive="{Binding IsLoadingActivity}"/>
                                </Grid>

                                <InfoBar
                                    Grid.Row="1"
                                    IsOpen="{Binding ShowActivityEmptyState}"
                                    Severity="Informational"
                                    Title="No activity returned"
                                    Message="Select a pipeline in the Pipelines tab to populate recent runs here."/>

                                <ListView Grid.Row="2"
                                          ItemsSource="{Binding ActivityRuns}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:PipelinesRunItemViewModel">
                                            <Border Padding="0,10">
                                                <StackPanel Spacing="4">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        TextWrapping="WrapWholeWords"/>
                                                    <TextBlock
                                                        Text="{x:Bind StatusSummary}"
                                                        TextWrapping="WrapWholeWords"/>
                                                    <TextBlock
                                                        Text="{x:Bind CreatedLabel}"
                                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                    <TextBlock
                                                        Text="{x:Bind BranchLabel}"
                                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                    <TextBlock
                                                        Text="{x:Bind StageSummary}"
                                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                        TextWrapping="WrapWholeWords"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </TabViewItem>

                    <TabViewItem Header="Releases">
                        <Grid ColumnSpacing="16"
                              Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource SwebKitSurfaceCardStyle}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Spacing="4">
                                        <TextBlock
                                            Text="Scoped releases"
                                            Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                        <TextBlock
                                            Text="{Binding ReleaseWorkspace.ReleasesSummary}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"/>
                                    </StackPanel>

                                    <InfoBar
                                        Grid.Row="1"
                                        IsOpen="{Binding ShowReleasesEmptyState}"
                                        Severity="Informational"
                                        Title="No releases found"
                                        Message="The release repository returned no entries that intersect the current delivery scope."/>

                                    <ListView Grid.Row="2"
                                              ItemsSource="{Binding ReleaseWorkspace.Releases}"
                                              SelectedItem="{Binding ReleaseWorkspace.SelectedRelease, Mode=TwoWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:PipelinesReleaseItemViewModel">
                                                <StackPanel Padding="0,8"
                                                            Spacing="2">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        TextWrapping="WrapWholeWords"/>
                                                    <TextBlock
                                                        Text="{x:Bind StatusLabel}"
                                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                    <TextBlock
                                                        Text="{x:Bind CreatedLabel}"
                                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                    <TextBlock
                                                        Text="{x:Bind ComponentCountText}"
                                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource SwebKitSurfaceCardStyle}">
                                <Grid RowSpacing="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Spacing="6">
                                        <TextBlock
                                            Text="{Binding ReleaseWorkspace.SelectedReleaseTitle}"
                                            Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"
                                            TextWrapping="WrapWholeWords"/>
                                        <TextBlock
                                            Text="{Binding ReleaseWorkspace.SelectedReleaseSubtitle}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"/>
                                        <TextBlock
                                            Text="{Binding ReleaseWorkspace.SelectedReleaseComponentSummary}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"
                                            Visibility="{Binding ReleaseWorkspace.SelectedReleaseDetailVisibility}"/>
                                        <TextBlock
                                            Text="{Binding ReleaseWorkspace.SelectedReleaseNotes}"
                                            TextWrapping="WrapWholeWords"
                                            Visibility="{Binding ReleaseWorkspace.SelectedReleaseDetailVisibility}"/>
                                        <TextBlock
                                            Text="Select a release to inspect its scoped components and notes."
                                            Visibility="{Binding ReleaseWorkspace.SelectedReleasePlaceholderVisibility}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="Components and tag manager"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Visibility="{Binding ReleaseWorkspace.SelectedReleaseDetailVisibility}"/>

                                    <StackPanel Grid.Row="2"
                                                Spacing="16"
                                                Visibility="{Binding ReleaseWorkspace.SelectedReleaseDetailVisibility}">
                                        <ListView ItemsSource="{Binding ReleaseWorkspace.SelectedReleaseComponents}"
                                                  MaxHeight="220">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:PipelinesReleaseComponentItemViewModel">
                                                    <StackPanel Padding="0,8"
                                                                Spacing="2">
                                                        <TextBlock
                                                            Text="{x:Bind ComponentName}"
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            TextWrapping="WrapWholeWords"/>
                                                        <TextBlock
                                                            Text="{x:Bind ProjectName}"
                                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                        <TextBlock
                                                            Text="{x:Bind ScopeStatus}"
                                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                        <TextBlock
                                                            Text="{x:Bind TargetTagLabel}"
                                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                            TextWrapping="WrapWholeWords"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="8"
                                                Padding="16">
                                            <Grid RowSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Spacing="4">
                                                        <TextBlock
                                                            Text="Tag manager"
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                        <TextBlock
                                                            Text="{Binding ReleaseWorkspace.ReleaseTagSummary}"
                                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                            TextWrapping="WrapWholeWords"/>
                                                    </StackPanel>

                                                    <ProgressRing
                                                        Grid.Column="1"
                                                        Width="20"
                                                        Height="20"
                                                        IsActive="{Binding ReleaseWorkspace.IsLoadingReleaseTags}"/>

                                                    <Button
                                                        Grid.Column="2"
                                                        Content="Refresh tags"
                                                        Command="{Binding RefreshReleaseTagsCommand}"
                                                        IsEnabled="{Binding ReleaseWorkspace.CanChangeReleaseTags}"/>
                                                </Grid>

                                                <InfoBar
                                                    Grid.Row="1"
                                                    IsOpen="{Binding ReleaseWorkspace.ShowReleaseTagWarningState}"
                                                    Severity="Warning"
                                                    Title="Partial git metadata"
                                                    Message="{Binding ReleaseWorkspace.ReleaseTagLoadWarning}"/>

                                                <Border Grid.Row="2"
                                                        Visibility="{Binding ReleaseWorkspace.ReleaseTagActionVisibility}"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        CornerRadius="8"
                                                        Padding="12">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock
                                                            Text="{Binding ReleaseWorkspace.ReleaseTagActionTitle}"
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            TextWrapping="WrapWholeWords"/>
                                                        <TextBlock
                                                            Text="{Binding ReleaseWorkspace.ReleaseTagActionSubtitle}"
                                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                            TextWrapping="WrapWholeWords"/>

                                                        <InfoBar
                                                            IsOpen="True"
                                                            Severity="Warning"
                                                            Title="This action cannot be undone"
                                                            Message="Type CONFIRM before creating the annotated git tag for this release component."/>

                                                        <StackPanel Spacing="6">
                                                            <TextBlock
                                                                Text="Confirmation"
                                                                Style="{StaticResource CaptionTextBlockStyle}"/>
                                                            <TextBox
                                                                Text="{Binding ReleaseWorkspace.ReleaseTagConfirmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                IsEnabled="{Binding ReleaseWorkspace.CanChangeReleaseTags}"
                                                                PlaceholderText="Type CONFIRM"/>
                                                        </StackPanel>

                                                        <TextBlock
                                                            Text="{Binding ReleaseWorkspace.ReleaseTagError}"
                                                            Visibility="{Binding ReleaseWorkspace.ReleaseTagErrorVisibility}"
                                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                            TextWrapping="WrapWholeWords"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="12">
                                                            <Button
                                                                Content="Cancel"
                                                                Command="{Binding CancelReleaseTagActionCommand}"
                                                                IsEnabled="{Binding ReleaseWorkspace.CanChangeReleaseTags}"/>
                                                            <Button
                                                                Content="Create tag"
                                                                Command="{Binding SubmitReleaseTagCommand}"
                                                                Style="{StaticResource AccentButtonStyle}"
                                                                IsEnabled="{Binding ReleaseWorkspace.CanSubmitReleaseTag}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <InfoBar
                                                    Grid.Row="3"
                                                    IsOpen="{Binding ReleaseWorkspace.ShowReleaseTagEmptyState}"
                                                    Severity="Informational"
                                                    Title="No in-scope components"
                                                    Message="This release has no in-scope components available for tag creation."/>

                                                <ListView Grid.Row="4"
                                                          ItemsSource="{Binding ReleaseWorkspace.ReleaseTagItems}"
                                                          Visibility="{Binding ReleaseWorkspace.ReleaseTagListVisibility}"
                                                          IsEnabled="{Binding ReleaseWorkspace.CanChangeReleaseTags}">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:PipelinesReleaseTagItemViewModel">
                                                            <Border Padding="0,10">
                                                                <StackPanel Spacing="8">
                                                                    <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0"
                                                                                    Spacing="2">
                                                                            <TextBlock
                                                                                Text="{x:Bind ComponentName}"
                                                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                                TextWrapping="WrapWholeWords"/>
                                                                            <TextBlock
                                                                                Text="{x:Bind ProjectName}"
                                                                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                            <TextBlock
                                                                                Text="{x:Bind LatestTagLabel}"
                                                                                Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                                TextWrapping="WrapWholeWords"/>
                                                                        </StackPanel>

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{x:Bind ConfirmedTagLabel}"
                                                                                   Visibility="{x:Bind ConfirmedTagVisibility}"
                                                                                   Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                                   TextWrapping="WrapWholeWords"
                                                                                   VerticalAlignment="Top"/>
                                                                    </Grid>

                                                                    <TextBlock
                                                                        Text="{x:Bind RecentTagsSummary}"
                                                                        Visibility="{x:Bind RecentTagsVisibility}"
                                                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                        TextWrapping="WrapWholeWords"/>

                                                                    <StackPanel Spacing="10"
                                                                                Visibility="{x:Bind CreateControlsVisibility}">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock
                                                                                Text="Tag name"
                                                                                Style="{StaticResource CaptionTextBlockStyle}"/>
                                                                            <TextBox
                                                                                Text="{x:Bind TagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                PlaceholderText="v1.5.0"/>
                                                                        </StackPanel>

                                                                        <Grid ColumnSpacing="12">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="2*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel Grid.Column="0"
                                                                                        Spacing="6">
                                                                                <TextBlock
                                                                                    Text="Commit"
                                                                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                                                                                <ComboBox
                                                                                    ItemsSource="{x:Bind AvailableCommits}"
                                                                                    SelectedItem="{x:Bind SelectedCommit, Mode=TwoWay}"
                                                                                    DisplayMemberPath="DisplayLabel"/>
                                                                            </StackPanel>

                                                                            <StackPanel Grid.Column="1"
                                                                                        Spacing="6">
                                                                                <TextBlock
                                                                                    Text="Message"
                                                                                    Style="{StaticResource CaptionTextBlockStyle}"/>
                                                                                <TextBox
                                                                                    Text="{x:Bind TagMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                    PlaceholderText="Release message"/>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <Grid ColumnSpacing="12">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{x:Bind CommitSummary}"
                                                                                       Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                                                       TextWrapping="WrapWholeWords"
                                                                                       VerticalAlignment="Center"/>

                                                                            <Button Grid.Column="1"
                                                                                    Content="Create tag"
                                                                                    Command="{Binding DataContext.BeginCreateReleaseTagCommand, ElementName=PageRoot}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Style="{StaticResource AccentButtonStyle}"
                                                                                    IsEnabled="{x:Bind CanCreateTag}"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabViewItem>

                    <TabViewItem Header="Approvals">
                        <Border Margin="0,8,0,0"
                                Style="{StaticResource SwebKitSurfaceCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Spacing="4">
                                        <TextBlock
                                            Text="Pending approvals"
                                            Style="{StaticResource SwebKitSectionHeaderTextBlockStyle}"/>
                                        <TextBlock
                                            Text="{Binding ApprovalsSummary}"
                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                            TextWrapping="WrapWholeWords"/>
                                    </StackPanel>

                                    <ProgressRing
                                        Grid.Column="1"
                                        Width="20"
                                        Height="20"
                                        IsActive="{Binding IsLoadingApprovals}"/>
                                </Grid>

                                <InfoBar
                                    Grid.Row="1"
                                    IsOpen="{Binding ShowApprovalRefreshWarningState}"
                                    Severity="Warning"
                                    Title="Approvals partially refreshed"
                                    Message="{Binding ApprovalRefreshWarning}"/>

                                <InfoBar
                                    Grid.Row="2"
                                    IsOpen="{Binding ShowApprovalsEmptyState}"
                                    Severity="Informational"
                                    Title="No pending approvals"
                                    Message="The current delivery scope has no pending approvals in this baseline."/>

                                <Border Grid.Row="3"
                                        Visibility="{Binding ApprovalActionVisibility}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Padding="16">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Spacing="4">
                                                <TextBlock
                                                    Text="{Binding ApprovalActionTitle}"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    TextWrapping="WrapWholeWords"/>
                                                <TextBlock
                                                    Text="{Binding ApprovalActionSubtitle}"
                                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                    TextWrapping="WrapWholeWords"/>
                                            </StackPanel>

                                            <ProgressRing
                                                Grid.Column="1"
                                                Width="20"
                                                Height="20"
                                                IsActive="{Binding IsSubmittingApprovalAction}"/>
                                        </Grid>

                                        <InfoBar
                                            IsOpen="{Binding ApprovalActionRequiresConfirm}"
                                            Visibility="{Binding ApprovalActionProdWarningVisibility}"
                                            Severity="Warning"
                                            Title="{Binding ApprovalActionConfirmationTitle}"
                                            Message="{Binding ApprovalActionConfirmationMessage}"/>

                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                Text="Comment"
                                                Style="{StaticResource CaptionTextBlockStyle}"/>
                                            <TextBox
                                                Text="{Binding ApprovalActionComment, Mode=TwoWay}"
                                                IsEnabled="{Binding CanChangeApprovalAction}"
                                                PlaceholderText="Optional operator note"
                                                AcceptsReturn="True"
                                                TextWrapping="Wrap"
                                                MinHeight="72"/>
                                        </StackPanel>

                                        <StackPanel Spacing="6"
                                                    Visibility="{Binding ApprovalActionProdWarningVisibility}">
                                            <TextBlock
                                                Text="Confirmation"
                                                Style="{StaticResource CaptionTextBlockStyle}"/>
                                            <TextBox
                                                Text="{Binding ApprovalActionConfirmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding CanChangeApprovalAction}"
                                                PlaceholderText="Type CONFIRM"/>
                                        </StackPanel>

                                        <TextBlock
                                            Text="{Binding ApprovalActionError}"
                                            Visibility="{Binding ApprovalActionErrorVisibility}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            TextWrapping="WrapWholeWords"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="12">
                                            <Button
                                                Content="Cancel"
                                                Command="{Binding CancelApprovalActionCommand}"
                                                IsEnabled="{Binding CanChangeApprovalAction}"/>
                                            <Button
                                                Content="{Binding ApprovalActionVerb}"
                                                Command="{Binding SubmitApprovalActionCommand}"
                                                IsEnabled="{Binding CanSubmitApprovalAction}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <ListView Grid.Row="4"
                                          ItemsSource="{Binding Approvals}"
                                          IsEnabled="{Binding CanChangeApprovalAction}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:PipelinesApprovalItemViewModel">
                                            <Border Padding="0,10">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    Spacing="4">
                                                            <TextBlock
                                                                Text="{x:Bind PipelineName}"
                                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                TextWrapping="WrapWholeWords"/>

                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="8">
                                                                <TextBlock
                                                                    Text="{x:Bind ProjectLabel}"
                                                                    Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                                <Border
                                                                    Visibility="{x:Bind ProductionBadgeVisibility}"
                                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                                    CornerRadius="999"
                                                                    Padding="8,2">
                                                                    <TextBlock
                                                                        Text="PROD"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"/>
                                                                </Border>
                                                                <Border
                                                                    Visibility="{x:Bind UnverifiedBadgeVisibility}"
                                                                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                                    CornerRadius="999"
                                                                    Padding="8,2">
                                                                    <TextBlock
                                                                        Text="UNVERIFIED"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    VerticalAlignment="Top">
                                                            <Button
                                                                Content="Approve"
                                                                Command="{Binding DataContext.StartApproveApprovalCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}"/>
                                                            <Button
                                                                Content="Reject"
                                                                Command="{Binding DataContext.StartRejectApprovalCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}"/>
                                                            <HyperlinkButton
                                                                Content="ADO"
                                                                NavigateUri="{x:Bind WebUri}"
                                                                Visibility="{x:Bind WebLinkVisibility}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock
                                                        Text="{x:Bind StageLabel}"
                                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                        TextWrapping="WrapWholeWords"/>
                                                    <TextBlock
                                                        Text="{x:Bind RequestedByLabel}"
                                                        Foreground="{ThemeResource SwebKitPageSubtitleBrush}"
                                                        TextWrapping="WrapWholeWords"/>
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="12">
                                                        <TextBlock
                                                            Text="{x:Bind PendingSinceLabel}"
                                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                        <TextBlock
                                                            Text="{x:Bind AgeStatusLabel}"
                                                            Foreground="{ThemeResource SwebKitPageSubtitleBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </TabViewItem>
                </TabView>
            </Grid>
        </shared:PageScaffold.BodyContent>
    </shared:PageScaffold>
</Page>