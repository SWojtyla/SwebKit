@if (Visible)
{
    <div class="server-panel">
        @if (Info is null)
        {
            <div class="empty">Loading server info...</div>
        }
        else
        {
            <div class="row"><span>Version</span><strong>@Info.RedisVersion</strong></div>
            <div class="row"><span>Uptime</span><strong>@Info.UptimeSeconds s</strong></div>
            <div class="row"><span>Clients</span><strong>@Info.ConnectedClients</strong></div>
            <div class="row"><span>Memory</span><strong>@Info.UsedMemoryHuman (@Info.UsedMemoryBytes bytes)</strong></div>
            <div class="row"><span>Commands</span><strong>@Info.TotalCommandsProcessed</strong></div>
            <div class="row">
                <span>Hit ratio</span>
                <strong>
                    @((Info.KeyspaceHitRatio * 100).ToString("0.##"))%
                    @if (Info.KeyspaceHitRatio >= 0.995)
                    {
                        <span title="Perfection. Don't touch anything.">🔥</span>
                    }
                </strong>
            </div>

            <table class="table">
                <thead>
                <tr><th>DB</th><th>Keys</th><th>Expires</th><th>Avg TTL</th></tr>
                </thead>
                <tbody>
                @foreach (var db in Info.Databases)
                {
                    <tr>
                        <td>@db.Index</td>
                        <td>@db.Keys</td>
                        <td>@db.Expires</td>
                        <td>@db.AvgTtl</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public SwebKit.Core.Models.RedisServerInfo? Info { get; set; }
}
