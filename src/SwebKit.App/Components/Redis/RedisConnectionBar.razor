<div class="page-header">
    @if (ActiveCacheEntry is not null)
    {
        <div class="cache-bar">
            @if (_isRenaming)
            {
                <input class="cache-rename-input" type="text" @bind="_renameDraft" @bind:event="oninput"
                       @onkeydown="HandleRenameKeyDown" @onblur="CommitRenameAsync" aria-label="Redis cache display name" />
            }
            else
            {
                <select class="cache-selector" @bind="_selectedCacheId" @bind:after="HandleCacheChangedAsync"
                        aria-label="Select active Redis cache">
                    @foreach (var cache in CacheEntries)
                    {
                        <option value="@cache.Id">@cache.DisplayName</option>
                    }
                </select>
                <button class="cache-rename-btn" type="button" @onclick="StartRename" title="Rename">&#9998;</button>
            }
        </div>
    }
    else
    {
        <h2>Redis</h2>
    }
</div>

@code {
    [Parameter] public List<RedisCacheEntry> CacheEntries { get; set; } = [];
    [Parameter] public RedisCacheEntry? ActiveCacheEntry { get; set; }
    [Parameter] public string SelectedCacheId { get; set; } = "";
    [Parameter] public EventCallback<string> OnCacheChanged { get; set; }
    [Parameter] public EventCallback<string> OnCacheNameChanged { get; set; }

    private string _selectedCacheId = "";
    private bool _isRenaming = false;
    private string _renameDraft = "";

    protected override void OnParametersSet()
    {
        _selectedCacheId = SelectedCacheId;
    }

    private Task HandleCacheChangedAsync() => OnCacheChanged.InvokeAsync(_selectedCacheId);

    private void StartRename()
    {
        _renameDraft = ActiveCacheEntry?.DisplayName ?? "";
        _isRenaming = true;
    }

    private async Task CommitRenameAsync()
    {
        if (!_isRenaming) return;
        _isRenaming = false;
        var name = _renameDraft.Trim();
        if (string.IsNullOrWhiteSpace(name)) name = ActiveCacheEntry?.DisplayName ?? "Cache";
        await OnCacheNameChanged.InvokeAsync(name);
    }

    private Task HandleRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") return CommitRenameAsync();
        if (e.Key == "Escape") { _isRenaming = false; return Task.CompletedTask; }
        return Task.CompletedTask;
    }
}
