<div class="toolbar">
    <div class="field">
        <label>Pattern</label>
        <input @bind="_pattern" placeholder="*" />
        <div class="pattern-help">
            Examples: <code>user:*</code> <code>session:*</code> <code>cache:*</code> <code>*:pending</code>
        </div>
    </div>

    <FluentButton Appearance="Appearance.Accent" @onclick="HandleScan" Disabled="@IsLoading">Scan
    </FluentButton>
    <FluentButton @onclick="OnRefreshKey" Disabled="@(IsLoading || SelectedKey is null)">Refresh Key
    </FluentButton>
    <FluentButton @onclick="OnDeleteKey" Disabled="@(IsLoading || SelectedKey is null)">Delete Key
    </FluentButton>
    <FluentButton @onclick="HandleSelectAllLoaded" Disabled="@(IsLoading || KeyCount == 0)">Select All Loaded
    </FluentButton>
    <FluentButton @onclick="ToggleMultiSelectMode"
                  Appearance="@(_multiSelectMode ? Appearance.Accent : Appearance.Neutral)">
        @(_multiSelectMode ? "Cancel Select" : "Select")
    </FluentButton>
    @if (_multiSelectMode)
    {
        <span class="selection-summary">
            Selected @_selectedKeys.Count of @KeyCount loaded key(s)@((HasMoreKeys && KeyCount > 0) ? " (more keys not loaded)" : string.Empty)
        </span>
        <FluentButton @onclick="ClearSelection" Disabled="@(_selectedKeys.Count == 0)">Clear Selection</FluentButton>
        @if (_selectedKeys.Count > 0)
        {
            <FluentButton @onclick="OnBatchDelete" Appearance="Appearance.Accent">
                Delete @_selectedKeys.Count key(s)
            </FluentButton>
        }
        @if (BatchProgressMessage is not null)
        {
            <span class="selection-summary">@BatchProgressMessage</span>
        }
    }
    <FluentButton @onclick="OnExportJson" Disabled="@(IsLoading || KeyCount == 0)">Export JSON
    </FluentButton>
    <AutoRefreshToggle OnRefresh="HandleScan" Paused="@IsLoading" />
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public int KeyCount { get; set; }
    [Parameter] public bool HasMoreKeys { get; set; }
    [Parameter] public bool IsProduction { get; set; }
    [Parameter] public bool HasAnyPanel { get; set; }
    [Parameter] public string? BatchProgressMessage { get; set; }
    [Parameter] public EventCallback<string> OnScan { get; set; }
    [Parameter] public EventCallback OnRefreshKey { get; set; }
    [Parameter] public EventCallback OnDeleteKey { get; set; }
    [Parameter] public EventCallback OnSelectAllLoaded { get; set; }
    [Parameter] public EventCallback OnExportJson { get; set; }
    [Parameter] public EventCallback OnBatchDelete { get; set; }

    private string _pattern = "*";
    private bool _multiSelectMode;
    private readonly HashSet<string> _selectedKeys = new(StringComparer.Ordinal);

    public string Pattern { get => _pattern; set => _pattern = value; }
    public bool MultiSelectMode => _multiSelectMode;
    public HashSet<string> SelectedKeys => _selectedKeys;

    public void ReplaceSelection(IEnumerable<string> keys)
    {
        _selectedKeys.Clear();
        foreach (var key in keys)
            _selectedKeys.Add(key);
        _multiSelectMode = true;
        RequestRender();
    }

    public void AddSelection(IEnumerable<string> keys)
    {
        _multiSelectMode = true;
        foreach (var key in keys)
            _selectedKeys.Add(key);
        RequestRender();
    }

    public void RemoveSelection(IEnumerable<string> keys)
    {
        foreach (var key in keys)
            _selectedKeys.Remove(key);
        RequestRender();
    }

    public void ClearSelection()
    {
        _selectedKeys.Clear();
        RequestRender();
    }

    public void ExitMultiSelect()
    {
        _selectedKeys.Clear();
        _multiSelectMode = false;
        RequestRender();
    }

    public void PruneSelection(IEnumerable<string> allowedKeys)
    {
        var allowed = allowedKeys as HashSet<string>
            ?? new HashSet<string>(allowedKeys, StringComparer.Ordinal);
        _selectedKeys.RemoveWhere(key => !allowed.Contains(key));
    }

    public void ToggleKeySelection(string key)
    {
        _multiSelectMode = true;
        if (!_selectedKeys.Remove(key))
            _selectedKeys.Add(key);
        RequestRender();
    }

    private Task HandleScan() => OnScan.InvokeAsync(_pattern);

    private Task HandleSelectAllLoaded() => OnSelectAllLoaded.InvokeAsync();

    private void RequestRender() => _ = InvokeAsync(StateHasChanged);

    private void ToggleMultiSelectMode()
    {
        _multiSelectMode = !_multiSelectMode;
        if (!_multiSelectMode)
            _selectedKeys.Clear();
    }
}
