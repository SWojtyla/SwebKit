@using SwebKit.Redis
@using System.Globalization
@using SwebKit.Core.Services
@inject IJSRuntime JS
@inject INotificationService Notifications
@implements IDisposable

<div class="redis-key-detail">
    @if (SelectedKey is null)
    {
        <div class="empty">Select a key to inspect.</div>
    }
    else if (KeyInfo is null)
    {
        <div class="empty">Loading key details...</div>
    }
    else
    {
        <div class="meta">
            <div class="key-name-row">
                <div class="key-name">@KeyInfo.Key</div>
                <button class="copy-btn" title="Copy key name" @onclick="CopyKeyNameAsync">
                    📋
                </button>
            </div>
            <div class="kv">Type: @KeyInfo.Type</div>
            <div class="kv @GetTtlClass()">TTL: @TtlFormatter.FormatHuman(_displayedTtl)</div>
            @if (_displayedTtl.HasValue && _displayedTtl.Value > TimeSpan.Zero)
            {
                <div class="ttl-bar-wrapper">
                    <div class="ttl-bar-fill"
                         style="width: @(TtlFormatter.GetBarWidthPercent(_displayedTtl, _originalTtl).ToString("F1", CultureInfo.InvariantCulture))%; background-color: @TtlFormatter.GetColor(_displayedTtl, _originalTtl);">
                    </div>
                </div>
            }
            @if (KeyInfo.MemoryBytes.HasValue)
            {
                <div class="kv">Memory: @KeyInfo.MemoryBytes bytes</div>
            }
        </div>

        <div class="actions">
            <FluentButton Appearance="Appearance.Accent" @onclick="OnRefresh">Refresh</FluentButton>
            <FluentButton @onclick="OnDelete">Delete</FluentButton>
            @if (CanEditCurrentType)
            {
                <FluentButton @onclick="BeginEdit">Edit</FluentButton>
            }
        </div>

        <div class="ttl-actions">
            <input type="number" min="1" @bind="TtlSeconds" class="ttl-input" />
            <FluentButton @onclick="ApplyTtlAsync">Set TTL (s)</FluentButton>
            <FluentButton @onclick="RemoveTtl">Remove TTL</FluentButton>
        </div>

        @if (KeyInfo.Type == "string")
        {
            @if (IsEditingString)
            {
                <textarea class="editor" @bind="StringEditorValue"></textarea>
                <div class="edit-actions">
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveStringAsync">Save</FluentButton>
                    <FluentButton @onclick="CancelEdit">Cancel</FluentButton>
                </div>
            }
            else
            {
                <pre class="blob">@DisplayStringValue</pre>
            }
        }
        else if (KeyInfo.Type == "hash")
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Field</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var field in HashFields)
                    {
                        <tr>
                            <td>@field.Field</td>
                            <td>
                                @if (IsEditingHash && EditingHashField == field.Field)
                                {
                                    <input class="hash-editor" type="text" @bind="HashEditorValue" />
                                }
                                else
                                {
                                    @field.Value
                                }
                            </td>
                            <td class="hash-actions">
                                @if (IsEditingHash && EditingHashField == field.Field)
                                {
                                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveHashFieldAsync">Save</FluentButton>
                                    <FluentButton @onclick="CancelEdit">Cancel</FluentButton>
                                }
                                else
                                {
                                    <FluentButton @onclick="() => BeginHashFieldEdit(field.Field, field.Value)">Edit</FluentButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (KeyInfo.Type == "list" || KeyInfo.Type == "set")
        {
            <ul class="list">
                @foreach (var item in Items)
                {
                    <li>@item</li>
                }
            </ul>
        }
        else if (KeyInfo.Type == "zset")
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Score</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in SortedSetItems)
                    {
                        <tr>
                            <td>@item.Member</td>
                            <td>@item.Score</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

@code {
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public RedisKeyInfo? KeyInfo { get; set; }
    [Parameter] public string? StringValue { get; set; }
    [Parameter] public IReadOnlyList<RedisHashField> HashFields { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<RedisSortedSetEntry> SortedSetItems { get; set; } = [];

    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback<int> OnSetTtl { get; set; }
    [Parameter] public EventCallback OnRemoveTtl { get; set; }
    [Parameter] public EventCallback<string> OnSetStringValue { get; set; }
    [Parameter] public EventCallback<(string Field, string Value)> OnSetHashField { get; set; }
    [Parameter] public int StartEditRequestId { get; set; }

    private int TtlSeconds = 300;
    private bool IsEditingString;
    private bool IsEditingHash;
    private string? EditingHashField;
    private string StringEditorValue = string.Empty;
    private string HashEditorValue = string.Empty;
    private int LastStartEditRequestId;
    private string DisplayStringValue => RedisValueHelpers.TruncateValue(RedisValueHelpers.FormatJsonIfValid(StringValue));

    // TTL visualisation state
    private string? _originalKey;
    private TimeSpan? _originalTtl;
    private TimeSpan? _displayedTtl;
    private RedisKeyInfo? _lastKnownKeyInfo;
    private CancellationTokenSource? _countdownCts;

    private bool CanEditCurrentType => KeyInfo?.Type is "string" or "hash";

    protected override void OnParametersSet()
    {
        if (StartEditRequestId != LastStartEditRequestId)
        {
            LastStartEditRequestId = StartEditRequestId;
            BeginEdit();
        }

        if (KeyInfo?.Type != "string")
            IsEditingString = false;

        if (KeyInfo?.Type != "hash")
            ResetHashEditState();

        // TTL visualisation: only act when KeyInfo reference actually changes (see BL-5)
        if (!ReferenceEquals(_lastKnownKeyInfo, KeyInfo))
        {
            _lastKnownKeyInfo = KeyInfo;

            if (SelectedKey != _originalKey)
            {
                // New key opened: capture original TTL and start countdown
                _originalKey = SelectedKey;
                _originalTtl = KeyInfo?.Ttl;
                _displayedTtl = KeyInfo?.Ttl;
                RestartCountdown();
            }
            else if (KeyInfo is not null)
            {
                // Same key refreshed: sync displayed TTL to fresh server value
                _displayedTtl = KeyInfo.Ttl;
            }
        }
    }

    private Task RemoveTtl() => OnRemoveTtl.InvokeAsync();

    private void BeginEdit()
    {
        if (KeyInfo?.Type == "string")
        {
            IsEditingString = true;
            StringEditorValue = StringValue ?? string.Empty;
            return;
        }

        if (KeyInfo?.Type == "hash" && HashFields.Count > 0)
        {
            BeginHashFieldEdit(HashFields[0].Field, HashFields[0].Value);
        }
    }

    private void BeginHashFieldEdit(string field, string value)
    {
        IsEditingHash = true;
        EditingHashField = field;
        HashEditorValue = value;
    }

    private async Task SaveStringAsync()
    {
        await OnSetStringValue.InvokeAsync(StringEditorValue ?? string.Empty);
        IsEditingString = false;
    }

    private async Task SaveHashFieldAsync()
    {
        if (string.IsNullOrWhiteSpace(EditingHashField))
            return;

        await OnSetHashField.InvokeAsync((EditingHashField, HashEditorValue ?? string.Empty));
        ResetHashEditState();
    }

    private void CancelEdit()
    {
        IsEditingString = false;
        ResetHashEditState();
    }

    private void ResetHashEditState()
    {
        IsEditingHash = false;
        EditingHashField = null;
        HashEditorValue = string.Empty;
    }

    private Task ApplyTtlAsync()
    {
        var value = Math.Max(1, TtlSeconds);
        return OnSetTtl.InvokeAsync(value);
    }

    private string GetTtlClass() =>
        _displayedTtl is { } t && t > TimeSpan.Zero && t.TotalSeconds < 60
            ? "ttl-critical"
            : string.Empty;

    private void RestartCountdown()
    {
        _countdownCts?.Cancel();
        _countdownCts?.Dispose();
        _countdownCts = null;

        if (SelectedKey is null || _displayedTtl is null)
            return;

        _countdownCts = new CancellationTokenSource();
        _ = RunCountdownAsync(_countdownCts.Token);
    }

    private async Task RunCountdownAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var ticksUntilRefresh = 30;

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_displayedTtl.HasValue && _displayedTtl.Value > TimeSpan.Zero)
                    _displayedTtl = _displayedTtl.Value - TimeSpan.FromSeconds(1);

                ticksUntilRefresh--;
                if (ticksUntilRefresh <= 0)
                {
                    ticksUntilRefresh = 30;
                    await InvokeAsync(async () => await OnRefresh.InvokeAsync());
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on disposal or key change
        }
    }

    private async Task CopyKeyNameAsync()
    {
        if (string.IsNullOrEmpty(KeyInfo?.Key)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", KeyInfo.Key);
        Notifications.ShowSuccess("Copied!");
    }

    public void Dispose()
    {
        _countdownCts?.Cancel();
        _countdownCts?.Dispose();
        _countdownCts = null;
    }
}
