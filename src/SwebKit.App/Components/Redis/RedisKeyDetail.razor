@using SwebKit.Redis
@using System.Globalization
@using SwebKit.Core.Services
@inject IJSRuntime JS
@inject INotificationService Notifications
@implements IDisposable

<div class="redis-key-detail">
    @if (SelectedKey is null)
    {
        <EmptyState Icon="🔑" Title="No key selected"
                    Subtitle="Pick a key from the tree on the left to inspect its value, TTL, and metadata." />
    }
    else if (KeyInfo is null)
    {
        <LoadingSpinner Message="Loading key details…" />
    }
    else
    {
        <div class="meta">
            <div class="key-name-row">
                @if (_isRenaming)
                {
                    <input class="rename-input" type="text" @bind="_renameValue" @onkeydown="HandleRenameKeyDown"
                           @onkeydown:preventDefault="@(_renamePrevent)" />
                    <FluentButton Appearance="Appearance.Accent" @onclick="ConfirmRenameAsync">✓</FluentButton>
                    <FluentButton @onclick="CancelRename">✕</FluentButton>
                }
                else
                {
                    <div class="key-name">@KeyInfo.Key</div>
                    <AppIconButton CssClass="copy-btn" Title="Copy key name" Label="Copy key name" OnClick="CopyKeyNameAsync">
                        <Icon>📋</Icon>
                    </AppIconButton>
                    <AppIconButton CssClass="copy-btn" Title="Rename key" Label="Rename key" OnClick="BeginRename">
                        <Icon>✏️</Icon>
                    </AppIconButton>
                }
            </div>
            <div class="kv">Type: @KeyInfo.Type</div>
            <div class="kv @GetTtlClass()">TTL: @TtlFormatter.FormatHuman(_displayedTtl)</div>
            @if (_displayedTtl.HasValue && _displayedTtl.Value > TimeSpan.Zero)
            {
                <div class="ttl-bar-wrapper">
                    <div class="ttl-bar-fill"
                         style="width: @(TtlFormatter.GetBarWidthPercent(_displayedTtl, _originalTtl).ToString("F1", CultureInfo.InvariantCulture))%; background-color: @TtlFormatter.GetColor(_displayedTtl, _originalTtl);">
                    </div>
                </div>
            }
            @if (KeyInfo.MemoryBytes.HasValue)
            {
                <div class="kv">Memory: @KeyInfo.MemoryBytes bytes</div>
            }
        </div>

        <div class="actions">
            <FluentButton Appearance="Appearance.Accent" @onclick="OnRefresh">Refresh</FluentButton>
            <FluentButton @onclick="OnDelete">Delete</FluentButton>
            @if (CanEditCurrentType)
            {
                <FluentButton @onclick="BeginEdit">Edit</FluentButton>
            }
        </div>

        <div class="ttl-actions">
            <input type="number" min="1" @bind="TtlSeconds" class="ttl-input" />
            <FluentButton @onclick="ApplyTtlAsync">Set TTL (s)</FluentButton>
            <FluentButton @onclick="RemoveTtl">Remove TTL</FluentButton>
        </div>

        @if (KeyInfo.Type == "string")
        {
            @if (IsEditingString)
            {
                <textarea class="editor" @bind="StringEditorValue"></textarea>
                <div class="edit-actions">
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveStringAsync">Save</FluentButton>
                    <FluentButton @onclick="CancelEdit">Cancel</FluentButton>
                </div>
            }
            else
            {
                @if (RedisValueHelpers.IsBinaryContent(StringValue))
                {
                    <div class="binary-badge">Binary content — cannot display</div>
                }
                else
                {
                    <div class="value-toolbar">
                        <span>Value</span>
                        <FluentButton Appearance="Appearance.Lightweight" @onclick="CopyStringValueAsync"
                                      Disabled="@(StringValue is null)">
                            Copy Value
                        </FluentButton>
                    </div>
                    <pre class="blob" tabindex="0">@DisplayStringValue</pre>
                }
            }
        }
        else if (KeyInfo.Type == "hash")
        {
            <FluentDataGrid Items="@(HashFields.AsQueryable())" TGridItem="RedisHashField">
                <TemplateColumn Title="Field" SortBy="@(GridSort<RedisHashField>.ByAscending(f => f.Field))">
                    @context.Field
                </TemplateColumn>
                <TemplateColumn Title="Value" SortBy="@(GridSort<RedisHashField>.ByAscending(f => f.Value))">
                    @if (IsEditingHash && EditingHashField == context.Field)
                    {
                        <input class="hash-editor" type="text" @bind="HashEditorValue" />
                    }
                    else
                    {
                        <div class="value-cell">
                            <span class="hash-value" title="@context.Value">@context.Value</span>
                            <AppButton Type="button" CssClass="copy-btn" Title="Copy value"
                                       OnClick='() => CopyTextAsync(context.Value, "Copied field value")'>
                                Copy
                            </AppButton>
                        </div>
                    }
                </TemplateColumn>
                <TemplateColumn Title="" Width="140px">
                    <div class="hash-actions">
                        @if (IsEditingHash && EditingHashField == context.Field)
                        {
                            <FluentButton Appearance="Appearance.Accent" @onclick="SaveHashFieldAsync">Save</FluentButton>
                            <FluentButton @onclick="CancelEdit">Cancel</FluentButton>
                        }
                        else
                        {
                            <FluentButton @onclick="() => BeginHashFieldEdit(context.Field, context.Value)">Edit</FluentButton>
                        }
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="" Width="50px">
                    <FluentButton @onclick="() => OnDeleteHashField.InvokeAsync(context.Field)" title="Delete field">−
                    </FluentButton>
                </TemplateColumn>
            </FluentDataGrid>
            <div class="hash-add-row">
                <input type="text" class="hash-editor" placeholder="Field name" @bind="_newHashFieldName" />
                <input type="text" class="hash-editor" placeholder="Value" @bind="_newHashFieldValue" />
                <FluentButton @onclick="AddHashFieldAsync" Disabled="@(string.IsNullOrWhiteSpace(_newHashFieldName))">+
                </FluentButton>
            </div>
        }
        else if (KeyInfo.Type == "list" || KeyInfo.Type == "set")
        {
            <ul class="list">
                @foreach (var item in Items)
                {
                    <li>
                        <pre class="item-value">@item</pre>
                        <AppButton Type="button" CssClass="copy-btn" Title="Copy item"
                                   OnClick='() => CopyTextAsync(item, "Copied item")'>
                            Copy
                        </AppButton>
                    </li>
                }
            </ul>
            @if (HasMoreItems)
            {
                <FluentButton @onclick="OnLoadMoreItems" class="load-more-btn">Load more (@Items.Count loaded)</FluentButton>
            }
        }
        else if (KeyInfo.Type == "zset")
        {
            <FluentDataGrid Items="@(SortedSetItems.AsQueryable())" TGridItem="RedisSortedSetEntry">
                <TemplateColumn Title="Member" SortBy="@(GridSort<RedisSortedSetEntry>.ByAscending(e => e.Member))">
                    <div class="value-cell">
                        <span class="hash-value" title="@context.Member">@context.Member</span>
                        <AppButton Type="button" CssClass="copy-btn" Title="Copy member"
                                   OnClick='() => CopyTextAsync(context.Member, "Copied member")'>
                            Copy
                        </AppButton>
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Score" SortBy="@(GridSort<RedisSortedSetEntry>.ByAscending(e => e.Score))">
                    <span @onclick="() => BeginZsetScoreEdit(context.Member, context.Score)" class="zset-score-cell">
                        @if (_editingZsetMember == context.Member)
                        {
                            <input type="number" step="any" class="zset-score-editor" @bind="_zsetScoreEditor"
                                   @onkeydown="HandleZsetScoreKeyDown" @onkeydown:preventDefault="@(_zsetKeyPrevent)" />
                        }
                        else
                        {
                            @context.Score
                        }
                    </span>
                </TemplateColumn>
            </FluentDataGrid>
            @if (HasMoreItems)
            {
                <FluentButton @onclick="OnLoadMoreItems" class="load-more-btn">Load more (@SortedSetItems.Count loaded)
                </FluentButton>
            }
        }
    }
</div>

@code {
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public RedisKeyInfo? KeyInfo { get; set; }
    [Parameter] public string? StringValue { get; set; }
    [Parameter] public IReadOnlyList<RedisHashField> HashFields { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<RedisSortedSetEntry> SortedSetItems { get; set; } = [];

    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback<int> OnSetTtl { get; set; }
    [Parameter] public EventCallback OnRemoveTtl { get; set; }
    [Parameter] public EventCallback<string> OnSetStringValue { get; set; }
    [Parameter] public EventCallback<(string Field, string Value)> OnSetHashField { get; set; }
    [Parameter] public int StartEditRequestId { get; set; }
    [Parameter] public EventCallback<(string Member, double Score)> OnUpdateSortedSetScore { get; set; }
    [Parameter] public EventCallback<string> OnRenameKey { get; set; }
    [Parameter] public EventCallback<string> OnDeleteHashField { get; set; }
    [Parameter] public bool HasMoreItems { get; set; }
    [Parameter] public EventCallback OnLoadMoreItems { get; set; }

    private int TtlSeconds = 300;
    private bool IsEditingString;
    private bool IsEditingHash;
    private string? EditingHashField;
    private string StringEditorValue = string.Empty;
    private string HashEditorValue = string.Empty;
    private int LastStartEditRequestId;
    private string DisplayStringValue => RedisValueHelpers.FormatJsonIfValid(StringValue);

    // RDS-3: Sorted set score editing
    private string? _editingZsetMember;
    private string _zsetScoreEditor = string.Empty;
    private bool _zsetKeyPrevent;

    // RDS-6: Key rename
    private bool _isRenaming;
    private string _renameValue = string.Empty;
    private bool _renamePrevent;

    // RDS-11: Hash field add
    private string _newHashFieldName = string.Empty;
    private string _newHashFieldValue = string.Empty;

    // TTL visualisation state
    private string? _originalKey;
    private TimeSpan? _originalTtl;
    private TimeSpan? _displayedTtl;
    private RedisKeyInfo? _lastKnownKeyInfo;
    private CancellationTokenSource? _countdownCts;

    private bool CanEditCurrentType => KeyInfo?.Type is "string" or "hash";

    protected override void OnParametersSet()
    {
        if (StartEditRequestId != LastStartEditRequestId)
        {
            LastStartEditRequestId = StartEditRequestId;
            BeginEdit();
        }

        if (KeyInfo?.Type != "string")
            IsEditingString = false;

        if (KeyInfo?.Type != "hash")
            ResetHashEditState();

        // TTL visualisation: only act when KeyInfo reference actually changes (see BL-5)
        if (!ReferenceEquals(_lastKnownKeyInfo, KeyInfo))
        {
            _lastKnownKeyInfo = KeyInfo;

            if (SelectedKey != _originalKey)
            {
                // New key opened: capture original TTL and start countdown
                _originalKey = SelectedKey;
                _originalTtl = KeyInfo?.Ttl;
                _displayedTtl = KeyInfo?.Ttl;

                // RDS-8: Pre-populate TTL input from current key TTL
                TtlSeconds = KeyInfo?.Ttl is { } ttl && ttl > TimeSpan.Zero
                    ? (int)Math.Ceiling(ttl.TotalSeconds)
                    : 300;

                // Reset edit states for new key
                _isRenaming = false;
                _editingZsetMember = null;
                _newHashFieldName = string.Empty;
                _newHashFieldValue = string.Empty;

                RestartCountdown();
            }
            else if (KeyInfo is not null)
            {
                // Same key refreshed: sync displayed TTL to fresh server value
                _displayedTtl = KeyInfo.Ttl;
            }
        }
    }

    private Task RemoveTtl() => OnRemoveTtl.InvokeAsync();

    private void BeginEdit()
    {
        if (KeyInfo?.Type == "string")
        {
            IsEditingString = true;
            StringEditorValue = StringValue ?? string.Empty;
            return;
        }

        if (KeyInfo?.Type == "hash" && HashFields.Count > 0)
        {
            BeginHashFieldEdit(HashFields[0].Field, HashFields[0].Value);
        }
    }

    private void BeginHashFieldEdit(string field, string value)
    {
        IsEditingHash = true;
        EditingHashField = field;
        HashEditorValue = value;
    }

    private async Task SaveStringAsync()
    {
        await OnSetStringValue.InvokeAsync(StringEditorValue ?? string.Empty);
        IsEditingString = false;
    }

    private async Task SaveHashFieldAsync()
    {
        if (string.IsNullOrWhiteSpace(EditingHashField))
            return;

        await OnSetHashField.InvokeAsync((EditingHashField, HashEditorValue ?? string.Empty));
        ResetHashEditState();
    }

    private void CancelEdit()
    {
        IsEditingString = false;
        ResetHashEditState();
    }

    private void ResetHashEditState()
    {
        IsEditingHash = false;
        EditingHashField = null;
        HashEditorValue = string.Empty;
    }

    private Task ApplyTtlAsync()
    {
        var value = Math.Max(1, TtlSeconds);
        return OnSetTtl.InvokeAsync(value);
    }

    private string GetTtlClass() =>
        _displayedTtl is { } t && t > TimeSpan.Zero && t.TotalSeconds < 60
            ? "ttl-critical"
            : string.Empty;

    private void RestartCountdown()
    {
        _countdownCts?.Cancel();
        _countdownCts?.Dispose();
        _countdownCts = null;

        if (SelectedKey is null || _displayedTtl is null)
            return;

        _countdownCts = new CancellationTokenSource();
        _ = RunCountdownAsync(_countdownCts.Token);
    }

    private async Task RunCountdownAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var ticksUntilRefresh = 30;

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_displayedTtl.HasValue && _displayedTtl.Value > TimeSpan.Zero)
                    _displayedTtl = _displayedTtl.Value - TimeSpan.FromSeconds(1);

                ticksUntilRefresh--;
                if (ticksUntilRefresh <= 0)
                {
                    ticksUntilRefresh = 30;
                    await InvokeAsync(async () => await OnRefresh.InvokeAsync());
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on disposal or key change
        }
    }

    private async Task CopyKeyNameAsync()
    {
        if (string.IsNullOrEmpty(KeyInfo?.Key)) return;
        await CopyTextAsync(KeyInfo.Key, "Copied key name");
    }

    private Task CopyStringValueAsync() => CopyTextAsync(StringValue, "Copied value");

    private async Task CopyTextAsync(string? value, string message)
    {
        if (string.IsNullOrEmpty(value)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
        Notifications.ShowSuccess(message);
    }

    // RDS-3: ZSet score editing
    private void BeginZsetScoreEdit(string member, double score)
    {
        _editingZsetMember = member;
        _zsetScoreEditor = score.ToString(CultureInfo.InvariantCulture);
    }

    private async Task HandleZsetScoreKeyDown(KeyboardEventArgs e)
    {
        _zsetKeyPrevent = e.Key is "Enter" or "Escape";
        if (e.Key == "Enter") await SaveZsetScoreAsync();
        else if (e.Key == "Escape") _editingZsetMember = null;
    }

    private async Task SaveZsetScoreAsync()
    {
        if (_editingZsetMember is null) return;
        if (double.TryParse(_zsetScoreEditor, NumberStyles.Float, CultureInfo.InvariantCulture, out var score))
        {
            await OnUpdateSortedSetScore.InvokeAsync((_editingZsetMember, score));
            _editingZsetMember = null;
        }
    }

    // RDS-6: Key rename
    private void BeginRename()
    {
        _isRenaming = true;
        _renameValue = KeyInfo?.Key ?? string.Empty;
    }

    private void CancelRename()
    {
        _isRenaming = false;
        _renameValue = string.Empty;
    }

    private async Task HandleRenameKeyDown(KeyboardEventArgs e)
    {
        _renamePrevent = e.Key is "Enter" or "Escape";
        if (e.Key == "Enter") await ConfirmRenameAsync();
        else if (e.Key == "Escape") CancelRename();
    }

    private async Task ConfirmRenameAsync()
    {
        if (string.IsNullOrWhiteSpace(_renameValue) || _renameValue == KeyInfo?.Key)
        {
            CancelRename();
            return;
        }
        await OnRenameKey.InvokeAsync(_renameValue.Trim());
        _isRenaming = false;
    }

    // RDS-11: Add hash field
    private async Task AddHashFieldAsync()
    {
        if (string.IsNullOrWhiteSpace(_newHashFieldName)) return;
        await OnSetHashField.InvokeAsync((_newHashFieldName.Trim(), _newHashFieldValue));
        _newHashFieldName = string.Empty;
        _newHashFieldValue = string.Empty;
    }

    public void Dispose()
    {
        _countdownCts?.Cancel();
        _countdownCts?.Dispose();
        _countdownCts = null;
    }
}
