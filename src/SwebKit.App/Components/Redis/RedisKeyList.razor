@using SwebKit.Redis

<div class="redis-key-list">
    @if (IsLoading && Keys.Count == 0)
    {
        <div class="empty">Scanning...</div>
    }
    else if (Keys.Count == 0)
    {
        <div class="empty">No keys found.</div>
    }
    else
    {
        <div class="bulk-bar">
            <span class="count">@SelectedKeys.Count selected</span>
        </div>

        <div class="rows">
            <Virtualize TItem="string" Items="@Keys" Context="key" ItemSize="36" OverscanCount="5">
                @{
                    var isSelected = SelectedKeys.Contains(key, StringComparer.Ordinal);
                }
                <button @key="key" @onclick="() => OnSelectKey.InvokeAsync(key)"
                        @oncontextmenu="e => ShowContextMenu(e, key)" @oncontextmenu:preventDefault="true"
                        class="key-row @(SelectedKey == key ? "active" : "")">
                    <input type="checkbox" checked="@isSelected" @onclick:stopPropagation="true"
                           @onchange="e => OnToggleSelection(key, e)" />
                    <span class="key-name">@key</span>
                    <span class="type-badge @(GetTypeClass(key))">@GetTypeLabel(key)</span>
                </button>
            </Virtualize>
        </div>

        <ContextMenu @ref="_ctxMenu">
            <button class="ctx-item" @onclick='() => InvokeContextActionAsync("open")'><span
                class="ctx-item-icon">&#9654;</span> Open</button>
                <button class="ctx-item" @onclick='() => InvokeContextActionAsync("edit")'><span
                    class="ctx-item-icon">&#9998;</span> Edit</button>
                    <div class="ctx-separator"></div>
                    <button class="ctx-item destructive" @onclick='() => InvokeContextActionAsync("delete")'><span
                        class="ctx-item-icon">&#10005;</span> Delete</button>
                    </ContextMenu>
                }

                <div class="footer">
                    <FluentButton Disabled="@(IsLoading || IsComplete)" @onclick="OnLoadMore">Load More</FluentButton>
                </div>
            </div>

@code {
    [Parameter, EditorRequired] public IList<string> Keys { get; set; } = [];
    [Parameter, EditorRequired]
    public IReadOnlySet<string> SelectedKeys { get; set; } = new
HashSet<string>(StringComparer.Ordinal);
    [Parameter, EditorRequired] public Dictionary<string, string> KeyTypes { get; set; } = new(StringComparer.Ordinal);
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsComplete { get; set; }
    [Parameter] public EventCallback<string> OnSelectKey { get; set; }
    [Parameter] public EventCallback OnLoadMore { get; set; }
    [Parameter] public EventCallback<(string key, bool selected)> OnToggleKeySelection { get; set; }
    [Parameter] public EventCallback<(string Key, string Action)> OnContextMenuAction { get; set; }

    private ContextMenu _ctxMenu = default!;
    private string? ContextMenuKey;
    private int _lastRenderHash;

    protected override bool ShouldRender()
    {
        var hash = HashCode.Combine(Keys.Count, SelectedKeys.Count, SelectedKey, IsLoading, IsComplete);
        if (hash == _lastRenderHash) return false;
        _lastRenderHash = hash;
        return true;
    }

    private Task OnToggleSelection(string key, ChangeEventArgs args)
    {
        var selected = args.Value is bool b && b;
        return OnToggleKeySelection.InvokeAsync((key, selected));
    }

    private string GetTypeLabel(string key)
    {
        return KeyTypes.TryGetValue(key, out var type) ? type : "?";
    }

    private void ShowContextMenu(MouseEventArgs e, string key)
    {
        ContextMenuKey = key;
        _ctxMenu.Show(e.ClientX, e.ClientY);
    }

    private async Task InvokeContextActionAsync(string action)
    {
        if (ContextMenuKey is null)
            return;

        _ctxMenu.Close();
        await OnContextMenuAction.InvokeAsync((ContextMenuKey, action));
        ContextMenuKey = null;
    }

    private string GetTypeClass(string key)
    {
        return RedisValueHelpers.TypeToBadgeClass(GetTypeLabel(key));
    }
}