@using SwebKit.Redis

<div class="ns-node" style="padding-left: @($"{Depth * 16}px")">
    @if (Node.IsKey)
    {
        <div class="@RowClass" data-active="@ActiveAttributeValue" data-selected="@SelectedAttributeValue">
            @if (MultiSelectMode)
            {
                <input type="checkbox" checked="@(SelectedKeys.Contains(Node.FullKey ?? ""))" @onclick="ToggleSelection"
                       @onclick:stopPropagation="true" class="ns-checkbox" />
            }
            <button type="button" class="ns-row-main" @onclick="HandleLeafClick" title="@Node.FullKey"
                    aria-current="@ActiveAttributeValue" aria-pressed="@LeafPressedState">
                <span class="ns-toggle-placeholder"></span>
                <span class="ns-name">@Node.Name</span>
                @if (KeyType is not null)
                {
                    <span class="type-badge @RedisValueHelpers.TypeToBadgeClass(KeyType)">@KeyType</span>
                }
            </button>
        </div>
    }
    else
    {
        <div class="@NamespaceRowClass" data-selected="@NamespaceSelectedAttributeValue">
            <button type="button" class="ns-row-toggle" @onclick="Toggle" @onclick:stopPropagation="true"
                    aria-label="@ExpandToggleLabel" title="@ExpandToggleLabel">
                @if (Node.Children.Count > 0)
                {
                    <span class="ns-toggle">@(IsExpanded ? "▾" : "▸")</span>
                }
                else
                {
                    <span class="ns-toggle-placeholder"></span>
                }
            </button>
            <button type="button" class="ns-row-main" @onclick="HandleNamespaceClick" title="@NamespaceClickTitle"
                    aria-pressed="@NamespacePressedState">
                <span class="ns-name">@Node.Name</span>
            </button>
            <span class="ns-count">@Node.KeyCount</span>
            <div class="ns-row-actions">
                <button type="button" class="ns-filter" @onclick="FilterPrefix" @onclick:stopPropagation="true"
                        title="Filter by this prefix">&#x229e;</button>
            </div>
        </div>
    }

    @if (IsExpanded)
    {
        @foreach (var child in Node.Children)
        {
            <RedisNamespaceTreeNode Node="@child" OnPrefixSelected="OnPrefixSelected" OnKeySelected="OnKeySelected"
                                    SelectedKey="@SelectedKey" KeyTypes="@KeyTypes" MultiSelectMode="@MultiSelectMode" SelectedKeys="@SelectedKeys"
                                    OnKeyToggled="OnKeyToggled" OnSubtreeSelected="OnSubtreeSelected" OnSubtreeCleared="OnSubtreeCleared"
                                    Depth="@(Depth + 1)" />
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public NamespaceNode Node { get; set; } = default!;
    [Parameter] public EventCallback<string> OnPrefixSelected { get; set; }
    [Parameter] public EventCallback<string> OnKeySelected { get; set; }
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public Dictionary<string, string> KeyTypes { get; set; } = new();
    [Parameter] public bool MultiSelectMode { get; set; }
    [Parameter] public HashSet<string> SelectedKeys { get; set; } = new();
    [Parameter] public EventCallback<string> OnKeyToggled { get; set; }
    [Parameter] public EventCallback<List<string>> OnSubtreeSelected { get; set; }
    [Parameter] public EventCallback<List<string>> OnSubtreeCleared { get; set; }
    [Parameter] public int Depth { get; set; }

    private bool IsExpanded;
    private List<string> _loadedDescendantKeys = [];
    private bool _hasAnyLoadedDescendantsSelected;
    private bool _areAllLoadedDescendantsSelected;

    private bool IsActive => Node.IsKey && Node.FullKey == SelectedKey;
    private bool IsSelected => Node.IsKey && Node.FullKey is not null && SelectedKeys.Contains(Node.FullKey);
    private string? ActiveAttributeValue => IsActive ? "true" : null;
    private string? SelectedAttributeValue => IsSelected ? "true" : null;
    private string? LeafPressedState => MultiSelectMode ? (IsSelected ? "true" : "false") : null;
    private string? KeyType => Node.FullKey is not null && KeyTypes.TryGetValue(Node.FullKey, out var t) ? t : null;
    private string RowClass => $"ns-row{(IsActive ? " active" : string.Empty)}{(IsSelected ? " selected" : string.Empty)}";
    private string NamespaceRowClass => $"ns-row{(_areAllLoadedDescendantsSelected ? " selected" : string.Empty)}{(_hasAnyLoadedDescendantsSelected && !_areAllLoadedDescendantsSelected ? " partial" : string.Empty)}";
    private string? NamespaceSelectedAttributeValue => _areAllLoadedDescendantsSelected ? "true" : _hasAnyLoadedDescendantsSelected ? "mixed" : null;
    private string? NamespacePressedState => !MultiSelectMode || _loadedDescendantKeys.Count == 0
        ? null
        : _areAllLoadedDescendantsSelected ? "true" : _hasAnyLoadedDescendantsSelected ? "mixed" : "false";
    private string ExpandToggleLabel => IsExpanded ? "Collapse namespace" : "Expand namespace";
    private string NamespaceClickTitle => MultiSelectMode && _loadedDescendantKeys.Count > 0
        ? _areAllLoadedDescendantsSelected
            ? $"Clear {_loadedDescendantKeys.Count} loaded descendant key(s)"
            : $"Select {_loadedDescendantKeys.Count} loaded descendant key(s)"
        : ExpandToggleLabel;

    protected override void OnParametersSet()
    {
        if (Node.IsKey)
        {
            _loadedDescendantKeys = [];
            _hasAnyLoadedDescendantsSelected = false;
            _areAllLoadedDescendantsSelected = false;
            return;
        }

        _loadedDescendantKeys = GetLoadedDescendantKeys(Node);
        _hasAnyLoadedDescendantsSelected = _loadedDescendantKeys.Any(SelectedKeys.Contains);
        _areAllLoadedDescendantsSelected = _loadedDescendantKeys.Count > 0
            && _loadedDescendantKeys.All(SelectedKeys.Contains);
    }

    private void Toggle()
    {
        if (Node.Children.Count > 0)
            IsExpanded = !IsExpanded;
    }

    private Task HandleLeafClick()
    {
        if (Node.FullKey is null)
            return Task.CompletedTask;

        return MultiSelectMode
            ? OnKeyToggled.InvokeAsync(Node.FullKey)
            : OnKeySelected.InvokeAsync(Node.FullKey);
    }

    private Task FilterPrefix()
    {
        return OnPrefixSelected.InvokeAsync(Node.FullPrefix);
    }

    private Task ToggleSelection()
    {
        return Node.FullKey is not null ? OnKeyToggled.InvokeAsync(Node.FullKey) : Task.CompletedTask;
    }

    private Task HandleNamespaceClick()
    {
        if (!MultiSelectMode || _loadedDescendantKeys.Count == 0)
        {
            Toggle();
            return Task.CompletedTask;
        }

        return _areAllLoadedDescendantsSelected
            ? OnSubtreeCleared.InvokeAsync(_loadedDescendantKeys)
            : OnSubtreeSelected.InvokeAsync(_loadedDescendantKeys);
    }

    private static List<string> GetLoadedDescendantKeys(NamespaceNode node)
    {
        var result = new List<string>();
        CollectDescendantKeys(node, result);
        return result;
    }

    private static void CollectDescendantKeys(NamespaceNode node, List<string> keys)
    {
        foreach (var child in node.Children)
        {
            if (child.IsKey && child.FullKey is not null)
            {
                keys.Add(child.FullKey);
                continue;
            }

            CollectDescendantKeys(child, keys);
        }
    }
}
