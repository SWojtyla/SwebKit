@implements IDisposable
@inject INotificationService Notifications
@inject UiStateRepository UiState

<div class="nh-container">
    <div class="nh-header">
        <span style="color:white; font-size:13px; font-weight:600;">Notifications</span>
        <button @onclick="Notifications.ClearAll" class="nh-clear-btn">
            Clear all
        </button>
    </div>

    <div class="nh-scroll">
        @if (Notifications.All.Count == 0 && UiState.State.NotificationHistory.Count == 0)
        {
            <div class="nh-empty">
                No notifications yet.
            </div>
        }
        else
        {
            @if (Notifications.All.Count > 0)
            {
                @foreach (var n in Notifications.All.Reverse())
                {
                    <div class="nh-row">
                        <span class="nh-row-icon"
                        style="color:@GetAccentColor(n.Severity);">@GetIcon(n.Severity)</span>
                        <div class="nh-body">
                            <div class="nh-title">
                                @n.Message</div>
                                @if (!string.IsNullOrEmpty(n.Detail))
                                {
                                    <div class="nh-detail">
                                        @n.Detail</div>
                                    }
                                </div>
                                <span class="nh-timestamp">@n.Timestamp.ToString("HH:mm:ss")</span>
                            </div>
                        }
                    }

                    @if (UiState.State.NotificationHistory.Count > 0)
                    {
                        <div class="nh-history-label-row">
                            <span style="color:rgba(255,255,255,0.5); font-size:11px; font-weight:600;">History</span>
                        </div>
                        @foreach (var h in UiState.State.NotificationHistory)
                        {
                            <div class="nh-history-row">
                                <span class="nh-row-icon"
                                style="color:@GetHistoryAccentColor(h.Severity);">@GetHistoryIcon(h.Severity)</span>
                                <div class="nh-body">
                                    <div class="nh-history-title">
                                        @h.Message</div>
                                        @if (!string.IsNullOrEmpty(h.Detail))
                                        {
                                            <div class="nh-history-detail">
                                                @h.Detail</div>
                                            }
                                        </div>
                                        <span class="nh-history-timestamp">@FormatHistoryTimestamp(h.Timestamp)</span>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>

@code {
    protected override void OnInitialized()
    {
        Notifications.NotificationsChanged += OnNotificationsChanged;
    }

    private void OnNotificationsChanged() => InvokeAsync(StateHasChanged);

    private async Task ClearHistoryAsync()
    {
        UiState.State.NotificationHistory.Clear();
        await UiState.SaveAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static string FormatHistoryTimestamp(DateTimeOffset ts)
    {
        var age = DateTimeOffset.UtcNow - ts;
        if (age.TotalMinutes < 1) return "just now";
        if (age.TotalHours < 1) return $"{(int)age.TotalMinutes}m ago";
        if (age.TotalDays < 1) return $"{(int)age.TotalHours}h ago";
        return ts.LocalDateTime.ToString("MMM d HH:mm");
    }

    private static string GetAccentColor(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Success => "#22C55E",
        NotificationSeverity.Warning => "#F59E0B",
        NotificationSeverity.Error => "#EF4444",
        _ => "#3B82F6",
    };

    private static string GetIcon(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Success => "✓",
        NotificationSeverity.Warning => "⚠",
        NotificationSeverity.Error => "✕",
        _ => "ℹ",
    };

    private static string GetHistoryAccentColor(string severity) => severity switch
    {
        "Success" => "#22C55E",
        "Warning" => "#F59E0B",
        "Error" => "#EF4444",
        _ => "#3B82F6",
    };

    private static string GetHistoryIcon(string severity) => severity switch
    {
        "Success" => "✓",
        "Warning" => "⚠",
        "Error" => "✕",
        _ => "ℹ",
    };

    public void Dispose()
    {
        Notifications.NotificationsChanged -= OnNotificationsChanged;
    }
}