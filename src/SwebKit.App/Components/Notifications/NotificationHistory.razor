@implements IDisposable
@inject INotificationService Notifications
@inject UiStateRepository UiState

<div class="nh-container" role="dialog" aria-label="Notification center">
    <div class="nh-header">
        <div>
            <div class="nh-heading">Notifications</div>
            <div class="nh-subtitle">@SummaryText</div>
        </div>

        <div class="nh-header-actions">
            @if (UiState.State.NotificationHistory.Count > 0)
            {
                <button @onclick="ClearHistoryAsync" class="nh-clear-btn">
                    Clear history
                </button>
            }
            @if (Notifications.All.Count > 0)
            {
                <button @onclick="Notifications.ClearAll" class="nh-clear-btn">
                    Clear all
                </button>
            }
            @if (OnClose.HasDelegate)
            {
                <button @onclick="OnClose" class="nh-clear-btn" aria-label="Close notification center">
                    Close
                </button>
            }
        </div>
    </div>

    <div class="nh-scroll">
        @if (Notifications.All.Count == 0 && UiState.State.NotificationHistory.Count == 0)
        {
            <div class="nh-empty">
                No notifications yet.
            </div>
        }
        else
        {
            @if (Notifications.All.Count > 0)
            {
                <section class="nh-section" aria-label="Active notifications">
                    <div class="nh-section-label">Active</div>
                    @foreach (var notification in Notifications.All.Reverse())
                    {
                        <div class="nh-row" role="listitem">
                            <span
                            class="nh-row-icon @GetSeverityClass(notification.Severity)">@GetIcon(notification.Severity)</span>
                            <div class="nh-body">
                                <div class="nh-title-row">
                                    <div class="nh-title">@notification.Message</div>
                                    <span
                                    class="nh-badge @GetSeverityBadgeClass(notification.Severity)">@GetSeverityLabel(notification.Severity)</span>
                                </div>
                                @if (!string.IsNullOrEmpty(notification.Detail))
                                {
                                    <div class="nh-detail">@notification.Detail</div>
                                }
                            </div>
                            <span class="nh-timestamp">@FormatTimestamp(notification.Timestamp)</span>
                        </div>
                    }
                </section>
            }

            @if (UiState.State.NotificationHistory.Count > 0)
            {
                <section class="nh-section" aria-label="Notification history">
                    <div class="nh-section-label">Recent</div>
                    @foreach (var notification in UiState.State.NotificationHistory)
                    {
                        <div class="nh-history-row" role="listitem">
                            <span
                            class="nh-row-icon @GetHistorySeverityClass(notification.Severity)">@GetHistoryIcon(notification.Severity)</span>
                            <div class="nh-body">
                                <div class="nh-title-row">
                                    <div class="nh-history-title">@notification.Message</div>
                                    <span
                                    class="nh-badge @GetHistorySeverityBadgeClass(notification.Severity)">@notification.Severity</span>
                                </div>
                                @if (!string.IsNullOrEmpty(notification.Detail))
                                {
                                    <div class="nh-history-detail">@notification.Detail</div>
                                }
                            </div>
                            <span class="nh-history-timestamp">@FormatTimestamp(notification.Timestamp)</span>
                        </div>
                    }
                </section>
            }
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string SummaryText => Notifications.All.Count switch
    {
        > 0 when UiState.State.NotificationHistory.Count > 0 => $"{Notifications.All.Count} active, {UiState.State.NotificationHistory.Count} recent",
        > 0 => $"{Notifications.All.Count} active notification{(Notifications.All.Count == 1 ? string.Empty : "s")}",
        _ when UiState.State.NotificationHistory.Count > 0 => $"{UiState.State.NotificationHistory.Count} recent notification{(UiState.State.NotificationHistory.Count == 1 ? string.Empty : "s")}",
        _ => "No recent activity yet",
    };

    protected override void OnInitialized()
    {
        Notifications.NotificationsChanged += OnNotificationsChanged;
    }

    private void OnNotificationsChanged() => InvokeAsync(StateHasChanged);

    private async Task ClearHistoryAsync()
    {
        UiState.State.NotificationHistory.Clear();
        await UiState.SaveAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static string FormatTimestamp(DateTimeOffset ts)
    {
        var age = DateTimeOffset.UtcNow - ts;
        if (age.TotalMinutes < 1) return "just now";
        if (age.TotalHours < 1) return $"{(int)age.TotalMinutes}m ago";
        if (age.TotalDays < 1) return $"{(int)age.TotalHours}h ago";
        return ts.LocalDateTime.ToString("MMM d HH:mm");
    }

    private static string GetSeverityLabel(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Success => "Success",
        NotificationSeverity.Warning => "Warning",
        NotificationSeverity.Error => "Error",
        _ => "Info",
    };

    private static string GetSeverityClass(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Success => "nh-row-icon--success",
        NotificationSeverity.Warning => "nh-row-icon--warning",
        NotificationSeverity.Error => "nh-row-icon--error",
        _ => "nh-row-icon--info",
    };

    private static string GetSeverityBadgeClass(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Success => "nh-badge--success",
        NotificationSeverity.Warning => "nh-badge--warning",
        NotificationSeverity.Error => "nh-badge--error",
        _ => "nh-badge--info",
    };

    private static string GetHistorySeverityClass(string severity) => severity switch
    {
        "Success" => "nh-row-icon--success",
        "Warning" => "nh-row-icon--warning",
        "Error" => "nh-row-icon--error",
        _ => "nh-row-icon--info",
    };

    private static string GetIcon(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Success => "✓",
        NotificationSeverity.Warning => "⚠",
        NotificationSeverity.Error => "✕",
        _ => "ℹ",
    };

    private static string GetHistorySeverityBadgeClass(string severity) => severity switch
    {
        "Success" => "nh-badge--success",
        "Warning" => "nh-badge--warning",
        "Error" => "nh-badge--error",
        _ => "nh-badge--info",
    };

    private static string GetHistoryIcon(string severity) => severity switch
    {
        "Success" => "✓",
        "Warning" => "⚠",
        "Error" => "✕",
        _ => "ℹ",
    };

    public void Dispose()
    {
        Notifications.NotificationsChanged -= OnNotificationsChanged;
    }
}