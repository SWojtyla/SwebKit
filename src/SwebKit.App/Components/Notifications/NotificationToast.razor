@implements IDisposable
@inject INotificationService Notifications

@if (Notifications.All.Count > 0)
{
    <div class="nt-container">
        @foreach (var n in Notifications.All.TakeLast(4))
        {
            <div class="nt-toast" style="border-left-color:@GetAccentColor(n.Severity);">
                <button @onclick="() => Notifications.Dismiss(n.Id)" class="nt-dismiss-btn">
                    ×
                </button>
                <div class="nt-content">
                    <span class="nt-icon"
                    style="color:@GetAccentColor(n.Severity);">@GetIcon(n.Severity)</span>
                    <span class="nt-label">@n.Message</span>
                </div>
                @if (!string.IsNullOrEmpty(n.Detail))
                {
                    <div class="notification-detail @(_expandedIds.Contains(n.Id) ? "expanded" : "")">
                        @n.Detail</div>
                        <button class="notification-toggle" @onclick="() => ToggleExpand(n.Id)" @onclick:stopPropagation>
                            @(_expandedIds.Contains(n.Id) ? "Show less" : "Show more")
                        </button>
                    }
                </div>
            }
        </div>
    }

@code {
    private readonly Dictionary<Guid, System.Timers.Timer> _timers = new();
    private readonly HashSet<Guid> _expandedIds = new();
    // _timers is accessed from both Blazor sync-context and ThreadPool timer callbacks.
    private readonly object _timersLock = new();

    protected override void OnInitialized()
    {
        Notifications.NotificationsChanged += OnNotificationsChanged;
    }

    private void OnNotificationsChanged()
    {
        var currentIds = Notifications.All.Select(n => n.Id).ToHashSet();

        lock (_timersLock)
        {
            // Dispose timers for notifications that are no longer present
            foreach (var id in _timers.Keys.Where(k => !currentIds.Contains(k)).ToList())
            {
                if (_timers.Remove(id, out var stale))
                    stale.Dispose();
            }

            // Start timers for newly added notifications
            foreach (var n in Notifications.All)
            {
                if (_timers.ContainsKey(n.Id)) continue;

                var intervalMs = n.Severity is NotificationSeverity.Success or NotificationSeverity.Info ? 4000 : 8000;
                var timer = new System.Timers.Timer(intervalMs) { AutoReset = false };
                var capturedId = n.Id;
                timer.Elapsed += async (_, _) =>
                {
                    Notifications.Dismiss(capturedId);
                    await InvokeAsync(StateHasChanged);
                };
                _timers[capturedId] = timer;
                timer.Start();
            }
        }

        InvokeAsync(StateHasChanged);
    }

    private static string GetAccentColor(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Success => "#22C55E",
        NotificationSeverity.Warning => "#F59E0B",
        NotificationSeverity.Error => "#EF4444",
        _ => "#3B82F6",
    };

    private static string GetIcon(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Success => "✓",
        NotificationSeverity.Warning => "⚠",
        NotificationSeverity.Error => "✕",
        _ => "ℹ",
    };

    private void ToggleExpand(Guid id)
    {
        if (!_expandedIds.Remove(id)) _expandedIds.Add(id);
    }

    public void Dispose()
    {
        Notifications.NotificationsChanged -= OnNotificationsChanged;
        lock (_timersLock)
        {
            foreach (var timer in _timers.Values) timer.Dispose();
            _timers.Clear();
        }
    }
}