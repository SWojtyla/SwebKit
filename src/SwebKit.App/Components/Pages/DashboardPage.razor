@page "/"
@page "/dashboard"
@inject AppStateService AppState
@inject IConfigurationHealthService ConfigurationHealth
@inject IDevOpsClientFactory DevOpsClientFactory
@inject IAppEventBus Events
@inject ICredentialStore CredentialStore
@inject IPodHealthMonitorService Monitor
@inject NavigationManager Nav
@inject SwebKit.Core.Services.DemoDevOpsClient DemoDevOpsClient
@inject OperatorWorkspaceService Workspaces
@implements IDisposable

@{
    var pinnedItems = GetPinnedItems();
    var readinessReport = BuildReadinessReport();
    var showReadiness = readinessReport.RequiresDashboardAttention;
    var readinessAreas = readinessReport.AttentionAreas;
}

<div class="dashboard-page">
    <RoutePageHeader Area="dashboard" Subtitle="Here's what needs attention.">
        <Meta>
            @if (AppState.UseDemoData)
            {
                <span class="shell-pill shell-pill--warning">Demo mode</span>
            }
            <span class="shell-pill shell-pill--muted">@pinnedItems.Count pinned</span>
            @if (Monitor.IsMonitoring)
            {
                <span class="shell-pill shell-pill--accent">@Monitor.MonitoredNamespaces.Count
                    namespace@(Monitor.MonitoredNamespaces.Count == 1 ? "" : "s") monitored</span>
                }
            </Meta>
            <Actions>
                <button class="page-header-action-btn dashboard-refresh-btn" @onclick="RefreshAll"
                        title="Refresh health data" aria-label="Refresh dashboard health">
                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" Width="16px" />
                    Refresh
                </button>
            </Actions>
        </RoutePageHeader>

        @if (showReadiness)
        {
            <section class="dashboard-section dashboard-section--readiness" data-testid="dashboard-readiness">
                <div class="dashboard-readiness-summary">
                    <div>
                        <p class="dashboard-readiness-eyebrow">Environment readiness</p>
                        <h2 class="dashboard-readiness-title">
                            @(readinessReport.IsFirstRun ? "Set up your operator workspace" : "Current configuration readiness")
                        </h2>
                        <p class="dashboard-readiness-body">@readinessReport.Summary</p>
                    </div>
                    <span class="dashboard-readiness-status @GetReadinessStatusClass(readinessReport.OverallStatus)">
                        @GetReadinessLabel(readinessReport.OverallStatus)
                    </span>
                </div>

                @if (readinessReport.ActionItems.Count > 0)
                {
                    <div class="dashboard-readiness-checklist" data-testid="dashboard-readiness-checklist">
                        @foreach (var actionItem in readinessReport.ActionItems)
                        {
                            <article class="dashboard-readiness-item">
                                <div class="dashboard-readiness-item__copy">
                                    <h3>@actionItem.Title</h3>
                                    <p>@actionItem.Summary</p>
                                </div>
                                <a class="dashboard-readiness-item__action" href="@GetSettingsHref(actionItem.SettingsSection)">
                                    @actionItem.ActionLabel
                                </a>
                            </article>
                        }
                    </div>
                }

                <div class="dashboard-readiness-areas">
                    @foreach (var area in readinessAreas)
                    {
                        <article class="dashboard-readiness-area @GetReadinessStatusClass(area.Status)">
                            <div class="dashboard-readiness-area__header">
                                <h3>@area.Title</h3>
                                <span class="dashboard-readiness-area__badge">@GetReadinessLabel(area.Status)</span>
                            </div>
                            <p class="dashboard-readiness-area__summary">@area.Summary</p>
                            @if (!string.IsNullOrWhiteSpace(area.Detail))
                            {
                                <p class="dashboard-readiness-area__detail">@area.Detail</p>
                            }
                            @if (area.ActionItems.Count > 0)
                            {
                                <a class="dashboard-readiness-area__link" href="@GetSettingsHref(area.SettingsSection)">
                                    Review @area.Title settings
                                </a>
                            }
                        </article>
                    }
                </div>
            </section>
        }

        @* ── Hero stats row ── *@
        <div class="dashboard-hero-row">
            <div class="hero-stat @(_sbConfigured ? "" : "hero-stat--unconfigured")">
                <span class="hero-stat-icon">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowSwap())" Width="20px" />
                </span>
                <span class="hero-stat-value">@(_sbData is not null ? $"{_sbData.Value} {_sbData.Label}" : "—")</span>
                <span class="hero-stat-label">Service Bus</span>
            </div>
            <div class="hero-stat @(_aksConfigured ? "" : "hero-stat--unconfigured")">
                <span class="hero-stat-icon">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Cloud())" Width="20px" />
                </span>
                <span class="hero-stat-value">@(_aksData is not null ? $"{_aksData.Value} {_aksData.Label}" : "—")</span>
                <span class="hero-stat-label">AKS</span>
            </div>
            <div class="hero-stat @(_redisConfigured ? "" : "hero-stat--unconfigured")">
                <span class="hero-stat-icon">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Database())" Width="20px" />
                </span>
                <span class="hero-stat-value">@(_redisData is not null ? $"{_redisData.Value} {_redisData.Label}" :
                                                                                                                                                                            "—")</span>
                    <span class="hero-stat-label">Redis</span>
                </div>
                <div class="hero-stat @(_releasesConfigured ? "" : "hero-stat--unconfigured")">
                    <span class="hero-stat-icon">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Rocket())" Width="20px" />
                    </span>
                    <span class="hero-stat-value">@(_releasesData is not null ? $"{_releasesData.Value} {_releasesData.Label}" :
                                                                                                                                                                                                             "—")</span>
                        <span class="hero-stat-label">Pipelines</span>
                    </div>
                </div>

                @* ── Health tiles ── *@
                <section class="dashboard-section">
                    <h2 class="dashboard-section-title">Health</h2>
                    <div class="health-grid">
                        <div class="health-tile-wrap health-tile-wrap--servicebus">
                            <HealthTile Title="Service Bus" Icon="⇄" IsConfigured="@_sbConfigured" Data="@_sbData" Error="@_sbError"
                                        OnNavigateToSettings="NavigateToSettings" />
                        </div>
                        <div class="health-tile-wrap health-tile-wrap--aks">
                            <HealthTile Title="AKS" Icon="☁" IsConfigured="@_aksConfigured" Data="@_aksData" Error="@_aksError"
                                        OnNavigateToSettings="NavigateToSettings" />
                        </div>
                        <div class="health-tile-wrap health-tile-wrap--redis">
                            <HealthTile Title="Redis" Icon="⬡" IsConfigured="@_redisConfigured" Data="@_redisData"
                                        Error="@_redisError" OnNavigateToSettings="NavigateToSettings" />
                        </div>
                        <div class="health-tile-wrap health-tile-wrap--pipelines">
                            <HealthTile Title="Pipelines" Icon="🚀" IsConfigured="@_releasesConfigured" Data="@_releasesData"
                                        Error="@_releasesError" OnNavigateToSettings="NavigateToSettings" />
                        </div>
                    </div>
                </section>

                @* ── Pod Health Alerts (only when monitoring is active) ── *@
                @if (Monitor.IsMonitoring || _monitorAlerts.Count > 0)
                {
                    <section class="dashboard-section">
                        <h2 class="dashboard-section-title">
                            Pod Health
                            @if (Monitor.IsMonitoring)
                            {
                                <span class="ph-monitoring-badge">monitoring</span>
                            }
                        </h2>

                        @* ── Monitored namespaces row ── *@
                        @if (Monitor.IsMonitoring && Monitor.MonitoredNamespaces.Count > 0)
                        {
                            <div class="ph-ns-row">
                                @foreach (var ns in Monitor.MonitoredNamespaces)
                                {
                                    <span class="ph-ns-chip">
                                        <span class="ph-ns-chip-label">@ns</span>
                                        <button class="ph-ns-chip-remove" title="Stop monitoring @ns" aria-label="Stop monitoring @ns"
                                                @onclick="() => StopMonitoringNamespaceAsync(ns)">✕</button>
                                    </span>
                                }
                                @if (Monitor.MonitoredNamespaces.Count > 1)
                                {
                                    <button class="ph-ns-stop-all" @onclick="StopAllMonitoringAsync" title="Stop all pod health monitoring">
                                        Stop all
                                    </button>
                                }
                            </div>
                        }

                        @if (_monitorAlerts.Count == 0)
                        {
                            <p class="dashboard-empty">No pod health events detected.</p>
                        }
                        else
                        {
                            <div class="ph-alert-list">
                                @foreach (var evt in _monitorAlerts.Take(6))
                                {
                                    <div class="ph-alert-row ph-@evt.EventType.ToString().ToLowerInvariant()">
                                        <span class="ph-alert-icon">⚠</span>
                                        <div class="ph-alert-body">
                                            <span class="ph-alert-pod">@evt.PodName</span>
                                            <span class="ph-alert-meta">@evt.Namespace — @evt.EventType</span>
                                        </div>
                                        <span class="ph-alert-time">@RelativeTime(evt.DetectedAt)</span>
                                    </div>
                                }
                            </div>
                            @if (_monitorAlerts.Count > 6)
                            {
                                <p class="ph-overflow-hint">+@(_monitorAlerts.Count - 6) more — see AKS page for full history</p>
                            }
                        }
                    </section>
                }

                @* ── Lower 2-column: activity feed + pinned ── *@
                <div class="dashboard-lower">
                    <section class="dashboard-activity-panel">
                        <h2 class="dashboard-section-title">Recent Activity</h2>
                        @if (_activities.Count == 0)
                        {
                            <EmptyState Icon="⋯" Title="No recent activity"
                                        Subtitle="Actions you take across Service Bus, AKS, and Pipelines will appear here.">
                                <Actions>
                                    <a href="/service-bus">Open Service Bus</a>
                                    <a href="/aks">Open AKS</a>
                                </Actions>
                            </EmptyState>
                        }
                        else
                        {
                            <div class="activity-list">
                                @foreach (var a in _activities)
                                {
                                    <div class="activity-item">
                                        <span class="activity-icon">@a.Icon</span>
                                        <span class="activity-desc">@a.Description</span>
                                        <span class="activity-time">@RelativeTime(a.OccurredAt)</span>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <aside class="dashboard-pinned-panel">
                        <h2 class="dashboard-section-title">Pinned</h2>
                        @if (pinnedItems.Count == 0)
                        {
                            <EmptyState Icon="⌘" Title="No pinned items"
                                        Subtitle="Pin queues, topics, subscriptions, or workloads from their workspace to keep them close.">
                                <Actions>
                                    <a href="/service-bus">Browse Service Bus</a>
                                    <a href="/aks">Browse AKS</a>
                                </Actions>
                            </EmptyState>
                        }
                        else
                        {
                            <div class="pinned-chips">
                                @foreach (var pin in pinnedItems)
                                {
                                    <button class="pinned-chip" @onclick="() => NavigateToPin(pin)" title="@pin.DisplayPath">
                                        <span class="pinned-chip-icon">@pin.Icon</span>
                                        <span class="pinned-chip-name">@pin.DisplayPath</span>
                                    </button>
                                }
                            </div>
                        }
                    </aside>
                </div>

            </div>

@code {
    // ── Health state ────────────────────────────────────────────────────────────────
    private bool _sbConfigured, _aksConfigured, _redisConfigured, _releasesConfigured;
    private HealthTileData? _sbData, _aksData, _redisData, _releasesData;
    private string? _sbError, _aksError, _redisError, _releasesError;

    // ── Pod Health ──────────────────────────────────────────────────────────────────
    private readonly List<PodHealthEvent> _monitorAlerts = [];

    // ── Activity feed ───────────────────────────────────────────────────────────────
    private record ActivityRecord(string Description, string Icon, string Area, DateTimeOffset OccurredAt);
    private readonly List<ActivityRecord> _activities = [];

    // ── Pinned entities ─────────────────────────────────────────────────────────────
    private sealed record DashboardPinnedItem(string DisplayPath, string Icon, WorkspaceSnapshot Snapshot);

    // ── Lifecycle ───────────────────────────────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _refreshTimer;

    protected override void OnInitialized()
    {
        Events.Subscribe<ActivityEvent>(OnActivityReceived);
        Events.Subscribe<RefreshRequestedEvent>(OnRefreshRequested);
        Monitor.PodHealthDetected += OnPodHealthDetected;
        Workspaces.Changed += OnWorkspaceChanged;
        // Seed from ring buffer so alerts already recorded before dashboard load are visible.
        _monitorAlerts.AddRange(Monitor.RecentEvents);
    }

    protected override Task OnInitializedAsync()
    {
        _ = LoadHealthDataAsync(_cts.Token);
        _ = StartRefreshLoopAsync();
        return Task.CompletedTask;
    }

    private async Task StartRefreshLoopAsync()
    {
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            while (await _refreshTimer.WaitForNextTickAsync(_cts.Token))
                await LoadHealthDataAsync(_cts.Token);
        }
        catch (OperationCanceledException) { }
    }

    private void OnPodHealthDetected(PodHealthEvent evt)
    {
        _ = InvokeAsync(() =>
        {
            _monitorAlerts.Insert(0, evt);
            if (_monitorAlerts.Count > 50)
                _monitorAlerts.RemoveAt(_monitorAlerts.Count - 1);
            StateHasChanged();
        });
    }

    private void OnActivityReceived(ActivityEvent e)
    {
        var record = new ActivityRecord(e.Description, e.Icon, e.Area, e.OccurredAt);
        _ = InvokeAsync(() =>
        {
            _activities.Insert(0, record);
            if (_activities.Count > 10)
                _activities.RemoveAt(_activities.Count - 1);
            StateHasChanged();
        });
    }

    private void OnRefreshRequested(RefreshRequestedEvent refresh)
    {
        if (!string.Equals(refresh.Area, "dashboard", StringComparison.Ordinal))
        {
            return;
        }

        _ = InvokeAsync(RefreshAll);
    }

    private void OnWorkspaceChanged() => InvokeAsync(StateHasChanged);

    private Task RefreshAll() => LoadHealthDataAsync(_cts.Token);

    private async Task StopMonitoringNamespaceAsync(string ns)
    {
        await Monitor.RemoveNamespaceAsync(ns);
        await InvokeAsync(StateHasChanged);
    }

    private async Task StopAllMonitoringAsync()
    {
        await Monitor.StopAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadHealthDataAsync(CancellationToken ct)
    {
        DetermineConfiguredState();
        await InvokeAsync(StateHasChanged);

        using var linked = CancellationTokenSource.CreateLinkedTokenSource(ct);
        linked.CancelAfter(TimeSpan.FromSeconds(10));

        await Task.WhenAll(
            FetchServiceBusAsync(linked.Token),
            FetchAksAsync(linked.Token),
            FetchRedisAsync(linked.Token),
            FetchReleasesAsync(linked.Token));

        await InvokeAsync(StateHasChanged);
    }

    private void DetermineConfiguredState()
    {
        _sbConfigured = AppState.UseDemoData || AppState.ServiceBusNamespaces.Count > 0;
        _aksConfigured = AppState.UseDemoData || AppState.Config.AksConfig is not null;
        _redisConfigured = AppState.UseDemoData || AppState.Config.RedisConfig?.ActiveCache is not null;
        _releasesConfigured = AppState.UseDemoData ||
            (AppState.Config.DevOpsConfig is not null && !string.IsNullOrEmpty(AppState.Config.DevOpsConfig.Organization));
    }

    // ── Service Bus ─────────────────────────────────────────────────────────────────

    private async Task FetchServiceBusAsync(CancellationToken ct)
    {
        if (!_sbConfigured) return;
        try
        {
            long dlq = 0;
            if (AppState.UseDemoData)
            {
                dlq += await SumDlqAsync(DemoServiceBusClient.OrdersDev(), ct);
            }
            else
            {
                foreach (var ns in AppState.ServiceBusNamespaces)
                {
                    var connStr = CredentialStore.Get(ns.CredentialKey);
                    if (string.IsNullOrWhiteSpace(connStr)) continue;
                    await using var client = new SwebKit.Azure.ServiceBus.AzureServiceBusClient(connStr);
                    dlq += await SumDlqAsync(client, ct);
                }
            }
            _sbData = new HealthTileData((int)dlq, "dead-lettered", DateTimeOffset.Now);
            _sbError = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _sbError = ex.Message;
        }
    }

    private static async Task<long> SumDlqAsync(IServiceBusClient client, CancellationToken ct)
    {
        var queues = await client.ListQueuesAsync(ct);
        var statsTasks = queues.Select(q => client.GetEntityStatsAsync(q.EntityPath, ct));
        var stats = await Task.WhenAll(statsTasks);
        return stats.Sum(s => s.DeadLetterMessageCount);
    }

    // ── AKS ─────────────────────────────────────────────────────────────────────────

    private async Task FetchAksAsync(CancellationToken ct)
    {
        if (!_aksConfigured) return;
        try
        {
            var aksConfig = AppState.Config.AksConfig;
            var ns = aksConfig?.DefaultNamespace ?? "default";

            IAksClient client = AppState.UseDemoData
                ? new DemoAksClient()
                : new SwebKit.Kubernetes.AksClient.KubernetesAksClient(
                    aksConfig!.KubeconfigContext,
                    aksConfig.KubeconfigPath);

            var pods = await client.GetPodsAsync(ns, null, ct);
            var unhealthy = pods.Count(p => p.Status is not ("Running" or "Succeeded" or "Completed"));
            _aksData = new HealthTileData(unhealthy, "unhealthy pods", DateTimeOffset.Now);
            _aksError = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _aksError = ex.Message;
        }
    }

    // ── Redis ────────────────────────────────────────────────────────────────────────

    private async Task FetchRedisAsync(CancellationToken ct)
    {
        if (!_redisConfigured) return;
        try
        {
            IRedisClient client = AppState.UseDemoData
                ? new DemoRedisClient(0)
                : await SwebKit.Redis.RedisClient.CreateAsync(AppState.Config.RedisConfig!.ActiveCache!);

            using (client)
            {
                var scan = await client.ScanKeysAsync("*", 0, 100, ct);
                var infoTasks = scan.Keys.Select(k => client.GetKeyInfoAsync(k, ct));
                var infos = await Task.WhenAll(infoTasks);
                var nearExpiry = infos.Count(i => i.Ttl is { } ttl && ttl < TimeSpan.FromMinutes(5) && ttl > TimeSpan.Zero);
                _redisData = new HealthTileData(nearExpiry, "keys expiring < 5m", DateTimeOffset.Now);
                _redisError = null;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _redisError = ex.Message;
        }
    }

    // ── Releases ─────────────────────────────────────────────────────────────────────

    private async Task FetchReleasesAsync(CancellationToken ct)
    {
        if (!_releasesConfigured) return;
        try
        {
            IDevOpsClient client = AppState.UseDemoData
                ? DemoDevOpsClient
                : CreateLiveDevOpsClient();
            var projects = await client.GetProjectsAsync(ct);
            var approvalTasks = projects.Select(p => client.GetPendingApprovalsAsync(p.Name, ct));
            var results = await Task.WhenAll(approvalTasks);
            var total = results.Sum(r => r.Count);
            _releasesData = new HealthTileData(total, "pending approvals", DateTimeOffset.Now);
            _releasesError = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _releasesError = ex.Message;
        }
    }

    private IDevOpsClient CreateLiveDevOpsClient()
    {
        var config = AppState.Config.DevOpsConfig
            ?? throw new InvalidOperationException("Azure DevOps is not configured.");

        return DevOpsClientFactory.Create(config);
    }

    // ── Navigation ───────────────────────────────────────────────────────────────────

    private void NavigateToSettings() => Events.Publish(new NavigateToAreaEvent("settings"));

    private ConfigurationHealthReport BuildReadinessReport() =>
        ConfigurationHealth.BuildReport(new ConfigurationHealthContext(
            AppState.Config,
            AppState.ServiceBusNamespaces,
            AppState.UseDemoData,
            AppState.HasProfileLoadFailure,
            AppState.ProfilePersistenceBlockedMessage));

    private static string GetReadinessLabel(ConfigurationCheckStatus status) => status switch
    {
        ConfigurationCheckStatus.NotConfigured => "Not configured",
        ConfigurationCheckStatus.Configured => "Configured",
        ConfigurationCheckStatus.Ready => "Ready",
        ConfigurationCheckStatus.Warning => "Needs attention",
        ConfigurationCheckStatus.Error => "Error",
        _ => "Skipped"
    };

    private static string GetReadinessStatusClass(ConfigurationCheckStatus status) => status switch
    {
        ConfigurationCheckStatus.NotConfigured => "readiness-status--muted",
        ConfigurationCheckStatus.Configured => "readiness-status--info",
        ConfigurationCheckStatus.Ready => "readiness-status--success",
        ConfigurationCheckStatus.Warning => "readiness-status--warning",
        ConfigurationCheckStatus.Error => "readiness-status--danger",
        _ => "readiness-status--muted"
    };

    private string GetSettingsHref(string section) => Nav.ToAbsoluteUri($"/settings?section={section}").PathAndQuery;

    private Task NavigateToPin(DashboardPinnedItem pin) => Workspaces.OpenSnapshotAsync(pin.Snapshot, recordRecent: true);

    private IReadOnlyList<DashboardPinnedItem> GetPinnedItems()
    {
        var items = new List<DashboardPinnedItem>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var favorite in Workspaces.GetFavoriteResources())
        {
            AddPinnedItem(items, seen, BuildFavoritePinnedItem(favorite));
        }

        return items;
    }

    // ── Helpers ──────────────────────────────────────────────────────────────────────

    private DashboardPinnedItem BuildFavoritePinnedItem(FavoriteResource favorite)
    {
        var icon = favorite.Snapshot.Resource.Area switch
        {
            "service-bus" => "⇄",
            "aks" => "☁",
            "observability" => "📈",
            "storage" => "📁",
            "redis" => "⚡",
            _ => favorite.Snapshot.Resource.Icon ?? "⌘"
        };

        return new DashboardPinnedItem(
            favorite.Snapshot.Resource.DisplayPath ?? favorite.Snapshot.Resource.DisplayName,
            icon,
            favorite.Snapshot.Clone());
    }

    private static void AddPinnedItem(
        List<DashboardPinnedItem> items,
        HashSet<string> seen,
        DashboardPinnedItem item)
    {
        var key = item.Snapshot.Resource.Key;
        if (seen.Add(key))
        {
            items.Add(item);
        }
    }

    private static string RelativeTime(DateTimeOffset at)
    {
        var elapsed = DateTimeOffset.Now - at;
        return elapsed.TotalSeconds < 60
            ? $"{(int)elapsed.TotalSeconds}s ago"
            : elapsed.TotalMinutes < 60
                ? $"{(int)elapsed.TotalMinutes}m ago"
                : $"{(int)elapsed.TotalHours}h ago";
    }

    public void Dispose()
    {
        Events.Unsubscribe<ActivityEvent>(OnActivityReceived);
        Events.Unsubscribe<RefreshRequestedEvent>(OnRefreshRequested);
        Monitor.PodHealthDetected -= OnPodHealthDetected;
        Workspaces.Changed -= OnWorkspaceChanged;
        _cts.Cancel();
        _cts.Dispose();
        _refreshTimer?.Dispose();
    }
}
