@page "/"
@page "/dashboard"
@inject AppStateService AppState
@inject IDevOpsClientFactory DevOpsClientFactory
@inject IServiceBusClientFactory SbClientFactory
@inject IAksClientFactory AksClientFactory
@inject IRedisClientFactory RedisClientFactory
@inject IAppEventBus Events
@inject ICredentialStore CredentialStore
@inject INotificationService Notifications
@inject IPodHealthMonitorService Monitor
@inject NavigationManager Nav
@inject UiStateRepository UiState
@inject SwebKit.Core.Services.DemoDevOpsClient DemoDevOpsClient
@inject SwebKit.Core.Services.DemoAksClient DemoAksClient
@inject SwebKit.Core.Services.DemoRedisClient DemoRedisClient
@inject OperatorWorkspaceService Workspaces
@implements IDisposable

@{
    var renderState = GetRenderState();
    var activeView = renderState.ActiveView;
    var activeFilters = activeView.Filters;
    var dashboardViews = renderState.DashboardViews;
    var pinnedItems = renderState.PinnedItems;
    var recentItems = renderState.RecentItems;
    var openTabs = renderState.OpenTabs;
    var boardTiles = renderState.BoardTiles;
    var editorRows = renderState.EditorRows;
    var visibleRows = editorRows.Where(static row => row.Preference.IsVisible).ToList();
    var hiddenRows = editorRows.Where(static row => !row.Preference.IsVisible).ToList();
    var serviceBusNamespaces = renderState.ServiceBusNamespaces;
    var attentionCount = GetAttentionCount();
}

<div class="@renderState.PageClass">
    <RoutePageHeader Area="dashboard"
                     Subtitle="A calm view of your posture — health at a glance, your own context to resume, one click to add more.">
        <Meta>
            @if (AppState.UseDemoData)
            {
                <span class="shell-pill shell-pill--warning">Demo mode</span>
            }
            <span class="shell-pill shell-pill--accent">@activeView.Title</span>
            @if (attentionCount > 0)
            {
                <span class="shell-pill shell-pill--warning">@attentionCount need attention</span>
            }
            else
            {
                <span class="shell-pill shell-pill--muted">All clear</span>
            }
        </Meta>
        <Actions>
            <label class="dashboard-view-switch">
                <span class="dashboard-view-switch__label">View</span>
                <AppSelect CssClass="dashboard-field dashboard-view-switch__input" Value="@activeView.Id"
                           ValueChanged="OnActiveViewSelectedAsync">
                    @foreach (var view in dashboardViews)
                    {
                        <option value="@view.Id">@view.Title</option>
                    }
                </AppSelect>
            </label>
            <AppButton Variant="Secondary" Size="Small" Type="button" CssClass="dashboard-action-button"
                       OnClick="RefreshAll">
                <FluentIcon Value="@(new Icons.Regular.Size20.ArrowClockwise())" Width="18px" />
                <span>Refresh</span>
            </AppButton>
            <AppButton Variant="Secondary" Size="Small" Type="button"
                       CssClass="dashboard-action-button dashboard-action-button--primary"
                       Disabled="@(!_dashboardPreferencesReady)" OnClick="ToggleCustomization">
                <FluentIcon Value="@(new Icons.Regular.Size20.Settings())" Width="18px" />
                <span>@(_isCustomizing ? "Done" : "Customize")</span>
            </AppButton>
        </Actions>
    </RoutePageHeader>

    @if (_isCustomizing)
    {
        <section class="dashboard-builder" aria-label="Dashboard customization">
            <!-- View controls -->
            <div class="dashboard-builder__group dashboard-builder__group--views">
                <div class="dashboard-builder__heading">
                    <h2>View</h2>
                    <button class="dashboard-reset-button" type="button" @onclick="ResetDashboardPreferencesAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size16.ArrowCounterclockwise())" Width="16px" />
                        Reset view
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_customizerMessage))
                {
                    <p class="dashboard-builder__message">@_customizerMessage</p>
                }

                <div class="dashboard-builder__view-actions">
                    <AppButton Variant="Secondary" Size="Small" Type="button" CssClass="dashboard-action-button"
                               Disabled="@(!_dashboardPreferencesReady)" OnClick="CreateDashboardViewAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Width="16px" />
                        <span>New</span>
                    </AppButton>
                    <AppButton Variant="Secondary" Size="Small" Type="button" CssClass="dashboard-action-button"
                               Disabled="@(!_dashboardPreferencesReady)" OnClick="DuplicateDashboardViewAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size16.DocumentMultiple())" Width="16px" />
                        <span>Duplicate</span>
                    </AppButton>
                    <AppButton Variant="Secondary" Size="Small" Type="button" CssClass="dashboard-action-button"
                               Disabled="@(!_dashboardPreferencesReady)" OnClick="BeginRenameDashboardView">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Width="16px" />
                        <span>Rename</span>
                    </AppButton>
                    <AppButton Variant="Secondary" Size="Small" Type="button" CssClass="dashboard-action-button"
                               Disabled="@(!_dashboardPreferencesReady || dashboardViews.Count <= 1)"
                               OnClick="DeleteDashboardViewAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Width="16px" />
                        <span>Delete</span>
                    </AppButton>
                </div>

                @if (_isEditingViewTitle)
                {
                    <div class="dashboard-view-editor" aria-label="Rename dashboard view">
                        <label class="dashboard-field-label">
                            <span>View title</span>
                            <input class="dashboard-field" @bind="_viewTitleDraft" placeholder="Operations review" />
                        </label>
                        <div class="dashboard-view-editor__actions">
                            <AppButton Variant="Secondary" Size="Small" Type="button" CssClass="dashboard-add-button"
                                       OnClick="RenameDashboardViewAsync">Save</AppButton>
                            <AppButton Variant="Secondary" Size="Small" Type="button" CssClass="dashboard-action-button"
                                       OnClick="CancelRenameDashboardView">Cancel</AppButton>
                        </div>
                    </div>
                }

                <div class="dashboard-builder__filters" aria-label="View filters">
                    <label class="dashboard-field-label">
                        <span>Area</span>
                        <AppSelect CssClass="dashboard-field" Value="@activeFilters.Area"
                                   ValueChanged="OnAreaFilterSelectedAsync">
                            <option value="all">All areas</option>
                            <option value="dashboard">Workspace</option>
                            <option value="service-bus">Service Bus</option>
                            <option value="aks">AKS</option>
                            <option value="redis">Redis</option>
                            <option value="pipelines">Pipelines</option>
                        </AppSelect>
                    </label>
                    <label class="dashboard-field-label">
                        <span>Focus</span>
                        <AppSelect CssClass="dashboard-field" Value="@activeFilters.Severity"
                                   ValueChanged="OnSeverityFilterSelectedAsync">
                            <option value="all">All widgets</option>
                            <option value="attention">Needs attention</option>
                            <option value="healthy">Healthy only</option>
                        </AppSelect>
                    </label>
                    <label class="dashboard-field-label">
                        <span>Window</span>
                        <AppSelect CssClass="dashboard-field" Value="@activeFilters.TimeWindow"
                                   ValueChanged="OnTimeWindowSelectedAsync">
                            <option value="live">Live</option>
                            <option value="15m">15 minutes</option>
                            <option value="1h">1 hour</option>
                            <option value="4h">4 hours</option>
                            <option value="today">Today</option>
                        </AppSelect>
                    </label>
                    <label class="dashboard-field-label">
                        <span>Refresh</span>
                        <AppSelect CssClass="dashboard-field" Value="@activeFilters.LiveMode"
                                   ValueChanged="OnLiveModeSelectedAsync">
                            <option value="live">Live cadence</option>
                            <option value="snapshot">Manual snapshot</option>
                        </AppSelect>
                    </label>
                </div>
            </div>

            <!-- Template gallery: add custom watch panels -->
            <div class="dashboard-builder__group dashboard-builder__group--templates">
                <div class="dashboard-builder__heading">
                    <h2>Add a panel</h2>
                </div>

                <article class="dashboard-template-card dashboard-template-card--service-bus">
                    <div class="dashboard-template-card__title">
                        <span class="dashboard-template-card__eyebrow">Service Bus</span>
                        <h3>Entity Watch</h3>
                    </div>
                    <p class="dashboard-template-card__desc">Watch one queue, topic, or subscription.</p>
                    <label class="dashboard-field-label">
                        <span>Namespace</span>
                        <AppSelect CssClass="dashboard-field" Value="@_newServiceBusNamespaceId"
                                   ValueChanged="SetNewServiceBusNamespaceId">
                            @foreach (var ns in serviceBusNamespaces)
                            {
                                <option value="@ns.Id">@ns.Label</option>
                            }
                        </AppSelect>
                    </label>
                    <label class="dashboard-field-label">
                        <span>Queue or subscription path</span>
                        <input class="dashboard-field" @bind="_newServiceBusEntityPath"
                               placeholder="orders or topic/subscriptions/consumer" />
                    </label>
                    <label class="dashboard-field-label">
                        <span>Title</span>
                        <input class="dashboard-field" @bind="_newServiceBusTileTitle" placeholder="Orders backlog" />
                    </label>
                    <div class="dashboard-size-picker" role="group" aria-label="Service Bus entity tile size">
                        @foreach (var size in GetSupportedTileSizes(DashboardTileRegistry.ServiceBusEntityWatch))
                        {
                            <button type="button" class="@GetSizeButtonClass(size, _newServiceBusTileSize)"
                                    @onclick="() => _newServiceBusTileSize = size">
                                @GetTileSizeLabel(size)
                            </button>
                        }
                    </div>
                    <AppButton Variant="Secondary" Size="Small" Type="button" CssClass="dashboard-add-button"
                               Disabled="@(serviceBusNamespaces.Count == 0)" OnClick="AddServiceBusEntityTileAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Width="16px" /> Add tile
                    </AppButton>
                </article>

                <article class="dashboard-template-card dashboard-template-card--aks">
                    <div class="dashboard-template-card__title">
                        <span class="dashboard-template-card__eyebrow">AKS</span>
                        <h3>Namespace Watch</h3>
                    </div>
                    <p class="dashboard-template-card__desc">Watch pods and deployments in one namespace.</p>
                    <label class="dashboard-field-label">
                        <span>Context</span>
                        <input class="dashboard-field" @bind="_newAksContext" placeholder="current context" />
                    </label>
                    <label class="dashboard-field-label">
                        <span>Namespace</span>
                        <input class="dashboard-field" @bind="_newAksNamespace" placeholder="namespace" />
                    </label>
                    <label class="dashboard-field-label">
                        <span>Title</span>
                        <input class="dashboard-field" @bind="_newAksTileTitle" placeholder="Production namespace" />
                    </label>
                    <div class="dashboard-size-picker" role="group" aria-label="AKS namespace tile size">
                        @foreach (var size in GetSupportedTileSizes(DashboardTileRegistry.AksNamespaceWatch))
                        {
                            <button type="button" class="@GetSizeButtonClass(size, _newAksTileSize)"
                                    @onclick="() => _newAksTileSize = size">
                                @GetTileSizeLabel(size)
                            </button>
                        }
                    </div>
                    <AppButton Variant="Secondary" Size="Small" Type="button" CssClass="dashboard-add-button"
                               Disabled="@(!_aksConfigured)" OnClick="AddAksNamespaceTileAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Width="16px" /> Add tile
                    </AppButton>
                </article>
            </div>

            <!-- Current layout + hidden panels -->
            <div class="dashboard-builder__group dashboard-builder__group--layout">
                <div class="dashboard-builder__heading">
                    <h2>Current layout</h2>
                    <span class="dashboard-builder__count">@visibleRows.Count shown</span>
                </div>
                <div class="dashboard-layout-list">
                    @foreach (var row in visibleRows)
                    {
                        <article class="dashboard-layout-row">
                            <div class="dashboard-layout-row__info">
                                <span class="dashboard-layout-row__name">@row.DisplayTitle</span>
                                <span class="dashboard-layout-row__meta">@row.Description</span>
                            </div>
                            <div class="dashboard-size-picker dashboard-size-picker--row" role="group"
                                 aria-label="Size for @row.DisplayTitle">
                                @foreach (var size in GetSupportedTileSizes(row.Preference.TileId))
                                {
                                    <button type="button" class="@GetSizeButtonClass(size, row.Preference.Size)"
                                            title="Use @GetTileSizeLabel(size) size"
                                            @onclick="() => SetTileSizeAsync(row.Preference.TileId, size)">
                                        @GetTileSizeLabel(size)
                                    </button>
                                }
                            </div>
                            <div class="dashboard-layout-row__actions">
                                @if (IsEditableCustomTile(row.Preference))
                                {
                                    <button type="button"
                                            title="@(IsEditingTile(row.Preference.TileId) ? "Cancel edit" : "Edit")"
                                            aria-label="Edit @row.DisplayTitle"
                                            class="@(IsEditingTile(row.Preference.TileId) ? "is-active" : "")"
                                            @onclick="() => ToggleEditTile(row.Preference.TileId)">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Width="16px" />
                                    </button>
                                }
                                <button type="button" title="Move up" aria-label="Move @row.DisplayTitle up"
                                        disabled="@IsFirstTile(row.Definition.Id)"
                                        @onclick="() => MoveTileAsync(row.Preference.TileId, -1)">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowUp())" Width="16px" />
                                </button>
                                <button type="button" title="Move down" aria-label="Move @row.DisplayTitle down"
                                        disabled="@IsLastTile(row.Definition.Id)"
                                        @onclick="() => MoveTileAsync(row.Preference.TileId, 1)">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowDown())" Width="16px" />
                                </button>
                                <button type="button"
                                        title="@(DashboardTileRegistry.IsCustomTile(row.Preference.TileId) ? "Remove" : "Hide")"
                                        aria-label="@(DashboardTileRegistry.IsCustomTile(row.Preference.TileId) ? "Remove" : "Hide") @row.DisplayTitle"
                                        @onclick="() => RemoveTileAsync(row.Preference.TileId)">
                                    @if (DashboardTileRegistry.IsCustomTile(row.Preference.TileId))
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Width="16px" />
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.EyeOff())" Width="16px" />
                                    }
                                </button>
                            </div>
                            @if (IsEditingTile(row.Preference.TileId))
                            {
                                <div class="dashboard-layout-row__edit">
                                    @if (DashboardTileRegistry.IsAksNamespaceWatch(row.Preference.TileId))
                                    {
                                        <label class="dashboard-field-label">
                                            <span>Context</span>
                                            <input class="dashboard-field" @bind="_editAksContext" placeholder="current context" />
                                        </label>
                                        <label class="dashboard-field-label">
                                            <span>Namespace</span>
                                            <input class="dashboard-field" @bind="_editAksNamespace" placeholder="namespace" />
                                        </label>
                                        <label class="dashboard-field-label">
                                            <span>Title</span>
                                            <input class="dashboard-field" @bind="_editAksTitle" placeholder="Production namespace" />
                                        </label>
                                    }
                                    else if (DashboardTileRegistry.IsServiceBusEntityWatch(row.Preference.TileId))
                                    {
                                        <label class="dashboard-field-label">
                                            <span>Namespace</span>
                                            <AppSelect CssClass="dashboard-field" Value="@_editServiceBusNamespaceId"
                                                       ValueChanged="SetEditServiceBusNamespaceId">
                                                @foreach (var ns in GetServiceBusNamespaceOptions())
                                                {
                                                    <option value="@ns.Id">@ns.Label</option>
                                                }
                                            </AppSelect>
                                        </label>
                                        <label class="dashboard-field-label">
                                            <span>Queue or subscription path</span>
                                            <input class="dashboard-field" @bind="_editServiceBusEntityPath"
                                                   placeholder="orders or topic/subscriptions/consumer" />
                                        </label>
                                        <label class="dashboard-field-label">
                                            <span>Title</span>
                                            <input class="dashboard-field" @bind="_editServiceBusTitle" placeholder="Orders backlog" />
                                        </label>
                                    }
                                    <div class="dashboard-layout-row__edit-actions">
                                        <AppButton Variant="Secondary" Size="Small" Type="button" CssClass="dashboard-add-button"
                                                   OnClick="() => SaveEditedTileAsync(row.Preference.TileId)">
                                            Save
                                        </AppButton>
                                        <button type="button" @onclick="() => ToggleEditTile(row.Preference.TileId)">Cancel</button>
                                    </div>
                                </div>
                            }
                        </article>
                    }
                    @if (visibleRows.Count == 0)
                    {
                        <p class="dashboard-builder__empty">No panels shown. Add one above, or re-show a hidden panel below.</p>
                    }
                </div>

                @if (hiddenRows.Count > 0)
                {
                    <div class="dashboard-builder__heading dashboard-builder__heading--sub">
                        <h2>Hidden panels</h2>
                        <span class="dashboard-builder__count">@hiddenRows.Count hidden</span>
                    </div>
                    <div class="dashboard-hidden-list">
                        @foreach (var row in hiddenRows)
                        {
                            <div class="dashboard-hidden-row">
                                <span class="dashboard-hidden-row__name">@row.DisplayTitle</span>
                                <span class="dashboard-hidden-row__meta">@row.Description</span>
                                <button type="button" class="dashboard-add-button dashboard-add-button--small"
                                        title="Show @row.DisplayTitle"
                                        @onclick="() => SetTileVisibilityAsync(row.Preference.TileId, true)">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Width="16px" /> Show
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <section class="dashboard-canvas" aria-label="Dashboard tiles">
        @if (boardTiles.Count == 0)
        {
            <EmptyState Icon="◱" Title="Your dashboard is empty"
                        Subtitle="Add panels from Customize to bring health, favorites, and watch tiles onto the board.">
                <Actions>
                    <button type="button" @onclick="ToggleCustomization">Open Customize</button>
                </Actions>
            </EmptyState>
        }
        else
        {
            <div class="@GetTileGridClass(boardTiles)">
                @foreach (var tile in boardTiles)
                {
                    <div @key="tile.Id" class="@GetTileClass(tile)">
                        @switch (DashboardTileRegistry.GetTemplateId(tile.Id))
                        {
                            case DashboardTileRegistry.Favorites:
                                <section class="dashboard-panel dashboard-panel--workspace">
                                    <div class="dashboard-panel__header">
                                        <div>
                                            <span class="dashboard-panel__eyebrow">Workspace</span>
                                            <h3>Favorites</h3>
                                        </div>
                                        <strong>@pinnedItems.Count</strong>
                                    </div>
                                    @if (pinnedItems.Count == 0)
                                    {
                                        <EmptyState Icon="☆" Title="No favorites yet"
                                                    Subtitle="Pin resources from any page to keep them close.">
                                            <Actions>
                                                <a href="/service-bus">Browse Service Bus</a>
                                                <a href="/aks">Browse AKS</a>
                                            </Actions>
                                        </EmptyState>
                                    }
                                    else
                                    {
                                        <div class="pinned-chips">
                                            @foreach (var pin in pinnedItems)
                                            {
                                                <button class="pinned-chip" @onclick="() => NavigateToPin(pin)"
                                                        title="@(pin.Snapshot.Resource.DisplayPath ?? pin.Snapshot.Resource.DisplayName)">
                                                    <span class="pinned-chip-icon">@pin.Icon</span>
                                                    <span class="pinned-chip-name">@pin.DisplayPath</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </section>
                                break;
                            case DashboardTileRegistry.RecentResources:
                                <section class="dashboard-panel dashboard-panel--workspace dashboard-panel--table">
                                    <div class="dashboard-panel__header">
                                        <div>
                                            <span class="dashboard-panel__eyebrow">Workspace</span>
                                            <h3>Recent Resources</h3>
                                        </div>
                                        <strong>@recentItems.Count</strong>
                                    </div>
                                    @if (recentItems.Count == 0)
                                    {
                                        <EmptyState Icon="◷" Title="Nothing recent"
                                                    Subtitle="Recently opened resources appear here for fast re-entry.">
                                            <Actions>
                                                <a href="/service-bus">Open Service Bus</a>
                                                <a href="/aks">Open AKS</a>
                                            </Actions>
                                        </EmptyState>
                                    }
                                    else
                                    {
                                        <div class="resource-row-list">
                                            @foreach (var item in recentItems)
                                            {
                                                <button class="resource-row" @onclick="() => NavigateToResource(item)"
                                                        title="@(item.Snapshot.Resource.DisplayPath ?? item.Snapshot.Resource.DisplayName)">
                                                    <span class="resource-row-icon">@item.Icon</span>
                                                    <span class="resource-row-main">
                                                        <span class="resource-row-name">@item.DisplayPath</span>
                                                        <span class="resource-row-meta">@GetResourceAreaLabel(item) ·
                                                            @GetResourceKindLabel(item)</span>
                                                    </span>
                                                    <span class="resource-row-time">@RelativeTime(item.Timestamp)</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </section>
                                break;
                            case DashboardTileRegistry.OpenTabs:
                                <section class="dashboard-panel dashboard-panel--workspace">
                                    <div class="dashboard-panel__header">
                                        <div>
                                            <span class="dashboard-panel__eyebrow">Workspace</span>
                                            <h3>Open Tabs</h3>
                                        </div>
                                        <strong>@openTabs.Count</strong>
                                    </div>
                                    @if (openTabs.Count == 0)
                                    {
                                        <EmptyState Icon="▭" Title="No restorable tabs"
                                                    Subtitle="Workspace tabs are restored here once saved in local state." />
                                    }
                                    else
                                    {
                                        <div class="open-tab-list">
                                            @foreach (var tab in openTabs)
                                            {
                                                <button class="open-tab-chip" @onclick="() => NavigateToTab(tab)">
                                                    <span class="open-tab-icon">@GetAreaIcon(tab.Area)</span>
                                                    <span class="open-tab-name">@tab.Title</span>
                                                    <span class="open-tab-area">@ShellNavigation.ForArea(tab.Area).Label</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </section>
                                break;
                            case DashboardTileRegistry.ServiceBusDeadLetters:
                                <DashboardMetricTile AreaLabel="Service Bus" OpenHref="/service-bus"
                                                     IsConfigured="@_sbConfigured" Data="@_sbData" Error="@_sbError"
                                                     FallbackLabel="dead-lettered" IsLoading="@_sbLoading"
                                                     CssClass="dashboard-metric-tile--service-bus" />
                                break;
                            case DashboardTileRegistry.AksUnhealthyPods:
                                <DashboardMetricTile AreaLabel="AKS" OpenHref="/aks" IsConfigured="@_aksConfigured"
                                                     Data="@_aksData" Error="@_aksError" FallbackLabel="unhealthy pods" IsLoading="@_aksLoading"
                                                     CssClass="dashboard-metric-tile--aks" />
                                break;
                            case DashboardTileRegistry.RedisExpiringKeys:
                                <DashboardMetricTile AreaLabel="Redis" OpenHref="/redis" IsConfigured="@_redisConfigured"
                                                     Data="@_redisData" Error="@_redisError" FallbackLabel="expiring < 5m"
                                                     IsLoading="@_redisLoading" CssClass="dashboard-metric-tile--redis" />
                                break;
                            case DashboardTileRegistry.PendingApprovals:
                                <DashboardMetricTile AreaLabel="Pipelines" OpenHref="/pipelines"
                                                     IsConfigured="@_releasesConfigured" Data="@_releasesData" Error="@_releasesError"
                                                     FallbackLabel="pending approvals" IsLoading="@_releasesLoading"
                                                     CssClass="dashboard-metric-tile--pipelines" />
                                break;
                            case DashboardTileRegistry.ServiceBusEntityWatch:
                                var entityPreference = GetTilePreference(tile.Id);
                                var entityMetric = GetServiceBusEntityMetric(tile.Id);
                                <section class="dashboard-panel dashboard-watch dashboard-watch--service-bus">
                                    <DashboardWatchTile AreaLabel="Service Bus Entity"
                                                        Title="@GetTileDisplayTitle(tile, entityPreference)"
                                                        Target="@GetServiceBusEntityTileTargetLabel(entityPreference)"
                                                        Stats="@GetServiceBusEntityStats(entityMetric)"
                                                        LastUpdated="@(entityMetric?.LastUpdated ?? default)" Error="@entityMetric?.Error"
                                                        IsLoading="@IsServiceBusEntityTileLoading(tile.Id)"
                                                        LoadingText="Loading entity stats..."
                                                        OnOpen="@(() => OpenServiceBusEntityTileAsync(entityPreference))" />
                                </section>
                                break;
                            case DashboardTileRegistry.AksNamespaceWatch:
                                var namespacePreference = GetTilePreference(tile.Id);
                                var namespaceMetric = GetAksNamespaceMetric(tile.Id);
                                <section class="dashboard-panel dashboard-watch dashboard-watch--aks">
                                    <DashboardWatchTile AreaLabel="AKS Namespace"
                                                        Title="@GetTileDisplayTitle(tile, namespacePreference)"
                                                        Target="@GetAksTileTargetLabel(namespacePreference)"
                                                        Stats="@GetAksNamespaceStats(namespaceMetric)"
                                                        LastUpdated="@(namespaceMetric?.LastUpdated ?? default)"
                                                        Error="@GetAksNamespaceTileError(namespaceMetric)"
                                                        Note="@GetAksNamespaceTileNote(namespaceMetric)"
                                                        IsLoading="@IsAksNamespaceTileLoading(tile.Id)"
                                                        LoadingText="Loading namespace summary..."
                                                        OnOpen="@(() => OpenAksNamespaceTile(namespacePreference))" />
                                </section>
                                break;
                            case DashboardTileRegistry.PodHealthAlerts:
                                <section class="dashboard-panel dashboard-panel--aks-events">
                                    <div class="dashboard-panel__header">
                                        <div>
                                            <span class="dashboard-panel__eyebrow">AKS</span>
                                            <h3>Pod Health</h3>
                                        </div>
                                        @if (Monitor.IsMonitoring)
                                        {
                                            <span class="ph-monitoring-badge">monitoring</span>
                                        }
                                    </div>
                                    @if (Monitor.IsMonitoring && Monitor.MonitoredNamespaces.Count > 0)
                                    {
                                        <div class="ph-ns-row">
                                            @foreach (var ns in Monitor.MonitoredNamespaces)
                                            {
                                                <span class="ph-ns-chip">
                                                    <span class="ph-ns-chip-label">@ns</span>
                                                    <button class="ph-ns-chip-remove" title="Stop monitoring @ns"
                                                            aria-label="Stop monitoring @ns"
                                                            @onclick="() => StopMonitoringNamespaceAsync(ns)">✕</button>
                                                </span>
                                            }
                                            @if (Monitor.MonitoredNamespaces.Count > 1)
                                            {
                                                <button class="ph-ns-stop-all" @onclick="StopAllMonitoringAsync"
                                                        title="Stop all pod health monitoring">
                                                    Stop all
                                                </button>
                                            }
                                        </div>
                                    }

                                    @if (_monitorAlerts.Count == 0)
                                    {
                                        <p class="dashboard-empty">No pod health events detected.</p>
                                    }
                                    else
                                    {
                                        <div class="ph-alert-list">
                                            @foreach (var evt in _monitorAlerts.Take(6))
                                            {
                                                <div class="ph-alert-row ph-@evt.EventType.ToString().ToLowerInvariant()">
                                                    <span class="ph-alert-icon">⚠</span>
                                                    <div class="ph-alert-body">
                                                        <span class="ph-alert-pod">@evt.PodName</span>
                                                        <span class="ph-alert-meta">@evt.Namespace — @evt.EventType</span>
                                                    </div>
                                                    <span class="ph-alert-time">@RelativeTime(evt.DetectedAt)</span>
                                                </div>
                                            }
                                        </div>
                                        @if (_monitorAlerts.Count > 6)
                                        {
                                            <p class="ph-overflow-hint">+@(_monitorAlerts.Count - 6) more — see AKS page for full
                                                history</p>
                                        }
                                    }
                                </section>
                                break;
                            case DashboardTileRegistry.RecentActivity:
                                <section class="dashboard-panel dashboard-panel--activity">
                                    <div class="dashboard-panel__header">
                                        <div>
                                            <span class="dashboard-panel__eyebrow">Session</span>
                                            <h3>Recent Activity</h3>
                                        </div>
                                        <strong>@_activities.Count</strong>
                                    </div>
                                    @if (_activities.Count == 0)
                                    {
                                        <EmptyState Icon="◷" Title="No recent activity"
                                                    Subtitle="Actions across Service Bus, AKS, and Pipelines appear here.">
                                            <Actions>
                                                <a href="/service-bus">Open Service Bus</a>
                                                <a href="/aks">Open AKS</a>
                                            </Actions>
                                        </EmptyState>
                                    }
                                    else
                                    {
                                        <div class="activity-list">
                                            @foreach (var a in _activities)
                                            {
                                                <div class="activity-item">
                                                    <span class="activity-icon">@a.Icon</span>
                                                    <span class="activity-desc">@a.Description</span>
                                                    <span class="activity-time">@RelativeTime(a.OccurredAt)</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </section>
                                break;
                        }
                    </div>
                }
            </div>
        }
    </section>
</div>

@code {
    // ── Decomposed into concern-scoped partials (Wave A) ─────────────────────────────
    //   • DashboardPage.Preferences.cs  — views/preferences state, persistence, view CRUD, filter/layout handlers
    //   • DashboardPage.Health.cs       — health tile refresh loop, per-area fetch, configured-state detection
    //   • DashboardPage.CustomTiles.cs  — Service Bus entity + AKS namespace watch tile state and metrics
    //   • DashboardPage.Builder.cs      — customization editor state and tile visibility/size/order/edit actions
    //   • DashboardPage.Rendering.cs    — render-state cache/coalescing, event handlers, tile helpers, navigation
    // This file keeps only component lifecycle; all called members live in the partials above.

    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _refreshTimer;

    protected override void OnInitialized()
    {
        // Determine configured state before the first render so tiles show the correct
        // state immediately rather than flashing "not configured" until the background
        // task runs DetermineConfiguredState.
        DetermineConfiguredState();
        LoadDashboardPreferences();
        InitializeBuilderDefaults();
        _dashboardPreferencesReady = AppState.IsInitialized;
        AppState.Initialized += OnAppStateInitialized;
        Events.Subscribe<ActivityEvent>(OnActivityReceived);
        Events.Subscribe<RefreshRequestedEvent>(OnRefreshRequested);
        Monitor.PodHealthDetected += OnPodHealthDetected;
        Workspaces.Changed += OnWorkspaceChanged;
        // Seed from ring buffer so alerts already recorded before dashboard load are visible.
        _monitorAlerts.AddRange(Monitor.RecentEvents);
        InvalidateRenderState();
    }

    protected override Task OnInitializedAsync()
    {
        RefreshAll();
        _ = StartRefreshLoopAsync();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        AppState.Initialized -= OnAppStateInitialized;
        Events.Unsubscribe<ActivityEvent>(OnActivityReceived);
        Events.Unsubscribe<RefreshRequestedEvent>(OnRefreshRequested);
        Monitor.PodHealthDetected -= OnPodHealthDetected;
        Workspaces.Changed -= OnWorkspaceChanged;
        _cts.Cancel();
        _cts.Dispose();
        _healthRefreshGate.Dispose();
        _refreshTimer?.Dispose();
    }
}
