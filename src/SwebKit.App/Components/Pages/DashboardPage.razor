                                            else
                                            {
                                                <div class="dashboard-dock-resource-list">
                                                    @foreach (var item in recentItems.Take(3))
                                                    {
                                                        <button class="dashboard-dock-resource" @onclick="() => NavigateToResource(item)">
                                                            <span class="dashboard-dock-resource__icon">@item.Icon</span>
                                                            <span class="dashboard-dock-resource__body">
                                                                <span class="dashboard-dock-resource__name">@item.DisplayPath</span>
                                                                <span class="dashboard-dock-resource__meta">@GetResourceAreaLabel(item) ·
                                                                    @RelativeTime(item.Timestamp)</span>
