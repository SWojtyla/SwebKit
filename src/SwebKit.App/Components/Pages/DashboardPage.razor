@page "/"
@page "/dashboard"
@inject AppStateService AppState
@inject IDevOpsClientFactory DevOpsClientFactory
@inject IServiceBusClientFactory SbClientFactory
@inject IAksClientFactory AksClientFactory
@inject IRedisClientFactory RedisClientFactory
@inject IAppEventBus Events
@inject ICredentialStore CredentialStore
@inject IPodHealthMonitorService Monitor
@inject NavigationManager Nav
@inject UiStateRepository UiState
@inject SwebKit.Core.Services.DemoDevOpsClient DemoDevOpsClient
@inject SwebKit.Core.Services.DemoAksClient DemoAksClient
@inject SwebKit.Core.Services.DemoRedisClient DemoRedisClient
@inject OperatorWorkspaceService Workspaces
@implements IDisposable

@{
    var pinnedItems = GetPinnedItems();
    var recentItems = GetRecentItems();
    var openTabs = GetOpenTabs();
    var visibleTiles = GetVisibleTileDefinitions();
    var editorRows = GetTileEditorRows();
    var serviceBusNamespaces = GetServiceBusNamespaceOptions();
}

<div class="dashboard-page">
    <RoutePageHeader Area="dashboard" Subtitle="Custom operations surface for the resources you watch most.">
        <Meta>
        @if (AppState.UseDemoData)
        {
            <span class="shell-pill shell-pill--warning">Demo mode</span>
        }
        <span class="shell-pill shell-pill--muted">@pinnedItems.Count favorite@(pinnedItems.Count == 1 ? "" :
                                                                                 "s")</span>
            <span class="shell-pill shell-pill--muted">@visibleTiles.Count tile@(visibleTiles.Count == 1 ? "" : "s")</span>
            @if (Monitor.IsMonitoring)
            {
                <span class="shell-pill shell-pill--accent">@Monitor.MonitoredNamespaces.Count
                    namespace@(Monitor.MonitoredNamespaces.Count == 1 ? "" : "s") monitored</span>
                }
            </Meta>
            <Actions>
                <button class="dashboard-action-button" type="button" @onclick="RefreshAll">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowClockwise())" Width="18px" />
                    <span>Refresh</span>
                </button>
                <button class="dashboard-action-button dashboard-action-button--primary" type="button"
                        disabled="@(!_dashboardPreferencesReady)" @onclick="ToggleCustomization">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Settings())" Width="18px" />
                    <span>@(_isCustomizing ? "Done" : "Customize")</span>
                </button>
            </Actions>
        </RoutePageHeader>

        <section class="dashboard-overview-strip" aria-label="Dashboard overview">
            <div class="dashboard-overview-cell">
                <span class="dashboard-overview-label">Visible</span>
                <strong>@visibleTiles.Count</strong>
            </div>
            <div class="dashboard-overview-cell">
                <span class="dashboard-overview-label">Favorites</span>
                <strong>@pinnedItems.Count</strong>
            </div>
            <div class="dashboard-overview-cell">
                <span class="dashboard-overview-label">Recent</span>
                <strong>@recentItems.Count</strong>
            </div>
            <div class="dashboard-overview-cell">
                <span class="dashboard-overview-label">Health</span>
                <strong>@GetAttentionCount()</strong>
            </div>
        </section>

        @if (_isCustomizing)
        {
            <section class="dashboard-builder" aria-label="Dashboard customization">
                <div class="dashboard-builder__templates">
                    <div class="dashboard-builder__heading">
                        <h2>Tile Library</h2>
                        <button class="dashboard-reset-button" type="button" @onclick="ResetDashboardPreferencesAsync">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowCounterclockwise())" Width="16px" /> Reset
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_customizerMessage))
                    {
                        <p class="dashboard-builder__message">@_customizerMessage</p>
                    }

                    <article class="dashboard-template-card dashboard-template-card--service-bus">
                        <div>
                            <span class="dashboard-template-card__eyebrow">Service Bus</span>
                            <h3>Entity Watch</h3>
                        </div>
                        <label>
                            <span>Namespace</span>
                            <select class="dashboard-field" @bind="_newServiceBusNamespaceId">
                                @foreach (var ns in serviceBusNamespaces)
                                {
                                    <option value="@ns.Id">@ns.Label</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Queue or subscription path</span>
                            <input class="dashboard-field" @bind="_newServiceBusEntityPath"
                                   placeholder="orders or topic/subscriptions/consumer" />
                        </label>
                        <label>
                            <span>Title</span>
                            <input class="dashboard-field" @bind="_newServiceBusTileTitle" placeholder="Orders backlog" />
                        </label>
                        <button class="dashboard-add-button" type="button" disabled="@(serviceBusNamespaces.Count == 0)"
                                @onclick="AddServiceBusEntityTileAsync">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Width="16px" /> Add tile
                        </button>
                    </article>

                    <article class="dashboard-template-card dashboard-template-card--aks">
                        <div>
                            <span class="dashboard-template-card__eyebrow">AKS</span>
                            <h3>Namespace Watch</h3>
                        </div>
                        <label>
                            <span>Context</span>
                            <input class="dashboard-field" @bind="_newAksContext" placeholder="current context" />
                        </label>
                        <label>
                            <span>Namespace</span>
                            <input class="dashboard-field" @bind="_newAksNamespace" placeholder="default" />
                        </label>
                        <label>
                            <span>Title</span>
                            <input class="dashboard-field" @bind="_newAksTileTitle" placeholder="Production namespace" />
                        </label>
                        <button class="dashboard-add-button" type="button" disabled="@(!_aksConfigured)"
                                @onclick="AddAksNamespaceTileAsync">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Width="16px" /> Add tile
                        </button>
                    </article>
                </div>

                <div class="dashboard-builder__layout">
                    <div class="dashboard-builder__heading">
                        <h2>Active Dashboard</h2>
                    </div>
                    <div class="dashboard-layout-list">
                        @foreach (var row in editorRows)
                        {
                            <article class="dashboard-layout-row @(row.Preference.IsVisible ? "" : "dashboard-layout-row--hidden")">
                                <label class="dashboard-layout-row__toggle">
                                    <input type="checkbox" checked="@row.Preference.IsVisible"
                                           @onchange="async args => await SetTileVisibilityAsync(row.Preference.TileId, args.Value is bool visible && visible)" />
                                    <span>@row.DisplayTitle</span>
                                </label>
                                <span class="dashboard-layout-row__meta">@row.Description</span>
                                <div class="dashboard-layout-row__actions">
                                    @if (IsEditableCustomTile(row.Preference))
                                    {
                                        <button type="button" title="@(IsEditingTile(row.Preference.TileId) ? "Cancel edit" : "Edit")"
                                                aria-label="Edit @row.DisplayTitle"
                                                class="@(IsEditingTile(row.Preference.TileId) ? "is-active" : "")"
                                                @onclick="() => ToggleEditTile(row.Preference.TileId)">
                                            <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Width="16px" />
                                        </button>
                                    }
                                    <button type="button" title="Move up" aria-label="Move @row.DisplayTitle up"
                                            disabled="@IsFirstTile(row.Definition.Id)"
                                            @onclick="() => MoveTileAsync(row.Preference.TileId, -1)">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.ArrowUp())" Width="16px" />
                                    </button>
                                    <button type="button" title="Move down" aria-label="Move @row.DisplayTitle down"
                                            disabled="@IsLastTile(row.Definition.Id)"
                                            @onclick="() => MoveTileAsync(row.Preference.TileId, 1)">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.ArrowDown())" Width="16px" />
                                    </button>
                                    <button type="button" title="Remove" aria-label="Remove @row.DisplayTitle"
                                            @onclick="() => RemoveTileAsync(row.Preference.TileId)">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Width="16px" />
                                    </button>
                                </div>
                                @if (IsEditingTile(row.Preference.TileId))
                                {
                                    <div class="dashboard-layout-row__edit">
                                        @if (DashboardTileRegistry.IsAksNamespaceWatch(row.Preference.TileId))
                                        {
                                            <label>
                                                <span>Context</span>
                                                <input class="dashboard-field" @bind="_editAksContext" placeholder="current context" />
                                            </label>
                                            <label>
                                                <span>Namespace</span>
                                                <input class="dashboard-field" @bind="_editAksNamespace" placeholder="default" />
                                            </label>
                                            <label>
                                                <span>Title</span>
                                                <input class="dashboard-field" @bind="_editAksTitle" placeholder="Production namespace" />
                                            </label>
                                        }
                                        else if (DashboardTileRegistry.IsServiceBusEntityWatch(row.Preference.TileId))
                                        {
                                            <label>
                                                <span>Namespace</span>
                                                <select class="dashboard-field" @bind="_editServiceBusNamespaceId">
                                                    @foreach (var ns in GetServiceBusNamespaceOptions())
                                                    {
                                                        <option value="@ns.Id">@ns.Label</option>
                                                    }
                                                </select>
                                            </label>
                                            <label>
                                                <span>Queue or subscription path</span>
                                                <input class="dashboard-field" @bind="_editServiceBusEntityPath"
                                                       placeholder="orders or topic/subscriptions/consumer" />
                                            </label>
                                            <label>
                                                <span>Title</span>
                                                <input class="dashboard-field" @bind="_editServiceBusTitle" placeholder="Orders backlog" />
                                            </label>
                                        }
                                        <div class="dashboard-layout-row__edit-actions">
                                            <button type="button" class="dashboard-add-button"
                                                    @onclick="() => SaveEditedTileAsync(row.Preference.TileId)">
                                                Save
                                            </button>
                                            <button type="button" @onclick="() => ToggleEditTile(row.Preference.TileId)">Cancel</button>
                                        </div>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                </div>
            </section>
        }

        <section class="dashboard-canvas" aria-label="Dashboard tiles">
            @if (visibleTiles.Count == 0)
            {
                <EmptyState Icon="⌘" Title="No dashboard tiles selected"
                            Subtitle="Turn on at least one tile to rebuild the dashboard." />
            }
            else
            {
                <div class="@GetTileGridClass(visibleTiles)">
                    @foreach (var tile in visibleTiles)
                    {
                        <div class="@GetTileClass(tile)">
                            @switch (DashboardTileRegistry.GetTemplateId(tile.Id))
                            {
                                case DashboardTileRegistry.Favorites:
                                    <section class="dashboard-panel dashboard-panel--workspace">
                                        <div class="dashboard-panel__header">
                                            <div>
                                                <span class="dashboard-panel__eyebrow">Workspace</span>
                                                <h3>Favorites</h3>
                                            </div>
                                            <strong>@pinnedItems.Count</strong>
                                        </div>
                                        @if (pinnedItems.Count == 0)
                                        {
                                            <EmptyState Icon="⌘" Title="No favorites"
                                                        Subtitle="Save queues, topics, subscriptions, or workloads as favorites to keep them close.">
                                                <Actions>
                                                    <a href="/service-bus">Browse Service Bus</a>
                                                    <a href="/aks">Browse AKS</a>
                                                </Actions>
                                            </EmptyState>
                                        }
                                        else
                                        {
                                            <div class="pinned-chips">
                                                @foreach (var pin in pinnedItems)
                                                {
                                                    <button class="pinned-chip" @onclick="() => NavigateToPin(pin)"
                                                            title="@(pin.Snapshot.Resource.DisplayPath ?? pin.Snapshot.Resource.DisplayName)">
                                                        <span class="pinned-chip-icon">@pin.Icon</span>
                                                        <span class="pinned-chip-name">@pin.DisplayPath</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </section>
                                    break;
                                case DashboardTileRegistry.RecentResources:
                                    <section class="dashboard-panel dashboard-panel--workspace dashboard-panel--table">
                                        <div class="dashboard-panel__header">
                                            <div>
                                                <span class="dashboard-panel__eyebrow">Workspace</span>
                                                <h3>Recent Resources</h3>
                                            </div>
                                            <strong>@recentItems.Count</strong>
                                        </div>
                                        @if (recentItems.Count == 0)
                                        {
                                            <EmptyState Icon="⋯" Title="No recent resources"
                                                        Subtitle="Resources opened from the shell will appear here.">
                                                <Actions>
                                                    <a href="/service-bus">Open Service Bus</a>
                                                    <a href="/aks">Open AKS</a>
                                                </Actions>
                                            </EmptyState>
                                        }
                                        else
                                        {
                                            <div class="resource-row-list">
                                                @foreach (var item in recentItems)
                                                {
                                                    <button class="resource-row" @onclick="() => NavigateToResource(item)"
                                                            title="@(item.Snapshot.Resource.DisplayPath ?? item.Snapshot.Resource.DisplayName)">
                                                        <span class="resource-row-icon">@item.Icon</span>
                                                        <span class="resource-row-main">
                                                            <span class="resource-row-name">@item.DisplayPath</span>
                                                            <span class="resource-row-meta">@GetResourceAreaLabel(item) ·
                                                                @GetResourceKindLabel(item)</span>
                                                            </span>
                                                            <span class="resource-row-time">@RelativeTime(item.Timestamp)</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </section>
                                        break;
                                case DashboardTileRegistry.OpenTabs:
                                            <section class="dashboard-panel dashboard-panel--workspace">
                                                <div class="dashboard-panel__header">
                                                    <div>
                                                        <span class="dashboard-panel__eyebrow">Workspace</span>
                                                        <h3>Open Tabs</h3>
                                                    </div>
                                                    <strong>@openTabs.Count</strong>
                                                </div>
                                                @if (openTabs.Count == 0)
                                                {
                                                    <EmptyState Icon="□" Title="No restorable tabs"
                                                                Subtitle="Open workspace tabs are restored here after they are saved in local state." />
                                                }
                                                else
                                                {
                                                    <div class="open-tab-list">
                                                        @foreach (var tab in openTabs)
                                                        {
                                                            <button class="open-tab-chip" @onclick="() => NavigateToTab(tab)">
                                                                <span class="open-tab-icon">@GetAreaIcon(tab.Area)</span>
                                                                <span class="open-tab-name">@tab.Title</span>
                                                                <span class="open-tab-area">@ShellNavigation.ForArea(tab.Area).Label</span>
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </section>
                                            break;
                                        case DashboardTileRegistry.ServiceBusDeadLetters:
                                            <section class="dashboard-signal dashboard-signal--service-bus">
                                                <span class="dashboard-signal__area">Service Bus</span>
                                                @RenderMetricBody(_sbConfigured, _sbData, _sbError, "dead-lettered")
                                            </section>
                                            break;
                                        case DashboardTileRegistry.AksUnhealthyPods:
                                            <section class="dashboard-signal dashboard-signal--aks">
                                                <span class="dashboard-signal__area">AKS</span>
                                                @RenderMetricBody(_aksConfigured, _aksData, _aksError, "unhealthy pods")
                                            </section>
                                            break;
                                        case DashboardTileRegistry.RedisExpiringKeys:
                                            <section class="dashboard-signal dashboard-signal--redis">
                                                <span class="dashboard-signal__area">Redis</span>
                                                @RenderMetricBody(_redisConfigured, _redisData, _redisError, "expiring < 5m")
                                            </section>
                                            break;
                                        case DashboardTileRegistry.PendingApprovals:
                                            <section class="dashboard-signal dashboard-signal--pipelines">
                                                <span class="dashboard-signal__area">Pipelines</span>
                                                @RenderMetricBody(_releasesConfigured, _releasesData, _releasesError, "pending approvals")
                                            </section>
                                            break;
                                        case DashboardTileRegistry.ServiceBusEntityWatch:
                                            var entityPreference = GetTilePreference(tile.Id);
                                            var entityMetric = GetServiceBusEntityMetric(tile.Id);
                                            <section class="dashboard-panel dashboard-watch dashboard-watch--service-bus">
                                                <div class="dashboard-panel__header">
                                                    <div>
                                                        <span class="dashboard-panel__eyebrow">Service Bus Entity</span>
                                                        <h3>@GetTileDisplayTitle(tile, entityPreference)</h3>
                                                    </div>
                                                    <button class="dashboard-panel__link" type="button"
                                                            @onclick="() => OpenServiceBusEntityTileAsync(entityPreference)">Open</button>
                                                </div>
                                                <p class="dashboard-watch__target">@GetSetting(entityPreference, "namespaceLabel") /
                                                    @GetSetting(entityPreference, "entityPath")</p>
                                                    @if (entityMetric is null)
                                                    {
                                                        <p class="dashboard-empty">Loading entity stats...</p>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(entityMetric.Error))
                                                    {
                                                        <p class="dashboard-error">@entityMetric.Error</p>
                                                    }
                                                    else
                                                    {
                                                        <div class="dashboard-watch__stats">
                                                            <span><strong>@entityMetric.ActiveMessages</strong> active</span>
                                                            <span><strong>@entityMetric.DeadLetterMessages</strong> dead-letter</span>
                                                            <span><strong>@entityMetric.ScheduledMessages</strong> scheduled</span>
                                                        </div>
                                                        <p class="dashboard-watch__updated">Updated @RelativeTime(entityMetric.LastUpdated)</p>
                                                    }
                                                </section>
                                                break;
                            case DashboardTileRegistry.AksNamespaceWatch:
                                                    var namespacePreference = GetTilePreference(tile.Id);
                                                    var namespaceMetric = GetAksNamespaceMetric(tile.Id);
                                                    <section class="dashboard-panel dashboard-watch dashboard-watch--aks">
                                                        <div class="dashboard-panel__header">
                                                            <div>
                                                                <span class="dashboard-panel__eyebrow">AKS Namespace</span>
                                                                <h3>@GetTileDisplayTitle(tile, namespacePreference)</h3>
                                                            </div>
                                                            <button class="dashboard-panel__link" type="button"
                                                                    @onclick="() => OpenAksNamespaceTile(namespacePreference)">Open</button>
                                                        </div>
                                                        <p class="dashboard-watch__target">@GetAksTileTargetLabel(namespacePreference)</p>
                                                        @if (namespaceMetric is null)
                                                        {
                                                            <p class="dashboard-empty">Loading namespace summary...</p>
                                                        }
                                                        else if (!string.IsNullOrWhiteSpace(namespaceMetric.Error) &&
                    !IsDeploymentPermissionError(namespaceMetric.Error))
                                                        {
                                                            <p class="dashboard-error">@namespaceMetric.Error</p>
                                                        }
                                                        else
                                                        {
                                                            <div class="dashboard-watch__stats">
                                                                <span><strong>@namespaceMetric.PodCount</strong> pods</span>
                                                                <span><strong>@namespaceMetric.UnhealthyPods</strong> unhealthy</span>
                                                                <span><strong>@namespaceMetric.RestartCount</strong> restarts</span>
                                                            </div>
                                                            @if (IsDeploymentPermissionError(namespaceMetric.Error))
                                                            {
                                                                <p class="dashboard-watch__note">Ignoring deployment permissions; this tile uses pod data.</p>
                                                            }
                                                            <p class="dashboard-watch__updated">Updated @RelativeTime(namespaceMetric.LastUpdated)</p>
                                                        }
                                                    </section>
                                                    break;
                                                case DashboardTileRegistry.PodHealthAlerts:
                                                    <section class="dashboard-panel dashboard-panel--aks-events">
                                                        <div class="dashboard-panel__header">
                                                            <div>
                                                                <span class="dashboard-panel__eyebrow">AKS</span>
                                                                <h3>Pod Health</h3>
                                                            </div>
                                                            @if (Monitor.IsMonitoring)
                                                            {
                                                                <span class="ph-monitoring-badge">monitoring</span>
                                                            }
                                                        </div>
                                                        @if (Monitor.IsMonitoring && Monitor.MonitoredNamespaces.Count > 0)
                                                        {
                                                            <div class="ph-ns-row">
                                                                @foreach (var ns in Monitor.MonitoredNamespaces)
                                                                {
                                                                    <span class="ph-ns-chip">
                                                                        <span class="ph-ns-chip-label">@ns</span>
                                                                        <button class="ph-ns-chip-remove" title="Stop monitoring @ns"
                                                                                aria-label="Stop monitoring @ns"
                                                                                @onclick="() => StopMonitoringNamespaceAsync(ns)">✕</button>
                                                                    </span>
                                                                }
                                                                @if (Monitor.MonitoredNamespaces.Count > 1)
                                                                {
                                                                    <button class="ph-ns-stop-all" @onclick="StopAllMonitoringAsync"
                                                                            title="Stop all pod health monitoring">
                                                                        Stop all
                                                                    </button>
                                                                }
                                                            </div>
                                                        }

                                                        @if (_monitorAlerts.Count == 0)
                                                        {
                                                            <p class="dashboard-empty">No pod health events detected.</p>
                                                        }
                                                        else
                                                        {
                                                            <div class="ph-alert-list">
                                                                @foreach (var evt in _monitorAlerts.Take(6))
                                                                {
                                                                    <div class="ph-alert-row ph-@evt.EventType.ToString().ToLowerInvariant()">
                                                                        <span class="ph-alert-icon">⚠</span>
                                                                        <div class="ph-alert-body">
                                                                            <span class="ph-alert-pod">@evt.PodName</span>
                                                                            <span class="ph-alert-meta">@evt.Namespace — @evt.EventType</span>
                                                                        </div>
                                                                        <span class="ph-alert-time">@RelativeTime(evt.DetectedAt)</span>
                                                                    </div>
                                                                }
                                                            </div>
                                                            @if (_monitorAlerts.Count > 6)
                                                            {
                                                                <p class="ph-overflow-hint">+@(_monitorAlerts.Count - 6) more — see AKS page for full history</p>
                                                            }
                                                        }
                                                    </section>
                                                    break;
                                                case DashboardTileRegistry.RecentActivity:
                                                    <section class="dashboard-panel dashboard-panel--activity">
                                                        <div class="dashboard-panel__header">
                                                            <div>
                                                                <span class="dashboard-panel__eyebrow">Session</span>
                                                                <h3>Recent Activity</h3>
                                                            </div>
                                                            <strong>@_activities.Count</strong>
                                                        </div>
                                                        @if (_activities.Count == 0)
                                                        {
                                                            <EmptyState Icon="⋯" Title="No recent activity"
                                                                        Subtitle="Actions you take across Service Bus, AKS, and Pipelines will appear here.">
                                                                <Actions>
                                                                    <a href="/service-bus">Open Service Bus</a>
                                                                    <a href="/aks">Open AKS</a>
                                                                </Actions>
                                                            </EmptyState>
                                                        }
                                                        else
                                                        {
                                                            <div class="activity-list">
                                                                @foreach (var a in _activities)
                                                                {
                                                                    <div class="activity-item">
                                                                        <span class="activity-icon">@a.Icon</span>
                                                                        <span class="activity-desc">@a.Description</span>
                                                                        <span class="activity-time">@RelativeTime(a.OccurredAt)</span>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </section>
                                                    break;
                                                }
                                            </div>
                                        }
                                    </div>
                            }
                        </section>
                    </div>

@code {
    // ── Health state ────────────────────────────────────────────────────────────────
    private bool _sbConfigured, _aksConfigured, _redisConfigured, _releasesConfigured;
    private HealthTileData? _sbData, _aksData, _redisData, _releasesData;
    private string? _sbError, _aksError, _redisError, _releasesError;

    // ── Pod Health ──────────────────────────────────────────────────────────────────
    private readonly List<PodHealthEvent> _monitorAlerts = [];

    // ── Activity feed ───────────────────────────────────────────────────────────────
    private record ActivityRecord(string Description, string Icon, string Area, DateTimeOffset OccurredAt);
    private readonly List<ActivityRecord> _activities = [];

    // ── Pinned entities ─────────────────────────────────────────────────────────────
    private sealed record DashboardPinnedItem(string DisplayPath, string Icon, WorkspaceSnapshot Snapshot);
    private sealed record DashboardResourceItem(
        string DisplayPath,
        string Icon,
        WorkspaceSnapshot Snapshot,
        DateTimeOffset Timestamp);
    private sealed record DashboardTileEditorRow(
        DashboardTileDefinition Definition,
        DashboardTilePreference Preference,
        string DisplayTitle,
        string Description);
    private sealed record DashboardServiceBusNamespaceOption(string Id, string Label, string FullyQualifiedNamespace);
    private sealed record DashboardServiceBusEntityMetric(
        long ActiveMessages,
        long DeadLetterMessages,
        long ScheduledMessages,
        DateTimeOffset LastUpdated,
        string? Error = null);
    private sealed record DashboardAksNamespaceMetric(
        int PodCount,
        int UnhealthyPods,
        int RestartCount,
        DateTimeOffset LastUpdated,
        string? Error = null);

    // ── Dashboard preferences ───────────────────────────────────────────────────────
    private static readonly Guid DemoOrdersNamespaceId = new("00000000-0000-0000-0000-000000000001");
    private static readonly Guid DemoPaymentsNamespaceId = new("00000000-0000-0000-0000-000000000002");

    private DashboardPreferences _dashboardPreferences = new();
    private bool _isCustomizing;
    private bool _dashboardPreferencesReady;
    private string? _customizerMessage;
    private string _newServiceBusNamespaceId = string.Empty;
    private string _newServiceBusEntityPath = string.Empty;
    private string _newServiceBusTileTitle = string.Empty;
    private string _newAksContext = string.Empty;
    private string _newAksNamespace = "default";
    private string _newAksTileTitle = string.Empty;
    private string? _editingTileId;
    private string _editAksContext = string.Empty;
    private string _editAksNamespace = string.Empty;
    private string _editAksTitle = string.Empty;
    private string _editServiceBusNamespaceId = string.Empty;
    private string _editServiceBusEntityPath = string.Empty;
    private string _editServiceBusTitle = string.Empty;
    private readonly Lock _customTileMetricsLock = new();
    private readonly Dictionary<string, DashboardServiceBusEntityMetric> _serviceBusEntityMetrics =
new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, DashboardAksNamespaceMetric> _aksNamespaceMetrics =
new(StringComparer.OrdinalIgnoreCase);

    private static readonly TimeSpan HealthRefreshBudget = TimeSpan.FromSeconds(8);

    // ── Lifecycle ───────────────────────────────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private readonly SemaphoreSlim _healthRefreshGate = new(1, 1);
    private PeriodicTimer? _refreshTimer;

    protected override void OnInitialized()
    {
        // Determine configured state before the first render so tiles show the correct
        // state immediately rather than flashing "not configured" until the background
        // task runs DetermineConfiguredState.
        DetermineConfiguredState();
        LoadDashboardPreferences();
        InitializeBuilderDefaults();
        _dashboardPreferencesReady = AppState.IsInitialized;
        AppState.Initialized += OnAppStateInitialized;
        Events.Subscribe<ActivityEvent>(OnActivityReceived);
        Events.Subscribe<RefreshRequestedEvent>(OnRefreshRequested);
        Monitor.PodHealthDetected += OnPodHealthDetected;
        Workspaces.Changed += OnWorkspaceChanged;
        // Seed from ring buffer so alerts already recorded before dashboard load are visible.
        _monitorAlerts.AddRange(Monitor.RecentEvents);
    }

    protected override Task OnInitializedAsync()
    {
        _ = LoadHealthDataAsync(_cts.Token);
        _ = StartRefreshLoopAsync();
        return Task.CompletedTask;
    }

    private async Task StartRefreshLoopAsync()
    {
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            while (await _refreshTimer.WaitForNextTickAsync(_cts.Token))
                await LoadHealthDataAsync(_cts.Token);
        }
        catch (OperationCanceledException) { }
    }

    private void OnPodHealthDetected(PodHealthEvent evt)
    {
        _ = InvokeAsync(() =>
        {
            _monitorAlerts.Insert(0, evt);
            if (_monitorAlerts.Count > 50)
                _monitorAlerts.RemoveAt(_monitorAlerts.Count - 1);
            StateHasChanged();
        });
    }

    private void OnActivityReceived(ActivityEvent e)
    {
        var record = new ActivityRecord(e.Description, e.Icon, e.Area, e.OccurredAt);
        _ = InvokeAsync(() =>
        {
            _activities.Insert(0, record);
            if (_activities.Count > 10)
                _activities.RemoveAt(_activities.Count - 1);
            StateHasChanged();
        });
    }

    private void OnRefreshRequested(RefreshRequestedEvent refresh)
    {
        if (!string.Equals(refresh.Area, "dashboard", StringComparison.Ordinal))
        {
            return;
        }

        _ = InvokeAsync(RefreshAll);
    }

    private void OnWorkspaceChanged() => InvokeAsync(StateHasChanged);

    private Task RefreshAll() => LoadHealthDataAsync(_cts.Token);

    private async Task StopMonitoringNamespaceAsync(string ns)
    {
        await Monitor.RemoveNamespaceAsync(ns);
        await InvokeAsync(StateHasChanged);
    }

    private async Task StopAllMonitoringAsync()
    {
        await Monitor.StopAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadHealthDataAsync(CancellationToken ct)
    {
        var enteredGate = false;

        DetermineConfiguredState();
        await InvokeAsync(StateHasChanged);

        try
        {
            enteredGate = await _healthRefreshGate.WaitAsync(0, ct);
            if (!enteredGate)
            {
                return;
            }

            var refreshTasks = new List<Task>
            {
                RefreshHealthTileAsync("Service Bus", FetchServiceBusAsync, error => _sbError = error, ct),
                RefreshHealthTileAsync("AKS", FetchAksAsync, error => _aksError = error, ct),
                RefreshHealthTileAsync("Redis", FetchRedisAsync, error => _redisError = error, ct),
                RefreshHealthTileAsync("Pipelines", FetchReleasesAsync, error => _releasesError = error, ct)
            };

            refreshTasks.AddRange(GetVisibleTilePreferences(DashboardTileRegistry.ServiceBusEntityWatch)
                .Select(preference => RefreshServiceBusEntityWatchAsync(preference, ct)));
            refreshTasks.AddRange(GetVisibleTilePreferences(DashboardTileRegistry.AksNamespaceWatch)
                .Select(preference => RefreshAksNamespaceWatchAsync(preference, ct)));

            await Task.WhenAll(refreshTasks);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        finally
        {
            if (enteredGate)
            {
                _healthRefreshGate.Release();
            }
        }
        // Each tile calls StateHasChanged when it finishes — no single batch update needed here.
    }

    private async Task RefreshHealthTileAsync(
        string areaName,
        Func<CancellationToken, Task> refresh,
        Action<string?> setError,
        CancellationToken ct)
    {
        using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(ct);
        timeoutCts.CancelAfter(HealthRefreshBudget);

        try
        {
            await refresh(timeoutCts.Token);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            throw;
        }
        catch (OperationCanceledException)
        {
            setError($"Timed out while refreshing {areaName}.");
        }
        catch (Exception ex)
        {
            setError(ex.Message);
        }
        finally
        {
            // Update this tile's UI as soon as it finishes, independent of the other tiles.
            // OperationCanceledException (navigation away) skips this via the throw above.
            if (!ct.IsCancellationRequested)
                await InvokeAsync(StateHasChanged);
        }
    }

    private void DetermineConfiguredState()
    {
        _sbConfigured = AppState.UseDemoData || AppState.ServiceBusNamespaces.Count > 0;
        _aksConfigured = AppState.UseDemoData || AppState.Config.AksConfig is not null;
        _redisConfigured = AppState.UseDemoData || AppState.Config.RedisConfig?.ActiveCache is not null;
        _releasesConfigured = AppState.UseDemoData ||
            (AppState.Config.DevOpsConfig is not null && !string.IsNullOrEmpty(AppState.Config.DevOpsConfig.Organization));
    }

    private void LoadDashboardPreferences()
    {
        _dashboardPreferences = UiState.GetDashboardPreferences(DashboardTileRegistry.DefaultPreferences);
    }

    private void OnAppStateInitialized()
    {
        _ = InvokeAsync(() =>
        {
            LoadDashboardPreferences();
            _dashboardPreferencesReady = true;
            StateHasChanged();
        });
    }

    private void ToggleCustomization()
    {
        if (!_dashboardPreferencesReady)
        {
            return;
        }

        InitializeBuilderDefaults();
        _customizerMessage = null;
        _isCustomizing = !_isCustomizing;
    }

    private void InitializeBuilderDefaults()
    {
        var serviceBusNamespace = GetServiceBusNamespaceOptions().FirstOrDefault();
        if (string.IsNullOrWhiteSpace(_newServiceBusNamespaceId) && serviceBusNamespace is not null)
        {
            _newServiceBusNamespaceId = serviceBusNamespace.Id;
        }

        if (string.IsNullOrWhiteSpace(_newAksNamespace))
        {
            _newAksNamespace = AppState.Config.AksConfig?.DefaultNamespace ?? "default";
        }

        if (string.IsNullOrWhiteSpace(_newAksContext))
        {
            _newAksContext = AppState.Config.AksConfig?.KubeconfigContext ?? string.Empty;
        }
    }

    private IReadOnlyList<DashboardTileDefinition> GetVisibleTileDefinitions() => _dashboardPreferences.Tiles
        .Select(static (preference, index) => (Preference: preference, Index: index))
        .Where(static item => item.Preference.IsVisible)
        .Select(static item => (Definition: DashboardTileRegistry.Find(item.Preference.TileId), item.Preference, item.Index))
        .Where(static tile => tile.Definition is not null)
        .Select(static tile => (Definition: tile.Definition! with { Size = tile.Preference.Size }, tile.Index))
        .Where(tile => ShouldRenderTile(tile.Definition))
        .OrderBy(static tile => GetTileVisualGroup(tile.Definition.Id))
        .ThenBy(static tile => tile.Index)
        .Select(static tile => tile.Definition)
        .ToList();

    private IReadOnlyList<DashboardTilePreference> GetVisibleTilePreferences(string templateId) =>
_dashboardPreferences.Tiles
        .Where(preference => preference.IsVisible
            && DashboardTileRegistry.GetTemplateId(preference.TileId).Equals(templateId, StringComparison.OrdinalIgnoreCase)
            && DashboardTileRegistry.IsCustomTile(preference.TileId))
        .ToList();

    private static int GetTileVisualGroup(string tileId) => DashboardTileRegistry.GetTemplateId(tileId) switch
    {
        DashboardTileRegistry.ServiceBusDeadLetters or
        DashboardTileRegistry.AksUnhealthyPods or
        DashboardTileRegistry.RedisExpiringKeys or
        DashboardTileRegistry.PendingApprovals => 0,
        DashboardTileRegistry.ServiceBusEntityWatch or
        DashboardTileRegistry.AksNamespaceWatch => 1,
        DashboardTileRegistry.RecentResources or
        DashboardTileRegistry.Favorites or
        DashboardTileRegistry.OpenTabs => 2,
        DashboardTileRegistry.PodHealthAlerts => 3,
        DashboardTileRegistry.RecentActivity => 4,
        _ => 4
    };

    private IReadOnlyList<DashboardTileEditorRow> GetTileEditorRows() => _dashboardPreferences.Tiles
        .Select(preference => (Definition: DashboardTileRegistry.Find(preference.TileId), Preference: preference))
        .Where(static row => row.Definition is not null)
        .Where(static row => !IsHiddenTemplatePreference(row.Preference))
        .Select(row => new DashboardTileEditorRow(
            row.Definition!,
            row.Preference,
            GetTileDisplayTitle(row.Definition!, row.Preference),
            GetTileEditorDescription(row.Definition!, row.Preference)))
        .ToList();

    private bool ShouldRenderTile(DashboardTileDefinition tile) => tile.Id switch
    {
        DashboardTileRegistry.PodHealthAlerts => Monitor.IsMonitoring || _monitorAlerts.Count > 0,
        _ when IsHiddenTemplateTile(tile.Id) => false,
        _ => true
    };

    private static bool IsHiddenTemplatePreference(DashboardTilePreference preference) =>
IsHiddenTemplateTile(preference.TileId);

    private static bool IsHiddenTemplateTile(string tileId) => DashboardTileRegistry.IsTemplateTile(tileId)
        && (DashboardTileRegistry.IsServiceBusEntityWatch(tileId) || DashboardTileRegistry.IsAksNamespaceWatch(tileId));

    private bool IsFirstTile(string tileId) => FindTilePreferenceIndex(tileId) <= 0;

    private bool IsLastTile(string tileId)
    {
        var index = FindTilePreferenceIndex(tileId);
        return index < 0 || index >= _dashboardPreferences.Tiles.Count - 1;
    }

    private async Task SetTileVisibilityAsync(string tileId, bool isVisible)
    {
        if (!_dashboardPreferencesReady)
        {
            return;
        }

        var index = FindTilePreferenceIndex(tileId);
        if (index < 0)
        {
            return;
        }

        var tiles = _dashboardPreferences.Tiles.ToList();
        tiles[index] = tiles[index] with { IsVisible = isVisible };
        _dashboardPreferences = _dashboardPreferences with { Tiles = tiles };
        await SaveDashboardPreferencesAsync();
    }

    private static bool IsEditableCustomTile(DashboardTilePreference preference) =>
        DashboardTileRegistry.IsCustomTile(preference.TileId)
        && (DashboardTileRegistry.IsAksNamespaceWatch(preference.TileId)
            || DashboardTileRegistry.IsServiceBusEntityWatch(preference.TileId));

    private bool IsEditingTile(string tileId) =>
        !string.IsNullOrEmpty(_editingTileId)
        && string.Equals(_editingTileId, tileId, StringComparison.OrdinalIgnoreCase);

    private void ToggleEditTile(string tileId)
    {
        if (IsEditingTile(tileId))
        {
            _editingTileId = null;
            return;
        }

        var preference = _dashboardPreferences.Tiles
            .FirstOrDefault(candidate => string.Equals(candidate.TileId, tileId, StringComparison.OrdinalIgnoreCase));
        if (preference is null || !IsEditableCustomTile(preference))
        {
            return;
        }

        _editingTileId = tileId;
        _customizerMessage = null;

        if (DashboardTileRegistry.IsAksNamespaceWatch(tileId))
        {
            _editAksContext = GetSetting(preference, "context", AppState.Config.AksConfig?.KubeconfigContext ?? string.Empty);
            _editAksNamespace = GetSetting(preference, "namespace", string.Empty);
            _editAksTitle = GetSetting(preference, "title", string.Empty);
        }
        else if (DashboardTileRegistry.IsServiceBusEntityWatch(tileId))
        {
            _editServiceBusNamespaceId = GetSetting(preference, "namespaceId", string.Empty);
            _editServiceBusEntityPath = GetSetting(preference, "entityPath", string.Empty);
            _editServiceBusTitle = GetSetting(preference, "title", string.Empty);
        }
    }

    private async Task SaveEditedTileAsync(string tileId)
    {
        if (!_dashboardPreferencesReady)
        {
            return;
        }

        var index = FindTilePreferenceIndex(tileId);
        if (index < 0)
        {
            return;
        }

        var current = _dashboardPreferences.Tiles[index];
        if (!IsEditableCustomTile(current))
        {
            return;
        }

        var settings = new Dictionary<string, string>(current.Settings ?? new Dictionary<string,
string>(StringComparer.Ordinal),
            StringComparer.Ordinal);

        if (DashboardTileRegistry.IsAksNamespaceWatch(tileId))
        {
            var context = _editAksContext.Trim();
            var @namespace = _editAksNamespace.Trim();
            if (string.IsNullOrWhiteSpace(@namespace))
            {
                _customizerMessage = "Enter an AKS namespace.";
                return;
            }

            var title = string.IsNullOrWhiteSpace(_editAksTitle) ? @namespace : _editAksTitle.Trim();
            if (string.IsNullOrWhiteSpace(context))
            {
                settings.Remove("context");
            }
            else
            {
                settings["context"] = context;
            }

            settings["namespace"] = @namespace;
            settings["title"] = title;
        }
        else if (DashboardTileRegistry.IsServiceBusEntityWatch(tileId))
        {
            var namespaceOption = GetServiceBusNamespaceOptions()
                .FirstOrDefault(option => string.Equals(option.Id, _editServiceBusNamespaceId, StringComparison.OrdinalIgnoreCase));
            var entityPath = _editServiceBusEntityPath.Trim();
            if (namespaceOption is null || string.IsNullOrWhiteSpace(entityPath))
            {
                _customizerMessage = "Choose a Service Bus namespace and entity path.";
                return;
            }

            var title = string.IsNullOrWhiteSpace(_editServiceBusTitle)
                ? entityPath.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).LastOrDefault() ??
entityPath
                : _editServiceBusTitle.Trim();
            settings["namespaceId"] = namespaceOption.Id;
            settings["namespaceLabel"] = namespaceOption.Label;
            settings["entityPath"] = entityPath;
            settings["title"] = title;

            // Drop stale cached metric for the previous entity key.
            lock (_customTileMetricsLock)
            {
                _serviceBusEntityMetrics.Clear();
            }
        }
        else
        {
            return;
        }

        var tiles = _dashboardPreferences.Tiles.ToList();
        tiles[index] = current with { Settings = settings };
        _dashboardPreferences = _dashboardPreferences with { Tiles = tiles };

        // Drop AKS metric cache so the tile re-queries with the new namespace.
        if (DashboardTileRegistry.IsAksNamespaceWatch(tileId))
        {
            lock (_customTileMetricsLock)
            {
                _aksNamespaceMetrics.Clear();
            }
        }

        _editingTileId = null;
        _customizerMessage = "Tile updated.";
        await SaveDashboardPreferencesAsync();
        _ = RefreshAll();
    }

    private async Task RemoveTileAsync(string tileId)
    {
        if (!_dashboardPreferencesReady)
        {
            return;
        }

        if (DashboardTileRegistry.IsCustomTile(tileId))
        {
            var tiles = _dashboardPreferences.Tiles
                .Where(preference => !string.Equals(preference.TileId, tileId, StringComparison.OrdinalIgnoreCase))
                .ToList();
            _dashboardPreferences = _dashboardPreferences with { Tiles = tiles };
        }
        else
        {
            var index = FindTilePreferenceIndex(tileId);
            if (index < 0)
            {
                return;
            }

            var tiles = _dashboardPreferences.Tiles.ToList();
            tiles[index] = tiles[index] with { IsVisible = false };
            _dashboardPreferences = _dashboardPreferences with { Tiles = tiles };
        }

        await SaveDashboardPreferencesAsync();
    }

    private async Task AddServiceBusEntityTileAsync()
    {
        if (!_dashboardPreferencesReady)
        {
            return;
        }

        var namespaceOption = GetServiceBusNamespaceOptions()
            .FirstOrDefault(option => string.Equals(option.Id, _newServiceBusNamespaceId, StringComparison.OrdinalIgnoreCase))
            ?? GetServiceBusNamespaceOptions().FirstOrDefault();
        var entityPath = _newServiceBusEntityPath.Trim();
        if (namespaceOption is null || string.IsNullOrWhiteSpace(entityPath))
        {
            _customizerMessage = "Choose a Service Bus namespace and entity path.";
            return;
        }

        var title = string.IsNullOrWhiteSpace(_newServiceBusTileTitle)
            ? entityPath.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).LastOrDefault() ??
entityPath
            : _newServiceBusTileTitle.Trim();

        var tile = new DashboardTilePreference
        {
            TileId = DashboardTileRegistry.CreateInstanceId(DashboardTileRegistry.ServiceBusEntityWatch),
            IsVisible = true,
            Size = "medium",
            Settings = new Dictionary<string, string>(StringComparer.Ordinal)
            {
                ["title"] = title,
                ["namespaceId"] = namespaceOption.Id,
                ["namespaceLabel"] = namespaceOption.Label,
                ["entityPath"] = entityPath
            }
        };

        await AddCustomTileAsync(tile);
        _newServiceBusEntityPath = string.Empty;
        _newServiceBusTileTitle = string.Empty;
        _customizerMessage = $"Added {title}.";
    }

    private async Task AddAksNamespaceTileAsync()
    {
        if (!_dashboardPreferencesReady)
        {
            return;
        }

        var @namespace = _newAksNamespace.Trim();
        if (string.IsNullOrWhiteSpace(@namespace))
        {
            _customizerMessage = "Enter an AKS namespace.";
            return;
        }

        var title = string.IsNullOrWhiteSpace(_newAksTileTitle) ? @namespace : _newAksTileTitle.Trim();
        var context = _newAksContext.Trim();
        var settings = new Dictionary<string, string>(StringComparer.Ordinal)
        {
            ["title"] = title,
            ["namespace"] = @namespace
        };

        if (!string.IsNullOrWhiteSpace(context))
        {
            settings["context"] = context;
        }

        var tile = new DashboardTilePreference
        {
            TileId = DashboardTileRegistry.CreateInstanceId(DashboardTileRegistry.AksNamespaceWatch),
            IsVisible = true,
            Size = "medium",
            Settings = settings
        };

        await AddCustomTileAsync(tile);
        _newAksContext = AppState.Config.AksConfig?.KubeconfigContext ?? string.Empty;
        _newAksNamespace = AppState.Config.AksConfig?.DefaultNamespace ?? "default";
        _newAksTileTitle = string.Empty;
        _customizerMessage = $"Added {title}.";
    }

    private async Task AddCustomTileAsync(DashboardTilePreference tile)
    {
        var tiles = _dashboardPreferences.Tiles.ToList();
        var insertIndex = tiles.FindIndex(preference => DashboardTileRegistry.GetTemplateId(preference.TileId) is
DashboardTileRegistry.RecentResources or DashboardTileRegistry.Favorites);
        if (insertIndex < 0)
        {
            tiles.Add(tile);
        }
        else
        {
            tiles.Insert(insertIndex, tile);
        }

        _dashboardPreferences = _dashboardPreferences with { Tiles = tiles };
        await SaveDashboardPreferencesAsync();
        _ = LoadHealthDataAsync(_cts.Token);
    }

    private async Task MoveTileAsync(string tileId, int offset)
    {
        if (!_dashboardPreferencesReady)
        {
            return;
        }

        var currentIndex = FindTilePreferenceIndex(tileId);
        var nextIndex = currentIndex + offset;
        if (currentIndex < 0 || nextIndex < 0 || nextIndex >= _dashboardPreferences.Tiles.Count)
        {
            return;
        }

        var tiles = _dashboardPreferences.Tiles.ToList();
        (tiles[currentIndex], tiles[nextIndex]) = (tiles[nextIndex], tiles[currentIndex]);
        _dashboardPreferences = _dashboardPreferences with { Tiles = tiles };
        await SaveDashboardPreferencesAsync();
    }

    private async Task ResetDashboardPreferencesAsync()
    {
        if (!_dashboardPreferencesReady)
        {
            return;
        }

        _dashboardPreferences = new DashboardPreferences
        {
            Tiles = DashboardTileRegistry.DefaultPreferences.Select(static preference => preference with { }).ToList()
        };

        await SaveDashboardPreferencesAsync();
    }

    private async Task SaveDashboardPreferencesAsync()
    {
        await UiState.SaveDashboardPreferencesAsync(_dashboardPreferences, DashboardTileRegistry.DefaultPreferences);
        LoadDashboardPreferences();
        await InvokeAsync(StateHasChanged);
    }

    private int FindTilePreferenceIndex(string tileId) => _dashboardPreferences.Tiles.FindIndex(preference =>
        string.Equals(preference.TileId, tileId, StringComparison.OrdinalIgnoreCase));

    // ── Service Bus ─────────────────────────────────────────────────────────────────

    private async Task FetchServiceBusAsync(CancellationToken ct)
    {
        if (!_sbConfigured) return;
        try
        {
            long dlq = 0;
            if (AppState.UseDemoData)
            {
                dlq += await SumDlqAsync(DemoServiceBusClient.OrdersDev(), ct);
            }
            else
            {
                foreach (var ns in AppState.ServiceBusNamespaces)
                {
                    var connStr = CredentialStore.Get(ns.CredentialKey);
                    if (string.IsNullOrWhiteSpace(connStr)) continue;
                    var client = SbClientFactory.Create(connStr);
                    try
                    {
                        dlq += await SumDlqAsync(client, ct);
                    }
                    finally
                    {
                        if (client is IAsyncDisposable d) await d.DisposeAsync();
                    }
                }
            }
            _sbData = new HealthTileData((int)dlq, "dead-lettered", DateTimeOffset.Now);
            _sbError = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _sbError = ex.Message;
        }
    }

    private static async Task<long> SumDlqAsync(IServiceBusClient client, CancellationToken ct)
    {
        var queues = await client.ListQueuesAsync(ct);
        return queues.Sum(queue => queue.Stats?.DeadLetterMessageCount ?? 0);
    }

    // ── AKS ─────────────────────────────────────────────────────────────────────────

    private async Task FetchAksAsync(CancellationToken ct)
    {
        if (!_aksConfigured) return;
        try
        {
            var aksConfig = AppState.Config.AksConfig;
            var ns = aksConfig?.DefaultNamespace ?? "default";

            IAksClient client = AppState.UseDemoData
                ? DemoAksClient
                : AksClientFactory.Create(aksConfig!.KubeconfigContext, aksConfig.KubeconfigPath);

            var pods = await client.GetPodsAsync(ns, null, ct);
            var unhealthy = pods.Count(p => p.Status is not ("Running" or "Succeeded" or "Completed"));
            _aksData = new HealthTileData(unhealthy, "unhealthy pods", DateTimeOffset.Now);
            _aksError = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _aksError = ex.Message;
        }
    }

    // ── Redis ────────────────────────────────────────────────────────────────────────

    private async Task FetchRedisAsync(CancellationToken ct)
    {
        if (!_redisConfigured) return;
        try
        {
            IRedisClient client = AppState.UseDemoData
                ? DemoRedisClient
                : await RedisClientFactory.CreateAsync(AppState.Config.RedisConfig!.ActiveCache!, ct);

            using (client)
            {
                var scan = await client.ScanKeysAsync("*", 0, 100, ct);
                var infoTasks = scan.Keys.Select(k => client.GetKeyInfoAsync(k, ct));
                var infos = await Task.WhenAll(infoTasks);
                var nearExpiry = infos.Count(i => i.Ttl is { } ttl && ttl < TimeSpan.FromMinutes(5) && ttl > TimeSpan.Zero);
                _redisData = new HealthTileData(nearExpiry, "keys expiring < 5m", DateTimeOffset.Now);
                _redisError = null;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _redisError = ex.Message;
        }
    }

    // ── Releases ─────────────────────────────────────────────────────────────────────

    private async Task FetchReleasesAsync(CancellationToken ct)
    {
        if (!_releasesConfigured) return;
        try
        {
            IDevOpsClient client = AppState.UseDemoData
                ? DemoDevOpsClient
                : CreateLiveDevOpsClient();
            var projects = await client.GetProjectsAsync(ct);
            var approvalTasks = projects.Select(p => client.GetPendingApprovalsAsync(p.Name, ct));
            var results = await Task.WhenAll(approvalTasks);
            var total = results.Sum(r => r.Count);
            _releasesData = new HealthTileData(total, "pending approvals", DateTimeOffset.Now);
            _releasesError = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _releasesError = ex.Message;
        }
    }

    private IDevOpsClient CreateLiveDevOpsClient()
    {
        var config = AppState.Config.DevOpsConfig
            ?? throw new InvalidOperationException("Azure DevOps is not configured.");

        return DevOpsClientFactory.Create(config);
    }

    private async Task RefreshServiceBusEntityWatchAsync(DashboardTilePreference preference, CancellationToken ct)
    {
        var tileId = preference.TileId;
        var namespaceId = GetSetting(preference, "namespaceId");
        var entityPath = GetSetting(preference, "entityPath");
        if (string.IsNullOrWhiteSpace(namespaceId) || string.IsNullOrWhiteSpace(entityPath))
        {
            SetServiceBusEntityMetric(tileId, new DashboardServiceBusEntityMetric(0, 0, 0, DateTimeOffset.Now, "Tile target is incomplete."));
            return;
        }

        IServiceBusClient? client = null;
        try
        {
            client = CreateServiceBusClient(namespaceId);
            if (client is null)
            {
                SetServiceBusEntityMetric(tileId, new DashboardServiceBusEntityMetric(0, 0, 0, DateTimeOffset.Now, "Namespace is not available."));
                return;
            }

            var stats = await client.GetEntityStatsAsync(entityPath, ct);
            SetServiceBusEntityMetric(tileId, new DashboardServiceBusEntityMetric(
                stats.ActiveMessageCount,
                stats.DeadLetterMessageCount,
                stats.ScheduledMessageCount,
                stats.UpdatedAt ?? DateTimeOffset.Now));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            SetServiceBusEntityMetric(tileId, new DashboardServiceBusEntityMetric(0, 0, 0, DateTimeOffset.Now, ex.Message));
        }
        finally
        {
            if (client is IAsyncDisposable disposable)
            {
                await disposable.DisposeAsync();
            }

            if (!ct.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task RefreshAksNamespaceWatchAsync(DashboardTilePreference preference, CancellationToken ct)
    {
        var tileId = preference.TileId;
        var @namespace = GetSetting(preference, "namespace", AppState.Config.AksConfig?.DefaultNamespace ?? "default");
        if (string.IsNullOrWhiteSpace(@namespace))
        {
            SetAksNamespaceMetric(tileId, new DashboardAksNamespaceMetric(0, 0, 0, DateTimeOffset.Now, "Namespace is not configured."));
            return;
        }

        try
        {
            var context = GetSetting(preference, "context", AppState.Config.AksConfig?.KubeconfigContext ?? string.Empty);
            IAksClient client = AppState.UseDemoData
                ? DemoAksClient
                : AksClientFactory.Create(string.IsNullOrWhiteSpace(context) ? null : context, AppState.Config.AksConfig!.KubeconfigPath);

            var pods = await client.GetPodsAsync(@namespace, null, ct);
            var unhealthyPods = pods.Count(static pod => !pod.Ready || pod.Status is not ("Running" or "Succeeded" or "Completed"));
            var restartCount = pods.Sum(static pod => pod.RestartCount);

            SetAksNamespaceMetric(tileId, new DashboardAksNamespaceMetric(
                pods.Count,
                unhealthyPods,
                restartCount,
                DateTimeOffset.Now));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            SetAksNamespaceMetric(tileId, new DashboardAksNamespaceMetric(0, 0, 0, DateTimeOffset.Now, ex.Message));
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private IServiceBusClient? CreateServiceBusClient(string namespaceId)
    {
        if (AppState.UseDemoData)
        {
            return Guid.TryParse(namespaceId, out var demoId) && demoId == DemoPaymentsNamespaceId
                ? DemoServiceBusClient.PaymentsDev()
                : DemoServiceBusClient.OrdersDev();
        }

        if (!Guid.TryParse(namespaceId, out var parsedNamespaceId))
        {
            return null;
        }

        var serviceBusNamespace = AppState.ServiceBusNamespaces.FirstOrDefault(ns => ns.Id == parsedNamespaceId);
        if (serviceBusNamespace is null)
        {
            return null;
        }

        var connectionString = CredentialStore.Get(serviceBusNamespace.CredentialKey);
        return string.IsNullOrWhiteSpace(connectionString) ? null : SbClientFactory.Create(connectionString);
    }

