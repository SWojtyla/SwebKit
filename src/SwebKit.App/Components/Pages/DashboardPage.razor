    private static string GetSetting(DashboardTilePreference? preference, string key, string fallback = "") =>
        preference?.Settings is not null && preference.Settings.TryGetValue(key, out var value) &&
!string.IsNullOrWhiteSpace(value)
            ? value
            : fallback;

    private static string GetTileGridClass(IReadOnlyList<DashboardTileDefinition> visibleTiles)
    {
        var hasListTile = visibleTiles.Any(static tile => DashboardTileRegistry.GetTemplateId(tile.Id) is
            DashboardTileRegistry.RecentResources or DashboardTileRegistry.Favorites or DashboardTileRegistry.OpenTabs);

        return visibleTiles.Count switch
        {
            1 when hasListTile => "dashboard-tile-grid dashboard-tile-grid--single dashboard-tile-grid--single-wide",
            1 => "dashboard-tile-grid dashboard-tile-grid--single",
            2 when hasListTile => "dashboard-tile-grid dashboard-tile-grid--pair dashboard-tile-grid--pair-with-list",
            2 => "dashboard-tile-grid dashboard-tile-grid--pair",
            _ => "dashboard-tile-grid"
        };
    }

    private int GetAttentionCount()
    {
        var count = 0;
        if (_sbData?.Value > 0) count++;
        if (_aksData?.Value > 0) count++;
        if (_redisData?.Value > 0) count++;
        if (_releasesData?.Value > 0) count++;
        count += _serviceBusEntityMetrics.Values.Count(static metric => metric.DeadLetterMessages > 0 ||
!string.IsNullOrWhiteSpace(metric.Error));
        count += _aksNamespaceMetrics.Values.Count(static metric => metric.UnhealthyPods > 0 ||
            (!string.IsNullOrWhiteSpace(metric.Error) && !IsDeploymentPermissionError(metric.Error)));
        return count;
    }

    private RenderFragment RenderMetricBody(bool isConfigured, HealthTileData? data, string? error, string fallbackLabel) =>
builder =>
    {
        if (!isConfigured)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "dashboard-signal__empty");
            builder.AddContent(2, "Not configured");
            builder.CloseElement();
            return;
        }

        if (!string.IsNullOrWhiteSpace(error))
        {
            builder.OpenElement(3, "p");
            builder.AddAttribute(4, "class", "dashboard-signal__error");
            builder.AddContent(5, error);
            builder.CloseElement();
            return;
        }

        if (data is null)
        {
            builder.OpenElement(6, "p");
            builder.AddAttribute(7, "class", "dashboard-signal__empty");
            builder.AddContent(8, "Loading...");
            builder.CloseElement();
            return;
        }

        builder.OpenElement(9, "div");
        builder.AddAttribute(10, "class", "dashboard-signal__metric");
        builder.OpenElement(11, "strong");
        builder.AddContent(12, data.Value);
        builder.CloseElement();
        builder.OpenElement(13, "span");
        builder.AddContent(14, string.IsNullOrWhiteSpace(data.Label) ? fallbackLabel : data.Label);
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(15, "p");
        builder.AddAttribute(16, "class", "dashboard-signal__updated");
        builder.AddContent(17, $"Updated {RelativeTime(data.LastUpdated)}");
        builder.CloseElement();
    };

