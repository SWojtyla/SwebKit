                                                                                Stats="@GetAksNamespaceStats(namespaceMetric)"
                                                                                LastUpdated="@(namespaceMetric?.LastUpdated ?? default)"
                                                                                Error="@GetAksNamespaceTileError(namespaceMetric)"
                                                                                Note="@GetAksNamespaceTileNote(namespaceMetric)"
                                                                                IsLoading="@IsAksNamespaceTileLoading(tile.Id)"
                                                                                LoadingText="Loading namespace summary..."
