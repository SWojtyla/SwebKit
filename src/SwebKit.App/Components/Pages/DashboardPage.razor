                                                                break;
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                        }
                                    </section>
                                </div>

                                @if (!activeLayout.CollapseInsightDock)
                                {
                                    <aside class="dashboard-insight-dock" aria-label="Home insight dock">
                                        <section class="dashboard-dock-card">
