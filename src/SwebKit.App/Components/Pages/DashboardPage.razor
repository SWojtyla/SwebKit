@page "/"
@page "/dashboard"
@inject AppStateService AppState
@inject IDevOpsClientFactory DevOpsClientFactory
@inject IServiceBusClientFactory SbClientFactory
@inject IAksClientFactory AksClientFactory
@inject IRedisClientFactory RedisClientFactory
@inject IAppEventBus Events
@inject ICredentialStore CredentialStore
@inject INotificationService Notifications
@inject IPodHealthMonitorService Monitor
@inject NavigationManager Nav
@inject UiStateRepository UiState
@inject SwebKit.Core.Services.DemoDevOpsClient DemoDevOpsClient
@inject SwebKit.Core.Services.DemoAksClient DemoAksClient
@inject SwebKit.Core.Services.DemoRedisClient DemoRedisClient
@inject OperatorWorkspaceService Workspaces
@implements IDisposable

@{
    var renderState = GetRenderState();
    var activeView = renderState.ActiveView;
    var activeFilters = activeView.Filters;
    var activeLayout = activeView.Layout;
    var dashboardViews = renderState.DashboardViews;
    var pinnedItems = renderState.PinnedItems;
    var recentItems = renderState.RecentItems;
    var openTabs = renderState.OpenTabs;
    var visibleTiles = renderState.VisibleTiles;
    var kpiTiles = renderState.KpiTiles;
    var boardTiles = renderState.BoardTiles;
    var editorRows = renderState.EditorRows;
    var serviceBusNamespaces = renderState.ServiceBusNamespaces;
    var attentionCount = GetAttentionCount();
}

<div class="@renderState.PageClass">
    <RoutePageHeader Area="dashboard"
                     Subtitle="Your operational home page for live posture, quick resume context, and drill-through.">
        <Meta>
        @if (AppState.UseDemoData)
        {
            <span class="shell-pill shell-pill--warning">Demo mode</span>
        }
        <span class="shell-pill shell-pill--accent">@activeView.Title</span>
        <span class="shell-pill shell-pill--muted">@pinnedItems.Count favorite@(pinnedItems.Count == 1 ? "" :
                                                                                                                                                                     "s")</span>
            <span class="shell-pill shell-pill--muted">@visibleTiles.Count tile@(visibleTiles.Count == 1 ? "" : "s")</span>
            @if (Monitor.IsMonitoring)
            {
                <span class="shell-pill shell-pill--accent">@Monitor.MonitoredNamespaces.Count
                    namespace@(Monitor.MonitoredNamespaces.Count == 1 ? "" : "s") monitored</span>
                }
            </Meta>
            <Actions>
                <button class="dashboard-action-button" type="button" @onclick="RefreshAll">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowClockwise())" Width="18px" />
                    <span>Refresh</span>
                </button>
                <button class="dashboard-action-button dashboard-action-button--primary" type="button"
                        disabled="@(!_dashboardPreferencesReady)" @onclick="ToggleCustomization">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Settings())" Width="18px" />
                    <span>@(_isCustomizing ? "Done" : "Customize")</span>
                </button>
            </Actions>
        </RoutePageHeader>

        <DashboardOverviewStrip Title="@activeView.Title" AttentionCount="@attentionCount"
                                VisibleTileCount="@visibleTiles.Count" ResumeCount="@(pinnedItems.Count + openTabs.Count)"
                                HomeModeLabel="@GetHomeModeLabel()" AreaLabel="@GetAreaFilterLabel(activeFilters.Area)"
                                FocusLabel="@GetSeverityFilterLabel(activeFilters.Severity)"
                                TimeWindowLabel="@GetTimeWindowLabel(activeFilters.TimeWindow)"
                                ConnectedAreasCount="@GetConfiguredSystemsCount()"
                                RefreshCadenceLabel="@GetRefreshCadenceLabel(activeFilters.LiveMode)" RecentResourceCount="@recentItems.Count"
                                IsMonitoring="@Monitor.IsMonitoring" MonitoredNamespaceCount="@Monitor.MonitoredNamespaces.Count">
            <Controls>
                <section class="dashboard-shell-controls" aria-label="Dashboard saved views and filters">
                    <label class="dashboard-shell-control">
                        <span>View</span>
                        <select class="dashboard-field dashboard-shell-control__input" value="@activeView.Id"
                                @onchange="OnActiveViewChangedAsync">
                            @foreach (var view in dashboardViews)
                            {
                                <option value="@view.Id">@view.Title</option>
                            }
                        </select>
                    </label>

                    <label class="dashboard-shell-control">
                        <span>Area</span>
                        <select class="dashboard-field dashboard-shell-control__input" value="@activeFilters.Area"
                                @onchange="OnAreaFilterChangedAsync">
                            <option value="all">All areas</option>
                            <option value="dashboard">Workspace</option>
                            <option value="service-bus">Service Bus</option>
                            <option value="aks">AKS</option>
                            <option value="redis">Redis</option>
                            <option value="pipelines">Pipelines</option>
                        </select>
                    </label>

                    <label class="dashboard-shell-control">
                        <span>Focus</span>
                        <select class="dashboard-field dashboard-shell-control__input" value="@activeFilters.Severity"
                                @onchange="OnSeverityFilterChangedAsync">
                            <option value="all">All widgets</option>
                            <option value="attention">Needs attention</option>
                            <option value="healthy">Healthy only</option>
                        </select>
                    </label>

                    <label class="dashboard-shell-control">
                        <span>Window</span>
                        <select class="dashboard-field dashboard-shell-control__input" value="@activeFilters.TimeWindow"
                                @onchange="OnTimeWindowChangedAsync">
                            <option value="live">Live</option>
                            <option value="15m">15 minutes</option>
                            <option value="1h">1 hour</option>
                            <option value="4h">4 hours</option>
                            <option value="today">Today</option>
                        </select>
                    </label>

                    <label class="dashboard-shell-control">
                        <span>Refresh</span>
                        <select class="dashboard-field dashboard-shell-control__input" value="@activeFilters.LiveMode"
                                @onchange="OnLiveModeChangedAsync">
                            <option value="live">Live cadence</option>
                            <option value="snapshot">Manual snapshot</option>
                        </select>
                    </label>
                </section>
            </Controls>
            <Actions>
                <div class="dashboard-shell-actions" aria-label="Dashboard view actions">
                    <button class="dashboard-action-button" type="button" disabled="@(!_dashboardPreferencesReady)"
                            @onclick="CreateDashboardViewAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Add())" Width="16px" />
                        <span>New view</span>
                    </button>
                    <button class="dashboard-action-button" type="button" disabled="@(!_dashboardPreferencesReady)"
                            @onclick="DuplicateDashboardViewAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size20.DocumentMultiple())" Width="16px" />
                        <span>Duplicate</span>
                    </button>
                    <button class="dashboard-action-button" type="button" disabled="@(!_dashboardPreferencesReady)"
                            @onclick="BeginRenameDashboardView">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Edit())" Width="16px" />
                        <span>Rename</span>
                    </button>
                    <button class="dashboard-action-button" type="button"
                            disabled="@(!_dashboardPreferencesReady || dashboardViews.Count <= 1)"
                            @onclick="DeleteDashboardViewAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Delete())" Width="16px" />
                        <span>Delete</span>
                    </button>
                    <button class="dashboard-action-button" type="button" disabled="@(!_dashboardPreferencesReady)"
                            @onclick="ToggleKpiRibbonAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size20.DataTrending())" Width="16px" />
                        <span>@(activeLayout.ShowKpiRibbon ? "Hide KPI" : "Show KPI")</span>
                    </button>
                    <button class="dashboard-action-button" type="button" disabled="@(!_dashboardPreferencesReady)"
                            @onclick="ToggleInsightDockAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size20.PanelRight())" Width="16px" />
                        <span>@(activeLayout.CollapseInsightDock ? "Show Dock" : "Collapse Dock")</span>
                    </button>
                </div>
            </Actions>
        </DashboardOverviewStrip>

        @if (_isEditingViewTitle)
        {
            <div class="dashboard-view-editor" aria-label="Rename dashboard view">
                <label class="dashboard-shell-control dashboard-shell-control--wide">
                    <span>View title</span>
                    <input class="dashboard-field dashboard-shell-control__input" @bind="_viewTitleDraft"
                           placeholder="Operations review" />
                </label>
                <div class="dashboard-view-editor__actions">
                    <button class="dashboard-add-button" type="button" @onclick="RenameDashboardViewAsync">Save
                        view</button>
                        <button class="dashboard-action-button" type="button" @onclick="CancelRenameDashboardView">Cancel</button>
                    </div>
                </div>
            }

            @if (activeLayout.ShowKpiRibbon && kpiTiles.Count > 0)
            {
                <section class="dashboard-kpi-ribbon" aria-label="Priority KPI ribbon">
                    @if (HasVisibleTile(kpiTiles, DashboardTileRegistry.ServiceBusDeadLetters))
                    {
                        <DashboardMetricTile AreaLabel="Service Bus" OpenHref="/service-bus" IsConfigured="@_sbConfigured"
                                             Data="@_sbData" Error="@_sbError" FallbackLabel="dead-lettered" IsLoading="@_sbLoading"
                                             CssClass="dashboard-metric-tile--service-bus" />
                    }
                    @if (HasVisibleTile(kpiTiles, DashboardTileRegistry.AksUnhealthyPods))
                    {
                        <DashboardMetricTile AreaLabel="AKS" OpenHref="/aks" IsConfigured="@_aksConfigured" Data="@_aksData"
                                             Error="@_aksError" FallbackLabel="unhealthy pods" IsLoading="@_aksLoading"
                                             CssClass="dashboard-metric-tile--aks" />
                    }
                    @if (HasVisibleTile(kpiTiles, DashboardTileRegistry.RedisExpiringKeys))
                    {
                        <DashboardMetricTile AreaLabel="Redis" OpenHref="/redis" IsConfigured="@_redisConfigured" Data="@_redisData"
                                             Error="@_redisError" FallbackLabel="expiring < 5m" IsLoading="@_redisLoading"
                                             CssClass="dashboard-metric-tile--redis" />
                    }
                    @if (HasVisibleTile(kpiTiles, DashboardTileRegistry.PendingApprovals))
                    {
                        <DashboardMetricTile AreaLabel="Pipelines" OpenHref="/pipelines" IsConfigured="@_releasesConfigured"
                                             Data="@_releasesData" Error="@_releasesError" FallbackLabel="pending approvals"
                                             IsLoading="@_releasesLoading" CssClass="dashboard-metric-tile--pipelines" />
                    }
                </section>
            }

            <div class="dashboard-home-layout">
                <div class="dashboard-home-layout__board">
                    @if (_isCustomizing)
                    {
                        <section class="dashboard-builder" aria-label="Dashboard customization">
                            <div class="dashboard-builder__templates">
                                <div class="dashboard-builder__heading">
                                    <h2>Tile Library</h2>
                                    <button class="dashboard-reset-button" type="button" @onclick="ResetDashboardPreferencesAsync">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.ArrowCounterclockwise())" Width="16px" />
                                        Reset
                                    </button>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(_customizerMessage))
                                {
                                    <p class="dashboard-builder__message">@_customizerMessage</p>
                                }

                                <article class="dashboard-template-card dashboard-template-card--service-bus">
                                    <div>
                                        <span class="dashboard-template-card__eyebrow">Service Bus</span>
                                        <h3>Entity Watch</h3>
                                    </div>
                                    <label>
                                        <span>Namespace</span>
                                        <select class="dashboard-field" @bind="_newServiceBusNamespaceId">
                                            @foreach (var ns in serviceBusNamespaces)
                                            {
                                                <option value="@ns.Id">@ns.Label</option>
                                            }
                                        </select>
                                    </label>
                                    <label>
                                        <span>Queue or subscription path</span>
                                        <input class="dashboard-field" @bind="_newServiceBusEntityPath"
                                               placeholder="orders or topic/subscriptions/consumer" />
                                    </label>
                                    <label>
                                        <span>Title</span>
                                        <input class="dashboard-field" @bind="_newServiceBusTileTitle"
                                               placeholder="Orders backlog" />
                                    </label>
                                    <div class="dashboard-size-picker" role="group" aria-label="Service Bus entity tile size">
                                        @foreach (var size in GetSupportedTileSizes(DashboardTileRegistry.ServiceBusEntityWatch))
                                        {
                                            <button type="button" class="@GetSizeButtonClass(size, _newServiceBusTileSize)"
                                                    @onclick="() => _newServiceBusTileSize = size">
                                                @GetTileSizeLabel(size)
                                            </button>
                                        }
                                    </div>
                                    <button class="dashboard-add-button" type="button" disabled="@(serviceBusNamespaces.Count == 0)"
                                            @onclick="AddServiceBusEntityTileAsync">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Width="16px" /> Add tile
                                    </button>
                                </article>

                                <article class="dashboard-template-card dashboard-template-card--aks">
                                    <div>
                                        <span class="dashboard-template-card__eyebrow">AKS</span>
                                        <h3>Namespace Watch</h3>
                                    </div>
                                    <label>
                                        <span>Context</span>
                                        <input class="dashboard-field" @bind="_newAksContext" placeholder="current context" />
                                    </label>
                                    <label>
                                        <span>Namespace</span>
                                        <input class="dashboard-field" @bind="_newAksNamespace" placeholder="namespace" />
                                    </label>
                                    <label>
                                        <span>Title</span>
                                        <input class="dashboard-field" @bind="_newAksTileTitle"
                                               placeholder="Production namespace" />
                                    </label>
                                    <div class="dashboard-size-picker" role="group" aria-label="AKS namespace tile size">
                                        @foreach (var size in GetSupportedTileSizes(DashboardTileRegistry.AksNamespaceWatch))
                                        {
                                            <button type="button" class="@GetSizeButtonClass(size, _newAksTileSize)"
                                                    @onclick="() => _newAksTileSize = size">
                                                @GetTileSizeLabel(size)
                                            </button>
                                        }
                                    </div>
                                    <button class="dashboard-add-button" type="button" disabled="@(!_aksConfigured)"
                                            @onclick="AddAksNamespaceTileAsync">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Width="16px" /> Add tile
                                    </button>
                                </article>
                            </div>

                            <div class="dashboard-builder__layout">
                                <div class="dashboard-builder__heading">
                                    <h2>Active Dashboard</h2>
                                </div>
                                <div class="dashboard-layout-list">
                                    @foreach (var row in editorRows)
                                    {
                                        <article
                                            class="dashboard-layout-row @(row.Preference.IsVisible ? "" : "dashboard-layout-row--hidden")">
                                            <label class="dashboard-layout-row__toggle">
                                                <input type="checkbox" checked="@row.Preference.IsVisible"
                                                       @onchange="async args => await SetTileVisibilityAsync(row.Preference.TileId, args.Value is bool visible && visible)" />
                                                <span>@row.DisplayTitle</span>
                                            </label>
                                            <span class="dashboard-layout-row__meta">@row.Description</span>
                                            <div class="dashboard-size-picker dashboard-size-picker--row" role="group"
                                                 aria-label="Size for @row.DisplayTitle">
                                                @foreach (var size in GetSupportedTileSizes(row.Preference.TileId))
                                                {
                                                    <button type="button" class="@GetSizeButtonClass(size, row.Preference.Size)"
                                                            title="Use @GetTileSizeLabel(size) size"
                                                            @onclick="() => SetTileSizeAsync(row.Preference.TileId, size)">
                                                        @GetTileSizeLabel(size)
                                                    </button>
                                                }
                                            </div>
                                            <div class="dashboard-layout-row__actions">
                                                @if (IsEditableCustomTile(row.Preference))
                                                {
                                                    <button type="button"
                                                            title="@(IsEditingTile(row.Preference.TileId) ? "Cancel edit" : "Edit")"
                                                            aria-label="Edit @row.DisplayTitle"
                                                            class="@(IsEditingTile(row.Preference.TileId) ? "is-active" : "")"
                                                            @onclick="() => ToggleEditTile(row.Preference.TileId)">
                                                        <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Width="16px" />
                                                    </button>
                                                }
                                                <button type="button" title="Move up" aria-label="Move @row.DisplayTitle up"
                                                        disabled="@IsFirstTile(row.Definition.Id)"
                                                        @onclick="() => MoveTileAsync(row.Preference.TileId, -1)">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowUp())" Width="16px" />
                                                </button>
                                                <button type="button" title="Move down" aria-label="Move @row.DisplayTitle down"
                                                        disabled="@IsLastTile(row.Definition.Id)"
                                                        @onclick="() => MoveTileAsync(row.Preference.TileId, 1)">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowDown())" Width="16px" />
                                                </button>
                                                <button type="button" title="Remove" aria-label="Remove @row.DisplayTitle"
                                                        @onclick="() => RemoveTileAsync(row.Preference.TileId)">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Width="16px" />
                                                </button>
                                            </div>
                                            @if (IsEditingTile(row.Preference.TileId))
                                            {
                                                <div class="dashboard-layout-row__edit">
                                                    @if (DashboardTileRegistry.IsAksNamespaceWatch(row.Preference.TileId))
                                                    {
                                                        <label>
                                                            <span>Context</span>
                                                            <input class="dashboard-field" @bind="_editAksContext"
                                                                   placeholder="current context" />
                                                        </label>
                                                        <label>
                                                            <span>Namespace</span>
                                                            <input class="dashboard-field" @bind="_editAksNamespace" placeholder="namespace" />
                                                        </label>
                                                        <label>
                                                            <span>Title</span>
                                                            <input class="dashboard-field" @bind="_editAksTitle"
                                                                   placeholder="Production namespace" />
                                                        </label>
                                                    }
                                                    else if (DashboardTileRegistry.IsServiceBusEntityWatch(row.Preference.TileId))
                                                    {
                                                        <label>
                                                            <span>Namespace</span>
                                                            <select class="dashboard-field" @bind="_editServiceBusNamespaceId">
                                                                @foreach (var ns in GetServiceBusNamespaceOptions())
                                                                {
                                                                    <option value="@ns.Id">@ns.Label</option>
                                                                }
                                                            </select>
                                                        </label>
                                                        <label>
                                                            <span>Queue or subscription path</span>
                                                            <input class="dashboard-field" @bind="_editServiceBusEntityPath"
                                                                   placeholder="orders or topic/subscriptions/consumer" />
                                                        </label>
                                                        <label>
                                                            <span>Title</span>
                                                            <input class="dashboard-field" @bind="_editServiceBusTitle"
                                                                   placeholder="Orders backlog" />
                                                        </label>
                                                    }
                                                    <div class="dashboard-layout-row__edit-actions">
                                                        <button type="button" class="dashboard-add-button"
                                                                @onclick="() => SaveEditedTileAsync(row.Preference.TileId)">
                                                            Save
                                                        </button>
                                                        <button type="button"
                                                                @onclick="() => ToggleEditTile(row.Preference.TileId)">Cancel</button>
                                                    </div>
                                                </div>
                                            }
                                        </article>
                                    }
                                </div>
                            </div>
                        </section>
                    }

                    <section class="dashboard-canvas" aria-label="Dashboard tiles">
                        @if (boardTiles.Count == 0)
                        {
                            <EmptyState Icon="⌘" Title="No board widgets selected"
                                        Subtitle="The KPI ribbon is active, but the main board has no visible widgets yet." />
                        }
                        else
                        {
                            <div class="@GetTileGridClass(boardTiles)">
                                @foreach (var tile in boardTiles)
                                {
                                    <div class="@GetTileClass(tile)">
                                        @switch (DashboardTileRegistry.GetTemplateId(tile.Id))
                                        {
                                            case DashboardTileRegistry.Favorites:
                                                <section class="dashboard-panel dashboard-panel--workspace">
                                                    <div class="dashboard-panel__header">
                                                        <div>
                                                            <span class="dashboard-panel__eyebrow">Workspace</span>
                                                            <h3>Favorites</h3>
                                                        </div>
                                                        <strong>@pinnedItems.Count</strong>
                                                    </div>
                                                    @if (pinnedItems.Count == 0)
                                                    {
                                                        <EmptyState Icon="⌘" Title="No favorites"
                                                                    Subtitle="Save queues, topics, subscriptions, or workloads as favorites to keep them close.">
                                                            <Actions>
                                                                <a href="/service-bus">Browse Service Bus</a>
                                                                <a href="/aks">Browse AKS</a>
                                                            </Actions>
                                                        </EmptyState>
                                                    }
                                                    else
                                                    {
                                                        <div class="pinned-chips">
                                                            @foreach (var pin in pinnedItems)
                                                            {
                                                                <button class="pinned-chip" @onclick="() => NavigateToPin(pin)"
                                                                        title="@(pin.Snapshot.Resource.DisplayPath ?? pin.Snapshot.Resource.DisplayName)">
                                                                    <span class="pinned-chip-icon">@pin.Icon</span>
                                                                    <span class="pinned-chip-name">@pin.DisplayPath</span>
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                </section>
                                                break;
                                            case DashboardTileRegistry.RecentResources:
                                                <section class="dashboard-panel dashboard-panel--workspace dashboard-panel--table">
                                                    <div class="dashboard-panel__header">
                                                        <div>
                                                            <span class="dashboard-panel__eyebrow">Workspace</span>
                                                            <h3>Recent Resources</h3>
                                                        </div>
                                                        <strong>@recentItems.Count</strong>
                                                    </div>
                                                    @if (recentItems.Count == 0)
                                                    {
                                                        <EmptyState Icon="⋯" Title="No recent resources"
                                                                    Subtitle="Resources opened from the shell will appear here.">
                                                            <Actions>
                                                                <a href="/service-bus">Open Service Bus</a>
                                                                <a href="/aks">Open AKS</a>
                                                            </Actions>
                                                        </EmptyState>
                                                    }
                                                    else
                                                    {
                                                        <div class="resource-row-list">
                                                            @foreach (var item in recentItems)
                                                            {
                                                                <button class="resource-row" @onclick="() => NavigateToResource(item)"
                                                                        title="@(item.Snapshot.Resource.DisplayPath ?? item.Snapshot.Resource.DisplayName)">
                                                                    <span class="resource-row-icon">@item.Icon</span>
                                                                    <span class="resource-row-main">
                                                                        <span class="resource-row-name">@item.DisplayPath</span>
                                                                        <span class="resource-row-meta">@GetResourceAreaLabel(item) ·
                                                                            @GetResourceKindLabel(item)</span>
                                                                        </span>
                                                                        <span class="resource-row-time">@RelativeTime(item.Timestamp)</span>
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                    </section>
                                                    break;
                                case DashboardTileRegistry.OpenTabs:
                                                        <section class="dashboard-panel dashboard-panel--workspace">
                                                            <div class="dashboard-panel__header">
                                                                <div>
                                                                    <span class="dashboard-panel__eyebrow">Workspace</span>
                                                                    <h3>Open Tabs</h3>
                                                                </div>
                                                                <strong>@openTabs.Count</strong>
                                                            </div>
                                                            @if (openTabs.Count == 0)
                                                            {
                                                                <EmptyState Icon="□" Title="No restorable tabs"
                                                                            Subtitle="Open workspace tabs are restored here after they are saved in local state." />
                                                            }
                                                            else
                                                            {
                                                                <div class="open-tab-list">
                                                                    @foreach (var tab in openTabs)
                                                                    {
                                                                        <button class="open-tab-chip" @onclick="() => NavigateToTab(tab)">
                                                                            <span class="open-tab-icon">@GetAreaIcon(tab.Area)</span>
                                                                            <span class="open-tab-name">@tab.Title</span>
                                                                            <span class="open-tab-area">@ShellNavigation.ForArea(tab.Area).Label</span>
                                                                        </button>
                                                                    }
                                                                </div>
                                                            }
                                                        </section>
                                                        break;
                                                    case DashboardTileRegistry.ServiceBusDeadLetters:
                                                        <DashboardMetricTile AreaLabel="Service Bus" OpenHref="/service-bus"
                                                                             IsConfigured="@_sbConfigured" Data="@_sbData" Error="@_sbError"
                                                                             FallbackLabel="dead-lettered" IsLoading="@_sbLoading"
                                                                             CssClass="dashboard-metric-tile--service-bus" />
                                                        break;
                                                    case DashboardTileRegistry.AksUnhealthyPods:
                                                        <DashboardMetricTile AreaLabel="AKS" OpenHref="/aks" IsConfigured="@_aksConfigured"
                                                                             Data="@_aksData" Error="@_aksError" FallbackLabel="unhealthy pods" IsLoading="@_aksLoading"
                                                                             CssClass="dashboard-metric-tile--aks" />
                                                        break;
                                                    case DashboardTileRegistry.RedisExpiringKeys:
                                                        <DashboardMetricTile AreaLabel="Redis" OpenHref="/redis" IsConfigured="@_redisConfigured"
                                                                             Data="@_redisData" Error="@_redisError" FallbackLabel="expiring < 5m"
                                                                             IsLoading="@_redisLoading" CssClass="dashboard-metric-tile--redis" />
                                                        break;
                                                    case DashboardTileRegistry.PendingApprovals:
                                                        <DashboardMetricTile AreaLabel="Pipelines" OpenHref="/pipelines"
                                                                             IsConfigured="@_releasesConfigured" Data="@_releasesData" Error="@_releasesError"
                                                                             FallbackLabel="pending approvals" IsLoading="@_releasesLoading"
                                                                             CssClass="dashboard-metric-tile--pipelines" />
                                                        break;
                                                    case DashboardTileRegistry.ServiceBusEntityWatch:
                                                        var entityPreference = GetTilePreference(tile.Id);
                                                        var entityMetric = GetServiceBusEntityMetric(tile.Id);
