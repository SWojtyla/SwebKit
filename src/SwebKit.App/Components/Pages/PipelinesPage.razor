@page "/pipelines"
@page "/releases"
@inject AppStateService AppState
@inject IDevOpsClientFactory DevOpsClientFactory
@inject SwebKit.Core.Services.DemoDevOpsClient DemoClient
@inject IAppEventBus Events
@inject ReleaseRepository ReleaseRepo
@inject IConnectionStateService ConnectionState
@inject CommandRegistry Commands
@implements IDisposable

<CascadingValue Value="ActiveClient" Name="DevOpsClient">
    <div class="pipelines-shell">
        <div class="page-shell-header">
            <RoutePageHeader Area="pipelines"
                             Subtitle="Track pipeline health, release activity, and pending approvals without leaving the shell.">
                <Meta>
                    @if (IsConfigured && !_showProjectPicker)
                    {
                        <span class="shell-pill shell-pill--muted">@ScopeSummary</span>
                    }
                    @if (_pendingApprovalCount > 0)
                    {
                        <span class="shell-pill shell-pill--accent">@_pendingApprovalCount pending
                            approval@(_pendingApprovalCount == 1 ? "" : "s")</span>
                        }
                        @if (AppState.UseDemoData)
                        {
                            <span class="shell-pill shell-pill--warning">Demo mode</span>
                        }
                    </Meta>
                    <Actions>
                        @if (IsConfigured && !_showProjectPicker)
                        {
                            <button class="pipelines-scope-change-btn" @onclick="@(() => _showProjectPicker = true)">
                                Change scope
                            </button>
                        }
                        <a class="page-header-action-btn" href="/settings?section=devops">Settings</a>
                    </Actions>
                </RoutePageHeader>
            </div>

            @if (!IsConfigured)
            {
                <div class="pipelines-empty-state-wrap">
                    <EmptyState Icon="🚀" Title="Azure DevOps is not configured"
                                Subtitle="Connect an organization and project in Settings before opening pipelines, releases, and approvals.">
                        <Actions>
                            <a href="/settings?section=devops">Open DevOps settings</a>
                        </Actions>
                    </EmptyState>
                </div>
            }
            else if (_showProjectPicker)
            {
                <ProjectPicker CurrentPinned="EffectivePinnedProjects"
                               AllowCancel="@(EffectivePinnedProjects.Count > 0 || AppState.UseDemoData)" IsDemoMode="AppState.UseDemoData"
                               OnConfirmed="OnProjectsPinned" OnCancelled="@(() => _showProjectPicker = false)" />
            }
            else
            {
                @* ── Tab bar ── *@
                <div class="pill-tab-bar">
                    <button class="pill-tab @(ActiveTab == "pipelines" ? "active" : "")"
                            @onclick="@(() => SetTab("pipelines"))">Pipelines</button>
                    <button class="pill-tab @(ActiveTab == "activity" ? "active" : "")"
                            @onclick="@(() => SetTab("activity"))">Activity</button>
                    <button class="pill-tab @(ActiveTab == "releases" ? "active" : "")"
                            @onclick="@(() => SetTab("releases"))">Releases</button>
                    <button class="pill-tab @(ActiveTab == "approvals" ? "active" : "")"
                            @onclick="@(() => SetTab("approvals"))">
                        Approvals
                        @if (_pendingApprovalCount > 0)
                        {
                            <span class="pill-badge">@_pendingApprovalCount</span>
                        }
                    </button>
                </div>

                <div class="pipelines-tab-content">
                    @switch (ActiveTab)
                    {
                        case "pipelines":
                            <div class="pipeline-split">
                                <div class="pipeline-split__left @(_leftCollapsed ? "pipeline-split__left--collapsed" : "")">
                                    <PipelineTree SelectedProject="_selectedProject" SelectedPipeline="_selectedPipeline"
                                                  OnPipelineSelected="OnPipelineSelected" Collapsed="_leftCollapsed"
                                                  OnToggleCollapse="@(() => { _leftCollapsed = !_leftCollapsed; })"
                                                  PinnedProjects="EffectivePinnedProjects" />
                                </div>
                                <div class="pipeline-split__right">
                                    @if (_selectedPipeline is not null && _selectedProject is not null)
                                    {
                                        <PipelineDetail Project="_selectedProject" Pipeline="_selectedPipeline" />
                                    }
                                    else
                                    {
                                        <PipelinesOverview OnPipelineSelected="OnPipelineSelected"
                                                           PinnedProjects="EffectivePinnedProjects" />
                                    }
                                </div>
                            </div>
                            break;

                        case "activity":
                            <PipelineActivity PinnedProjects="EffectivePinnedProjects" />
                            break;

                        case "releases":
                            <div class="pipeline-split">
                                <div class="pipeline-split__left pipeline-split__left--releases">
                                    <ReleaseList Releases="EffectiveReleases" SelectedRelease="_selectedRelease"
                                                 IsDemoMode="AppState.UseDemoData" OnCreate="CreateRelease" OnSelect="OnReleaseSelected" />
                                </div>
                                <div class="pipeline-split__right">
                                    <ReleaseDetail Release="_selectedRelease" IsDemoOnly="IsSelectedReleaseDemoOnly"
                                                   OnEditRelease="EditRelease" OnEditComponents="EditComponents"
                                                   OnDeleteRelease="ConfirmDeleteRelease" />
                                </div>
                            </div>
                            break;

                        case "approvals":
                            <div class="pipelines-approvals-wrap">
                                <ApprovalCenter OnCountChanged="OnApprovalCountChanged" PinnedProjects="EffectivePinnedProjects" />
                            </div>
                            break;
                    }
                </div>
            }
        </div>

        @* ── Modals ── *@
        <ReleaseEditor Visible="ShowReleaseEditor" Release="EditingRelease" OnSaved="OnReleaseSaved"
                       OnCancel="@(() => ShowReleaseEditor = false)" />

        <ComponentScopeEditor Visible="ShowComponentEditor" Release="_selectedRelease" OnSaved="OnComponentsSaved"
                              OnClose="@(() => ShowComponentEditor = false)" />

        @if (ShowDeleteConfirm && _selectedRelease is not null)
        {
            <div class="releases-delete-overlay">
                <div class="releases-delete-dialog">
                    <h3 style="margin:0 0 8px; font-size:var(--font-size-lg);">Delete Release</h3>
                    <p class="text-muted text-sm" style="margin:0 0 16px;">
                        Are you sure you want to delete <strong>@_selectedRelease.Name</strong>? This cannot be undone.
                    </p>
                    <div style="display:flex; gap:8px; justify-content:flex-end;">
                        <button @onclick="@(() => ShowDeleteConfirm = false)"
                                style="padding:6px 16px; cursor:pointer; background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-sm); color:var(--color-text-muted);">Cancel</button>
                        <button @onclick="DeleteReleaseAsync"
                                style="padding:6px 16px; background:var(--color-error); color:white; border:none; border-radius:var(--radius-sm); cursor:pointer;">Delete</button>
                    </div>
                </div>
            </div>
        }
    </CascadingValue>

    <style>
        .releases-delete-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: var(--z-modal);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .releases-delete-dialog {
            background: var(--color-surface-2);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            padding: 24px;
            max-width: 400px;
            width: 90%;
            box-shadow: var(--shadow-lg);
        }
    </style>

@code {
    private string ActiveTab = "pipelines";
    private int _pendingApprovalCount;
    private bool _showProjectPicker;
    private bool _hasValidDevOpsConfig = true;
    private List<string> _demoPinnedProjects = [];
    private CancellationTokenSource _cts = new();
    private IDevOpsClient? _realClient;

    // Pipelines tab state
    private AdoProject? _selectedProject;
    private AdoPipeline? _selectedPipeline;
    private bool _leftCollapsed;

    // Releases tab state
    private ReleaseRecord? _selectedRelease;

    // Modal state
    private bool ShowReleaseEditor;
    private ReleaseRecord? EditingRelease;
    private bool ShowComponentEditor;
    private bool ShowDeleteConfirm;

    private IDevOpsClient ActiveClient => AppState.UseDemoData ? DemoClient : _realClient ?? DemoClient;

    private bool IsConfigured =>
        AppState.UseDemoData ||
        (_hasValidDevOpsConfig
         && AppState.Config.DevOpsConfig is not null
         && !string.IsNullOrEmpty(AppState.Config.DevOpsConfig.Organization));

    private List<string> PinnedProjects =>
        AppState.Config.DevOpsConfig?.PinnedProjects ?? [];

    private string ScopeSummary => EffectivePinnedProjects.Count == 0
        ? "All projects"
        : $"{EffectivePinnedProjects.Count} project{(EffectivePinnedProjects.Count == 1 ? string.Empty : "s")}";

    /// <summary>In demo mode uses in-memory selection; in real mode uses persisted PinnedProjects.</summary>
    private List<string> EffectivePinnedProjects =>
        AppState.UseDemoData ? _demoPinnedProjects : PinnedProjects;

    private IReadOnlyList<ReleaseRecord> EffectiveReleases =>
        AppState.UseDemoData
            ? SwebKit.Core.Services.DemoDevOpsClient.DemoReleases
            : (IReadOnlyList<ReleaseRecord>)ReleaseRepo.AllReleases;

    private bool IsSelectedReleaseDemoOnly =>
        _selectedRelease is not null
        && AppState.UseDemoData
        && ReleaseRepo.GetRelease(_selectedRelease.Id) is null;

    protected override async Task OnInitializedAsync()
    {
        // PERF-9: Load AppState and release repo in parallel
        var loadTask = Task.WhenAll(
            AppState.WhenInitializedAsync(),
            ReleaseRepo.LoadAsync()
        );

        // PERF-16: Stop waiting if the component is disposed (user navigated away)
        try
        {
            await loadTask.WaitAsync(_cts.Token);
        }
        catch (OperationCanceledException) { return; } // CS-2

        if (!AppState.UseDemoData && IsConfigured)
        {
            var config = AppState.Config.DevOpsConfig;
            if (config is not null)
            {
                try
                {
                    _realClient = DevOpsClientFactory.Create(config);
                }
                catch (InvalidOperationException)
                {
                    _hasValidDevOpsConfig = false;
                    _realClient = null;
                }
            }
        }

        if (IsConfigured)
        {
            _selectedRelease = EffectiveReleases.OrderByDescending(r => r.CreatedAt).FirstOrDefault();
            ConnectionState.SetConnected("pipelines");
            // Show project picker when no projects are pinned (real mode only)
            _showProjectPicker = !AppState.UseDemoData && PinnedProjects.Count == 0;
        }
        else
        {
            ConnectionState.SetNotConfigured("pipelines");
        }
    }

    protected override void OnInitialized()
    {
        Events.Subscribe<RefreshRequestedEvent>(OnRefresh);
        RegisterCommands();
    }

    private void RegisterCommands()
    {
        Commands.Register(new AppCommand
        {
            Id = "releases-refresh",
            Label = "Refresh Releases",
            Category = "Releases",
            AreaScope = "releases",
            Execute = async () => { await ReleaseRepo.LoadAsync(); await InvokeAsync(StateHasChanged); }
        });
        Commands.Register(new AppCommand
        {
            Id = "releases-new",
            Label = "New Release",
            Category = "Releases",
            AreaScope = "releases",
            IsAvailable = () => IsConfigured,
            Execute = () => { CreateRelease(); return Task.CompletedTask; }
        });
        Commands.Register(new AppCommand
        {
            Id = "releases-edit",
            Label = "Edit Release",
            Category = "Releases",
            AreaScope = "releases",
            IsAvailable = () => _selectedRelease is not null && !IsSelectedReleaseDemoOnly,
            Execute = () => { EditRelease(); return Task.CompletedTask; }
        });
        Commands.Register(new AppCommand
        {
            Id = "releases-approvals",
            Label = "Open Approval Center",
            Category = "Releases",
            AreaScope = "releases",
            IsAvailable = () => IsConfigured,
            Execute = () => { SetTab("approvals"); return Task.CompletedTask; }
        });
    }

    private async Task OnProjectsPinned(List<string> pinned)
    {
        if (AppState.UseDemoData)
        {
            _demoPinnedProjects = pinned;
        }
        else
        {
            if (AppState.Config.DevOpsConfig is not null)
                AppState.Config.DevOpsConfig.PinnedProjects = pinned;
            await AppState.SaveConfigAsync();
        }
        _showProjectPicker = false;
    }

    private void OnPipelineSelected((AdoProject Project, AdoPipeline Pipeline) sel)
    {
        _selectedProject = sel.Project;
        _selectedPipeline = sel.Pipeline;
    }

    private void OnReleaseSelected(ReleaseRecord release) => _selectedRelease = release;

    private void OnApprovalCountChanged(int count)
    {
        _pendingApprovalCount = count;
        InvokeAsync(StateHasChanged);
    }

    private void CreateRelease() { EditingRelease = null; ShowReleaseEditor = true; }
    private void EditRelease() { EditingRelease = _selectedRelease; ShowReleaseEditor = true; }
    private void EditComponents() => ShowComponentEditor = true;
    private void ConfirmDeleteRelease() => ShowDeleteConfirm = true;

    private async Task DeleteReleaseAsync()
    {
        ShowDeleteConfirm = false;
        if (_selectedRelease is null) return;
        await ReleaseRepo.RemoveReleaseAsync(_selectedRelease.Id);
        _selectedRelease = ReleaseRepo.AllReleases.OrderByDescending(r => r.CreatedAt).FirstOrDefault();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnReleaseSaved(ReleaseRecord release)
    {
        ShowReleaseEditor = false;
        _selectedRelease = ReleaseRepo.GetRelease(release.Id) ?? release;
        StateHasChanged();
    }

    private async Task OnComponentsSaved()
    {
        ShowComponentEditor = false;
        if (_selectedRelease is not null)
            _selectedRelease = ReleaseRepo.GetRelease(_selectedRelease.Id) ?? _selectedRelease;
        StateHasChanged();
    }

    private void OnRefresh(RefreshRequestedEvent e)
    {
        if (e.Area is "pipelines" or "releases")
        {
            _ = InvokeAsync(async () =>
            {
                if (!AppState.UseDemoData)
                {
                    await ReleaseRepo.LoadAsync();
                }

                StateHasChanged();
            });
        }
    }

    private void SetTab(string tab) => ActiveTab = tab;

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        Events.Unsubscribe<RefreshRequestedEvent>(OnRefresh);
        foreach (var id in new[] { "releases-refresh", "releases-new", "releases-edit", "releases-approvals" })
            Commands.Unregister(id);
    }
}
