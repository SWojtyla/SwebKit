@page "/releases"
@inject AppStateService AppState
@inject SwebKit.DevOps.DevOpsClient RealDevOpsClient
@inject SwebKit.Core.Services.DemoDevOpsClient DemoClient
@inject IAppEventBus Events
@inject ReleaseRepository ReleaseRepo
@inject IConnectionStateService ConnectionState
@implements IDisposable

<CascadingValue Value="ActiveClient" Name="DevOpsClient">
    <div class="page-content">
        <div class="page-header">
            <div style="display:flex; align-items:center; gap:12px;">
                <h2 class="page-title">Releases</h2>

                @if (IsConfigured && EffectiveReleases.Count > 0)
                {
                    <div class="release-selector-wrap">
                        <select class="release-selector" value="@SelectedReleaseId" @onchange="OnReleaseSelected">
                            @foreach (var r in EffectiveReleases.OrderByDescending(r => r.CreatedAt))
                            {
                                <option value="@r.Id">@r.Name @StatusLabel(r.Status)</option>
                            }
                        </select>
                    </div>
                }
            </div>

            @if (IsConfigured)
            {
                <div style="display:flex; gap:8px;">
                    @if (SelectedRelease is not null && !IsSelectedReleaseDemoOnly)
                    {
                        <FluentButton Appearance="Appearance.Lightweight" @onclick="EditComponents">Edit Components
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Lightweight" @onclick="EditRelease">Edit Release</FluentButton>
                        <FluentButton Appearance="Appearance.Lightweight" @onclick="ConfirmDeleteRelease"
                                      style="color:var(--color-error);">Delete</FluentButton>
                    }
                    <FluentButton Appearance="Appearance.Accent" @onclick="CreateRelease">New Release</FluentButton>
                </div>
            }
        </div>

        @if (!IsConfigured)
        {
            <div class="text-muted">
                <p>Azure DevOps is not configured for this project.</p>
                <p>Go to <strong>Settings</strong> and configure the <strong>Azure DevOps</strong> section to get started.</p>
            </div>
        }
        else if (ErrorMessage is not null)
        {
            <ErrorCallout Message="@ErrorMessage" OnRetry="LoadAsync" />
        }
        else
        {
            @* ── Tab navigation ── *@
            <div class="pill-tab-bar">
                <button class="pill-tab @(ActiveTab == "board" ? "active" : "")" @onclick="@(() => SetTab("board"))">Release Board</button>
                <button class="pill-tab @(ActiveTab == "approvals" ? "active" : "")" @onclick="@(() => SetTab("approvals"))">
                    Approval Center
                    @if (PendingApprovalCount > 0)
                    {
                        <span class="pill-badge">@PendingApprovalCount</span>
                    }
                </button>
                <button class="pill-tab @(ActiveTab == "pipelines" ? "active" : "")" @onclick="@(() => SetTab("pipelines"))">Deployments</button>
                <button class="pill-tab @(ActiveTab == "tags" ? "active" : "")" @onclick="@(() => SetTab("tags"))">Tag Manager</button>
            </div>

            @switch (ActiveTab)
            {
                case "board":
                    <ReleaseBoard Release="SelectedRelease" />
                    break;
                case "approvals":
                    <ApprovalCenter Release="SelectedRelease" />
                    break;
                case "pipelines":
                    <PipelineTriggerHub Release="SelectedRelease" />
                    break;
                case "tags":
                    <TagManager Release="SelectedRelease" />
                    break;
            }
        }
    </div>

    @* ── Modals ── *@
    <ReleaseEditor Visible="ShowReleaseEditor"               Release="EditingRelease"               OnSaved="OnReleaseSaved"
                   OnCancel="@(() => { ShowReleaseEditor = false; })" />

    <ComponentScopeEditor Visible="ShowComponentEditor"                      Release="SelectedRelease"                      OnSaved="OnComponentsSaved"
                          OnClose="@(() => { ShowComponentEditor = false; })" />

    @if (ShowDeleteConfirm && SelectedRelease is not null)
    {
        <div class="releases-delete-overlay">
            <div class="releases-delete-dialog">
                <h3 style="margin:0 0 8px; font-size:var(--font-size-lg);">Delete Release</h3>
                <p class="text-muted text-sm" style="margin:0 0 16px;">
                    Are you sure you want to delete <strong>@SelectedRelease.Name</strong>? This cannot be undone.
                </p>
                <div style="display:flex; gap:8px; justify-content:flex-end;">
                    <button @onclick="@(() => ShowDeleteConfirm = false)"
                            style="padding:6px 16px; cursor:pointer; background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-sm); color:var(--color-text-muted);">Cancel</button>
                    <button @onclick="DeleteReleaseAsync"
                            style="padding:6px 16px; background:var(--color-error); color:white; border:none; border-radius:var(--radius-sm); cursor:pointer;">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    }
</CascadingValue>

<style>
    .releases-delete-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        z-index: var(--z-modal);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .releases-delete-dialog {
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: 24px;
        max-width: 400px;
        width: 90%;
        box-shadow: var(--shadow-lg);
    }
</style>

@code {
    private string ActiveTab = "board";
    private string? ErrorMessage;
    private int PendingApprovalCount;
    private string? SelectedReleaseId;
    private ReleaseRecord? SelectedRelease;

    // Modal state
    private bool ShowReleaseEditor;
    private ReleaseRecord? EditingRelease;
    private bool ShowComponentEditor;
    private bool ShowDeleteConfirm;

    private IDevOpsClient ActiveClient => AppState.UseDemoData
        ? DemoClient
        : RealDevOpsClient;

    private bool IsConfigured =>
        AppState.UseDemoData ||
        (AppState.Config.DevOpsConfig is not null
        && !string.IsNullOrEmpty(AppState.Config.DevOpsConfig.Organization));

    // In demo mode always surface the built-in demo releases so the board and
    // approval center show realistic synthetic content, not the user's real releases.
    private IReadOnlyList<ReleaseRecord> EffectiveReleases =>
        AppState.UseDemoData
            ? SwebKit.Core.Services.DemoDevOpsClient.DemoReleases
            : (IReadOnlyList<ReleaseRecord>)ReleaseRepo.AllReleases;

    // True when the selected release is one of the built-in demo releases
    // (not persisted in the repo) — in that case editing is suppressed.
    private bool IsSelectedReleaseDemoOnly =>
        SelectedRelease is not null
        && AppState.UseDemoData
        && ReleaseRepo.GetRelease(SelectedRelease.Id) is null;

    protected override async Task OnInitializedAsync()
    {
        await AppState.InitializeAsync();
        await ReleaseRepo.LoadAsync();

        if (!AppState.UseDemoData && IsConfigured)
        {
            var config = AppState.Config.DevOpsConfig;
            if (config is not null)
                RealDevOpsClient.Configure(config);
        }

        if (IsConfigured)
        {
            var latest = EffectiveReleases.OrderByDescending(r => r.CreatedAt).FirstOrDefault();
            if (latest is not null)
            {
                SelectedReleaseId = latest.Id.ToString();
                SelectedRelease = latest;
            }

            await LoadAsync();
            ConnectionState.SetConnected("releases");
        }
        else
        {
            ConnectionState.SetNotConfigured("releases");
        }
    }

    protected override void OnInitialized()
    {
        Events.Subscribe<RefreshRequestedEvent>(OnRefresh);
    }

    private async Task LoadAsync()
    {
        ErrorMessage = null;
        try
        {
            // Count pending approvals from the selected release's components
            var totalApprovals = 0;
            var scoped = SelectedRelease?.Components
                .Where(c => c.InScope && c.PipelineId > 0).ToList() ?? [];

            foreach (var comp in scoped)
            {
                try
                {
                    var runs = await ActiveClient.GetPipelineRunsAsync(comp.ProjectName, comp.PipelineId, top: 1);
                    var latest = runs.FirstOrDefault();
                    if (latest is null || latest.State == "completed") continue;

                    var waitingStages = await ActiveClient.GetWaitingStagesAsync(comp.ProjectName, latest.Id);
                    totalApprovals += waitingStages.Count;
                }
                catch { }
            }
            PendingApprovalCount = totalApprovals;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private void OnReleaseSelected(ChangeEventArgs e)
    {
        SelectedReleaseId = e.Value?.ToString();
        if (Guid.TryParse(SelectedReleaseId, out var id))
        {
            SelectedRelease = ReleaseRepo.GetRelease(id)
                ?? EffectiveReleases.FirstOrDefault(r => r.Id == id);
        }
    }

    private void ConfirmDeleteRelease()
    {
        ShowDeleteConfirm = true;
    }

    private async Task DeleteReleaseAsync()
    {
        ShowDeleteConfirm = false;
        if (SelectedRelease is null) return;

        var idToDelete = SelectedRelease.Id;
        await ReleaseRepo.RemoveReleaseAsync(idToDelete);

        // Select the next available release after deletion
        var next = ReleaseRepo.AllReleases.OrderByDescending(r => r.CreatedAt).FirstOrDefault();
        SelectedRelease = next;
        SelectedReleaseId = next?.Id.ToString();

        PendingApprovalCount = 0;
        if (SelectedRelease is not null)
            await LoadAsync();

        StateHasChanged();
    }

    private void CreateRelease()
    {
        EditingRelease = null;
        ShowReleaseEditor = true;
    }

    private void EditRelease()
    {
        EditingRelease = SelectedRelease;
        ShowReleaseEditor = true;
    }

    private void EditComponents()
    {
        ShowComponentEditor = true;
    }

    private async Task OnReleaseSaved(ReleaseRecord release)
    {
        ShowReleaseEditor = false;
        // Re-read to ensure repo state is in sync
        SelectedRelease = ReleaseRepo.GetRelease(release.Id) ?? release;
        SelectedReleaseId = SelectedRelease.Id.ToString();
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OnComponentsSaved()
    {
        ShowComponentEditor = false;
        // Re-read the release from the repo to ensure we have the latest state.
        // Demo-only releases are not in the repo; keep the current reference.
        if (SelectedRelease is not null)
            SelectedRelease = ReleaseRepo.GetRelease(SelectedRelease.Id) ?? SelectedRelease;
        await LoadAsync();
        StateHasChanged();
    }

    private void OnRefresh(RefreshRequestedEvent e)
    {
        if (e.Area == "releases")
        {
            InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    private void SetTab(string tab) => ActiveTab = tab;

    private string TabClass(string tab) =>
        $"release-tab{(ActiveTab == tab ? " active" : "")}";

    private static string StatusLabel(ReleaseStatus status) => status switch
    {
        ReleaseStatus.Draft => "[Draft]",
        ReleaseStatus.InProgress => "[In Progress]",
        ReleaseStatus.Completed => "[Completed]",
        _ => ""
    };

    public void Dispose()
    {
        Events.Unsubscribe<RefreshRequestedEvent>(OnRefresh);
    }
}