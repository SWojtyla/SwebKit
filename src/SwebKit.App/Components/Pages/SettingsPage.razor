@page "/settings"
@inject AppStateService AppState
@inject ICredentialStore CredentialStore

<div style="padding:20px; max-width:760px; overflow-y:auto; height:100%;">
    <h2 style="margin:0 0 16px; font-size:18px;">Settings</h2>

    <FluentAccordion>
        <FluentAccordionItem Heading="Service Bus — Pinned Entities">
            <ServiceBusConfigForm Environment="AppState.Config" OnSaved="SaveAsync" />
        </FluentAccordionItem>
        <FluentAccordionItem Heading="AKS / Kubernetes">
            <AksConfigForm Environment="AppState.Config" OnSaved="SaveAsync" />
        </FluentAccordionItem>
        <FluentAccordionItem Heading="Redis">
            <RedisConfigForm Environment="AppState.Config" OnSaved="SaveAsync" />
        </FluentAccordionItem>
        <FluentAccordionItem Heading="Azure DevOps (Releases)">
            <DevOpsConfigForm OnSaved="SaveAsync" />
        </FluentAccordionItem>
        <FluentAccordionItem Heading="Storage (Azure Blob)">
            <StorageConfigForm Environment="AppState.Config" CredentialStore="CredentialStore" OnSaved="SaveAsync" />
        </FluentAccordionItem>
    </FluentAccordion>

    @if (SavedMessage is not null)
    {
        <div style="margin-top:12px; padding:8px 12px; background:rgba(67,160,71,0.2); border:1px solid var(--color-success); border-radius:4px; font-size:12px; color:var(--color-success);">
            @SavedMessage
        </div>
    }
</div>

@code {
    private string? SavedMessage;

    private async Task SaveAsync()
    {
        await AppState.SaveConfigAsync();
        SavedMessage = "Settings saved.";
        await Task.Delay(3000);
        SavedMessage = null;
        StateHasChanged();
    }
}
