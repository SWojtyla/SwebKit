@page "/settings"
@inject AppStateService AppState
@inject ICredentialStore CredentialStore
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="settings-shell">

    @* ── Left navigation sidebar ── *@
    <nav class="settings-nav">
        <button class="settings-nav-item @(_active == "appearance" ? "active" : "")"
                @onclick="@(() => _active = "appearance")">
            <FluentIcon Value="@(new Icons.Regular.Size20.PaintBrush())" Width="18px" />
            Appearance
        </button>
        <button class="settings-nav-item @(_active == "servicebus" ? "active" : "")"
                @onclick="@(() => _active = "servicebus")">
            <FluentIcon Value="@(new Icons.Regular.Size20.ArrowSwap())" Width="18px" />
            Service Bus
        </button>
        <button class="settings-nav-item @(_active == "aks" ? "active" : "")" @onclick="@(() => _active = "aks")">
            <FluentIcon Value="@(new Icons.Regular.Size20.Cloud())" Width="18px" />
            AKS
        </button>
        <button class="settings-nav-item @(_active == "redis" ? "active" : "")" @onclick="@(() => _active = "redis")">
            <FluentIcon Value="@(new Icons.Regular.Size20.Database())" Width="18px" />
            Redis
        </button>
        <button class="settings-nav-item @(_active == "devops" ? "active" : "")" @onclick="@(() => _active = "devops")">
            <FluentIcon Value="@(new Icons.Regular.Size20.Rocket())" Width="18px" />
            DevOps
        </button>
        <button class="settings-nav-item @(_active == "storage" ? "active" : "")"
                @onclick="@(() => _active = "storage")">
            <FluentIcon Value="@(new Icons.Regular.Size20.Folder())" Width="18px" />
            Storage
        </button>
        <button class="settings-nav-item @(_active == "observability" ? "active" : "")"
                @onclick="@(() => _active = "observability")">
            <FluentIcon Value="@(new Icons.Regular.Size20.DataTrending())" Width="18px" />
            Observability
        </button>
    </nav>

    @* ── Right content well ── *@
    <div class="settings-content">
        @if (IsDirty)
        {
            <div class="settings-unsaved-banner" role="status">
                <FluentIcon Value="@(new Icons.Regular.Size20.Warning())" Width="16px" />
                Unsaved changes
            </div>
        }

        @switch (_active)
        {
            case "appearance":
                <h3 class="page-title" style="margin-bottom:var(--spacing-lg);">Appearance</h3>
                <AppearanceSettings CurrentTheme="@_layout?.CurrentTheme" OnThemeChanged="ApplyThemeAsync" />

                <div class="settings-field-group" style="margin-top:var(--spacing-xl);">
                    <label class="settings-label">Production environment</label>
                    <p class="settings-hint">
                        Mark this environment as production. Destructive operations (e.g. DLQ resubmit/delete) will show
                        an extra confirmation step requiring you to type CONFIRM.
                    </p>
                    <FluentCheckbox Value="@AppState.Config.IsProduction"
                                    ValueChanged="@(async (bool v) => { AppState.Config.IsProduction = v; await SaveAsync(); })">
                        This is a production environment
                    </FluentCheckbox>
                </div>
                break;

            case "servicebus":
                <h3 class="page-title" style="margin-bottom:var(--spacing-lg);">Service Bus</h3>
                <ServiceBusConfigForm Environment="AppState.Config" OnSaved="SaveAsync" />
                break;

            case "aks":
                <h3 class="page-title" style="margin-bottom:var(--spacing-lg);">AKS / Kubernetes</h3>
                <AksConfigForm Environment="AppState.Config" OnSaved="SaveAsync" />
                break;

            case "redis":
                <h3 class="page-title" style="margin-bottom:var(--spacing-lg);">Redis</h3>
                <RedisConfigForm Environment="AppState.Config" OnSaved="SaveAsync" />
                break;

            case "devops":
                <h3 class="page-title" style="margin-bottom:var(--spacing-lg);">Azure DevOps (Releases)</h3>
                <DevOpsConfigForm OnSaved="SaveAsync" />
                break;

            case "storage":
                <h3 class="page-title" style="margin-bottom:var(--spacing-lg);">Storage (Azure Blob)</h3>
                <StorageConfigForm Environment="AppState.Config" CredentialStore="CredentialStore" OnSaved="SaveAsync" />
                break;

            case "observability":
                <h3 class="page-title" style="margin-bottom:var(--spacing-lg);">Observability</h3>
                <div class="settings-info-card">
                    <div class="settings-info-icon">🔑</div>
                    <div>
                        <div class="settings-info-title">No credentials to configure</div>
                        <p class="settings-info-body">
                            The Observability tab connects to Azure Application Insights using
                            <strong>DefaultAzureCredential</strong> — the same identity your Azure CLI session uses.
                            No secrets or connection strings are stored here.
                        </p>
                        <p class="settings-info-body">
                            If you can run <code class="settings-info-code">az account show</code> in a terminal and
                            see your account, you're ready. SwebKit will automatically discover every Application
                            Insights resource you have read access to across all your subscriptions.
                        </p>
                        <p class="settings-info-body">
                            <strong>Not seeing your resources?</strong> Run <code class="settings-info-code">az login</code>
                            (or <code class="settings-info-code">az login --tenant &lt;tenant-id&gt;</code> if you work
                            across multiple tenants) and reopen the Observability tab.
                        </p>
                    </div>
                </div>

                @if (AppState.Config.ObservabilityConfig is { } obsCfg)
                {
                    <div class="settings-field-group" style="margin-top:var(--spacing-xl);">
                        <label class="settings-label">Max rows per query</label>
                        <p class="settings-hint">
                            Caps the number of rows returned by any KQL query. Lower values reduce Azure Monitor query costs.
                            Range: 100 – 5000.
                        </p>
                        <input class="settings-input" type="number" min="100" max="5000" value="@obsCfg.MaxRowsPerQuery"
                               @onchange="async e => { obsCfg.MaxRowsPerQuery = Math.Clamp(int.TryParse(e.Value?.ToString(), out var v) ? v : 500, 100, 5000); await SaveAsync(); }" />
                    </div>
                }
                break;
        }

        @if (_savedMessage is not null)
        {
            <div class="settings-saved-banner">@_savedMessage</div>
        }
    </div>

</div>

@code {
    [CascadingParameter(Name = "Layout")] private MainLayout? _layout { get; set; }

    private string _active = "appearance";
    private string? _savedMessage;
    private string _configSnapshot = string.Empty;
    private IDisposable? _navGuard;

    private bool IsDirty => _configSnapshot.Length > 0
        && _configSnapshot != CurrentConfigJson();

    protected override void OnInitialized()
    {
        _configSnapshot = CurrentConfigJson();
        _navGuard = Nav.RegisterLocationChangingHandler(OnLocationChanging);
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (!IsDirty)
            return;

        var leave = await JS.InvokeAsync<bool>("confirm",
            "You have unsaved changes. Leave this page?");
        if (!leave)
            context.PreventNavigation();
    }

    private string CurrentConfigJson() =>
        System.Text.Json.JsonSerializer.Serialize(AppState.Config);

    private async Task SaveAsync()
    {
        await AppState.SaveConfigAsync();
        _configSnapshot = CurrentConfigJson();
        _savedMessage = "Settings saved.";
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        _savedMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyThemeAsync(string theme)
    {
        if (_layout is not null)
            await _layout.SetThemeAsync(theme);
    }

    public void Dispose()
    {
        _navGuard?.Dispose();
    }
}
