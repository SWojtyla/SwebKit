@page "/settings"
@inject AppStateService AppState
@inject ICredentialStore CredentialStore

<div style="padding:20px; max-width:760px; overflow-y:auto; height:100%;">
    <h2 style="margin:0 0 16px; font-size:18px;">Settings</h2>

    @if (AppState.CurrentProject is null)
    {
        <div style="color:var(--color-text-muted);">Select a project first to configure environments.</div>
    }
    else
    {
        <div style="margin-bottom:16px;">
            <h3 style="font-size:14px; margin:0 0 8px;">@AppState.CurrentProject.Name</h3>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                @foreach (var env in AppState.CurrentProject.Environments)
                {
                    <button style="padding:4px 12px; border-radius:4px; cursor:pointer; background:@(env.Id == AppState.CurrentEnvironment?.Id ? "var(--color-accent)" : "var(--color-surface)"); color:white; border:1px solid var(--color-border);"
                            @onclick="() => AppState.SelectEnvironmentAsync(env.Id)">
                        @env.Name @(env.IsProduction ? "⚠" : "")
                    </button>
                }
            </div>
        </div>

        @if (AppState.CurrentEnvironment is not null)
        {
            var env = AppState.CurrentEnvironment;
            <FluentAccordion>
                <FluentAccordionItem Heading="Service Bus — Pinned Entities">
                    <ServiceBusConfigForm Environment="env" OnSaved="SaveAsync" />
                </FluentAccordionItem>
                <FluentAccordionItem Heading="Observability (App Insights / OTLP)">
                    <ObservabilityConfigForm Environment="env" CredentialStore="CredentialStore" OnSaved="SaveAsync" />
                </FluentAccordionItem>
                <FluentAccordionItem Heading="AKS / Kubernetes">
                    <AksConfigForm Environment="env" OnSaved="SaveAsync" />
                </FluentAccordionItem>
                <FluentAccordionItem Heading="Redis">
                    <RedisConfigForm Environment="env" OnSaved="SaveAsync" />
                </FluentAccordionItem>
                <FluentAccordionItem Heading="Azure DevOps (Releases)">
                    <DevOpsConfigForm OnSaved="SaveAsync" />
                </FluentAccordionItem>
            </FluentAccordion>
        }
    }

    @if (SavedMessage is not null)
    {
        <div style="margin-top:12px; padding:8px 12px; background:rgba(67,160,71,0.2); border:1px solid var(--color-success); border-radius:4px; font-size:12px; color:var(--color-success);">
            @SavedMessage
        </div>
    }
</div>

@code {
    private string? SavedMessage;

    private async Task SaveAsync()
    {
        await AppState.UpdateProjectAsync(AppState.CurrentProject!);
        SavedMessage = "Settings saved.";
        await Task.Delay(3000);
        SavedMessage = null;
        StateHasChanged();
    }
}
