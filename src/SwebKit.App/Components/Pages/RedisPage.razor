    // ── RDS-12: Export keys to JSON ──

    private async Task ExportKeysToJsonAsync()
    {
        if (Client is null || Keys.Count == 0) return;

        IsLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var data = new Dictionary<string, object?>();
            foreach (var key in Keys)
            {
                try
                {
                    var info = await Client.GetKeyInfoAsync(key);
                    object? value = info.Type switch
                    {
                        "string" => await Client.GetKeyValueAsync(key),
                        "hash" => (await Client.GetHashFieldsAsync(key)).ToDictionary(f => f.Field, f => f.Value),
                        "list" => await Client.GetListItemsAsync(key),
                        "set" => await Client.GetSetMembersAsync(key),
                        "zset" => (await Client.GetSortedSetMembersAsync(key))
                                    .Select(e => new { e.Member, e.Score }).ToList() as object,
                        _ => null
                    };
                    data[key] = value;
                }
                catch
                {
                    data[key] = "<error reading key>";
                }
            }

            var json = System.Text.Json.JsonSerializer.Serialize(data,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            var downloads = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            Directory.CreateDirectory(downloads);
            var fileName = $"redis-export-{DateTime.Now:yyyyMMdd-HHmmss}.json";
            var filePath = Path.Combine(downloads, fileName);
            await File.WriteAllTextAsync(filePath, json);
            Notifications.ShowSuccess("Export complete", filePath);
        }
        catch (OperationCanceledException) { throw; } // CS-2
        catch (Exception ex)
        {
            Notifications.ShowError("Export failed", ex: ex);
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

