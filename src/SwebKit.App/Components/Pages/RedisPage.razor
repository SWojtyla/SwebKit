    private void DisposeClient()
    {
        Client?.Dispose();
        Client = null;
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _insightsCts.Cancel();
        _insightsCts.Dispose();
        DisposeClient();
        Events.Unsubscribe<RefreshRequestedEvent>(OnRefreshRequested);
        foreach (var id in new[] { "redis-scan", "redis-refresh-key", "redis-delete-key" })
            Commands.Unregister(id);
        Selection.SetSelection("redis", null);
    }
