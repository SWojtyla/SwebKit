@page "/redis"
@using SwebKit.Core.Services
@inject AppStateService AppState
@inject INotificationService Notifications
@inject IConnectionStateService ConnectionState
@inject IAppEventBus Events
@inject IRedisWarmupCache RedisWarmupCache
@implements IDisposable
@inject CommandRegistry Commands
@inject ISelectionContext Selection
@inject PageDataCache Cache
@inject RedisOpsInsightsAggregator OpsInsightsAggregator

<div class="redis-page">
    <RoutePageHeader Area="redis" Subtitle="Explore keyspaces, health, and value operations for the active cache.">
        <Meta>
    </Meta>
</RoutePageHeader>

<RedisConnectionBar CacheEntries="@CacheEntries" ActiveCacheEntry="@ActiveCacheEntry"
                    SelectedCacheId="@SelectedCacheId" OnCacheChanged="HandleCacheChanged"
                    OnCacheNameChanged="HandleCacheNameChanged" />

@if (!AppState.UseDemoData && !IsConfigured)
{
    <EmptyState Icon="🗄" Title="Redis is not configured"
                Subtitle="Configure the active cache in Settings before opening keyspace, health, and value operations.">
        <Actions>
            <a href="/settings?section=redis">Open Redis settings</a>
        </Actions>
    </EmptyState>
}
else
{
    <RedisToolbar @ref="_toolbar" IsLoading="@IsLoading" SelectedKey="@SelectedKey" KeyCount="@Keys.Count"
                  HasMoreKeys="@_hasMoreKeys" IsProduction="@IsProduction" HasAnyPanel="@(SelectedInfo is not null)"
                  BatchProgressMessage="@_batchProgressMessage" OnScan="HandleScan" OnRefreshKey="RefreshSelectedAsync"
                  OnDeleteKey="DeleteSelectedKeyAsync" OnSelectAllLoaded="SelectAllLoadedAsync"
                  OnExportJson="ExportKeysToJsonAsync" OnBatchDelete="DeleteSelectedKeysAsync" />

    @if (ErrorMessage is not null)
    {
        <ErrorCallout Message="@ErrorMessage" />
    }

    @if (IsLoading && Client is null)
    {
        <LoadingSpinner Message="Connecting to Redis…" />
    }
    else
    {
        <div class="content-grid">
            <div class="left-column">
                <div class="panel key-tree-panel" tabindex="0" @onkeydown="HandleKeyListKeyDown"
                     @onkeydown:preventDefault="@_preventKeyListKey">
                    <RedisNamespaceTree Nodes="@NamespaceNodes" Separator="@CurrentSeparator" SelectedKey="@SelectedKey"
                                        KeyTypes="@KeyTypes" IsLoading="@IsLoading" OnSeparatorChanged="OnSeparatorChangedAsync"
                                        OnPrefixSelected="OnPrefixSelectedAsync" OnKeySelected="SelectKeyAsync"
                                        MultiSelectMode="@(_toolbar?.MultiSelectMode ?? false)"
                                        SelectedKeys="@(_toolbar?.SelectedKeys ?? _emptySelectedKeys)" OnKeyToggled="HandleKeyToggled"
                                        OnSubtreeSelected="HandleSubtreeSelected" OnSubtreeCleared="HandleSubtreeCleared" />
                    @if (_hasMoreKeys)
                    {
                        <div class="load-more-bar">
                            <FluentButton @onclick="LoadMoreKeysAsync" Disabled="@IsLoading">Load more matches (@Keys.Count
                                loaded)
                            </FluentButton>
                        </div>
                    }
                </div>
            </div>

            <div class="right-column">
                <div class="panel detail-panel">
                    <RedisKeyDetail SelectedKey="@SelectedKey" KeyInfo="@SelectedInfo" StringValue="@SelectedStringValue"
                                    HashFields="@SelectedHashFields" Items="@SelectedItems" SortedSetItems="@SelectedSortedSetItems"
                                    OnRefresh="RefreshSelectedAsync" OnDelete="DeleteSelectedKeyAsync" OnSetTtl="SetTtlAsync"
                                    OnRemoveTtl="RemoveTtlAsync" OnSetStringValue="SetStringValueAsync"
                                    OnSetHashField="SetHashFieldAsync" OnUpdateSortedSetScore="UpdateSortedSetScoreAsync"
                                    OnRenameKey="RenameSelectedKeyAsync" OnDeleteHashField="DeleteHashFieldAsync"
                                    HasMoreItems="@_hasMoreItems" OnLoadMoreItems="LoadMoreItemsAsync" />
                </div>

                <div class="panel health-panel">
                    <RedisKeyspaceHealthExplorer Report="@HealthReport" IsLoading="@IsAnalyzingHealth"
                                                 OnAnalyze="AnalyzeKeyspaceHealthAsync" OnFindingSelected="OpenFindingKeyAsync" />
                </div>

                <RedisPrefixMemory Buckets="@PrefixMemoryBuckets" ScannedKeyCount="@ScannedKeyInfos.Count"
                                   TotalKeyCount="@Keys.Count" IsLoading="@IsAnalyzingMemory" OnAnalyze="AnalyzePrefixMemoryAsync" />

                <div class="panel insights-panel">
                    <RedisOpsInsightsPanel SlowLog="@_slowLog" HotKeys="@_hotKeys" PubSub="@_pubSub"
                                           OnRefreshSlowLog="LoadSlowLogAsync" OnRefreshPubSub="LoadPubSubAsync"
                                           OnNavigateToKey="SelectKeyAsync" />
                </div>
            </div>
        </div>
    }
}
</div>

<ConfirmDialog Visible="@ConfirmVisible" Title="@ConfirmTitle" Message="@ConfirmMessage" ConfirmLabel="@ConfirmLabel"
               IsProduction="@IsProduction" RequireTyping="true" OnConfirm="OnConfirmAsync" OnCancel="OnCancelConfirmAsync" />

@code {
    private IRedisClient? Client;
    private RedisToolbar? _toolbar;
    private static readonly HashSet<string> _emptySelectedKeys = [];
    private bool IsLoading;
    private string? ErrorMessage;
    private CancellationTokenSource _cts = new();

    private sealed record RedisPageSnapshot(
        List<string> Keys,
        Dictionary<string, string> KeyTypes,
        List<NamespaceNode> NamespaceNodes,
        string Separator);

    private readonly List<string> Keys = [];
    private readonly Dictionary<string, string> KeyTypes = new(StringComparer.Ordinal);
    private readonly RedisKeyspaceHealthAnalyzer _healthAnalyzer = new();
    private readonly RedisScanPageAccumulator _scanPageAccumulator = new(ScanPageSize);

    // RDS-1: Key scan pagination
    private long _scanCursor;
    private long _scanSessionVersion;
    private bool _hasMoreKeys;
    private const int ScanPageSize = 250;
    private const int ScanBatchSize = 250;
    private const int KeyTypeBatchSize = 25;

    // RDS-4: Item pagination
    private long _itemsOffset;
    private long _setItemsCursor;
    private bool _hasMoreItems;
    private const int ItemPageSize = 100;

    // RDS-9: Multi-key delete
    private string? _batchProgressMessage;

    private string? SelectedKey;
    private RedisKeyInfo? SelectedInfo;
    private string? SelectedStringValue;
    private List<RedisHashField> SelectedHashFields = [];
    private List<string> SelectedItems = [];
    private List<RedisSortedSetEntry> SelectedSortedSetItems = [];

    // Namespace tree
    private List<NamespaceNode> NamespaceNodes = [];
    private string CurrentSeparator = "-";

    // Prefix memory
    private List<PrefixMemoryBucket> PrefixMemoryBuckets = [];
    private List<RedisKeyInfo> ScannedKeyInfos = [];
    private bool IsAnalyzingMemory;

    // Keyspace health
    private RedisKeyspaceHealthReport? HealthReport;
    private bool IsAnalyzingHealth;

    // Ops insights
    private RedisSlowLogSummary? _slowLog;
    private RedisHotKeySummary? _hotKeys;
    private RedisPubSubSnapshot? _pubSub;
    private CancellationTokenSource _insightsCts = new();

    // Confirm dialog
    private bool ConfirmVisible;
    private string ConfirmTitle = "Confirm";
    private string ConfirmMessage = "Are you sure?";
    private string ConfirmLabel = "Confirm";
    private Func<Task>? ConfirmAction;

    // Multi-cache
    private string SelectedCacheId = "";

    private RedisConfig? CurrentRedisConfig => AppState.Config.RedisConfig;

    private List<RedisCacheEntry> CacheEntries
    {
        get
        {
            var config = CurrentRedisConfig;
            if (config is null) return [];
            config.EnsureMigrated();
            return config.Caches;
        }
    }

    private RedisCacheEntry? ActiveCacheEntry => CacheEntries.FirstOrDefault(c => c.Id == SelectedCacheId)
                                                  ?? CacheEntries.FirstOrDefault();

    private bool IsConfigured => AppState.UseDemoData || CacheEntries.Any(c =>
        !string.IsNullOrWhiteSpace(c.ConnectionString));
    private bool IsProduction => AppState.Config.IsProduction;

    protected override void OnInitialized()
    {
        Events.Subscribe<RefreshRequestedEvent>(OnRefreshRequested);
        RegisterRedisCommands();
    }

    private void OnRefreshRequested(RefreshRequestedEvent refresh)
    {
        if (!string.Equals(refresh.Area, "redis", StringComparison.Ordinal))
        {
            return;
        }

        _ = SelectedKey is not null
            ? InvokeAsync(RefreshSelectedAsync)
            : InvokeAsync(StartFreshScanAsync);
    }

    private void RegisterRedisCommands()
    {
        Commands.Register(new AppCommand
        {
            Id = "redis-scan",
            Label = "Scan Keys",
            Category = "Redis",
            AreaScope = "redis",
            Execute = StartFreshScanAsync
        });
        Commands.Register(new AppCommand
        {
            Id = "redis-refresh-key",
            Label = "Refresh Selected Key",
            Category = "Redis",
            AreaScope = "redis",
            IsAvailable = () => SelectedKey is not null,
            Execute = () => RefreshSelectedAsync()
        });
        Commands.Register(new AppCommand
        {
            Id = "redis-delete-key",
            Label = "Delete Selected Key",
            Category = "Redis",
            AreaScope = "redis",
            IsAvailable = () => SelectedKey is not null,
            Execute = () => DeleteSelectedKeyAsync()
        });
    }

    // ── Key list keyboard navigation ──

    private bool _preventKeyListKey;

    private async Task HandleKeyListKeyDown(KeyboardEventArgs e)
    {
        _preventKeyListKey = e.Key is "ArrowUp" or "ArrowDown" or "Escape";
        switch (e.Key)
        {
            case "ArrowDown": SelectKeyRelative(+1); break;
            case "ArrowUp": SelectKeyRelative(-1); break;
            case "Escape":
                SelectedKey = null;
                Selection.SetSelection("redis", null);
                await InvokeAsync(StateHasChanged);
                break;
            case "Enter": if (SelectedKey is not null) await RefreshSelectedAsync(); break;
        }
    }

    private void SelectKeyRelative(int delta)
    {
        if (Keys.Count == 0) return;
        var idx = SelectedKey is null ? -1 : Keys.IndexOf(SelectedKey);
        var next = Keys[Math.Clamp(idx + delta, 0, Keys.Count - 1)];
        SelectedKey = next;
        Selection.SetSelection("redis", next);
        _ = RefreshSelectedAsync();
    }

    private string? _loadedCacheId;

    private (long SessionVersion, CancellationToken Token) BeginNewScanSession()
    {
        _scanSessionVersion++;
        _cts.Cancel();
        _cts.Dispose();
        _cts = new CancellationTokenSource();
        return (_scanSessionVersion, _cts.Token);
    }

    private bool IsCurrentScanSession(long sessionVersion) => sessionVersion == _scanSessionVersion;

    private Task StartFreshScanAsync()
    {
        var (sessionVersion, token) = BeginNewScanSession();
        return ScanAsync(sessionVersion, token);
    }

    private Task StartReconnectAndScanAsync()
    {
        var (sessionVersion, token) = BeginNewScanSession();
        return ConnectAndScanAsync(sessionVersion, token);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Initialize separator from config
        CurrentSeparator = CurrentRedisConfig?.NamespaceSeparator ?? "-";

        // Initialize selected cache
        var config = CurrentRedisConfig;
        if (config is not null)
        {
            config.EnsureMigrated();
            SelectedCacheId = config.ActiveCacheId ?? config.Caches.FirstOrDefault()?.Id ?? "";
        }

        // PERF-10: Guard — only reload if the cache selection actually changed (BL-3, BL-5)
        if (string.Equals(_loadedCacheId, SelectedCacheId, StringComparison.Ordinal))
            return;

        _loadedCacheId = SelectedCacheId; // Set guard BEFORE await (BL-3)

        // Reset insights when cache changes
        _slowLog = null;
        _hotKeys = null;
        _pubSub = null;

        await StartReconnectAndScanAsync();
    }

    private async Task ConnectAndScanAsync(long scanSession, CancellationToken ct = default)
    {
        if (!IsCurrentScanSession(scanSession))
            return;

        InvalidateHealthReport();

        // PERF-18: Stale-while-revalidate — restore cached snapshot for instant back-navigation
        var cacheKey = $"redis:{SelectedCacheId}";
        var cached = Cache.Get<RedisPageSnapshot>(cacheKey);
        if (cached is not null)
        {
            Keys.Clear();
            Keys.AddRange(cached.Keys);
            KeyTypes.Clear();
            foreach (var kv in cached.KeyTypes)
                KeyTypes[kv.Key] = kv.Value;
            NamespaceNodes = cached.NamespaceNodes;
            CurrentSeparator = cached.Separator;
            await InvokeAsync(StateHasChanged);
        }

        IsLoading = true;
        ErrorMessage = null;
        await InvokeAsync(StateHasChanged); // Show spinner before connection attempt
        try
        {
            await ConnectAsync(scanSession, ct);
            ct.ThrowIfCancellationRequested();
            if (!IsCurrentScanSession(scanSession))
                return;

            await ScanAsync(scanSession, ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            if (IsCurrentScanSession(scanSession))
            {
                IsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ConnectAsync(long scanSession, CancellationToken ct)
    {
        DisposeClient();
        IRedisClient? nextClient = null;

        try
        {
            if (AppState.UseDemoData)
            {
                var db = ActiveCacheEntry?.Database ?? 0;
                nextClient = new DemoRedisClient(db);
                if (!IsCurrentScanSession(scanSession))
                    return;

                Client = nextClient;
                nextClient = null;
                ConnectionState.SetConnected("redis");
                return;
            }

            var entry = ActiveCacheEntry;
            if (entry is null || string.IsNullOrWhiteSpace(entry.ConnectionString))
            {
                if (IsCurrentScanSession(scanSession))
                    ConnectionState.SetNotConfigured("redis");
                return;
            }

            // Check warm-client cache first — TryGet removes the entry so ownership transfers here
            var warm = RedisWarmupCache.TryGet(entry.Id);
            if (warm is not null)
            {
                if (!IsCurrentScanSession(scanSession))
                    return;
                Client = warm;
                ConnectionState.SetConnected("redis");
                return;
            }

            nextClient = await SwebKit.Redis.RedisClient.CreateAsync(entry);
            ct.ThrowIfCancellationRequested();
            await nextClient.TestConnectionAsync(ct);
            ct.ThrowIfCancellationRequested();
            if (!IsCurrentScanSession(scanSession))
                return;

            Client = nextClient;
            nextClient = null;
            ConnectionState.SetConnected("redis");
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            if (!IsCurrentScanSession(scanSession))
                return;

            ErrorMessage = ex.Message;
            DisposeClient();
            ConnectionState.SetError("redis", ex.Message);
        }
        finally
        {
            nextClient?.Dispose();
        }
    }

    private async Task ScanAsync(long scanSession, CancellationToken ct = default)
    {
        if (Client is null)
            return;

        IsLoading = true;
        ErrorMessage = null;
        Keys.Clear();
        KeyTypes.Clear();
        ScannedKeyInfos.Clear();
        PrefixMemoryBuckets.Clear();
        InvalidateHealthReport();
        _scanPageAccumulator.Reset();
        await InvokeAsync(StateHasChanged);

        try
        {
            var pattern = _toolbar?.Pattern ?? "*";
            if (string.IsNullOrWhiteSpace(pattern)) pattern = "*";
            _scanCursor = 0;
            _hasMoreKeys = false;
            var newKeys = new List<string>(ScanPageSize);

            do
            {
                ct.ThrowIfCancellationRequested();
                var result = await Client.ScanKeysAsync(pattern, _scanCursor, ScanBatchSize, ct);
                ct.ThrowIfCancellationRequested();
                if (!IsCurrentScanSession(scanSession))
                    return;

                _scanCursor = result.Cursor;
                var appended = _scanPageAccumulator.AppendBatch(result.Keys, newKeys.Count);
                newKeys.AddRange(appended.VisibleKeys);
                _hasMoreKeys = _scanPageAccumulator.HasOverflow || (!result.IsComplete && _scanCursor != 0);

                if (_scanPageAccumulator.HasOverflow || newKeys.Count >= ScanPageSize || result.IsComplete || _scanCursor == 0)
                    break;
            } while (true);

            ct.ThrowIfCancellationRequested();
            if (!IsCurrentScanSession(scanSession))
                return;

            Keys.AddRange(newKeys);
            RebuildNamespaceTree();
            IsLoading = false;
            await InvokeAsync(StateHasChanged);

            await LoadVisibleKeyTypesAsync(Keys, scanSession, ct);
        }
        catch (OperationCanceledException) { return; } // CS-2: cancelled — silently abort
        catch (Exception ex)
        {
            if (IsCurrentScanSession(scanSession))
                ErrorMessage = ex.Message;
        }
        finally
        {
            if (IsCurrentScanSession(scanSession) && !ct.IsCancellationRequested)
            {
                // PERF-18: Save snapshot to cache after successful scan
                var cacheKey = $"redis:{SelectedCacheId}";
                Cache.Set(cacheKey, new RedisPageSnapshot(
                    Keys.ToList(),
                    new Dictionary<string, string>(KeyTypes, StringComparer.Ordinal),
                    NamespaceNodes.ToList(),
                    CurrentSeparator));

                IsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadVisibleKeyTypesAsync(IReadOnlyList<string> targetKeys, long scanSession, CancellationToken ct =
default)
    {
        if (Client is null || targetKeys.Count == 0 || !IsCurrentScanSession(scanSession))
            return;

        var batches = targetKeys.Chunk(KeyTypeBatchSize).ToList();
        for (var index = 0; index < batches.Count; index++)
        {
            ct.ThrowIfCancellationRequested();
            if (!IsCurrentScanSession(scanSession))
                return;

            var batch = batches[index];
            var resolvedTypes = await Task.WhenAll(batch.Select(key => LoadKeyTypeAsync(key, ct)));

            ct.ThrowIfCancellationRequested();
            if (!IsCurrentScanSession(scanSession))
                return;

            foreach (var (key, type) in resolvedTypes)
            {
                if (Keys.Contains(key))
                    KeyTypes[key] = type;
            }

            if (index == batches.Count - 1 || (index + 1) % 2 == 0)
                await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<(string Key, string Type)> LoadKeyTypeAsync(string key, CancellationToken ct)
    {
        if (Client is null)
            return (key, "?");

        try
        {
            return (key, await Client.GetKeyTypeAsync(key, ct));
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
            return (key, "?");
        }
    }

    private async Task SelectKeyAsync(string key)
    {
        SelectedKey = key;
        Selection.SetSelection("redis", key);
        await RefreshSelectedAsync();
    }

    private async Task RefreshSelectedAsync()
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey))
            return;

        ErrorMessage = null;

        try
        {
            SelectedInfo = await Client.GetKeyInfoAsync(SelectedKey);
            KeyTypes[SelectedKey] = SelectedInfo.Type;
            SelectedStringValue = null;
            SelectedHashFields = [];
            SelectedItems = [];
            SelectedSortedSetItems = [];
            _hasMoreItems = false;

            switch (SelectedInfo.Type)
            {
                case "string":
                    SelectedStringValue = await Client.GetKeyValueAsync(SelectedKey);
                    break;
                case "hash":
                    SelectedHashFields = (await Client.GetHashFieldsAsync(SelectedKey)).ToList();
                    break;
                case "list":
                    _itemsOffset = ItemPageSize;
                    SelectedItems = (await Client.GetListItemsAsync(SelectedKey, 0, ItemPageSize - 1)).ToList();
                    _hasMoreItems = SelectedItems.Count >= ItemPageSize;
                    break;
                case "set":
                    var setPage = await Client.GetSetMembersPageAsync(SelectedKey, 0, ItemPageSize);
                    SelectedItems = setPage.Members.ToList();
                    _setItemsCursor = setPage.Cursor;
                    _hasMoreItems = !setPage.IsComplete;
                    break;
                case "zset":
                    _itemsOffset = ItemPageSize;
                    SelectedSortedSetItems = (await Client.GetSortedSetMembersAsync(SelectedKey, 0, ItemPageSize - 1)).ToList();
                    _hasMoreItems = SelectedSortedSetItems.Count >= ItemPageSize;
                    break;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task DeleteSelectedKeyAsync()
    {
        if (SelectedKey is null)
            return Task.CompletedTask;

        return ShowConfirmationAsync(
            title: "Delete Key",
            message: $"Delete key '{SelectedKey}'?",
            label: "Delete",
            action: async () =>
            {
                if (Client is null || SelectedKey is null)
                    return;

                var deletedKey = SelectedKey;
                await Client.DeleteKeysAsync([SelectedKey]);
                Keys.Remove(SelectedKey);

                KeyTypes.Remove(SelectedKey);
                SelectedKey = null;
                SelectedInfo = null;
                SelectedStringValue = null;
                SelectedHashFields = [];
                SelectedItems = [];
                SelectedSortedSetItems = [];
                RebuildNamespaceTree();
                InvalidateHealthReport();
                Notifications.ShowSuccess("Key deleted", deletedKey);
            });
    }

    private async Task SetTtlAsync(int ttlSeconds)
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey))
            return;

        try
        {
            await Client.SetTtlAsync(SelectedKey, TimeSpan.FromSeconds(Math.Max(1, ttlSeconds)));
            await RefreshSelectedAsync();
            InvalidateHealthReport();
            Notifications.ShowSuccess("TTL updated", $"{ttlSeconds}s on '{SelectedKey}'");
        }
        catch (Exception ex)
        {
            Notifications.ShowError("Failed to update TTL", ex: ex);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RemoveTtlAsync()
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey))
            return;

        try
        {
            await Client.RemoveTtlAsync(SelectedKey);
            await RefreshSelectedAsync();
            InvalidateHealthReport();
            Notifications.ShowSuccess("TTL removed", $"Key '{SelectedKey}' will not expire.");
        }
        catch (Exception ex)
        {
            Notifications.ShowError("Failed to remove TTL", ex: ex);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SetStringValueAsync(string value)
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey))
            return;

        try
        {
            await Client.SetKeyValueAsync(SelectedKey, value);
            await RefreshSelectedAsync();
            InvalidateHealthReport();
            Notifications.ShowSuccess("Value saved", SelectedKey);
        }
        catch (Exception ex)
        {
            Notifications.ShowError("Failed to save value", ex: ex);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SetHashFieldAsync((string Field, string Value) entry)
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey) || string.IsNullOrWhiteSpace(entry.Field))
            return;

        try
        {
            await Client.SetHashFieldAsync(SelectedKey, entry.Field, entry.Value);
            await RefreshSelectedAsync();
            InvalidateHealthReport();
            Notifications.ShowSuccess("Field saved", $"{entry.Field} on '{SelectedKey}'");
        }
        catch (Exception ex)
        {
            Notifications.ShowError("Failed to save field", ex: ex);
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── RDS-1: Load more keys ──

    private async Task LoadMoreKeysAsync()
    {
        if (Client is null || !_hasMoreKeys) return;

        var ct = _cts.Token;
        var scanSession = _scanSessionVersion;
        IsLoading = true;
        ErrorMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            ct.ThrowIfCancellationRequested();
            if (!IsCurrentScanSession(scanSession))
                return;

            var pattern = _toolbar?.Pattern ?? "*";
            if (string.IsNullOrWhiteSpace(pattern)) pattern = "*";
            var newKeys = _scanPageAccumulator.TakeOverflowPage(0).ToList();

            while (newKeys.Count < ScanPageSize && _scanCursor != 0)
            {
                ct.ThrowIfCancellationRequested();
                var result = await Client.ScanKeysAsync(pattern, _scanCursor, ScanBatchSize, ct);
                ct.ThrowIfCancellationRequested();
                if (!IsCurrentScanSession(scanSession))
                    return;

                _scanCursor = result.Cursor;
                var appended = _scanPageAccumulator.AppendBatch(result.Keys, newKeys.Count);
                newKeys.AddRange(appended.VisibleKeys);
                _hasMoreKeys = _scanPageAccumulator.HasOverflow || (!result.IsComplete && _scanCursor != 0);

                if (_scanPageAccumulator.HasOverflow || newKeys.Count >= ScanPageSize || result.IsComplete || _scanCursor == 0)
                    break;
            }

            if (!IsCurrentScanSession(scanSession))
                return;

            Keys.AddRange(newKeys);
            _hasMoreKeys = _scanPageAccumulator.HasOverflow || _scanCursor != 0;

            RebuildNamespaceTree();
            InvalidateHealthReport();
            IsLoading = false;
            await InvokeAsync(StateHasChanged);

            await LoadVisibleKeyTypesAsync(newKeys, scanSession, ct);
        }
        catch (OperationCanceledException) { return; } // CS-2
        catch (Exception ex)
        {
            if (IsCurrentScanSession(scanSession))
                ErrorMessage = ex.Message;
        }
        finally
        {
            if (IsCurrentScanSession(scanSession))
            {
                IsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    // ── RDS-4: Load more items ──

    private async Task LoadMoreItemsAsync()
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey) || !_hasMoreItems) return;

        try
        {
            switch (SelectedInfo?.Type)
            {
                case "list":
                    var listPage = (await Client.GetListItemsAsync(SelectedKey, _itemsOffset, _itemsOffset + ItemPageSize - 1)).ToList();
                    SelectedItems.AddRange(listPage);
                    _itemsOffset += listPage.Count;
                    _hasMoreItems = listPage.Count >= ItemPageSize;
                    break;
                case "set":
                    var setPage = await Client.GetSetMembersPageAsync(SelectedKey, _setItemsCursor, ItemPageSize);
                    SelectedItems.AddRange(setPage.Members);
                    _setItemsCursor = setPage.Cursor;
                    _hasMoreItems = !setPage.IsComplete;
                    break;
                case "zset":
                    var zsetPage = (await Client.GetSortedSetMembersAsync(SelectedKey, _itemsOffset, _itemsOffset + ItemPageSize -
1)).ToList();
                    SelectedSortedSetItems.AddRange(zsetPage);
                    _itemsOffset += zsetPage.Count;
                    _hasMoreItems = zsetPage.Count >= ItemPageSize;
                    break;
            }
        }
        catch (OperationCanceledException) { throw; } // CS-2
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    // ── RDS-3: Update sorted set score ──

    private async Task UpdateSortedSetScoreAsync((string Member, double Score) entry)
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey)) return;

        try
        {
            await Client.UpdateSortedSetScoreAsync(SelectedKey, entry.Member, entry.Score);
            await RefreshSelectedAsync();
            Notifications.ShowSuccess("Score updated", $"{entry.Member} = {entry.Score}");
        }
        catch (OperationCanceledException) { throw; } // CS-2
        catch (Exception ex)
        {
            Notifications.ShowError("Failed to update score", ex: ex);
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── RDS-6: Rename key ──

    private async Task RenameSelectedKeyAsync(string newKey)
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey)) return;

        var oldKey = SelectedKey;
        try
        {
            await Client.RenameKeyAsync(oldKey, newKey);
            var idx = Keys.IndexOf(oldKey);
            if (idx >= 0)
                Keys[idx] = newKey;
            if (KeyTypes.Remove(oldKey, out var type))
                KeyTypes[newKey] = type;
            _scanPageAccumulator.RegisterVisibleKey(newKey);
            SelectedKey = newKey;
            Selection.SetSelection("redis", newKey);
            RebuildNamespaceTree();
            InvalidateHealthReport();
            await RefreshSelectedAsync();
            Notifications.ShowSuccess("Key renamed", $"'{oldKey}' → '{newKey}'");
        }
        catch (OperationCanceledException) { throw; } // CS-2
        catch (Exception ex)
        {
            Notifications.ShowError("Rename failed", ex: ex);
            await InvokeAsync(StateHasChanged);
        }
    }

