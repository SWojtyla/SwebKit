    private Task DeleteSelectedKeysAsync()
    {
        if (_toolbar is null || _toolbar.SelectedKeys.Count == 0) return Task.CompletedTask;

        var keyList = _toolbar.SelectedKeys.ToList();
        return ShowConfirmationAsync(
            title: "Delete Keys",
            message: $"Delete {keyList.Count} selected key(s)?",
            label: "Delete",
            action: async () =>
            {
                if (Client is null) return;

                try
                {
                    var chunks = keyList.Chunk(10).ToList();
                    int done = 0;
                    foreach (var chunk in chunks)
                    {
                        await Client.DeleteKeysAsync(chunk);
                        done += chunk.Length;
                        _batchProgressMessage = $"Deleting key {done} of {keyList.Count}\u2026";
                        await InvokeAsync(StateHasChanged);
                    }
                    foreach (var key in keyList)
                    {
                        Keys.Remove(key);
                        KeyTypes.Remove(key);
                    }
                    _toolbar.ExitMultiSelect();

                    if (keyList.Contains(SelectedKey ?? ""))
                    {
                        SelectedKey = null;
                        SelectedInfo = null;
                        SelectedStringValue = null;
                        SelectedHashFields = [];
                        SelectedItems = [];
                        SelectedSortedSetItems = [];
                    }

                    RebuildNamespaceTree();
                    InvalidateHealthReport();
                    Notifications.ShowSuccess("Keys deleted", $"{keyList.Count} key(s) removed.");
                }
                finally
                {
                    _batchProgressMessage = null;
                }
            });
    }

