    private async Task<IReadOnlyList<RedisKeyInfo>> LoadKeyInfosForLoadedKeysAsync(CancellationToken ct)
    {
        if (Client is null || Keys.Count == 0)
            return [];

        var results = new List<RedisKeyInfo>(Keys.Count);
        foreach (var key in Keys)
        {
            ct.ThrowIfCancellationRequested();
            var info = await Client.GetKeyInfoAsync(key, ct);
            results.Add(info);
        }

        return results;
    }

    private async Task<long?> TryGetEstimatedKeyCountAsync(CancellationToken ct)
    {
        if (Client is null)
            return null;

        try
        {
            var serverInfo = await Client.GetServerInfoAsync(ct);
            var dbIndex = Math.Clamp(ActiveCacheEntry?.Database ?? 0, 0, 15);
            return serverInfo.Databases.FirstOrDefault(db => db.Index == dbIndex)?.Keys;
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
            return null;
        }
    }

    private async Task AnalyzeKeyspaceHealthAsync()
    {
        if (Client is null || Keys.Count == 0)
            return;

        IsAnalyzingHealth = true;
        ErrorMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var keyInfos = await LoadKeyInfosForLoadedKeysAsync(_cts.Token);
            var estimate = await TryGetEstimatedKeyCountAsync(_cts.Token);

            HealthReport = _healthAnalyzer.Analyze(
                keyInfos,
                estimate,
                new RedisHealthScanOptions
                {
                    Separator = CurrentSeparator,
                });
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsAnalyzingHealth = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenFindingKeyAsync(string key)
    {
        if (string.IsNullOrWhiteSpace(key))
            return;

        var exists = Keys.Any(candidate => string.Equals(candidate, key, StringComparison.Ordinal));
        if (!exists)
        {
            Notifications.ShowWarning("Key not loaded", key);
            return;
        }

        await SelectKeyAsync(key);
    }

