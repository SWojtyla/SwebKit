@page "/redis"
@using SwebKit.Core.Services
@inject AppStateService AppState
@inject INotificationService Notifications
@inject IConnectionStateService ConnectionState
@implements IDisposable
@inject CommandRegistry Commands
@inject ISelectionContext Selection
@inject PageDataCache Cache

<div class="redis-page">
    <div class="page-header">
        @if (ActiveCacheEntry is not null)
        {
            <h2 class="cache-title">
                <input class="cache-name-input" type="text" value="@ActiveCacheEntry.DisplayName"
                       @onchange="OnCacheNameChanged" />
            </h2>
        }
        else
        {
            <h2>Redis</h2>
        }

        @if (CacheEntries.Count > 1)
        {
            <select class="cache-selector" @bind="SelectedCacheId" @bind:after="OnCacheChangedAsync">
                @foreach (var cache in CacheEntries)
                {
                    <option value="@cache.Id">@cache.DisplayName</option>
                }
            </select>
        }
    </div>

    @if (!AppState.UseDemoData && !IsConfigured)
    {
        <div class="not-configured">
            Redis is not configured for this environment. Configure it in Settings.
        </div>
    }
    else
    {
        <div class="toolbar">
            <div class="field">
                <label>Pattern</label>
                <input @bind="Pattern" placeholder="*" />
                <div class="pattern-help">
                    Examples: <code>user:*</code> <code>session:*</code> <code>cache:*</code> <code>*:pending</code>
                </div>
            </div>

            <FluentButton Appearance="Appearance.Accent" @onclick="() => ScanAsync(_cts.Token)" Disabled="@IsLoading">Scan
            </FluentButton>
            <FluentButton @onclick="RefreshSelectedAsync" Disabled="@(IsLoading || SelectedKey is null)">Refresh Key
            </FluentButton>
            <FluentButton @onclick="DeleteSelectedKeyAsync" Disabled="@(IsLoading || SelectedKey is null)">Delete Key
            </FluentButton>
            <FluentButton @onclick="PurgeAllAsync" Disabled="@IsLoading">Purge All</FluentButton>
            <AutoRefreshToggle OnRefresh="() => ScanAsync(_cts.Token)" Paused="@IsLoading" />

            <span class="connection">@ConnectionLabel</span>
        </div>

        @if (ErrorMessage is not null)
        {
            <ErrorCallout Message="@ErrorMessage" />
        }

        @if (IsLoading && Client is null)
        {
            <LoadingSpinner Message="Connecting to Redis…" />
        }
        else
        {
            <div class="content-grid">
                <div class="left-column">
                    <div class="panel key-tree-panel" tabindex="0" @onkeydown="HandleKeyListKeyDown"
                         @onkeydown:preventDefault="@_preventKeyListKey">
                        <RedisNamespaceTree Nodes="@NamespaceNodes" Separator="@CurrentSeparator" SelectedKey="@SelectedKey"
                                            KeyTypes="@KeyTypes" IsLoading="@IsLoading" OnSeparatorChanged="OnSeparatorChangedAsync"
                                            OnPrefixSelected="OnPrefixSelectedAsync" OnKeySelected="SelectKeyAsync" />
                    </div>
                </div>

                <div class="right-column">
                    <div class="panel detail-panel">
                        <RedisKeyDetail SelectedKey="@SelectedKey" KeyInfo="@SelectedInfo" StringValue="@SelectedStringValue"
                                        HashFields="@SelectedHashFields" Items="@SelectedItems" SortedSetItems="@SelectedSortedSetItems"
                                        OnRefresh="RefreshSelectedAsync" OnDelete="DeleteSelectedKeyAsync" OnSetTtl="SetTtlAsync"
                                        OnRemoveTtl="RemoveTtlAsync" OnSetStringValue="SetStringValueAsync"
                                        OnSetHashField="SetHashFieldAsync" />
                    </div>

                    <RedisPrefixMemory Buckets="@PrefixMemoryBuckets" ScannedKeyCount="@ScannedKeyInfos.Count"
                                       TotalKeyCount="@Keys.Count" IsLoading="@IsAnalyzingMemory" OnAnalyze="AnalyzePrefixMemoryAsync" />
                </div>
            </div>
        }
    }
</div>

<ConfirmDialog Visible="@ConfirmVisible" Title="@ConfirmTitle" Message="@ConfirmMessage" ConfirmLabel="@ConfirmLabel"
               IsProduction="@IsProduction" RequireTyping="true" OnConfirm="OnConfirmAsync" OnCancel="OnCancelConfirmAsync" />

@code {
    private IRedisClient? Client;
    private string Pattern = "*";
    private bool IsLoading;
    private string? ErrorMessage;
    private CancellationTokenSource _cts = new();

    private sealed record RedisPageSnapshot(
        List<string> Keys,
        Dictionary<string, string> KeyTypes,
        List<NamespaceNode> NamespaceNodes,
        string Separator);

    private readonly List<string> Keys = [];
    private readonly Dictionary<string, string> KeyTypes = new(StringComparer.Ordinal);

    private string? SelectedKey;
    private RedisKeyInfo? SelectedInfo;
    private string? SelectedStringValue;
    private List<RedisHashField> SelectedHashFields = [];
    private List<string> SelectedItems = [];
    private List<RedisSortedSetEntry> SelectedSortedSetItems = [];

    // Namespace tree
    private List<NamespaceNode> NamespaceNodes = [];
    private string CurrentSeparator = "-";

    // Prefix memory
    private List<PrefixMemoryBucket> PrefixMemoryBuckets = [];
    private List<RedisKeyInfo> ScannedKeyInfos = [];
    private bool IsAnalyzingMemory;

    // Confirm dialog
    private bool ConfirmVisible;
    private string ConfirmTitle = "Confirm";
    private string ConfirmMessage = "Are you sure?";
    private string ConfirmLabel = "Confirm";
    private Func<Task>? ConfirmAction;

    // Multi-cache
    private string SelectedCacheId = "";

    private RedisConfig? CurrentRedisConfig => AppState.Config.RedisConfig;

    private List<RedisCacheEntry> CacheEntries
    {
        get
        {
            var config = CurrentRedisConfig;
            if (config is null) return [];
            config.EnsureMigrated();
            return config.Caches;
        }
    }

    private RedisCacheEntry? ActiveCacheEntry => CacheEntries.FirstOrDefault(c => c.Id == SelectedCacheId)
                                                  ?? CacheEntries.FirstOrDefault();

    private bool IsConfigured => AppState.UseDemoData || CacheEntries.Any(c =>
!string.IsNullOrWhiteSpace(c.ConnectionString));
    private bool IsProduction => false;

    private string ConnectionLabel
    {
        get
        {
            if (AppState.UseDemoData)
                return "Connected: demo";
            var name = ActiveCacheEntry?.DisplayName;
            return $"Connected: {(string.IsNullOrWhiteSpace(name) ? "Redis" : name)}";
        }
    }

    protected override void OnInitialized()
    {
        RegisterRedisCommands();
    }

    private void RegisterRedisCommands()
    {
        Commands.Register(new AppCommand
        {
            Id = "redis-scan",
            Label = "Scan Keys",
            Category = "Redis",
            AreaScope = "redis",
            Execute = () => ScanAsync(_cts.Token)
        });
        Commands.Register(new AppCommand
        {
            Id = "redis-refresh-key",
            Label = "Refresh Selected Key",
            Category = "Redis",
            AreaScope = "redis",
            IsAvailable = () => SelectedKey is not null,
            Execute = () => RefreshSelectedAsync()
        });
        Commands.Register(new AppCommand
        {
            Id = "redis-delete-key",
            Label = "Delete Selected Key",
            Category = "Redis",
            AreaScope = "redis",
            IsAvailable = () => SelectedKey is not null,
            Execute = () => DeleteSelectedKeyAsync()
        });
    }

    // ── Key list keyboard navigation ──

    private bool _preventKeyListKey;

    private async Task HandleKeyListKeyDown(KeyboardEventArgs e)
    {
        _preventKeyListKey = e.Key is "ArrowUp" or "ArrowDown" or "Escape";
        switch (e.Key)
        {
            case "ArrowDown": SelectKeyRelative(+1); break;
            case "ArrowUp": SelectKeyRelative(-1); break;
            case "Escape": SelectedKey = null; Selection.SetSelection("redis", null); StateHasChanged(); break;
            case "Enter": if (SelectedKey is not null) await RefreshSelectedAsync(); break;
        }
    }

    private void SelectKeyRelative(int delta)
    {
        if (Keys.Count == 0) return;
        var idx = SelectedKey is null ? -1 : Keys.IndexOf(SelectedKey);
        var next = Keys[Math.Clamp(idx + delta, 0, Keys.Count - 1)];
        SelectedKey = next;
        Selection.SetSelection("redis", next);
        _ = RefreshSelectedAsync();
    }

    private string? _loadedCacheId;

    protected override async Task OnParametersSetAsync()
    {
        // Initialize separator from config
        CurrentSeparator = CurrentRedisConfig?.NamespaceSeparator ?? "-";

        // Initialize selected cache
        var config = CurrentRedisConfig;
        if (config is not null)
        {
            config.EnsureMigrated();
            SelectedCacheId = config.ActiveCacheId ?? config.Caches.FirstOrDefault()?.Id ?? "";
        }

        // PERF-10: Guard — only reload if the cache selection actually changed (BL-3, BL-5)
        if (string.Equals(_loadedCacheId, SelectedCacheId, StringComparison.Ordinal))
            return;

        _loadedCacheId = SelectedCacheId; // Set guard BEFORE await (BL-3)

        // PERF-16: Cancel any in-flight scan before starting new connection
        _cts.Cancel();
        _cts.Dispose();
        _cts = new CancellationTokenSource();

        await ConnectAndScanAsync(_cts.Token);
    }

    private async Task ConnectAndScanAsync(CancellationToken ct = default)
    {
        // PERF-18: Stale-while-revalidate — restore cached snapshot for instant back-navigation
        var cacheKey = $"redis:{SelectedCacheId}";
        var cached = Cache.Get<RedisPageSnapshot>(cacheKey);
        if (cached is not null)
        {
            Keys.Clear();
            Keys.AddRange(cached.Keys);
            KeyTypes.Clear();
            foreach (var kv in cached.KeyTypes)
                KeyTypes[kv.Key] = kv.Value;
            NamespaceNodes = cached.NamespaceNodes;
            CurrentSeparator = cached.Separator;
            await InvokeAsync(StateHasChanged);
        }

        IsLoading = true;
        ErrorMessage = null;
        await InvokeAsync(StateHasChanged); // Show spinner before connection attempt
        try
        {
            await ConnectAsync();
            ct.ThrowIfCancellationRequested();
            await ScanAsync(ct);
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConnectAsync()
    {
        DisposeClient();

        try
        {
            if (AppState.UseDemoData)
            {
                var db = ActiveCacheEntry?.Database ?? 0;
                Client = new DemoRedisClient(db);
                ConnectionState.SetConnected("redis");
                return;
            }

            var entry = ActiveCacheEntry;
            if (entry is null || string.IsNullOrWhiteSpace(entry.ConnectionString))
            {
                ConnectionState.SetNotConfigured("redis");
                return;
            }

            Client = await SwebKit.Redis.RedisClient.CreateAsync(entry);
            await Client.TestConnectionAsync();
            ConnectionState.SetConnected("redis");
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            DisposeClient();
            ConnectionState.SetError("redis", ex.Message);
        }
    }

    private async Task ScanAsync(CancellationToken ct = default)
    {
        if (Client is null)
            return;

        IsLoading = true;
        ErrorMessage = null;
        Keys.Clear();
        KeyTypes.Clear();
        ScannedKeyInfos.Clear();
        PrefixMemoryBuckets.Clear();
        await InvokeAsync(StateHasChanged);

        try
        {
            var pattern = string.IsNullOrWhiteSpace(Pattern) ? "*" : Pattern;
            long cursor = 0;
            var seen = new HashSet<string>(StringComparer.Ordinal);

            do
            {
                ct.ThrowIfCancellationRequested();
                var result = await Client.ScanKeysAsync(pattern, cursor, 500);
                var newKeys = result.Keys.Where(k => seen.Add(k)).ToList();
                Keys.AddRange(newKeys);
                cursor = result.Cursor;

                if (result.IsComplete || cursor == 0)
                    break;
            } while (true);

            ct.ThrowIfCancellationRequested();
            await LoadVisibleKeyTypesAsync(Keys);
            RebuildNamespaceTree();
        }
        catch (OperationCanceledException) { return; } // CS-2: cancelled — silently abort
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                // PERF-18: Save snapshot to cache after successful scan
                var cacheKey = $"redis:{SelectedCacheId}";
                Cache.Set(cacheKey, new RedisPageSnapshot(
                    Keys.ToList(),
                    new Dictionary<string, string>(KeyTypes, StringComparer.Ordinal),
                    NamespaceNodes.ToList(),
                    CurrentSeparator));

                IsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadVisibleKeyTypesAsync(IReadOnlyList<string> targetKeys)
    {
        if (Client is null || targetKeys.Count == 0)
            return;

        var tasks = targetKeys.Select(async key =>
        {
            try
            {
                var info = await Client.GetKeyInfoAsync(key);
                KeyTypes[key] = info.Type;
            }
            catch
            {
                KeyTypes[key] = "?";
            }
        });

        await Task.WhenAll(tasks);
    }

    private async Task SelectKeyAsync(string key)
    {
        SelectedKey = key;
        Selection.SetSelection("redis", key);
        await RefreshSelectedAsync();
    }

    private async Task RefreshSelectedAsync()
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey))
            return;

        ErrorMessage = null;

        try
        {
            SelectedInfo = await Client.GetKeyInfoAsync(SelectedKey);
            KeyTypes[SelectedKey] = SelectedInfo.Type;
            SelectedStringValue = null;
            SelectedHashFields = [];
            SelectedItems = [];
            SelectedSortedSetItems = [];

            switch (SelectedInfo.Type)
            {
                case "string":
                    SelectedStringValue = await Client.GetKeyValueAsync(SelectedKey);
                    break;
                case "hash":
                    SelectedHashFields = (await Client.GetHashFieldsAsync(SelectedKey)).ToList();
                    break;
                case "list":
                    SelectedItems = (await Client.GetListItemsAsync(SelectedKey, 0, 100)).ToList();
                    break;
                case "set":
                    SelectedItems = (await Client.GetSetMembersAsync(SelectedKey)).ToList();
                    break;
                case "zset":
                    SelectedSortedSetItems = (await Client.GetSortedSetMembersAsync(SelectedKey, 0, 100)).ToList();
                    break;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task DeleteSelectedKeyAsync()
    {
        if (SelectedKey is null)
            return Task.CompletedTask;

        return ShowConfirmationAsync(
            title: "Delete Key",
            message: $"Delete key '{SelectedKey}'?",
            label: "Delete",
            action: async () =>
            {
                if (Client is null || SelectedKey is null)
                    return;

                var deletedKey = SelectedKey;
                await Client.DeleteKeysAsync([SelectedKey]);
                Keys.Remove(SelectedKey);

                KeyTypes.Remove(SelectedKey);
                SelectedKey = null;
                SelectedInfo = null;
                SelectedStringValue = null;
                SelectedHashFields = [];
                SelectedItems = [];
                SelectedSortedSetItems = [];
                RebuildNamespaceTree();
                Notifications.ShowSuccess("Key deleted", deletedKey);
            });
    }

    private Task PurgeAllAsync()
    {
        return ShowConfirmationAsync(
            title: "Purge All",
            message: "Purge all keys from the active Redis database? This action is irreversible.",
            label: "Purge",
            action: async () =>
            {
                if (Client is null)
                    return;

                await Client.FlushDatabaseAsync();
                Keys.Clear();
                KeyTypes.Clear();

                SelectedKey = null;
                SelectedInfo = null;
                SelectedStringValue = null;
                SelectedHashFields = [];
                SelectedItems = [];
                SelectedSortedSetItems = [];
                NamespaceNodes = [];
                PrefixMemoryBuckets = [];
                ScannedKeyInfos.Clear();
                Notifications.ShowWarning("Database purged", "All keys have been removed.");
            });
    }

    private async Task SetTtlAsync(int ttlSeconds)
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey))
            return;

        try
        {
            await Client.SetTtlAsync(SelectedKey, TimeSpan.FromSeconds(Math.Max(1, ttlSeconds)));
            await RefreshSelectedAsync();
            Notifications.ShowSuccess("TTL updated", $"{ttlSeconds}s on '{SelectedKey}'");
        }
        catch (Exception ex)
        {
            Notifications.ShowError("Failed to update TTL", ex: ex);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RemoveTtlAsync()
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey))
            return;

        try
        {
            await Client.RemoveTtlAsync(SelectedKey);
            await RefreshSelectedAsync();
            Notifications.ShowSuccess("TTL removed", $"Key '{SelectedKey}' will not expire.");
        }
        catch (Exception ex)
        {
            Notifications.ShowError("Failed to remove TTL", ex: ex);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SetStringValueAsync(string value)
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey))
            return;

        try
        {
            await Client.SetKeyValueAsync(SelectedKey, value);
            await RefreshSelectedAsync();
            Notifications.ShowSuccess("Value saved", SelectedKey);
        }
        catch (Exception ex)
        {
            Notifications.ShowError("Failed to save value", ex: ex);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SetHashFieldAsync((string Field, string Value) entry)
    {
        if (Client is null || string.IsNullOrWhiteSpace(SelectedKey) || string.IsNullOrWhiteSpace(entry.Field))
            return;

        try
        {
            await Client.SetHashFieldAsync(SelectedKey, entry.Field, entry.Value);
            await RefreshSelectedAsync();
            Notifications.ShowSuccess("Field saved", $"{entry.Field} on '{SelectedKey}'");
        }
        catch (Exception ex)
        {
            Notifications.ShowError("Failed to save field", ex: ex);
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Cache switching ──

    private async Task OnCacheChangedAsync()
    {
        var config = CurrentRedisConfig;
        if (config is not null)
            config.ActiveCacheId = SelectedCacheId;

        await ConnectAsync();
        await ScanAsync();
    }

    private async void OnCacheNameChanged(ChangeEventArgs e)
    {
        var entry = ActiveCacheEntry;
        if (entry is null) return;
        entry.DisplayName = e.Value?.ToString()?.Trim() ?? "Cache";
        await InvokeAsync(StateHasChanged);
    }

    // ── Namespace tree ──

    private void RebuildNamespaceTree()
    {
        NamespaceNodes = RedisKeyGrouper.BuildNamespaceTree(Keys, CurrentSeparator);
    }

    private async Task OnSeparatorChangedAsync(string separator)
    {
        CurrentSeparator = string.IsNullOrEmpty(separator) ? "-" : separator;
        var config = CurrentRedisConfig;
        if (config is not null)
        {
            config.NamespaceSeparator = CurrentSeparator;
            await AppState.SaveConfigAsync();
        }

        RebuildNamespaceTree();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPrefixSelectedAsync(string prefix)
    {
        Pattern = $"{prefix}{CurrentSeparator}*";
        await ScanAsync();
    }

    // ── Prefix memory analysis ──

    private async Task AnalyzePrefixMemoryAsync()
    {
        if (Client is null || Keys.Count == 0)
            return;

        IsAnalyzingMemory = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            ScannedKeyInfos.Clear();
            foreach (var key in Keys)
            {
                var info = await Client.GetKeyInfoAsync(key);
                ScannedKeyInfos.Add(info);
            }

            PrefixMemoryBuckets = RedisKeyGrouper.ComputePrefixMemory(ScannedKeyInfos, CurrentSeparator);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsAnalyzingMemory = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Confirm dialog ──

    private Task ShowConfirmationAsync(string title, string message, string label, Func<Task> action)
    {
        ConfirmTitle = title;
        ConfirmMessage = message;
        ConfirmLabel = label;
        ConfirmAction = action;
        ConfirmVisible = true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnConfirmAsync()
    {
        ConfirmVisible = false;

        try
        {
            if (ConfirmAction is not null)
                await ConfirmAction();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            ConfirmAction = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task OnCancelConfirmAsync()
    {
        ConfirmVisible = false;
        ConfirmAction = null;
        return InvokeAsync(StateHasChanged);
    }

    private void DisposeClient()
    {
        Client?.Dispose();
        Client = null;
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        DisposeClient();
        foreach (var id in new[] { "redis-scan", "redis-refresh-key", "redis-delete-key" })
            Commands.Unregister(id);
        Selection.SetSelection("redis", null);
    }
}