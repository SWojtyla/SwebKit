    private async Task LoadSlowLogAsync()
    {
        if (Client is null)
            return;

        _insightsCts.Cancel();
        _insightsCts.Dispose();
        _insightsCts = new CancellationTokenSource();
        var ct = _insightsCts.Token;

        _slowLog = null;
        _hotKeys = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var slowLog = await Client.GetSlowLogAsync(ct: ct);
            ct.ThrowIfCancellationRequested();
            var hotKeys = OpsInsightsAggregator.BuildHotKeySignals(slowLog, ScannedKeyInfos);
            _slowLog = slowLog;
            _hotKeys = hotKeys;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

