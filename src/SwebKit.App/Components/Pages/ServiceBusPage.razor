                    new SbMessage { MessageId = "orders-005", Body = """{"orderId":"ORD-12349","amount":18.75,"customer":"C-0042","items":[{"sku":"SKU-1100","qty":1}]}""", ContentType = "application/json", Subject = "OrderCreated", CorrelationId = "sess-9f01", EnqueuedAt = DateTimeOffset.UtcNow.AddMinutes(-1), DeliveryCount = 1, SequenceNumber = 4505, ApplicationProperties = new Dictionary<string, object>() { ["source"] = "mobile-app", ["priority"] = "normal" } }
