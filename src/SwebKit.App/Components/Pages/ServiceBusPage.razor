@page "/service-bus"
@inject AppStateService AppState
@inject ICredentialStore CredentialStore
@inject IAppEventBus Events
@inject IJSRuntime JS
@implements IDisposable

<div class="service-bus-page-shell @(_isNamespacePaneCollapsed ? "left-pane-collapsed" : string.Empty)"
     style="display:flex; height:100%; overflow:hidden;">
    <!-- Left: namespace list + entity trees -->
    <div class="service-bus-left-pane @(_isNamespacePaneCollapsed ? "collapsed" : string.Empty)"
         style="border-right:1px solid var(--color-border); display:flex; flex-direction:column; overflow:hidden;">

        <!-- Namespace panel header -->
        <div
            style="padding:8px 12px; font-size:11px; border-bottom:1px solid var(--color-border); display:flex; align-items:center; justify-content:space-between;">
            @if (_isNamespacePaneCollapsed)
            {
                <button type="button"                        class="namespace-pane-toggle"                        title="Expand namespace panel"
                        aria-label="Expand namespace panel"                        aria-expanded="false"                        @onclick="ToggleNamespacePane">
                    ▶
                </button>
            }
            else
            {
                <span
                style="color:var(--color-text-muted); text-transform:uppercase; letter-spacing:0.5px;">Namespaces</span>
                <div style="display:flex; gap:4px; align-items:center;">
                    <button
                    style="padding:2px 8px; font-size:11px; cursor:pointer; background:var(--color-surface-2); color:var(--color-text-muted); border:1px solid var(--color-border); border-radius:3px;"
                    title="Add a demo namespace with fake data" @onclick="AddDemoNamespace">Demo</button>
                    <button
                    style="padding:2px 8px; font-size:11px; cursor:pointer; background:var(--color-accent); color:white; border:none; border-radius:3px;"
                    @onclick="ToggleAddForm">+ Add</button>
                    <button type="button" class="namespace-pane-toggle" title="Collapse namespace panel"
                            aria-label="Collapse namespace panel" aria-expanded="true" @onclick="ToggleNamespacePane">
                        ◀
                    </button>
                </div>
            }
        </div>

        @if (!_isNamespacePaneCollapsed)
        {
            <!-- Add namespace form -->
            @if (_showAddForm)
            {
                <div style="padding:10px 12px; border-bottom:1px solid var(--color-border); background:var(--color-surface);">
                    <div style="font-size:11px; color:var(--color-text-muted); margin-bottom:6px;">Paste a connection string:
                    </div>
                    <textarea @bind="_addConnStr" rows="3"
                              placeholder="Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=..."
                              style="width:100%; box-sizing:border-box; padding:6px; font-size:11px; background:var(--color-surface-2); color:var(--color-text); border:1px solid var(--color-border); border-radius:3px; resize:none; font-family:monospace;" />
                    @if (!string.IsNullOrWhiteSpace(_addError))
                    {
                        <div style="font-size:11px; color:var(--color-error); margin-top:4px;">@_addError</div>
                    }
                    <div style="display:flex; gap:6px; margin-top:6px;">
                        <button
                        style="flex:1; padding:4px; font-size:11px; cursor:pointer; background:var(--color-accent); color:white; border:none; border-radius:3px;"
                        @onclick="AddNamespaceAsync">Add</button>
                        <button
                        style="padding:4px 8px; font-size:11px; cursor:pointer; background:var(--color-surface-2); color:var(--color-text); border:1px solid var(--color-border); border-radius:3px;"
                        @onclick="CancelAdd">Cancel</button>
                    </div>
                </div>
            }

            <!-- Namespace list -->
            <div style="flex:1; overflow-y:auto;">
                @if (!_namespaceStates.Any())
                {
                    <div style="padding:16px 12px; font-size:12px; color:var(--color-text-muted);">
                        No namespaces added yet. Click <strong>+ Add</strong> and paste a connection string.
                    </div>
                }

                @foreach (var ns in _namespaceStates)
                {
                    <!-- Namespace header row -->
                    <div style="display:flex; align-items:center; padding:6px 12px; border-bottom:1px solid var(--color-border); cursor:pointer; background:var(--color-surface);"
                         @onclick="() => ToggleNamespace(ns.Namespace.Id)">
                        <span style="margin-right:6px; font-size:10px;">@(ns.IsExpanded ? "▼" : "▶")</span>
                        <span style="flex:1; font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                              title="@ns.Namespace.FullyQualifiedNamespace">@ns.Namespace.Alias</span>
                        @if (ns.IsConnecting)
                        {
                            <span style="font-size:10px; color:var(--color-text-muted);">...</span>
                        }
                        else if (ns.Client is not null)
                        {
                            <span style="font-size:10px; color:var(--color-success);">●</span>
                        }
                        else
                        {
                            <span style="font-size:10px; color:var(--color-error);" title="@ns.ConnectionError">●</span>
                        }
                        <button
                        style="margin-left:6px; background:transparent; border:none; color:var(--color-text-muted); cursor:pointer; font-size:12px; padding:0 2px;"
                        title="Remove namespace" @onclick:stopPropagation="true"
                        @onclick="() => RemoveNamespaceAsync(ns.Namespace.Id)">✕</button>
                    </div>

                    @if (ns.IsExpanded)
                    {
                        @if (ns.ConnectionError is not null && ns.Client is null)
                        {
                            <div style="padding:8px 12px; font-size:11px; color:var(--color-error);">@ns.ConnectionError</div>
                        }
                        else
                        {
                            <EntityTree Client="ns.Client" NamespaceId="ns.Namespace.Id" LinkedEntities="CurrentLinkedEntities"
                                        OnEntitySelected="entity => OpenEntityTab(ns, entity)"
                                        OnEntityModeSelected="selection => OpenEntityTab(ns, selection.Entity, selection.IsDlq)"
                                        OnEntityLinkToggled="link => ToggleEntityLinkAsync(link)" />
                        }
                    }
                }
            </div>
        }
    </div>

    <!-- Right: tabbed content -->
    <div class="service-bus-right-pane" style="flex:1; display:flex; flex-direction:column; overflow:hidden;">
        @if (!_openTabs.Any())
        {
            <div style="padding:40px; text-align:center; color:var(--color-text-muted);">
                Select a queue or topic from a namespace to open it.
            </div>
        }
        else
        {
            <!-- Tab bar -->
            <div class="tab-bar">
                @foreach (var tab in _openTabs)
                {
                    <div class="tab-item @(_activeTab?.Id == tab.Id ? "active" : "")" @onclick="() => SetActive(tab)">
                        @if (tab.IsDlq)
                        {
                            <span style="color:var(--color-error);">&#9888;</span>
                        }
                        <span style="flex:1; overflow:hidden; text-overflow:ellipsis;">
                            <span style="font-size:10px; color:var(--color-text-muted);">@tab.NamespaceAlias / </span>@tab.Title
                        </span>
                        <span class="close-btn" @onclick:stopPropagation="true" @onclick="() => CloseTab(tab)">&#x2715;</span>
                    </div>
                }
            </div>
            <!-- Active tab content -->
            @if (_activeTab is not null)
            {
                @if (_activeTab.IsDlq)
                {
                    <DlqView @key="_activeTab.Id" Client="_activeTab.Client" EntityPath="@_activeTab.EntityPath" />
                }
                else
                {
                    <div @key="_activeTab.Id" class="service-bus-active-workspace" style="display:flex; flex:1; overflow:hidden;">
                        <div class="service-bus-message-pane" style="flex:1; overflow:hidden;">
                            <MessageListView Client="_activeTab.Client" EntityPath="@_activeTab.EntityPath"
                                             ShowCompose="true"
                                             SelectedMessage="_activeTab.SelectedMessage"
                                             OnMessageSelected="msg => { _activeTab.SelectedMessage = msg; StateHasChanged(); }" />
                        </div>
                        <div @ref="_splitterRef" class="pane-splitter"></div>
                        <div @ref="_detailPaneRef" class="details-pane">
                            <MessageDetailPane Message="_activeTab.SelectedMessage" />
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>

@code {
    private List<NsState> _namespaceStates = [];
    private List<SbTab> _openTabs = [];
    private SbTab? _activeTab;
    private bool _showAddForm;
    private bool _isNamespacePaneCollapsed;
    private string _addConnStr = string.Empty;
    private string? _addError;
    private ElementReference _splitterRef;
    private ElementReference _detailPaneRef;
    private IJSObjectReference? _splitterHandle;

    private IReadOnlyList<SbEntityLink> CurrentLinkedEntities =>
        AppState.CurrentEnvironment?.ServiceBusEntityLinks ?? [];

    protected override async Task OnInitializedAsync()
    {
        Events.Subscribe<ProjectChangedEvent>(OnContextChanged);
        Events.Subscribe<EnvironmentChangedEvent>(OnContextChanged2);
        await LoadNamespacesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_activeTab is not null && !_activeTab.IsDlq && _splitterHandle is null)
        {
            try
            {
                _splitterHandle = await JS.InvokeAsync<IJSObjectReference>(
                    "SwebKitSplitter.init", _splitterRef, _detailPaneRef,
                    new { minWidth = 200, maxWidth = 700 });
            }
            catch { /* Element may not be rendered yet */ }
        }
    }

    private async Task LoadNamespacesAsync()
    {
        // Build namespace states from global list and connect each
        var incoming = AppState.ServiceBusNamespaces;
        var tasks = incoming.Select(async ns =>
        {
            var state = new NsState { Namespace = ns, IsExpanded = true, IsConnecting = true };
            state.Client = await TryConnectAsync(ns, state);
            return state;
        });
        _namespaceStates = (await Task.WhenAll(tasks)).ToList();
        StateHasChanged();
    }

    private async Task<IServiceBusClient?> TryConnectAsync(ServiceBusNamespace ns, NsState state)
    {
        try
        {
            var connStr = CredentialStore.Get(ns.CredentialKey);
            if (string.IsNullOrWhiteSpace(connStr))
            {
                state.ConnectionError = "Connection string not found in credential store.";
                state.IsConnecting = false;
                return null;
            }

            var client = new SwebKit.Azure.ServiceBus.AzureServiceBusClient(connStr);
            var ok = await client.TestConnectionAsync();
            state.IsConnecting = false;
            if (!ok)
            {
                state.ConnectionError = "Connection test failed. Check the connection string.";
                await client.DisposeAsync();
                return null;
            }

            return client;
        }
        catch (Exception ex)
        {
            state.IsConnecting = false;
            state.ConnectionError = ex.Message;
            return null;
        }
    }

    private void ToggleAddForm()
    {
        _showAddForm = !_showAddForm;
        _addConnStr = string.Empty;
        _addError = null;
    }

    private void CancelAdd()
    {
        _showAddForm = false;
        _addConnStr = string.Empty;
        _addError = null;
    }

    private void ToggleNamespacePane()
    {
        _isNamespacePaneCollapsed = !_isNamespacePaneCollapsed;
        if (_isNamespacePaneCollapsed)
        {
            _showAddForm = false;
        }
    }

    private async Task AddNamespaceAsync()
    {
        _addError = null;
        var raw = _addConnStr.Trim();
        if (string.IsNullOrWhiteSpace(raw))
        {
            _addError = "Connection string is required.";
            return;
        }

        string fqns;
        try
        {
            var props = global::Azure.Messaging.ServiceBus.ServiceBusConnectionStringProperties.Parse(raw);
            fqns = props.FullyQualifiedNamespace;
            if (string.IsNullOrWhiteSpace(fqns))
                throw new FormatException("Could not determine namespace from connection string.");
        }
        catch (Exception ex)
        {
            _addError = $"Invalid connection string: {ex.Message}";
            return;
        }

        // Avoid duplicates
        if (AppState.ServiceBusNamespaces.Any(n => n.FullyQualifiedNamespace.Equals(fqns, StringComparison.OrdinalIgnoreCase)))
        {
            _addError = "This namespace is already added.";
            return;
        }

        var credKey = $"sb:ns:{Guid.NewGuid()}";
        CredentialStore.Save(credKey, raw);

        var ns = new ServiceBusNamespace
        {
            Alias = fqns.Split('.')[0],
            FullyQualifiedNamespace = fqns,
            CredentialKey = credKey
        };

        await AppState.AddServiceBusNamespaceAsync(ns);

        var state = new NsState { Namespace = ns, IsExpanded = true, IsConnecting = true };
        _namespaceStates.Add(state);
        _showAddForm = false;
        _addConnStr = string.Empty;
        StateHasChanged();

        state.Client = await TryConnectAsync(ns, state);
        StateHasChanged();
    }

    private async Task RemoveNamespaceAsync(Guid namespaceId)
    {
        var state = _namespaceStates.FirstOrDefault(s => s.Namespace.Id == namespaceId);
        if (state is null) return;

        // Close tabs belonging to this namespace
        var tabsToClose = _openTabs.Where(t => t.NamespaceId == namespaceId).ToList();
        foreach (var tab in tabsToClose) _openTabs.Remove(tab);
        if (_activeTab is not null && tabsToClose.Contains(_activeTab))
            _activeTab = _openTabs.LastOrDefault();

        // Dispose client
        if (state.Client is IAsyncDisposable d) await d.DisposeAsync();

        // Remove credential
        CredentialStore.Delete(state.Namespace.CredentialKey);

        _namespaceStates.Remove(state);
        await AppState.RemoveServiceBusNamespaceAsync(namespaceId);
        StateHasChanged();
    }

    private void ToggleNamespace(Guid id)
    {
        var ns = _namespaceStates.FirstOrDefault(s => s.Namespace.Id == id);
        if (ns is not null) ns.IsExpanded = !ns.IsExpanded;
        StateHasChanged();
    }

    private void OpenEntityTab(NsState ns, SbEntityInfo entity, bool isDlq = false)
    {
        if (ns.Client is null) return;
        var modeSuffix = isDlq ? "dlq" : "active";
        var id = $"{ns.Namespace.Id}:{entity.EntityPath}:{modeSuffix}";
        var existing = _openTabs.FirstOrDefault(t => t.Id == id);
        if (existing is not null) { _activeTab = existing; StateHasChanged(); return; }

        var tab = new SbTab
        {
            Id = id,
            NamespaceId = ns.Namespace.Id,
            NamespaceAlias = ns.Namespace.Alias,
            Title = isDlq ? $"{entity.Name} (DLQ)" : entity.Name,
            EntityPath = entity.EntityPath,
            Client = ns.Client,
            IsDlq = isDlq
        };
        _openTabs.Add(tab);
        _activeTab = tab;
        StateHasChanged();
    }

    private async Task ToggleEntityLinkAsync(SbEntityLink link)
    {
        var env = AppState.CurrentEnvironment;
        if (env is null || AppState.CurrentProject is null) return;

        var existing = env.ServiceBusEntityLinks
            .FirstOrDefault(l => l.NamespaceId == link.NamespaceId && l.EntityPath == link.EntityPath);

        if (existing is not null)
            env.ServiceBusEntityLinks.Remove(existing);
        else
            env.ServiceBusEntityLinks.Add(link);

        await AppState.UpdateProjectAsync(AppState.CurrentProject);
        StateHasChanged();
    }

    private async Task SetActive(SbTab tab)
    {
        if (_splitterHandle is not null)
        {
            try { await _splitterHandle.InvokeVoidAsync("dispose"); } catch { }
            _splitterHandle = null;
        }
        _activeTab = tab;
        StateHasChanged();
    }

    private void CloseTab(SbTab tab)
    {
        _openTabs.Remove(tab);
        if (_activeTab == tab) _activeTab = _openTabs.LastOrDefault();
        StateHasChanged();
    }

    private void OnContextChanged(ProjectChangedEvent _) => InvokeAsync(StateHasChanged);
    private void OnContextChanged2(EnvironmentChangedEvent _) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Events.Unsubscribe<ProjectChangedEvent>(OnContextChanged);
        Events.Unsubscribe<EnvironmentChangedEvent>(OnContextChanged2);
        if (_splitterHandle is not null)
        {
            try { _ = _splitterHandle.InvokeVoidAsync("dispose"); } catch { }
        }
        foreach (var ns in _namespaceStates)
            if (ns.Client is IAsyncDisposable d) _ = d.DisposeAsync().AsTask();
    }

    private static readonly Guid DemoNamespaceId = new("00000000-0000-0000-0000-000000000001");

    private void AddDemoNamespace()
    {
        if (_namespaceStates.Any(s => s.Namespace.Id == DemoNamespaceId)) return;

        var ns = new ServiceBusNamespace
        {
            Id = DemoNamespaceId,
            Alias = "demo-namespace",
            FullyQualifiedNamespace = "demo.servicebus.windows.net",
            CredentialKey = string.Empty
        };

        _namespaceStates.Add(new NsState
        {
            Namespace = ns,
            IsExpanded = true,
            IsConnecting = false,
            Client = new FakeServiceBusClient()
        });
        StateHasChanged();
    }

    private class NsState
    {
        public required ServiceBusNamespace Namespace { get; set; }
        public IServiceBusClient? Client { get; set; }
        public bool IsExpanded { get; set; }
        public bool IsConnecting { get; set; }
        public string? ConnectionError { get; set; }
    }

    private class SbTab
    {
        public required string Id { get; set; }
        public required Guid NamespaceId { get; set; }
        public required string NamespaceAlias { get; set; }
        public required string Title { get; set; }
        public required string EntityPath { get; set; }
        public required IServiceBusClient Client { get; set; }
        public bool IsDlq { get; set; }
        public SbMessage? SelectedMessage { get; set; }
    }

    private sealed class FakeServiceBusClient : IServiceBusClient
    {
        private readonly Dictionary<string, DemoEntityData> _entityData = new(StringComparer.OrdinalIgnoreCase)
        {
            ["orders"] = new DemoEntityData(
                ActiveTotal: 42,
                DeadLetterTotal: 3,
                ActiveMessages:
                [
                    new SbMessage { MessageId = "orders-001", Body = """{"orderId":"12345","amount":99.99}""", ContentType =
"application/json", Subject = "OrderCreated", EnqueuedAt = DateTimeOffset.UtcNow.AddMinutes(-5), DeliveryCount = 1 },
                    new SbMessage { MessageId = "orders-002", Body = """{"orderId":"12346","amount":149.99}""", ContentType =
"application/json", Subject = "OrderCreated", EnqueuedAt = DateTimeOffset.UtcNow.AddMinutes(-2), DeliveryCount = 1 }
                ],
                DeadLetterMessages:
                [
                    new SbMessage { MessageId = "orders-dlq-001", Body = """{"error":"validation failed"}""", Subject = "OrderFailed",
DeadLetterReason = "MaxDeliveryCountExceeded", EnqueuedAt = DateTimeOffset.UtcNow.AddHours(-1), DeliveryCount = 10 },
                    new SbMessage { MessageId = "orders-dlq-002", Body = """{"error":"missing customer id"}""", Subject = "OrderRejected",
DeadLetterReason = "DeadLetteredByApplication", EnqueuedAt = DateTimeOffset.UtcNow.AddHours(-2), DeliveryCount = 4 },
                    new SbMessage { MessageId = "orders-dlq-003", Body = """{"error":"timeout"}""", Subject = "OrderRetry", DeadLetterReason
= "MaxDeliveryCountExceeded", EnqueuedAt = DateTimeOffset.UtcNow.AddHours(-3), DeliveryCount = 10 }
                ]),
            ["payments"] = new DemoEntityData(
                ActiveTotal: 7,
                DeadLetterTotal: 1,
                ActiveMessages:
                [
                    new SbMessage { MessageId = "payments-001", Body = """{"paymentId":"pay-001","status":"captured"}""", ContentType =
"application/json", Subject = "PaymentCaptured", EnqueuedAt = DateTimeOffset.UtcNow.AddMinutes(-7), DeliveryCount = 1 },
                    new SbMessage { MessageId = "payments-002", Body = """{"paymentId":"pay-002","status":"authorized"}""", ContentType =
"application/json", Subject = "PaymentAuthorized", EnqueuedAt = DateTimeOffset.UtcNow.AddMinutes(-3), DeliveryCount = 1
}
                ],
                DeadLetterMessages:
                [
                    new SbMessage { MessageId = "payments-dlq-001", Body = """{"error":"gateway unavailable"}""", Subject = "PaymentFailed",
DeadLetterReason = "MaxDeliveryCountExceeded", EnqueuedAt = DateTimeOffset.UtcNow.AddHours(-4), DeliveryCount = 10 }
                ]),
            ["notifications"] = new DemoEntityData(
                ActiveTotal: 0,
                DeadLetterTotal: 0,
                ActiveMessages: [],
                DeadLetterMessages: []),
            ["user-events/subscriptions/consumer-a"] = new DemoEntityData(
                ActiveTotal: 5,
                DeadLetterTotal: 0,
                ActiveMessages:
                [
                    new SbMessage { MessageId = "ue-a-001", Body = """{"event":"user.created"}""", ContentType = "application/json", Subject
= "UserCreated", EnqueuedAt = DateTimeOffset.UtcNow.AddMinutes(-12), DeliveryCount = 1 },
                    new SbMessage { MessageId = "ue-a-002", Body = """{"event":"user.updated"}""", ContentType = "application/json", Subject
= "UserUpdated", EnqueuedAt = DateTimeOffset.UtcNow.AddMinutes(-10), DeliveryCount = 1 }
                ],
                DeadLetterMessages: []),
            ["user-events/subscriptions/consumer-b"] = new DemoEntityData(
                ActiveTotal: 0,
                DeadLetterTotal: 0,
                ActiveMessages: [],
                DeadLetterMessages: []),
            ["audit-log/subscriptions/consumer-a"] = new DemoEntityData(
                ActiveTotal: 2,
                DeadLetterTotal: 0,
                ActiveMessages:
                [
                    new SbMessage { MessageId = "audit-a-001", Body = """{"action":"login"}""", ContentType = "application/json", Subject =
"AuditEvent", EnqueuedAt = DateTimeOffset.UtcNow.AddMinutes(-20), DeliveryCount = 1 }
                ],
                DeadLetterMessages: []),
            ["audit-log/subscriptions/consumer-b"] = new DemoEntityData(
                ActiveTotal: 0,
                DeadLetterTotal: 0,
                ActiveMessages: [],
                DeadLetterMessages: [])
        };

        public Task<SbNamespaceInfo> GetNamespaceInfoAsync(CancellationToken ct = default) =>
            Task.FromResult(new SbNamespaceInfo { Name = "demo-namespace", Endpoint = "demo.servicebus.windows.net" });

        public Task<IReadOnlyList<SbEntityInfo>> ListQueuesAsync(CancellationToken ct = default) =>
            Task.FromResult<IReadOnlyList<SbEntityInfo>>(
            [
                new SbEntityInfo { Name = "orders", EntityPath = "orders", Stats = new() { ActiveMessageCount = 42,
DeadLetterMessageCount = 3 } },
                new SbEntityInfo { Name = "payments", EntityPath = "payments", Stats = new() { ActiveMessageCount = 7 } },
                new SbEntityInfo { Name = "notifications", EntityPath = "notifications" },
            ]);

        public Task<IReadOnlyList<SbEntityInfo>> ListTopicsAsync(CancellationToken ct = default) =>
            Task.FromResult<IReadOnlyList<SbEntityInfo>>(
            [
                new SbEntityInfo { Name = "user-events", EntityPath = "user-events", IsTopic = true },
                new SbEntityInfo { Name = "audit-log", EntityPath = "audit-log", IsTopic = true },
            ]);

        public Task<IReadOnlyList<SbEntityInfo>> ListSubscriptionsAsync(string topicName, CancellationToken ct = default) =>
            Task.FromResult<IReadOnlyList<SbEntityInfo>>(
            [
                new SbEntityInfo { Name = "consumer-a", EntityPath = $"{topicName}/subscriptions/consumer-a", IsSubscription = true,
TopicName = topicName, Stats = new() { ActiveMessageCount = 5, DeadLetterMessageCount = 0 } },
                new SbEntityInfo { Name = "consumer-b", EntityPath = $"{topicName}/subscriptions/consumer-b", IsSubscription = true,
TopicName = topicName, Stats = new() { ActiveMessageCount = 0, DeadLetterMessageCount = 0 } },
            ]);

        public Task<SbEntityStats> GetEntityStatsAsync(string entityPath, CancellationToken ct = default) =>
            Task.FromResult(_entityData.TryGetValue(entityPath, out var data)
                ? new SbEntityStats { ActiveMessageCount = data.ActiveTotal, DeadLetterMessageCount = data.DeadLetterTotal }
                : new SbEntityStats());

        public Task<IReadOnlyList<SbMessage>> PeekMessagesAsync(string entityPath, int count, CancellationToken ct = default) =>
            Task.FromResult<IReadOnlyList<SbMessage>>(
                _entityData.TryGetValue(entityPath, out var data)
                    ? data.ActiveMessages.Take(count).ToList()
                    : []);

        public Task<IReadOnlyList<SbMessage>> PeekDeadLetterAsync(string entityPath, int count, CancellationToken ct = default)
=>
            Task.FromResult<IReadOnlyList<SbMessage>>(
                _entityData.TryGetValue(entityPath, out var data)
                    ? data.DeadLetterMessages.Take(count).ToList()
                    : []);

        public Task SendMessageAsync(string entityPath, SbMessage message, CancellationToken ct = default) =>
Task.CompletedTask;
        public Task SendBatchAsync(string entityPath, IReadOnlyList<SbMessage> messages, CancellationToken ct = default) =>
Task.CompletedTask;
        public Task ResubmitDeadLetterAsync(string entityPath, IReadOnlyList<string> sequenceNumbers, string? targetEntityPath,
CancellationToken ct = default) => Task.CompletedTask;
        public Task CompleteDeadLetterAsync(string entityPath, IReadOnlyList<string> sequenceNumbers, CancellationToken ct =
default) => Task.CompletedTask;
        public Task<bool> TestConnectionAsync(CancellationToken ct = default) => Task.FromResult(true);

        private sealed record DemoEntityData(
            long ActiveTotal,
            long DeadLetterTotal,
            IReadOnlyList<SbMessage> ActiveMessages,
            IReadOnlyList<SbMessage> DeadLetterMessages);
    }
}