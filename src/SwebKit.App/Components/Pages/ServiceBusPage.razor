@page "/service-bus"
@inject AppStateService AppState
@inject ICredentialStore CredentialStore
@inject IAppEventBus Events
@inject IJSRuntime JS
@inject ScheduledMessageRepository ScheduledRepo
@inject IConnectionStateService ConnectionState
@implements IDisposable
@inject CommandRegistry Commands
@inject ISelectionContext Selection
@inject PageDataCache Cache

<div class="service-bus-page-shell" style="display:flex; height:100%; overflow:hidden; position:relative;">
    <!-- Left: namespace list + entity trees -->
    <div class="sb-entity-panel @(_isNamespacePaneCollapsed ? "collapsed" : string.Empty)">
        <div class="sb-entity-panel-icon-strip">
            <button type="button" class="namespace-pane-toggle" title="Expand namespace panel"
                    aria-label="Expand namespace panel" aria-expanded="false"
                    @onclick="() => SetNamespacePaneCollapsedAsync(false)">
                ▶
            </button>
            @foreach (var ns in _namespaceStates)
            {
                <button type="button" class="sb-ns-icon-badge" title="@ns.Namespace.Alias"
                        @onclick="() => ExpandNamespaceAsync(ns)">
                    @(ns.Namespace.Alias.Length > 0 ? char.ToUpper(ns.Namespace.Alias[0]).ToString() : "?")
                </button>
            }
        </div>

        <div class="sb-entity-panel-body" style="display:flex; flex-direction:column; height:100%; overflow:hidden;">
            <!-- Namespace panel header -->
            <div
                style="padding:8px 12px; font-size:11px; border-bottom:1px solid var(--color-border); display:flex; align-items:center; justify-content:space-between;">
                <span
                style="color:var(--color-text-muted); text-transform:uppercase; letter-spacing:0.5px;">Namespaces</span>
                <div style="display:flex; gap:4px; align-items:center;">
                    <button
                    style="padding:2px 8px; font-size:11px; cursor:pointer; background:var(--color-accent); color:white; border:none; border-radius:3px;"
                    @onclick="ToggleAddForm">+ Add</button>
                    <button type="button" class="namespace-pane-toggle" title="Collapse namespace panel"
                            aria-label="Collapse namespace panel" aria-expanded="true"
                            @onclick="() => SetNamespacePaneCollapsedAsync(true)">
                        ◀
                    </button>
                </div>
            </div>

            <!-- Add namespace form -->
            @if (_showAddForm)
            {
                <div
                    style="padding:10px 12px; border-bottom:1px solid var(--color-border); background:var(--color-surface);">
                    <div style="font-size:11px; color:var(--color-text-muted); margin-bottom:6px;">Paste a connection
                        string:
                    </div>
                    @if (_showConnStr)
                    {
                        <textarea @bind="_addConnStr" rows="3"
                                  placeholder="Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=..."
                                  style="width:100%; box-sizing:border-box; padding:6px; font-size:11px; background:var(--color-surface-2); color:var(--color-text); border:1px solid var(--color-border); border-radius:3px; resize:none; font-family:monospace;" />
                    }
                    else
                    {
                        <PasswordField Value="@_addConnStr" ValueChanged="@(v => _addConnStr = v ?? string.Empty)"
                                       Label="Connection string"
                                       Placeholder="Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=..."
                                       InputStyle="width:100%; box-sizing:border-box; padding:6px; font-size:11px; background:var(--color-surface-2); color:var(--color-text); border:1px solid var(--color-border); border-radius:3px; font-family:monospace;" />
                    }
                    @if (!string.IsNullOrWhiteSpace(_addError))
                    {
                        <div style="font-size:11px; color:var(--color-error); margin-top:4px;">@_addError</div>
                    }
                    <div style="display:flex; gap:6px; margin-top:6px;">
                        <button
                        style="flex:1; padding:4px; font-size:11px; cursor:pointer; background:var(--color-accent); color:white; border:none; border-radius:3px;"
                        @onclick="AddNamespaceAsync">Add</button>
                        <button
                            style="padding:4px 8px; font-size:11px; cursor:pointer; background:var(--color-surface-2); color:var(--color-text); border:1px solid var(--color-border); border-radius:3px;"
                            @onclick="() => _showConnStr = !_showConnStr"
                            title="@(_showConnStr ? "Hide connection string" : "Show connection string")">@(_showConnStr ?
                                                                             "🙈" : "👁️")</button>
                            <button
                            style="padding:4px 8px; font-size:11px; cursor:pointer; background:var(--color-surface-2); color:var(--color-text); border:1px solid var(--color-border); border-radius:3px;"
                            @onclick="CancelAdd">Cancel</button>
                        </div>
                    </div>
                }

                <!-- Namespace list -->
                <div style="flex:1; overflow-y:auto;">
                    @if (!_namespaceStates.Any())
                    {
                        <div style="padding:16px 12px; font-size:12px; color:var(--color-text-muted);">
                            No namespaces added yet. Click <strong>+ Add</strong> and paste a connection string.
                        </div>
                    }

                    @foreach (var ns in _namespaceStates)
                    {
                        <!-- Namespace header row -->
                        <div style="display:flex; align-items:center; padding:6px 12px; border-bottom:1px solid var(--color-border); cursor:pointer; background:var(--color-surface);"
                             @onclick="() => ToggleNamespace(ns.Namespace.Id)">
                            <span style="margin-right:6px; font-size:10px;">@(ns.IsExpanded ? "▼" : "▶")</span>
                            <span style="flex:1; font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                  title="@ns.Namespace.FullyQualifiedNamespace">@ns.Namespace.Alias</span>
                            @if (ns.IsConnecting)
                            {
                                <span style="font-size:10px; color:var(--color-text-muted);">...</span>
                            }
                            else if (ns.Client is not null)
                            {
                                <span style="color:var(--color-success); display:inline-flex; align-items:center;">
                                    <FluentIcon Value="@(new Icons.Filled.Size12.Circle())" Width="10px" />
                                </span>
                            }
                            else
                            {
                                <span style="color:var(--color-error); display:inline-flex; align-items:center;"
                                      title="@ns.ConnectionError">
                                    <FluentIcon Value="@(new Icons.Filled.Size12.Circle())" Width="10px" />
                                </span>
                            }
                            <button
                                style="margin-left:4px; background:transparent; border:none; color:var(--color-text-muted); cursor:pointer; padding:0 3px; display:inline-flex; align-items:center;"
                                title="View scheduled messages for this namespace" @onclick:stopPropagation="true"
                                @onclick="() => OpenScheduledTab(ns)">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Clock())" Width="14px" />
                            </button>
                            <button
                                style="margin-left:2px; background:transparent; border:none; color:var(--color-text-muted); cursor:pointer; padding:0 2px; display:inline-flex; align-items:center;"
                                title="Remove namespace" @onclick:stopPropagation="true"
                                @onclick="() => RemoveNamespaceAsync(ns.Namespace.Id)">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="12px" />
                            </button>
                        </div>

                        @if (ns.IsExpanded)
                        {
                            @if (ns.ConnectionError is not null && ns.Client is null)
                            {
                                <div style="padding:8px 12px; font-size:11px; color:var(--color-error);">@ns.ConnectionError</div>
                            }
                            else
                            {
                                <EntityTree Client="ns.Client" NamespaceId="ns.Namespace.Id" LinkedEntities="CurrentLinkedEntities"
                                            OnEntitySelected="entity => OpenEntityTab(ns, entity)"
                                            OnEntityModeSelected="selection => OpenEntityTab(ns, selection.Entity, selection.IsDlq)"
                                            OnEntityLinkToggled="link => ToggleEntityLinkAsync(link)" />
                            }
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Right: tabbed content -->
        <div class="service-bus-right-pane" style="flex:1; display:flex; flex-direction:column; overflow:hidden;">
            @if (!_openTabs.Any())
            {
                <div style="padding:40px; text-align:center; color:var(--color-text-muted);">
                    Select a queue or topic from a namespace to open it.
                </div>
            }
            else
            {
                <!-- Tab bar -->
                <div class="tab-bar sb-tab-bar">
                    @foreach (var tab in _openTabs)
                    {
                        <div class="tab-item @(_activeTab?.Id == tab.Id ? "active" : "")" @onclick="() => SetActive(tab)">
                            @if (tab.IsDlq)
                            {
                                <span style="color:var(--color-error); display:inline-flex; align-items:center;">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Width="12px" />
                                </span>
                            }
                            <span style="flex:1; overflow:hidden; text-overflow:ellipsis;">
                                <span style="font-size:10px; color:var(--color-text-muted);">@tab.NamespaceAlias / </span>@tab.Title
                            </span>
                            <span class="close-btn" @onclick:stopPropagation="true" @onclick="() => CloseTab(tab)">&#x2715;</span>
                        </div>
                    }
                </div>
                <!-- Active tab content -->
                @if (_activeTab is not null)
                {
                    @if (_activeTab.IsScheduled)
                    {
                        <ScheduledMessages @key="_activeTab.Id" Client="_activeTab.Client" NamespaceId="_activeTab.NamespaceId"
                                           EntityPath="@_activeTab.EntityPath" />
                    }
                    else if (_activeTab.IsDlq)
                    {
                        <DlqView @key="_activeTab.Id" Client="_activeTab.Client" EntityPath="@_activeTab.EntityPath" />
                    }
                    else
                    {
                        <div @key="_activeTab.Id" class="sb-active-workspace">
                            <div style="flex:1; overflow:hidden; display:flex; flex-direction:column; min-width:0;">
                                <MessageListView Client="_activeTab.Client" EntityPath="@_activeTab.EntityPath"
                                                 NamespaceId="_activeTab.NamespaceId" ShowCompose="true" SelectedMessage="_activeTab.SelectedMessage"
                                                 IsDetailPaneOpen="IsDetailPaneOpen" OnMessageSelected="OnMessageSelectedAsync"
                                                 OnCloseDetails="CloseDetailPane" />
                            </div>
                            @if (IsDetailPaneOpen)
                            {
                                if (_isDetailDrawerOverlay)
                                {
                                    <div class="sb-detail-drawer overlay">
                                        <div class="sb-detail-drawer-header">
                                            <span>Message details</span>
                                            <button type="button" class="sb-detail-close-btn" title="Close details"
                                                    @onclick="CloseDetailPane">×</button>
                                        </div>
                                        <div style="flex:1; overflow:hidden;">
                                            <MessageDetailPane Message="_activeTab.SelectedMessage"
                                                               OnEdit="msg => OpenComposer(msg, MessageComposer.ComposerMode.Edit)"
                                                               OnReplay="msg => OpenComposer(msg, MessageComposer.ComposerMode.Replay)"
                                                               OnSchedule="msg => OpenComposer(msg, MessageComposer.ComposerMode.Schedule)" />
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <ResizablePanel DefaultWidth="380" MinWidth="240" MaxWidth="600">
                                        <div class="sb-detail-drawer">
                                            <div class="sb-detail-drawer-header">
                                                <span>Message details</span>
                                                <button type="button" class="sb-detail-close-btn" title="Close details"
                                                        @onclick="CloseDetailPane">×</button>
                                            </div>
                                            <div style="flex:1; overflow:hidden;">
                                                <MessageDetailPane Message="_activeTab.SelectedMessage"
                                                                   OnEdit="msg => OpenComposer(msg, MessageComposer.ComposerMode.Edit)"
                                                                   OnReplay="msg => OpenComposer(msg, MessageComposer.ComposerMode.Replay)"
                                                                   OnSchedule="msg => OpenComposer(msg, MessageComposer.ComposerMode.Schedule)" />
                                            </div>
                                        </div>
                                    </ResizablePanel>
                                }
                            }
                        </div>
                    }
                }
            }
        </div>
    </div>

    <!-- Modal composer (Edit / Replay / Schedule) -->
    <Modal IsOpen="@(_composerMessage is not null && _activeTab is not null)" OnClose="CloseComposer">
        @if (_composerMessage is not null && _activeTab is not null)
        {
            <MessageComposer Client="_activeTab.Client" EntityPath="@_activeTab.EntityPath" IsProduction="false"
                             Mode="_composerMode" PrefillMessage="_composerMessage" AvailableNamespaces="@AvailableNamespaceOptions"
                             OwnerNamespaceId="_activeTab.NamespaceId" ScheduledRepo="ScheduledRepo" OnSent="OnComposerSent"
                             OnClose="CloseComposer" />
        }
    </Modal>

@code {
    private List<NsState> _namespaceStates = [];
    private List<SbTab> _openTabs = [];
    private SbTab? _activeTab;
    private bool _showAddForm;
    private bool _isNamespacePaneCollapsed;
    private string _addConnStr = string.Empty;
    private string? _addError;
    private bool _showConnStr;
    private bool _isDetailDrawerOverlay;
    private CancellationTokenSource _cts = new();

    private const string NamespacePaneStateKey = "sb:namespace-pane-collapsed";
    private const int DetailOverlayBreakpoint = 1400;

    private bool IsDetailPaneOpen => _activeTab?.SelectedMessage is not null;

    // Composer modal state
    private SbMessage? _composerMessage;
    private MessageComposer.ComposerMode _composerMode;

    private IReadOnlyList<MessageComposer.NamespaceOption> AvailableNamespaceOptions =>
    _namespaceStates
    .Where(s => s.Client is not null)
    .Select(s => new MessageComposer.NamespaceOption(s.Namespace.Id, s.Namespace.Alias, s.Client!))
    .ToList();

    private void OpenComposer(SbMessage msg, MessageComposer.ComposerMode mode)
    {
        _composerMessage = msg;
        _composerMode = mode;
        StateHasChanged();
    }

    private void CloseComposer()
    {
        _composerMessage = null;
        StateHasChanged();
    }

    private async Task OnMessageSelectedAsync(SbMessage? msg)
    {
        if (_activeTab is null) return;
        _activeTab.SelectedMessage = msg;
        Selection.SetSelection("service-bus", msg);
        if (msg is not null)
        {
            var width = await JS.InvokeAsync<int>("SwebKitUi.getWindowWidth");
            _isDetailDrawerOverlay = width > 0 && width < DetailOverlayBreakpoint;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseDetailPane()
    {
        if (_activeTab is null) return;
        _activeTab.SelectedMessage = null;
        Selection.SetSelection("service-bus", null);
        await InvokeAsync(StateHasChanged);
    }

    private Task OnComposerSent(ScheduledMessageEntry? _)
    {
        CloseComposer();
        return Task.CompletedTask;
    }

    private IReadOnlyList<SbEntityLink> CurrentLinkedEntities =>
    AppState.Config.ServiceBusEntityLinks;

    protected override async Task OnInitializedAsync()
    {
        Events.Subscribe<ServiceBusShortcutEvent>(OnServiceBusShortcut);
        RegisterSbCommands();
        await ScheduledRepo.LoadAsync();
        await LoadNamespacesAsync();
    }

    private void RegisterSbCommands()
    {
        Commands.Register(new AppCommand
        {
            Id = "sb-peek",
            Label = "Peek Messages",
            Category = "Service Bus",
            AreaScope = "service-bus",
            Execute = () => { Events.Publish(new RefreshRequestedEvent("service-bus")); return Task.CompletedTask; }
        });
        Commands.Register(new AppCommand
        {
            Id = "sb-resubmit",
            Label = "Resubmit Selected Message",
            Category = "Service Bus",
            AreaScope = "service-bus",
            IsAvailable = () => _activeTab?.SelectedMessage is not null,
            Execute = () =>
            {
                if (_activeTab?.SelectedMessage is not null)
                    Events.Publish(new ServiceBusShortcutEvent("Replay"));
                return Task.CompletedTask;
            }
        });
        Commands.Register(new AppCommand
        {
            Id = "sb-edit-resubmit",
            Label = "Edit & Resubmit Selected",
            Category = "Service Bus",
            AreaScope = "service-bus",
            IsAvailable = () => _activeTab?.SelectedMessage is not null,
            Execute = () =>
            {
                if (_activeTab?.SelectedMessage is not null)
                    Events.Publish(new ServiceBusShortcutEvent("Edit"));
                return Task.CompletedTask;
            }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var stored = await JS.InvokeAsync<string?>("SwebKitUi.getLocalStorage", NamespacePaneStateKey);
        if (bool.TryParse(stored, out var collapsed))
            _isNamespacePaneCollapsed = collapsed;
        if (_isNamespacePaneCollapsed)
            _showAddForm = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadNamespacesAsync()
    {
        // Cancel any in-flight connections from a previous load
        await _cts.CancelAsync();
        _cts.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        // PERF-8: Build all states immediately so the UI shows namespace list with loading indicators
        var incoming = AppState.ServiceBusNamespaces;

        // Restore cached structural snapshot for instant back-navigation rendering
        var cached = Cache.Get<SbPageSnapshot>("servicebus");
        if (cached is not null)
        {
            var lookup = cached.Namespaces.ToDictionary(n => n.Config.Id);
            _namespaceStates = incoming.Select(ns =>
            {
                if (lookup.TryGetValue(ns.Id, out var snap))
                    return new NsState
                    {
                        Namespace = ns,
                        IsExpanded = true,
                        IsConnecting = snap.WasConnected, // will reconnect in background
                        ConnectionError = snap.WasConnected ? null : snap.Error
                    };
                return new NsState { Namespace = ns, IsExpanded = true, IsConnecting = true };
            }).ToList();
        }
        else
        {
            _namespaceStates = incoming.Select(ns => new NsState
            {
                Namespace = ns,
                IsExpanded = true,
                IsConnecting = true
            }).ToList();
        }

        if (AppState.UseDemoData)
            AddDemoNamespace();

        StateHasChanged();

        // Connect each namespace independently — render as each completes
        var tasks = _namespaceStates
            .Where(s => s.Client is null && s.ConnectionError is null)
            .Select(async state =>
            {
                state.Client = await TryConnectAsync(state.Namespace, state, ct);
                if (!ct.IsCancellationRequested)
                    await InvokeAsync(StateHasChanged); // BL-2
            });

        await Task.WhenAll(tasks);

        if (ct.IsCancellationRequested) return;

        ReportConnectionState();
        await InvokeAsync(StateHasChanged); // BL-2

        // Save structural snapshot for instant back-navigation
        Cache.Set("servicebus", new SbPageSnapshot(
            _namespaceStates.Select(s => new SbNamespaceSnapshot(
                s.Namespace, s.Client is not null, s.ConnectionError)).ToList()));
    }

    private void ReportConnectionState()
    {
        if (!AppState.UseDemoData && _namespaceStates.Count == 0)
        {
            ConnectionState.SetNotConfigured("service-bus");
            return;
        }
        var connected = _namespaceStates.Any(s => s.Client is not null);
        if (connected)
        {
            ConnectionState.SetConnected("service-bus");
        }
        else
        {
            var firstError = _namespaceStates.FirstOrDefault(s => s.ConnectionError is not null)?.ConnectionError;
            ConnectionState.SetError("service-bus", firstError ?? "All namespaces failed to connect.");
        }
    }

    private async Task<IServiceBusClient?> TryConnectAsync(ServiceBusNamespace ns, NsState state, CancellationToken ct =
default)
    {
        try
        {
            var connStr = CredentialStore.Get(ns.CredentialKey);
            if (string.IsNullOrWhiteSpace(connStr))
            {
                state.ConnectionError = "Connection string not found in credential store.";
                state.IsConnecting = false;
                return null;
            }

            var client = new SwebKit.Azure.ServiceBus.AzureServiceBusClient(connStr);
            var ok = await client.TestConnectionAsync(ct);
            state.IsConnecting = false;
            if (!ok)
            {
                state.ConnectionError = "Connection test failed. Check the connection string.";
                await client.DisposeAsync();
                return null;
            }

            return client;
        }
        catch (OperationCanceledException)
        {
            state.IsConnecting = false;
            return null;
        }
        catch (Exception ex)
        {
            state.IsConnecting = false;
            state.ConnectionError = ex.Message;
            return null;
        }
    }

    private void ToggleAddForm()
    {
        _showAddForm = !_showAddForm;
        _addConnStr = string.Empty;
        _addError = null;
        _showConnStr = false;
    }

    private void CancelAdd()
    {
        _showAddForm = false;
        _addConnStr = string.Empty;
        _addError = null;
        _showConnStr = false;
    }

    private async Task SetNamespacePaneCollapsedAsync(bool isCollapsed)
    {
        _isNamespacePaneCollapsed = isCollapsed;
        if (_isNamespacePaneCollapsed)
            _showAddForm = false;
        await JS.InvokeVoidAsync("SwebKitUi.setLocalStorage", NamespacePaneStateKey, isCollapsed.ToString().ToLowerInvariant());
    }

    private async Task ExpandNamespaceAsync(NsState ns)
    {
        await SetNamespacePaneCollapsedAsync(false);
        ns.IsExpanded = true;
        StateHasChanged();
    }

    private async Task AddNamespaceAsync()
    {
        _addError = null;
        var raw = _addConnStr.Trim();
        if (string.IsNullOrWhiteSpace(raw))
        {
            _addError = "Connection string is required.";
            return;
        }

        string fqns;
        try
        {
            var props = global::Azure.Messaging.ServiceBus.ServiceBusConnectionStringProperties.Parse(raw);
            fqns = props.FullyQualifiedNamespace;
            if (string.IsNullOrWhiteSpace(fqns))
                throw new FormatException("Could not determine namespace from connection string.");
        }
        catch (Exception ex)
        {
            _addError = $"Invalid connection string: {ex.Message}";
            return;
        }

        // Avoid duplicates
        if (AppState.ServiceBusNamespaces.Any(n => n.FullyQualifiedNamespace.Equals(fqns, StringComparison.OrdinalIgnoreCase)))
        {
            _addError = "This namespace is already added.";
            return;
        }

        var credKey = $"sb:ns:{Guid.NewGuid()}";
        CredentialStore.Save(credKey, raw);

        var ns = new ServiceBusNamespace
        {
            Alias = fqns.Split('.')[0],
            FullyQualifiedNamespace = fqns,
            CredentialKey = credKey
        };

        await AppState.AddServiceBusNamespaceAsync(ns);

        var state = new NsState { Namespace = ns, IsExpanded = true, IsConnecting = true };
        _namespaceStates.Add(state);
        _showAddForm = false;
        _addConnStr = string.Empty;
        _showConnStr = false;
        StateHasChanged();

        state.Client = await TryConnectAsync(ns, state, _cts.Token);
        StateHasChanged();
    }

    private async Task RemoveNamespaceAsync(Guid namespaceId)
    {
        var state = _namespaceStates.FirstOrDefault(s => s.Namespace.Id == namespaceId);
        if (state is null) return;

        // Close tabs belonging to this namespace
        var tabsToClose = _openTabs.Where(t => t.NamespaceId == namespaceId).ToList();
        foreach (var tab in tabsToClose) _openTabs.Remove(tab);
        if (_activeTab is not null && tabsToClose.Contains(_activeTab))
            _activeTab = _openTabs.LastOrDefault();

        // Dispose client
        if (state.Client is IAsyncDisposable d) await d.DisposeAsync();

        // Remove credential
        CredentialStore.Delete(state.Namespace.CredentialKey);

        _namespaceStates.Remove(state);
        await AppState.RemoveServiceBusNamespaceAsync(namespaceId);
        StateHasChanged();
    }

    private void ToggleNamespace(Guid id)
    {
        var ns = _namespaceStates.FirstOrDefault(s => s.Namespace.Id == id);
        if (ns is not null) ns.IsExpanded = !ns.IsExpanded;
        StateHasChanged();
    }

    private void OpenEntityTab(NsState ns, SbEntityInfo entity, bool isDlq = false)
    {
        if (ns.Client is null) return;
        var modeSuffix = isDlq ? "dlq" : "active";
        var id = $"{ns.Namespace.Id}:{entity.EntityPath}:{modeSuffix}";
        var existing = _openTabs.FirstOrDefault(t => t.Id == id);
        if (existing is not null) { _activeTab = existing; StateHasChanged(); return; }

        var tab = new SbTab
        {
            Id = id,
            NamespaceId = ns.Namespace.Id,
            NamespaceAlias = ns.Namespace.Alias,
            Title = isDlq ? $"{entity.Name} (DLQ)" : entity.Name,
            EntityPath = entity.EntityPath,
            Client = ns.Client,
            IsDlq = isDlq
        };
        _openTabs.Add(tab);
        _activeTab = tab;
        StateHasChanged();
    }

    private void OpenScheduledTab(NsState ns)
    {
        if (ns.Client is null) return;
        var id = $"{ns.Namespace.Id}:scheduled";
        var existing = _openTabs.FirstOrDefault(t => t.Id == id);
        if (existing is not null) { _activeTab = existing; StateHasChanged(); return; }

        var tab = new SbTab
        {
            Id = id,
            NamespaceId = ns.Namespace.Id,
            NamespaceAlias = ns.Namespace.Alias,
            Title = "Scheduled",
            EntityPath = string.Empty,
            Client = ns.Client,
            IsScheduled = true
        };
        _openTabs.Add(tab);
        _activeTab = tab;
        StateHasChanged();
    }

    private async Task ToggleEntityLinkAsync(SbEntityLink link)
    {
        var existing = AppState.Config.ServiceBusEntityLinks
        .FirstOrDefault(l => l.NamespaceId == link.NamespaceId && l.EntityPath == link.EntityPath);

        if (existing is not null)
            AppState.Config.ServiceBusEntityLinks.Remove(existing);
        else
            AppState.Config.ServiceBusEntityLinks.Add(link);

        await AppState.SaveConfigAsync();
        StateHasChanged();
    }

    private Task SetActive(SbTab tab)
    {
        _activeTab = tab;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void CloseTab(SbTab tab)
    {
        _openTabs.Remove(tab);
        if (_activeTab == tab) _activeTab = _openTabs.LastOrDefault();
        StateHasChanged();
    }

    private void OnServiceBusShortcut(ServiceBusShortcutEvent e) => InvokeAsync(() =>
    {
        if (_activeTab is null || _activeTab.IsDlq || _activeTab.IsScheduled) return;
        var msg = _activeTab.SelectedMessage;

        switch (e.Action)
        {
            case "Edit" when msg is not null:
                OpenComposer(msg, MessageComposer.ComposerMode.Edit);
                break;
            case "Replay" when msg is not null:
                OpenComposer(msg, MessageComposer.ComposerMode.Replay);
                break;
            case "Schedule" when msg is not null:
                OpenComposer(msg, MessageComposer.ComposerMode.Schedule);
                break;
            case "Peek":
                Events.Publish(new RefreshRequestedEvent("service-bus"));
                break;
        }
    });

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        Events.Unsubscribe<ServiceBusShortcutEvent>(OnServiceBusShortcut);
        foreach (var id in new[] { "sb-peek", "sb-resubmit", "sb-edit-resubmit" })
            Commands.Unregister(id);
        Selection.SetSelection("service-bus", null);
        foreach (var ns in _namespaceStates)
            if (ns.Client is IAsyncDisposable d) _ = d.DisposeAsync().AsTask();
    }

    private static readonly Guid DemoNamespaceId1 = new("00000000-0000-0000-0000-000000000001");
    private static readonly Guid DemoNamespaceId2 = new("00000000-0000-0000-0000-000000000002");

    private void AddDemoNamespace()
    {
        if (_namespaceStates.Any(s => s.Namespace.Id == DemoNamespaceId1)) return;

        _namespaceStates.Add(new NsState
        {
            Namespace = new ServiceBusNamespace
            {
                Id = DemoNamespaceId1,
                Alias = "orders-dev",
                FullyQualifiedNamespace = "orders-dev.servicebus.windows.net",
                CredentialKey = string.Empty
            },
            IsExpanded = true,
            IsConnecting = false,
            Client = SwebKit.Core.Services.DemoServiceBusClient.OrdersDev()
        });

        _namespaceStates.Add(new NsState
        {
            Namespace = new ServiceBusNamespace
            {
                Id = DemoNamespaceId2,
                Alias = "payments-dev",
                FullyQualifiedNamespace = "payments-dev.servicebus.windows.net",
                CredentialKey = string.Empty
            },
            IsExpanded = false,
            IsConnecting = false,
            Client = SwebKit.Core.Services.DemoServiceBusClient.PaymentsDev()
        });

        StateHasChanged();
    }

    private class NsState
    {
        public required ServiceBusNamespace Namespace { get; set; }
        public IServiceBusClient? Client { get; set; }
        public bool IsExpanded { get; set; }
        public bool IsConnecting { get; set; }
        public string? ConnectionError { get; set; }
    }

    private class SbTab
    {
        public required string Id { get; set; }
        public required Guid NamespaceId { get; set; }
        public required string NamespaceAlias { get; set; }
        public required string Title { get; set; }
        public required string EntityPath { get; set; }
        public required IServiceBusClient Client { get; set; }
        public bool IsDlq { get; set; }
        public bool IsScheduled { get; set; }
        public SbMessage? SelectedMessage { get; set; }
    }

    private sealed record SbPageSnapshot(
        List<SbNamespaceSnapshot> Namespaces);

    private sealed record SbNamespaceSnapshot(
        ServiceBusNamespace Config,
        bool WasConnected,
        string? Error);

