@using SwebKit.Core.Domain

<div style="display:grid; gap:10px; padding:12px 0;">
    <FluentTextField Label="Namespace / Hostname" @bind-Value="NamespaceHostname" style="width:100%;"
                     Placeholder="my-namespace or my-namespace.servicebus.windows.net" />

    <div style="display:grid; gap:6px;">
        <label style="font-size:12px; color:var(--color-text-muted);">Authentication</label>
        <select @bind="AuthMode"
                style="padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px; font-size:12px;">
            <option value="DefaultAzureCredential">Default Azure Credential</option>
            <option value="ConnectionString">Connection String (stored in Windows Credential Manager)</option>
        </select>
    </div>

    @if (AuthMode == "ConnectionString")
    {
        <FluentTextField Label="Connection String" @bind-Value="ConnectionString" TextFieldType="TextFieldType.Password"
                         style="width:100%;" Placeholder="Endpoint=sb://..." />
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div style="font-size:12px; color:var(--color-error);">@ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div style="font-size:12px; color:var(--color-success);">@SuccessMessage</div>
    }

    <div>
        <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync">Save Service Bus Settings</FluentButton>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProjectEnvironment Environment { get; set; } = default!;
    [Parameter, EditorRequired] public ICredentialStore CredentialStore { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private string NamespaceHostname = string.Empty;
    private string AuthMode = nameof(SbAuthMode.DefaultAzureCredential);
    private string ConnectionString = string.Empty;
    private Guid _loadedEnvironmentId;
    private string? ErrorMessage;
    private string? SuccessMessage;

    protected override void OnParametersSet()
    {
        if (_loadedEnvironmentId == Environment.Id) return;

        var config = Environment.ServiceBusConfig;
        NamespaceHostname = config?.NamespaceHostname ?? string.Empty;
        AuthMode = config?.AuthMode == SbAuthMode.ConnectionString
            ? nameof(SbAuthMode.ConnectionString)
            : nameof(SbAuthMode.DefaultAzureCredential);

        if (config?.CredentialRef is not null)
        {
            ConnectionString = CredentialStore.Get(config.CredentialRef) ?? string.Empty;
        }

        _loadedEnvironmentId = Environment.Id;
    }

    private async Task SaveAsync()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (string.IsNullOrWhiteSpace(NamespaceHostname))
        {
            ErrorMessage = "Namespace / hostname is required.";
            return;
        }

        var useConnectionString = AuthMode == nameof(SbAuthMode.ConnectionString);
        if (useConnectionString && string.IsNullOrWhiteSpace(ConnectionString))
        {
            ErrorMessage = "Connection string is required when Connection String auth is selected.";
            return;
        }

        var config = Environment.ServiceBusConfig ??= new ServiceBusConfig { NamespaceHostname = string.Empty };
        config.NamespaceHostname = NamespaceHostname.Trim();
        config.AuthMode = useConnectionString
            ? SbAuthMode.ConnectionString
            : SbAuthMode.DefaultAzureCredential;

        if (config.AuthMode == SbAuthMode.ConnectionString)
        {
            var key = config.CredentialRef ?? $"project:{Environment.ProjectId}:env:{Environment.Id}:servicebus";
            config.CredentialRef = key;
            if (!string.IsNullOrWhiteSpace(ConnectionString))
            {
                CredentialStore.Save(key, ConnectionString.Trim());
            }
        }
        else
        {
            if (config.CredentialRef is not null)
            {
                CredentialStore.Delete(config.CredentialRef);
                config.CredentialRef = null;
            }
        }

        await OnSaved.InvokeAsync();
        SuccessMessage = "Service Bus settings saved.";
    }
}