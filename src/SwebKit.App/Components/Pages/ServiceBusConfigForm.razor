@using SwebKit.Core.Domain
@inject AppStateService AppState

@* Displays and manages the Service Bus entity links pinned to this environment. *@
<div style="display:grid; gap:10px; padding:12px 0;">

    <div style="font-size:12px; color:var(--color-text-muted);">
        Pin queues or subscriptions from your global namespaces to this environment.
        You can pin entities from the Service Bus page (📍 icon next to each entity).
    </div>

    @if (!Environment.ServiceBusEntityLinks.Any())
    {
        <div style="font-size:12px; color:var(--color-text-muted); padding:8px; background:var(--color-surface); border-radius:4px;">
            No entities pinned yet.
        </div>
    }
    else
    {
        <div style="display:grid; gap:4px;">
            @foreach (var link in Environment.ServiceBusEntityLinks.ToList())
            {
                var ns = AppState.ServiceBusNamespaces.FirstOrDefault(n => n.Id == link.NamespaceId);
                <div style="display:flex; align-items:center; gap:8px; padding:6px 8px; background:var(--color-surface); border-radius:4px; font-size:12px;">
                    <span style="flex:1; overflow:hidden; text-overflow:ellipsis;">
                        <span style="color:var(--color-text-muted);">@(ns?.Alias ?? link.NamespaceId.ToString("N")[..8])</span>
                        <span style="margin:0 4px;">/</span>
                        @link.EntityPath
                    </span>
                    <button style="background:transparent; border:none; color:var(--color-error); cursor:pointer; font-size:13px;"
                            title="Remove link"
                            @onclick="() => RemoveLinkAsync(link)">✕</button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public AppConfig Environment { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private async Task RemoveLinkAsync(SbEntityLink link)
    {
        Environment.ServiceBusEntityLinks.Remove(link);
        await OnSaved.InvokeAsync();
    }
}
