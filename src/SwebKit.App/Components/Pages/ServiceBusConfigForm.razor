@using SwebKit.Core.Domain
@inject AppStateService AppState
@inject ICredentialStore CredentialStore
@inject IMonitoringConnectionPool MonitoringPool
@inject IServiceBusNamespaceBootstrapper NamespaceBootstrapper

@* Displays and manages global Service Bus namespaces and entity links pinned to the current configuration. *@
<div class="sb-settings-shell">

    <div class="sb-settings-section">
        <label class="app-form-field__label">Namespaces</label>
        <p class="app-form-field__hint">
            Connect with Entra ID (recommended) or a connection string.
            Entities can then be pinned from the Service Bus page.
        </p>

        @foreach (var ns in AppState.ServiceBusNamespaces.ToList())
        {
            var rs = GetReconnectState(ns.Id);
            <div class="sb-settings-ns-row">
                <span class="sb-settings-ns-row__alias" title="@ns.Alias">@ns.Alias</span>
                <span class="sb-settings-ns-row__fqns" title="@ns.FullyQualifiedNamespace">@ns.FullyQualifiedNamespace</span>
                <span class="sb-settings-ns-row__badge sb-settings-ns-row__badge--@(ns.AuthMode == SbAuthMode.DefaultAzureCredential ? "entra" : "key")">
                    @(ns.AuthMode == SbAuthMode.DefaultAzureCredential ? "Entra ID" : "Key")
                </span>
                <AppIconButton Label="Refresh connection"
                               Title="@(rs.Status == ReconnectStatus.Error ? rs.Error : "Refresh connection / re-authenticate")"
                               Size="Small" Variant="Ghost"
                               Loading="@(rs.Status == ReconnectStatus.Connecting)"
                               OnClick="() => ReconnectAsync(ns)">
                    <Icon>
                        @if (rs.Status == ReconnectStatus.Success) { <span class="sb-settings-reconnect-ok">✓</span> }
                        else if (rs.Status == ReconnectStatus.Error) { <span class="sb-settings-reconnect-err">✗</span> }
                        else { <span>↺</span> }
                    </Icon>
                </AppIconButton>
                <button type="button" class="sb-settings-ns-row__remove" title="Remove namespace"
                        @onclick="() => RemoveNamespaceAsync(ns)">×</button>
            </div>
            @if (rs.Status == ReconnectStatus.Error && !string.IsNullOrWhiteSpace(rs.Error))
            {
                <div class="sb-settings-ns-inline-error">@rs.Error</div>
            }
        }

        @if (_showAddForm)
        {
            <div class="sb-settings-add-form">
                <div class="sb-settings-add-form__auth-section">
                    <span class="app-form-field__label sb-settings-add-form__auth-label">Authentication</span>
                    <SegmentedControl Items="@_authModeItems"
                                      Value="@_authModeDisplay"
                                      ValueChanged="@OnAuthModeChanged"
                                      Size="Small" />
                    <p class="app-form-field__hint">
                        @if (_addAuthMode == SbAuthMode.DefaultAzureCredential)
                        {
                            <span>Uses your current Azure identity (az cli, VS Code, managed identity, etc.)</span>
                        }
                        else
                        {
                            <span>Uses a SAS connection string with shared access key.</span>
                        }
                    </p>
                </div>

                @if (_addAuthMode == SbAuthMode.DefaultAzureCredential)
                {
                    <FormField Label="Namespace hostname" Hint="e.g. myns or myns.servicebus.windows.net">
                        <input type="text" class="app-native-control sb-settings-add-form__input"
                               placeholder="myns.servicebus.windows.net"
                               value="@_addHostname"
                               @oninput="@(e => _addHostname = e.Value?.ToString() ?? string.Empty)" />
                    </FormField>
                }
                else
                {
                    <PasswordField Value="@_addConnStr" ValueChanged="@(v => _addConnStr = v ?? string.Empty)"
                                   Label="Connection string"
                                   Placeholder="Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=..."
                                   InputClass="app-native-control sb-settings-add-form__input" />
                }

                @if (!string.IsNullOrWhiteSpace(_addError))
                {
                    <div class="app-form-field__error">@_addError</div>
                }
                <div class="sb-settings-add-form__actions">
                    <AppButton Variant="Primary" Size="Small" OnClick="OnAddClickAsync">Add</AppButton>
                    <AppButton Variant="Ghost" Size="Small" OnClick="OnCancelClick">Cancel</AppButton>
                </div>
            </div>
        }
        else
        {
            <button type="button" class="sb-settings-add-btn" @onclick="() => _showAddForm = true">
                + Add namespace
            </button>
        }
    </div>

    <div class="sb-settings-section">
        <label class="app-form-field__label">Pinned entities</label>
        <p class="app-form-field__hint">
            Pin queues or subscriptions from your global namespaces to the current configuration.
            You can pin entities from the Service Bus page (📍 icon next to each entity).
        </p>

        @if (!Environment.ServiceBusEntityLinks.Any())
        {
            <div class="sb-settings-empty">No entities pinned yet.</div>
        }
        else
        {
            <div class="sb-settings-link-list">
                @foreach (var link in Environment.ServiceBusEntityLinks.ToList())
                {
                    var ns = AppState.ServiceBusNamespaces.FirstOrDefault(n => n.Id == link.NamespaceId);
                    <div class="sb-settings-link-row">
                        <span class="sb-settings-link-row__label">
                            <span class="sb-settings-link-row__ns">@(ns?.Alias ?? link.NamespaceId.ToString("N")[..8])</span>
                            <span class="sb-settings-link-row__sep">/</span>@link.EntityPath
                        </span>
                        <button type="button" class="sb-settings-link-row__remove" title="Remove link"
                                @onclick="() => RemoveLinkAsync(link)">✕</button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private enum ReconnectStatus { Idle, Connecting, Success, Error }
    private record ReconnectState(ReconnectStatus Status, string? Error = null);
    private static readonly ReconnectState Idle = new(ReconnectStatus.Idle);

    private static readonly IReadOnlyList<string> _authModeItems = ["Entra ID", "Connection string"];

    [Parameter, EditorRequired] public AppConfig Environment { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _showAddForm;
    private SbAuthMode _addAuthMode = SbAuthMode.DefaultAzureCredential;
    private string _authModeDisplay = "Entra ID";
    private string _addHostname = string.Empty;
    private string _addConnStr = string.Empty;
    private string? _addError;

    private readonly Dictionary<Guid, ReconnectState> _reconnectStates = new();

    private ReconnectState GetReconnectState(Guid id) =>
        _reconnectStates.TryGetValue(id, out var s) ? s : Idle;

    private void OnAuthModeChanged(string? value)
    {
        _authModeDisplay = value ?? "Entra ID";
        _addAuthMode = value == "Connection string" ? SbAuthMode.ConnectionString : SbAuthMode.DefaultAzureCredential;
        _addError = null;
    }

    private Task OnAddClickAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs _) => HandleAddAsync();
    private void OnCancelClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs _) => CancelAdd();

    private async Task ReconnectAsync(ServiceBusNamespace ns)
    {
        _reconnectStates[ns.Id] = new(ReconnectStatus.Connecting);
        StateHasChanged();

        try
        {
            MonitoringPool.EvictServiceBusClient(ns.Alias);
            var result = await NamespaceBootstrapper.ConnectAsync(ns);
            _reconnectStates[ns.Id] = result.ConnectionError is null
                ? new(ReconnectStatus.Success)
                : new(ReconnectStatus.Error, result.ConnectionError);
        }
        catch (Exception ex)
        {
            _reconnectStates[ns.Id] = new(ReconnectStatus.Error, ex.Message);
        }

        StateHasChanged();
    }

    private async Task HandleAddAsync()
    {
        _addError = null;

        if (_addAuthMode == SbAuthMode.DefaultAzureCredential)
            await HandleAddEntraAsync();
        else
            await HandleAddConnectionStringAsync();
    }

    private async Task HandleAddEntraAsync()
    {
        var raw = _addHostname.Trim();
        if (string.IsNullOrWhiteSpace(raw))
        {
            _addError = "Namespace hostname is required.";
            return;
        }

        var fqns = raw.Contains('.') ? raw : $"{raw}.servicebus.windows.net";

        if (AppState.ServiceBusNamespaces.Any(n => n.FullyQualifiedNamespace.Equals(fqns, StringComparison.OrdinalIgnoreCase)))
        {
            _addError = "This namespace is already added.";
            return;
        }

        var ns = new ServiceBusNamespace
        {
            Alias = fqns.Split('.')[0],
            FullyQualifiedNamespace = fqns,
            AuthMode = SbAuthMode.DefaultAzureCredential,
            CredentialKey = string.Empty
        };

        await AppState.AddServiceBusNamespaceAsync(ns);
        _showAddForm = false;
        _addHostname = string.Empty;
    }

    private async Task HandleAddConnectionStringAsync()
    {
        var raw = _addConnStr.Trim();
        if (string.IsNullOrWhiteSpace(raw))
        {
            _addError = "Connection string is required.";
            return;
        }

        string fqns;
        try
        {
            var props = global::Azure.Messaging.ServiceBus.ServiceBusConnectionStringProperties.Parse(raw);
            fqns = props.FullyQualifiedNamespace;
            if (string.IsNullOrWhiteSpace(fqns))
                throw new FormatException("Could not determine namespace from connection string.");
        }
        catch (Exception ex)
        {
            _addError = $"Invalid connection string: {ex.Message}";
            return;
        }

        if (AppState.ServiceBusNamespaces.Any(n => n.FullyQualifiedNamespace.Equals(fqns, StringComparison.OrdinalIgnoreCase)))
        {
            _addError = "This namespace is already added.";
            return;
        }

        var credKey = $"sb:ns:{Guid.NewGuid()}";
        CredentialStore.Save(credKey, raw);

        var ns = new ServiceBusNamespace
        {
            Alias = fqns.Split('.')[0],
            FullyQualifiedNamespace = fqns,
            AuthMode = SbAuthMode.ConnectionString,
            CredentialKey = credKey
        };

        await AppState.AddServiceBusNamespaceAsync(ns);
        _showAddForm = false;
        _addConnStr = string.Empty;
    }

    private async Task RemoveNamespaceAsync(ServiceBusNamespace ns)
    {
        _reconnectStates.Remove(ns.Id);
        if (!string.IsNullOrWhiteSpace(ns.CredentialKey))
            CredentialStore.Delete(ns.CredentialKey);
        await AppState.RemoveServiceBusNamespaceAsync(ns.Id);
    }

    private void CancelAdd()
    {
        _showAddForm = false;
        _addHostname = string.Empty;
        _addConnStr = string.Empty;
        _addError = null;
    }

    private async Task RemoveLinkAsync(SbEntityLink link)
    {
        Environment.ServiceBusEntityLinks.Remove(link);
        await OnSaved.InvokeAsync();
    }
}

