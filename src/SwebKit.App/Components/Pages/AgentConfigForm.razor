@using SwebKit.Core.Domain
@inject UserSettingsRepository UserSettings
@inject ICredentialStore CredentialStore

<div style="display:grid; gap:12px; padding:12px 0;">
    <div style="display:grid; gap:4px;">
        <label style="font-size:12px; color:var(--color-text-muted);">Mistral API Key</label>
        <PasswordField Value="@ApiKey" ValueChanged="@(v => ApiKey = v ?? string.Empty)" Label="Mistral API Key"
                       Placeholder="Enter Mistral API key (stored securely in Windows Credential Manager)" />
        <span style="font-size:12px; color:var(--color-text-muted);">
            Your Mistral AI API key. This is stored securely in Windows Credential Manager and never persisted in plain text.
        </span>
    </div>

    <div style="display:grid; gap:4px;">
        <label style="font-size:12px; color:var(--color-text-muted);">Model Override</label>
        <input type="text" @bind="ModelOverride" @bind:event="oninput"
               style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px;"
               placeholder="mistral-medium-latest" />
        <span style="font-size:12px; color:var(--color-text-muted);">
            Override the default Mistral model. Leave empty to use the application default (mistral-medium-latest).
        </span>
    </div>

    <div style="display:grid; gap:4px;">
        <label style="font-size:12px; color:var(--color-text-muted);">Maximum History Messages</label>
        <input type="number" @bind="MaxHistoryMessages" @bind:event="oninput"
               style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px;"
               placeholder="20" min="1" max="100" />
        <span style="font-size:12px; color:var(--color-text-muted);">
            Maximum number of messages to keep in conversation history (each exchange counts as 2 messages).
        </span>
    </div>

    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-top:12px;">
        <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync">Save</FluentButton>

        <FluentCheckbox Value="@IsEnabled" ValueChanged="@(async v => { IsEnabled = v; UserSettings.Settings.Agent.IsEnabled = v; await UserSettings.SaveAsync(); await OnSaved.InvokeAsync(); })">
            Show Agent in top bar
        </FluentCheckbox>

        @if (StatusMessage is not null)
        {
            <span
            style="font-size:12px; color:@(StatusOk ? "var(--color-success)" : "var(--color-error)");">@StatusMessage</span>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private string ApiKey = string.Empty;
    private string ModelOverride = string.Empty;
    private int MaxHistoryMessages = 20;
    private bool IsEnabled;
    private string? StatusMessage;
    private bool StatusOk;

    private const string ApiKeyCredentialKey = "SwebKit-Agent:Mistral-ApiKey";

    protected override void OnParametersSet()
    {
        // Load current values from UserSettings
        var agentConfig = UserSettings.Settings.Agent;
        IsEnabled = agentConfig.IsEnabled;
        ModelOverride = agentConfig.ModelOverride;
        MaxHistoryMessages = agentConfig.MaxHistoryMessages;
        
        // Try to get saved API key from credential store
        ApiKey = CredentialStore.Get(ApiKeyCredentialKey) ?? string.Empty;
        
        StatusMessage = null;
    }

    private async Task SaveAsync()
    {
        // Save API key to credential store
        if (!string.IsNullOrWhiteSpace(ApiKey))
        {
            CredentialStore.Save(ApiKeyCredentialKey, ApiKey);
        }
        else
        {
            // If user cleared the API key, remove it from the store
            CredentialStore.Delete(ApiKeyCredentialKey);
        }

        // Save agent configuration to UserSettings
        UserSettings.Settings.Agent.IsEnabled = IsEnabled;
        UserSettings.Settings.Agent.ModelOverride = ModelOverride;
        UserSettings.Settings.Agent.MaxHistoryMessages = MaxHistoryMessages;
        
        await UserSettings.SaveAsync();
        await OnSaved.InvokeAsync();
        
        StatusOk = true;
        StatusMessage = "Agent settings saved.";
        await InvokeAsync(StateHasChanged);
    }
}