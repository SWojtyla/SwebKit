@page "/projects"
@page "/"
@inject AppStateService AppState

<div style="padding: 20px; max-width: 900px;">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
        <h2 style="margin:0; font-size:18px;">Projects</h2>
        <FluentButton Appearance="Appearance.Accent" @onclick="AddProject">+ New Project</FluentButton>
    </div>

    @if (!AppState.AllProjects.Any())
    {
        <div style="text-align:center; padding:60px; color:var(--color-text-muted);">
            <p style="font-size:32px;">&#128193;</p>
            <p>No projects yet. Create one to get started.</p>
            <FluentButton Appearance="Appearance.Accent" @onclick="AddProject">Create Project</FluentButton>
        </div>
    }
    else
    {
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px,1fr)); gap:12px;">
            @foreach (var project in AppState.AllProjects)
            {
                <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:6px; padding:16px; cursor:pointer; border-left: 4px solid @project.IconColor;"
                     @onclick="() => SelectProject(project.Id)">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                        <div>
                            <div style="font-size:15px; font-weight:600;">@project.Name</div>
                            @if (!string.IsNullOrEmpty(project.Description))
                            {
                                <div style="font-size:12px; color:var(--color-text-muted); margin-top:4px;">@project.Description</div>
                            }
                        </div>
                        <div style="display:flex; gap:4px;">
                            <span @onclick:stopPropagation="true"><FluentButton Appearance="Appearance.Stealth" @onclick="() => EditProject(project)">&#9998;</FluentButton></span>
                            <span @onclick:stopPropagation="true"><FluentButton Appearance="Appearance.Stealth" @onclick="() => DeleteProject(project.Id)">&#128465;</FluentButton></span>
                        </div>
                    </div>
                    <div style="margin-top:12px; display:flex; gap:4px; flex-wrap:wrap;">
                        @foreach (var env in project.Environments)
                        {
                            <span style="background:@(env.IsProduction ? "rgba(200,0,42,0.2)" : "rgba(0,120,212,0.2)"); color:@(env.IsProduction ? "#FF6B6B" : "#8BE9FD"); padding:2px 8px; border-radius:10px; font-size:11px;">
                                @env.Name
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (ShowEditDialog)
{
    <ProjectEditDialog Project="EditingProject" OnSave="SaveProject" OnClose="() => ShowEditDialog = false" />
}

@if (ShowDeleteConfirm)
{
    <ConfirmDialog Visible="true" Title="Delete Project" IsProduction="false"
                   Message="@($"Delete '{DeletingProject?.Name}'? This cannot be undone.")"
                   ConfirmLabel="Delete" OnConfirm="ConfirmDelete" OnCancel="() => ShowDeleteConfirm = false" />
}

@code {
    private bool ShowEditDialog;
    private bool ShowDeleteConfirm;
    private Project? EditingProject;
    private Project? DeletingProject;

    private void AddProject()
    {
        EditingProject = new Project { Name = string.Empty };
        ShowEditDialog = true;
    }

    private void EditProject(Project p)
    {
        EditingProject = new Project { Id = p.Id, Name = p.Name, Description = p.Description, IconColor = p.IconColor, Environments = p.Environments };
        ShowEditDialog = true;
    }

    private async Task SelectProject(Guid id)
    {
        await AppState.SelectProjectAsync(id);
        StateHasChanged();
    }

    private async Task SaveProject(Project project)
    {
        ShowEditDialog = false;
        if (AppState.AllProjects.Any(p => p.Id == project.Id))
            await AppState.UpdateProjectAsync(project);
        else
            await AppState.AddProjectAsync(project);
        StateHasChanged();
    }

    private void DeleteProject(Guid id)
    {
        DeletingProject = AppState.AllProjects.FirstOrDefault(p => p.Id == id);
        ShowDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        ShowDeleteConfirm = false;
        if (DeletingProject is not null)
            await AppState.DeleteProjectAsync(DeletingProject.Id);
        StateHasChanged();
    }
}
