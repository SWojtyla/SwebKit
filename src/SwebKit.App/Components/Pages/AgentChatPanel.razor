@using SwebKit.Agents
@using SwebKit.App.Services
@using Markdig
@inject IAgentChatService Agent
@inject UserSettingsRepository UserSettings
@inject IJSRuntime JS
@inject ILogger<AgentChatPanel> Logger
@implements IDisposable

<aside class="agent-panel @(IsOpen ? "" : "agent-panel--closed")" aria-label="AI Agent chat panel"
       aria-hidden="@(!IsOpen)">

    <div class="agent-panel-resizer" id="agent-panel-resizer" role="separator" aria-orientation="vertical"
         aria-label="Resize AI Agent panel"></div>

    <div class="agent-panel-inner">

        <header class="agent-panel-header">
            <span class="agent-panel-title">
                <FluentIcon Value="@(new Icons.Regular.Size20.Bot())" Width="15px" />
                AI Agent
            </span>
            <span class="agent-panel-pills">
                <span class="shell-pill @(_historyWarning ? "shell-pill--warning" : "shell-pill--muted")">
                    @Agent.HistoryMessageCount / @UserSettings.Settings.Agent.MaxHistoryMessages
                </span>
                @if (_historyWarning)
                {
                    <span class="shell-pill shell-pill--warning">Almost full</span>
                }
            </span>
            <div class="agent-panel-header-actions">
                @if (_showClearConfirm)
                {
                    <AppButton CssClass="agent-panel-header-btn" Size="Small" Variant="Danger" OnClick="ConfirmClearHistory"
                               Title="Confirm clear history">
                        Yes, clear
                    </AppButton>
                    <AppIconButton CssClass="agent-panel-header-btn" Size="Small" Variant="Ghost"
                                   OnClick="@(() => _showClearConfirm = false)" Title="Cancel" Label="Cancel clear history">
                        <Icon>
                            <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="12px" />
                        </Icon>
                    </AppIconButton>
                }
                else
                {
                    <AppIconButton CssClass="agent-panel-header-btn" Size="Small" Variant="Ghost"
                                   OnClick="@(() => _showClearConfirm = true)" Disabled="@(Agent.HistoryMessageCount == 0)"
                                   Title="Clear conversation history" Label="Clear conversation history">
                        <Icon>
                            <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Width="14px" />
                        </Icon>
                    </AppIconButton>
                }
                <AppIconButton CssClass="agent-panel-header-btn" Size="Small" Variant="Ghost" OnClick="OnClose"
                               Title="Close AI Agent panel" Label="Close AI Agent panel">
                    <Icon>
                        <FluentIcon Value="@(new Icons.Regular.Size16.ChevronDoubleRight())" Width="14px" />
                    </Icon>
                </AppIconButton>
            </div>
        </header>

        <div class="agent-panel-thread" id="agent-panel-thread" tabindex="-1">
            @if (_messages.Count == 0 && !_isLoading)
            {
                <div class="agent-empty-state">
                    <FluentIcon Value="@(new Icons.Regular.Size48.Bot())" />
                    <p>Ask me anything about your workspace.</p>
                    <p class="agent-empty-hint">Try: "List pods in default" or "Any warnings in kube-system?"</p>
                </div>
            }

            @foreach (var msg in _messages)
            {
                @if (msg.IsUser)
                {
                    <div class="agent-bubble agent-bubble--user">
                        <span class="agent-bubble__text">@msg.Content</span>
                    </div>
                }
                else
                {
                    <div class="agent-bubble agent-bubble--assistant">
                        @if (msg.ToolsUsed.Count > 0)
                        {
                            <div class="agent-tools-used">
                                @foreach (var tool in msg.ToolsUsed)
                                {
                                    <span class="agent-tool-badge">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Wrench())" Width="10px" />
                                        @tool
                                    </span>
                                }
                                <span class="agent-elapsed">@msg.Elapsed.TotalSeconds.ToString("F1")s</span>
                            </div>
                        }
                        <div class="agent-bubble__text agent-bubble__markdown">
                            @RenderMarkdown(msg.Content)
                        </div>
                    </div>
                }
            }

            @if (_isLoading)
            {
                <div class="agent-bubble agent-bubble--assistant agent-bubble--loading">
                    <FluentProgressRing Width="18px" />
                    <span>@(_currentToolName is not null ? $"Running {_currentToolName}\u2026" : "Thinking\u2026")</span>
                </div>
            }
        </div>

        <div class="agent-panel-input-bar">
            <div class="agent-input-wrapper">
                <textarea class="agent-input" @bind="_inputText" @bind:event="oninput" placeholder="Ask a question…"
                          disabled="@_isLoading" rows="2" @onkeydown="HandleKeyDown"></textarea>
            </div>
            <AppButton CssClass="agent-send-btn" Disabled="@(string.IsNullOrWhiteSpace(_inputText) || _isLoading)"
                       OnClick="SendMessage" Variant="Secondary">
                <FluentIcon Value="@(new Icons.Regular.Size20.Send())" Width="16px" />
            </AppButton>
        </div>

    </div>

</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private sealed record ChatMessage(
        bool IsUser,
        string Content,
        IReadOnlyList<string> ToolsUsed,
        TimeSpan Elapsed);

    // Static counter: globally unique Mermaid source IDs across all rendered messages.
    private static int _mermaidIdCounter;

    // Shared pipeline with common extensions (tables, autolinks, strikethrough, task lists, etc.).
    private static readonly MarkdownPipeline _markdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private readonly List<ChatMessage> _messages = [];
    private string _inputText = string.Empty;
    private bool _isLoading;
    private bool _showClearConfirm;
    private string? _currentToolName;
    private CancellationTokenSource? _cts;

    private bool _prevIsOpen;
    private bool _resizerNeedsInit;
    // Deferred post-render work: set flags then let OnAfterRenderAsync act once the DOM is updated.
    private bool _pendingScroll;
    private bool _pendingMermaidRender;

    private bool _historyWarning => Agent.IsNearHistoryLimit;
    private static MarkupString RenderMarkdown(string text)
    {
        if (string.IsNullOrEmpty(text))
            return new MarkupString(string.Empty);

        // Intercept mermaid fences BEFORE Markdig sees them so they aren't treated as code blocks.
        // Code is base64-encoded into a data attribute — this survives Markdig without whitespace mangling.
        var processed = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"```mermaid([\s\S]*?)```",
            m =>
            {
                var code = m.Groups[1].Value.Trim();
                var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(code));
                var id = "mermaid-" + System.Threading.Interlocked.Increment(ref _mermaidIdCounter);
                return $"""<div class="mermaid" id="{id}" data-mermaid-b64="{b64}"></div>""";
            });

        return new MarkupString(Markdown.ToHtml(processed, _markdownPipeline));
    }

    private async Task RenderMermaidAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("renderMermaidDiagrams");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Mermaid rendering error");
        }
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && !_prevIsOpen)
            _resizerNeedsInit = true;
        else if (!IsOpen && _prevIsOpen)
            _ = DisposeResizerAsync();

        _prevIsOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_resizerNeedsInit)
        {
            _resizerNeedsInit = false;
            await InitResizerAsync();
        }

        // Run deferred work AFTER the DOM reflects the latest render.
        if (_pendingScroll)
        {
            _pendingScroll = false;
            await ScrollToBottomAsync();
        }

        if (_pendingMermaidRender)
        {
            _pendingMermaidRender = false;
            await RenderMermaidAsync();
        }
    }

    private async Task InitResizerAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "SwebKitAgentPanel.initResizer",
                "agent-panel-resizer",
                ".app-shell",
                new { minWidth = 260, maxWidth = 800, initialWidth = 340 });
        }
        catch (JSException) { /* Non-critical — panel works without resize */ }
        catch (OperationCanceledException) { /* Component disposing */ }
    }

    private async Task DisposeResizerAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("SwebKitAgentPanel.disposeResizer", ".app-shell");
        }
        catch { /* Non-critical */ }
    }

    private async Task SendMessage()
    {
        var text = _inputText.Trim();
        if (string.IsNullOrWhiteSpace(text) || _isLoading)
            return;

        _inputText = string.Empty;
        _messages.Add(new ChatMessage(true, text, [], TimeSpan.Zero));
        _isLoading = true;
        _currentToolName = null;
        StateHasChanged(); // Safe: synchronous, before any await.

        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        try
        {
            var reply = await Agent.SendAsync(text, _cts.Token);
            _messages.Add(new ChatMessage(false, reply.Text, reply.ToolsUsed, reply.Elapsed));
        }
        catch (OperationCanceledException)
        {
            _messages.Add(new ChatMessage(false, "(Request cancelled.)", [], TimeSpan.Zero));
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage(false, $"Error: {ex.Message}", [], TimeSpan.Zero));
        }
        finally
        {
            _isLoading = false;
            _currentToolName = null;
            // BL-2: dispatch on Blazor thread after async continuation.
            // Set flags so OnAfterRenderAsync acts once the DOM is actually updated.
            _pendingScroll = true;
            _pendingMermaidRender = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ConfirmClearHistory()
    {
        Agent.ClearHistory();
        _messages.Clear();
        _showClearConfirm = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !e.CtrlKey)
            await SendMessage();
    }

    private async Task ScrollToBottomAsync()
    {
        try { await JS.InvokeVoidAsync("scrollElementToBottom", "agent-panel-thread"); }
        catch { }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
