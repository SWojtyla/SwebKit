@using SwebKit.Core.Domain
@inject AppStateService AppState
@inject ICredentialStore CredentialStore
@inject SwebKit.DevOps.DevOpsClient DevOpsClient

<div style="display:grid; gap:12px; padding:12px 0;">
    <div style="display:grid; gap:4px;">
        <label style="font-size:12px; color:var(--color-text-muted);">Organization</label>
        <input type="text" @bind="Organization" @bind:event="oninput"
               style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px;"
               placeholder="my-organization" />
    </div>

    <div style="display:grid; gap:4px;">
        <label style="font-size:12px; color:var(--color-text-muted);">Personal Access Token (PAT)</label>
        <PasswordField Value="@Pat" ValueChanged="@(v => Pat = v ?? string.Empty)"
                       Label="Personal Access Token"
                       Placeholder="Enter PAT (stored securely in Windows Credential Manager)" />
    </div>

    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
        <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync">Save</FluentButton>
        <FluentButton @onclick="TestConnectionAsync">Test Connection</FluentButton>

        @if (StatusMessage is not null)
        {
            <span style="font-size:12px; color:@(StatusOk ? "var(--color-success)" : "var(--color-error)");">@StatusMessage</span>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private string Organization = string.Empty;
    private string Pat = string.Empty;
    private string? StatusMessage;
    private bool StatusOk;

    private const string CredentialKey = "swebkit:devops:global:pat";

    protected override void OnParametersSet()
    {
        var config = AppState.Config.DevOpsConfig;
        Organization = config?.Organization ?? string.Empty;

        if (!string.IsNullOrEmpty(config?.PatCredentialKey))
        {
            Pat = CredentialStore.Get(config.PatCredentialKey) ?? string.Empty;
        }

        StatusMessage = null;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Organization))
        {
            StatusOk = false;
            StatusMessage = "Organization is required.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(Pat))
        {
            CredentialStore.Save(CredentialKey, Pat);
        }

        AppState.Config.DevOpsConfig = new DevOpsConfig
        {
            Organization = Organization.Trim(),
            PatCredentialKey = CredentialKey
        };

        await AppState.SaveConfigAsync();
        await OnSaved.InvokeAsync();
        StatusOk = true;
        StatusMessage = "Saved.";
        await InvokeAsync(StateHasChanged);
    }

    private async Task TestConnectionAsync()
    {
        StatusMessage = null;
        StatusOk = false;

        if (string.IsNullOrWhiteSpace(Organization) || string.IsNullOrWhiteSpace(Pat))
        {
            StatusMessage = "Fill in all fields before testing.";
            return;
        }

        try
        {
            CredentialStore.Save(CredentialKey, Pat);

            var config = new DevOpsConfig
            {
                Organization = Organization.Trim(),
                PatCredentialKey = CredentialKey
            };

            DevOpsClient.Configure(config);

            var ok = await DevOpsClient.TestConnectionAsync();
            StatusOk = ok;
            StatusMessage = ok ? "Connection successful." : "Connection failed — check your PAT and organization.";
        }
        catch (Exception ex)
        {
            StatusOk = false;
            StatusMessage = $"Connection failed: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }
}
