    private async Task OpenYaml(string kind, string name, bool startInEditMode = false)
    {
        LogPodName = null;
        ScaleTarget = null;
        YamlTarget = (kind, name);
        YamlText = null;
        YamlError = null;
        YamlLoading = true;
        YamlEditMode = false;
        YamlEditText = string.Empty;
        YamlApplying = false;
        StateHasChanged();

        try
        {
            YamlText = await Client!.GetResourceYamlAsync(CurrentNamespace, kind, name);
            _yamlHighlighted = await HighlightAsync(YamlText);
            if (startInEditMode && YamlIsEditable)
            {
                YamlEditMode = true;
                YamlEditText = YamlText ?? string.Empty;
                _yamlEditHighlighted = _yamlHighlighted;
                _editKey++;
                _initEditOverlay = true;
            }
        }
        catch (Exception ex)
        {
            YamlError = ex.Message;
        }
        finally
        {
            YamlLoading = false;
            StateHasChanged();
        }
    }

    private void CloseYaml()
    {
        YamlTarget = null;
        YamlText = null;
        YamlError = null;
        YamlEditMode = false;
        YamlEditText = string.Empty;
        YamlApplying = false;
        _yamlSearch = string.Empty;
        _yamlSearchCount = 0;
        _showYamlSearch = false;
        StateHasChanged();
    }

    private async Task OnYamlSearchInput(ChangeEventArgs e)
    {
        _yamlSearch = e.Value?.ToString() ?? string.Empty;
        if (_yamlViewPre.Id is null) { StateHasChanged(); return; }
        _yamlSearchCount = await JS.InvokeAsync<int>("yamlHighlight.searchInPre", _yamlViewPre, _yamlSearch);
        StateHasChanged();
    }

    private async Task ClearYamlSearch()
    {
        _yamlSearch = string.Empty;
        _yamlSearchCount = 0;
