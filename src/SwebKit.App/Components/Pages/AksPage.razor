    || (h.Chart?.Contains(HelmFilter, StringComparison.OrdinalIgnoreCase) ?? false)).AsQueryable();

    private IQueryable<ConfigMapInfo> FilteredConfigMaps => string.IsNullOrWhiteSpace(ConfigMapFilter)
