@page "/aks"
@inject AppStateService AppState
@inject IJSRuntime JS
@inject INotificationService Notifications
@inject IPortForwardSessionService SessionService
@inject IAppEventBus EventBus
@inject IConnectionStateService ConnectionState
@implements IDisposable

<div class="aks-page" @oncontextmenu:preventDefault>
    @* ── Toolbar ── *@
    <div class="aks-toolbar">

        @* ── Row 1: connection + actions ── *@
        <div class="aks-toolbar-row">
            <span class="connection-dot @(Client is not null ? "dot-ok" : "dot-unknown")"></span>

            @* ── Context dropdown ── *@
            <label class="aks-ns-label">Context</label>
            <select class="aks-ns-select" value="@ActiveContext" @onchange="OnContextChanged">
                @if (Contexts.Count == 0)
                {
                    <option value="">@(string.IsNullOrWhiteSpace(ActiveContext) ? "default" : ActiveContext)</option>
                }
                @foreach (var ctx in Contexts)
                {
                    <option value="@ctx.Name" selected="@(ctx.Name == ActiveContext)">
                        @ctx.Name @(ctx.IsCurrent ? "(current)" : "")
                    </option>
                }
            </select>

            <span class="aks-toolbar-divider"></span>

            @* ── Namespace searchable picker ── *@
            @if (NsDropOpen)
            {
                <div class="aks-ns-backdrop" @onclick="CloseNsDrop"></div>
            }
            <label class="aks-ns-label">Namespace</label>
            <div class="aks-ns-picker">
                <input class="aks-ns-select aks-ns-search" value="@(NsDropOpen? NsSearchText : CurrentNamespace)"
                       placeholder="@(NsDropOpen ? "Filter…" : CurrentNamespace)" @onfocus="OpenNsDrop"
                       @oninput="OnNsSearchInput" readonly="@(!NsDropOpen)" />
                @if (NsDropOpen)
                {
                    <div class="aks-ns-dropdown">
                        @foreach (var ns in NsFiltered)
                        {
                            var nsLocal = ns;
                            <div class="aks-ns-option @(nsLocal == CurrentNamespace ? "current" : "")"
                                 @onclick="() => SelectNs(nsLocal)">
                                @nsLocal
                            </div>
                        }
                    </div>
                }
            </div>

            <span class="aks-toolbar-spacer"></span>

            @{
                var warnCount = Events.Count(e => e.Type == "Warning");
            }
            <button class="aks-events-toggle @(ShowEvents ? "active" : "")"
                    @onclick="() => { ShowEvents = !ShowEvents; StateHasChanged(); }" title="Toggle events panel">
                <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Width="14px" style="vertical-align:middle;" />
                @(warnCount > 0 ? $" {warnCount}" : " Events")
            </button>

            @{
                var pfCount = SessionService.Sessions.Count(s => s.Status is PortForwardStatus.Starting or PortForwardStatus.Active);
            }
            <button class="aks-events-toggle @(ShowPortForwardSessions ? "active" : "")"
                    @onclick="() => { ShowPortForwardSessions = !ShowPortForwardSessions; StateHasChanged(); }"
                    title="Toggle port-forward sessions panel">
                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowForward())" Width="14px" style="vertical-align:middle;" />
                @(pfCount > 0 ? $" {pfCount} pf" : " Sessions")
            </button>

            <AutoRefreshToggle OnRefresh="LoadAsync" Paused="@HasAnyPanel" />

            <FluentButton Appearance="Appearance.Stealth" Disabled="@IsLoading" @onclick="LoadAsync"
                          Title="Refresh (F5)">
                @(IsLoading ? "Loading…" : "↻ Refresh")
            </FluentButton>
        </div>

        @* ── Row 2: resource type tabs ── *@
        <div class="aks-tab-bar">
            @foreach (var rt in ResourceTypes)
            {
                <button class="aks-resource-tab @(rt == ActiveResourceType ? "active" : "")"
                        @onclick="() => SwitchResourceType(rt)">
                    @rt
                </button>
            }
        </div>

    </div>

    @* ── Error ── *@
    @if (ErrorMessage is not null)
    {
        <ErrorCallout Message="@ErrorMessage" OnRetry="LoadAsync" />
    }

    @* ── Confirm bar ── *@
    <AksConfirmBar @ref="Confirm" />

    @* ── Empty / Loading / Content ── *@
    @if (Client is null && !AppState.UseDemoData && AppState.Config.AksConfig is null)
    {
        <div class="aks-empty-state">
            <div class="aks-empty-icon">
                <FluentIcon Value="@(new Icons.Regular.Size32.CloudCube())" Width="48px" />
            </div>
            <div class="aks-empty-title">No cluster configured</div>
            <div class="aks-empty-subtitle">
                Go to <a href="/settings">Settings</a> to configure your AKS connection.
            </div>
        </div>
    }
    else if (IsLoading && !HasAnyData)
    {
        <LoadingSpinner Message="Connecting to cluster…" />
    }
    else
    {
        <div class="aks-content @(HasAnyPanel ? "side-open" : "")">
            @* ── Main resource panel ── *@
            <div class="aks-resource-panel">
                <div class="aks-section-header">
                    <span class="aks-section-title">@ActiveResourceType</span>
                    <span class="aks-section-count">@ActiveResourceCount</span>
                </div>
                <ResourceFilter Placeholder="@($"Filter {ActiveResourceType.ToLowerInvariant()}…")" Value="@ActiveFilter"
                                ValueChanged="OnFilterChanged" />
                <div class="aks-table-wrap" @oncontextmenu="OnTableContextMenu" @oncontextmenu:preventDefault
                     tabindex="0" @onkeydown="HandleGridKeyDown" @onkeydown:preventDefault="@_preventGridKey">
                    @switch (ActiveResourceType)
                    {
                        case "Deployments":
                            <DeploymentGrid FilteredItems="@FilteredDeployments" Hpas="@Hpas" IsMultiNamespace="@IsMultiNamespace"
                                            SelectedDeployment="@SelectedDeployment"
                                            OnContextMenu="@((args) => ShowDeploymentMenu(args.Item1, args.Item2))"
                                            OnSelectRow="@((d) => { SelectedDeployment = d; StateHasChanged(); })" OnOpenHpa="@OpenHpaDetail"
                                            OnNamespaceClick="@((ns) => { CurrentNamespace = ns; _ = LoadAsync(); })" />
                            break;

                        case "StatefulSets":
                            <StatefulSetGrid FilteredItems="@FilteredStatefulSets" Hpas="@Hpas" IsMultiNamespace="@IsMultiNamespace"
                                             OnContextMenu="@((args) => ShowStatefulSetMenu(args.Item1, args.Item2))" OnOpenHpa="@OpenHpaDetail"
                                             OnNamespaceClick="@((ns) => { CurrentNamespace = ns; _ = LoadAsync(); })" />
                            break;

                        case "ConfigMaps":
                            <ConfigMapGrid FilteredItems="@FilteredConfigMaps" IsMultiNamespace="@IsMultiNamespace"
                                           OnContextMenu="@((args) => ShowConfigMapMenu(args.Item1, args.Item2))" />
                            break;

                        case "Secrets":
                            <SecretGrid FilteredItems="@FilteredSecrets" IsMultiNamespace="@IsMultiNamespace"
                                        OnContextMenu="@((args) => ShowSecretMenu(args.Item1, args.Item2))" />
                            break;

                        case "Pods":
                            <PodGrid FilteredItems="@FilteredPods" PodMetricsList="@PodMetricsList"
                                     IsMultiNamespace="@IsMultiNamespace"
                                     OnContextMenu="@((args) => ShowPodMenu(args.Item1, args.Item2))"
                                     OnNamespaceClick="@((ns) => { CurrentNamespace = ns; _ = LoadAsync(); })" />
                            break;

                        case "Ingresses":
                            <IngressGrid FilteredItems="@FilteredIngresses"
                                         OnContextMenu="@((args) => ShowIngressMenu(args.Item1, args.Item2))"
                                         OnOpenUrl="@((url) => _ = OpenUrlAsync(url))" />
                            break;

                        case "Helm":
                            <HelmGrid FilteredItems="@FilteredHelmReleases"
                                      OnContextMenu="@((args) => ShowHelmMenu(args.Item1, args.Item2))" />
                            break;

                        case "CronJobs":
                            <CronJobGrid FilteredItems="@FilteredCronJobs" IsMultiNamespace="@IsMultiNamespace"
                                         OnContextMenu="@((args) => ShowCronJobMenu(args.Item1, args.Item2))"
                                         OnNamespaceClick="@((ns) => { CurrentNamespace = ns; _ = LoadAsync(); })" />
                            break;
                    }
                </div>
            </div>

            @* ── Side column: all panels (incl. events) ── *@
            @if (HasAnyPanel)
            {
                <ResizablePanel DefaultWidth="420" MinWidth="280" MaxWidth="900">
                    <div class="aks-panels-col">

                        @* ── YAML viewer / editor ── *@
                        @if (YamlTarget is not null)
                        {
                            <div class="aks-panel-pane">
                                <div class="aks-section-header">
                                    <span class="aks-section-title" title="@YamlTarget.Value.Kind/@YamlTarget.Value.Name">
                                        @(YamlEditMode ? "Edit" : "") @YamlTarget.Value.Kind: @YamlTarget.Value.Name
                                    </span>
                                    @if (!YamlLoading && YamlError is null && YamlIsEditable && !YamlEditMode)
                                    {
                                        <FluentButton Appearance="Appearance.Stealth" @onclick="OnEditYamlToggle" Title="Edit YAML">
                                            <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Width="16px" />
                                        </FluentButton>
                                    }
                                    @if (!YamlEditMode && !YamlLoading && YamlError is null)
                                    {
                                        <button class="aks-search-toggle-btn @(_showYamlSearch ? "active" : "")"
                                                @onclick="() => { _showYamlSearch = !_showYamlSearch; if (!_showYamlSearch) _ = ClearYamlSearch(); StateHasChanged(); }"
                                                title="Search in YAML">
                                            <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Width="16px" />
                                        </button>
                                    }
                                    @if (YamlEditMode)
                                    {
                                        <FluentButton Appearance="Appearance.Accent" Disabled="@YamlApplying" @onclick="OnSaveYaml"
                                                      Title="Apply YAML">
                                            @(YamlApplying ? "Saving…" : "Save")
                                        </FluentButton>
                                        <FluentButton Appearance="Appearance.Stealth" Disabled="@YamlApplying"
                                                      @onclick="OnCancelYamlEdit" Title="Cancel edit">Cancel</FluentButton>
                                    }
                                    <FluentButton Appearance="Appearance.Stealth" @onclick="CloseYaml" Title="Close">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                                    </FluentButton>
                                </div>
                                @if (_showYamlSearch && !YamlEditMode)
                                {
                                    <div class="aks-yaml-search-bar">
                                        <input type="text" class="aks-yaml-search-input" placeholder="Search in YAML…"
                                               value="@_yamlSearch" @oninput="OnYamlSearchInput" autofocus />
                                        @if (!string.IsNullOrEmpty(_yamlSearch))
                                        {
                                            <span class="aks-yaml-search-count">@_yamlSearchCount match@(_yamlSearchCount != 1 ? "es" :
                                                                            "")</span>
                                                <button class="aks-yaml-search-clear" @onclick="ClearYamlSearch" title="Clear">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="14px" />
                                                </button>
                                            }
                                        </div>
                                    }
                                    <div class="aks-yaml-content">
                                        @if (YamlLoading)
                                        {
                                            <LoadingSpinner Message="Loading YAML…" />
                                        }
                                        else if (YamlError is not null)
                                        {
                                            <div class="aks-yaml-error">@YamlError</div>
                                        }
                                        else if (YamlEditMode)
                                        {
                                            <div class="aks-yaml-edit-wrap" @key="_editKey">
                                                <pre class="aks-yaml-pre aks-yaml-edit-bg" @ref="_editPre">@_yamlEditHighlighted</pre>
                                                <textarea class="aks-yaml-edit" spellcheck="false" @ref="_editTextarea"
                                                          @oninput="OnYamlEditInput">@YamlEditText</textarea>
                                            </div>
                                        }
                                        else
                                        {
                                            <pre class="aks-yaml-pre" @ref="_yamlViewPre">@_yamlHighlighted</pre>
                                        }
                                    </div>
                                </div>
                            }

                            @* ── Helm History ── *@
                            @if (HelmHistoryTarget is not null && YamlTarget is null)
                            {
                                <div class="aks-panel-pane">
                                    <div class="aks-section-header">
                                        <span class="aks-section-title">@(HelmRollbackMode ? "Rollback" : "History"):
                                            @HelmHistoryTarget</span>
                                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseHelmHistory" Title="Close">
                                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                                            </FluentButton>
                                        </div>
                                        @if (HelmRollbackMode)
                                        {
                                            <div class="aks-rollback-hint">Select a revision to rollback to:</div>
                                        }
                                        <div class="aks-yaml-content">
                                            @if (HelmHistoryLoading)
                                            {
                                                <LoadingSpinner Message="Loading history…" />
                                            }
                                            else
                                            {
                                                <table class="aks-history-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Rev</th>
                                                            <th>Status</th>
                                                            <th>Chart</th>
                                                            <th>App Version</th>
                                                            <th>Updated</th>
                                                            <th>Description</th>
                                                            @if (HelmRollbackMode)
                                                            {
                                                                <th></th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var rev in HelmHistory.OrderByDescending(r => r.Revision))
                                                        {
                                                            <tr class="@(rev.Status == "deployed" ? "aks-rev-current" : "")">
                                                                <td>@rev.Revision</td>
                                                                <td><span
                                                                    class="aks-status @(rev.Status == "deployed" ? "running" : rev.Status == "failed" ? "error" : "other")">@rev.Status</span>
                                                                </td>
                                                                <td>@rev.Chart</td>
                                                                <td>@rev.AppVersion</td>
                                                                <td>@rev.Updated?.ToString("yyyy-MM-dd HH:mm")</td>
                                                                <td>@rev.Description</td>
                                                                @if (HelmRollbackMode)
                                                                {
                                                                    <td>
                                                                        @if (rev.Status == "superseded")
                                                                        {
                                                                            var r = rev;
                                                                            <button class="ctx-item destructive aks-rollback-btn"
                                                                                    style="display:inline-flex; align-items:center; gap:4px;"
                                                                                    @onclick="() => OnRollbackToRevision(r)">
                                                                                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowCounterclockwise())"
                                                                                            Width="14px" /> Rollback
                                                                            </button>
                                                                        }
                                                                    </td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </div>
                                    </div>
                                }

                                @* ── Helm Values ── *@
                                @if (HelmValuesTarget is not null && YamlTarget is null && HelmHistoryTarget is null)
                                {
                                    <div class="aks-panel-pane">
                                        <div class="aks-section-header">
                                            <span class="aks-section-title">Values: @HelmValuesTarget</span>
                                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseHelmValues" Title="Close">
                                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                                            </FluentButton>
                                        </div>
                                        <div class="aks-yaml-content">
                                            @if (HelmValuesLoading)
                                            {
                                                <LoadingSpinner Message="Loading values…" />
                                            }
                                            else
                                            {
                                                <pre class="aks-yaml-pre">@_helmValuesHighlighted</pre>
                                            }
                                        </div>
                                    </div>
                                }

                                @* ── Scale ── *@
                                @if (ScaleTarget is not null && YamlTarget is null && LogPodName is null)
                                {
                                    <div class="aks-panel-pane">
                                        <div class="aks-section-header">
                                            <span class="aks-section-title" title="@ScaleTarget">Scale: @ScaleTarget</span>
                                            <FluentButton Appearance="Appearance.Stealth" @onclick="OnScaleCancel" Title="Cancel">
                                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                                            </FluentButton>
                                        </div>
                                        <div class="aks-scale-panel">
                                            <div class="aks-scale-label">Desired replicas</div>
                                            <div class="aks-scale-stepper">
                                                <button class="aks-scale-step-btn"
                                                        @onclick="() => ScaleReplicas = Math.Max(0, ScaleReplicas - 1)">−</button>
                                                <input type="number" class="aks-scale-input" min="0" max="100" @bind="ScaleReplicas"
                                                       @bind:event="oninput" />
                                                <button class="aks-scale-step-btn"
                                                        @onclick="() => ScaleReplicas = Math.Min(100, ScaleReplicas + 1)">+</button>
                                            </div>
                                            <div class="aks-scale-current">Currently: @(_scaleIsStatefulSet ? (StatefulSets.FirstOrDefault(s
                                                                            => s.Name == ScaleTarget)?.Replicas ?? 0) : (Deployments.FirstOrDefault(d => d.Name ==
                                                                            ScaleTarget)?.Replicas ?? 0)) replicas</div>
                                                <div class="aks-scale-actions">
                                                    <button class="confirm-btn confirm-yes" @onclick="OnScaleConfirm">Apply</button>
                                                    <button class="confirm-btn confirm-no" @onclick="OnScaleCancel">Cancel</button>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @* ── Pod logs ── *@
                                    @if (LogPodName is not null && YamlTarget is null)
                                    {
                                        <div class="aks-panel-pane">
                                            <div class="aks-section-header aks-log-header">
                                                <span class="aks-section-title" title="@LogPodName">Logs: @TruncatePodName(LogPodName)</span>
                                                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseLogs" Title="Close">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                                                </FluentButton>
                                            </div>
                                            <PodLogView Client="Client" Namespace="@CurrentNamespace" PodName="@LogPodName" />
                                        </div>
                                    }

                                    @* ── Multi-pod logs ── *@
                                    @if (LogDeploymentName is not null && LogPodName is null && YamlTarget is null)
                                    {
                                        <div class="aks-panel-pane">
                                            <div class="aks-section-header aks-log-header">
                                                <span class="aks-section-title">All-pod logs: @LogDeploymentName</span>
                                                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseDeploymentLogs" Title="Close">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                                                </FluentButton>
                                            </div>
                                            <MultiPodLogView Client="Client" Namespace="@CurrentNamespace"
                                                             DeploymentName="@LogDeploymentName" />
                                        </div>
                                    }

                                    @* ── Container details ── *@
                                    @if (ContainerDetailPodName is not null && YamlTarget is null && LogPodName is null && LogDeploymentName
                                                    is null)
                                    {
                                        <div class="aks-panel-pane">
                                            <div class="aks-section-header">
                                                <span class="aks-section-title">Containers: @TruncatePodName(ContainerDetailPodName)</span>
                                                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseContainerDetail" Title="Close">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                                                </FluentButton>
                                            </div>
                                            <div class="aks-yaml-content">
                                                <ContainerDetailPanel Client="Client" Namespace="@CurrentNamespace"
                                                                      PodName="@ContainerDetailPodName" />
                                            </div>
                                        </div>
                                    }

                                    @* ── ConfigMap detail ── *@
                                    @if (ConfigMapDetailTarget is not null && YamlTarget is null)
                                    {
                                        <div class="aks-panel-pane">
                                            <div class="aks-section-header">
                                                <span class="aks-section-title">ConfigMap: @ConfigMapDetailTarget.Name</span>
                                                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseConfigMapDetail" Title="Close">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                                                </FluentButton>
                                            </div>
                                            <ConfigMapDetailPanel ConfigMap="ConfigMapDetailTarget" />
                                        </div>
                                    }

                                    @* ── Secret detail ── *@
                                    @if (SecretDetailTarget is not null && YamlTarget is null)
                                    {
                                        <div class="aks-panel-pane">
                                            <div class="aks-section-header">
                                                <span class="aks-section-title">Secret: @SecretDetailTarget.Name</span>
                                                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseSecretDetail" Title="Close">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                                                </FluentButton>
                                            </div>
                                            <SecretDetailPanel Client="Client" Namespace="@CurrentNamespace" Secret="SecretDetailTarget" />
                                        </div>
                                    }

                                    @* ── HPA detail ── *@
                                    @if (HpaDetailTarget is not null && YamlTarget is null)
                                    {
                                        <div class="aks-panel-pane">
                                            <div class="aks-section-header">
                                                <span class="aks-section-title">HPA: @HpaDetailTarget.Name</span>
                                                <FluentButton Appearance="Appearance.Stealth"
                                                              @onclick="() => { HpaDetailTarget = null; StateHasChanged(); }" Title="Close">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                                                </FluentButton>
                                            </div>
                                            <HpaPanel Hpa="HpaDetailTarget" />
                                        </div>
                                    }

                                    @* ── Events panel (full peer pane) ── *@
                                    @if (ShowEvents)
                                    {
                                        <div class="aks-panel-pane">
                                            <div class="aks-section-header">
                                                <span class="aks-section-title">Events</span>
                                                <span class="aks-section-count">@Events.Count</span>
                                                @if (Events.Any(e => e.Type == "Warning"))
                                                {
                                                    <span class="aks-event-warn-badge" style="display:inline-flex; align-items:center; gap:4px;">
                                                        <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Width="14px" /> @Events.Count(e =>
                                                                                    e.Type == "Warning")
                                                    </span>
                                                }
                                                <span class="aks-toolbar-spacer"></span>
                                                <FluentButton Appearance="Appearance.Stealth"
                                                              @onclick="() => { ShowEvents = false; StateHasChanged(); }" Title="Close">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                                                </FluentButton>
                                            </div>
                                            <div class="aks-events-list">
                                                @if (Events.Count == 0)
                                                {
                                                    <div class="aks-events-empty">No recent events</div>
                                                }
                                                else
                                                {
                                                    @foreach (var evt in Events)
                                                    {
                                                        <div class="aks-event-item @(evt.Type == "Warning" ? "warning" : "")">
                                                            <div class="aks-event-header">
                                                                @if (evt.Type == "Warning")
                                                                {
                                                                    <span class="aks-event-icon warning" style="display:inline-flex; align-items:center;">
                                                                        <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Width="14px" />
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="aks-event-icon normal" style="display:inline-flex; align-items:center;">
                                                                        <FluentIcon Value="@(new Icons.Filled.Size12.Circle())" Width="10px" />
                                                                    </span>
                                                                }
                                                                <span class="aks-event-reason">@evt.Reason</span>
                                                                @if (evt.Count > 1)
                                                                {
                                                                    <span class="aks-event-count">×@evt.Count</span>
                                                                }
                                                                <span class="aks-event-time">@evt.LastTimestamp?.ToString("HH:mm:ss")</span>
                                                            </div>
                                                            <div class="aks-event-detail">
                                                                <span class="aks-event-object">@evt.InvolvedObjectName</span>
                                                                @evt.Message
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }

                                </div>
                            </ResizablePanel>
                        }

                    </div>
                }

                @* ── Context menus ── *@
                <ContextMenu @ref="DeploymentMenu">
                    <button class="ctx-item" @onclick="() => OnCtxViewYaml('D')"><span class="ctx-item-icon">{ }</span> View
                        YAML</button>
                        <button class="ctx-item" @onclick="() => OnCtxEditYaml('D')"><span class="ctx-item-icon">✎</span> Edit
                            YAML</button>
                            <button class="ctx-item" @onclick="OnCtxViewDeploymentLogs"><span class="ctx-item-icon">&#9776;</span> View
                                Logs</button>
                                <button class="ctx-item" @onclick="OnCtxAllPodsLogs"><span class="ctx-item-icon">&#9782;</span> Logs for all
                                    pods</button>
                                    <button class="ctx-item" @onclick="OnCtxContainerDetailsDeployment"><span class="ctx-item-icon">&#9881;</span>
                                        Container Details</button>
                                        <div class="ctx-separator"></div>
                                        <button class="ctx-item" @onclick="OnCtxRestartDeployment"><span class="ctx-item-icon">&#8635;</span> Restart
                                            Deployment</button>
                                            <button class="ctx-item" @onclick="OnCtxScaleDeployment"><span class="ctx-item-icon">&#8693;</span>
