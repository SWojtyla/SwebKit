    private async Task OnSaveYaml()
    {
        if (YamlTarget is null || Client is null) return;
        YamlApplying = true;
        StateHasChanged();

        try
        {
            if (IsProduction)
            {
                var confirmed = await Confirm.ShowAsync(
                $"Apply YAML changes to {YamlTarget.Value.Kind} \"{YamlTarget.Value.Name}\" in production?",
                YamlTarget.Value.Name,
                requireTypedName: true);
                if (!confirmed) { YamlApplying = false; StateHasChanged(); return; }
            }

            await Client.ApplyResourceYamlAsync(CurrentNamespace, YamlTarget.Value.Kind, YamlTarget.Value.Name, YamlEditText);
            YamlText = YamlEditText;
            _yamlHighlighted = await HighlightAsync(YamlText);
            YamlEditMode = false;
            YamlEditText = string.Empty;
            StateHasChanged();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { YamlApplying = false; StateHasChanged(); }
    }

