    private async Task OnScaleConfirm()
    {
        if (ScaleTarget is null || Client is null) return;
        var name = ScaleTarget;
        var replicas = ScaleReplicas;
        var isStatefulSet = _scaleIsStatefulSet;
        ScaleTarget = null;
        StateHasChanged();

        if (IsProduction)
        {
            var confirmed = await Confirm.ShowAsync(
            $"Scale \"{name}\" to {replicas} replicas in production?",
            name,
            requireTypedName: true);
            if (!confirmed) return;
        }

        try
        {
            if (isStatefulSet)
                await Client.ScaleStatefulSetAsync(CurrentNamespace, name, replicas);
            else
                await Client.ScaleDeploymentAsync(CurrentNamespace, name, replicas);
            await LoadAsync();
            Notifications.ShowSuccess("Scaled", $"{name} → {replicas} replica{(replicas == 1 ? "" : "s")}");
        }
        catch (Exception ex) { ErrorMessage = ex.Message; Notifications.ShowError("Failed to scale", ex: ex); }
    }

