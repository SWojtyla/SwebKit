@page "/aks"
@inject AppStateService AppState
@implements IDisposable

<div class="aks-page" @oncontextmenu:preventDefault>
    @* ── Toolbar ── *@
    <div class="aks-toolbar">
        <span class="connection-dot @(Client is not null ? "dot-ok" : "dot-unknown")"></span>

        @* ── Context dropdown ── *@
        <label class="aks-ns-label">Context</label>
        <select class="aks-ns-select" value="@ActiveContext" @onchange="OnContextChanged">
            @if (Contexts.Count == 0)
            {
                <option value="">@(string.IsNullOrWhiteSpace(ActiveContext) ? "default" : ActiveContext)</option>
            }
            @foreach (var ctx in Contexts)
            {
                <option value="@ctx.Name" selected="@(ctx.Name == ActiveContext)">
                    @ctx.Name @(ctx.IsCurrent ? "(current)" : "")
                </option>
            }
        </select>

        <span class="aks-toolbar-divider"></span>

        @* ── Namespace dropdown ── *@
        <label class="aks-ns-label">Namespace</label>
        <select class="aks-ns-select" value="@CurrentNamespace" @onchange="OnNamespaceChanged">
            <option value="*" selected="@(CurrentNamespace == "*")">All namespaces</option>
            @foreach (var ns in Namespaces)
            {
                <option value="@ns" selected="@(ns == CurrentNamespace)">@ns</option>
            }
        </select>

        <span class="aks-toolbar-divider"></span>

        @* ── Resource type selector ── *@
        @foreach (var rt in ResourceTypes)
        {
            <button class="aks-resource-tab @(rt == ActiveResourceType ? "active" : "")"
                    @onclick="() => SwitchResourceType(rt)">
                @rt
            </button>
        }

        <span class="aks-toolbar-spacer"></span>

        <AutoRefreshToggle OnRefresh="LoadAsync"
                          Paused="@(YamlTarget is not null || LogPodName is not null || HelmHistoryTarget is not null || HelmValuesTarget is not null || ScaleTarget is not null)" />

        <FluentButton Appearance="Appearance.Stealth" Disabled="@IsLoading" @onclick="LoadAsync"
                      Title="Refresh (F5)">
            @(IsLoading ? "Loading…" : "↻ Refresh")
        </FluentButton>
    </div>

    @* ── Error ── *@
    @if (ErrorMessage is not null)
    {
        <ErrorCallout Message="@ErrorMessage" OnRetry="LoadAsync" />
    }

    @* ── Confirm bar ── *@
    <AksConfirmBar @ref="Confirm" />

    @* ── Empty / Loading / Content ── *@
    @if (Client is null && !AppState.UseDemoData && AppState.CurrentEnvironment?.AksConfig is null)
    {
        <div class="aks-empty-state">
            <div class="aks-empty-icon">☸</div>
            <div class="aks-empty-title">No cluster configured</div>
            <div class="aks-empty-subtitle">
                Go to <a href="/settings">Settings</a> to configure your AKS connection.
            </div>
        </div>
    }
    else if (IsLoading && !HasAnyData)
    {
        <LoadingSpinner Message="Connecting to cluster…" />
    }
    else
    {
        <div class="aks-content @(YamlTarget is not null || LogPodName is not null || HelmHistoryTarget is not null || HelmValuesTarget is not null ? "side-open" : "") @(ShowEvents ? "" : "events-collapsed")">
            @* ── Main resource panel ── *@
            <div class="aks-resource-panel">
                <div class="aks-section-header">
                    <span class="aks-section-title">@ActiveResourceType</span>
                    <span class="aks-section-count">@ActiveResourceCount</span>
                </div>
                <ResourceFilter Placeholder="@($"Filter {ActiveResourceType.ToLowerInvariant()}…")"
                                Value="@ActiveFilter" ValueChanged="OnFilterChanged" />
                <div class="aks-table-wrap" @oncontextmenu="OnTableContextMenu" @oncontextmenu:preventDefault>
                    @switch (ActiveResourceType)
                    {
                        case "Deployments":
                            <FluentDataGrid Items="@FilteredDeployments" TGridItem="DeploymentInfo"
                                            Virtualize="true" ItemSize="36"
                                            RowClass="@(d => SelectedDeployment?.Name == d.Name ? "selected-row" : "")"
                                            OnRowClick="@(r => { if (r.Item is not null) { SelectedDeployment = r.Item; StateHasChanged(); } })">
                                <TemplateColumn Title="Name">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowDeploymentMenu(e, context)" @oncontextmenu:preventDefault>
                                        <span class="aks-resource-name">@context.Name</span>
                                    </div>
                                </TemplateColumn>
                                @if (IsMultiNamespace)
                                {
                                    <TemplateColumn Title="Namespace" Width="130px">
                                        <span class="aks-ns-cell" @onclick="() => { CurrentNamespace = context.Namespace; _ = LoadAsync(); }">@context.Namespace</span>
                                    </TemplateColumn>
                                }
                                <TemplateColumn Title="Ready" Width="90px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowDeploymentMenu(e, context)" @oncontextmenu:preventDefault>
                                        <span class="aks-ready-badge @(context.ReadyReplicas == context.Replicas ? "healthy" : "degraded")">
                                            @context.ReadyReplicas / @context.Replicas
                                        </span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Status" Width="100px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowDeploymentMenu(e, context)" @oncontextmenu:preventDefault>
                                        <span class="aks-status @(context.Status is "Running" or "Available" ? "running" : "other")">
                                            @context.Status
                                        </span>
                                    </div>
                                </TemplateColumn>
                            </FluentDataGrid>
                            break;

                        case "Pods":
                            <FluentDataGrid Items="@FilteredPods" TGridItem="PodInfo"
                                            Virtualize="true" ItemSize="36">
                                <TemplateColumn Title="Name">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)" @oncontextmenu:preventDefault>
                                        <span class="aks-resource-name">@context.Name</span>
                                    </div>
                                </TemplateColumn>
                                @if (IsMultiNamespace)
                                {
                                    <TemplateColumn Title="Namespace" Width="130px">
                                        <span class="aks-ns-cell" @onclick="() => { CurrentNamespace = context.Namespace; _ = LoadAsync(); }">@context.Namespace</span>
                                    </TemplateColumn>
                                }
                                <TemplateColumn Title="Phase" Width="110px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)" @oncontextmenu:preventDefault>
                                        <span class="aks-status @(context.Phase == "Running" ? "running" : context.Phase == "CrashLoopBackOff" ? "error" : "other")">
                                            @context.Phase
                                        </span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Ready" Width="70px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)" @oncontextmenu:preventDefault>
                                        <span class="aks-ready-badge @(context.Ready ? "healthy" : "degraded")">
                                            @(context.Ready ? "Yes" : "No")
                                        </span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Node" Width="180px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)" @oncontextmenu:preventDefault>
                                        @context.NodeName
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Age" Width="80px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)" @oncontextmenu:preventDefault>
                                        @if (context.StartTime.HasValue)
                                        {
                                            @FormatAge(context.StartTime.Value)
                                        }
                                    </div>
                                </TemplateColumn>
                                @if (PodMetricsList.Count > 0)
                                {
                                    <TemplateColumn Title="CPU" Width="80px">
                                        <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)" @oncontextmenu:preventDefault>
                                            @{ var cpuMetric = GetPodCpu(context.Name); }
                                            @if (cpuMetric is not null)
                                            {
                                                <span class="aks-metric @CpuClass(cpuMetric.Value)" title="@($"{cpuMetric.Value:F3} cores")">
                                                    @($"{cpuMetric.Value * 1000:F0}m")
                                                </span>
                                            }
                                        </div>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Memory" Width="90px">
                                        <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)" @oncontextmenu:preventDefault>
                                            @{ var memMetric = GetPodMemoryMi(context.Name); }
                                            @if (memMetric is not null)
                                            {
                                                <span class="aks-metric @MemoryClass(memMetric.Value)" title="@($"{memMetric.Value:F1} Mi")">
                                                    @($"{memMetric.Value:F0}Mi")
                                                </span>
                                            }
                                        </div>
                                    </TemplateColumn>
                                }
                            </FluentDataGrid>
                            break;

                        case "Ingresses":
                            <FluentDataGrid Items="@FilteredIngresses" TGridItem="IngressInfo"
                                            Virtualize="true" ItemSize="36">
                                <TemplateColumn Title="Name">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowIngressMenu(e, context)" @oncontextmenu:preventDefault>
                                        <span class="aks-resource-name">@context.Name</span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Class" Width="100px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowIngressMenu(e, context)" @oncontextmenu:preventDefault>
                                        @context.IngressClass
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Hosts">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowIngressMenu(e, context)" @oncontextmenu:preventDefault>
                                        <span class="aks-ingress-hosts">
                                            @string.Join(", ", context.Rules.Where(r => r.Host is not null).Select(r => r.Host!))
                                        </span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Address" Width="140px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowIngressMenu(e, context)" @oncontextmenu:preventDefault>
                                        @string.Join(", ", context.Addresses)
                                    </div>
                                </TemplateColumn>
                            </FluentDataGrid>
                            break;

                        case "Helm":
                            <FluentDataGrid Items="@FilteredHelmReleases" TGridItem="HelmReleaseInfo"
                                            Virtualize="true" ItemSize="36">
                                <TemplateColumn Title="Release">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowHelmMenu(e, context)" @oncontextmenu:preventDefault>
                                        <span class="aks-resource-name">@context.Name</span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Chart">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowHelmMenu(e, context)" @oncontextmenu:preventDefault>
                                        @context.Chart
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="App Version" Width="100px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowHelmMenu(e, context)" @oncontextmenu:preventDefault>
                                        @context.AppVersion
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Rev" Width="60px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowHelmMenu(e, context)" @oncontextmenu:preventDefault>
                                        <span class="aks-section-count">@context.Revision</span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Status" Width="100px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowHelmMenu(e, context)" @oncontextmenu:preventDefault>
                                        <span class="aks-status @(context.Status == "deployed" ? "running" : context.Status == "failed" ? "error" : "other")">
                                            @context.Status
                                        </span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Updated" Width="100px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowHelmMenu(e, context)" @oncontextmenu:preventDefault>
                                        @if (context.Updated.HasValue)
                                        {
                                            @FormatAge(context.Updated.Value)
                                            <span class="aks-age-suffix"> ago</span>
                                        }
                                    </div>
                                </TemplateColumn>
                            </FluentDataGrid>
                            break;
                    }
                </div>
            </div>

            @* ── Events panel (collapsible) ── *@
            @if (ShowEvents)
            {
                <div class="aks-events-panel">
                    <div class="aks-section-header">
                        <span class="aks-section-title">Events</span>
                        <span class="aks-section-count">@Events.Count</span>
                        <button class="aks-collapse-btn" @onclick="() => ShowEvents = false" title="Collapse events">
                            ✕
                        </button>
                    </div>
                    <div class="aks-events-list">
                        @if (Events.Count == 0)
                        {
                            <div class="aks-events-empty">No recent events</div>
                        }
                        else
                        {
                            @foreach (var evt in Events)
                            {
                                <div class="aks-event-item @(evt.Type == "Warning" ? "warning" : "")">
                                    <div class="aks-event-header">
                                        @if (evt.Type == "Warning")
                                        {
                                            <span class="aks-event-icon warning">&#9888;</span>
                                        }
                                        else
                                        {
                                            <span class="aks-event-icon normal">&#9679;</span>
                                        }
                                        <span class="aks-event-reason">@evt.Reason</span>
                                        @if (evt.Count > 1)
                                        {
                                            <span class="aks-event-count">×@evt.Count</span>
                                        }
                                        <span class="aks-event-time">@evt.LastTimestamp?.ToString("HH:mm:ss")</span>
                                    </div>
                                    <div class="aks-event-detail">
                                        <span class="aks-event-object">@evt.InvolvedObjectName</span>
                                        @evt.Message
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
            else
            {
                <button class="aks-events-collapsed-tab" @onclick="() => ShowEvents = true" title="Show events">
                    Events (@Events.Count(e => e.Type == "Warning") &#9888;)
                </button>
            }

            @* ── YAML viewer slide-out ── *@
            @if (YamlTarget is not null)
            {
                <ResizablePanel DefaultWidth="380" MinWidth="250" MaxWidth="700">
                    <div class="aks-section-header">
                        <span class="aks-section-title" title="@YamlTarget.Value.Kind/@YamlTarget.Value.Name">
                            @YamlTarget.Value.Kind: @YamlTarget.Value.Name
                        </span>
                        <FluentButton Appearance="Appearance.Stealth" @onclick="CloseYaml" Title="Close YAML">✕</FluentButton>
                    </div>
                    <div class="aks-yaml-content">
                        @if (YamlLoading)
                        {
                            <LoadingSpinner Message="Loading YAML…" />
                        }
                        else if (YamlError is not null)
                        {
                            <div class="aks-yaml-error">@YamlError</div>
                        }
                        else
                        {
                            <pre class="aks-yaml-pre">@YamlText</pre>
                        }
                    </div>
                </ResizablePanel>
            }

            @* ── Helm History slide-out ── *@
            @if (HelmHistoryTarget is not null && YamlTarget is null)
            {
                <ResizablePanel DefaultWidth="480" MinWidth="300" MaxWidth="700">
                    <div class="aks-section-header">
                        <span class="aks-section-title">@(HelmRollbackMode ? "Rollback" : "History"): @HelmHistoryTarget</span>
                        <FluentButton Appearance="Appearance.Stealth" @onclick="CloseHelmHistory" Title="Close">✕</FluentButton>
                    </div>
                    @if (HelmRollbackMode)
                    {
                        <div class="aks-rollback-hint">Select a revision to rollback to:</div>
                    }
                    <div class="aks-yaml-content">
                        @if (HelmHistoryLoading)
                        {
                            <LoadingSpinner Message="Loading history…" />
                        }
                        else
                        {
                            <table class="aks-history-table">
                                <thead>
                                    <tr>
                                        <th>Rev</th><th>Status</th><th>Chart</th><th>App Version</th><th>Updated</th><th>Description</th>
                                        @if (HelmRollbackMode) { <th></th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rev in HelmHistory)
                                    {
                                        <tr class="@(rev.Status == "deployed" ? "aks-rev-current" : "")">
                                            <td>@rev.Revision</td>
                                            <td><span class="aks-status @(rev.Status == "deployed" ? "running" : rev.Status == "failed" ? "error" : "other")">@rev.Status</span></td>
                                            <td>@rev.Chart</td>
                                            <td>@rev.AppVersion</td>
                                            <td>@rev.Updated?.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@rev.Description</td>
                                            @if (HelmRollbackMode)
                                            {
                                                <td>
                                                    @if (rev.Status == "superseded")
                                                    {
                                                        var r = rev;
                                                        <button class="ctx-item destructive aks-rollback-btn" @onclick="() => OnRollbackToRevision(r)">
                                                            &#8634; Rollback
                                                        </button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </ResizablePanel>
            }

            @* ── Helm Values slide-out ── *@
            @if (HelmValuesTarget is not null && YamlTarget is null && HelmHistoryTarget is null)
            {
                <ResizablePanel DefaultWidth="380" MinWidth="250" MaxWidth="700">
                    <div class="aks-section-header">
                        <span class="aks-section-title">Values: @HelmValuesTarget</span>
                        <FluentButton Appearance="Appearance.Stealth" @onclick="CloseHelmValues" Title="Close">✕</FluentButton>
                    </div>
                    <div class="aks-yaml-content">
                        @if (HelmValuesLoading)
                        {
                            <LoadingSpinner Message="Loading values…" />
                        }
                        else
                        {
                            <pre class="aks-yaml-pre">@HelmValuesText</pre>
                        }
                    </div>
                </ResizablePanel>
            }

            @* ── Scale input bar ── *@
            @if (ScaleTarget is not null)
            {
                <div class="confirm-bar">
                    <span class="confirm-message">Scale "@ScaleTarget" to</span>
                    <input type="number" class="confirm-input" min="0" max="100"
                           style="width:70px" @bind="ScaleReplicas" @bind:event="oninput" />
                    <span class="confirm-message">replicas</span>
                    <button class="confirm-btn confirm-yes" @onclick="OnScaleConfirm">Apply</button>
                    <button class="confirm-btn confirm-no" @onclick="OnScaleCancel">Cancel</button>
                </div>
            }

            @* ── Log slide-out ── *@
            @if (LogPodName is not null && YamlTarget is null)
            {
                <ResizablePanel DefaultWidth="420" MinWidth="280" MaxWidth="800">
                    <div class="aks-section-header aks-log-header">
                        <span class="aks-section-title" title="@LogPodName">Logs: @TruncatePodName(LogPodName)</span>
                        <FluentButton Appearance="Appearance.Stealth" @onclick="CloseLogs"
                                      Title="Close log panel">✕</FluentButton>
                    </div>
                    <PodLogView Client="Client" Namespace="@CurrentNamespace" PodName="@LogPodName" />
                </ResizablePanel>
            }
        </div>
    }
</div>

@* ── Context menus ── *@
<ContextMenu @ref="DeploymentMenu">
    <button class="ctx-item" @onclick="() => OnCtxViewYaml('D')"><span class="ctx-item-icon">{ }</span> View YAML</button>
    <button class="ctx-item" @onclick="OnCtxViewDeploymentLogs"><span class="ctx-item-icon">&#9776;</span> View Logs</button>
    <div class="ctx-separator"></div>
    <button class="ctx-item" @onclick="OnCtxRestartDeployment"><span class="ctx-item-icon">&#8635;</span> Restart Deployment</button>
    <button class="ctx-item" @onclick="OnCtxScaleDeployment"><span class="ctx-item-icon">&#8693;</span> Scale...</button>
</ContextMenu>

<ContextMenu @ref="PodMenu">
    <button class="ctx-item" @onclick="() => OnCtxViewYaml('P')"><span class="ctx-item-icon">{ }</span> View YAML</button>
    <button class="ctx-item" @onclick="OnCtxViewPodLogs"><span class="ctx-item-icon">&#9776;</span> View Logs</button>
    <div class="ctx-separator"></div>
    <button class="ctx-item destructive" @onclick="OnCtxKillPod"><span class="ctx-item-icon">&#10005;</span> Kill Pod</button>
</ContextMenu>

<ContextMenu @ref="IngressMenu">
    <button class="ctx-item" @onclick="() => OnCtxViewYaml('I')"><span class="ctx-item-icon">{ }</span> View YAML</button>
    <button class="ctx-item" @onclick="OnCtxCopyHostUrl"><span class="ctx-item-icon">&#128279;</span> Copy Host URL</button>
</ContextMenu>

<ContextMenu @ref="HelmMenu">
    <button class="ctx-item" @onclick="() => OnCtxViewYaml('H')"><span class="ctx-item-icon">{ }</span> View Release YAML</button>
    <button class="ctx-item" @onclick="OnCtxViewHelmValues"><span class="ctx-item-icon">&#9998;</span> View Values</button>
    <button class="ctx-item" @onclick="OnCtxViewHelmHistory"><span class="ctx-item-icon">&#128337;</span> View History</button>
    <div class="ctx-separator"></div>
    <button class="ctx-item destructive" @onclick="OnCtxRollbackHelm"><span class="ctx-item-icon">&#8634;</span> Rollback...</button>
</ContextMenu>

@code {
    private static readonly string[] ResourceTypes = ["Deployments", "Pods", "Ingresses", "Helm"];

    private IAksClient? Client;
    private List<DeploymentInfo> Deployments = [];
    private List<PodInfo> Pods = [];
    private List<IngressInfo> Ingresses = [];
    private List<HelmReleaseInfo> HelmReleases = [];
    private List<KubernetesEvent> Events = [];
    private List<string> Namespaces = ["default"];
    private List<KubeContextInfo> Contexts = [];
    private DeploymentInfo? SelectedDeployment;
    private bool IsLoading;
    private string? ErrorMessage;
    private string? LogPodName;

    // YAML viewer state
    private (string Kind, string Name)? YamlTarget;
    private string? YamlText;
    private string? YamlError;
    private bool YamlLoading;

    // Scale state
    private string? ScaleTarget;
    private int ScaleReplicas;

    // Helm History state
    private string? HelmHistoryTarget;
    private List<HelmRevisionInfo> HelmHistory = [];
    private bool HelmHistoryLoading;

    // Helm rollback mode (history panel shows rollback buttons)
    private bool HelmRollbackMode;

    // Helm Values state
    private string? HelmValuesTarget;
    private string? HelmValuesText;
    private bool HelmValuesLoading;

    // Filter state (per-tab)
    private string DeploymentFilter = string.Empty;
    private string PodFilter = string.Empty;
    private string IngressFilter = string.Empty;
    private string HelmFilter = string.Empty;

    private string ActiveFilter
    {
        get => ActiveResourceType switch
        {
            "Deployments" => DeploymentFilter,
            "Pods" => PodFilter,
            "Ingresses" => IngressFilter,
            "Helm" => HelmFilter,
            _ => string.Empty
        };
        set
        {
            switch (ActiveResourceType)
            {
                case "Deployments": DeploymentFilter = value; break;
                case "Pods": PodFilter = value; break;
                case "Ingresses": IngressFilter = value; break;
                case "Helm": HelmFilter = value; break;
            }
        }
    }

    private IQueryable<DeploymentInfo> FilteredDeployments => string.IsNullOrWhiteSpace(DeploymentFilter)
        ? Deployments.AsQueryable()
        : Deployments.Where(d => d.Name.Contains(DeploymentFilter, StringComparison.OrdinalIgnoreCase)
            || d.Status.Contains(DeploymentFilter, StringComparison.OrdinalIgnoreCase)).AsQueryable();

    private IQueryable<PodInfo> FilteredPods => string.IsNullOrWhiteSpace(PodFilter)
        ? Pods.AsQueryable()
        : Pods.Where(p => p.Name.Contains(PodFilter, StringComparison.OrdinalIgnoreCase)
            || p.Phase.Contains(PodFilter, StringComparison.OrdinalIgnoreCase)
            || (p.NodeName?.Contains(PodFilter, StringComparison.OrdinalIgnoreCase) ?? false)).AsQueryable();

    private IQueryable<IngressInfo> FilteredIngresses => string.IsNullOrWhiteSpace(IngressFilter)
        ? Ingresses.AsQueryable()
        : Ingresses.Where(i => i.Name.Contains(IngressFilter, StringComparison.OrdinalIgnoreCase)
            || i.Rules.Any(r => r.Host?.Contains(IngressFilter, StringComparison.OrdinalIgnoreCase) ?? false)).AsQueryable();

    private IQueryable<HelmReleaseInfo> FilteredHelmReleases => string.IsNullOrWhiteSpace(HelmFilter)
        ? HelmReleases.AsQueryable()
        : HelmReleases.Where(h => h.Name.Contains(HelmFilter, StringComparison.OrdinalIgnoreCase)
            || h.Status.Contains(HelmFilter, StringComparison.OrdinalIgnoreCase)
            || (h.Chart?.Contains(HelmFilter, StringComparison.OrdinalIgnoreCase) ?? false)).AsQueryable();

    // Pod metrics
    private List<PodMetrics> PodMetricsList = [];

    private string CurrentNamespace = "default";
    private string ActiveContext = string.Empty;
    private string ActiveResourceType = "Deployments";
    private bool ShowEvents = true;

    // Context menu refs and targets
    private ContextMenu DeploymentMenu = default!;
    private ContextMenu PodMenu = default!;
    private ContextMenu IngressMenu = default!;
    private ContextMenu HelmMenu = default!;
    private AksConfirmBar Confirm = default!;

    private DeploymentInfo? CtxDeployment;
    private PodInfo? CtxPod;
    private IngressInfo? CtxIngress;
    private HelmReleaseInfo? CtxHelm;

    private bool HasAnyData => Deployments.Count > 0 || Pods.Count > 0 || Ingresses.Count > 0 || HelmReleases.Count > 0;

    private int ActiveResourceCount => ActiveResourceType switch
    {
        "Deployments" => FilteredDeployments.Count(),
        "Pods" => FilteredPods.Count(),
        "Ingresses" => FilteredIngresses.Count(),
        "Helm" => FilteredHelmReleases.Count(),
        _ => 0
    };

    private bool IsProduction => AppState.CurrentEnvironment?.IsProduction ?? false;

    protected override void OnParametersSet()
    {
        SyncFromEnvironment();
        // Fire-and-forget so the UI renders immediately with loading state
        _ = ConnectAndLoadAsync();
    }

    private void SyncFromEnvironment()
    {
        var config = AppState.CurrentEnvironment?.AksConfig;
        CurrentNamespace = string.IsNullOrWhiteSpace(config?.DefaultNamespace) ? "default" : config!.DefaultNamespace;
        ActiveContext = config?.KubeconfigContext ?? string.Empty;
    }

    private async Task ConnectAndLoadAsync()
    {
        IsLoading = true;
        await InvokeAsync(StateHasChanged);

        if (AppState.UseDemoData)
        {
            Client = new SwebKit.Core.Services.DemoAksClient();
            await LoadContextsAsync();
            await LoadNamespacesAsync();
            await LoadAsync();
            return;
        }

        var config = AppState.CurrentEnvironment?.AksConfig;
        if (config is null) return;

        try
        {
            Client = new SwebKit.Kubernetes.AksClient.KubernetesAksClient(
                string.IsNullOrWhiteSpace(config.KubeconfigContext) ? null : config.KubeconfigContext,
                string.IsNullOrWhiteSpace(config.KubeconfigPath) ? null : config.KubeconfigPath);
            await LoadContextsAsync();
            await LoadNamespacesAsync();
            await LoadAsync();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    private async Task LoadContextsAsync()
    {
        if (Client is null) return;
        try
        {
            Contexts = (await Client.GetContextsAsync()).ToList();
            if (string.IsNullOrWhiteSpace(ActiveContext))
            {
                var current = Contexts.FirstOrDefault(c => c.IsCurrent);
                if (current is not null) ActiveContext = current.Name;
            }
        }
        catch { /* keep empty */ }
    }

    private async Task LoadNamespacesAsync()
    {
        if (Client is null) return;
        try
        {
            var ns = await Client.GetNamespacesAsync();
            if (ns.Count > 0)
            {
                Namespaces = ns.ToList();
                if (!Namespaces.Contains(CurrentNamespace))
                    CurrentNamespace = Namespaces.Contains("default") ? "default" : Namespaces[0];
            }
        }
        catch { /* keep default list */ }
    }

    private bool IsMultiNamespace => CurrentNamespace == "*";

    private async Task LoadAsync()
    {
        if (Client is null) return;
        IsLoading = true; ErrorMessage = null; StateHasChanged();
        try
        {
            if (IsMultiNamespace)
            {
                var allNs = Namespaces.Where(n => n != "default" || Namespaces.Count <= 3).ToList();
                var deploymentsTask = Client.GetDeploymentsAsync(allNs);
                var podsTask = Client.GetPodsAsync(allNs);

                await Task.WhenAll(deploymentsTask, podsTask);

                Deployments = deploymentsTask.Result.ToList();
                Pods = podsTask.Result.ToList();
                Ingresses = [];
                HelmReleases = [];
                Events = [];
                PodMetricsList = [];
            }
            else
            {
                var ns = CurrentNamespace;
                var deploymentsTask = Client.GetDeploymentsAsync(ns);
                var podsTask = Client.GetPodsAsync(ns);
                var ingressesTask = Client.GetIngressesAsync(ns);
                var helmTask = Client.GetHelmReleasesAsync(ns);
                var eventsTask = Client.GetEventsAsync(ns);
                var metricsTask = Client.GetPodMetricsAsync(ns);

                await Task.WhenAll(deploymentsTask, podsTask, ingressesTask, helmTask, eventsTask, metricsTask);

                Deployments = deploymentsTask.Result.ToList();
                Pods = podsTask.Result.ToList();
                Ingresses = ingressesTask.Result.ToList();
                HelmReleases = helmTask.Result.ToList();
                Events = eventsTask.Result.Take(50).ToList();
                PodMetricsList = metricsTask.Result.ToList();
            }
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; StateHasChanged(); }
    }

    private async Task OnContextChanged(ChangeEventArgs e)
    {
        var newContext = e.Value?.ToString() ?? "";
        if (newContext == ActiveContext) return;
        ActiveContext = newContext;

        if (!AppState.UseDemoData)
        {
            var config = AppState.CurrentEnvironment?.AksConfig;
            try
            {
                Client = new SwebKit.Kubernetes.AksClient.KubernetesAksClient(
                    string.IsNullOrWhiteSpace(newContext) ? null : newContext,
                    string.IsNullOrWhiteSpace(config?.KubeconfigPath) ? null : config?.KubeconfigPath);
            }
            catch (Exception ex) { ErrorMessage = ex.Message; return; }
        }

        await LoadNamespacesAsync();
        await LoadAsync();
    }

    private async Task OnNamespaceChanged(ChangeEventArgs e)
    {
        CurrentNamespace = e.Value?.ToString() ?? "default";
        await LoadAsync();
    }

    private void SwitchResourceType(string type)
    {
        ActiveResourceType = type;
        StateHasChanged();
    }

    private void OnFilterChanged(string value)
    {
        ActiveFilter = value;
        StateHasChanged();
    }

