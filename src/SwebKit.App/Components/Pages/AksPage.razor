                @* ── Secret detail slide-out ── *@
                @if (SecretDetailTarget is not null && YamlTarget is null)
                {
                    <ResizablePanel DefaultWidth="420" MinWidth="280" MaxWidth="800">
                        <div class="aks-section-header">
                            <span class="aks-section-title">Secret: @SecretDetailTarget.Name</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseSecretDetail" Title="Close">✕
                            </FluentButton>
                        </div>
                        <SecretDetailPanel Client="Client" Namespace="@CurrentNamespace" Secret="SecretDetailTarget" />
                    </ResizablePanel>
                }

                @* ── HPA detail slide-out ── *@
                @if (HpaDetailTarget is not null && YamlTarget is null)
                {
                    <ResizablePanel DefaultWidth="360" MinWidth="260" MaxWidth="600">
                        <div class="aks-section-header">
                            <span class="aks-section-title">HPA: @HpaDetailTarget.Name</span>
                            <FluentButton Appearance="Appearance.Stealth"
                                          @onclick="() => { HpaDetailTarget = null; StateHasChanged(); }" Title="Close">✕</FluentButton>
                        </div>
                        <div class="aks-yaml-content">
                            <div class="aks-hpa-detail">
                                <div class="aks-hpa-row">
                                    <span class="aks-hpa-label">Target</span>
                                    <span>@HpaDetailTarget.TargetKind: @HpaDetailTarget.TargetName</span>
                                </div>
                                <div class="aks-hpa-row">
                                    <span class="aks-hpa-label">Replicas</span>
                                    <span>@HpaDetailTarget.CurrentReplicas current / @HpaDetailTarget.DesiredReplicas desired (min
                                        @HpaDetailTarget.MinReplicas, max @HpaDetailTarget.MaxReplicas)</span>
                                    </div>
                                    @if (HpaDetailTarget.Metrics.Count > 0)
                                    {
                                        <div class="aks-hpa-section-label">Metrics</div>
                                        <table class="aks-hpa-table">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Type</th>
                                                    <th>Current</th>
                                                    <th>Target</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var m in HpaDetailTarget.Metrics)
                                                {
                                                    <tr>
                                                        <td>@m.Name</td>
                                                        <td><span class="aks-text-muted">@m.Type</span></td>
                                                        <td>@(m.CurrentValue.HasValue ? $"{m.CurrentValue:F0}%" : "—")</td>
                                                        <td>@(m.TargetValue.HasValue ? $"{m.TargetValue:F0}%" : "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    @if (HpaDetailTarget.Conditions.Count > 0)
                                    {
                                        <div class="aks-hpa-section-label">Conditions</div>
                                        <table class="aks-hpa-table">
                                            <thead>
                                                <tr>
                                                    <th>Type</th>
                                                    <th>Status</th>
                                                    <th>Reason</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var cond in HpaDetailTarget.Conditions)
                                                {
                                                    <tr>
                                                        <td>@cond.Type</td>
                                                        <td><span
                                                            class="aks-ready-badge @(cond.Status == "True" ? "healthy" : "degraded")">@cond.Status</span>
                                                        </td>
                                                        <td class="aks-text-muted">@cond.Reason</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </div>
                        </ResizablePanel>
                    }
                </div>
            }
        </div>

        @* ── Context menus ── *@
        <ContextMenu @ref="DeploymentMenu">
            <button class="ctx-item" @onclick="() => OnCtxViewYaml('D')"><span class="ctx-item-icon">{ }</span> View
                YAML</button>
                <button class="ctx-item" @onclick="() => OnCtxEditYaml('D')"><span class="ctx-item-icon">✎</span> Edit YAML</button>
                <button class="ctx-item" @onclick="OnCtxViewDeploymentLogs"><span class="ctx-item-icon">&#9776;</span> View
