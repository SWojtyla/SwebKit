                                                </ContextMenu>

                                                <ContextMenu @ref="IngressMenu">
                                                    <button class="ctx-item" @onclick="() => OnCtxViewYaml('I')"><span class="ctx-item-icon">{ }</span> View
                                                        YAML</button>
                                                        <button class="ctx-item" @onclick="() => OnCtxEditYaml('I')"><span class="ctx-item-icon">✎</span> Edit YAML</button>
                                                        <button class="ctx-item" @onclick="OnCtxCopyHostUrl"><span class="ctx-item-icon">&#128279;</span> Copy Host
                                                            URL</button>
                                                        </ContextMenu>

                                                        <ContextMenu @ref="HelmMenu">
                                                            <button class="ctx-item" @onclick="() => OnCtxViewYaml('H')"><span class="ctx-item-icon">{ }</span> View Release
                                                                YAML</button>
                                                                <button class="ctx-item" @onclick="OnCtxViewHelmValues"><span class="ctx-item-icon">&#9998;</span> View
                                                                    Values</button>
                                                                    <button class="ctx-item" @onclick="OnCtxViewHelmHistory"><span class="ctx-item-icon">&#128337;</span> View
                                                                        History</button>
                                                                        <div class="ctx-separator"></div>
                                                                        <button class="ctx-item destructive" @onclick="OnCtxRollbackHelm"><span class="ctx-item-icon">&#8634;</span>
                                                                            Rollback...</button>
                                                                        </ContextMenu>

                                                                        <ContextMenu @ref="StatefulSetMenu">
                                                                            <button class="ctx-item" @onclick="() => OnCtxViewYaml('S')"><span class="ctx-item-icon">{ }</span> View
                                                                                YAML</button>
                                                                                <button class="ctx-item" @onclick="() => OnCtxEditYaml('S')"><span class="ctx-item-icon">✎</span> Edit YAML</button>
                                                                                <button class="ctx-item" @onclick="OnCtxAllPodsLogsStatefulSet"><span class="ctx-item-icon">&#9782;</span> Logs for
                                                                                    all pods</button>
                                                                                    <div class="ctx-separator"></div>
                                                                                    <button class="ctx-item" @onclick="OnCtxRestartStatefulSet"><span class="ctx-item-icon">&#8635;</span>
                                                                                        Restart</button>
                                                                                        <button class="ctx-item" @onclick="OnCtxScaleStatefulSet"><span class="ctx-item-icon">&#8693;</span>
                                                                                            Scale...</button>
                                                                                        </ContextMenu>

                                                                                        <ContextMenu @ref="ConfigMapMenu">
                                                                                            <button class="ctx-item" @onclick="() => OnCtxViewYaml('C')"><span class="ctx-item-icon">{ }</span> View
                                                                                                YAML</button>
                                                                                                <button class="ctx-item" @onclick="() => OnCtxEditYaml('C')"><span class="ctx-item-icon">✎</span> Edit YAML</button>
                                                                                                <button class="ctx-item" @onclick="OnCtxViewConfigMapKeys"><span class="ctx-item-icon">&#128273;</span> View
                                                                                                    Keys</button>
                                                                                                </ContextMenu>

                                                                                                <ContextMenu @ref="SecretMenu">
                                                                                                    <button class="ctx-item" @onclick="() => OnCtxViewYaml('E')"><span class="ctx-item-icon">{ }</span> View
                                                                                                        YAML</button>
                                                                                                        <button class="ctx-item" @onclick="() => OnCtxEditYaml('E')"><span class="ctx-item-icon">✎</span> Edit YAML</button>
                                                                                                        <button class="ctx-item" @onclick="OnCtxViewSecretKeys"><span class="ctx-item-icon">&#128274;</span> View
                                                                                                            Keys</button>
                                                                                                        </ContextMenu>

@code {
    private static readonly string[] ResourceTypes = ["Deployments", "StatefulSets", "Pods", "ConfigMaps", "Secrets",
"Ingresses", "Helm"];

    private IAksClient? Client;
    private List<DeploymentInfo> Deployments = [];
    private List<StatefulSetInfo> StatefulSets = [];
    private List<PodInfo> Pods = [];
    private List<IngressInfo> Ingresses = [];
    private List<HelmReleaseInfo> HelmReleases = [];
    private List<ConfigMapInfo> ConfigMaps = [];
    private List<SecretInfo> Secrets = [];
    private List<HpaInfo> Hpas = [];
    private List<KubernetesEvent> Events = [];
    private List<string> Namespaces = ["default"];
    private List<KubeContextInfo> Contexts = [];
    private DeploymentInfo? SelectedDeployment;
    private bool IsLoading;
    private string? ErrorMessage;
    private string? LogPodName;
    private string? LogDeploymentName;
    private string? ContainerDetailPodName;
    private ConfigMapInfo? ConfigMapDetailTarget;
    private SecretInfo? SecretDetailTarget;
    private HpaInfo? HpaDetailTarget;
    private bool _scaleIsStatefulSet;

    // YAML viewer/editor state
    private (string Kind, string Name)? YamlTarget;
    private string? YamlText;
    private string? YamlError;
    private bool YamlLoading;
    private bool YamlEditMode;
    private string YamlEditText = string.Empty;
    private bool YamlApplying;

    // Highlighted markup for YAML panels
    private MarkupString _yamlHighlighted;
    private MarkupString _yamlEditHighlighted;
    private MarkupString _helmValuesHighlighted;

    // Edit overlay refs & lifecycle flags
    private ElementReference _editTextarea;
    private ElementReference _editPre;
    private bool _initEditOverlay;
    private int _editKey;

    // Only these resource types are editable
    private bool YamlIsEditable => YamlTarget?.Kind is "Deployment" or "Ingress" or "StatefulSet" or "ConfigMap" or
    "Secret";

    // Scale state
    private string? ScaleTarget;
    private int ScaleReplicas; // Helm History state
    private string? HelmHistoryTarget;
    private List<HelmRevisionInfo> HelmHistory = [];
    private bool HelmHistoryLoading;

    // Helm rollback mode (history panel shows rollback buttons)
    private bool HelmRollbackMode;

    // Helm Values state
    private string? HelmValuesTarget;
    private string? HelmValuesText;
    private bool HelmValuesLoading;

    // Filter state (per-tab)
    private string DeploymentFilter = string.Empty;
    private string StatefulSetFilter = string.Empty;
    private string PodFilter = string.Empty;
    private string IngressFilter = string.Empty;
    private string HelmFilter = string.Empty;
    private string ConfigMapFilter = string.Empty;
    private string SecretFilter = string.Empty;

    private string ActiveFilter
    {
        get => ActiveResourceType switch
        {
            "Deployments" => DeploymentFilter,
            "StatefulSets" => StatefulSetFilter,
            "Pods" => PodFilter,
            "Ingresses" => IngressFilter,
            "Helm" => HelmFilter,
            "ConfigMaps" => ConfigMapFilter,
            "Secrets" => SecretFilter,
            _ => string.Empty
        };
        set
        {
            switch (ActiveResourceType)
            {
                case "Deployments": DeploymentFilter = value; break;
                case "StatefulSets": StatefulSetFilter = value; break;
                case "Pods": PodFilter = value; break;
                case "Ingresses": IngressFilter = value; break;
                case "Helm": HelmFilter = value; break;
                case "ConfigMaps": ConfigMapFilter = value; break;
                case "Secrets": SecretFilter = value; break;
            }
        }
    }

    private IQueryable<DeploymentInfo> FilteredDeployments => string.IsNullOrWhiteSpace(DeploymentFilter)
    ? Deployments.AsQueryable()
    : Deployments.Where(d => d.Name.Contains(DeploymentFilter, StringComparison.OrdinalIgnoreCase)
    || d.Status.Contains(DeploymentFilter, StringComparison.OrdinalIgnoreCase)).AsQueryable();

    private IQueryable<StatefulSetInfo> FilteredStatefulSets => string.IsNullOrWhiteSpace(StatefulSetFilter)
    ? StatefulSets.AsQueryable()
    : StatefulSets.Where(s => s.Name.Contains(StatefulSetFilter, StringComparison.OrdinalIgnoreCase)).AsQueryable();

    private IQueryable<PodInfo> FilteredPods => string.IsNullOrWhiteSpace(PodFilter)
    ? Pods.AsQueryable()
    : Pods.Where(p => p.Name.Contains(PodFilter, StringComparison.OrdinalIgnoreCase)
    || p.Phase.Contains(PodFilter, StringComparison.OrdinalIgnoreCase)
    || (p.NodeName?.Contains(PodFilter, StringComparison.OrdinalIgnoreCase) ?? false)).AsQueryable();

    private IQueryable<IngressInfo> FilteredIngresses => string.IsNullOrWhiteSpace(IngressFilter)
    ? Ingresses.AsQueryable()
    : Ingresses.Where(i => i.Name.Contains(IngressFilter, StringComparison.OrdinalIgnoreCase)
    || i.Rules.Any(r => r.Host?.Contains(IngressFilter, StringComparison.OrdinalIgnoreCase) ?? false)).AsQueryable();

    private IQueryable<HelmReleaseInfo> FilteredHelmReleases => string.IsNullOrWhiteSpace(HelmFilter)
    ? HelmReleases.AsQueryable()
    : HelmReleases.Where(h => h.Name.Contains(HelmFilter, StringComparison.OrdinalIgnoreCase)
    || h.Status.Contains(HelmFilter, StringComparison.OrdinalIgnoreCase)
    || (h.Chart?.Contains(HelmFilter, StringComparison.OrdinalIgnoreCase) ?? false)).AsQueryable();

    private IQueryable<ConfigMapInfo> FilteredConfigMaps => string.IsNullOrWhiteSpace(ConfigMapFilter)
    ? ConfigMaps.AsQueryable()
    : ConfigMaps.Where(cm => cm.Name.Contains(ConfigMapFilter, StringComparison.OrdinalIgnoreCase)).AsQueryable();

    private IQueryable<SecretInfo> FilteredSecrets => string.IsNullOrWhiteSpace(SecretFilter)
    ? Secrets.AsQueryable()
    : Secrets.Where(s => s.Name.Contains(SecretFilter, StringComparison.OrdinalIgnoreCase)
    || s.Type.Contains(SecretFilter, StringComparison.OrdinalIgnoreCase)).AsQueryable();

    // Pod metrics
    private List<PodMetrics> PodMetricsList = [];

    private string CurrentNamespace = "default";
    private string ActiveContext = string.Empty;
    private string ActiveResourceType = "Deployments";
    private bool ShowEvents = true;

    // Namespace picker state
    private bool NsDropOpen;
    private string NsSearchText = string.Empty;

    private IEnumerable<string> NsFiltered
    {
        get
        {
            var all = Enumerable.Repeat("*", 1).Concat(Namespaces);
            return string.IsNullOrWhiteSpace(NsSearchText)
            ? all
            : all.Where(n => n.Contains(NsSearchText, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void OpenNsDrop()
    {
        NsSearchText = string.Empty;
        NsDropOpen = true;
        StateHasChanged();
    }

    private void CloseNsDrop()
    {
        NsDropOpen = false;
        NsSearchText = string.Empty;
        StateHasChanged();
    }

    private void OnNsSearchInput(ChangeEventArgs e)
    {
        NsSearchText = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private async Task SelectNs(string ns)
    {
        NsDropOpen = false;
        NsSearchText = string.Empty;
        CurrentNamespace = ns;
        await LoadAsync();
    }

    // Context menu refs and targets
    private ContextMenu DeploymentMenu = default!;
    private ContextMenu PodMenu = default!;
    private ContextMenu IngressMenu = default!;
    private ContextMenu HelmMenu = default!;
    private ContextMenu StatefulSetMenu = default!;
    private ContextMenu ConfigMapMenu = default!;
    private ContextMenu SecretMenu = default!;
    private AksConfirmBar Confirm = default!;

    private DeploymentInfo? CtxDeployment;
    private PodInfo? CtxPod;
    private IngressInfo? CtxIngress;
    private HelmReleaseInfo? CtxHelm;
    private StatefulSetInfo? CtxStatefulSet;
    private ConfigMapInfo? CtxConfigMap;
    private SecretInfo? CtxSecret;

    private bool HasAnyData => Deployments.Count > 0 || StatefulSets.Count > 0 || Pods.Count > 0
    || Ingresses.Count > 0 || HelmReleases.Count > 0 || ConfigMaps.Count > 0 || Secrets.Count > 0;

    private int ActiveResourceCount => ActiveResourceType switch
    {
        "Deployments" => FilteredDeployments.Count(),
        "StatefulSets" => FilteredStatefulSets.Count(),
        "Pods" => FilteredPods.Count(),
        "Ingresses" => FilteredIngresses.Count(),
        "Helm" => FilteredHelmReleases.Count(),
        "ConfigMaps" => FilteredConfigMaps.Count(),
        "Secrets" => FilteredSecrets.Count(),
        _ => 0
    };

    private bool HasOpenPanel =>
    LogPodName is not null ||
    LogDeploymentName is not null ||
    YamlTarget is not null ||
    ScaleTarget is not null ||
    HelmHistoryTarget is not null ||
    HelmValuesTarget is not null ||
    ConfigMapDetailTarget is not null ||
    SecretDetailTarget is not null ||
    ContainerDetailPodName is not null ||
    HpaDetailTarget is not null ||
    YamlEditMode;

    private bool IsProduction => AppState.CurrentEnvironment?.IsProduction ?? false;

    protected override void OnParametersSet()
    {
        SyncFromEnvironment();
        // Fire-and-forget so the UI renders immediately with loading state
        _ = ConnectAndLoadAsync();
    }

    private void SyncFromEnvironment()
    {
        var config = AppState.CurrentEnvironment?.AksConfig;
        CurrentNamespace = string.IsNullOrWhiteSpace(config?.DefaultNamespace) ? "default" : config!.DefaultNamespace;
        ActiveContext = config?.KubeconfigContext ?? string.Empty;
    }

    private async Task ConnectAndLoadAsync()
    {
        IsLoading = true;
        await InvokeAsync(StateHasChanged);

        if (AppState.UseDemoData)
        {
            Client = new SwebKit.Core.Services.DemoAksClient();
            await LoadContextsAsync();
            await LoadNamespacesAsync();
            await LoadAsync();
            return;
        }

        var config = AppState.CurrentEnvironment?.AksConfig;
        if (config is null) return;

        try
        {
            Client = new SwebKit.Kubernetes.AksClient.KubernetesAksClient(
            string.IsNullOrWhiteSpace(config.KubeconfigContext) ? null : config.KubeconfigContext,
            string.IsNullOrWhiteSpace(config.KubeconfigPath) ? null : config.KubeconfigPath);
            await LoadContextsAsync();
            await LoadNamespacesAsync();
            await LoadAsync();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    private async Task LoadContextsAsync()
    {
        if (Client is null) return;
        try
        {
            Contexts = (await Client.GetContextsAsync()).ToList();
            if (string.IsNullOrWhiteSpace(ActiveContext))
            {
                var current = Contexts.FirstOrDefault(c => c.IsCurrent);
                if (current is not null) ActiveContext = current.Name;
            }
        }
        catch { /* keep empty */ }
    }

    private async Task LoadNamespacesAsync()
    {
        if (Client is null) return;
        try
        {
            var ns = await Client.GetNamespacesAsync();
            if (ns.Count > 0)
            {
                Namespaces = ns.ToList();
                if (!Namespaces.Contains(CurrentNamespace))
                    CurrentNamespace = Namespaces.Contains("default") ? "default" : Namespaces[0];
            }
        }
        catch { /* keep default list */ }
    }

    private bool IsMultiNamespace => CurrentNamespace == "*";

    private async Task LoadAsync()
    {
        if (Client is null) return;
        IsLoading = true; ErrorMessage = null; StateHasChanged();
        try
        {
            if (IsMultiNamespace)
            {
                var allNs = Namespaces.Where(n => n != "default" || Namespaces.Count <= 3).ToList();
                var deploymentsTask = Client.GetDeploymentsAsync(allNs);
                var podsTask = Client.GetPodsAsync(allNs);
                var statefulSetsTask = Client.GetStatefulSetsAsync(allNs);

                await Task.WhenAll(deploymentsTask, podsTask, statefulSetsTask);

                Deployments = deploymentsTask.Result.ToList();
                Pods = podsTask.Result.ToList();
                StatefulSets = statefulSetsTask.Result.ToList();
                Ingresses = [];
                HelmReleases = [];
                ConfigMaps = [];
                Secrets = [];
                Hpas = [];
                Events = [];
                PodMetricsList = [];
            }
            else
            {
                var ns = CurrentNamespace;
                var deploymentsTask = Client.GetDeploymentsAsync(ns);
                var statefulSetsTask = Client.GetStatefulSetsAsync(ns);
                var podsTask = Client.GetPodsAsync(ns);
                var ingressesTask = Client.GetIngressesAsync(ns);
                var helmTask = Client.GetHelmReleasesAsync(ns);
                var eventsTask = Client.GetEventsAsync(ns);
                var metricsTask = Client.GetPodMetricsAsync(ns);
                var configMapsTask = Client.GetConfigMapsAsync(ns);
                var secretsTask = Client.GetSecretsAsync(ns);
                var hpasTask = Client.GetHpasAsync(ns);

                await Task.WhenAll(deploymentsTask, statefulSetsTask, podsTask, ingressesTask,
                helmTask, eventsTask, metricsTask, configMapsTask, secretsTask, hpasTask);

                Deployments = deploymentsTask.Result.ToList();
                StatefulSets = statefulSetsTask.Result.ToList();
                Pods = podsTask.Result.ToList();
                Ingresses = ingressesTask.Result.ToList();
                HelmReleases = helmTask.Result.ToList();
                Events = eventsTask.Result.Take(50).ToList();
                PodMetricsList = metricsTask.Result.ToList();
                ConfigMaps = configMapsTask.Result.ToList();
                Secrets = secretsTask.Result.ToList();
                Hpas = hpasTask.Result.ToList();
            }
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; StateHasChanged(); }
    }

    private async Task OnContextChanged(ChangeEventArgs e)
    {
        var newContext = e.Value?.ToString() ?? "";
        if (newContext == ActiveContext) return;
        ActiveContext = newContext;

        if (!AppState.UseDemoData)
        {
            var config = AppState.CurrentEnvironment?.AksConfig;
            try
            {
                Client = new SwebKit.Kubernetes.AksClient.KubernetesAksClient(
                string.IsNullOrWhiteSpace(newContext) ? null : newContext,
                string.IsNullOrWhiteSpace(config?.KubeconfigPath) ? null : config?.KubeconfigPath);
            }
            catch (Exception ex) { ErrorMessage = ex.Message; return; }
        }

        await LoadNamespacesAsync();
        await LoadAsync();
    }

