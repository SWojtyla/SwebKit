    : CronJobs.Where(c => c.Name.Contains(CronJobFilter, StringComparison.OrdinalIgnoreCase)
    || (c.Schedule?.Contains(CronJobFilter, StringComparison.OrdinalIgnoreCase) ?? false)).AsQueryable();

