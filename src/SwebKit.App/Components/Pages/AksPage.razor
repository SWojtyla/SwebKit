    protected override void OnParametersSet()
    {
        SyncFromEnvironment();
        // Fire-and-forget so the UI renders immediately with loading state
        _ = ConnectAndLoadAsync();
    }

    private void SyncFromEnvironment()
    {
        var config = AppState.Config.AksConfig;
        CurrentNamespace = string.IsNullOrWhiteSpace(config?.DefaultNamespace) ? "default" : config!.DefaultNamespace;
        ActiveContext = config?.KubeconfigContext ?? string.Empty;
    }

    private async Task ConnectAndLoadAsync()
    {
        IsLoading = true;
        await InvokeAsync(StateHasChanged);

        if (AppState.UseDemoData)
        {
            Client = new SwebKit.Core.Services.DemoAksClient();
            await LoadContextsAsync();
            await LoadNamespacesAsync();
            await LoadAsync();
            ConnectionState.SetConnected("aks");
            return;
        }

        var config = AppState.Config.AksConfig;
        if (config is null)
        {
            ConnectionState.SetNotConfigured("aks");
            return;
        }

        try
        {
            Client = new SwebKit.Kubernetes.AksClient.KubernetesAksClient(
            string.IsNullOrWhiteSpace(config.KubeconfigContext) ? null : config.KubeconfigContext,
            string.IsNullOrWhiteSpace(config.KubeconfigPath) ? null : config.KubeconfigPath);
            await LoadContextsAsync();
            await LoadNamespacesAsync();
            await LoadAsync();
            ConnectionState.SetConnected("aks");
        }
        catch (Exception ex) { ErrorMessage = ex.Message; ConnectionState.SetError("aks", ex.Message); }
    }

    private async Task LoadContextsAsync()
    {
        if (Client is null) return;
        try
        {
            Contexts = (await Client.GetContextsAsync()).ToList();
            if (string.IsNullOrWhiteSpace(ActiveContext))
            {
                var current = Contexts.FirstOrDefault(c => c.IsCurrent);
                if (current is not null) ActiveContext = current.Name;
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"LoadContextsAsync failed: {ex.Message}");
        }
    }

    private async Task LoadNamespacesAsync()
    {
        if (Client is null) return;
        try
        {
            var ns = await Client.GetNamespacesAsync();
            if (ns.Count > 0)
            {
                Namespaces = ns.ToList();
                if (!Namespaces.Contains(CurrentNamespace))
                    CurrentNamespace = Namespaces.Contains("default") ? "default" : Namespaces[0];
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"LoadNamespacesAsync failed: {ex.Message}");
        }
    }

    private bool IsMultiNamespace => CurrentNamespace == "*";

    private async Task LoadAsync()
    {
        if (Client is null) return;

        // PERF-18: Restore cached data for instant back-navigation rendering
        var cacheKey = !string.IsNullOrEmpty(ActiveContext) && !string.IsNullOrEmpty(CurrentNamespace)
            ? $"aks:{ActiveContext}:{CurrentNamespace}" : null;
        var cached = cacheKey is not null ? Cache.Get<AksPageSnapshot>(cacheKey) : null;
        if (cached is not null)
        {
            Deployments = cached.Deployments;
            StatefulSets = cached.StatefulSets;
            Pods = cached.Pods;
            Ingresses = cached.Ingresses;
            HelmReleases = cached.HelmReleases;
            ConfigMaps = cached.ConfigMaps;
            Secrets = cached.Secrets;
            Hpas = cached.Hpas;
            Events = cached.Events;
            CronJobs = cached.CronJobs;
            PodMetricsList = cached.PodMetricsList;
            IsLoading = false;
            StateHasChanged();
            // Continue to background-refresh (stale-while-revalidate)
        }

        // PERF-16: Cancel any in-flight load before starting a new one
        var newCts = new CancellationTokenSource();
        var oldCts = Interlocked.Exchange(ref _cts, newCts);
        oldCts?.Cancel();
        oldCts?.Dispose();
        var ct = newCts.Token;

        IsLoading = cached is null; ErrorMessage = null; StateHasChanged();
        try
        {
            // PERF-7: Incremental rendering — each dataset renders as it completes
            // PERF2-8: Batch StateHasChanged via dirty flag + debounced flush loop
            bool datasetDirty = false;

            async Task LoadDataset<T>(Func<Task<IReadOnlyList<T>>> fetch, Action<List<T>> assign)
            {
                ct.ThrowIfCancellationRequested();
                try
                {
                    var result = await fetch();
                    ct.ThrowIfCancellationRequested();
                    assign(result.ToList());
                    datasetDirty = true;
                }
                catch (OperationCanceledException) { throw; } // CS-2
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"Dataset load failed: {ex.Message}");
                }
            }

            if (IsMultiNamespace)
            {
                var allNs = Namespaces.Where(n => n != "default" || Namespaces.Count <= 3).ToList();

                // Clear non-loaded lists synchronously
                Ingresses = [];
                HelmReleases = [];
                ConfigMaps = [];
                Secrets = [];
                Hpas = [];
                Events = [];
                PodMetricsList = [];
                CronJobs = [];

                var tasks = new List<Task>
                {
                    LoadDataset(() => Client.GetDeploymentsAsync(allNs), r => Deployments = r),
                    LoadDataset(() => Client.GetPodsAsync(allNs), r => Pods = r),
                    LoadDataset(() => Client.GetStatefulSetsAsync(allNs), r => StatefulSets = r),
                };

                // PERF2-8: Render flush loop — batch renders at ~150ms intervals
                var flushCts = CancellationTokenSource.CreateLinkedTokenSource(ct);
                var flushTask = Task.Run(async () =>
                {
                    try
                    {
                        while (!flushCts.Token.IsCancellationRequested)
                        {
                            await Task.Delay(150, flushCts.Token);
                            if (datasetDirty)
                            {
                                datasetDirty = false;
                                await InvokeAsync(StateHasChanged);
                            }
                        }
                    }
                    catch (OperationCanceledException) { }
                });

                await Task.WhenAll(tasks);
                flushCts.Cancel();
                flushCts.Dispose();

                // Final flush — render any remaining dirty state
                datasetDirty = false;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                var ns = CurrentNamespace;

                var tasks = new List<Task>
                {
                    LoadDataset(() => Client.GetDeploymentsAsync(ns), r => Deployments = r),
                    LoadDataset(() => Client.GetStatefulSetsAsync(ns), r => StatefulSets = r),
                    LoadDataset(() => Client.GetPodsAsync(ns), r => Pods = r),
                    LoadDataset(() => Client.GetIngressesAsync(ns), r => Ingresses = r),
                    LoadDataset(() => Client.GetHelmReleasesAsync(ns), r => HelmReleases = r),
                    LoadDataset(async () => (IReadOnlyList<KubernetesEvent>)(await Client.GetEventsAsync(ns)).Take(50).ToList(), r => Events
= r),
                    LoadDataset(() => Client.GetPodMetricsAsync(ns), r => PodMetricsList = r),
                    LoadDataset(() => Client.GetConfigMapsAsync(ns), r => ConfigMaps = r),
                    LoadDataset(() => Client.GetSecretsAsync(ns), r => Secrets = r),
                    LoadDataset(() => Client.GetHpasAsync(ns), r => Hpas = r),
                    LoadDataset(() => Client.GetCronJobsAsync(ns), r => CronJobs = r),
                };

                // PERF2-8: Render flush loop — batch renders at ~150ms intervals
                var flushCts = CancellationTokenSource.CreateLinkedTokenSource(ct);
                var flushTask = Task.Run(async () =>
                {
                    try
                    {
                        while (!flushCts.Token.IsCancellationRequested)
                        {
                            await Task.Delay(150, flushCts.Token);
                            if (datasetDirty)
                            {
                                datasetDirty = false;
                                await InvokeAsync(StateHasChanged);
                            }
                        }
                    }
                    catch (OperationCanceledException) { }
                });

                await Task.WhenAll(tasks);
                flushCts.Cancel();
                flushCts.Dispose();

                // Final flush — render any remaining dirty state
                datasetDirty = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { return; } // CS-2: cancelled — new load takes over
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                // PERF-18: Save fresh data to cache
                if (cacheKey is not null)
                {
                    Cache.Set(cacheKey, new AksPageSnapshot(
                        Deployments, StatefulSets, Pods, Ingresses, HelmReleases,
                        ConfigMaps, Secrets, Hpas, Events, CronJobs, PodMetricsList));
                }

                IsLoading = false;
                await InvokeAsync(StateHasChanged); // BL-2
            }
        }
    }

    private async Task HandleContextChangedAsync(string newContext)
    {
        if (newContext == ActiveContext) return;
        Cache.InvalidateByPrefix("aks:"); // PERF-18: context switch — invalidate stale cache
        ActiveContext = newContext;

        if (!AppState.UseDemoData)
        {
            var config = AppState.Config.AksConfig;
            try
            {
                Client = new SwebKit.Kubernetes.AksClient.KubernetesAksClient(
                string.IsNullOrWhiteSpace(newContext) ? null : newContext,
                string.IsNullOrWhiteSpace(config?.KubeconfigPath) ? null : config?.KubeconfigPath);
            }
            catch (Exception ex) { ErrorMessage = ex.Message; return; }
        }

        await LoadNamespacesAsync();
        await LoadAsync();
    }

    private async Task HandleNamespaceChangedAsync(string ns)
    {
        CurrentNamespace = ns;
        // PERF-18: namespace switch does NOT invalidate — each ns has its own cache key
        await LoadAsync();
    }

