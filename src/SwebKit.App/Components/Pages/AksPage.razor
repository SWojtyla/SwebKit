    // ── Context menu actions ──

    private async Task OnCtxViewYaml(char source)
    {
        var (kind, name) = source switch
        {
            'D' => ("Deployment", CtxDeployment?.Name),
            'P' => ("Pod", CtxPod?.Name),
            'I' => ("Ingress", CtxIngress?.Name),
            'H' => ("Helm", CtxHelm?.Name),
            _ => ((string?)null, (string?)null)
        };
        CloseAllMenus();
        if (kind is not null && name is not null)
            await OpenYaml(kind, name);
    }

    private void OnCtxViewDeploymentLogs()
    {
        var deployment = CtxDeployment;
        CloseAllMenus();
        if (deployment is null) return;
        CloseYaml();
        var pod = Pods.FirstOrDefault(p => p.Name.StartsWith(deployment.Name));
        if (pod is not null) { LogPodName = pod.Name; StateHasChanged(); }
    }

    private void OnCtxViewPodLogs()
    {
        var pod = CtxPod;
        CloseAllMenus();
        if (pod is null) return;
        CloseYaml();
        LogPodName = pod.Name;
        StateHasChanged();
    }

    private async Task OnCtxRestartDeployment()
    {
        var deployment = CtxDeployment;
        CloseAllMenus();
        if (deployment is null || Client is null) return;

        var confirmed = await Confirm.ShowAsync(
            $"Restart deployment \"{deployment.Name}\"?",
            deployment.Name,
            requireTypedName: IsProduction);
        if (!confirmed) return;

        try
        {
            await Client.RestartDeploymentAsync(CurrentNamespace, deployment.Name);
            await LoadAsync();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    private async Task OnCtxKillPod()
    {
        var pod = CtxPod;
        CloseAllMenus();
        if (pod is null || Client is null) return;

        var confirmed = await Confirm.ShowAsync(
            $"Delete pod \"{pod.Name}\"? This is irreversible.",
            pod.Name,
            requireTypedName: IsProduction);
        if (!confirmed) return;

        try
        {
            await Client.DeletePodAsync(CurrentNamespace, pod.Name);
            if (LogPodName == pod.Name) CloseLogs();
            await LoadAsync();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    private void OnCtxCopyHostUrl()
    {
        var ingress = CtxIngress;
        CloseAllMenus();
        if (ingress is null) return;
        var host = ingress.Rules.FirstOrDefault(r => r.Host is not null)?.Host;
        // Clipboard copy handled via JS interop would go here; for now just a no-op
        // TODO: wire clipboard via JSRuntime
    }

    private void OnCtxScaleDeployment()
    {
        var deployment = CtxDeployment;
        CloseAllMenus();
        if (deployment is null) return;
        ScaleTarget = deployment.Name;
        ScaleReplicas = deployment.Replicas;
        StateHasChanged();
    }

    private async Task OnScaleConfirm()
    {
        if (ScaleTarget is null || Client is null) return;
        var name = ScaleTarget;
        var replicas = ScaleReplicas;
        ScaleTarget = null;
        StateHasChanged();

        if (IsProduction)
        {
            var confirmed = await Confirm.ShowAsync(
                $"Scale \"{name}\" to {replicas} replicas in production?",
                name,
                requireTypedName: true);
            if (!confirmed) return;
        }

        try
        {
            await Client.ScaleDeploymentAsync(CurrentNamespace, name, replicas);
            await LoadAsync();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    private void OnScaleCancel()
    {
        ScaleTarget = null;
        StateHasChanged();
    }

    private async Task OnCtxViewHelmHistory()
    {
        var helm = CtxHelm;
        CloseAllMenus();
        if (helm is null || Client is null) return;
        CloseYaml();
        CloseHelmValues();
        HelmHistoryTarget = helm.Name;
        HelmHistoryLoading = true;
        StateHasChanged();

        try
        {
            HelmHistory = (await Client.GetHelmReleaseHistoryAsync(CurrentNamespace, helm.Name)).ToList();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { HelmHistoryLoading = false; StateHasChanged(); }
    }

    private void CloseHelmHistory()
    {
        HelmHistoryTarget = null;
        HelmHistory = [];
        HelmRollbackMode = false;
        StateHasChanged();
    }

    private async Task OnCtxViewHelmValues()
    {
        var helm = CtxHelm;
        CloseAllMenus();
        if (helm is null || Client is null) return;
        CloseYaml();
        CloseHelmHistory();
        HelmValuesTarget = helm.Name;
        HelmValuesLoading = true;
        HelmValuesText = null;
        StateHasChanged();

        try
        {
            HelmValuesText = await Client.GetHelmReleaseValuesAsync(CurrentNamespace, helm.Name);
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { HelmValuesLoading = false; StateHasChanged(); }
    }

    private void CloseHelmValues()
    {
        HelmValuesTarget = null;
        HelmValuesText = null;
        StateHasChanged();
    }

    private async Task OnCtxRollbackHelm()
    {
        var helm = CtxHelm;
        CloseAllMenus();
        if (helm is null || Client is null) return;

        // Open history panel in rollback mode so user can pick a revision
        CloseYaml();
        CloseHelmValues();
        HelmHistoryTarget = helm.Name;
        HelmRollbackMode = true;
        HelmHistoryLoading = true;
        StateHasChanged();

        try
        {
            HelmHistory = (await Client.GetHelmReleaseHistoryAsync(CurrentNamespace, helm.Name)).ToList();
            var hasPrevious = HelmHistory.Any(r => r.Status == "superseded");
            if (!hasPrevious)
            {
                ErrorMessage = $"No previous revisions available for \"{helm.Name}\".";
                CloseHelmHistory();
                return;
            }
        }
        catch (Exception ex) { ErrorMessage = ex.Message; CloseHelmHistory(); return; }
        finally { HelmHistoryLoading = false; StateHasChanged(); }
    }

    private async Task OnRollbackToRevision(HelmRevisionInfo rev)
    {
        if (HelmHistoryTarget is null || Client is null) return;
        var releaseName = HelmHistoryTarget;

        var confirmed = await Confirm.ShowAsync(
            $"Rollback \"{releaseName}\" to revision {rev.Revision} ({rev.Chart})?",
            releaseName,
            requireTypedName: IsProduction);
        if (!confirmed) return;

        try
        {
            await Client.RollbackHelmReleaseAsync(CurrentNamespace, releaseName, rev.Revision);
            CloseHelmHistory();
            await LoadAsync();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    private void CloseAllMenus()
    {
        DeploymentMenu.Close();
        PodMenu.Close();
        IngressMenu.Close();
        HelmMenu.Close();
    }

    // ── Side panel helpers ──

    private void CloseLogs() { LogPodName = null; StateHasChanged(); }

    private async Task OpenYaml(string kind, string name)
    {
        LogPodName = null;
        YamlTarget = (kind, name);
        YamlText = null;
        YamlError = null;
        YamlLoading = true;
        StateHasChanged();

        try
        {
            YamlText = await Client!.GetResourceYamlAsync(CurrentNamespace, kind, name);
        }
        catch (Exception ex)
        {
            YamlError = ex.Message;
        }
        finally
        {
            YamlLoading = false;
            StateHasChanged();
        }
    }

    private void CloseYaml() { YamlTarget = null; YamlText = null; YamlError = null; StateHasChanged(); }

    private static string TruncatePodName(string name)
        => name.Length > 36 ? name[..18] + "…" + name[^14..] : name;

    private static string FormatAge(DateTimeOffset start)
    {
        var span = DateTimeOffset.UtcNow - start;
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h";
        return $"{(int)span.TotalMinutes}m";
    }

    // ── Pod metrics helpers ──

    private double? GetPodCpu(string podName)
    {
        var m = PodMetricsList.FirstOrDefault(p => p.PodName == podName || podName.StartsWith(p.PodName));
        if (m is null) return null;
        return m.Containers.Sum(c => c.CpuCores);
    }

    private double? GetPodMemoryMi(string podName)
    {
        var m = PodMetricsList.FirstOrDefault(p => p.PodName == podName || podName.StartsWith(p.PodName));
        if (m is null) return null;
        return m.Containers.Sum(c => c.MemoryBytes) / (1024.0 * 1024.0);
    }

    private static string CpuClass(double cores) =>
        cores > 0.4 ? "metric-high" : cores > 0.15 ? "metric-med" : "metric-low";

    private static string MemoryClass(double mi) =>
        mi > 400 ? "metric-high" : mi > 200 ? "metric-med" : "metric-low";

