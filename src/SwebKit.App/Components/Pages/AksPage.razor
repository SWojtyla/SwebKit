@page "/aks"
@inject AppStateService AppState
@implements IDisposable

<div style="display:flex; height:100%; overflow:hidden;">
    <!-- Workload overview + events -->
    <div style="flex:1; display:flex; flex-direction:column; overflow:hidden;">
        <div class="filter-bar">
            <span style="font-size:12px; color:var(--color-text-muted);">Namespace:</span>
            <strong style="font-size:12px;">@CurrentNamespace</strong>
                <span style="font-size:12px; color:var(--color-text-muted); margin-left:10px;">Context:</span>
                <strong style="font-size:12px;">@(string.IsNullOrWhiteSpace(CurrentContext) ? "(current)" : CurrentContext)</strong>
                <FluentButton @onclick="LoadAsync" Disabled="@IsLoading" style="margin-left:auto;">
                    @(IsLoading ? "Loading..." : "↻ Refresh (F5)")
                </FluentButton>
            </div>

            <div style="display:grid; grid-template-columns: 1.2fr 0.9fr 0.7fr auto auto; gap:8px; padding:8px 0; align-items:end;">
                <FluentTextField Label="Kubeconfig Path" @bind-Value="CurrentKubeconfigPath" Placeholder="C:\Users\you\.kube\config" />
                <FluentTextField Label="Context" @bind-Value="CurrentContext" Placeholder="my-aks-context" />
                <FluentTextField Label="Namespace" @bind-Value="CurrentNamespace" Placeholder="default" />
                <label style="display:flex; align-items:center; gap:6px; font-size:12px; white-space:nowrap; padding-bottom:8px;">
                    <input type="checkbox" @bind="UseAzureCredentialFallback" />
                    Azure fallback
                </label>
                <div style="display:flex; gap:8px; padding-bottom:4px;">
                    <FluentButton Appearance="Appearance.Accent" Disabled="@IsLoading" @onclick="ApplyAndReconnectAsync">Apply</FluentButton>
                    <FluentButton Disabled="@IsLoading" @onclick="SaveAndReconnectAsync">Save</FluentButton>
                </div>
            </div>

            @if (ErrorMessage is not null)
            {
                <ErrorCallout Message="@ErrorMessage" OnRetry="LoadAsync" />
            }

            @if (Client is null && !AppState.UseDemoData && AppState.CurrentEnvironment?.AksConfig is null)
            {
                <div style="padding:40px; text-align:center; color:var(--color-text-muted);">
                    No AKS cluster configured. <a href="/settings" style="color:var(--color-accent);">Open Settings</a>
                </div>
            }
            else if (IsLoading)
            {
                <LoadingSpinner Message="Loading workloads..." />
            }
            else
            {
                <div style="display:flex; flex:1; overflow:hidden;">
                    <!-- Deployments table -->
                    <div class="data-table-container" style="flex:3;">
                        <FluentDataGrid Items="@Deployments.AsQueryable()" TGridItem="DeploymentInfo" Virtualize="true"
                                        ItemSize="36" RowClass="@(d => SelectedDeployment?.Name == d.Name ? "selected-row" : "")"
                                        OnRowClick="@(r => { SelectedDeployment = r.Item; StateHasChanged(); })">
                            <PropertyColumn Property="d => d.Name" Title="Name" />
                            <PropertyColumn Property="d => d.Namespace" Title="Namespace" Width="120px" />
                            <TemplateColumn Title="Ready" Width="80px">
                                <span
                                style="color: @(context.ReadyReplicas == context.Replicas ? "var(--color-success)" : "var(--color-warning)")">@context.ReadyReplicas/@context.Replicas</span>
                            </TemplateColumn>
                            <PropertyColumn Property="d => d.Status" Title="Status" Width="90px" />
                            <TemplateColumn Title="Actions" Width="120px">
                                <span @onclick:stopPropagation="true">
                                    <FluentButton Appearance="Appearance.Stealth" @onclick="() => OpenLogs(context)">Logs
                                    </FluentButton>
                                </span>
                            </TemplateColumn>
                        </FluentDataGrid>
                    </div>

                    <!-- Events panel -->
                    <div style="flex:2; border-left:1px solid var(--color-border); overflow-y:auto;">
                        <div
                            style="padding:6px 12px; font-size:11px; color:var(--color-text-muted); text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid var(--color-border);">
                            Events</div>
                            @foreach (var evt in Events)
                            {
                                <div style="padding:6px 12px; border-bottom:1px solid var(--color-border); font-size:11px;">
                                    <div style="display:flex; gap:8px; align-items:center;">
                                        @if (evt.Type == "Warning")
                                        {
                                            <span style="color:var(--color-warning);">&#9888;</span>
                                        }
                                        <span
                                        style="font-weight:600; color:@(evt.Type == "Warning" ? "var(--color-warning)" : "var(--color-text)");">@evt.Reason</span>
                                        <span
                                        style="color:var(--color-text-muted); margin-left:auto;">@evt.LastTimestamp?.ToString("HH:mm:ss")</span>
                                    </div>
                                    <div style="color:var(--color-text-muted); margin-top:2px;">@evt.InvolvedObjectName — @evt.Message
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Log pane (if open) -->
            @if (LogPodName is not null)
            {
                <div
                    style="width:420px; border-left:1px solid var(--color-border); display:flex; flex-direction:column; overflow:hidden;">
                    <div
                        style="padding:8px 12px; border-bottom:1px solid var(--color-border); display:flex; align-items:center; font-size:12px;">
                        <span style="font-weight:600;">Logs: @LogPodName</span>
                        <FluentButton Appearance="Appearance.Stealth" style="margin-left:auto;" @onclick="() => LogPodName = null">
                            &#x2715;</FluentButton>
                        </div>
                        <PodLogView Client="Client" Namespace="@CurrentNamespace"
                                    PodName="@LogPodName" />
                    </div>
                }
            </div>

@code {
    private IAksClient? Client;
    private List<DeploymentInfo> Deployments = [];
    private List<KubernetesEvent> Events = [];
    private DeploymentInfo? SelectedDeployment;
    private bool IsLoading;
    private string? ErrorMessage;
    private string? LogPodName;
    private string CurrentKubeconfigPath = string.Empty;
    private string CurrentContext = string.Empty;
    private string CurrentNamespace = "default";
    private bool UseAzureCredentialFallback = true;

    protected override async Task OnParametersSetAsync()
    {
        SyncInputsFromEnvironment();
        await ConnectAndLoadAsync();
    }

    private void SyncInputsFromEnvironment()
    {
        var config = AppState.CurrentEnvironment?.AksConfig;
        CurrentKubeconfigPath = config?.KubeconfigPath ?? string.Empty;
        CurrentContext = config?.KubeconfigContext ?? string.Empty;
        CurrentNamespace = string.IsNullOrWhiteSpace(config?.DefaultNamespace) ? "default" : config!.DefaultNamespace;
        UseAzureCredentialFallback = config?.UseAzureCredentialFallback ?? true;
    }

    private async Task ConnectAndLoadAsync()
    {
        if (AppState.UseDemoData)
        {
            Client = new SwebKit.Core.Services.DemoAksClient();
            await LoadAsync();
            return;
        }

        var hasKubeconfigData = !string.IsNullOrWhiteSpace(CurrentKubeconfigPath)
            || !string.IsNullOrWhiteSpace(CurrentContext);
        var config = AppState.CurrentEnvironment?.AksConfig;
        if (config is null && !hasKubeconfigData) return;

        try
        {
            Client = new SwebKit.Kubernetes.AksClient.KubernetesAksClient(
                string.IsNullOrWhiteSpace(CurrentContext) ? null : CurrentContext.Trim(),
                string.IsNullOrWhiteSpace(CurrentKubeconfigPath) ? null : CurrentKubeconfigPath.Trim(),
                UseAzureCredentialFallback);
            await LoadAsync();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    private async Task ApplyAndReconnectAsync()
    {
        ErrorMessage = null;
        await ConnectAndLoadAsync();
    }

    private async Task SaveAndReconnectAsync()
    {
        var env = AppState.CurrentEnvironment;
        if (env is null || AppState.CurrentProject is null)
            return;

        var config = env.AksConfig ??= new SwebKit.Core.Domain.AksConfig();
        config.KubeconfigPath = string.IsNullOrWhiteSpace(CurrentKubeconfigPath) ? null : CurrentKubeconfigPath.Trim();
        config.KubeconfigContext = string.IsNullOrWhiteSpace(CurrentContext) ? null : CurrentContext.Trim();
        config.DefaultNamespace = string.IsNullOrWhiteSpace(CurrentNamespace) ? "default" : CurrentNamespace.Trim();
        config.UseAzureCredentialFallback = UseAzureCredentialFallback;

        await AppState.UpdateProjectAsync(AppState.CurrentProject);
        await ConnectAndLoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Client is null) return;
        IsLoading = true; ErrorMessage = null; StateHasChanged();
        try
        {
            var ns = string.IsNullOrWhiteSpace(CurrentNamespace) ? "default" : CurrentNamespace.Trim();
            Deployments = (await Client.GetDeploymentsAsync(ns)).ToList();
            Events = (await Client.GetEventsAsync(ns)).Take(50).ToList();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; StateHasChanged(); }
    }

    private async Task OpenLogs(DeploymentInfo deployment)
    {
        var ns = string.IsNullOrWhiteSpace(CurrentNamespace) ? "default" : CurrentNamespace.Trim();
        var pods = await Client!.GetPodsAsync(ns);
        var pod = pods.FirstOrDefault(p => p.Name.StartsWith(deployment.Name));
        if (pod is not null) { LogPodName = pod.Name; StateHasChanged(); }
    }

    public void Dispose() { }
}