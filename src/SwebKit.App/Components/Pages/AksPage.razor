@page "/aks"
@inject AppStateService AppState
@inject IJSRuntime JS
@implements IDisposable

<div class="aks-page" @oncontextmenu:preventDefault>
    @* ── Toolbar ── *@
    <div class="aks-toolbar">
        <span class="connection-dot @(Client is not null ? "dot-ok" : "dot-unknown")"></span>

        @* ── Context dropdown ── *@
        <label class="aks-ns-label">Context</label>
        <select class="aks-ns-select" value="@ActiveContext" @onchange="OnContextChanged">
            @if (Contexts.Count == 0)
            {
                <option value="">@(string.IsNullOrWhiteSpace(ActiveContext) ? "default" : ActiveContext)</option>
            }
            @foreach (var ctx in Contexts)
            {
                <option value="@ctx.Name" selected="@(ctx.Name == ActiveContext)">
                    @ctx.Name @(ctx.IsCurrent ? "(current)" : "")
                </option>
            }
        </select>

        <span class="aks-toolbar-divider"></span>

        @* ── Namespace searchable picker ── *@
        @if (NsDropOpen)
        {
            <div class="aks-ns-backdrop" @onclick="CloseNsDrop"></div>
        }
        <label class="aks-ns-label">Namespace</label>
        <div class="aks-ns-picker">
            <input class="aks-ns-select aks-ns-search" value="@(NsDropOpen? NsSearchText : CurrentNamespace)"
                   placeholder="@(NsDropOpen ? "Filter…" : CurrentNamespace)" @onfocus="OpenNsDrop"
                   @oninput="OnNsSearchInput" readonly="@(!NsDropOpen)" />
            @if (NsDropOpen)
            {
                <div class="aks-ns-dropdown">
                    @foreach (var ns in NsFiltered)
                    {
                        var nsLocal = ns;
                        <div class="aks-ns-option @(nsLocal == CurrentNamespace ? "current" : "")"
                             @onclick="() => SelectNs(nsLocal)">
                            @nsLocal
                        </div>
                    }
                </div>
            }
        </div>

        <span class="aks-toolbar-divider"></span>

        @* ── Resource type selector ── *@
        @foreach (var rt in ResourceTypes)
        {
            <button class="aks-resource-tab @(rt == ActiveResourceType ? "active" : "")"
                    @onclick="() => SwitchResourceType(rt)">
                @rt
            </button>
        }

        <span class="aks-toolbar-spacer"></span>

        <AutoRefreshToggle OnRefresh="LoadAsync" Paused="@HasOpenPanel" />

        <FluentButton Appearance="Appearance.Stealth" Disabled="@IsLoading" @onclick="LoadAsync" Title="Refresh (F5)">
            @(IsLoading ? "Loading…" : "↻ Refresh")
        </FluentButton>
    </div>

    @* ── Error ── *@
    @if (ErrorMessage is not null)
    {
        <ErrorCallout Message="@ErrorMessage" OnRetry="LoadAsync" />
    }

    @* ── Confirm bar ── *@
    <AksConfirmBar @ref="Confirm" />

    @* ── Empty / Loading / Content ── *@
    @if (Client is null && !AppState.UseDemoData && AppState.CurrentEnvironment?.AksConfig is null)
    {
        <div class="aks-empty-state">
            <div class="aks-empty-icon">☸</div>
            <div class="aks-empty-title">No cluster configured</div>
            <div class="aks-empty-subtitle">
                Go to <a href="/settings">Settings</a> to configure your AKS connection.
            </div>
        </div>
    }
    else if (IsLoading && !HasAnyData)
    {
        <LoadingSpinner Message="Connecting to cluster…" />
    }
    else
    {
        <div class="aks-content @(HasOpenPanel ? "side-open" : "") @(ShowEvents ? "" : "events-collapsed")">
            @* ── Main resource panel ── *@
            <div class="aks-resource-panel">
                <div class="aks-section-header">
                    <span class="aks-section-title">@ActiveResourceType</span>
                    <span class="aks-section-count">@ActiveResourceCount</span>
                </div>
                <ResourceFilter Placeholder="@($"Filter {ActiveResourceType.ToLowerInvariant()}…")" Value="@ActiveFilter"
                                ValueChanged="OnFilterChanged" />
                <div class="aks-table-wrap" @oncontextmenu="OnTableContextMenu" @oncontextmenu:preventDefault>
                    @switch (ActiveResourceType)
                    {
                        case "Deployments":
                            <FluentDataGrid Items="@FilteredDeployments" TGridItem="DeploymentInfo" Virtualize="true" ItemSize="36"
                                            RowClass="@(d => SelectedDeployment?.Name == d.Name ? "selected-row" : "")"
                                            OnRowClick="@(r => { if (r.Item is not null) { SelectedDeployment = r.Item; StateHasChanged(); } })">
                                <TemplateColumn Title="Name">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowDeploymentMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-resource-name">@context.Name</span>
                                    </div>
                                </TemplateColumn>
                                @if (IsMultiNamespace)
                                {
                                    <TemplateColumn Title="Namespace" Width="130px">
                                        <span class="aks-ns-cell"
                                              @onclick="() => { CurrentNamespace = context.Namespace; _ = LoadAsync(); }">@context.Namespace</span>
                                    </TemplateColumn>
                                }
                                <TemplateColumn Title="Ready" Width="90px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowDeploymentMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span
                                            class="aks-ready-badge @(context.ReadyReplicas == context.Replicas ? "healthy" : "degraded")">
                                            @context.ReadyReplicas / @context.Replicas
                                        </span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Status" Width="100px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowDeploymentMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span
                                            class="aks-status @(context.Status is "Running" or "Available" ? "running" : "other")">
                                            @context.Status
                                        </span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="HPA" Width="110px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowDeploymentMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        @{
                                            var depHpa = Hpas.FirstOrDefault(h => h.TargetName == context.Name && h.TargetKind ==
                                            "Deployment");
                                        }
                                        @if (depHpa is not null)
                                        {
                                            <button class="aks-hpa-badge" @onclick="() => OpenHpaDetail(depHpa)">
HPA
@depHpa.CurrentReplicas/@depHpa.MaxReplicas@(depHpa.CurrentCpuUtilizationPercent.HasValue
                                ? $" @ {depHpa.CurrentCpuUtilizationPercent:F0}%" : "")
                                            </button>
                                        }
                                    </div>
                                </TemplateColumn>
                            </FluentDataGrid>
                            break;

                        case "StatefulSets":
                            <FluentDataGrid Items="@FilteredStatefulSets" TGridItem="StatefulSetInfo" Virtualize="true"
                                            ItemSize="36">
                                <TemplateColumn Title="Name">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowStatefulSetMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-resource-name">@context.Name</span>
                                    </div>
                                </TemplateColumn>
                                @if (IsMultiNamespace)
                                {
                                    <TemplateColumn Title="Namespace" Width="130px">
                                        <span class="aks-ns-cell"
                                              @onclick="() => { CurrentNamespace = context.Namespace; _ = LoadAsync(); }">@context.Namespace</span>
                                    </TemplateColumn>
                                }
                                <TemplateColumn Title="Ready" Width="90px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowStatefulSetMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span
                                            class="aks-ready-badge @(context.ReadyReplicas == context.Replicas ? "healthy" : "degraded")">
                                            @context.ReadyReplicas / @context.Replicas
                                        </span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Revision" Width="130px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowStatefulSetMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-text-muted">@context.CurrentRevision</span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="HPA" Width="110px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowStatefulSetMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        @{
                                            var ssHpa = Hpas.FirstOrDefault(h => h.TargetName == context.Name && h.TargetKind ==
                                            "StatefulSet");
                                        }
                                        @if (ssHpa is not null)
                                        {
                                            <button class="aks-hpa-badge" @onclick="() => OpenHpaDetail(ssHpa)">
                                                HPA
                                                @ssHpa.CurrentReplicas/@ssHpa.MaxReplicas@(ssHpa.CurrentCpuUtilizationPercent.HasValue ?
                                                $" @ {ssHpa.CurrentCpuUtilizationPercent:F0}%" : "")
                                            </button>
                                        }
                                    </div>
                                </TemplateColumn>
                            </FluentDataGrid>
                            break;

                        case "ConfigMaps":
                            <FluentDataGrid Items="@FilteredConfigMaps" TGridItem="ConfigMapInfo" Virtualize="true" ItemSize="36">
                                <TemplateColumn Title="Name">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowConfigMapMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-resource-name">@context.Name</span>
                                    </div>
                                </TemplateColumn>
                                @if (IsMultiNamespace)
                                {
                                    <TemplateColumn Title="Namespace" Width="130px">
                                        <span class="aks-ns-cell">@context.Namespace</span>
                                    </TemplateColumn>
                                }
                                <TemplateColumn Title="Keys" Width="70px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowConfigMapMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-section-count">@context.Data.Count</span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Labels" Width="70px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowConfigMapMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-section-count">@context.Labels.Count</span>
                                    </div>
                                </TemplateColumn>
                            </FluentDataGrid>
                            break;

                        case "Secrets":
                            <FluentDataGrid Items="@FilteredSecrets" TGridItem="SecretInfo" Virtualize="true" ItemSize="36">
                                <TemplateColumn Title="Name">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowSecretMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-resource-name">@context.Name</span>
                                    </div>
                                </TemplateColumn>
                                @if (IsMultiNamespace)
                                {
                                    <TemplateColumn Title="Namespace" Width="130px">
                                        <span class="aks-ns-cell">@context.Namespace</span>
                                    </TemplateColumn>
                                }
                                <TemplateColumn Title="Type" Width="160px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowSecretMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-text-muted">@context.Type</span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Keys" Width="70px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowSecretMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-section-count">@context.Keys.Count</span>
                                    </div>
                                </TemplateColumn>
                            </FluentDataGrid>
                            break;

                        case "Pods":
                            <FluentDataGrid Items="@FilteredPods" TGridItem="PodInfo" Virtualize="true" ItemSize="36">
                                <TemplateColumn Title="Name">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-resource-name">@context.Name</span>
                                    </div>
                                </TemplateColumn>
                                @if (IsMultiNamespace)
                                {
                                    <TemplateColumn Title="Namespace" Width="130px">
                                        <span class="aks-ns-cell"
                                              @onclick="() => { CurrentNamespace = context.Namespace; _ = LoadAsync(); }">@context.Namespace</span>
                                    </TemplateColumn>
                                }
                                <TemplateColumn Title="Phase" Width="110px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span
                                            class="aks-status @(context.Phase == "Running" ? "running" : context.Phase == "CrashLoopBackOff" ? "error" : "other")">
                                            @context.Phase
                                        </span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Ready" Width="70px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-ready-badge @(context.Ready ? "healthy" : "degraded")">
                                            @(context.Ready ? "Yes" : "No")
                                        </span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Node" Width="180px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        @context.NodeName
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Age" Width="80px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        @if (context.StartTime.HasValue)
                                        {
                                            @FormatAge(context.StartTime.Value)
                                        }
                                    </div>
                                </TemplateColumn>
                                @if (PodMetricsList.Count > 0)
                                {
                                    <TemplateColumn Title="CPU" Width="80px">
                                        <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)"
                                             @oncontextmenu:preventDefault>
                                            @{
                                                var cpuMetric = GetPodCpu(context.Name);
                                            }
                                            @if (cpuMetric is not null)
                                            {
                                                <span class="aks-metric @CpuClass(cpuMetric.Value)"
                                                      title="@($"{cpuMetric.Value:F3} cores")">
                                                    @($"{cpuMetric.Value * 1000:F0}m")
                                                </span>
                                            }
                                        </div>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Memory" Width="90px">
                                        <div class="aks-row-ctx" @oncontextmenu="e => ShowPodMenu(e, context)"
                                             @oncontextmenu:preventDefault>
                                            @{
                                                var memMetric = GetPodMemoryMi(context.Name);
                                            }
                                            @if (memMetric is not null)
                                            {
                                                <span class="aks-metric @MemoryClass(memMetric.Value)"
                                                      title="@($"{memMetric.Value:F1} Mi")">
                                                    @($"{memMetric.Value:F0}Mi")
                                                </span>
                                            }
                                        </div>
                                    </TemplateColumn>
                                }
                            </FluentDataGrid>
                            break;

                        case "Ingresses":
                            <FluentDataGrid Items="@FilteredIngresses" TGridItem="IngressInfo" Virtualize="true" ItemSize="36">
                                <TemplateColumn Title="Name">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowIngressMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-resource-name">@context.Name</span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Class" Width="100px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowIngressMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        @context.IngressClass
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Hosts">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowIngressMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-ingress-hosts">
                                            @string.Join(", ", context.Rules.Where(r => r.Host is not null).Select(r => r.Host!))
                                        </span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Address" Width="140px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowIngressMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        @string.Join(", ", context.Addresses)
                                    </div>
                                </TemplateColumn>
                            </FluentDataGrid>
                            break;

                        case "Helm":
                            <FluentDataGrid Items="@FilteredHelmReleases" TGridItem="HelmReleaseInfo" Virtualize="true"
                                            ItemSize="36">
                                <TemplateColumn Title="Release">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowHelmMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-resource-name">@context.Name</span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Chart">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowHelmMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        @context.Chart
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="App Version" Width="100px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowHelmMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        @context.AppVersion
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Rev" Width="60px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowHelmMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span class="aks-section-count">@context.Revision</span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Status" Width="100px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowHelmMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        <span
                                            class="aks-status @(context.Status == "deployed" ? "running" : context.Status == "failed" ? "error" : "other")">
                                            @context.Status
                                        </span>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Updated" Width="100px">
                                    <div class="aks-row-ctx" @oncontextmenu="e => ShowHelmMenu(e, context)"
                                         @oncontextmenu:preventDefault>
                                        @if (context.Updated.HasValue)
                                        {
                                            @FormatAge(context.Updated.Value)
                                            <span class="aks-age-suffix"> ago</span>
                                        }
                                    </div>
                                </TemplateColumn>
                            </FluentDataGrid>
                            break;
                    }
                </div>
            </div>

            @* ── Events panel (collapsible) ── *@
            @if (ShowEvents)
            {
                <div class="aks-events-panel">
                    <div class="aks-section-header">
                        <span class="aks-section-title">Events</span>
                        <span class="aks-section-count">@Events.Count</span>
                        <button class="aks-collapse-btn" @onclick="() => ShowEvents = false" title="Collapse events">
                            ✕
                        </button>
                    </div>
                    <div class="aks-events-list">
                        @if (Events.Count == 0)
                        {
                            <div class="aks-events-empty">No recent events</div>
                        }
                        else
                        {
                            @foreach (var evt in Events)
                            {
                                <div class="aks-event-item @(evt.Type == "Warning" ? "warning" : "")">
                                    <div class="aks-event-header">
                                        @if (evt.Type == "Warning")
                                        {
                                            <span class="aks-event-icon warning">&#9888;</span>
                                        }
                                        else
                                        {
                                            <span class="aks-event-icon normal">&#9679;</span>
                                        }
                                        <span class="aks-event-reason">@evt.Reason</span>
                                        @if (evt.Count > 1)
                                        {
                                            <span class="aks-event-count">×@evt.Count</span>
                                        }
                                        <span class="aks-event-time">@evt.LastTimestamp?.ToString("HH:mm:ss")</span>
                                    </div>
                                    <div class="aks-event-detail">
                                        <span class="aks-event-object">@evt.InvolvedObjectName</span>
                                        @evt.Message
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
            else
            {
                <button class="aks-events-collapsed-tab" @onclick="() => ShowEvents = true" title="Show events">
                    Events (@Events.Count(e => e.Type == "Warning") &#9888;)
                </button>
            }

            @* ── YAML viewer / editor slide-out ── *@
            @if (YamlTarget is not null)
            {
                <ResizablePanel DefaultWidth="420" MinWidth="280" MaxWidth="800">
                    <div class="aks-section-header">
                        <span class="aks-section-title" title="@YamlTarget.Value.Kind/@YamlTarget.Value.Name">
                            @(YamlEditMode ? "Edit" : "") @YamlTarget.Value.Kind: @YamlTarget.Value.Name
                        </span>
                        @if (!YamlLoading && YamlError is null && YamlIsEditable && !YamlEditMode)
                        {
                            <FluentButton Appearance="Appearance.Stealth" @onclick="OnEditYamlToggle" Title="Edit YAML">✎
                            </FluentButton>
                        }
                        @if (YamlEditMode)
                        {
                            <FluentButton Appearance="Appearance.Accent" Disabled="@YamlApplying" @onclick="OnSaveYaml"
                                          Title="Apply YAML">
                                @(YamlApplying ? "Saving…" : "Save")
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Stealth" Disabled="@YamlApplying" @onclick="OnCancelYamlEdit"
                                          Title="Cancel edit">Cancel</FluentButton>
                        }
                        <FluentButton Appearance="Appearance.Stealth" @onclick="CloseYaml" Title="Close YAML">✕</FluentButton>
                    </div>
                    <div class="aks-yaml-content">
                        @if (YamlLoading)
                        {
                            <LoadingSpinner Message="Loading YAML…" />
                        }
                        else if (YamlError is not null)
                        {
                            <div class="aks-yaml-error">@YamlError</div>
                        }
                        else if (YamlEditMode)
                        {
                            <div class="aks-yaml-edit-wrap" @key="_editKey">
                                <pre class="aks-yaml-pre aks-yaml-edit-bg" @ref="_editPre">@_yamlEditHighlighted</pre>
                                <textarea class="aks-yaml-edit" spellcheck="false" @ref="_editTextarea"
                                          @oninput="OnYamlEditInput">@YamlEditText</textarea>
                            </div>
                        }
                        else
                        {
                            <pre class="aks-yaml-pre">@_yamlHighlighted</pre>
                        }
                    </div>
                </ResizablePanel>
            }

            @* ── Helm History slide-out ── *@
            @if (HelmHistoryTarget is not null && YamlTarget is null)
            {
                <ResizablePanel DefaultWidth="480" MinWidth="300" MaxWidth="700">
                    <div class="aks-section-header">
                        <span class="aks-section-title">@(HelmRollbackMode ? "Rollback" : "History"): @HelmHistoryTarget</span>
                        <FluentButton Appearance="Appearance.Stealth" @onclick="CloseHelmHistory" Title="Close">✕</FluentButton>
                    </div>
                    @if (HelmRollbackMode)
                    {
                        <div class="aks-rollback-hint">Select a revision to rollback to:</div>
                    }
                    <div class="aks-yaml-content">
                        @if (HelmHistoryLoading)
                        {
                            <LoadingSpinner Message="Loading history…" />
                        }
                        else
                        {
                            <table class="aks-history-table">
                                <thead>
                                    <tr>
                                        <th>Rev</th>
                                        <th>Status</th>
                                        <th>Chart</th>
                                        <th>App Version</th>
                                        <th>Updated</th>
                                        <th>Description</th>
                                        @if (HelmRollbackMode)
                                        {
                                            <th></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rev in HelmHistory.OrderBy(r => r.Revision))
                                    {
                                        <tr class="@(rev.Status == "deployed" ? "aks-rev-current" : "")">
                                            <td>@rev.Revision</td>
                                            <td><span
                                                class="aks-status @(rev.Status == "deployed" ? "running" : rev.Status == "failed" ? "error" : "other")">@rev.Status</span>
                                            </td>
                                            <td>@rev.Chart</td>
                                            <td>@rev.AppVersion</td>
                                            <td>@rev.Updated?.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@rev.Description</td>
                                            @if (HelmRollbackMode)
                                            {
                                                <td>
                                                    @if (rev.Status == "superseded")
                                                    {
                                                        var r = rev;
                                                        <button class="ctx-item destructive aks-rollback-btn"
                                                                @onclick="() => OnRollbackToRevision(r)">
                                                            &#8634; Rollback
                                                        </button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </ResizablePanel>
            }

            @* ── Helm Values slide-out ── *@
            @if (HelmValuesTarget is not null && YamlTarget is null && HelmHistoryTarget is null)
            {
                <ResizablePanel DefaultWidth="380" MinWidth="250" MaxWidth="700">
                    <div class="aks-section-header">
                        <span class="aks-section-title">Values: @HelmValuesTarget</span>
                        <FluentButton Appearance="Appearance.Stealth" @onclick="CloseHelmValues" Title="Close">✕</FluentButton>
                    </div>
                    <div class="aks-yaml-content">
                        @if (HelmValuesLoading)
                        {
                            <LoadingSpinner Message="Loading values…" />
                        }
                        else
                        {
                            <pre class="aks-yaml-pre">@_helmValuesHighlighted</pre>
                        }
                    </div>
                </ResizablePanel>
            }

            @* ── Scale deployment panel ── *@
            @if (ScaleTarget is not null && YamlTarget is null && LogPodName is null)
            {
                <ResizablePanel DefaultWidth="260" MinWidth="200" MaxWidth="400">
                    <div class="aks-section-header">
                        <span class="aks-section-title" title="@ScaleTarget">Scale: @ScaleTarget</span>
                        <FluentButton Appearance="Appearance.Stealth" @onclick="OnScaleCancel" Title="Cancel">✕</FluentButton>
                    </div>
                    <div class="aks-scale-panel">
                        <div class="aks-scale-label">Desired replicas</div>
                        <div class="aks-scale-stepper">
                            <button class="aks-scale-step-btn"
                                    @onclick="() => ScaleReplicas = Math.Max(0, ScaleReplicas - 1)">−</button>
                            <input type="number" class="aks-scale-input" min="0" max="100" @bind="ScaleReplicas"
                                   @bind:event="oninput" />
                            <button class="aks-scale-step-btn"
                                    @onclick="() => ScaleReplicas = Math.Min(100, ScaleReplicas + 1)">+</button>
                        </div>
                        <div class="aks-scale-current">Currently: @(_scaleIsStatefulSet ? (StatefulSets.FirstOrDefault(s =>
                                                s.Name == ScaleTarget)?.Replicas ?? 0) : (Deployments.FirstOrDefault(d => d.Name ==
                                                ScaleTarget)?.Replicas ?? 0)) replicas</div>
                            <div class="aks-scale-actions">
                                <button class="confirm-btn confirm-yes" @onclick="OnScaleConfirm">Apply</button>
                                <button class="confirm-btn confirm-no" @onclick="OnScaleCancel">Cancel</button>
                            </div>
