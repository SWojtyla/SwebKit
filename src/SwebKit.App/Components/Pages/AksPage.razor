    private async Task OnCtxRollbackHelm()
    {
        var helm = CtxHelm;
        CloseAllMenus();
        if (helm is null || Client is null) return;

        // Open history panel in rollback mode so user can pick a revision
        CloseYaml();
        CloseHelmValues();
        HelmHistoryTarget = helm.Name;
        HelmRollbackMode = true;
        HelmHistoryLoading = true;
        StateHasChanged();

        try
        {
            HelmHistory = (await Client.GetHelmReleaseHistoryAsync(CurrentNamespace, helm.Name)).ToList();
            var hasPrevious = HelmHistory.Any(r => r.Status == "superseded");
            if (!hasPrevious)
            {
                ErrorMessage = $"No previous revisions available for \"{helm.Name}\".";
                CloseHelmHistory();
                return;
            }
        }
        catch (Exception ex) { ErrorMessage = ex.Message; CloseHelmHistory(); return; }
        finally { HelmHistoryLoading = false; StateHasChanged(); }
    }

