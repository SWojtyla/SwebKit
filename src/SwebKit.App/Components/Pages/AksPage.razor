@page "/aks"
@inject AppStateService AppState
@inject IJSRuntime JS
@inject INotificationService Notifications
@inject IPortForwardSessionService SessionService
@inject IAppEventBus EventBus
@inject IConnectionStateService ConnectionState
@implements IDisposable
@inject CommandRegistry Commands
@inject ISelectionContext Selection
@inject PageDataCache Cache
@inject ILogger<AksPage> Logger
@inject IAksClientBootstrapper AksBootstrapper
@inject IAksWarmupCache AksWarmupCache
@inject OperatorWorkspaceService Workspaces
@inject PinnedPortForwardService PinnedPortForwards

<div class="aks-page" @oncontextmenu:preventDefault>
    <div class="page-shell-header">
        <RoutePageHeader Area="aks"
                         Subtitle="Inspect workloads, events, metrics, and operational shortcuts for the active cluster context.">
        </RoutePageHeader>
    </div>

    @* ── Toolbar ── *@
    <AksConnectionBar Contexts="Contexts" ActiveContext="@ActiveContext" Namespaces="Namespaces"
                      CurrentNamespace="@CurrentNamespace" IsLoading="@IsLoading" IsConnected="@(Client is not null)"
                      DefaultContext="@(AppState.Config.AksConfig?.KubeconfigContext)" ActiveResourceType="@ActiveResourceType"
                      ShowEvents="@ShowEvents" ShowPortForwardSessions="@ShowPortForwardSessions"
                      EventWarningCount="@_eventWarningCount"
                      ActivePortForwardCount="@(SessionService.Sessions.Count(s => s.Status is PortForwardStatus.Starting or PortForwardStatus.Active))"
                      AutoRefreshPaused="@HasAnyPanel" OnContextChanged="HandleContextChangedAsync"
                      OnNamespaceChanged="HandleNamespaceChangedAsync" OnResourceTypeChanged="SwitchResourceType"
                      OnRefresh="LoadAsync" OnToggleEvents="HandleToggleEvents"
                      OnTogglePortForwardSessions="HandleTogglePortForwardSessions" />

    @* ── Error ── *@
    @if (ErrorMessage is not null)
    {
        <ErrorCallout Message="@ErrorMessage" OnRetry="LoadAsync" />
    }

    @* ── Limited permissions (partial RBAC denial — other data still loaded) ── *@
    @if (PermissionWarning is not null)
    {
        <ErrorCallout Title="Limited permissions" Message="@PermissionWarning"
                      OnDismiss="@(() => PermissionWarning = null)" />
    }

    @* ── Confirm bar ── *@
    <AksConfirmBar @ref="Confirm" />

    @* ── Empty / Loading / Content ── *@
    @if (Client is null && !AppState.UseDemoData && AppState.Config.AksConfig is null)
    {
        <EmptyState Icon="☁" Title="No cluster configured"
                    Subtitle="Connect a kubeconfig context and default namespace in Settings before opening the AKS workspace.">
            <Actions>
                <a href="/settings?section=aks">Open AKS settings</a>
            </Actions>
        </EmptyState>
    }
    else if (IsLoading && !HasAnyData)
    {
        <LoadingSpinner Message="Connecting to cluster…" />
    }
    else
    {
        <div class="aks-content @(HasAnyPanel ? "side-open" : "")">
            @* ── Main resource panel ── *@
            <div class="aks-resource-panel">
                <div class="aks-section-header">
                    <span class="aks-section-title">@ActiveResourceType</span>
                    <span class="aks-section-count">@ActiveResourceCount</span>
                    @if (_allPodsGreenBanner)
                    {
                        <span class="aks-pods-green-banner">All pods healthy</span>
                    }
                </div>
                <ResourceFilter Placeholder="@($"Filter {ActiveResourceType.ToLowerInvariant()}…")" Value="@ActiveFilter"
                                ValueChanged="OnFilterChanged">
                    @if (ActiveResourceType == "Pods")
                    {
                        <label class="resource-filter-check" title="Show terminal pods such as Completed and Succeeded">
                            <input type="checkbox" checked="@ShowCompletedPods" @onchange="OnShowCompletedPodsChanged" />
                            <span>Show completed</span>
                        </label>
                        @if (!ShowCompletedPods && HiddenCompletedPodCount > 0)
                        {
                            <span class="resource-filter-muted">@HiddenCompletedPodCount hidden</span>
                        }
                    }
                </ResourceFilter>
                <div class="aks-table-wrap" @oncontextmenu="OnTableContextMenu" @oncontextmenu:preventDefault tabindex="0"
                     @onkeydown="HandleGridKeyDown" @onkeydown:preventDefault="@_preventGridKey">
                    @* PERF: BL-4 — keep every resource grid mounted and toggle visibility with `hidden`
                       instead of an @switch. Recreating FluentDataGrid (Virtualize=true) on every tab click
                       tears down and rebuilds its JS-side virtualization observers, which caused the app to
                       become unresponsive when switching tabs quickly. All datasets are already loaded by
                       LoadAsync, so keeping the grids mounted costs no extra network/data work. *@
                    <div hidden="@(ActiveResourceType != "Deployments")">
                        <DeploymentGrid FilteredItems="@FilteredDeployments" Hpas="@Hpas"
                                        IsMultiNamespace="@IsMultiNamespace" SelectedDeployment="@SelectedDeployment"
                                        OnContextMenu="@((args) => ShowDeploymentMenu(args.Item1, args.Item2))"
                                        OnSelectRow="@SelectDeployment" OnOpenHpa="@OpenHpaDetail"
                                        OnOpenNetworkAnalysis="@OpenDeploymentNetworkAnalysis"
                                        OnNamespaceClick="@HandleNamespaceJumpAsync" />
                    </div>

                    <div hidden="@(ActiveResourceType != "StatefulSets")">
                        <StatefulSetGrid FilteredItems="@FilteredStatefulSets" Hpas="@Hpas"
                                         IsMultiNamespace="@IsMultiNamespace" SelectedStatefulSet="@SelectedStatefulSet"
                                         OnSelectRow="@SelectStatefulSet"
                                         OnContextMenu="@((args) => ShowStatefulSetMenu(args.Item1, args.Item2))"
                                         OnOpenHpa="@OpenHpaDetail" OnOpenNetworkAnalysis="@OpenStatefulSetNetworkAnalysis"
                                         OnNamespaceClick="@HandleNamespaceJumpAsync" />
                    </div>

                    <div hidden="@(ActiveResourceType != "ConfigMaps")">
                        @if (IsMultiNamespace && ConfigMaps.Count == 0 && !IsLoading)
                        {
                            <div class="aks-mns-notice">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Info())" Width="14px"
                                            style="vertical-align:middle;" />
                                ConfigMaps are not loaded in multi-namespace mode. Select a specific namespace to view them.
                            </div>
                        }
                        else
                        {
                            <ConfigMapGrid FilteredItems="@FilteredConfigMaps" IsMultiNamespace="@IsMultiNamespace"
                                           SelectedConfigMap="@SelectedConfigMap" OnSelectRow="@SelectConfigMap"
                                           OnContextMenu="@((args) => ShowConfigMapMenu(args.Item1, args.Item2))" />
                        }
                    </div>

                    <div hidden="@(ActiveResourceType != "Secrets")">
                        @if (IsMultiNamespace && Secrets.Count == 0 && !IsLoading)
                        {
                            <div class="aks-mns-notice">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Info())" Width="14px"
                                            style="vertical-align:middle;" />
                                Secrets are not loaded in multi-namespace mode. Select a specific namespace to view them.
                            </div>
                        }
                        else
                        {
                            <SecretGrid FilteredItems="@FilteredSecrets" IsMultiNamespace="@IsMultiNamespace"
                                        SelectedSecret="@SelectedSecret" OnSelectRow="@SelectSecret"
                                        OnContextMenu="@((args) => ShowSecretMenu(args.Item1, args.Item2))" />
                        }
                    </div>

                    <div hidden="@(ActiveResourceType != "Pods")">
                        <PodGrid FilteredItems="@FilteredPods" PodMetricsList="@PodMetricsList"
                                 IsMultiNamespace="@IsMultiNamespace" SelectedPod="@SelectedPod"
                                 CpuCeiling="@(AppState.Config.AksConfig?.CpuBarCeilingMillicores ?? 500)"
                                 MemoryCeiling="@(AppState.Config.AksConfig?.MemoryBarCeilingMi ?? 512)" OnSelectRow="@SelectPod"
                                 OnContextMenu="@((args) => ShowPodMenu(args.Item1, args.Item2))"
                                 OnOpenNetworkAnalysis="@OpenPodNetworkAnalysis" OnNamespaceClick="@HandleNamespaceJumpAsync" />
                    </div>

                    <div hidden="@(ActiveResourceType != "Services")">
                        <ServiceGrid FilteredItems="@FilteredServices" IsMultiNamespace="@IsMultiNamespace"
                                     SelectedService="@SelectedService" OnSelectRow="@SelectService"
                                     OnContextMenu="@((args) => ShowServiceMenu(args.Item1, args.Item2))"
                                     OnNamespaceClick="@HandleNamespaceJumpAsync" />
                    </div>

                    <div hidden="@(ActiveResourceType != "Ingresses")">
                        <IngressGrid FilteredItems="@FilteredIngresses" SelectedIngress="@SelectedIngress"
                                     OnSelectRow="@SelectIngress"
                                     OnContextMenu="@((args) => ShowIngressMenu(args.Item1, args.Item2))"
                                     OnOpenAnalysis="@OpenIngressAnalysis" OnOpenUrl="@((url) => _ = OpenUrlAsync(url))" />
                    </div>

                    <div hidden="@(ActiveResourceType != "GatewayClasses")">
                        <GatewayClassGrid FilteredItems="@FilteredGatewayClasses"
                                          SelectedGatewayClass="@SelectedGatewayClass" OnSelectRow="@SelectGatewayClass"
                                          OnContextMenu="@((args) => ShowGatewayClassMenu(args.Item1, args.Item2))" />
                    </div>

                    <div hidden="@(ActiveResourceType != "Gateways")">
                        <GatewayGrid FilteredItems="@FilteredGateways" IsMultiNamespace="@IsMultiNamespace"
                                     SelectedGateway="@SelectedGateway" OnSelectRow="@SelectGateway"
                                     OnContextMenu="@((args) => ShowGatewayMenu(args.Item1, args.Item2))"
                                     OnNamespaceClick="@HandleNamespaceJumpAsync" />
                    </div>

                    <div hidden="@(ActiveResourceType != "HTTPRoutes")">
                        <HttpRouteGrid FilteredItems="@FilteredHttpRoutes" IsMultiNamespace="@IsMultiNamespace"
                                       SelectedHttpRoute="@SelectedHttpRoute" OnSelectRow="@SelectHttpRoute"
                                       OnContextMenu="@((args) => ShowHttpRouteMenu(args.Item1, args.Item2))"
                                       OnNamespaceClick="@HandleNamespaceJumpAsync" OnOpenUrl="@((url) => _ = OpenUrlAsync(url))" />
                    </div>

                    <div hidden="@(ActiveResourceType != "Helm")">
                        <HelmGrid FilteredItems="@FilteredHelmReleases" SelectedHelm="@SelectedHelmRelease"
                                  OnSelectRow="@SelectHelmRelease"
                                  OnContextMenu="@((args) => ShowHelmMenu(args.Item1, args.Item2))" />
                    </div>

                    <div hidden="@(ActiveResourceType != "Jobs")">
                        <JobGrid FilteredItems="@FilteredJobs" IsMultiNamespace="@IsMultiNamespace"
                                 SelectedJob="@SelectedJob" OnSelectRow="@SelectJob"
                                 OnContextMenu="@((args) => ShowJobMenu(args.Item1, args.Item2))"
                                 OnNamespaceClick="@HandleNamespaceJumpAsync" />
                    </div>

                    <div hidden="@(ActiveResourceType != "CronJobs")">
                        <CronJobGrid FilteredItems="@FilteredCronJobs" IsMultiNamespace="@IsMultiNamespace"
                                     SelectedCronJob="@SelectedCronJob" OnSelectRow="@SelectCronJob"
                                     OnContextMenu="@((args) => ShowCronJobMenu(args.Item1, args.Item2))"
                                     OnNamespaceClick="@HandleNamespaceJumpAsync" />
                    </div>
                </div>

                @* ── Keyboard hint bar ── *@
                <div class="aks-kbd-hints">
                    <span class="aks-kbd-hint"><kbd>↑↓</kbd> navigate</span>
                    @if (ActiveResourceType is "Deployments" or "StatefulSets" or "Pods")
                    {
                        <span class="aks-kbd-hint"><kbd>l</kbd> logs</span>
                    }
                    @if (ActiveResourceType is "Deployments" or "StatefulSets" or "Pods")
                    {
                        <span class="aks-kbd-hint"><kbd>n</kbd> network</span>
                    }
                    @if (ActiveResourceType is "Deployments" or "StatefulSets" or "ConfigMaps" or "Secrets"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    or "Services" or "Ingresses" or "GatewayClasses" or "Gateways" or "HTTPRoutes" or "Pods" or "Jobs" or
                                                                                                                                            "CronJobs")
                    {
                        <span class="aks-kbd-hint"><kbd>y</kbd> yaml</span>
                    }
                    @if (ActiveResourceType == "Ingresses")
                    {
                        <span class="aks-kbd-hint"><kbd>i</kbd> inspect</span>
                    }
                    @if (ActiveResourceType is "Deployments" or "StatefulSets")
                    {
                        <span class="aks-kbd-hint"><kbd>r</kbd> restart</span>
                    }
                    @if (ActiveResourceType == "Pods")
                    {
                        var podRunning = SelectedPod?.Status is "Running";
                        var podTerminating = SelectedPod?.Status?.Contains("Terminating") == true;
                        var shellUnavailable = SelectedPod is not null && !podRunning;

                        <span class="aks-kbd-hint @(shellUnavailable ? "aks-kbd-hint--dimmed" : "")"
                              title="@(shellUnavailable ? "Shell not available — pod is not running" : "")">
                            <kbd>s</kbd> shell
                        </span>
                        <span class="aks-kbd-hint"><kbd>p</kbd> port-fwd</span>
                        @if (!podTerminating)
                        {
                            <span class="aks-kbd-hint"><kbd>d</kbd> kill</span>
                        }
                    }
                    @if (ActiveResourceType == "CronJobs")
                    {
                        var cronSuspended = SelectedCronJob?.Suspend == true;
                        <span class="aks-kbd-hint @(cronSuspended ? "aks-kbd-hint--dimmed" : "")"
                              title="@(cronSuspended ? "CronJob is suspended" : "")">
                            <kbd>r</kbd> trigger
                        </span>
                    }
                    @if (ActiveResourceType == "Helm")
                    {
                        <span class="aks-kbd-hint"><kbd>h</kbd> history</span>
                        <span class="aks-kbd-hint"><kbd>v</kbd> values</span>
                    }
                    @if (ActiveResourceType is "ConfigMaps" or "Secrets")
                    {
                        <span class="aks-kbd-hint"><kbd>Enter</kbd> view keys</span>
                    }
                    <span class="aks-kbd-hint"><kbd>/</kbd> filter</span>
                    <span class="aks-kbd-hint"><kbd>Esc</kbd> deselect</span>
                </div>
            </div>

            @* ── Side column: all detail panels ── *@
            <AksDetailPanels @ref="_detailPanels" Client="Client" Namespace="@CurrentPrimaryNamespace"
                             IsProduction="@IsProduction" Confirm="Confirm" Notifications="Notifications" Events="@Events"
                             Deployments="@Deployments" Pods="@Pods" StatefulSets="@StatefulSets" ShowEvents="@ShowEvents"
                             OnShowEventsChanged="HandleToggleEventsOff" OnError="@(msg => ErrorMessage = msg)" OnDataChanged="LoadAsync"
                             OnIsOpenChanged="HandlePanelOpenChanged" OnJumpToResource="HandleJumpToResource" />

        </div>
    }

    @* ── Context menus ── *@
    <ContextMenu @ref="DeploymentMenu">
        <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxDeployment?.Name)"><span
            class="ctx-item-icon">📋</span> Copy name</button>
            <button class="ctx-item" @onclick="() => OnCtxViewYaml('D')"><span class="ctx-item-icon">{ }</span> View
                YAML</button>
                <button class="ctx-item" @onclick="() => OnCtxEditYaml('D')"><span class="ctx-item-icon">✎</span> Edit
                    YAML</button>
                    <button class="ctx-item" @onclick="OnCtxViewDeploymentLogs"><span class="ctx-item-icon">&#9776;</span> View
                        Logs</button>
                        <button class="ctx-item" @onclick="OnCtxAllPodsLogs"><span class="ctx-item-icon">&#9782;</span> Logs for all
                            pods</button>
                            <button class="ctx-item" @onclick="OnCtxContainerDetailsDeployment"><span class="ctx-item-icon">&#9881;</span>
                                Container Details</button>
                                <button class="ctx-item" @onclick="OnCtxAnalyzeDeploymentNetwork"><span class="ctx-item-icon">&#128246;</span>
                                    Analyze network</button>
                                    <button class="ctx-item" @onclick="OnCtxProbeFailuresDeployment"><span class="ctx-item-icon">&#128680;</span>
                                        Probe failures</button>
                                        <button class="ctx-item" @onclick="OnCtxPlacementDeployment"><span class="ctx-item-icon">&#128205;</span>
                                            Placement</button>
                                            <div class="ctx-separator"></div>
                                            <button class="ctx-item" @onclick="OnCtxRestartDeployment"><span class="ctx-item-icon">&#8635;</span> Restart
                                                Deployment</button>
                                                <button class="ctx-item" @onclick="OnCtxScaleDeployment"><span class="ctx-item-icon">&#8693;</span>
                                                    Scale...</button>
                                                </ContextMenu>

                                                <ContextMenu @ref="PodMenu">
                                                    <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxPod?.Name)"><span
                                                        class="ctx-item-icon">📋</span> Copy name</button>
                                                        <button class="ctx-item" @onclick="() => OnCtxViewYaml('P')"><span class="ctx-item-icon">{ }</span> View
                                                            YAML</button>
                                                            <button class="ctx-item" @onclick="OnCtxViewPodLogs"><span class="ctx-item-icon">&#9776;</span> View
                                                                Logs</button>
                                                                <button class="ctx-item" @onclick="OnCtxContainerDetailsPod"><span class="ctx-item-icon">&#9881;</span>
                                                                    Container Details</button>
                                                                    <button class="ctx-item" @onclick="OnCtxAnalyzePodNetwork"><span class="ctx-item-icon">&#128246;</span>
                                                                        Analyze network</button>
                                                                        <div class="ctx-separator"></div>
                                                                        <button class="ctx-item" @onclick="OnCtxOpenPodShell"><span class="ctx-item-icon">&#62;</span> Open shell in
                                                                            pod</button>
                                                                            <button class="ctx-item" @onclick="OnCtxPortForward"><span class="ctx-item-icon">&#8594;</span>
                                                                                Port-forward…</button>
                                                                                <div class="ctx-separator"></div>
                                                                                <button class="ctx-item destructive" @onclick="OnCtxKillPod"><span class="ctx-item-icon">&#10005;</span> Kill
                                                                                    Pod</button>
                                                                                </ContextMenu>

                                                                                <ContextMenu @ref="ServiceMenu">
                                                                                    <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxService?.Name)"><span
                                                                                        class="ctx-item-icon">📋</span> Copy name</button>
                                                                                        <button class="ctx-item" @onclick="OnCtxViewYamlService"><span class="ctx-item-icon">{ }</span> View
                                                                                            YAML</button>
                                                                                        </ContextMenu>

                                                                                        <ContextMenu @ref="IngressMenu">
                                                                                            <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxIngress?.Name)"><span
                                                                                                class="ctx-item-icon">📋</span> Copy name</button>
                                                                                                <button class="ctx-item" @onclick="() => OnCtxViewYaml('I')"><span class="ctx-item-icon">{ }</span> View
                                                                                                    YAML</button>
                                                                                                    <button class="ctx-item" @onclick="() => OnCtxEditYaml('I')"><span class="ctx-item-icon">✎</span> Edit
                                                                                                        YAML</button>
                                                                                                        <button class="ctx-item" @onclick="OnCtxOpenIngressUrl"><span class="ctx-item-icon">&#128279;</span> Open URL in
                                                                                                            browser</button>
                                                                                                            <button class="ctx-item" @onclick="OnCtxCopyHostUrl"><span class="ctx-item-icon">&#128203;</span> Copy
                                                                                                                URL</button>
                                                                                                                <button class="ctx-item" @onclick="OnCtxAnalyzeIngress"><span class="ctx-item-icon">&#128269;</span>
                                                                                                                    Analyze ingress</button>
                                                                                                                    <div class="ctx-separator"></div>
                                                                                                                    <button class="ctx-item destructive" @onclick="OnCtxDeleteIngress"><span class="ctx-item-icon">&#10005;</span>
                                                                                                                        Delete
                                                                                                                        Ingress</button>
                                                                                                                    </ContextMenu>

                                                                                                                    <ContextMenu @ref="GatewayClassMenu">
                                                                                                                        <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxGatewayClass?.Name)"><span
                                                                                                                            class="ctx-item-icon">📋</span> Copy name</button>
                                                                                                                            <button class="ctx-item" @onclick="OnCtxViewYamlGatewayClass"><span class="ctx-item-icon">{ }</span> View
                                                                                                                                YAML</button>
                                                                                                                            </ContextMenu>

                                                                                                                            <ContextMenu @ref="GatewayMenu">
                                                                                                                                <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxGateway?.Name)"><span
                                                                                                                                    class="ctx-item-icon">📋</span> Copy name</button>
                                                                                                                                    <button class="ctx-item" @onclick="OnCtxViewYamlGateway"><span class="ctx-item-icon">{ }</span> View
                                                                                                                                        YAML</button>
                                                                                                                                    </ContextMenu>

                                                                                                                                    <ContextMenu @ref="HttpRouteMenu">
                                                                                                                                        <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxHttpRoute?.Name)"><span
                                                                                                                                            class="ctx-item-icon">📋</span> Copy name</button>
                                                                                                                                            <button class="ctx-item" @onclick="OnCtxViewYamlHttpRoute"><span class="ctx-item-icon">{ }</span> View
                                                                                                                                                YAML</button>
                <button class="ctx-item" @onclick="OnCtxEditYamlHttpRoute"><span class="ctx-item-icon">✎</span> Edit
                    YAML</button>
                    <div class="ctx-separator"></div>
                    <button class="ctx-item destructive" @onclick="OnCtxDeleteHttpRoute"><span class="ctx-item-icon">&#10005;</span>
                        Delete
                        HTTPRoute</button>
                    </ContextMenu>

                    <ContextMenu @ref="HelmMenu">
                        <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxHelm?.Name)"><span
                            class="ctx-item-icon">📋</span> Copy name</button>
                            <button class="ctx-item" @onclick="() => OnCtxViewYaml('H')"><span class="ctx-item-icon">{ }</span> View Release
                                YAML</button>
                                <button class="ctx-item" @onclick="OnCtxViewHelmValues"><span class="ctx-item-icon">&#9998;</span> View
                                                                                                                                                                Values</button>
                                                                                                                                                                <button class="ctx-item" @onclick="OnCtxViewHelmHistory"><span class="ctx-item-icon">&#128337;</span> View
                                                                                                                                                                    History</button>
                                                                                                                                                                    <button class="ctx-item" @onclick="OnCtxHelmDiffPreview"><span class="ctx-item-icon">&#128269;</span>
                                                                                                                                                                        Preview upgrade</button>
                                                                                                                                                                        <div class="ctx-separator"></div>
                                                                                                                                                                        <button class="ctx-item destructive" @onclick="OnCtxRollbackHelm"><span class="ctx-item-icon">&#8634;</span>
                                                                                                                                                                            Rollback...</button>
                                                                                                                                                                        </ContextMenu>

                                                                                                                                                                        <ContextMenu @ref="StatefulSetMenu">
                                                                                                                                                                            <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxStatefulSet?.Name)"><span
                                                                                                                                                                                class="ctx-item-icon">📋</span> Copy name</button>
                                                                                                                                                                                <button class="ctx-item" @onclick="() => OnCtxViewYaml('S')"><span class="ctx-item-icon">{ }</span> View
                                                                                                                                                                                    YAML</button>
                                                                                                                                                                                    <button class="ctx-item" @onclick="() => OnCtxEditYaml('S')"><span class="ctx-item-icon">✎</span> Edit
                                                                                                                                                                                        YAML</button>
                                                                                                                                                                                        <button class="ctx-item" @onclick="OnCtxAllPodsLogsStatefulSet"><span class="ctx-item-icon">&#9782;</span> Logs
                                                                                                                                                                                            for all pods</button>
                                                                                                                                                                                            <div class="ctx-separator"></div>
                                                                                                                                                                                            <button class="ctx-item" @onclick="OnCtxRestartStatefulSet"><span class="ctx-item-icon">&#8635;</span>
                                                                                                                                                                                                Restart</button>
                                                                                                                                                                                                <button class="ctx-item" @onclick="OnCtxScaleStatefulSet"><span class="ctx-item-icon">&#8693;</span>
                                                                                                                                                                                                    Scale...</button>
                                                                                                                                                                                                    <button class="ctx-item" @onclick="OnCtxAnalyzeStatefulSetNetwork"><span class="ctx-item-icon">&#128246;</span>
                                                                                                                                                                                                        Analyze network</button>
                                                                                                                                                                                                        <button class="ctx-item" @onclick="OnCtxProbeFailuresStatefulSet"><span class="ctx-item-icon">&#128680;</span>
                                                                                                                                                                                                            Probe failures</button>
                                                                                                                                                                                                            <button class="ctx-item" @onclick="OnCtxPlacementStatefulSet"><span class="ctx-item-icon">&#128205;</span>
                                                                                                                                                                                                                Placement</button>
                                                                                                                                                                                                            </ContextMenu>

                                                                                                                                                                                                            <ContextMenu @ref="ConfigMapMenu">
                                                                                                                                                                                                                <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxConfigMap?.Name)"><span
                                                                                                                                                                                                                    class="ctx-item-icon">📋</span> Copy name</button>
                                                                                                                                                                                                                    <button class="ctx-item" @onclick="() => OnCtxViewYaml('C')"><span class="ctx-item-icon">{ }</span> View
                                                                                                                                                                                                                        YAML</button>
                                                                                                                                                                                                                        <button class="ctx-item" @onclick="() => OnCtxEditYaml('C')"><span class="ctx-item-icon">✎</span> Edit
                                                                                                                                                                                                                            YAML</button>
                                                                                                                                                                                                                            <button class="ctx-item" @onclick="OnCtxViewConfigMapKeys"><span class="ctx-item-icon">&#128273;</span> View
                                                                                                                                                                                                                                Keys</button>
                                                                                                                                                                                                                            </ContextMenu>

                                                                                                                                                                                                                            <ContextMenu @ref="SecretMenu">
                                                                                                                                                                                                                                <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxSecret?.Name)"><span
                                                                                                                                                                                                                                    class="ctx-item-icon">📋</span> Copy name</button>
                                                                                                                                                                                                                                    <button class="ctx-item" @onclick="() => OnCtxViewYaml('E')"><span class="ctx-item-icon">{ }</span> View
                                                                                                                                                                                                                                        YAML</button>
                                                                                                                                                                                                                                        <button class="ctx-item" @onclick="() => OnCtxEditYaml('E')"><span class="ctx-item-icon">✎</span> Edit
                                                                                                                                                                                                                                            YAML</button>
                                                                                                                                                                                                                                            <button class="ctx-item" @onclick="OnCtxViewSecretKeys"><span class="ctx-item-icon">&#128274;</span> View
                                                                                                                                                                                                                                                Keys</button>
                                                                                                                                                                                                                                            </ContextMenu>

                                                                                                                                                                                                                                            <ContextMenu @ref="JobMenu">
                                                                                                                                                                                                                                                <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxJob?.Name)"><span
                                                                                                                                                                                                                                                    class="ctx-item-icon">📋</span> Copy name</button>
                                                                                                                                                                                                                                                    <button class="ctx-item" @onclick="OnCtxViewYamlJob"><span class="ctx-item-icon">{ }</span> View
                                                                                                                                                                                                                                                        YAML</button>
                                                                                                                                                                                                                                                        <div class="ctx-separator"></div>
                                                                                                                                                                                                                                                        <button class="ctx-item" @onclick="OnCtxRerunJob"><span class="ctx-item-icon">&#8635;</span> Rerun
                                                                                                                                                                                                                                                            job</button>
                                                                                                                                                                                                                                                            <button class="ctx-item" @onclick="OnCtxToggleJobPause"><span class="ctx-item-icon">@(CtxJob?.Parallelism == 0 ?
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "▶" : "⏸")</span> @(CtxJob?.Parallelism == 0 ? "Resume job" : "Pause job")</button>
                                                                                                                                                                                                                                                            </ContextMenu>

                                                                                                                                                                                                                                                            <ContextMenu @ref="CronJobMenu">
                                                                                                                                                                                                                                                                <button class="ctx-item" @onclick="() => CopyToClipboardAsync(CtxCronJob?.Name)"><span
                                                                                                                                                                                                                                                                    class="ctx-item-icon">📋</span> Copy name</button>
                                                                                                                                                                                                                                                                    <button class="ctx-item" @onclick="OnCtxViewYamlCronJob"><span class="ctx-item-icon">{ }</span> View
                                                                                                                                                                                                                                                                        YAML</button>
                                                                                                                                                                                                                                                                        <div class="ctx-separator"></div>
                                                                                                                                                                                                                                                                        <button class="ctx-item" @onclick="OnCtxRunCronJob"><span class="ctx-item-icon">&#9654;</span> Run
                                                                                                                                                                                                                                                                            now</button>
                                                                                                                                                                                                                                                                            <button class="ctx-item" @onclick="OnCtxToggleCronJobSuspend"><span class="ctx-item-icon">@(CtxCronJob?.Suspend
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                == true ? "▶" : "⏸")</span> @(CtxCronJob?.Suspend == true ? "Resume" : "Suspend")</button>
                                                                                                                                                                                                                                                                            </ContextMenu>

                                                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                                                        @* ── Port-forward sessions panel ── *@
                                                                                                                                                                                                                                                                        @if (ShowPortForwardSessions)
                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                            <PortForwardSessionsPanel Expanded="true" OnStopSession="OnStopPortForwardSession" />
                                                                                                                                                                                                                                                                        }

@* ── Port-forward start dialog ── *@
<PortForwardStartDialog Visible="@ShowPortForwardDialog" PodName="@(_pfDialogPod?.Name ?? "")"
                        Namespace="@(_pfDialogPod?.Namespace ?? "")" RemotePort="@_pfDialogRemotePort" KubeconfigContext="@ActiveContext"
                        PinnedEntries="@PinnedPortForwards.GetPins(ActiveContext)" OnStart="OnStartPortForward"
                        OnCancel="@(() => { ShowPortForwardDialog = false; StateHasChanged(); })"
                        OnPinAdd="@(async entry => await PinnedPortForwards.AddPinAsync(ActiveContext, entry))"
                        OnPinRemove="@(async entry => await PinnedPortForwards.RemovePinAsync(ActiveContext, entry))" />

@* Code-behind is in partial class files:
   AksPage.razor.Core.cs - state fields, lifecycle, bootstrap, commands, dispose
   AksPage.razor.Filters.cs - filter state and filtered collections
   AksPage.razor.Lifecycle.cs - LoadAsync, namespace scope, context/namespace handlers
   AksPage.razor.Selection.cs - selection, navigation, keyboard, workspace snapshot
   AksPage.razor.ContextMenuActions.cs - context menu show/action handlers *@