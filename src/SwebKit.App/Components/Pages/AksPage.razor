    // ── Grid keyboard navigation ──

    private void HandleGridKeyDown(KeyboardEventArgs e)
    {
        _preventGridKey = e.Key is "ArrowUp" or "ArrowDown" or "Escape";

        if (ActiveResourceType == "Deployments")
        {
            var items = FilteredDeployments.ToList();
            if (items.Count == 0) return;

            var currentIdx = SelectedDeployment is null
                ? -1
                : items.FindIndex(d => d.Name == SelectedDeployment.Name);

            switch (e.Key)
            {
                case "ArrowDown":
                    SelectedDeployment = items[Math.Min(currentIdx + 1, items.Count - 1)];
                    StateHasChanged();
                    break;
                case "ArrowUp":
                    SelectedDeployment = currentIdx > 0
                        ? items[Math.Max(currentIdx - 1, 0)]
                        : SelectedDeployment;
                    StateHasChanged();
                    break;
                case "Escape":
                    SelectedDeployment = null;
                    StateHasChanged();
                    break;
            }
        }
    }

