    private async Task OnSaveYaml()
    {
        if (YamlTarget is null || Client is null) return;
        YamlApplying = true;
        StateHasChanged();

        try
        {
            if (IsProduction)
            {
                var confirmed = await Confirm.ShowAsync(
                $"Apply YAML changes to {YamlTarget.Value.Kind} \"{YamlTarget.Value.Name}\" in production?",
                YamlTarget.Value.Name,
                requireTypedName: true);
                if (!confirmed) { YamlApplying = false; StateHasChanged(); return; }
            }

            await Client.ApplyResourceYamlAsync(CurrentNamespace, YamlTarget.Value.Kind, YamlTarget.Value.Name, YamlEditText);
            YamlText = YamlEditText;
            _yamlHighlighted = await HighlightAsync(YamlText);
            YamlEditMode = false;
            YamlEditText = string.Empty;
            StateHasChanged();
            Notifications.ShowSuccess("YAML applied", $"{YamlTarget.Value.Kind} {YamlTarget.Value.Name}");
        }
        catch (Exception ex) { ErrorMessage = ex.Message; Notifications.ShowError("Failed to apply YAML", ex: ex); }
        finally { YamlApplying = false; StateHasChanged(); }
    }

    private async Task OnCtxEditYaml(char source)
    {
        var (kind, name) = source switch
        {
            'D' => ("Deployment", CtxDeployment?.Name),
            'I' => ("Ingress", CtxIngress?.Name),
            'S' => ("StatefulSet", CtxStatefulSet?.Name),
            'C' => ("ConfigMap", CtxConfigMap?.Name),
            'E' => ("Secret", CtxSecret?.Name),
            _ => ((string?)null, (string?)null)
        };
        CloseAllMenus();
        if (kind is not null && name is not null)
            await OpenYaml(kind, name, startInEditMode: true);
    }

    private static string TruncatePodName(string name)
    => name.Length > 36 ? name[..18] + "…" + name[^14..] : name;

