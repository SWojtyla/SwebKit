@using SwebKit.Core.Domain
@inject AppStateService AppState

<div style="display:grid; gap:12px; padding:12px 0;">
    @* ── Cache list ── *@
    @if (Caches.Count > 0)
    {
        <div style="font-size:12px; color:var(--color-text-muted); font-weight:600;">Configured Caches</div>
        @foreach (var cache in Caches)
        {
            <div
                style="display:flex; align-items:center; gap:8px; padding:6px 8px; border:1px solid var(--color-border); border-radius:4px; background:var(--color-surface);">
                <span style="flex:1; font-size:12px; font-family:Consolas, monospace;">@cache.DisplayName</span>
                <span style="font-size:11px; color:var(--color-text-muted);">DB@cache.Database</span>
                <FluentButton Appearance="Appearance.Lightweight" @onclick="() => EditCache(cache)">Edit</FluentButton>
                <FluentButton Appearance="Appearance.Lightweight" @onclick="() => RemoveCache(cache)">Remove</FluentButton>
            </div>
        }
    }

    @* ── Edit / Add form ── *@
    <div style="font-size:12px; color:var(--color-text-muted); font-weight:600;">
        @(EditingCacheId is not null ? "Edit Cache" : "Add Cache")
    </div>

    <div style="display:grid; gap:4px;">
        <label style="font-size:12px; color:var(--color-text-muted);">Display Name</label>
        <input type="text" @bind="DisplayName" @bind:event="oninput" class="@FieldClass(FieldDisplayName)"
               aria-invalid="@HasError(FieldDisplayName)" aria-describedby="@ErrorId(FieldDisplayName)"
               style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px;"
               placeholder="Dev Cache" @onfocusin="() => ClearError(FieldDisplayName)" />
        @if (_errors.TryGetValue(FieldDisplayName, out var dnErr))
        {
            <span id="err-display-name" class="field-error-msg" role="alert">@dnErr</span>
        }
    </div>

    <div style="display:grid; gap:4px;">
        <label style="font-size:12px; color:var(--color-text-muted);">Redis Connection String</label>
        <PasswordField Value="@ConnectionString" ValueChanged="@(v => { ConnectionString = v ?? ""; ClearError(FieldConnectionString); })"
                       Label="Redis Connection String"
                       Placeholder="localhost:6379,password=***,abortConnect=false"
                       InputClass="@FieldClass(FieldConnectionString)" />
        @if (_errors.TryGetValue(FieldConnectionString, out var csErr))
        {
            <span id="err-conn-str" class="field-error-msg" role="alert">@csErr</span>
        }
    </div>

    <div style="display:grid; gap:6px;">
        <label style="font-size:12px; color:var(--color-text-muted);">Default Database</label>
        <select @bind="Database"
                style="padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px; font-size:12px; width:120px;">
            @for (var i = 0; i <= 15; i++)
            {
                <option value="@i">DB@i</option>
            }
        </select>
    </div>

    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
        <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync">
            @(EditingCacheId is not null ? "Save Cache" : "Add Cache")
        </FluentButton>
        @if (EditingCacheId is not null)
        {
            <FluentButton @onclick="CancelEdit">Cancel</FluentButton>
        }
        <FluentButton @onclick="TestConnectionAsync">Test Connection</FluentButton>

        @if (ConnectionStatus is not null)
        {
            <span
            style="font-size:12px; color:@(ConnectionOk ? "var(--color-success)" : "var(--color-error)");">@ConnectionStatus</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public AppConfig Environment { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private string DisplayName = string.Empty;
    private string ConnectionString = string.Empty;
    private int Database;
    private Dictionary<string, string> _errors = new();

    private const string FieldDisplayName = "DisplayName";
    private const string FieldConnectionString = "ConnectionString";

    private string FieldClass(string field) => _errors.ContainsKey(field) ? "field-invalid" : "";
    private string? HasError(string field) => _errors.ContainsKey(field) ? "true" : null;
    private string? ErrorId(string field) => _errors.ContainsKey(field) ? $"err-{field.ToLowerInvariant()}" : null;
    private string? ConnectionStatus;
    private bool ConnectionOk;
    private string? EditingCacheId;
    private List<RedisCacheEntry> Caches
    {
        get
        {
            var config = Environment.RedisConfig;
            if (config is null) return [];
            config.EnsureMigrated();
            return config.Caches;
        }
    }

    protected override void OnParametersSet()
    {
        Environment.RedisConfig?.EnsureMigrated();
        ResetForm();
    }

    private void ResetForm()
    {
        EditingCacheId = null;
        DisplayName = string.Empty;
        ConnectionString = string.Empty;
        Database = 0;
        ConnectionStatus = null;
        ConnectionOk = false;
        _errors.Clear();
    }

    private bool Validate()
    {
        _errors.Clear();
        if (string.IsNullOrWhiteSpace(DisplayName))
            _errors["DisplayName"] = "Display name is required.";
        if (string.IsNullOrWhiteSpace(ConnectionString))
            _errors["ConnectionString"] = "Connection string is required.";
        return _errors.Count == 0;
    }

    private void ClearError(string field)
    {
        if (_errors.Remove(field))
            StateHasChanged();
    }

    private void EditCache(RedisCacheEntry cache)
    {
        EditingCacheId = cache.Id;
        DisplayName = cache.DisplayName;
        ConnectionString = cache.ConnectionString;
        Database = cache.Database;
        ConnectionStatus = null;
    }

    private void CancelEdit() => ResetForm();

    private async Task RemoveCache(RedisCacheEntry cache)
    {
        var config = Environment.RedisConfig;
        if (config is null) return;

        config.Caches.Remove(cache);
        if (config.ActiveCacheId == cache.Id)
            config.ActiveCacheId = config.Caches.FirstOrDefault()?.Id;

        if (EditingCacheId == cache.Id)
            ResetForm();

        await OnSaved.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAsync()
    {
        if (!Validate())
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        var config = Environment.RedisConfig ??= new RedisConfig();

        if (EditingCacheId is not null)
        {
            var existing = config.Caches.FirstOrDefault(c => c.Id == EditingCacheId);
            if (existing is not null)
            {
                existing.DisplayName = string.IsNullOrWhiteSpace(DisplayName) ? "Cache" : DisplayName.Trim();
                existing.ConnectionString = ConnectionString.Trim();
                existing.Database = Math.Clamp(Database, 0, 15);
            }
        }
        else
        {
            var entry = new RedisCacheEntry
            {
                DisplayName = string.IsNullOrWhiteSpace(DisplayName) ? "Cache" : DisplayName.Trim(),
                ConnectionString = ConnectionString.Trim(),
                Database = Math.Clamp(Database, 0, 15)
            };
            config.Caches.Add(entry);
            config.ActiveCacheId ??= entry.Id;
        }

        await OnSaved.InvokeAsync();
        ConnectionOk = true;
        ConnectionStatus = EditingCacheId is not null ? "Cache updated." : "Cache added.";
        ResetForm();
        ConnectionStatus = "Saved.";
        await InvokeAsync(StateHasChanged);
    }

    private async Task TestConnectionAsync()
    {
        ConnectionStatus = null;
        ConnectionOk = false;

        try
        {
            using var client = await CreateClientAsync();
            var ok = await client.TestConnectionAsync();
            ConnectionOk = ok;
            ConnectionStatus = ok ? "Connection successful." : "Connection failed.";
        }
        catch (Exception ex)
        {
            ConnectionOk = false;
            ConnectionStatus = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<IRedisClient> CreateClientAsync()
    {
        if (AppState.UseDemoData)
            return new DemoRedisClient(Database);

        if (string.IsNullOrWhiteSpace(ConnectionString))
            throw new InvalidOperationException("Provide a Redis connection string before testing.");

        return await SwebKit.Redis.RedisClient.CreateAsync(new RedisCacheEntry
        {
            DisplayName = DisplayName,
            ConnectionString = ConnectionString,
            Database = Database
        });
    }
}
