@using Microsoft.AspNetCore.Components.Forms
@using SwebKit.Core.Domain
@inject AppStateService AppState

<div class="redis-settings-shell">
    <section class="redis-settings-card redis-settings-card--hero">
        <div class="redis-settings-card__copy">
            <p class="redis-settings-card__eyebrow">Redis connections</p>
            <h3 class="redis-settings-card__title">Manage cache profiles for this environment</h3>
            <p class="redis-settings-card__body">
                Add one cache at a time or import a connection list from a `.txt` or `.json` export.
                Imported entries are merged by Redis endpoint.
            </p>
        </div>
        <div class="redis-settings-card__meta">
            <span class="shell-pill shell-pill--muted">@Caches.Count configured</span>
            <span class="shell-pill shell-pill--muted">Global separator: @CurrentSeparator</span>
        </div>
    </section>

    <section class="redis-settings-card redis-settings-card--import">
        <div class="redis-settings-import__copy">
            <h4 class="redis-settings-section-title">Import connection list</h4>
            <p class="redis-settings-card__body">
                Accepts Redis connection exports like the file you attached. If the file contains mixed separators,
                SwebKit applies the most common one because separator grouping is global today.
            </p>
        </div>
        <div class="redis-settings-import__actions">
            <FluentInputFile class="redis-settings-import__picker" AnchorId="redis-settings-import-trigger"
                             Accept=".txt,.json,application/json,text/plain" MaximumFileCount="1" DragDropZoneVisible="false"
                             Disabled="@_isImportingConnections" OnInputFileChange="OnImportFileSelected" />
            <FluentButton id="redis-settings-import-trigger" Appearance="Appearance.Outline"
                          Disabled="@_isImportingConnections">
                @(_selectedImportFile is null ? "Choose file" : "Change file")
            </FluentButton>
            <FluentButton Appearance="Appearance.Accent"
                          Disabled="@(_selectedImportFile is null || _isImportingConnections)" @onclick="ImportConnectionsAsync">
                @(_isImportingConnections ? "Importing…" : "Import connections")
            </FluentButton>
        </div>
        @if (_selectedImportFile is not null)
        {
            <p class="redis-settings-card__body">Selected file: @_selectedImportFile.Name</p>
        }
    </section>

    @if (StatusMessage is not null)
    {
        <div class="redis-settings-status redis-settings-status--@StatusTone" role="status">@StatusMessage</div>
    }

    @if (Caches.Count > 0)
    {
        <section class="redis-settings-card">
            <div class="redis-settings-card__header">
                <h4 class="redis-settings-section-title">Configured caches</h4>
            </div>
            <div class="redis-settings-cache-grid">
                @foreach (var cache in Caches)
                {
                    <article
                        class="redis-settings-cache-card @(cache.Id == Environment.RedisConfig?.ActiveCacheId ? "redis-settings-cache-card--active" : string.Empty)">
                        <div class="redis-settings-cache-card__header">
                            <div class="redis-settings-cache-card__copy">
                                <h5 class="redis-settings-cache-card__title">@GetCachePrimaryLabel(cache)</h5>
                                @if (GetCacheSecondaryLabel(cache) is { } secondaryLabel)
                                {
                                    <p class="redis-settings-cache-card__detail">@secondaryLabel</p>
                                }
                            </div>
                            <div class="redis-settings-cache-card__meta">
                                @if (cache.Id == Environment.RedisConfig?.ActiveCacheId)
                                {
                                    <span class="shell-pill shell-pill--muted">Active</span>
                                }
                                <span class="shell-pill shell-pill--muted">DB@cache.Database</span>
                            </div>
                        </div>
                        <p class="redis-settings-cache-card__endpoint">@GetConnectionIdentity(cache.ConnectionString)</p>
                        <div class="redis-settings-cache-card__footer">
                            <div class="redis-settings-cache-card__actions">
                                <FluentButton Appearance="Appearance.Lightweight" @onclick="() => EditCache(cache)">Edit
                                </FluentButton>
                                <FluentButton Appearance="Appearance.Lightweight" @onclick="() => RemoveCache(cache)">Remove
                                </FluentButton>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <section class="redis-settings-card">
        <div class="redis-settings-card__header">
            <div>
                <h4 class="redis-settings-section-title">@(EditingCacheId is not null ? "Edit cache" : "Add cache")</h4>
                <p class="redis-settings-card__body">Use a display name that reads well in the Redis workspace and
                    dashboard.</p>
                </div>
            </div>

            <div class="redis-settings-form-grid">
                <div class="redis-settings-field">
                    <label class="redis-settings-field__label">Display name</label>
                    <input type="text" @bind="DisplayName" @bind:event="oninput"
                           class="@FieldClass(FieldDisplayName) redis-settings-field__input"
                           aria-invalid="@HasError(FieldDisplayName)" aria-describedby="@ErrorId(FieldDisplayName)"
                           placeholder="Dev Cache" @onfocusin="() => ClearError(FieldDisplayName)" />
                    @if (_errors.TryGetValue(FieldDisplayName, out var dnErr))
                    {
                        <span id="err-display-name" class="field-error-msg" role="alert">@dnErr</span>
                    }
                </div>

                <div class="redis-settings-field">
                    <label class="redis-settings-field__label">Redis connection string</label>
                    <PasswordField Value="@ConnectionString"
                                   ValueChanged="@(v => { ConnectionString = v ?? string.Empty; ClearError(FieldConnectionString); })"
                                   Label="Redis Connection String" Placeholder="localhost:6379,password=***,abortConnect=false"
                                   InputClass="@FieldClass(FieldConnectionString)" />
                    @if (_errors.TryGetValue(FieldConnectionString, out var csErr))
                    {
                        <span id="err-conn-str" class="field-error-msg" role="alert">@csErr</span>
                    }
                </div>

                <div class="redis-settings-field redis-settings-field--compact">
                    <label class="redis-settings-field__label">Default database</label>
                    <select @bind="Database" class="redis-settings-field__input redis-settings-field__input--select">
                        @for (var i = 0; i <= 15; i++)
                        {
                            <option value="@i">DB@i</option>
                        }
                    </select>
                </div>
            </div>

            <div class="redis-settings-actions">
                <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync">
                    @(EditingCacheId is not null ? "Save cache" : "Add cache")
                </FluentButton>
                @if (EditingCacheId is not null)
                {
                    <FluentButton Appearance="Appearance.Lightweight" @onclick="CancelEdit">Cancel</FluentButton>
                }
                <FluentButton Appearance="Appearance.Lightweight" @onclick="TestConnectionAsync">Test connection
                </FluentButton>
            </div>
        </section>
    </div>

@code {
    [Parameter, EditorRequired] public AppConfig Environment { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private string DisplayName = string.Empty;
    private string ConnectionString = string.Empty;
    private int Database;
    private Dictionary<string, string> _errors = new();
    private IBrowserFile? _selectedImportFile;
    private bool _isImportingConnections;

    private const string FieldDisplayName = "DisplayName";
    private const string FieldConnectionString = "ConnectionString";

    private string FieldClass(string field) => _errors.ContainsKey(field) ? "field-invalid" : "";
    private string? HasError(string field) => _errors.ContainsKey(field) ? "true" : null;
    private string? ErrorId(string field) => _errors.ContainsKey(field) ? $"err-{field.ToLowerInvariant()}" : null;
    private string? StatusMessage;
    private string StatusTone = "muted";
    private string? EditingCacheId;

    private string CurrentSeparator => Environment.RedisConfig?.NamespaceSeparator ?? "-";

    private List<RedisCacheEntry> Caches
    {
        get
        {
            var config = Environment.RedisConfig;
            if (config is null) return [];
            config.EnsureMigrated();
            return config.Caches;
        }
    }

    protected override void OnParametersSet()
    {
        Environment.RedisConfig?.EnsureMigrated();
        ResetForm();
    }

    private void ResetForm()
    {
        EditingCacheId = null;
        DisplayName = string.Empty;
        ConnectionString = string.Empty;
        Database = 0;
        _errors.Clear();
    }

    private bool Validate()
    {
        _errors.Clear();
        if (string.IsNullOrWhiteSpace(DisplayName))
            _errors["DisplayName"] = "Display name is required.";
        if (string.IsNullOrWhiteSpace(ConnectionString))
            _errors["ConnectionString"] = "Connection string is required.";
        return _errors.Count == 0;
    }

    private void ClearError(string field)
    {
        if (_errors.Remove(field))
            StateHasChanged();
    }

    private void EditCache(RedisCacheEntry cache)
    {
        EditingCacheId = cache.Id;
        DisplayName = cache.DisplayName;
        ConnectionString = cache.ConnectionString;
        Database = cache.Database;
    }

    private void OnImportFileSelected(InputFileChangeEventArgs e)
    {
        _selectedImportFile = e.File;
    }

    private void CancelEdit() => ResetForm();

    private async Task RemoveCache(RedisCacheEntry cache)
    {
        var config = Environment.RedisConfig;
        if (config is null) return;

        config.Caches.Remove(cache);
        if (config.ActiveCacheId == cache.Id)
            config.ActiveCacheId = config.Caches.FirstOrDefault()?.Id;

        if (EditingCacheId == cache.Id)
            ResetForm();

        await OnSaved.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ImportConnectionsAsync()
    {
        if (_selectedImportFile is null || _isImportingConnections)
            return;

        _isImportingConnections = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var stream = _selectedImportFile.OpenReadStream(maxAllowedSize: 8L * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var payload = await reader.ReadToEndAsync();
            var import = RedisConnectionImportParser.Parse(payload);
            var config = Environment.RedisConfig ??= new RedisConfig();
            config.EnsureMigrated();

            var existingByIdentity = config.Caches.ToDictionary(GetConnectionIdentity, StringComparer.OrdinalIgnoreCase);
            var added = 0;
            var updated = 0;

            foreach (var cache in import.Caches)
            {
                var identity = GetConnectionIdentity(cache.ConnectionString);
                if (existingByIdentity.TryGetValue(identity, out var existing))
                {
                    existing.DisplayName = cache.DisplayName;
                    existing.ConnectionString = cache.ConnectionString;
                    updated++;
                }
                else
                {
                    config.Caches.Add(cache);
                    existingByIdentity[identity] = cache;
                    added++;
                }
            }

            config.ActiveCacheId ??= config.Caches.FirstOrDefault()?.Id;
            if (!string.IsNullOrWhiteSpace(import.SuggestedSeparator))
                config.NamespaceSeparator = import.SuggestedSeparator;

            _selectedImportFile = null;
            await OnSaved.InvokeAsync();

            var importedCount = added + updated;
            var summary = $"Imported {importedCount} connection{(importedCount == 1 ? string.Empty : "s")} ({added} added, {updated} updated).";
            if (import.HasMixedSeparators)
                summary += $" Mixed separators found; using '{import.SuggestedSeparator}' globally.";
            if (import.Warnings.Count > 0)
                summary += $" {import.Warnings[0]}";

            SetStatus(summary, import.HasMixedSeparators || import.Warnings.Count > 0 ? "warning" : "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Import failed: {ex.Message}", "error");
        }
        finally
        {
            _isImportingConnections = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveAsync()
    {
        if (!Validate())
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        var config = Environment.RedisConfig ??= new RedisConfig();

        if (EditingCacheId is not null)
        {
            var existing = config.Caches.FirstOrDefault(c => c.Id == EditingCacheId);
            if (existing is not null)
            {
                existing.DisplayName = string.IsNullOrWhiteSpace(DisplayName) ? "Cache" : DisplayName.Trim();
                existing.ConnectionString = ConnectionString.Trim();
                existing.Database = Math.Clamp(Database, 0, 15);
            }
        }
        else
        {
            var entry = new RedisCacheEntry
            {
                DisplayName = string.IsNullOrWhiteSpace(DisplayName) ? "Cache" : DisplayName.Trim(),
                ConnectionString = ConnectionString.Trim(),
                Database = Math.Clamp(Database, 0, 15)
            };
            config.Caches.Add(entry);
            config.ActiveCacheId ??= entry.Id;
        }

        await OnSaved.InvokeAsync();
        ResetForm();
        SetStatus("Saved.", "success");
        await InvokeAsync(StateHasChanged);
    }

    private async Task TestConnectionAsync()
    {
        SetStatus("Testing connection…", "muted");

        try
        {
            using var client = await CreateClientAsync();
            var ok = await client.TestConnectionAsync();
            SetStatus(ok ? "Connection successful." : "Connection failed.", ok ? "success" : "error");
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, "error");
        }

        await InvokeAsync(StateHasChanged);
    }

    private void SetStatus(string message, string tone)
    {
        StatusMessage = message;
        StatusTone = tone;
    }

    private static string GetCachePrimaryLabel(RedisCacheEntry cache)
    {
        var displayName = cache.DisplayName?.Trim();
        var identity = GetConnectionIdentity(cache.ConnectionString);

        if (string.IsNullOrWhiteSpace(displayName))
            return identity;

        return displayName.Length <= identity.Length ? displayName : identity;
    }

    private static string? GetCacheSecondaryLabel(RedisCacheEntry cache)
    {
        var displayName = cache.DisplayName?.Trim();
        var identity = GetConnectionIdentity(cache.ConnectionString);
        var primary = GetCachePrimaryLabel(cache);

        if (string.IsNullOrWhiteSpace(displayName) || string.Equals(displayName, identity, StringComparison.OrdinalIgnoreCase))
            return null;

        return string.Equals(primary, identity, StringComparison.OrdinalIgnoreCase)
            ? displayName
            : identity;
    }

    private static string GetConnectionIdentity(RedisCacheEntry entry) => GetConnectionIdentity(entry.ConnectionString);

    private static string GetConnectionIdentity(string connectionString)
        => connectionString.Split(',', 2, StringSplitOptions.TrimEntries)[0].Trim();

    private async Task<IRedisClient> CreateClientAsync()
    {
        if (AppState.UseDemoData)
            return new DemoRedisClient(Database);

        if (string.IsNullOrWhiteSpace(ConnectionString))
            throw new InvalidOperationException("Provide a Redis connection string before testing.");

        return await SwebKit.Redis.RedisClient.CreateAsync(new RedisCacheEntry
        {
            DisplayName = DisplayName,
            ConnectionString = ConnectionString,
            Database = Database
        });
    }
}
