@using SwebKit.Azure.Storage

<div style="display:grid; gap:12px; padding:12px 0;">

    @* ── List of configured accounts ── *@
    @if (Environment.StorageAccounts.Count > 0)
    {
        <div style="font-size:12px; color:var(--color-text-muted); font-weight:600;">Configured Accounts</div>
        @foreach (var acc in Environment.StorageAccounts.ToList())
        {
            <div style="display:flex; align-items:center; gap:8px; padding:6px 8px; border:1px solid var(--color-border); border-radius:4px; background:var(--color-surface);">
                <span style="flex:1; font-size:12px; font-family:Consolas, monospace;">@acc.DisplayName</span>
                <span style="font-size:11px; color:var(--color-text-muted);">@(acc.UseAad ? "AAD" : "ConnStr") · @acc.AccountName</span>
                <FluentButton Appearance="Appearance.Lightweight" @onclick="() => EditAccount(acc)">Edit</FluentButton>
                <FluentButton Appearance="Appearance.Lightweight" @onclick="() => RemoveAccountAsync(acc)">Remove</FluentButton>
            </div>
        }
    }

    @* ── Add / Edit form ── *@
    <div style="font-size:12px; color:var(--color-text-muted); font-weight:600;">
        @(_editingId is not null ? "Edit Account" : "Add Account")
    </div>

    <div style="display:grid; gap:4px;">
        <label style="font-size:12px; color:var(--color-text-muted);">Display Name</label>
        <input type="text" @bind="_displayName" @bind:event="oninput"
               style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px;"
               placeholder="Production Storage" />
    </div>

    <div style="display:grid; gap:4px;">
        <label style="font-size:12px; color:var(--color-text-muted);">Account Name</label>
        <input type="text" @bind="_accountName" @bind:event="oninput"
               style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid @(_accountNameError is not null ? "var(--color-error)" : "var(--color-border)"); border-radius:4px;"
               placeholder="mystorageaccount" />
        @if (_accountNameError is not null)
        {
            <span style="font-size:11px; color:var(--color-error);">@_accountNameError</span>
        }
    </div>

    <div style="display:flex; align-items:center; gap:8px;">
        <input type="checkbox" id="storage-use-aad" @bind="_useAad" />
        <label for="storage-use-aad" style="font-size:12px; color:var(--color-text); cursor:pointer;">
            Use Azure AD (DefaultAzureCredential)
        </label>
    </div>

    @if (!_useAad)
    {
        <div style="display:grid; gap:4px;">
            <label style="font-size:12px; color:var(--color-text-muted);">Credential ref key (Windows Credential Manager)</label>
            <input type="text" @bind="_connectionStringRef" @bind:event="oninput"
                   style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid @(_connRefError is not null ? "var(--color-error)" : "var(--color-border)"); border-radius:4px;"
                   placeholder="storage-myaccount-connstr" />
            @if (_connRefError is not null)
            {
                <span style="font-size:11px; color:var(--color-error);">@_connRefError</span>
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_connectionStringRef))
    {
        <div style="padding:6px 10px; background:rgba(255,193,7,0.15); border:1px solid var(--color-border); border-radius:4px; font-size:12px; color:var(--color-text-muted);">
            ⚠ Connection String Ref is ignored when AAD is enabled.
        </div>
    }

    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
        <FluentButton Appearance="Appearance.Accent" Disabled="@(!CanSave)" @onclick="SaveAsync">
            @(_editingId is not null ? "Save Account" : "Add Account")
        </FluentButton>
        @if (_editingId is not null)
        {
            <FluentButton @onclick="CancelEdit">Cancel</FluentButton>
        }
        <FluentButton Appearance="Appearance.Lightweight" Disabled="@(_testing || !CanTest)" @onclick="TestConnectionAsync">
            @(_testing ? "Testing..." : "Test Connection")
        </FluentButton>
        @if (_connStatus is not null)
        {
            <span style="font-size:12px; color:@(_connOk ? "var(--color-success)" : "var(--color-error)");">@_connStatus</span>
        }
    </div>

</div>

@code {
    [Parameter, EditorRequired] public ProjectEnvironment Environment { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public ICredentialStore CredentialStore { get; set; } = default!;

    private string _displayName = string.Empty;
    private string _accountName = string.Empty;
    private string _connectionStringRef = string.Empty;
    private bool _useAad;
    private string? _editingId;
    private string? _accountNameError;
    private string? _connRefError;
    private string? _connStatus;
    private bool _connOk;
    private bool _testing;
    private Guid? _loadedEnvironmentId;

    private bool CanSave => !string.IsNullOrWhiteSpace(_displayName) && (_useAad
        ? !string.IsNullOrWhiteSpace(_accountName)
        : !string.IsNullOrWhiteSpace(_connectionStringRef));

    private bool CanTest => _useAad
        ? !string.IsNullOrWhiteSpace(_accountName)
        : !string.IsNullOrWhiteSpace(_connectionStringRef);

    protected override void OnParametersSet()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        _editingId = null;
        _displayName = string.Empty;
        _accountName = string.Empty;
        _connectionStringRef = string.Empty;
        _useAad = false;
        _accountNameError = null;
        _connRefError = null;
        _connStatus = null;
        _connOk = false;
    }

    private void EditAccount(StorageConfig acc)
    {
        _editingId = acc.Id;
        _displayName = acc.DisplayName;
        _accountName = acc.AccountName;
        _connectionStringRef = acc.ConnectionStringRef ?? string.Empty;
        _useAad = acc.UseAad;
        _accountNameError = null;
        _connRefError = null;
        _connStatus = null;
    }

    private void CancelEdit() => ResetForm();

    private async Task RemoveAccountAsync(StorageConfig acc)
    {
        Environment.StorageAccounts.Remove(acc);
        if (_editingId == acc.Id) ResetForm();
        await OnSaved.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task TestConnectionAsync()
    {
        _connStatus = null;
        _connOk = false;
        _testing = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var config = BuildConfig();
            var client = new AzureStorageClient(config, CredentialStore);
            _connOk = await client.TestConnectionAsync();
            _connStatus = _connOk ? "Connected." : "Connection failed.";
        }
        catch (Exception ex)
        {
            _connOk = false;
            _connStatus = ex.Message;
        }
        finally
        {
            _testing = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAsync()
    {
        _accountNameError = null;
        _connRefError = null;

        if (_useAad && string.IsNullOrWhiteSpace(_accountName))
        {
            _accountNameError = "Account Name is required for AAD authentication.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!_useAad && string.IsNullOrWhiteSpace(_connectionStringRef))
        {
            _connRefError = "Connection String Ref is required.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_editingId is not null)
        {
            var existing = Environment.StorageAccounts.FirstOrDefault(a => a.Id == _editingId);
            if (existing is not null)
            {
                existing.DisplayName = _displayName.Trim();
                existing.AccountName = _accountName.Trim();
                existing.ConnectionStringRef = string.IsNullOrWhiteSpace(_connectionStringRef) ? null : _connectionStringRef.Trim();
                existing.UseAad = _useAad;
            }
        }
        else
        {
            Environment.StorageAccounts.Add(BuildConfig());
        }

        ResetForm();
        await OnSaved.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private StorageConfig BuildConfig() => new StorageConfig
    {
        DisplayName = _displayName.Trim(),
        AccountName = _accountName.Trim(),
        ConnectionStringRef = string.IsNullOrWhiteSpace(_connectionStringRef) ? null : _connectionStringRef.Trim(),
        UseAad = _useAad
    };
}
