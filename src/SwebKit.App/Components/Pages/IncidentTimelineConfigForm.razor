@using System.Globalization

<div class="incident-timeline-config" data-testid="incident-timeline-config-form">
    <div class="incident-timeline-config__intro">
        <div class="incident-timeline-config__intro-copy">
            <p class="incident-timeline-config__eyebrow">Evidence mappings</p>
            <p class="incident-timeline-config__lead">
                Define which App Insights roles, Service Bus entities, and Azure DevOps pipelines belong to a workload.
                The incident page only loads non-AKS evidence when those mappings exist.
            </p>
            <p class="incident-timeline-config__hint">
                Sources marked Not configured still need their base Service Bus, DevOps, or Observability settings on the other tabs.
            </p>
        </div>

        <div class="incident-timeline-config__intro-actions">
            <button type="button"
                    class="incident-timeline-config__button"
                    data-testid="incident-mapping-add-button"
                    @onclick="AddMappingAsync">
                Add mapping
            </button>
        </div>
    </div>

    @if (HasSuggestedScope)
    {
        <div class="incident-timeline-config__suggestion" data-testid="incident-mapping-suggestion">
            <div>
                <div class="incident-timeline-config__suggestion-title">Current incident scope</div>
                <p class="incident-timeline-config__suggestion-body">@SuggestedScopeLabel</p>
            </div>

            @if (HasSuggestedMapping)
            {
                <span class="incident-timeline-config__suggestion-status">A matching mapping already exists below.</span>
            }
            else
            {
                <button type="button"
                        class="incident-timeline-config__button incident-timeline-config__button--secondary"
                        data-testid="incident-mapping-add-suggested"
                        @onclick="AddSuggestedMappingAsync">
                    Add mapping for current incident scope
                </button>
            }
        </div>
    }

    @if (Config.WorkloadMappings.Count == 0)
    {
        <div class="incident-timeline-config__empty">
            <strong>No workload mappings yet.</strong>
            <p>
                Add at least one mapping so Incident Timeline can explain which App Insights, Service Bus, and release evidence belongs to a workload.
            </p>
        </div>
    }
    else
    {
        <div class="incident-timeline-config__cards">
            @for (var mappingIndex = 0; mappingIndex < Config.WorkloadMappings.Count; mappingIndex++)
            {
                var mapping = Config.WorkloadMappings[mappingIndex];

                <section class="incident-timeline-config__card @(IsSuggestedMatch(mapping) ? "incident-timeline-config__card--suggested" : null)"
                         data-testid="@($"incident-mapping-card-{mappingIndex}")">
                    <header class="incident-timeline-config__card-header">
                        <div>
                            <h4>@GetMappingTitle(mapping, mappingIndex)</h4>
                            <p>@GetMappingScopeLabel(mapping)</p>
                            @if (IsSuggestedMatch(mapping))
                            {
                                <span class="incident-timeline-config__scope-chip">Current incident scope</span>
                            }
                        </div>

                        <button type="button"
                                class="incident-timeline-config__button incident-timeline-config__button--danger"
                                @onclick="() => RemoveMappingAsync(mapping)">
                            Remove
                        </button>
                    </header>

                    <div class="incident-timeline-config__field-grid">
                        <label class="incident-timeline-config__field">
                            <span>Namespace</span>
                            <input class="incident-timeline-config__input"
                                   @bind="mapping.Namespace"
                                   @bind:event="oninput"
                                   @bind:after="NotifyChangedAsync"
                                   placeholder="prd-phonotif" />
                        </label>

                        <label class="incident-timeline-config__field">
                            <span>Workload kind</span>
                            <select class="incident-timeline-config__input"
                                    @bind="mapping.WorkloadKind"
                                    @bind:after="NotifyChangedAsync">
                                @foreach (var kind in _workloadKinds)
                                {
                                    <option value="@kind">@kind</option>
                                }
                            </select>
                        </label>

                        <label class="incident-timeline-config__field">
                            <span>Workload name</span>
                            <input class="incident-timeline-config__input"
                                   @bind="mapping.WorkloadName"
                                   @bind:event="oninput"
                                   @bind:after="NotifyChangedAsync"
                                   placeholder="phonotif-api" />
                        </label>

                        <label class="incident-timeline-config__field">
                            <span>Display name</span>
                            <input class="incident-timeline-config__input"
                                   @bind="mapping.DisplayName"
                                   @bind:event="oninput"
                                   @bind:after="NotifyChangedAsync"
                                   placeholder="Phonotif API" />
                        </label>
                    </div>

                    <section class="incident-timeline-config__section">
                        <div class="incident-timeline-config__section-header">
                            <div>
                                <h5>App Insights mapping</h5>
                                <p>Map the resource, cloud role names, and operation names that belong to this workload.</p>
                            </div>

                            @if (mapping.Observability is null)
                            {
                                <button type="button"
                                        class="incident-timeline-config__button incident-timeline-config__button--secondary"
                                        @onclick="() => EnableObservabilityAsync(mapping)">
                                    Add App Insights mapping
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="incident-timeline-config__button incident-timeline-config__button--secondary"
                                        @onclick="() => ClearObservabilityAsync(mapping)">
                                    Clear section
                                </button>
                            }
                        </div>

                        @if (mapping.Observability is null)
                        {
                            <div class="incident-timeline-config__section-empty">No App Insights mapping configured for this workload.</div>
                        }
                        else
                        {
                            <div class="incident-timeline-config__section-body">
                                <label class="incident-timeline-config__field incident-timeline-config__field--full">
                                    <span>Resource ID</span>
                                    <input class="incident-timeline-config__input"
                                           @bind="mapping.Observability.ResourceId"
                                           @bind:event="oninput"
                                           @bind:after="NotifyChangedAsync"
                                           placeholder="/subscriptions/.../providers/microsoft.insights/components/phonotif-ai" />
                                </label>

                                <div class="incident-timeline-config__list-group">
                                    <div class="incident-timeline-config__list-header">
                                        <span>Cloud role names</span>
                                        <button type="button"
                                                class="incident-timeline-config__button incident-timeline-config__button--secondary"
                                                @onclick="() => AddStringItemAsync(mapping.Observability.CloudRoleNames)">
                                            Add role
                                        </button>
                                    </div>

                                    @if (mapping.Observability.CloudRoleNames.Count == 0)
                                    {
                                        <div class="incident-timeline-config__list-empty">No cloud role names configured yet.</div>
                                    }
                                    else
                                    {
                                        @for (var roleIndex = 0; roleIndex < mapping.Observability.CloudRoleNames.Count; roleIndex++)
                                        {
                                            var currentRoleIndex = roleIndex;
                                            <div class="incident-timeline-config__list-row">
                                                <input class="incident-timeline-config__input"
                                                       @bind="mapping.Observability.CloudRoleNames[currentRoleIndex]"
                                                       @bind:event="oninput"
                                                       @bind:after="NotifyChangedAsync"
                                                       placeholder="phonotif-api" />
                                                <button type="button"
                                                        class="incident-timeline-config__button incident-timeline-config__button--danger"
                                                        @onclick="() => RemoveStringItemAsync(mapping.Observability.CloudRoleNames, currentRoleIndex)">
                                                    Remove
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>

                                <div class="incident-timeline-config__list-group">
                                    <div class="incident-timeline-config__list-header">
                                        <span>Operation names</span>
                                        <button type="button"
                                                class="incident-timeline-config__button incident-timeline-config__button--secondary"
                                                @onclick="() => AddStringItemAsync(mapping.Observability.OperationNames)">
                                            Add operation
                                        </button>
                                    </div>

                                    @if (mapping.Observability.OperationNames.Count == 0)
                                    {
                                        <div class="incident-timeline-config__list-empty">No operation names configured yet.</div>
                                    }
                                    else
                                    {
                                        @for (var operationIndex = 0; operationIndex < mapping.Observability.OperationNames.Count; operationIndex++)
                                        {
                                            var currentOperationIndex = operationIndex;
                                            <div class="incident-timeline-config__list-row">
                                                <input class="incident-timeline-config__input"
                                                       @bind="mapping.Observability.OperationNames[currentOperationIndex]"
                                                       @bind:event="oninput"
                                                       @bind:after="NotifyChangedAsync"
                                                       placeholder="POST /notifications" />
                                                <button type="button"
                                                        class="incident-timeline-config__button incident-timeline-config__button--danger"
                                                        @onclick="() => RemoveStringItemAsync(mapping.Observability.OperationNames, currentOperationIndex)">
                                                    Remove
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </section>

                    <section class="incident-timeline-config__section">
                        <div class="incident-timeline-config__section-header">
                            <div>
                                <h5>Service Bus mappings</h5>
                                <p>Map the namespace and entity paths that represent this workload's queues, topics, or subscriptions.</p>
                            </div>

                            <button type="button"
                                    class="incident-timeline-config__button incident-timeline-config__button--secondary"
                                    @onclick="() => AddServiceBusEntityAsync(mapping)">
                                Add Service Bus entity
                            </button>
                        </div>

                        @if (mapping.ServiceBusEntities.Count == 0)
                        {
                            <div class="incident-timeline-config__section-empty">No Service Bus entities configured for this workload.</div>
                        }
                        else
                        {
                            <div class="incident-timeline-config__stack">
                                @for (var entityIndex = 0; entityIndex < mapping.ServiceBusEntities.Count; entityIndex++)
                                {
                                    var entity = mapping.ServiceBusEntities[entityIndex];
                                    <div class="incident-timeline-config__compound-card">
                                        <div class="incident-timeline-config__compound-grid">
                                            <label class="incident-timeline-config__field">
                                                <span>Namespace ID</span>
                                                <input class="incident-timeline-config__input"
                                                       type="text"
                                                       value="@FormatGuid(entity.NamespaceId)"
                                                       placeholder="00000000-0000-0000-0000-000000000000"
                                                       @onchange="args => UpdateNamespaceIdAsync(entity, args)" />
                                            </label>

                                            <label class="incident-timeline-config__field">
                                                <span>Entity path</span>
                                                <input class="incident-timeline-config__input"
                                                       @bind="entity.EntityPath"
                                                       @bind:event="oninput"
                                                       @bind:after="NotifyChangedAsync"
                                                       placeholder="orders/deadletter" />
                                            </label>

                                            <label class="incident-timeline-config__field">
                                                <span>Alias</span>
                                                <input class="incident-timeline-config__input"
                                                       @bind="entity.Alias"
                                                       @bind:event="oninput"
                                                       @bind:after="NotifyChangedAsync"
                                                       placeholder="Order DLQ" />
                                            </label>
                                        </div>

                                        <button type="button"
                                                class="incident-timeline-config__button incident-timeline-config__button--danger"
                                                @onclick="() => RemoveServiceBusEntityAsync(mapping, entity)">
                                            Remove entity
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <section class="incident-timeline-config__section">
                        <div class="incident-timeline-config__section-header">
                            <div>
                                <h5>Azure DevOps mappings</h5>
                                <p>Map the pipeline bindings and deployment environments that should show up as contextual release evidence.</p>
                            </div>

                            @if (mapping.DevOps is null)
                            {
                                <button type="button"
                                        class="incident-timeline-config__button incident-timeline-config__button--secondary"
                                        @onclick="() => EnableDevOpsAsync(mapping)">
                                    Add Azure DevOps mapping
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="incident-timeline-config__button incident-timeline-config__button--secondary"
                                        @onclick="() => ClearDevOpsAsync(mapping)">
                                    Clear section
                                </button>
                            }
                        </div>

                        @if (mapping.DevOps is null)
                        {
                            <div class="incident-timeline-config__section-empty">No Azure DevOps mapping configured for this workload.</div>
                        }
                        else
                        {
                            <div class="incident-timeline-config__section-body">
                                <div class="incident-timeline-config__list-group">
                                    <div class="incident-timeline-config__list-header">
                                        <span>Pipeline bindings</span>
                                        <button type="button"
                                                class="incident-timeline-config__button incident-timeline-config__button--secondary"
                                                @onclick="() => AddPipelineAsync(mapping.DevOps)">
                                            Add pipeline
                                        </button>
                                    </div>

                                    @if (mapping.DevOps.Pipelines.Count == 0)
                                    {
                                        <div class="incident-timeline-config__list-empty">No pipelines configured yet.</div>
                                    }
                                    else
                                    {
                                        @for (var pipelineIndex = 0; pipelineIndex < mapping.DevOps.Pipelines.Count; pipelineIndex++)
                                        {
                                            var pipeline = mapping.DevOps.Pipelines[pipelineIndex];
                                            <div class="incident-timeline-config__compound-card">
                                                <div class="incident-timeline-config__compound-grid">
                                                    <label class="incident-timeline-config__field">
                                                        <span>Project name</span>
                                                        <input class="incident-timeline-config__input"
                                                               @bind="pipeline.ProjectName"
                                                               @bind:event="oninput"
                                                               @bind:after="NotifyChangedAsync"
                                                               placeholder="platform-services" />
                                                    </label>

                                                    <label class="incident-timeline-config__field">
                                                        <span>Pipeline ID</span>
                                                        <input class="incident-timeline-config__input"
                                                               type="number"
                                                               min="1"
                                                               value="@FormatPipelineId(pipeline.PipelineId)"
                                                               placeholder="101"
                                                               @onchange="args => UpdatePipelineIdAsync(pipeline, args)" />
                                                    </label>

                                                    <label class="incident-timeline-config__field">
                                                        <span>Alias</span>
                                                        <input class="incident-timeline-config__input"
                                                               @bind="pipeline.Alias"
                                                               @bind:event="oninput"
                                                               @bind:after="NotifyChangedAsync"
                                                               placeholder="phonotif-api-ci-cd" />
                                                    </label>
                                                </div>

                                                <button type="button"
                                                        class="incident-timeline-config__button incident-timeline-config__button--danger"
                                                        @onclick="() => RemovePipelineAsync(mapping.DevOps, pipeline)">
                                                    Remove pipeline
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>

                                <div class="incident-timeline-config__list-group">
                                    <div class="incident-timeline-config__list-header">
                                        <span>Environment names</span>
                                        <button type="button"
                                                class="incident-timeline-config__button incident-timeline-config__button--secondary"
                                                @onclick="() => AddStringItemAsync(mapping.DevOps.EnvironmentNames)">
                                            Add environment
                                        </button>
                                    </div>

                                    @if (mapping.DevOps.EnvironmentNames.Count == 0)
                                    {
                                        <div class="incident-timeline-config__list-empty">No environment filters configured yet.</div>
                                    }
                                    else
                                    {
                                        @for (var environmentIndex = 0; environmentIndex < mapping.DevOps.EnvironmentNames.Count; environmentIndex++)
                                        {
                                            var currentEnvironmentIndex = environmentIndex;
                                            <div class="incident-timeline-config__list-row">
                                                <input class="incident-timeline-config__input"
                                                       @bind="mapping.DevOps.EnvironmentNames[currentEnvironmentIndex]"
                                                       @bind:event="oninput"
                                                       @bind:after="NotifyChangedAsync"
                                                       placeholder="Production" />
                                                <button type="button"
                                                        class="incident-timeline-config__button incident-timeline-config__button--danger"
                                                        @onclick="() => RemoveStringItemAsync(mapping.DevOps.EnvironmentNames, currentEnvironmentIndex)">
                                                    Remove
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </section>
                </section>
            }
        </div>
    }

    <div class="incident-timeline-config__footer">
        <FluentButton Appearance="Appearance.Accent"
                      data-testid="incident-mapping-save-button"
                      @onclick="SaveAsync">
            Save Incident Timeline mappings
        </FluentButton>
    </div>
</div>

@code {
    private static readonly IncidentWorkloadKind[] _workloadKinds =
    [
        IncidentWorkloadKind.Deployment,
        IncidentWorkloadKind.StatefulSet,
        IncidentWorkloadKind.Pod,
        IncidentWorkloadKind.DaemonSet,
    ];

    [Parameter, EditorRequired] public AppConfig Environment { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public string? SuggestedNamespace { get; set; }
    [Parameter] public string? SuggestedWorkloadKind { get; set; }
    [Parameter] public string? SuggestedWorkloadName { get; set; }

    private IncidentTimelineConfig Config => Environment.IncidentTimeline;

    private bool HasSuggestedScope => TryGetSuggestedScope(out _);

    private bool HasSuggestedMapping => Config.WorkloadMappings.Any(IsSuggestedMatch);

    private string SuggestedScopeLabel => TryGetSuggestedScope(out var suggestedKind)
        ? $"{SuggestedNamespace} / {suggestedKind} / {SuggestedWorkloadName}"
        : string.Empty;

    private async Task AddMappingAsync()
    {
        Config.WorkloadMappings.Insert(0, new IncidentTimelineWorkloadMapping());
        await NotifyChangedAsync();
    }

    private async Task AddSuggestedMappingAsync()
    {
        if (!TryGetSuggestedScope(out var suggestedKind) || HasSuggestedMapping)
        {
            return;
        }

        Config.WorkloadMappings.Insert(0, new IncidentTimelineWorkloadMapping
        {
            Namespace = SuggestedNamespace!.Trim(),
            WorkloadKind = suggestedKind,
            WorkloadName = SuggestedWorkloadName!.Trim(),
            DisplayName = SuggestedWorkloadName!.Trim(),
        });

        await NotifyChangedAsync();
    }

    private async Task RemoveMappingAsync(IncidentTimelineWorkloadMapping mapping)
    {
        Config.WorkloadMappings.Remove(mapping);
        await NotifyChangedAsync();
    }

    private async Task EnableObservabilityAsync(IncidentTimelineWorkloadMapping mapping)
    {
        mapping.Observability = new IncidentTimelineObservabilityMapping();
        await NotifyChangedAsync();
    }

    private async Task ClearObservabilityAsync(IncidentTimelineWorkloadMapping mapping)
    {
        mapping.Observability = null;
        await NotifyChangedAsync();
    }

    private async Task AddServiceBusEntityAsync(IncidentTimelineWorkloadMapping mapping)
    {
        mapping.ServiceBusEntities.Add(new SbEntityLink());
        await NotifyChangedAsync();
    }

    private async Task RemoveServiceBusEntityAsync(IncidentTimelineWorkloadMapping mapping, SbEntityLink entity)
    {
        mapping.ServiceBusEntities.Remove(entity);
        await NotifyChangedAsync();
    }

    private async Task EnableDevOpsAsync(IncidentTimelineWorkloadMapping mapping)
    {
        mapping.DevOps = new IncidentTimelineDevOpsMapping();
        await NotifyChangedAsync();
    }

    private async Task ClearDevOpsAsync(IncidentTimelineWorkloadMapping mapping)
    {
        mapping.DevOps = null;
        await NotifyChangedAsync();
    }

    private async Task AddPipelineAsync(IncidentTimelineDevOpsMapping mapping)
    {
        mapping.Pipelines.Add(new IncidentTimelinePipelineBinding());
        await NotifyChangedAsync();
    }

    private async Task RemovePipelineAsync(IncidentTimelineDevOpsMapping mapping, IncidentTimelinePipelineBinding pipeline)
    {
        mapping.Pipelines.Remove(pipeline);
        await NotifyChangedAsync();
    }

    private async Task AddStringItemAsync(List<string> values)
    {
        values.Add(string.Empty);
        await NotifyChangedAsync();
    }

    private async Task RemoveStringItemAsync(List<string> values, int index)
    {
        if (index < 0 || index >= values.Count)
        {
            return;
        }

        values.RemoveAt(index);
        await NotifyChangedAsync();
    }

    private async Task UpdateNamespaceIdAsync(SbEntityLink entity, ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        entity.NamespaceId = Guid.TryParse(raw, out var namespaceId) ? namespaceId : Guid.Empty;
        await NotifyChangedAsync();
    }

    private async Task UpdatePipelineIdAsync(IncidentTimelinePipelineBinding pipeline, ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        pipeline.PipelineId = int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var pipelineId)
            ? Math.Max(0, pipelineId)
            : 0;
        await NotifyChangedAsync();
    }

    private async Task SaveAsync()
    {
        SanitizeMappings();
        await OnSaved.InvokeAsync();
    }

    private Task NotifyChangedAsync() => OnChanged.HasDelegate
        ? OnChanged.InvokeAsync()
        : Task.CompletedTask;

    private void SanitizeMappings()
    {
        Config.WorkloadMappings = Config.WorkloadMappings
            .Select(SanitizeMapping)
            .Where(static mapping => !string.IsNullOrWhiteSpace(mapping.Namespace) || !string.IsNullOrWhiteSpace(mapping.WorkloadName) || !string.IsNullOrWhiteSpace(mapping.DisplayName))
            .ToList();
    }

    private static IncidentTimelineWorkloadMapping SanitizeMapping(IncidentTimelineWorkloadMapping mapping)
    {
        mapping.Namespace = mapping.Namespace.Trim();
        mapping.WorkloadName = mapping.WorkloadName.Trim();
        mapping.DisplayName = NormalizeOptional(mapping.DisplayName);

        if (mapping.Observability is not null)
        {
            mapping.Observability.ResourceId = NormalizeOptional(mapping.Observability.ResourceId);
            mapping.Observability.CloudRoleNames = NormalizeStringList(mapping.Observability.CloudRoleNames);
            mapping.Observability.OperationNames = NormalizeStringList(mapping.Observability.OperationNames);

            if (string.IsNullOrWhiteSpace(mapping.Observability.ResourceId)
                && mapping.Observability.CloudRoleNames.Count == 0
                && mapping.Observability.OperationNames.Count == 0)
            {
                mapping.Observability = null;
            }
        }

        mapping.ServiceBusEntities = mapping.ServiceBusEntities
            .Select(static entity => new SbEntityLink
            {
                NamespaceId = entity.NamespaceId,
                EntityPath = entity.EntityPath.Trim(),
                Alias = NormalizeOptional(entity.Alias),
            })
            .Where(static entity => entity.NamespaceId != Guid.Empty
                || !string.IsNullOrWhiteSpace(entity.EntityPath)
                || !string.IsNullOrWhiteSpace(entity.Alias))
            .ToList();

        if (mapping.DevOps is not null)
        {
            mapping.DevOps.Pipelines = mapping.DevOps.Pipelines
                .Select(static pipeline => new IncidentTimelinePipelineBinding
                {
                    ProjectName = pipeline.ProjectName.Trim(),
                    PipelineId = pipeline.PipelineId,
                    Alias = NormalizeOptional(pipeline.Alias),
                })
                .Where(static pipeline => !string.IsNullOrWhiteSpace(pipeline.ProjectName)
                    || pipeline.PipelineId > 0
                    || !string.IsNullOrWhiteSpace(pipeline.Alias))
                .ToList();
            mapping.DevOps.EnvironmentNames = NormalizeStringList(mapping.DevOps.EnvironmentNames);

            if (mapping.DevOps.Pipelines.Count == 0 && mapping.DevOps.EnvironmentNames.Count == 0)
            {
                mapping.DevOps = null;
            }
        }

        return mapping;
    }

    private static List<string> NormalizeStringList(List<string> values) => values
        .Select(static value => value.Trim())
        .Where(static value => !string.IsNullOrWhiteSpace(value))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private static string? NormalizeOptional(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return value.Trim();
    }

    private string GetMappingTitle(IncidentTimelineWorkloadMapping mapping, int index) => !string.IsNullOrWhiteSpace(mapping.DisplayName)
        ? mapping.DisplayName
        : !string.IsNullOrWhiteSpace(mapping.WorkloadName)
            ? mapping.WorkloadName
            : $"Mapping {index + 1}";

    private static string GetMappingScopeLabel(IncidentTimelineWorkloadMapping mapping)
    {
        var namespaceLabel = string.IsNullOrWhiteSpace(mapping.Namespace) ? "Namespace not set" : mapping.Namespace;
        var workloadLabel = string.IsNullOrWhiteSpace(mapping.WorkloadName) ? "Workload not set" : mapping.WorkloadName;
        return $"{namespaceLabel} / {mapping.WorkloadKind} / {workloadLabel}";
    }

    private bool IsSuggestedMatch(IncidentTimelineWorkloadMapping mapping)
    {
        if (!TryGetSuggestedScope(out var suggestedKind))
        {
            return false;
        }

        return string.Equals(mapping.Namespace, SuggestedNamespace, StringComparison.OrdinalIgnoreCase)
            && mapping.WorkloadKind == suggestedKind
            && string.Equals(mapping.WorkloadName, SuggestedWorkloadName, StringComparison.OrdinalIgnoreCase);
    }

    private bool TryGetSuggestedScope(out IncidentWorkloadKind suggestedKind)
    {
        suggestedKind = IncidentWorkloadKind.Deployment;

        return !string.IsNullOrWhiteSpace(SuggestedNamespace)
            && !string.IsNullOrWhiteSpace(SuggestedWorkloadName)
            && Enum.TryParse<IncidentWorkloadKind>(SuggestedWorkloadKind, ignoreCase: true, out suggestedKind);
    }

    private static string FormatGuid(Guid value) => value == Guid.Empty ? string.Empty : value.ToString();

    private static string FormatPipelineId(int value) => value > 0 ? value.ToString(CultureInfo.InvariantCulture) : string.Empty;
}