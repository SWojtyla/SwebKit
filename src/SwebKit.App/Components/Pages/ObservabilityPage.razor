@page "/observability"
@using SwebKit.Core.Abstractions
@using SwebKit.Core.Domain
@using SwebKit.Core.Models
@using SwebKit.Core.Services
@using SwebKit.App.Components.Observability
@using SwebKit.App.Services
@inject AppStateService AppState
@inject IConnectionStateService ConnectionState
@inject IObservabilityResourceDiscovery RealDiscovery
@inject IObservabilityProviderFactory ProviderFactory
@inject IObservabilityExplainerService ExplainerService
@inject INotificationService Notifications
@inject CommandRegistry Commands
@inject ISelectionContext Selection
@inject IJSRuntime JS
@inject IAppEventBus Events
@inject OperatorWorkspaceService Workspaces
@inject IncidentInvestigationLauncher InvestigationLauncher
@inject ReleaseRepository ReleaseRepo
@implements IDisposable

<div class="obs-page">
    <div class="page-shell-header">
        <RoutePageHeader Area="observability"
                         Subtitle="Inspect overview, failures, performance, logs, and availability for Application Insights resources.">
            <Meta>
                @if (_selectedResource is not null)
                {
                    <span class="shell-pill shell-pill--muted">@_selectedResource.Name</span>
                }
                @if (_provider is not null)
                {
                    <span class="shell-pill shell-pill--accent">@_provider.ProviderType</span>
                }
                @if (_autoRefreshEnabled)
                {
                    <span class="shell-pill shell-pill--muted">Auto refresh every @_autoRefreshSeconds seconds</span>
                }
                @if (AppState.UseDemoData)
                {
                    <span class="shell-pill shell-pill--warning">Demo mode</span>
                }
            </Meta>
            <Actions>
                <button class="page-header-action-btn" disabled="@(_provider is null)"
                        @onclick="LaunchInvestigationFromObservability">Investigate</button>
            </Actions>
        </RoutePageHeader>
    </div>

    <!-- Top toolbar: resource selector + time range + refresh -->
    <PageToolbar>
        <LeadingContent>
            <div class="obs-resource-selector">
                <FluentButton @onclick="ToggleResourceSelector" IconStart="@(new Icons.Regular.Size16.DataTrending())"
                              title="Select Application Insights resource">
                    @(_selectedResource?.Name ?? "Select resource…")
                </FluentButton>

                @if (_resourceSelectorOpen)
                {
                    <div class="obs-resource-flyout">
                        <ResourceSelectorDialog SelectedResourceId="@_selectedResource?.ResourceId"
                                                Discovery="@CurrentDiscovery" OnSelected="OnResourceSelectedAsync" />
                    </div>
                }
            </div>
        </LeadingContent>
        <CenterContent>
            <TimeRangePicker Value="_range" ValueChanged="OnRangeChangedAsync" />
        </CenterContent>

        <TrailingContent>
            <FluentButton @onclick="RefreshAsync" title="Refresh (F5)" Disabled="@(_provider is null)"
                          IconStart="@(new Icons.Regular.Size16.ArrowClockwise())">
                Refresh
            </FluentButton>

            @* OBS-7: Auto-refresh toggle *@
            <div class="obs-auto-refresh">
                <FluentButton Appearance="@(_autoRefreshEnabled? Appearance.Accent: Appearance.Lightweight)"
                              @onclick="ToggleAutoRefresh" title="Toggle auto-refresh">
                    @(_autoRefreshEnabled ? "⏸ Auto" : "▶ Auto")
                </FluentButton>
                @if (_autoRefreshEnabled)
                {
                    <select class="obs-auto-refresh-interval" @onchange="OnAutoRefreshIntervalChanged">
                        <option value="60" selected="@(_autoRefreshSeconds == 60)">1 min</option>
                        <option value="120" selected="@(_autoRefreshSeconds == 120)">2 min</option>
                        <option value="300" selected="@(_autoRefreshSeconds == 300)">5 min</option>
                    </select>
                }
                @if (_lastRefreshedAt is not null)
                {
                    <span class="obs-last-updated">Last: @_lastRefreshedAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
                }
            </div>

            @if (AppState.UseDemoData)
            {
                <span class="obs-demo-badge">DEMO</span>
            }
            else if (_provider is not null)
            {
                <span class="obs-provider-badge">@_provider.ProviderType</span>
            }
        </TrailingContent>
    </PageToolbar>

    @if (_provider is null)
    {
        <div class="obs-empty-state-wrap">
            <EmptyState Icon="📊" Title="No resource selected"
                        Subtitle="@(AppState.UseDemoData
                                                                                                                                                                                            ? "Pick a demo Application Insights resource to explore the observability workspace."
                                                                                                                                                                                            : "Scan your subscriptions and choose an Application Insights resource to start querying telemetry.")">
                <Actions>
                    <button type="button" @onclick="ToggleResourceSelector">Select resource</button>
                    @if (!AppState.UseDemoData)
                    {
                        <a href="/settings?section=observability">Review observability settings</a>
                    }
                </Actions>
            </EmptyState>
        </div>
    }
    else
    {
        <!-- Explainer summary -->
        <ObservabilityExplainerSummary Summary="_explainerSummary" OnInvestigate="LaunchInvestigationFromObservability" />

        @if (_explainerSummary is not null)
        {
            <DependencyHealthPanel Summary="_explainerSummary.DependencyHealth" />
            @foreach (var pivot in _explainerSummary.DimensionPivots)
            {
                <DimensionPivotPanel Breakdown="pivot" />
            }
        }

        <!-- Wave 2: Deployment comparison -->
        <DeploymentComparisonPanel Summary="_deploymentComparison"
                                    AvailableAnchors="_anchors"
                                    OnAnchorSelected="OnAnchorSelectedAsync" />

        <!-- Wave 3: SLO status -->
        <SloStatusPanel Summary="_sloStatus"
                        HasDefinitions="@(CurrentConfig?.SloDefinitions.Count > 0)" />

        <!-- Tab bar -->
        <div class="obs-tabs">
            <button class="obs-tab @(_tab == Tab.Overview ? "active" : "")"
                    @onclick="() => SetTab(Tab.Overview)">Overview</button>
            <button class="obs-tab @(_tab == Tab.Failures ? "active" : "")"
                    @onclick="() => SetTab(Tab.Failures)">Failures</button>
            <button class="obs-tab @(_tab == Tab.Performance ? "active" : "")"
                    @onclick="() => SetTab(Tab.Performance)">Performance</button>
            <button class="obs-tab @(_tab == Tab.Logs ? "active" : "")" data-testid="obs-tab-logs"
                    @onclick="() => SetTab(Tab.Logs)">Logs</button>
            <button class="obs-tab @(_tab == Tab.Availability ? "active" : "")"
                    @onclick="() => SetTab(Tab.Availability)">Availability</button>
        </div>

        <!-- Tab content -->
        <div class="obs-tab-content @GetTabContentClass()">
            @switch (_tab)
            {
                case Tab.Overview:
                    <ObservabilityOverview @ref="_overviewRef" Provider="_provider" Range="_range" Config="CurrentConfig" />
                    break;
                case Tab.Failures:
                    <ObservabilityFailures @ref="_failuresRef" Provider="_provider" Range="_range"
                                           ResourceId="@_selectedResource?.ResourceId" TzOffsetMinutes="_tzOffsetMinutes"
                                           OnDrillToLogs="DrillToLogsAsync" />
                    break;
                case Tab.Performance:
                    <ObservabilityPerformance @ref="_perfRef" Provider="_provider" Range="_range" Config="CurrentConfig" />
                    break;
                case Tab.Logs:
                    <ObservabilityLogs @ref="_logsRef" Provider="_provider" Range="_range"
                                       MaxRows="@(CurrentConfig?.MaxRowsPerQuery ?? 500)" SavedQueries="@(CurrentConfig?.SavedQueries ?? [])"
                                       SavedQueriesChanged="OnSavedQueriesChangedAsync" PendingQuery="@_pendingLogsQuery"
                                       PendingQueryVersion="@_pendingLogsQueryVersion" PendingQueryHandled="OnPendingLogsQueryHandledAsync"
                                       Mode="@(CurrentConfig?.LogsQueryMode ?? GuidedLogsQueryMode.Advanced)" ModeChanged="OnLogsModeChangedAsync"
                                       GuidedDraft="CurrentConfig?.GuidedLogsDraft" GuidedDraftChanged="OnGuidedDraftChangedAsync" />
                    break;
                case Tab.Availability:
                    <ObservabilityAvailability @ref="_availRef" Provider="_provider" Range="_range"
                                               TzOffsetMinutes="_tzOffsetMinutes" />
                    break;
            }
        </div>
    }
</div>

@* Click-outside to close resource selector *@
@if (_resourceSelectorOpen)
{
    <div class="obs-backdrop" @onclick="() => _resourceSelectorOpen = false"></div>
}

@code {
    private enum Tab { Overview, Failures, Performance, Logs, Availability }

    private Tab _tab = Tab.Overview;
    private TimeRange _range = TimeRange.Last24Hours;
    private IObservabilityProvider? _provider;
    private ObservabilityResourceInfo? _selectedResource;
    private bool _resourceSelectorOpen;
    private CancellationTokenSource _cts = new();
    private CancellationTokenSource _explainerCts = new();
    private CancellationTokenSource _comparisonCts = new();
    private SwebKit.Core.Models.ObservabilityExplainerSummary? _explainerSummary;
    private IReadOnlyList<DeploymentAnchor> _anchors = [];
    private DeploymentComparisonSummary? _deploymentComparison;
    private SloStatusSummary? _sloStatus;

    // Auto-refresh (OBS-7)
    private bool _autoRefreshEnabled;
    private int _autoRefreshSeconds = 60;
    private PeriodicTimer? _autoRefreshTimer;
    private CancellationTokenSource? _autoRefreshCts;
    private DateTimeOffset? _lastRefreshedAt;

    // Timezone offset (OBS-8) — minutes ahead of UTC
    private int _tzOffsetMinutes;

    // Component refs for targeted refresh
    private ObservabilityOverview? _overviewRef;
    private ObservabilityFailures? _failuresRef;
    private ObservabilityPerformance? _perfRef;
    private ObservabilityLogs? _logsRef;
    private ObservabilityAvailability? _availRef;
    private string? _pendingLogsQuery;
    private int _pendingLogsQueryVersion;

    private ObservabilityConfig? CurrentConfig => AppState.Config.ObservabilityConfig;

    private IObservabilityResourceDiscovery CurrentDiscovery =>
        AppState.UseDemoData
            ? new DemoObservabilityResourceDiscovery()
            : RealDiscovery;

    protected override async Task OnInitializedAsync()
    {
        AppState.DemoModeChanged += OnDemoModeChanged;
        Events.Subscribe<RefreshRequestedEvent>(OnRefreshRequested);
        RegisterObsCommands();
        Workspaces.RegisterRestoreHandler("observability", RestoreWorkspaceAsync);
        await TryRestoreLastResourceAsync();
        await Workspaces.ApplyPendingRestoreAsync("observability");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _tzOffsetMinutes = await JS.InvokeAsync<int>("SwebKit.getBrowserTimezoneOffset");
            await InvokeAsync(StateHasChanged);
        }

    }

    private void RegisterObsCommands()
    {
        Commands.Register(new AppCommand
        {
            Id = "obs-refresh",
            Label = "Refresh",
            Category = "Observability",
            AreaScope = "observability",
            IsAvailable = () => _provider is not null,
            Execute = () => RefreshAsync()
        });
        Commands.Register(new AppCommand
        {
            Id = "obs-run-query",
            Label = "Run Query",
            Category = "Observability",
            AreaScope = "observability",
            IsAvailable = () => _tab == Tab.Logs && _provider is not null,
            Execute = () => _logsRef is not null ? _logsRef.LoadQueryAsync(string.Empty) : Task.CompletedTask
        });
        Commands.Register(new AppCommand
        {
            Id = "obs-show-logs",
            Label = "Switch to Logs",
            Category = "Observability",
            AreaScope = "observability",
            Execute = () => { SetTab(Tab.Logs); return Task.CompletedTask; }
        });
        Commands.Register(new AppCommand
        {
            Id = "obs-show-failures",
            Label = "Switch to Failures",
            Category = "Observability",
            AreaScope = "observability",
            Execute = () => { SetTab(Tab.Failures); return Task.CompletedTask; }
        });
        Commands.Register(new AppCommand
        {
            Id = "obs-show-overview",
            Label = "Switch to Overview",
            Category = "Observability",
            AreaScope = "observability",
            Execute = () => { SetTab(Tab.Overview); return Task.CompletedTask; }
        });
    }

    private async Task TryRestoreLastResourceAsync()
    {
        var config = CurrentConfig;
        if (config?.SelectedResourceId is null || config.SelectedResourceName is null)
        {
            // In demo mode, auto-select the first demo resource for a better first-run experience
            if (AppState.UseDemoData)
            {
                await foreach (var r in CurrentDiscovery.DiscoverResourcesAsync(_cts.Token))
                {
                    await ActivateResourceAsync(r, persist: false);
                    break;
                }
            }
            return;
        }

        // Restore previously selected resource from config (fast path — no scan needed)
        var restored = new ObservabilityResourceInfo(
            config.SelectedResourceId,
            config.SelectedResourceName,
            string.Empty, string.Empty, string.Empty, string.Empty);

        await ActivateResourceAsync(restored, persist: false);
    }

    private async Task OnResourceSelectedAsync(ObservabilityResourceInfo resource)
    {
        _resourceSelectorOpen = false;
        await ActivateResourceAsync(resource, persist: true);
    }

    private async Task ActivateResourceAsync(ObservabilityResourceInfo resource, bool persist)
    {
        _selectedResource = resource;
        _provider = CreateProvider(resource.ResourceId);
        ConnectionState.SetConnected("observability");
        _explainerSummary = null;
        _anchors = ObservabilityExplainerService.GetDeploymentAnchors(ReleaseRepo);
        _deploymentComparison = null;
        _sloStatus = null;

        if (persist)
        {
            var config = EnsureConfig();
            config.SelectedResourceId = resource.ResourceId;
            config.SelectedResourceName = resource.Name;
            await AppState.SaveConfigAsync();
        }

        await InvokeAsync(StateHasChanged);
        await PublishWorkspaceSnapshotAsync(recordRecent: persist);
        _ = LoadExplainerAsync();
        _ = LoadSloStatusAsync();
    }

    private async Task LoadExplainerAsync()
    {
        if (_provider is null) return;

        _explainerCts.Cancel();
        _explainerCts.Dispose();
        _explainerCts = new CancellationTokenSource();
        var ct = _explainerCts.Token;

        try
        {
            var summary = await ExplainerService.GetExplainerSummaryAsync(
                _provider, _range, ["cloud/roleName", "operation/name"], ct);
            _explainerSummary = summary;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception) { /* Leave _explainerSummary null; component handles null gracefully. */ }
    }

    private async Task LoadSloStatusAsync()
    {
        if (_provider is null) return;
        var config = CurrentConfig;
        if (config is null || config.SloDefinitions.Count == 0) return;

        var ct = _explainerCts.Token;
        try
        {
            var status = await ExplainerService.GetSloStatusAsync(_provider, config.SloDefinitions, _range, ct);
            _sloStatus = status;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception) { /* Leave _sloStatus null; component handles null gracefully. */ }
    }

    private async Task OnAnchorSelectedAsync(DeploymentAnchor anchor)
    {
        if (_provider is null) return;

        _comparisonCts.Cancel();
        _comparisonCts.Dispose();
        _comparisonCts = new CancellationTokenSource();
        var ct = _comparisonCts.Token;

        _deploymentComparison = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await ExplainerService.GetDeploymentComparisonAsync(_provider, anchor, TimeSpan.FromHours(4), ct);
            _deploymentComparison = result;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception) { /* Leave _deploymentComparison null; component handles null gracefully. */ }
    }

    private IObservabilityProvider CreateProvider(string resourceId) =>
        ProviderFactory.Create(resourceId, AppState.UseDemoData);

    private void ToggleResourceSelector()
    {
        _resourceSelectorOpen = !_resourceSelectorOpen;
        StateHasChanged();
    }

    private async Task OnRangeChangedAsync(TimeRange range)
    {
        _range = range;
        _ = LoadExplainerAsync();
        _ = LoadSloStatusAsync();
        await RefreshAsync();
        await PublishWorkspaceSnapshotAsync(recordRecent: false);
    }

    private void SetTab(Tab tab)
    {
        _tab = tab;
        _ = PublishWorkspaceSnapshotAsync(recordRecent: false);
        StateHasChanged();
    }

    private string GetTabContentClass() =>
        _tab is Tab.Failures or Tab.Performance ? "obs-tab-content-structured" : string.Empty;

    private async Task RefreshAsync()
    {
        _lastRefreshedAt = DateTimeOffset.Now;
        await InvokeAsync(async () =>
        {
            switch (_tab)
            {
                case Tab.Overview: if (_overviewRef is not null) await _overviewRef.RefreshAsync(); break;
                case Tab.Failures: if (_failuresRef is not null) await _failuresRef.RefreshAsync(); break;
                case Tab.Performance: if (_perfRef is not null) await _perfRef.RefreshAsync(); break;
                case Tab.Availability: if (_availRef is not null) await _availRef.RefreshAsync(); break;
            }
            StateHasChanged();
        });
    }

    private async Task DrillToLogsAsync(string kql)
    {
        _pendingLogsQuery = kql;
        _pendingLogsQueryVersion++;
        _tab = Tab.Logs;
        await PublishWorkspaceSnapshotAsync(recordRecent: false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task PublishWorkspaceSnapshotAsync(bool recordRecent)
    {
        var snapshot = BuildWorkspaceSnapshot();
        if (snapshot is null)
        {
            Workspaces.ClearCurrentSnapshot("observability");
            return;
        }

        await Workspaces.PublishSnapshotAsync(snapshot, recordRecent);
    }

    private WorkspaceSnapshot? BuildWorkspaceSnapshot()
    {
        if (_selectedResource is null)
        {
            return null;
        }

        return new WorkspaceSnapshot
        {
            Resource = new OperatorResourceReference
            {
                Key = $"observability:{_selectedResource.ResourceId}",
                Area = "observability",
                Kind = "resource",
                DisplayName = _selectedResource.Name,
                DisplayPath = _selectedResource.Name,
                Summary = _selectedResource.ResourceGroup,
                Icon = "📈",
                Metadata = new Dictionary<string, string>(StringComparer.Ordinal)
                {
                    ["resourceId"] = _selectedResource.ResourceId,
                    ["resourceGroup"] = _selectedResource.ResourceGroup,
                    ["location"] = _selectedResource.Location,
                },
            },
            RestoreState = new Dictionary<string, string>(StringComparer.Ordinal)
            {
                ["resourceId"] = _selectedResource.ResourceId,
                ["resourceName"] = _selectedResource.Name,
                ["tab"] = _tab.ToString(),
                ["rangeStart"] = _range.Start.ToString("O"),
                ["rangeEnd"] = _range.End.ToString("O"),
            },
        };
    }

    private async Task RestoreWorkspaceAsync(WorkspaceSnapshot snapshot)
    {
        if (snapshot.RestoreState.TryGetValue("resourceId", out var resourceId)
            && snapshot.RestoreState.TryGetValue("resourceName", out var resourceName)
            && !string.IsNullOrWhiteSpace(resourceId)
            && !string.IsNullOrWhiteSpace(resourceName))
        {
            await ActivateResourceAsync(
                new ObservabilityResourceInfo(resourceId, resourceName, string.Empty, string.Empty, snapshot.Resource.Summary ??
string.Empty, string.Empty),
                persist: false);
        }

        if (snapshot.RestoreState.TryGetValue("tab", out var tabText)
            && Enum.TryParse<Tab>(tabText, out var restoredTab))
        {
            _tab = restoredTab;
        }

        if (snapshot.RestoreState.TryGetValue("rangeStart", out var startText)
            && snapshot.RestoreState.TryGetValue("rangeEnd", out var endText)
            && DateTimeOffset.TryParse(startText, out var rangeStart)
            && DateTimeOffset.TryParse(endText, out var rangeEnd))
        {
            _range = new TimeRange(rangeStart, rangeEnd);
        }

        await RefreshAsync();
        await PublishWorkspaceSnapshotAsync(recordRecent: false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPendingLogsQueryHandledAsync(int handledVersion)
    {
        if (handledVersion != _pendingLogsQueryVersion)
        {
            return;
        }

        _pendingLogsQuery = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSavedQueriesChangedAsync(List<SwebKit.Core.Domain.SavedQuery> queries)
    {
        var config = EnsureConfig();
        config.SavedQueries = queries;
        await AppState.SaveConfigAsync();
    }

    private async Task OnLogsModeChangedAsync(GuidedLogsQueryMode mode)
    {
        var config = EnsureConfig();
        config.LogsQueryMode = mode;
        await AppState.SaveConfigAsync();
    }

    private async Task OnGuidedDraftChangedAsync(GuidedKqlQueryDefinition draft)
    {
        var config = EnsureConfig();
        config.GuidedLogsDraft = draft?.Clone();
        await AppState.SaveConfigAsync();
    }

    private ObservabilityConfig EnsureConfig()
    {
        if (AppState.Config.ObservabilityConfig is null)
            AppState.Config.ObservabilityConfig = new ObservabilityConfig();
        return AppState.Config.ObservabilityConfig;
    }

    private void OnDemoModeChanged() => InvokeAsync(async () =>
    {
        _provider = null;
        _selectedResource = null;
        await TryRestoreLastResourceAsync();
        StateHasChanged();
    });

    private void OnRefreshRequested(RefreshRequestedEvent refresh)
    {
        if (!string.Equals(refresh.Area, "observability", StringComparison.Ordinal))
        {
            return;
        }

        _ = InvokeAsync(RefreshAsync);
    }

    // OBS-7: Auto-refresh toggle
    private void ToggleAutoRefresh()
    {
        _autoRefreshEnabled = !_autoRefreshEnabled;
        if (_autoRefreshEnabled)
            StartAutoRefreshLoop();
        else
            StopAutoRefreshLoop();
        StateHasChanged();
    }

    private void OnAutoRefreshIntervalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var seconds))
        {
            _autoRefreshSeconds = seconds;
            if (_autoRefreshEnabled)
            {
                StopAutoRefreshLoop();
                StartAutoRefreshLoop();
            }
        }
    }

    private void StartAutoRefreshLoop()
    {
        StopAutoRefreshLoop();
        _autoRefreshCts = new CancellationTokenSource();
        _autoRefreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(_autoRefreshSeconds));
        var ct = _autoRefreshCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _autoRefreshTimer.WaitForNextTickAsync(ct))
                {
                    await InvokeAsync(async () =>
                    {
                        await RefreshAsync();
                    });
                }
            }
            catch (OperationCanceledException) { /* expected on dispose */ }
        }, ct);
    }

    private void StopAutoRefreshLoop()
    {
        _autoRefreshCts?.Cancel();
        _autoRefreshCts?.Dispose();
        _autoRefreshCts = null;
        _autoRefreshTimer?.Dispose();
        _autoRefreshTimer = null;
    }

    public void Dispose()
    {
        StopAutoRefreshLoop();
        foreach (var id in new[] { "obs-refresh", "obs-run-query", "obs-show-logs", "obs-show-failures", "obs-show-overview" })
            Commands.Unregister(id);
        Selection.SetSelection("observability", null);
        AppState.DemoModeChanged -= OnDemoModeChanged;
        Events.Unsubscribe<RefreshRequestedEvent>(OnRefreshRequested);
        Workspaces.UnregisterRestoreHandler("observability");
        _cts.Cancel();
        _cts.Dispose();
        _explainerCts.Cancel();
        _explainerCts.Dispose();
        _comparisonCts.Cancel();
        _comparisonCts.Dispose();
    }

    private void LaunchInvestigationFromObservability()
    {
        if (_selectedResource is null) return;

        var seed = new IncidentInvestigationSeed
        {
            SourceArea = IncidentInvestigationSourceArea.Observability,
            LaunchedAtUtc = DateTimeOffset.UtcNow,
            SelectedRange = _range,
            EvidenceRef = new IncidentSeedEvidenceRef
            {
                ResourceId = _selectedResource.ResourceId,
            },
            SuggestedSources = [IncidentTimelineSource.Observability],
        };

        InvestigationLauncher.Launch(seed);
    }
}
