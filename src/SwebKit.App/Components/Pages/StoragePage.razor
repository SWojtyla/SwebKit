@page "/storage"
@inject AppStateService AppState
@inject ICredentialStore CredentialStore
@inject IAppEventBus Events
@inject IConnectionStateService ConnectionState
@inject SwebKit.Core.Services.DemoStorageClient DemoStorage
@inject IStorageClientFactory StorageFactory
@inject UiStateRepository UiState
@inject CommandRegistry Commands
@inject ISelectionContext Selection
@inject INotificationService Notifications
@inject IJSRuntime JS
@inject OperatorWorkspaceService Workspaces
@implements IAsyncDisposable
@implements IDisposable

<div class="storage-page-shell">
    <div class="page-shell-header">
        <RoutePageHeader Area="storage"
                         Subtitle="Inspect containers, blobs, and download flows for the active storage account.">
            <Meta>
            <span class="shell-pill shell-pill--muted">@_storageAccounts.Count account@(_storageAccounts.Count == 1 ? "" : "s")</span>
            @if (!string.IsNullOrWhiteSpace(SelectedStorageAccountDisplayName))
            {
                <span class="shell-pill shell-pill--accent">@SelectedStorageAccountDisplayName</span>
            }
            @if (AppState.UseDemoData)
            {
                <span class="shell-pill shell-pill--warning">Demo mode</span>
            }
        </Meta>
        <Actions>
            <a class="page-header-action-btn" href="/settings?section=storage">Settings</a>
        </Actions>
    </RoutePageHeader>
</div>

@if (_storageAccounts.Count == 0)
{
    <div class="storage-not-configured">
        <EmptyState Icon="📦" Title="Storage is not configured"
                    Subtitle="Connect an Azure Blob account in Settings before opening containers and blob detail views.">
            <Actions>
                <a href="/settings?section=storage">Open Storage settings</a>
            </Actions>
        </EmptyState>
    </div>
}
else
{
    @if (_storageAccounts.Count > 1)
    {
        <div class="storage-account-bar">
            <span>Account:</span>
            <AppSelect CssClass="storage-select" Value="@_selectedAccountId" ValueChanged="OnAccountChangedAsync"
                       aria-label="Select active storage account">
                @foreach (var acc in _storageAccounts)
                {
                    <option value="@acc.Id">@acc.DisplayName (@acc.AccountName)</option>
                }
            </AppSelect>
        </div>
    }

    @if (_storageClient is null)
    {
        <div class="storage-not-configured">
            <EmptyState Icon="🚫" Title="Selected storage account is unavailable"
                        Subtitle="The saved storage configuration is incomplete or invalid for this configuration.">
                <Actions>
                    <a href="/settings?section=storage">Review Storage settings</a>
                </Actions>
            </EmptyState>
        </div>
    }
    else
    {
        <StorageMutationBanner MutationsEnabled="@(_storageClient.Config.AllowMutations)"
                               AccountName="@_storageClient.Config.AccountName" />

        <div class="storage-body">
            <div class="storage-container-pane">
                <StorageContainerTree Client="_storageClient" SelectedContainer="_selectedContainer"
                                      SelectedContainerChanged="OnContainerSelectedAsync" />
            </div>

            <div class="storage-blob-pane">
                @if (_selectedContainer is null)
                {
                    <EmptyState Icon="📁" Title="Select a container"
                                Subtitle="Choose a container from the left pane to inspect blobs, metadata, and download options." />
                }
                else
                {
                    @if (_storageClient.Config.AllowMutations)
                    {
                        <div class="storage-mutation-actions">
                            <FluentButton Appearance="Appearance.Accent"
                                          @onclick="() => { _showUploadDialog = true; _mutationMessage = null; }">Upload</FluentButton>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_mutationMessage))
                    {
                        <div class="@(_mutationSuccess ? "storage-mutation-result storage-mutation-result--success" : "storage-mutation-result storage-mutation-result--error")"
                             role="status">
                            @_mutationMessage
                        </div>
                    }

                    <div class="@(_selectedBlob is not null ? "storage-blob-split has-selection" : "storage-blob-split")">
                        <div class="storage-blob-list-pane">
                            <StorageBlobList Client="_storageClient" ContainerName="@_selectedContainer"
                                             SelectedBlob="_selectedBlob" SelectedBlobChanged="OnBlobSelectedAsync" />
                        </div>
                        @if (_selectedBlob is not null)
                        {
                            <div @ref="_detailSplitterRef" class="pane-splitter storage-detail-splitter" role="separator"
                                 aria-orientation="vertical" aria-label="Resize blob detail pane"
                                 title="Drag to resize the detail pane"></div>
                            <div @ref="_detailPaneRef" class="storage-detail-pane" style="@DetailPaneStyle">
                                @if (_storageClient.Config.AllowMutations)
                                {
                                    <div class="storage-blob-mutation-bar">
                                        <FluentButton Appearance="Appearance.Lightweight" @onclick="OpenCopyDialogAsync">Copy
                                        </FluentButton>
                                    </div>
                                }
                                <BlobDetailPane Client="_storageClient" ContainerName="@_selectedContainer" Blob="_selectedBlob"
                                                AllowMutations="@(_storageClient.Config.AllowMutations)" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (_showUploadDialog && _selectedContainer is not null)
        {
            <BlobUploadDialog Visible="true" ContainerName="@_selectedContainer" OnConfirm="HandleUploadAsync"
                              OnCancel="() => { _showUploadDialog = false; _mutationMessage = null; }" />
        }

        @if (_showCopyDialog && _selectedBlob is not null && _selectedContainer is not null)
        {
            <BlobCopyDialog Visible="true" SourceContainer="@_selectedContainer" SourceBlobName="@_selectedBlob.Name"
                            AvailableContainers="@_containerNames" OnConfirm="HandleCopyAsync"
                            OnCancel="() => { _showCopyDialog = false; _mutationMessage = null; }" />
        }
    }
}
</div>

@code {
    private IStorageClient? _storageClient;
    private List<StorageConfig> _storageAccounts = [];
    private string? _selectedAccountId;
    private string? _selectedContainer;
    private StorageBlobItem? _selectedBlob;
    private CancellationTokenSource _cts = new();
    private bool _showUploadDialog;
    private bool _showCopyDialog;
    private string? _mutationMessage;
    private bool _mutationSuccess;
    private IReadOnlyList<string> _containerNames = [];
    private ElementReference _detailSplitterRef;
    private ElementReference _detailPaneRef;
    private IJSObjectReference? _detailSplitterHandle;
    private DotNetObjectReference<StoragePage>? _jsRef;
    private bool _disposed;
    private int _detailPaneWidth;

    private const string DetailPaneWidthStateKey = "storage:detail-pane-width";
    private const int DefaultDetailPaneWidth = 460;
    private const int MinDetailPaneWidth = 320;
    private const int MaxDetailPaneWidth = 1080;

    private string? SelectedStorageAccountDisplayName =>
        _storageAccounts.FirstOrDefault(acc => acc.Id == _selectedAccountId)?.DisplayName;

    private string DetailPaneStyle => $"width: {_detailPaneWidth}px; flex: 0 0 {_detailPaneWidth}px;";

    protected override void OnInitialized()
    {
        _detailPaneWidth = NormalizeDetailPaneWidth(UiState.GetViewState(DetailPaneWidthStateKey, DefaultDetailPaneWidth));
        _jsRef = DotNetObjectReference.Create(this);
        Events.Subscribe<RefreshRequestedEvent>(OnRefreshRequested);
        Workspaces.RegisterRestoreHandler("storage", RestoreWorkspaceAsync);
        RebuildClient();
        RegisterStorageCommands();
        _ = Workspaces.ApplyPendingRestoreAsync("storage");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_selectedBlob is not null)
        {
            await EnsureDetailSplitterAsync();
        }
        else if (_detailSplitterHandle is not null)
        {
            await DisposeDetailSplitterAsync();
        }
    }

    private void RegisterStorageCommands()
    {
        Commands.Register(new AppCommand
        {
            Id = "storage-refresh",
            Label = "Refresh Blobs",
            Category = "Storage",
            AreaScope = "storage",
            Execute = () =>
            {
                RebuildClient();
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            }
        });
        Commands.Register(new AppCommand
        {
            Id = "storage-download-blob",
            Label = "Download Selected Blob",
            Category = "Storage",
            AreaScope = "storage",
            IsAvailable = () => _selectedBlob is not null && _storageClient is not null,
            Execute = () => DownloadSelectedBlobAsync(_cts.Token)
        });
        Commands.Register(new AppCommand
        {
            Id = "storage-copy-sas",
            Label = "Copy SAS URL",
            Category = "Storage",
            AreaScope = "storage",
            IsAvailable = () => _selectedBlob is not null && _storageClient is not null,
            Execute = () => CopySelectedBlobSasAsync(_cts.Token)
        });
    }

    public void Dispose()
    {
        DisposeCore();
        _ = DisposeDetailSplitterAsync();
    }

    public async ValueTask DisposeAsync()
    {
        DisposeCore();
        await DisposeDetailSplitterAsync();
    }

    private void OnRefreshRequested(RefreshRequestedEvent refresh)
    {
        if (!string.Equals(refresh.Area, "storage", StringComparison.Ordinal))
        {
            return;
        }

        RebuildClient();
        _ = InvokeAsync(StateHasChanged);
    }

    private void RebuildClient()
    {
        _storageClient = null;

        if (AppState.UseDemoData)
        {
            _storageAccounts = [DemoStorage.Config];
            _selectedAccountId = DemoStorage.Config.Id;
            _storageClient = DemoStorage;
            ConnectionState.SetConnected("storage");
            _ = PublishWorkspaceSnapshotAsync(recordRecent: false);
            return;
        }

        _storageAccounts = AppState.Config.StorageAccounts;
        if (_storageAccounts.Count == 0)
        {
            ConnectionState.SetNotConfigured("storage");
            Workspaces.ClearCurrentSnapshot("storage");
            return;
        }

        var selected = _storageAccounts.FirstOrDefault(a => a.Id == _selectedAccountId)
                       ?? _storageAccounts[0];
        _selectedAccountId = selected.Id;

        try
        {
            _storageClient = StorageFactory.Create(selected);
            ConnectionState.SetConnected("storage");
        }
        catch (Exception ex)
        {
            ConnectionState.SetError("storage", ex.Message);
        }

        _ = PublishWorkspaceSnapshotAsync(recordRecent: false);
    }

    private async Task OnAccountChangedAsync(string? value)
    {
        await DisposeDetailSplitterAsync();
        _selectedAccountId = value;
        _selectedContainer = null;
        _selectedBlob = null;
        RebuildClient();
        await PublishWorkspaceSnapshotAsync(recordRecent: false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnContainerSelectedAsync(string? container)
    {
        await DisposeDetailSplitterAsync();
        _selectedContainer = container;
        _selectedBlob = null;
        await PublishWorkspaceSnapshotAsync(recordRecent: !string.IsNullOrWhiteSpace(container));
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnBlobSelectedAsync(StorageBlobItem? blob)
    {
        if (blob is null)
        {
            await DisposeDetailSplitterAsync();
        }

        _selectedBlob = blob;
        Selection.SetSelection("storage", blob);
        await PublishWorkspaceSnapshotAsync(recordRecent: blob is not null);
        await InvokeAsync(StateHasChanged);
    }

    private async Task EnsureDetailSplitterAsync()
    {
        if (_detailSplitterHandle is not null)
        {
            return;
        }

        try
        {
            _detailSplitterHandle = await JS.InvokeAsync<IJSObjectReference>(
                "SwebKitSplitter.init", _detailSplitterRef, _detailPaneRef,
                new
                {
                    minWidth = MinDetailPaneWidth,
                    maxWidth = MaxDetailPaneWidth,
                    initialWidth = _detailPaneWidth,
                    dotNetRef = _jsRef,
                    onWidthChangedMethod = nameof(OnDetailPaneWidthChanged)
                });
        }
        catch
        {
            _detailSplitterHandle = null;
        }
    }

    private async Task DisposeDetailSplitterAsync()
    {
        if (_detailSplitterHandle is null)
        {
            return;
        }

        try
        {
            var width = await _detailSplitterHandle.InvokeAsync<int>("getWidth");
            await PersistDetailPaneWidthAsync(width);
            await _detailSplitterHandle.InvokeVoidAsync("dispose");
            await _detailSplitterHandle.DisposeAsync();
        }
        catch
        {
            // Best-effort cleanup. The renderer may already be gone.
        }
        finally
        {
            _detailSplitterHandle = null;
        }
    }

    private void DisposeCore()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
        Events.Unsubscribe<RefreshRequestedEvent>(OnRefreshRequested);
        Workspaces.UnregisterRestoreHandler("storage");
        foreach (var id in new[] { "storage-refresh", "storage-download-blob", "storage-copy-sas" })
        {
            Commands.Unregister(id);
        }

        Selection.SetSelection("storage", null);
        _jsRef?.Dispose();
        _jsRef = null;
    }

    [JSInvokable]
    public async Task OnDetailPaneWidthChanged(int width)
    {
        await PersistDetailPaneWidthAsync(width);
    }

    private async Task PersistDetailPaneWidthAsync(int width)
    {
        var normalizedWidth = NormalizeDetailPaneWidth(width);
        if (normalizedWidth == _detailPaneWidth)
        {
            return;
        }

        _detailPaneWidth = normalizedWidth;
        await UiState.SaveViewStateAsync(DetailPaneWidthStateKey, normalizedWidth);
    }

    private static int NormalizeDetailPaneWidth(int width) => Math.Clamp(width, MinDetailPaneWidth, MaxDetailPaneWidth);

    private async Task PublishWorkspaceSnapshotAsync(bool recordRecent)
    {
        var snapshot = BuildWorkspaceSnapshot();
        if (snapshot is null)
        {
            Workspaces.ClearCurrentSnapshot("storage");
            return;
        }

        await Workspaces.PublishSnapshotAsync(snapshot, recordRecent);
    }

    private WorkspaceSnapshot? BuildWorkspaceSnapshot()
    {
        var account = _storageAccounts.FirstOrDefault(candidate => candidate.Id == _selectedAccountId);
        if (account is null)
        {
            return null;
        }

        var kind = _selectedBlob is not null
            ? "blob"
            : !string.IsNullOrWhiteSpace(_selectedContainer)
                ? "container"
                : "account";
        var displayName = _selectedBlob?.Name ?? _selectedContainer ?? account.DisplayName;
        var displayPath = _selectedBlob is not null
            ? $"{account.DisplayName}/{_selectedContainer}/{_selectedBlob.Name}"
            : !string.IsNullOrWhiteSpace(_selectedContainer)
                ? $"{account.DisplayName}/{_selectedContainer}"
                : account.DisplayName;

        return new WorkspaceSnapshot
        {
            Resource = new OperatorResourceReference
            {
                Key = $"storage:{account.Id}:{_selectedContainer}:{_selectedBlob?.Name}",
                Area = "storage",
                Kind = kind,
                DisplayName = displayName,
                DisplayPath = displayPath,
                Summary = account.AccountName,
                Icon = "📁",
            },
            RestoreState = new Dictionary<string, string>(StringComparer.Ordinal)
            {
                ["accountId"] = account.Id,
                ["container"] = _selectedContainer ?? string.Empty,
                ["blobName"] = _selectedBlob?.Name ?? string.Empty,
            },
        };
    }

    private async Task RestoreWorkspaceAsync(WorkspaceSnapshot snapshot)
    {
        _selectedAccountId = snapshot.RestoreState.TryGetValue("accountId", out var accountId)
            ? accountId
            : _selectedAccountId;
        RebuildClient();

        _selectedContainer = snapshot.RestoreState.TryGetValue("container", out var container)
            && !string.IsNullOrWhiteSpace(container)
            ? container
            : null;
        _selectedBlob = snapshot.RestoreState.TryGetValue("blobName", out var blobName)
            && !string.IsNullOrWhiteSpace(blobName)
            ? new StorageBlobItem(blobName, false, null, null, null, null)
            : null;

        await PublishWorkspaceSnapshotAsync(recordRecent: false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadSelectedBlobAsync(CancellationToken ct = default)
    {
        if (_storageClient is null || _selectedBlob is null || _selectedContainer is null) return;
        try
        {
            var fileName = System.IO.Path.GetFileName(_selectedBlob.Name.TrimEnd('/'));
            if (string.IsNullOrEmpty(fileName)) fileName = _selectedBlob.Name.Replace('/', '_');
            var destPath = System.IO.Path.Combine(
                System.Environment.GetFolderPath(System.Environment.SpecialFolder.UserProfile),
                "Downloads", fileName);
            await using var fs = System.IO.File.OpenWrite(destPath);
            await _storageClient.DownloadBlobAsync(_selectedContainer, _selectedBlob.Name, fs, ct: ct);
            Notifications.ShowSuccess("Blob downloaded", fileName);
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            Notifications.ShowError("Download failed", ex: ex);
        }
    }

    private async Task CopySelectedBlobSasAsync(CancellationToken ct = default)
    {
        if (_storageClient is null || _selectedBlob is null || _selectedContainer is null) return;
        try
        {
            var url = await _storageClient.GetBlobSasUrlAsync(_selectedContainer, _selectedBlob.Name, TimeSpan.FromHours(24), ct);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            Notifications.ShowSuccess("SAS URL copied", "Expires in 24 hours");
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            Notifications.ShowError("Failed to copy SAS URL", ex: ex);
        }
    }

    private async Task OpenCopyDialogAsync()
    {
        _containerNames = [];
        if (_storageClient is not null)
        {
            try
            {
                var containers = await _storageClient.ListContainersAsync(_cts.Token);
                _containerNames = containers.Select(c => c.Name).ToList();
            }
            catch (OperationCanceledException) { return; }
            catch { /* best-effort */ }
        }
        _showCopyDialog = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleUploadAsync((BlobUploadOptions Options, Stream FileStream) payload)
    {
        if (_storageClient is null) return;
        _mutationMessage = null;
        var result = await _storageClient.UploadBlobAsync(payload.Options, payload.FileStream, null, _cts.Token);
        if (result.Success)
        {
            _showUploadDialog = false;
        }
        _mutationMessage = result.Success
            ? $"Uploaded to {result.ResultBlobPath}"
            : $"Upload failed: {result.ErrorMessage}";
        _mutationSuccess = result.Success;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleCopyAsync(BlobCopyOptions options)
    {
        if (_storageClient is null) return;
        _mutationMessage = null;
        var result = await _storageClient.CopyBlobAsync(options, _cts.Token);
        if (result.Success)
        {
            _showCopyDialog = false;
        }
        _mutationMessage = result.Success
            ? $"Copied to {result.ResultBlobPath}"
            : $"Copy failed: {result.ErrorMessage}";
        _mutationSuccess = result.Success;
        await InvokeAsync(StateHasChanged);
    }
}
