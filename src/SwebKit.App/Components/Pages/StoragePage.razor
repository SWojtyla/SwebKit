@page "/storage"
@using SwebKit.Azure.Storage
@inject AppStateService AppState
@inject ICredentialStore CredentialStore
@inject IAppEventBus Events
@inject IConnectionStateService ConnectionState
@inject SwebKit.Core.Services.DemoStorageClient DemoStorage
@inject CommandRegistry Commands
@inject ISelectionContext Selection
@inject INotificationService Notifications
@inject IJSRuntime JS
@implements IDisposable

<div class="storage-page-shell">
    <div class="page-shell-header">
        <RoutePageHeader Area="storage"
                         Subtitle="Inspect containers, blobs, and download flows for the active storage account.">
            <Meta>
                <span class="shell-pill shell-pill--muted">@_storageAccounts.Count account@(_storageAccounts.Count == 1 ? "" : "s")</span>
                @if (!string.IsNullOrWhiteSpace(SelectedStorageAccountDisplayName))
                {
                    <span class="shell-pill shell-pill--accent">@SelectedStorageAccountDisplayName</span>
                }
                @if (AppState.UseDemoData)
                {
                    <span class="shell-pill shell-pill--warning">Demo mode</span>
                }
            </Meta>
            <Actions>
                <a class="page-header-action-btn" href="/settings?section=storage">Settings</a>
            </Actions>
        </RoutePageHeader>
    </div>

    @if (_storageAccounts.Count == 0)
    {
        <div class="storage-not-configured">
            <EmptyState Icon="📦" Title="Storage is not configured"
                        Subtitle="Connect an Azure Blob account in Settings before opening containers and blob detail views.">
                <Actions>
                    <a href="/settings?section=storage">Open Storage settings</a>
                </Actions>
            </EmptyState>
        </div>
    }
    else
    {
        @if (_storageAccounts.Count > 1)
        {
            <div class="storage-account-bar">
                <span>Account:</span>
                <select class="storage-select" value="@_selectedAccountId" @onchange="OnAccountChangedAsync">
                    @foreach (var acc in _storageAccounts)
                    {
                        <option value="@acc.Id">@acc.DisplayName (@acc.AccountName)</option>
                    }
                </select>
            </div>
        }

        @if (_storageClient is null)
        {
            <div class="storage-not-configured">
                <EmptyState Icon="⚠" Title="Selected storage account is unavailable"
                            Subtitle="The saved storage configuration is incomplete or invalid for this configuration.">
                    <Actions>
                        <a href="/settings?section=storage">Review Storage settings</a>
                    </Actions>
                </EmptyState>
            </div>
        }
        else
        {
            <div class="storage-body">
                <div class="storage-container-pane">
                    <StorageContainerTree Client="_storageClient" SelectedContainer="_selectedContainer"
                                          SelectedContainerChanged="OnContainerSelectedAsync" />
                </div>

                <div class="storage-blob-pane">
                    @if (_selectedContainer is null)
                    {
                        <EmptyState Icon="📁" Title="Select a container"
                                    Subtitle="Choose a container from the left pane to inspect blobs, metadata, and download options." />
                    }
                    else
                    {
                        <div class="storage-blob-split">
                            <div
                                style="flex:1; height:100%; overflow:hidden; border-right:@(_selectedBlob is not null ? "1px solid var(--color-border)" : "none");">
                                <StorageBlobList Client="_storageClient" ContainerName="@_selectedContainer"
                                                 SelectedBlob="_selectedBlob" SelectedBlobChanged="OnBlobSelectedAsync" />
                            </div>
                            @if (_selectedBlob is not null)
                            {
                                <div class="storage-detail-pane">
                                    <BlobDetailPane Client="_storageClient" ContainerName="@_selectedContainer" Blob="_selectedBlob" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private IStorageClient? _storageClient;
    private List<StorageConfig> _storageAccounts = [];
    private string? _selectedAccountId;
    private string? _selectedContainer;
    private StorageBlobItem? _selectedBlob;
    private CancellationTokenSource _cts = new();

    private string? SelectedStorageAccountDisplayName =>
        _storageAccounts.FirstOrDefault(acc => acc.Id == _selectedAccountId)?.DisplayName;

    protected override void OnInitialized()
    {
        Events.Subscribe<RefreshRequestedEvent>(OnRefreshRequested);
        RebuildClient();
        RegisterStorageCommands();
    }

    private void RegisterStorageCommands()
    {
        Commands.Register(new AppCommand
        {
            Id = "storage-refresh",
            Label = "Refresh Blobs",
            Category = "Storage",
            AreaScope = "storage",
            Execute = () =>
            {
                RebuildClient();
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            }
        });
        Commands.Register(new AppCommand
        {
            Id = "storage-download-blob",
            Label = "Download Selected Blob",
            Category = "Storage",
            AreaScope = "storage",
            IsAvailable = () => _selectedBlob is not null && _storageClient is not null,
            Execute = () => DownloadSelectedBlobAsync(_cts.Token)
        });
        Commands.Register(new AppCommand
        {
            Id = "storage-copy-sas",
            Label = "Copy SAS URL",
            Category = "Storage",
            AreaScope = "storage",
            IsAvailable = () => _selectedBlob is not null && _storageClient is not null,
            Execute = () => CopySelectedBlobSasAsync(_cts.Token)
        });
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        Events.Unsubscribe<RefreshRequestedEvent>(OnRefreshRequested);
        foreach (var id in new[] { "storage-refresh", "storage-download-blob", "storage-copy-sas" })
        {
            Commands.Unregister(id);
        }

        Selection.SetSelection("storage", null);
    }

    private void OnRefreshRequested(RefreshRequestedEvent refresh)
    {
        if (!string.Equals(refresh.Area, "storage", StringComparison.Ordinal))
        {
            return;
        }

        RebuildClient();
        _ = InvokeAsync(StateHasChanged);
    }

    private void RebuildClient()
    {
        _storageClient = null;

        if (AppState.UseDemoData)
        {
            _storageAccounts = [DemoStorage.Config];
            _selectedAccountId = DemoStorage.Config.Id;
            _storageClient = DemoStorage;
            ConnectionState.SetConnected("storage");
            return;
        }

        _storageAccounts = AppState.Config.StorageAccounts;
        if (_storageAccounts.Count == 0)
        {
            ConnectionState.SetNotConfigured("storage");
            return;
        }

        var selected = _storageAccounts.FirstOrDefault(a => a.Id == _selectedAccountId)
                       ?? _storageAccounts[0];
        _selectedAccountId = selected.Id;

        try
        {
            _storageClient = new AzureStorageClient(selected, CredentialStore);
            ConnectionState.SetConnected("storage");
        }
        catch (Exception ex)
        {
            ConnectionState.SetError("storage", ex.Message);
        }
    }

    private async Task OnAccountChangedAsync(ChangeEventArgs e)
    {
        _selectedAccountId = e.Value?.ToString();
        _selectedContainer = null;
        _selectedBlob = null;
        RebuildClient();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnContainerSelectedAsync(string? container)
    {
        _selectedContainer = container;
        _selectedBlob = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnBlobSelectedAsync(StorageBlobItem? blob)
    {
        _selectedBlob = blob;
        Selection.SetSelection("storage", blob);
        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadSelectedBlobAsync(CancellationToken ct = default)
    {
        if (_storageClient is null || _selectedBlob is null || _selectedContainer is null) return;
        try
        {
            var fileName = System.IO.Path.GetFileName(_selectedBlob.Name.TrimEnd('/'));
            if (string.IsNullOrEmpty(fileName)) fileName = _selectedBlob.Name.Replace('/', '_');
            var destPath = System.IO.Path.Combine(
                System.Environment.GetFolderPath(System.Environment.SpecialFolder.UserProfile),
                "Downloads", fileName);
            await using var fs = System.IO.File.OpenWrite(destPath);
            await _storageClient.DownloadBlobAsync(_selectedContainer, _selectedBlob.Name, fs, ct: ct);
            Notifications.ShowSuccess("Blob downloaded", fileName);
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            Notifications.ShowError("Download failed", ex: ex);
        }
    }

    private async Task CopySelectedBlobSasAsync(CancellationToken ct = default)
    {
        if (_storageClient is null || _selectedBlob is null || _selectedContainer is null) return;
        try
        {
            var url = await _storageClient.GetBlobSasUrlAsync(_selectedContainer, _selectedBlob.Name, TimeSpan.FromHours(24), ct);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            Notifications.ShowSuccess("SAS URL copied", "Expires in 24 hours");
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            Notifications.ShowError("Failed to copy SAS URL", ex: ex);
        }
    }
}
