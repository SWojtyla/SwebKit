@* Flattened + virtualized collection tree (BL-5 guard on ShouldRender) *@
@using Microsoft.FluentUI.AspNetCore.Components
@inject IJSRuntime JS

<div class="api-client collection-tree">

    <div class="collection-tree__search">
        <label for="collection-tree-search" class="sr-only">Filter collection tree</label>
        <input type="text" id="collection-tree-search" placeholder="Filter..." class="collection-tree__search-input"
               value="@_filter" @oninput="OnFilterInput" aria-label="Filter collection tree"
               aria-describedby="collection-tree-search-help" />
        <span id="collection-tree-search-help" class="sr-only">Type to filter API requests and collections</span>
    </div>

    <div class="collection-tree__rows" role="tree" aria-label="API request collection">
        <Virtualize Items="@_visibleNodes" Context="node" ItemSize="28" OverscanCount="8">
            <div @key="node.Id" class="collection-tree__row @GetRowClass(node) @GetDragClass(node)"
                 style="--depth: @node.Depth" role="treeitem"
                 aria-selected="@(node.Node.Request?.Id == SelectedRequestId)"
                 aria-expanded="@(node.Node.Type == ApiCollectionNodeType.Folder && node.IsExpanded)"
                 aria-level="@(node.Depth + 1)" tabindex="@(node.Node.Request?.Id == SelectedRequestId ? 0 : -1)"
                 draggable="@(CanDrag(node) ? "true" : "false")" @ondragstart="() => OnDragStart(node)"
                 @ondragover="() => OnDragOver(node)" @ondragover:preventDefault="@CanDrop(node)"
                 @ondragleave="() => OnDragLeave(node)" @ondrop="e => OnDropAsync(node)" @ondrop:preventDefault="true"
                 @ondrop:stopPropagation="true" @ondragend="OnDragEnd" @onclick="() => OnRowClickAsync(node)"
                 @oncontextmenu="e => ShowContextMenu(e, node)" @oncontextmenu:preventDefault="true"
                 @onkeydown:preventDefault="true" @onkeydown="e => HandleTreeKeyDown(e, node)">

                @if (node.Kind is FlatTreeNodeKind.Group)
                {
                    <span class="collection-tree__group-label">@node.Node.Name</span>
                }
                else
                {
                    @if (node.Node.Type == ApiCollectionNodeType.Folder)
                    {
                        <button type="button" class="collection-tree__chevron"
                                aria-label="@(node.IsExpanded ? "Collapse" : "Expand")" @onclick:stopPropagation="true"
                                @onclick="() => ToggleExpand(node)">
                            <FluentIcon Value="@(node.IsExpanded ? _iconChevronDown : _iconChevronRight)" Width="12px" />
                        </button>
                    }
                    else
                    {
                        <span class="collection-tree__chevron collection-tree__chevron--spacer" aria-hidden="true">
                            <FluentIcon Value="@_iconChevronRight" Width="12px" />
                        </span>
                    }

                    @if (node.Kind == FlatTreeNodeKind.LinkedRoot)
                    {
                        <span class="collection-tree__fluent-icon collection-tree__fluent-icon--linked" aria-hidden="true">
                            <FluentIcon Value="@_iconLinked" Width="14px" />
                        </span>
                    }
                    else if (node.Node.Id.StartsWith("__col__", StringComparison.Ordinal))
                    {
                        <span class="collection-tree__fluent-icon collection-tree__fluent-icon--collection" aria-hidden="true">
                            <FluentIcon Value="@_iconCollection" Width="14px" />
                        </span>
                    }
                    else if (node.Node.Type == ApiCollectionNodeType.Folder)
                    {
                        <span class="collection-tree__fluent-icon collection-tree__fluent-icon--folder" aria-hidden="true">
                            <FluentIcon Value="@(node.IsExpanded ? _iconFolderOpen : _iconFolder)" Width="14px" />
                        </span>
                    }
                    else if (node.Node.Request is not null)
                    {
                        <span
                            class="collection-tree__method-badge collection-tree__method-badge--@node.Node.Request.Method.ToString().ToLowerInvariant()"
                            aria-hidden="true">
                            @GetMethodLabel(node.Node.Request.Method)
                        </span>
                    }

                    @if (node.Id == _renamingNodeId)
                    {
                        <input class="collection-tree__rename-input" value="@_renameValue"
                               @oninput="e => _renameValue = e.Value as string ?? _renameValue" @onkeydown="OnRenameKeyDownAsync"
                               @onblur="CommitRenameAsync" @onclick:stopPropagation="true" @ref="_renameInput" />
                    }
                    else
                    {
                        <span class="collection-tree__label" title="@node.Node.Name">@node.Node.Name</span>
                    }

                    @if (node.Kind == FlatTreeNodeKind.LinkedRoot && node.LinkedRoot is not null)
                    {
                        @if (!string.IsNullOrWhiteSpace(node.LinkedRoot.Branch))
                        {
                            <span class="collection-tree__git-badge" title="Current branch">@node.LinkedRoot.Branch</span>
                        }
                        <span
                            class="collection-tree__git-badge @(node.LinkedRoot.ChangedFileCount > 0 ? "collection-tree__git-badge--dirty" : "")"
                            title="SwebKit API file changes">
                            @(node.LinkedRoot.ChangedFileCount > 0 ? $"{node.LinkedRoot.ChangedFileCount} changed" : "clean")
                        </span>
                    }
                    else if (node.Node.Type == ApiCollectionNodeType.Folder && !node.IsExpanded && node.HasChildren)
                    {
                        <span class="collection-tree__count-badge" aria-label="@node.Node.Children.Count children">
                            @node.Node.Children.Count
                        </span>
                    }
                }

            </div>
        </Virtualize>
    </div>

    @if (_ctxNode is not null && _ctxNode.Kind == FlatTreeNodeKind.Node)
    {
        <div class="ctx-backdrop" @onclick="() => _ctxNode = null"></div>
        <div class="ctx-menu"
             style="top:@(_ctxY.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))px; left:@(_ctxX.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))px;">
            @{
                var isCollRoot = _ctxNode.Node.Id.StartsWith("__col__", StringComparison.Ordinal);
                var isFolder = _ctxNode.Node.Type == ApiCollectionNodeType.Folder;
            }
            @if (isFolder)
            {
                <button class="ctx-item" @onclick="AddSubFolderCtxAsync">
                    <span class="ctx-item-icon" aria-hidden="true">
                        <FluentIcon Value="@_iconAddFolder" Width="12px" />
                    </span>
                    <span>New sub-folder</span>
                </button>
                <button class="ctx-item" @onclick="AddRequestCtxAsync">
                    <span class="ctx-item-icon" aria-hidden="true">
                        <FluentIcon Value="@_iconAddRequest" Width="12px" />
                    </span>
                    <span>New request here</span>
                </button>
                <div class="ctx-separator"></div>
            }
            @if (isCollRoot && !IsLinkedCollection(_ctxNode.CollectionId))
            {
                <button class="ctx-item" @onclick="LinkToRepoCtxAsync">
                    <span class="ctx-item-icon" aria-hidden="true">
                        <FluentIcon Value="@_iconLinked" Width="12px" />
                    </span>
                    <span>Link to Git repo…</span>
                </button>
                <div class="ctx-separator"></div>
            }
            <button class="ctx-item" @onclick="BeginRenameCtx">
                <span class="ctx-item-icon" aria-hidden="true">
                    <FluentIcon Value="@_iconRename" Width="12px" />
                </span>
                <span>@(isCollRoot ? "Rename collection" : "Rename")</span>
            </button>
            <div class="ctx-separator"></div>
            <button class="ctx-item destructive" @onclick="DeleteNodeCtxAsync">
                <span class="ctx-item-icon" aria-hidden="true">
                    <FluentIcon Value="@_iconDelete" Width="12px" />
                </span>
                <span>@(isCollRoot ? "Delete collection" : "Delete")</span>
            </button>
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ApiCollection> Collections { get; set; } = [];
    [Parameter] public IReadOnlyList<LinkedCollectionTreeInfo> LinkedRoots { get; set; } = [];
    [Parameter] public string? SelectedRequestId { get; set; }
    [Parameter] public string? ActiveCollectionId { get; set; }
    [Parameter] public string? ActiveLinkedRootId { get; set; }
    [Parameter] public EventCallback<HttpRequestEntry> OnRequestSelected { get; set; }
    [Parameter] public EventCallback<string> OnCollectionSelected { get; set; }
    [Parameter] public EventCallback<string> OnLinkedRootSelected { get; set; }
    [Parameter] public EventCallback<(string CollectionId, ApiCollectionNode ParentNode)> OnAddFolder { get; set; }
    [Parameter] public EventCallback<(string CollectionId, ApiCollectionNode ParentNode)> OnAddRequest { get; set; }
    [Parameter] public EventCallback<(ApiCollectionNode Node, string NewName)> OnRenameNode { get; set; }
    [Parameter] public EventCallback<ApiCollectionNode> OnDeleteNode { get; set; }
    [Parameter] public EventCallback<(string CollectionId, string NewName)> OnRenameCollection { get; set; }
    [Parameter] public EventCallback<string> OnDeleteCollection { get; set; }
    [Parameter] public EventCallback<string> OnLinkCollectionToRepo { get; set; }
    [Parameter]
    public EventCallback<(string CollectionId, ApiCollectionNode DraggedNode, ApiCollectionNode? NewParent, int?
NewIndex)> OnMoveNode
    { get; set; }

    // Icon cache for performance - prevents re-renders on every parent render
    private static readonly Microsoft.FluentUI.AspNetCore.Components.Icon _iconChevronRight = new
Icons.Regular.Size16.ChevronRight();
    private static readonly Microsoft.FluentUI.AspNetCore.Components.Icon _iconChevronDown = new
Icons.Regular.Size16.ChevronDown();
    private static readonly Microsoft.FluentUI.AspNetCore.Components.Icon _iconFolder = new Icons.Regular.Size16.Folder();
    private static readonly Microsoft.FluentUI.AspNetCore.Components.Icon _iconFolderOpen = new
Icons.Regular.Size16.FolderOpen();
    private static readonly Microsoft.FluentUI.AspNetCore.Components.Icon _iconCollection = new
Icons.Regular.Size16.Folder();
    private static readonly Microsoft.FluentUI.AspNetCore.Components.Icon _iconLinked = new Icons.Regular.Size16.Globe();
    private static readonly Microsoft.FluentUI.AspNetCore.Components.Icon _iconAddFolder = new
Icons.Regular.Size16.AddSquare();
    private static readonly Microsoft.FluentUI.AspNetCore.Components.Icon _iconAddRequest = new Icons.Regular.Size16.Add();
    private static readonly Microsoft.FluentUI.AspNetCore.Components.Icon _iconRename = new Icons.Regular.Size16.Edit();
    private static readonly Microsoft.FluentUI.AspNetCore.Components.Icon _iconDelete = new Icons.Regular.Size16.Delete();

    private enum FlatTreeNodeKind
    {
        Group,
        Node,
        LinkedRoot,
    }

    private record FlatTreeNode(
        ApiCollectionNode Node,
        int Depth,
        bool IsExpanded,
        bool HasChildren,
        string CollectionId,
        FlatTreeNodeKind Kind = FlatTreeNodeKind.Node,
        LinkedCollectionTreeInfo? LinkedRoot = null)
    {
        public string Id => Node.Id;
    }

    private List<FlatTreeNode> _flatNodes = [];
    private List<FlatTreeNode> _visibleNodes = [];
    private string _filter = string.Empty;

    private IReadOnlyList<ApiCollection>? _prevCollections;
    private IReadOnlyList<LinkedCollectionTreeInfo>? _prevLinkedRoots;
    private string? _prevSelectedRequestId;

    protected override void OnParametersSet()
    {
        var collectionsChanged = !ReferenceEquals(_prevCollections, Collections);
        var linkedRootsChanged = !ReferenceEquals(_prevLinkedRoots, LinkedRoots);
        var selectionChanged = _prevSelectedRequestId != SelectedRequestId;

        if (collectionsChanged || linkedRootsChanged)
        {
            _prevCollections = Collections;
            _prevLinkedRoots = LinkedRoots;
            RebuildFlatTree();
        }
        else if (selectionChanged)
        {
            _prevSelectedRequestId = SelectedRequestId;
        }
    }

    protected override bool ShouldRender() => true;

    private void RebuildFlatTree()
    {
        _flatNodes = [];

        if (Collections.Any(c => !IsLinkedCollection(c.Id)))
        {
            AddGroup("__group__local", "Local Collections");
            foreach (var collection in Collections.Where(c => !IsLinkedCollection(c.Id)))
            {
                AddCollection(collection, depth: 1);
            }
        }

        if (LinkedRoots.Count > 0)
        {
            AddGroup("__group__linked", "Linked Repositories");
            foreach (var root in LinkedRoots)
            {
                AddLinkedRoot(root);
                if (_GetExpandedState($"__linked__{root.Id}", true))
                {
                    foreach (var collectionId in root.CollectionIds)
                    {
                        var collection = Collections.FirstOrDefault(c => c.Id == collectionId);
                        if (collection is not null)
                        {
                            AddCollection(collection, depth: 2);
                        }
                    }
                }
            }
        }

        ApplyFilter();
    }

    private void AddGroup(string id, string name)
    {
        var groupNode = new ApiCollectionNode
        {
            Id = id,
            Type = ApiCollectionNodeType.Folder,
            Name = name,
            IsExpanded = true,
        };
        _flatNodes.Add(new FlatTreeNode(groupNode, 0, true, false, string.Empty, FlatTreeNodeKind.Group));
    }

    private void AddLinkedRoot(LinkedCollectionTreeInfo root)
    {
        var rootNode = new ApiCollectionNode
        {
            Id = $"__linked__{root.Id}",
            Type = ApiCollectionNodeType.Folder,
            Name = root.Name,
            IsExpanded = _GetExpandedState($"__linked__{root.Id}", true),
        };

        _flatNodes.Add(new FlatTreeNode(
            Node: rootNode,
            Depth: 1,
            IsExpanded: rootNode.IsExpanded,
            HasChildren: root.CollectionIds.Count > 0,
            CollectionId: string.Empty,
            Kind: FlatTreeNodeKind.LinkedRoot,
            LinkedRoot: root));
    }

    private void AddCollection(ApiCollection collection, int depth)
    {
        var collectionRootNode = new ApiCollectionNode
        {
            Id = $"__col__{collection.Id}",
            Type = ApiCollectionNodeType.Folder,
            Name = collection.Name,
            IsExpanded = _GetExpandedState($"__col__{collection.Id}", true),
            Children = collection.Nodes,
        };

        _flatNodes.Add(new FlatTreeNode(
            Node: collectionRootNode,
            Depth: depth,
            IsExpanded: collectionRootNode.IsExpanded,
            HasChildren: collection.Nodes.Count > 0,
            CollectionId: collection.Id));

        if (collectionRootNode.IsExpanded)
        {
            FlattenNodes(collection.Nodes, depth + 1, collection.Id);
        }
    }

    private void FlattenNodes(List<ApiCollectionNode> nodes, int depth, string collectionId)
    {
        foreach (var node in nodes)
        {
            var isExpanded = _GetExpandedState(node.Id, node.IsExpanded);
            _flatNodes.Add(new FlatTreeNode(
                Node: node,
                Depth: depth,
                IsExpanded: isExpanded,
                HasChildren: node.Children.Count > 0,
                CollectionId: collectionId));

            if (node.Type == ApiCollectionNodeType.Folder && isExpanded)
            {
                FlattenNodes(node.Children, depth + 1, collectionId);
            }
        }
    }

    private readonly Dictionary<string, bool> _expandedOverrides = new(StringComparer.Ordinal);

    private bool _GetExpandedState(string nodeId, bool defaultExpanded) =>
        _expandedOverrides.TryGetValue(nodeId, out var val) ? val : defaultExpanded;

    private void ToggleExpand(FlatTreeNode flatNode)
    {
        var current = _GetExpandedState(flatNode.Node.Id, flatNode.Node.IsExpanded);
        _expandedOverrides[flatNode.Node.Id] = !current;
        RebuildFlatTree();
    }

    private void OnFilterInput(ChangeEventArgs e)
    {
        _filter = e.Value as string ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_filter))
        {
            _visibleNodes = _flatNodes;
            return;
        }

        _visibleNodes = _flatNodes
            .Where(n => n.Kind != FlatTreeNodeKind.Group && n.Node.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private async Task OnRowClickAsync(FlatTreeNode flatNode)
    {
        if (flatNode.Kind == FlatTreeNodeKind.Group)
        {
            return;
        }

        if (flatNode.Kind == FlatTreeNodeKind.LinkedRoot)
        {
            if (flatNode.LinkedRoot is not null)
            {
                await OnLinkedRootSelected.InvokeAsync(flatNode.LinkedRoot.Id);
            }

            ToggleExpand(flatNode);
            return;
        }

        if (flatNode.Node.Type == ApiCollectionNodeType.Folder)
        {
            if (flatNode.Node.Id.StartsWith("__col__", StringComparison.Ordinal))
            {
                await OnCollectionSelected.InvokeAsync(flatNode.CollectionId);
            }

            ToggleExpand(flatNode);
            return;
        }

        if (flatNode.Node.Request is not null)
        {
            await OnCollectionSelected.InvokeAsync(flatNode.CollectionId);
            await OnRequestSelected.InvokeAsync(flatNode.Node.Request);
        }
    }

    private void ShowContextMenu(MouseEventArgs e, FlatTreeNode node)
    {
        if (node.Kind != FlatTreeNodeKind.Node)
        {
            return;
        }

        _ctxNode = node;
        _ctxX = e.ClientX;
        _ctxY = e.ClientY;
    }

    private FlatTreeNode? _ctxNode;
    private double _ctxX;
    private double _ctxY;

    private string? _renamingNodeId;
    private string _renameValue = "";
    private ElementReference _renameInput;
    private bool _shouldFocusRename;

    private void BeginRenameCtx()
    {
        if (_ctxNode is null) return;
        _renamingNodeId = _ctxNode.Id;
        _renameValue = _ctxNode.Node.Name;
        _ctxNode = null;
        _shouldFocusRename = true;
    }

    private async Task AddSubFolderCtxAsync()
    {
        var node = _ctxNode;
        _ctxNode = null;
        if (node is not null) await OnAddFolder.InvokeAsync((node.CollectionId, node.Node));
    }

    private async Task AddRequestCtxAsync()
    {
        var node = _ctxNode;
        _ctxNode = null;
        if (node is not null) await OnAddRequest.InvokeAsync((node.CollectionId, node.Node));
    }

    private async Task LinkToRepoCtxAsync()
    {
        var node = _ctxNode;
        _ctxNode = null;
        if (node is not null)
            await OnLinkCollectionToRepo.InvokeAsync(node.CollectionId);
    }

    private async Task DeleteNodeCtxAsync()
    {
        var node = _ctxNode;
        _ctxNode = null;
        if (node is null) return;
        if (node.Node.Id.StartsWith("__col__", StringComparison.Ordinal))
            await OnDeleteCollection.InvokeAsync(node.CollectionId);
        else
            await OnDeleteNode.InvokeAsync(node.Node);
    }

    private async Task CommitRenameAsync()
    {
        if (_renamingNodeId is null) return;
        var flatNode = _flatNodes.FirstOrDefault(n => n.Id == _renamingNodeId);
        _renamingNodeId = null;
        if (flatNode is null || string.IsNullOrWhiteSpace(_renameValue)) return;

        if (flatNode.Node.Id.StartsWith("__col__", StringComparison.Ordinal))
        {
            if (_renameValue != flatNode.Node.Name)
                await OnRenameCollection.InvokeAsync((flatNode.CollectionId, _renameValue));
        }
        else if (_renameValue != flatNode.Node.Name)
        {
            await OnRenameNode.InvokeAsync((flatNode.Node, _renameValue));
        }
    }

    private async Task OnRenameKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CommitRenameAsync();
        else if (e.Key == "Escape") _renamingNodeId = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocusRename)
        {
            _shouldFocusRename = false;
            try { await _renameInput.FocusAsync(); }
            catch { }
        }
    }

    private string GetRowClass(FlatTreeNode node)
    {
        if (node.Kind == FlatTreeNodeKind.Group)
            return "collection-tree__row--group";
        if (node.Kind == FlatTreeNodeKind.LinkedRoot)
            return node.LinkedRoot?.Id == ActiveLinkedRootId
                ? "collection-tree__row--linked-root collection-tree__row--active-linked-root"
                : "collection-tree__row--linked-root";
        if (node.Node.Request?.Id == SelectedRequestId && SelectedRequestId is not null)
            return "collection-tree__row--selected";
        if (node.Node.Id == $"__col__{ActiveCollectionId}" && ActiveCollectionId is not null)
            return "collection-tree__row--active-collection";
        return string.Empty;
    }

    // ── Drag-and-drop reorder (native HTML5 drag events) ────────────────────────
    // Restricted to moves within a single collection (see ApiClientPage.OnMoveNodeAsync).

    private FlatTreeNode? _draggedNode;
    private string? _dragOverNodeId;

    private static bool CanDrag(FlatTreeNode node) =>
        node.Kind == FlatTreeNodeKind.Node && !node.Node.Id.StartsWith("__col__", StringComparison.Ordinal);

    private static bool CanDrop(FlatTreeNode node) => node.Kind == FlatTreeNodeKind.Node;

    private string GetDragClass(FlatTreeNode node)
    {
        if (_draggedNode is not null && _draggedNode.Id == node.Id)
            return "collection-tree__row--dragging";
        if (_dragOverNodeId == node.Id && _draggedNode is not null && _draggedNode.Id != node.Id)
            return "collection-tree__row--drop-target";
        return string.Empty;
    }

    private void OnDragStart(FlatTreeNode node)
    {
        if (!CanDrag(node)) return;
        _draggedNode = node;
    }

    private void OnDragOver(FlatTreeNode node)
    {
        if (_draggedNode is null || !CanDrop(node) || _dragOverNodeId == node.Id) return;
        _dragOverNodeId = node.Id;
        StateHasChanged();
    }

    private void OnDragLeave(FlatTreeNode node)
    {
        if (_dragOverNodeId != node.Id) return;
        _dragOverNodeId = null;
        StateHasChanged();
    }

    private void OnDragEnd()
    {
        _draggedNode = null;
        _dragOverNodeId = null;
        StateHasChanged();
    }

    private async Task OnDropAsync(FlatTreeNode target)
    {
        var dragged = _draggedNode;
        _draggedNode = null;
        _dragOverNodeId = null;
        StateHasChanged();

        if (dragged is null || !CanDrop(target)) return;
        if (dragged.Id == target.Id) return;
        if (dragged.CollectionId != target.CollectionId) return; // cross-collection moves not supported
        if (dragged.Node.Type == ApiCollectionNodeType.Folder && IsDescendant(dragged, target)) return;

        ApiCollectionNode? newParent;
        int? newIndex;

        if (target.Node.Type == ApiCollectionNodeType.Folder)
        {
            // Drop onto a folder or the collection root row → reparent as its last child.
            newParent = target.Node.Id.StartsWith("__col__", StringComparison.Ordinal) ? null : target.Node;
            newIndex = null;
        }
        else
        {
            // Drop onto a request row → reorder as a sibling at that position.
            newParent = FindParentOfFlatNode(target);
            newIndex = ComputeSiblingIndex(target, newParent);
        }

        await OnMoveNode.InvokeAsync((target.CollectionId, dragged.Node, newParent, newIndex));
    }

    /// <summary>
    /// True when <paramref name="candidate"/> is nested anywhere inside <paramref name="ancestor"/>'s
    /// subtree. <see cref="_flatNodes"/> is a pre-order DFS, so descendants of a node are exactly the
    /// contiguous run of rows after it whose depth is greater than its own.
    /// </summary>
    private bool IsDescendant(FlatTreeNode ancestor, FlatTreeNode candidate)
    {
        var startIndex = _flatNodes.FindIndex(n => n.Id == ancestor.Id);
        if (startIndex < 0) return false;

        for (var i = startIndex + 1; i < _flatNodes.Count; i++)
        {
            if (_flatNodes[i].Depth <= ancestor.Depth) break;
            if (_flatNodes[i].Id == candidate.Id) return true;
        }

        return false;
    }

    /// <summary>
    /// Finds the immediate parent folder node of <paramref name="target"/> by walking backwards
    /// through the flattened (pre-order) tree for the nearest preceding shallower row. Returns
    /// <c>null</c> when the parent is the collection root itself.
    /// </summary>
    private ApiCollectionNode? FindParentOfFlatNode(FlatTreeNode target)
    {
        var index = _flatNodes.FindIndex(n => n.Id == target.Id);
        for (var i = index - 1; i >= 0; i--)
        {
            var candidate = _flatNodes[i];
            if (candidate.Kind == FlatTreeNodeKind.Group) continue;
            if (candidate.Depth < target.Depth)
            {
                return candidate.Node.Id.StartsWith("__col__", StringComparison.Ordinal) ? null : candidate.Node;
            }
        }

        return null;
    }

    private int? ComputeSiblingIndex(FlatTreeNode target, ApiCollectionNode? parent)
    {
        var collection = Collections.FirstOrDefault(c => c.Id == target.CollectionId);
        if (collection is null) return null;

        var siblings = parent?.Children ?? collection.Nodes;
        var index = siblings.FindIndex(n => n.Id == target.Node.Id);
        return index >= 0 ? index : null;
    }

    private async Task HandleTreeKeyDown(KeyboardEventArgs e, FlatTreeNode node)
    {
        switch (e.Key)
        {
            case "ArrowUp":
                await FocusPreviousNode(node);
                break;
            case "ArrowDown":
                await FocusNextNode(node);
                break;
            case "ArrowRight":
                if (node.Node.Type == ApiCollectionNodeType.Folder)
                {
                    if (!node.IsExpanded)
                        ToggleExpand(node);
                    else
                        await FocusFirstChild(node);
                }
                break;
            case "ArrowLeft":
                if (node.Node.Type == ApiCollectionNodeType.Folder && node.IsExpanded)
                    ToggleExpand(node);
                else if (node.Depth > 0)
                    await FocusParentNode(node);
                break;
            case "Enter":
            case " ":
                await OnRowClickAsync(node);
                break;
            case "Home":
                await FocusFirstNode();
                break;
            case "End":
                await FocusLastNode();
                break;
            case "PageUp":
                await FocusPageUp(node);
                break;
            case "PageDown":
                await FocusPageDown(node);
                break;
        }
    }

    private async Task FocusPreviousNode(FlatTreeNode currentNode)
    {
        var currentIndex = _visibleNodes.FindIndex(n => n.Id == currentNode.Id);
        if (currentIndex > 0)
        {
            var previousNode = _visibleNodes[currentIndex - 1];
            if (previousNode.Kind != FlatTreeNodeKind.Group)
            {
                var requestId = previousNode.Node.Request?.Id;
                if (requestId is not null)
                {
                    SelectedRequestId = requestId;
                    await OnRequestSelected.InvokeAsync(previousNode.Node.Request!);
                }
                else if (previousNode.Node.Type == ApiCollectionNodeType.Folder)
                {
                    // For folders, we don't change selection but allow focus
                }
            }
            else
            {
                // Skip groups and try previous
                await FocusPreviousNode(previousNode);
            }
        }
    }

    private async Task FocusNextNode(FlatTreeNode currentNode)
    {
        var currentIndex = _visibleNodes.FindIndex(n => n.Id == currentNode.Id);
        if (currentIndex < _visibleNodes.Count - 1)
        {
            var nextNode = _visibleNodes[currentIndex + 1];
            if (nextNode.Kind != FlatTreeNodeKind.Group)
            {
                var requestId = nextNode.Node.Request?.Id;
                if (requestId is not null)
                {
                    SelectedRequestId = requestId;
                    await OnRequestSelected.InvokeAsync(nextNode.Node.Request!);
                }
                else if (nextNode.Node.Type == ApiCollectionNodeType.Folder)
                {
                    // For folders, we don't change selection but allow focus
                }
            }
            else
            {
                // Skip groups and try next
                await FocusNextNode(nextNode);
            }
        }
    }

    private async Task FocusParentNode(FlatTreeNode currentNode)
    {
        // Find parent node in the flat structure
        var parentId = GetParentId(currentNode);
        if (parentId is not null)
        {
            var parentNode = _visibleNodes.FirstOrDefault(n => n.Id == parentId);
            if (parentNode is not null)
            {
                // Focus parent but don't select it
            }
        }
    }

    private async Task FocusFirstChild(FlatTreeNode parentNode)
    {
        // This would require tracking children relationships, which is complex with virtualization
        // For now, just select the next visible node that's a child
        var currentIndex = _visibleNodes.FindIndex(n => n.Id == parentNode.Id);
        if (currentIndex < _visibleNodes.Count - 1)
        {
            var nextNode = _visibleNodes[currentIndex + 1];
            if (nextNode.Depth > parentNode.Depth && nextNode.Kind != FlatTreeNodeKind.Group)
            {
                var requestId = nextNode.Node.Request?.Id;
                if (requestId is not null)
                {
                    SelectedRequestId = requestId;
                    await OnRequestSelected.InvokeAsync(nextNode.Node.Request!);
                }
            }
        }
    }

    private async Task FocusFirstNode()
    {
        var firstNode = _visibleNodes.FirstOrDefault(n => n.Kind != FlatTreeNodeKind.Group);
        if (firstNode?.Node.Request is not null)
        {
            SelectedRequestId = firstNode.Node.Request.Id;
            await OnRequestSelected.InvokeAsync(firstNode.Node.Request);
        }
    }

    private async Task FocusLastNode()
    {
        var lastNode = _visibleNodes.LastOrDefault(n => n.Kind != FlatTreeNodeKind.Group);
        if (lastNode?.Node.Request is not null)
        {
            SelectedRequestId = lastNode.Node.Request.Id;
            await OnRequestSelected.InvokeAsync(lastNode.Node.Request);
        }
    }

    private async Task FocusPageUp(FlatTreeNode currentNode)
    {
        var currentIndex = _visibleNodes.FindIndex(n => n.Id == currentNode.Id);
        var newIndex = Math.Max(0, currentIndex - 10);
        var targetNode = _visibleNodes[newIndex];
        if (targetNode.Kind != FlatTreeNodeKind.Group && targetNode.Node.Request is not null)
        {
            SelectedRequestId = targetNode.Node.Request.Id;
            await OnRequestSelected.InvokeAsync(targetNode.Node.Request);
        }
    }

    private async Task FocusPageDown(FlatTreeNode currentNode)
    {
        var currentIndex = _visibleNodes.FindIndex(n => n.Id == currentNode.Id);
        var newIndex = Math.Min(_visibleNodes.Count - 1, currentIndex + 10);
        var targetNode = _visibleNodes[newIndex];
        if (targetNode.Kind != FlatTreeNodeKind.Group && targetNode.Node.Request is not null)
        {
            SelectedRequestId = targetNode.Node.Request.Id;
            await OnRequestSelected.InvokeAsync(targetNode.Node.Request);
        }
    }

    private string? GetParentId(FlatTreeNode node)
    {
        // This is simplified - in a real implementation, we'd need to track parent relationships
        if (node.Depth > 0)
        {
            // Try to find the parent by looking for a node at the previous depth level
            for (int i = _visibleNodes.Count - 1; i >= 0; i--)
            {
                var candidate = _visibleNodes[i];
                if (candidate.Depth == node.Depth - 1 && candidate.Kind != FlatTreeNodeKind.Group)
                {
                    // Check if this node would be a parent (next nodes have higher depth)
                    if (i + 1 < _visibleNodes.Count)
                    {
                        var nextNode = _visibleNodes[i + 1];
                        if (nextNode.Depth > candidate.Depth)
                        {
                            return candidate.Id;
                        }
                    }
                }
            }
        }
        return null;
    }

    private static string GetMethodLabel(ApiRequestMethod method) => method switch
    {
        ApiRequestMethod.Get => "GET",
        ApiRequestMethod.Post => "POST",
        ApiRequestMethod.Put => "PUT",
        ApiRequestMethod.Patch => "PATCH",
        ApiRequestMethod.Delete => "DEL",
        ApiRequestMethod.Head => "HEAD",
        ApiRequestMethod.Options => "OPT",
        ApiRequestMethod.GraphQl => "GQL",
        ApiRequestMethod.WebSocket => "WS",
        _ => "GET",
    };

    private bool IsLinkedCollection(string collectionId) =>
        LinkedRoots.Any(root => root.CollectionIds.Contains(collectionId));
