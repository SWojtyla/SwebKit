@using BlazorMonaco
@using BlazorMonaco.Editor
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="unified-body-editor">
    @if (!_monacoLoaded)
    {
        <div class="unified-body-editor__loading">
            <span class="unified-body-editor__loading-spinner"></span>
            Loading editor…
        </div>
    }
    else if (_monacoFailed)
    {
        <textarea class="unified-body-editor__fallback" value="@Value" @oninput="OnFallbackInputAsync"
                  placeholder="@Placeholder" spellcheck="false"></textarea>
    }
    else
    {
        <StandaloneCodeEditor @ref="_editor" ConstructionOptions="EditorOptions"
                              OnDidChangeModelContent="OnContentChangedAsync" OnDidInit="OnEditorInitAsync"
                              OnDidChangeCursorPosition="OnCursorChangedAsync" />
        <div class="unified-body-editor__status-bar" aria-hidden="true">
            <span class="unified-body-editor__status-cursor">Ln @_cursorLine, Col @_cursorCol</span>
            <span class="unified-body-editor__status-sep">│</span>
            <span class="unified-body-editor__status-lang">@LanguageLabel</span>
            @if (BodyMode == RequestBodyMode.Json && !string.IsNullOrWhiteSpace(Value))
            {
                <span class="unified-body-editor__status-sep">│</span>
                <span
                    class="unified-body-editor__status-valid @(_isValidJson ? "unified-body-editor__status-valid--ok" : "unified-body-editor__status-valid--err")">
                    <FluentIcon Value="@(_isValidJson ? _iconCheckmark : _iconWarning)" Width="12px" /> @(_isValidJson ? "Valid JSON" : "Invalid JSON")
                </span>
            }
        </div>
    }
</div>

@code {
    // ── Icons (Phase 1: FluentIcon vocabulary) ─────────────────────────────────
    private static readonly Icon _iconCheckmark = new Icons.Regular.Size16.Checkmark();
    private static readonly Icon _iconWarning = new Icons.Regular.Size16.Warning();

    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public RequestBodyMode BodyMode { get; set; } = RequestBodyMode.Json;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Enter request body…";
    [Parameter] public int Height { get; set; } = 300;

    private StandaloneCodeEditor? _editor;
    private bool _monacoLoaded;
    private bool _monacoLoading;
    private bool _monacoFailed;
    private long _cursorLine = 1;
    private long _cursorCol = 1;
    private bool _isValidJson = true;

    private string Language => BodyMode switch
    {
        RequestBodyMode.Json => "json",
        RequestBodyMode.Xml => "xml",
        RequestBodyMode.Text => "plaintext",
        _ => "plaintext"
    };

    private string LanguageLabel => BodyMode switch
    {
        RequestBodyMode.Json => "JSON",
        RequestBodyMode.Xml => "XML",
        RequestBodyMode.Text => "Text",
        _ => "Plain"
    };

    private StandaloneEditorConstructionOptions EditorOptions(StandaloneCodeEditor _) => new()
    {
        Language = Language,
        Theme = "swebkit-dark",
        Value = Value,
        AutomaticLayout = true,
        Minimap = new EditorMinimapOptions { Enabled = false },
        ScrollBeyondLastLine = false,
        FontSize = 13,
        LineNumbers = "on",
        Folding = true,
        WordWrap = "on",
        Dimension = new Dimension { Height = Height }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await EnsureMonacoAsync();
    }

    protected override void OnParametersSet()
    {
        // No need to update language dynamically for now
        // Language is set when the editor is initialized
    }

    private async Task EnsureMonacoAsync()
    {
        if (_monacoLoaded || _monacoLoading) return;
        _monacoLoading = true;
        try
        {
            await JS.InvokeVoidAsync("SwebKitUi.ensureMonacoLoaded");
            _monacoLoaded = true;
        }
        catch (JSException)
        {
            _monacoFailed = true;
        }
        finally
        {
            _monacoLoading = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnContentChangedAsync(ModelContentChangedEvent _)
    {
        if (_editor is null) return;
        var newValue = await _editor.GetValue();
        if (Value == newValue) return;

        Value = newValue;
        ValidateJson();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnEditorInitAsync()
    {
        if (_editor is not null && !string.IsNullOrEmpty(Value))
        {
            await _editor.SetValue(Value);
        }
        // Correct the Monaco theme in case construction options set the wrong one
        await JS.InvokeVoidAsync("SwebKitUi.applyMonacoTheme");
        ValidateJson();
    }

    private Task OnCursorChangedAsync(CursorPositionChangedEvent e)
    {
        _cursorLine = e.Position.LineNumber;
        _cursorCol = e.Position.Column;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ValidateJson()
    {
        if (BodyMode != RequestBodyMode.Json || string.IsNullOrWhiteSpace(Value))
        {
            _isValidJson = true;
            return;
        }
        try
        {
            System.Text.Json.JsonDocument.Parse(Value);
            _isValidJson = true;
        }
        catch
        {
            _isValidJson = false;
        }
    }

    private async Task OnFallbackInputAsync(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }
}
