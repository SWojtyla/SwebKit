@* CollectionVariableEditor — edits the collection-level variable list *@
@inject CollectionRepository CollectionRepo
@inject ILogger<CollectionVariableEditor> Logger

<div class="collection-var-editor">
    <div class="collection-var-editor__header">
        <span class="collection-var-editor__title">Collection Variables</span>
        <small class="collection-var-editor__subtitle">Active regardless of selected environment</small>
    </div>

    <div class="collection-var-editor__cols">
        <span class="collection-var-editor__col-label"></span>
        <span class="collection-var-editor__col-label">KEY</span>
        <span class="collection-var-editor__col-label">TYPE</span>
        <span class="collection-var-editor__col-label">VALUE</span>
        <span></span>
    </div>

    @foreach (var v in _vars)
    {
        <div class="collection-var-editor__row">
            <input type="checkbox" class="collection-var-editor__enabled" checked="@v.IsEnabled"
                   @onchange="e => OnVarChanged(v, isEnabled: (bool)(e.Value ?? true))" />
            <input type="text" class="collection-var-editor__key" placeholder="key" value="@v.Key"
                   @oninput="e => OnVarChanged(v, key: e.Value?.ToString() ?? string.Empty)" />
            <button type="button" class="collection-var-editor__type-btn" @onclick="() => ToggleGenerated(v)">
                @(v.Generator is null ? "Plain" : "Generated")
            </button>
            @if (v.Generator is null)
            {
                <input type="text" class="collection-var-editor__value" placeholder="value" value="@v.Value"
                       @oninput="e => OnVarChanged(v, value: e.Value?.ToString())" />
            }
            else
            {
                <VariableGeneratorEditor Definition="@v.Generator" />
            }
            <button type="button" class="collection-var-editor__delete" title="Remove" @onclick="() => RemoveVar(v)">
                <FluentIcon Value="@_iconDelete" Width="12px" />
            </button>
        </div>
    }

    <button type="button" class="collection-var-editor__add-btn" @onclick="AddVar">+ Add Variable</button>

    <div class="collection-var-editor__actions">
        <button type="button" class="collection-var-editor__btn collection-var-editor__btn--primary"
                @onclick="SaveAsync">Save</button>
        <button type="button" class="collection-var-editor__btn"
                @onclick="() => OnCancelled.InvokeAsync()">Cancel</button>
    </div>
</div>

@code {
    // ── Icons (Phase 1: FluentIcon vocabulary) ─────────────────────────────────
    private static readonly Icon _iconDelete = new Icons.Regular.Size16.Delete();

    [Parameter, EditorRequired] public ApiCollection Collection { get; set; } = null!;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    // Local mutable copy so Cancel discards changes
    private List<CollectionVariable> _vars = [];
    private ApiCollection? _lastCollection;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_lastCollection, Collection)) return; // BL-5
        _lastCollection = Collection; // BL-3
        _vars = Collection.Variables
            .Select(v => new CollectionVariable
            {
                Key = v.Key,
                Value = v.Value,
                Generator = CloneGenerator(v.Generator),
                IsEnabled =
v.IsEnabled
            })
            .ToList();
    }

    private void OnVarChanged(CollectionVariable v,
        bool? isEnabled = null, string? key = null, string? value = null)
    {
        if (isEnabled.HasValue) v.IsEnabled = isEnabled.Value;
        if (key is not null) v.Key = key;
        if (value is not null) v.Value = value;
    }

    private void AddVar()
    {
        _vars.Add(new CollectionVariable { IsEnabled = true });
    }

    private void ToggleGenerated(CollectionVariable variable)
    {
        if (variable.Generator is null)
        {
            variable.Generator = new VariableGeneratorDefinition();
            variable.Value = null;
        }
        else
        {
            variable.Generator = null;
        }
    }

    private void RemoveVar(CollectionVariable v)
    {
        _vars.Remove(v);
    }

    private static VariableGeneratorDefinition? CloneGenerator(VariableGeneratorDefinition? generator) =>
        generator is null
            ? null
            : new VariableGeneratorDefinition
            {
                Kind = generator.Kind,
                MinInt = generator.MinInt,
                MaxInt = generator.MaxInt,
                MinDecimal = generator.MinDecimal,
                MaxDecimal = generator.MaxDecimal,
                DecimalPlaces = generator.DecimalPlaces,
                TrueWeightPercent = generator.TrueWeightPercent,
                FakerCategory = generator.FakerCategory,
                Template = generator.Template,
                Values = generator.Values.ToList(),
            };

    private async Task SaveAsync()
    {
        // Remove blank key rows, then flush back to the collection
        Collection.Variables = _vars.Where(v => !string.IsNullOrWhiteSpace(v.Key)).ToList();
        await CollectionRepo.UpdateCollectionAsync(Collection);
        await OnSaved.InvokeAsync();
    }
}
