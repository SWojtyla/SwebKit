@using SwebKit.Core.Services
@using System.Threading

@page "/api-client"
@inject IFolderPickerService FolderPicker
@inject CollectionRepository CollectionRepo
@inject EnvironmentRepository EnvironmentRepo
@inject LinkedCollectionRootRepository LinkedRootRepo
@inject LinkedCollectionFileService LinkedFileService
@inject BrunoSyncService BrunoSync
@inject CollectionImportService ImportService
@inject BrunoCollectionExporter BrunoExporter
@inject ApiClientWorkflowService WorkflowService
@inject ICredentialStore CredentialStore
@inject UserSettingsRepository UserSettings
@inject NavigationManager Nav
@inject ILogger<ApiClientPage> Logger
@inject IJSRuntime JS
@inject IAppEventBus Events
@inject CommandRegistry Commands
@inject AppStateService AppState
@implements IAsyncDisposable

<div class="api-client-page" role="application" aria-label="API Client">

    @* ── Toolbar ── *@
    <ApiClientToolbar State="_state" CanCreateRequest="CanCreateRequest" IsRepoMenuActive="IsRepoMenuActive"
                      IsVariableMenuActive="IsVariableMenuActive"
                      CurrentTargetLinkedRootPresent="@(CurrentTargetLinkedRoot is not null)" CurrentTargetLabel="CurrentTargetLabel"
                      CurrentTargetHint="CurrentTargetHint" EnvsWorksheetActive="@(_state.WorksheetMode == WorksheetEnvs)"
                      ActiveEnvironment="ActiveEnvironment" OnNewCollection="OpenNewCollectionDialog" OnAddRequest="AddRequestAsync"
                      OnSaveRequest="SaveRequestAsync" OnAddGitRepo="OpenLinkedRootDialogFromMenu"
                      OnGitForSelectedRepo="OpenCurrentTargetGitFromMenu" OnManageGitRepos="OpenLinkedRootManagementFromMenu"
                      OnImportCurl="OpenCurlImportDialogFromMenu" OnImportCollection="OpenCollectionImportDialogFromMenu"
                      OnExportCollection="OpenCollectionExportDialogFromMenu" OnReloadLinkedConflict="ReloadLinkedConflictAsync"
                      OnKeepMineLinkedConflict="KeepMineLinkedConflictAsync"
                      OnSaveLinkedConflictAsCopy="SaveLinkedConflictAsCopyAsync" OnCopyCurl="CopyCurlAsync"
                      OnOpenCollectionVariables="OpenCollectionVariablesFromMenu"
                      OnOpenRequestVariables="OpenRequestVariablesFromMenu" OnToggleEnvsWorksheet="ToggleEnvsWorksheet"
                      OnSelectEnvironment="SelectEnvAsync"
                      BrunoSyncAvailable="@(CurrentTargetLinkedRoot?.Config.BrunoSyncFolderPath is not null)"
                      BrunoSyncEnabled="@(CurrentTargetLinkedRoot?.Config.BrunoSyncEnabled ?? false)"
                      OnToggleBrunoSync="ToggleBrunoSyncAsync" />

    @* ── Main split: collection tree + request workspace ── *@
    <ApiClientWorkspace State="_state" CanCreateRequest="CanCreateRequest" MissingSecretNames="MissingSecretNames"
                        RequestTabsEnabled="@UserSettings.Settings.ApiClientRequestTabs" OnAddCollection="AddCollectionAsync"
                        OnAddApiRepo="OpenLinkedRootDialog" OnRequestSelected="OnRequestSelectedAsync"
                        OnCollectionSelected="OnCollectionSelectedAsync" OnTabSelected="OnTabSelectedAsync"
                        OnTabCloseRequested="OnTabCloseRequestedAsync" OnAddFolder="OnAddFolderAsync"
                        OnAddRequestInFolder="OnAddRequestInFolderAsync" OnRenameNode="OnRenameNodeAsync"
                        OnDeleteNode="OnDeleteNodeAsync" OnLinkedRootSelected="OnLinkedRootSelectedAsync"
                        OnRenameCollection="OnRenameCollectionAsync" OnDeleteCollection="OnDeleteCollectionAsync"
                        OnLinkCollectionToRepo="OnLinkCollectionToRepoAsync" OnMoveNode="OnMoveNodeAsync"
                        OnReimportFromBruno="ReimportFromBrunoAsync" OnExportToBrunoFolder="ExportToBrunoFolderAsync"
                        OnEnvironmentsChanged="OnEnvironmentsChangedAsync" OnCollectionVariablesSaved="OnCollVarEditorSavedAsync"
                        OnRefreshLinkedRoots="LoadLinkedRootsAsync" OnOpenGitPanel="OpenGitPanelAsync"
                        OnRemoveLinkedRoot="RemoveLinkedRootAsync" OnAddRequest="AddRequestAsync"
                        OnRequestChanged="OnRequestChangedAsync" OnRequestResult="OnRequestResultAsync"
                        OnSubscriptionMessage="OnSubscriptionMessageAsync" OnSubscriptionStopped="OnSubscriptionStoppedAsync"
                        OnResendHistoryEntry="OnResendHistoryEntryAsync" OnSaveResponseExample="SaveResponseExampleAsync"
                        OnConfigureSecret="OpenConfigureSecretDialog" />
</div>

@if (_state.BrunoSyncWarning is not null)
{
    <div class="api-client-bruno-sync-warning">
        <span>@_state.BrunoSyncWarning</span>
        <button type="button" class="api-client-bruno-sync-warning__dismiss"
                @onclick="() => _state.BrunoSyncWarning = null">×</button>
    </div>
}

@* ── New collection dialog ── *@
@if (_showNewCollectionDialog)
{
    <div class="api-client-dialog-backdrop" @onclick="() => _showNewCollectionDialog = false"></div>
    <div class="api-client-dialog" role="dialog" aria-modal="true" aria-label="New Collection">
        <div class="api-client-dialog__title">New Collection</div>
        <input type="text" class="api-client-dialog__input" placeholder="Collection name…" value="@_newCollectionName"
               @oninput="e => _newCollectionName = e.Value?.ToString() ?? string.Empty"
               @onkeydown="OnNewCollectionKeyDownAsync" @ref="_newCollectionInput" />
        <div class="api-client-dialog__actions">
            <AppButton Variant="Primary" Size="Small" CssClass="api-client-dialog__btn api-client-dialog__btn--primary"
                       Disabled="@(string.IsNullOrWhiteSpace(_newCollectionName))" OnClick="ConfirmNewCollectionAsync">Create
            </AppButton>
            <AppButton Variant="Secondary" Size="Small" CssClass="api-client-dialog__btn"
                       OnClick="@(() => _showNewCollectionDialog = false)">Cancel</AppButton>
        </div>
    </div>
}

@* ── Close dirty tab confirm dialog (Phase 3, Task 5) ── *@
@if (_showTabCloseConfirmDialog)
{
    <div class="api-client-dialog-backdrop" @onclick="CancelTabCloseConfirm"></div>
    <div class="api-client-dialog" role="dialog" aria-modal="true" aria-label="Unsaved changes">
        <div class="api-client-dialog__title">Unsaved changes</div>
        <div class="api-client-dialog__hint">This request has unsaved changes. Save before closing the tab?</div>
        <div class="api-client-dialog__actions">
            <AppButton Variant="Primary" Size="Small" CssClass="api-client-dialog__btn api-client-dialog__btn--primary"
                       OnClick="SaveAndCloseTabAsync">Save</AppButton>
            <AppButton Variant="Secondary" Size="Small" CssClass="api-client-dialog__btn" OnClick="DiscardAndCloseTabAsync">
                Discard</AppButton>
                <AppButton Variant="Secondary" Size="Small" CssClass="api-client-dialog__btn" OnClick="CancelTabCloseConfirm">
                    Cancel</AppButton>
                </div>
            </div>
        }

        @* ── Add API repo dialog ── *@
        @if (_showLinkedRootDialog)
        {
            <div class="api-client-dialog-backdrop" @onclick="() => _showLinkedRootDialog = false"></div>
            <div class="api-client-dialog api-client-dialog--wide" role="dialog" aria-modal="true" aria-label="Add API Repository">
                <div class="api-client-dialog__title">Add API Repository</div>
                <div class="api-client-dialog__hint">
                    Choose a Git repository folder, or an existing .swebkit-api folder. SwebKit keeps API request files there so
                    they can be committed with that repo. Optionally specify a Bruno collection folder to import and keep in sync.
                </div>
                <input type="text" class="api-client-dialog__input" placeholder="Display name (optional)"
                       value="@_newLinkedRootName" @oninput="e => _newLinkedRootName = e.Value?.ToString() ?? string.Empty" />
                <div class="api-client-dialog__path-row">
                    <input type="text" class="api-client-dialog__input" placeholder="Path to Git repo or .swebkit-api folder"
                           value="@_newLinkedRootPath" @oninput="e => _newLinkedRootPath = e.Value?.ToString() ?? string.Empty"
                           @ref="_newLinkedRootInput" />
                    <AppButton Variant="Secondary" Size="Small" CssClass="api-client-dialog__btn"
                               OnClick="PickLinkedRootFolderAsync">…</AppButton>
                </div>
                <div class="api-client-dialog__path-row">
                    <input type="text" class="api-client-dialog__input" placeholder="Bruno collection folder (optional — import & sync)"
                           value="@_newLinkedRootBrunoFolder" @oninput="e => _newLinkedRootBrunoFolder = e.Value?.ToString() ?? string.Empty" />
                    <AppButton Variant="Secondary" Size="Small" CssClass="api-client-dialog__btn"
                               OnClick="PickBrunoFolderAsync">…</AppButton>
                </div>
                @if (_linkedRootError is not null)
                {
                    <div class="api-client-dialog__error">@_linkedRootError</div>
                }
                <div class="api-client-dialog__actions">
                    <AppButton Variant="Primary" Size="Small" CssClass="api-client-dialog__btn api-client-dialog__btn--primary"
                               Disabled="@(string.IsNullOrWhiteSpace(_newLinkedRootPath))" OnClick="ConfirmLinkedRootAsync">Add repo
                    </AppButton>
                    <AppButton Variant="Secondary" Size="Small" CssClass="api-client-dialog__btn"
                               OnClick="@(() => _showLinkedRootDialog = false)">Cancel</AppButton>
                </div>
            </div>
        }

        @if (_showConfigureSecretDialog)
        {
            <div class="api-client-dialog-backdrop" @onclick="() => _showConfigureSecretDialog = false"></div>
            <div class="api-client-dialog" role="dialog" aria-modal="true" aria-label="Configure linked secret">
                <div class="api-client-dialog__title">Configure Secret</div>
                <div class="api-client-dialog__hint">@(_secretNameToConfigure ?? "Select a missing secret")</div>
                <input type="password" class="api-client-dialog__input" placeholder="Secret value stored locally"
                       value="@_secretValueToConfigure"
                       @oninput="e => _secretValueToConfigure = e.Value?.ToString() ?? string.Empty" />
                @if (_secretConfigError is not null)
                {
                    <div class="api-client-dialog__error">@_secretConfigError</div>
                }
                <div class="api-client-dialog__actions">
                    <AppButton Variant="Primary" Size="Small" CssClass="api-client-dialog__btn api-client-dialog__btn--primary"
                               Disabled="@(string.IsNullOrWhiteSpace(_secretNameToConfigure) || string.IsNullOrEmpty(_secretValueToConfigure))"
                               OnClick="SaveConfiguredSecretAsync">Save Secret</AppButton>
                    <AppButton Variant="Secondary" Size="Small" CssClass="api-client-dialog__btn"
                               OnClick="@(() => _showConfigureSecretDialog = false)">Cancel</AppButton>
                </div>
            </div>
        }

        @if (_showCurlImportDialog)
        {
            <div class="api-client-dialog-backdrop" @onclick="() => _showCurlImportDialog = false"></div>
            <div class="api-client-dialog api-client-dialog--wide" role="dialog" aria-modal="true" aria-label="Import cURL">
                <div class="api-client-dialog__title">Import cURL</div>
                <div class="api-client-dialog__hint">Paste a cURL command. SwebKit will create a request in the active collection.
                </div>
                <textarea class="api-client-dialog__textarea" placeholder="curl https://api.example.com ..."
                          value="@_curlImportText" @oninput="e => _curlImportText = e.Value?.ToString() ?? string.Empty"></textarea>
                @if (_curlImportError is not null)
                {
                    <div class="api-client-dialog__error">@_curlImportError</div>
                }
                <div class="api-client-dialog__actions">
                    <AppButton Variant="Primary" Size="Small" CssClass="api-client-dialog__btn api-client-dialog__btn--primary"
                               Disabled="@(string.IsNullOrWhiteSpace(_curlImportText) || _state.ActiveCollection is null)"
                               OnClick="ImportCurlAsync">Import</AppButton>
                    <AppButton Variant="Secondary" Size="Small" CssClass="api-client-dialog__btn"
                               OnClick="@(() => _showCurlImportDialog = false)">Cancel</AppButton>
                </div>
            </div>
        }

@* ── Delete collection confirm ── *@
<ConfirmDialog Visible="@(_pendingDeleteCollectionId is not null)" Title="Delete collection?"
               Message="@($"Delete \"{_pendingDeleteCollectionName}\" and all its requests? This cannot be undone.")"
               ConfirmLabel="Delete" OnConfirm="ConfirmDeleteCollectionAsync"
               OnCancel="@(() => { _pendingDeleteCollectionId = null; _pendingDeleteCollectionName = null; })" />

        @* ── Export / Import dialog ── *@
        <CollectionExportDialog Visible="@_showExportDialog" Collection="@_state.ActiveCollection"
                                Environments="@_state.Environments" InitialTab="@_exportDialogInitialTab"
                                TargetLinkedRootApiPath="@(CurrentTargetLinkedRoot?.ApiRootPath)" OnClose="@(() => _showExportDialog = false)"
                                OnImported="@OnCollectionImportedAsync" OnBrunoFolderImported="@OnBrunoFolderImportedAsync" />

@code {
    // ── Icons (Phase 1: FluentIcon vocabulary, reused across the page) ─────────
    private static readonly Icon _iconChevronDown = new Icons.Regular.Size16.ChevronDown();
    private static readonly Icon _iconDirtyDot = new Icons.Filled.Size12.Circle();

    // ── State ─────────────────────────────────────────────────────────────────
    // Page-scoped state container (DEC-UX-3): not DI-registered, one instance per page.
    private readonly ApiClientState _state = new();

    // Ensures only one background initialization/reload runs at a time.
    private readonly SemaphoreSlim _initLock = new(1, 1);

    // Curl import/export dialog state + handlers: see ApiClientPage.Curl.cs
    // Secret configuration dialog state + handlers: see ApiClientPage.Secrets.cs

    // Request history cap, subscription state cap, auto-save debounce state + handlers: see
    // ApiClientPage.Requests.cs

    // Worksheet mode constants — aliases of ApiClientState's public consts (single source of
    // truth, Phase 2 Task 5), kept as page-local const so existing unqualified call sites below
    // don't need to change.
    private const string WorksheetEnvs = ApiClientState.WorksheetEnvs;
    private const string WorksheetVars = ApiClientState.WorksheetVars;
    private const string WorksheetLinkedRoots = ApiClientState.WorksheetLinkedRoots;
    private const string WorksheetGit = ApiClientState.WorksheetGit;
    private const string WorksheetVariables = ApiClientState.WorksheetVariables;

    // New-collection / linked-root / delete-collection / export dialog state + handlers: see
    // ApiClientPage.Collections.cs

    // Close-dirty-tab confirm dialog state + handlers: see ApiClientPage.Tabs.cs

    // ── Computed ──────────────────────────────────────────────────────────────
    // Active environment resolves per active collection: a per-collection selection takes precedence
    // over the global fallback, and a resolved environment scoped to a *different* collection is
    // ignored (guards against stale references after switching collections).
    private ApiEnvironment? ActiveEnvironment
    {
        get
        {
            var collectionId = _state.ActiveCollection?.Id;
            string? envId = null;
            if (collectionId is not null &&
                EnvironmentRepo.UiState.ActiveEnvironmentIdByCollection.TryGetValue(collectionId, out var perCollection))
            {
                envId = perCollection;
            }
            envId ??= _state.ActiveEnvironmentId;

            var env = _state.Environments.FirstOrDefault(e => e.Id == envId);
            if (env is not null && env.CollectionId is not null && env.CollectionId != collectionId)
                return null;
            return env;
        }
    }

    private LinkedCollectionRootLoadResult? ActiveGitRoot =>
        _state.LinkedRootResults.FirstOrDefault(root => root.Config.Id == _state.ActiveGitRootId);

    private LinkedCollectionRootLoadResult? ActiveLinkedRoot =>
        _state.LinkedRootResults.FirstOrDefault(root => root.Config.Id == _state.ActiveLinkedRootId);

    private LinkedCollectionRootLoadResult? CurrentTargetLinkedRoot =>
        ActiveLinkedRoot ?? (_state.ActiveCollection is not null ? FindLinkedRootForCollection(_state.ActiveCollection.Id) :
null);

    private string CurrentTargetLabel => CurrentTargetLinkedRoot is { } linkedRoot
        ? $"Repo — {linkedRoot.DisplayName}"
        : _state.ActiveCollection is not null
            ? $"Local — {_state.ActiveCollection.Name}"
            : "Local collections";

    private string CurrentTargetHint => CurrentTargetLinkedRoot is { } linkedRoot
        ? $"New collections are created in {linkedRoot.ApiRootPath}. New requests require a collection inside that linked repo."
        : _state.ActiveCollection is not null
            ? $"New requests are created in local collection '{_state.ActiveCollection.Name}'."
            : "New collections are created in local SwebKit storage.";

    private bool CanCreateRequest => GetRequestTargetCollection() is not null;

    private bool IsRepoMenuActive => _state.WorksheetMode is WorksheetLinkedRoots or WorksheetGit;

    private bool IsVariableMenuActive => _state.WorksheetMode is WorksheetVars or WorksheetVariables;

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _state.AutoSave = UserSettings.Settings.AutoSaveRequests;

        // Kick Monaco asset load in the background so it is ready before the user opens a GQL request.
        // Fire-and-forget: failures are handled inside monacoLoader.js.
        _ = JS.InvokeVoidAsync("SwebKitUi.ensureMonacoLoaded").AsTask();

        // Register keyboard shortcuts in the command palette
        RegisterApiClientCommands();

        // Subscribe to keyboard shortcut events published by MainLayout
        Events.Subscribe<ApiClientShortcutEvent>(OnApiClientShortcut);

        // Subscribe to demo mode changes to show/hide demo collections
        AppState.DemoModeChanged += OnDemoModeChanged;

        // Render the page immediately with the loading indicator, then load data in the
        // background so the UI stays fluid when disk/Git I/O is slow.
        _ = InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        await _initLock.WaitAsync();
        try
        {
            _state.LoadingCollections = true;
            await InvokeAsync(StateHasChanged);

            // Load local collections/environments first, then merge linked roots into the collection list.
            await Task.WhenAll(LoadCollectionsAsync(), LoadEnvironmentsAsync());
            await LoadLinkedRootsAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize API client");
        }
        finally
        {
            _state.LoadingCollections = false;
            await InvokeAsync(StateHasChanged);
            _initLock.Release();
        }
    }

    // LoadCollectionsAsync: see ApiClientPage.Collections.cs

    private void OnDemoModeChanged() => _ = OnDemoModeChangedAsync();

    private async Task OnDemoModeChangedAsync()
    {
        await _initLock.WaitAsync();
        try
        {
            _state.LoadingCollections = true;
            await InvokeAsync(StateHasChanged);

            await Task.WhenAll(LoadCollectionsAsync(), LoadEnvironmentsAsync());
            await LoadLinkedRootsAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reload API client collections after demo mode change");
        }
        finally
        {
            _state.LoadingCollections = false;
            await InvokeAsync(StateHasChanged);
            _initLock.Release();
        }
    }

    // LoadLinkedRootsAsync, LoadEnvironmentsAsync: see ApiClientPage.Collections.cs

    // RestoreSelectedRequest: see ApiClientPage.Tabs.cs

    // ── Toolbar actions ───────────────────────────────────────────────────────

    // OpenCurrentTargetGitFromMenu: see ApiClientPage.LinkedSave.cs

    // OpenCollectionImportDialogFromMenu, OpenCollectionExportDialogFromMenu,
    // OpenCollectionVariablesFromMenu, ToggleEnvsWorksheet, OpenRequestVariablesFromMenu,
    // OpenVariableInspectorAsync, ConfirmLinkedRootAsync, RemoveLinkedRootAsync: see
    // ApiClientPage.Collections.cs

    // OpenGitPanelAsync: see ApiClientPage.LinkedSave.cs

    // ConfirmNewCollectionAsync, OnNewCollectionKeyDownAsync, AddCollectionAsync,
    // CreateCollectionForCurrentTargetAsync: see ApiClientPage.Collections.cs

    private ApiCollection? GetRequestTargetCollection()
    {
        if (_state.ActiveCollection is not null)
        {
            return _state.ActiveCollection;
        }

        var linkedRoot = ActiveLinkedRoot;
        return linkedRoot is { Collections.Count: 1 }
            ? linkedRoot.Collections[0]
            : null;
    }

    // ActivateCollection, AddRequestAsync, SelectEnvAsync, OnEnvironmentsChangedAsync,
    // OnCollVarEditorSavedAsync: see ApiClientPage.Collections.cs

    // SaveRequestAsync, SaveActiveCollectionAsync, TryRunLinkedFileOperationAsync,
    // RefreshAfterLinkedMutationAsync, ReloadLinkedConflictAsync, KeepMineLinkedConflictAsync,
    // SaveLinkedConflictAsCopyAsync: see ApiClientPage.LinkedSave.cs

    // ── Tree callbacks ─────────────────────────────────────────────────────────

    // OnCollectionSelectedAsync, OnLinkedRootSelectedAsync: see ApiClientPage.Collections.cs

    // OnRequestSelectedAsync: see ApiClientPage.Requests.cs

    // OnTabSelectedAsync, OnTabCloseRequestedAsync, SaveAndCloseTabAsync, DiscardAndCloseTabAsync,
    // CancelTabCloseConfirm, CloseTab, PersistLastSelectionAsync: see ApiClientPage.Tabs.cs

    // OnAddFolderAsync, OnAddRequestInFolderAsync, OnRenameNodeAsync, OnDeleteNodeAsync: see
    // ApiClientPage.Tree.cs

    // OnRenameCollectionAsync, OnDeleteCollectionAsync, ConfirmDeleteCollectionAsync: see
    // ApiClientPage.Collections.cs

    // OnMoveNodeAsync: see ApiClientPage.Tree.cs

    // ── Tree helpers ───────────────────────────────────────────────────────────

    private static void SyncNodeName(List<ApiCollectionNode> nodes, string requestId, string name)
    {
        foreach (var node in nodes)
        {
            if (node.Request?.Id == requestId) { node.Name = name; return; }
            if (node.Type == ApiCollectionNodeType.Folder) SyncNodeName(node.Children, requestId, name);
        }
    }

    private static bool AddNodeToParent(List<ApiCollectionNode> nodes, string parentId, ApiCollectionNode newNode)
    {
        foreach (var node in nodes)
        {
            if (node.Id == parentId && node.Type == ApiCollectionNodeType.Folder)
            {
                node.Children.Add(newNode);
                return true;
            }
            if (node.Type == ApiCollectionNodeType.Folder && AddNodeToParent(node.Children, parentId, newNode))
                return true;
        }
        return false;
    }

    /// <summary>
    /// Like <see cref="AddNodeToParent"/> but supports inserting at a specific sibling index
    /// (used by drag-and-drop reorder). <paramref name="parentId"/> of <c>null</c> targets the
    /// collection's top-level <paramref name="nodes"/> list.
    /// </summary>
    private static bool InsertNodeAtParent(List<ApiCollectionNode> nodes, string? parentId, ApiCollectionNode newNode, int?
index)
    {
        if (parentId is null)
        {
            InsertAt(nodes, newNode, index);
            return true;
        }

        foreach (var node in nodes)
        {
            if (node.Id == parentId && node.Type == ApiCollectionNodeType.Folder)
            {
                InsertAt(node.Children, newNode, index);
                return true;
            }
            if (node.Type == ApiCollectionNodeType.Folder && InsertNodeAtParent(node.Children, parentId, newNode, index))
                return true;
        }
        return false;
    }

    private static void InsertAt(List<ApiCollectionNode> siblings, ApiCollectionNode node, int? index)
    {
        if (index is int idx && idx >= 0 && idx <= siblings.Count)
            siblings.Insert(idx, node);
        else
            siblings.Add(node);
    }

    private static bool RenameNodeInTree(List<ApiCollectionNode> nodes, string nodeId, string newName)
    {
        foreach (var node in nodes)
        {
            if (node.Id == nodeId) { node.Name = newName; return true; }
            if (node.Type == ApiCollectionNodeType.Folder && RenameNodeInTree(node.Children, nodeId, newName))
                return true;
        }
        return false;
    }

    private static bool RemoveNodeFromTree(List<ApiCollectionNode> nodes, string nodeId)
    {
        var idx = nodes.FindIndex(n => n.Id == nodeId);
        if (idx >= 0) { nodes.RemoveAt(idx); return true; }

        foreach (var node in nodes.Where(n => n.Type == ApiCollectionNodeType.Folder))
        {
            if (RemoveNodeFromTree(node.Children, nodeId))
                return true;
        }
        return false;
    }

    private static bool ContainsRequest(List<ApiCollectionNode> nodes, string requestId)
    {
        foreach (var node in nodes)
        {
            if (node.Type == ApiCollectionNodeType.Request && node.Request?.Id == requestId) return true;
            if (node.Type == ApiCollectionNodeType.Folder && ContainsRequest(node.Children, requestId)) return true;
        }
        return false;
    }

    private static HttpRequestEntry? FindRequestInNodes(List<ApiCollectionNode> nodes, string requestId)
    {
        foreach (var node in nodes)
        {
            if (node.Type == ApiCollectionNodeType.Request && node.Request?.Id == requestId)
                return node.Request;

            if (node.Type == ApiCollectionNodeType.Folder)
            {
                var found = FindRequestInNodes(node.Children, requestId);
                if (found is not null)
                    return found;
            }
        }

        return null;
    }

    private static HttpRequestEntry CloneRequestAsCopy(HttpRequestEntry request)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(request);
        var copy = System.Text.Json.JsonSerializer.Deserialize<HttpRequestEntry>(json) ?? new HttpRequestEntry();
        var now = DateTimeOffset.UtcNow;
        copy.Id = Guid.NewGuid().ToString("N");
        copy.Name = $"{request.Name} copy";
        copy.CreatedAt = now;
        copy.UpdatedAt = now;
        return copy;
    }

    // IsLinkedCollection: see ApiClientPage.LinkedSave.cs

    private static string GetMethodLabel(ApiRequestMethod method) => method switch
    {
        ApiRequestMethod.Get => "GET",
        ApiRequestMethod.Post => "POST",
        ApiRequestMethod.Put => "PUT",
        ApiRequestMethod.Patch => "PATCH",
        ApiRequestMethod.Delete => "DEL",
        ApiRequestMethod.Head => "HEAD",
        ApiRequestMethod.Options => "OPT",
        ApiRequestMethod.GraphQl => "GQL",
        ApiRequestMethod.WebSocket => "WS",
        _ => "GET",
    };

    // ── Request change + auto-save ─────────────────────────────────────────────

    // OnRequestChangedAsync, AutoSaveLoopAsync: see ApiClientPage.Requests.cs

    // ── Request send ────────────────────



    // ── Request result ─────────────────────────────────────────────────────────

    // OnRequestResultAsync: see ApiClientPage.Requests.cs

    // ── Subscription callbacks ─────────────────────────────────────────────────

    // OnSubscriptionMessageAsync, OnSubscriptionStoppedAsync, OnResendHistoryEntryAsync,
    // SaveResponseExampleAsync: see ApiClientPage.Requests.cs

    // ── Export / Import ────────────────────────────────────────────────────────

    // OnCollectionImportedAsync: see ApiClientPage.Collections.cs

    // ── Dialog input focus ──────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus the new-collection dialog input when it opens
        if (_shouldFocusNewCollectionInput)
        {
            _shouldFocusNewCollectionInput = false;
            try { await _newCollectionInput.FocusAsync(); } catch { }
        }

        if (_shouldFocusLinkedRootInput)
        {
            _shouldFocusLinkedRootInput = false;
            try { await _newLinkedRootInput.FocusAsync(); }
            catch { }
        }
    }

    // ── Keyboard shortcut event handler ─────────────────────────────────────────

    // OnApiClientShortcut, GetNextOpenTabId, RegisterApiClientCommands: see
    // ApiClientPage.Commands.cs

    // ── IAsyncDisposable ───────────────────────────────────────────────────────

    public ValueTask DisposeAsync()
    {
        Events.Unsubscribe<ApiClientShortcutEvent>(OnApiClientShortcut);
        AppState.DemoModeChanged -= OnDemoModeChanged;
        Commands.Unregister("api-new-request");
        Commands.Unregister("api-new-collection");
        Commands.Unregister("api-env-manager");
        Commands.Unregister("api-quick-nav");
        Commands.Unregister("api-save-request");
        _autoSaveTimer?.Dispose();
        _initLock.Dispose();
        return ValueTask.CompletedTask;
    }

    private LinkedCollectionRootLoadResult? FindLinkedRootForCollection(string collectionId) =>
        _state.LinkedRootResults.FirstOrDefault(root => root.Collections.Any(collection => collection.Id == collectionId));

    private (LinkedCollectionRootLoadResult Root, LinkedEnvironmentFileState EnvironmentFile)?
FindLinkedRootForEnvironment(string environmentId)
    {
        foreach (var root in _state.LinkedRootResults)
        {
            var environmentFile = root.EnvironmentFiles.FirstOrDefault(file => file.EnvironmentId == environmentId);
            if (environmentFile is not null)
                return (root, environmentFile);
        }

        return null;
    }

    private LinkedRequestFileState? FindLinkedRequestFileState(string requestId) =>
        _state.LinkedRootResults.SelectMany(root => root.RequestFiles).FirstOrDefault(file => file.RequestId == requestId);

    private (ApiCollection? Collection, HttpRequestEntry? Request) FindCollectionAndRequest(string requestId)
    {
        foreach (var collection in _state.Collections)
        {
            var request = FindRequestInNodes(collection.Nodes, requestId);
            if (request is not null)
            {
                return (collection, request);
            }
        }

        return (null, null);
    }

    private static string FormatElapsed(TimeSpan elapsed)
    {
        if (elapsed == TimeSpan.Zero)
        {
            return "—";
        }

        return elapsed.TotalSeconds >= 1
            ? $"{elapsed.TotalSeconds:F2} s"
            : $"{elapsed.TotalMilliseconds:F0} ms";
    }

    internal sealed record LinkedSaveConflict(
        string RootId,
        string CollectionId,
        string RequestId,
        string? RequestFilePath,
        string Message);

    private List<ApiCollection> BuildCombinedCollections()
    {
        var combined = CollectionRepo.Collections.Concat(_state.LinkedRootResults.SelectMany(root =>
root.Collections)).ToList();

        // Add demo collection if in demo mode
        if (AppState.UseDemoData)
        {
            var demoCollection = DemoApiCollectionFactory.CreateDemoCollection();
            combined = [demoCollection, .. combined];
        }

        return combined;
    }

    private List<ApiEnvironment> BuildCombinedEnvironments() =>
        EnvironmentRepo.Environments.Concat(_state.LinkedRootResults.SelectMany(root => root.Environments)).ToList();
}
