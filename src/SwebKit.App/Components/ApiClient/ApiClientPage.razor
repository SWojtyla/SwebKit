@page "/api-client"
@inject CollectionRepository CollectionRepo
@inject EnvironmentRepository EnvironmentRepo
@inject LinkedCollectionRootRepository LinkedRootRepo
@inject LinkedCollectionFileService LinkedFileService
@inject LinkedGitService LinkedGit
@inject ApiClientWorkflowService WorkflowService
@inject ApiClientCollectionRunnerService RunnerService
@inject ICredentialStore CredentialStore
@inject UserSettingsRepository UserSettings
@inject NavigationManager Nav
@inject ILogger<ApiClientPage> Logger
@inject IJSRuntime JS
@inject IAppEventBus Events
@inject CommandRegistry Commands
@implements IAsyncDisposable

<div class="api-client-page">

    @* ── Toolbar ── *@
    <div class="api-client-toolbar">
        <div class="api-client-toolbar__left">
            <button type="button" class="api-client-toolbar-btn" title="New collection (Ctrl+Shift+N)"
                    @onclick="OpenNewCollectionDialog">
                <FluentIcon Value="@(new Icons.Regular.Size16.AddSquare())" Width="14px" />
                <span>New Collection</span>
            </button>
            <button type="button" class="api-client-toolbar-btn" title="New request (Ctrl+N)"
                    disabled="@(_activeCollection is null)" @onclick="AddRequestAsync">
                <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Width="14px" />
                <span>New Request</span>
            </button>
            @if (_isDirty && !_autoSave)
            {
                <button type="button" class="api-client-toolbar-btn api-client-toolbar-btn--save"
                        title="Save request (Ctrl+S)" @onclick="SaveRequestAsync">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Save())" Width="14px" />
                    <span>Save</span>
                </button>
            }
            <button type="button" class="api-client-toolbar-btn" title="Add a Git-backed SwebKit API collection folder"
                    @onclick="OpenLinkedRootDialog">
                <span>Add API Repo</span>
            </button>
            <button type="button" class="api-client-toolbar-btn" title="Import a request from cURL"
                    disabled="@(_activeCollection is null)" @onclick="OpenCurlImportDialog">
                <span>Import cURL</span>
            </button>
            @if (_linkedRootInfos.Count > 0)
            {
                <button type="button"
                        class="api-client-toolbar-btn @(_worksheetMode == WorksheetLinkedRoots ? "api-client-toolbar-btn--active" : "")"
                        title="Manage Git-backed API repositories"
                        @onclick="@(() => _worksheetMode = _worksheetMode == WorksheetLinkedRoots ? null : WorksheetLinkedRoots)">
                    <span>API Repos</span>
                </button>
            }
        </div>

        <div class="api-client-toolbar__center">
            <span class="api-client-target-chip" title="@CurrentTargetHint">
                <span class="api-client-target-chip__label">Target</span>
                <strong>@CurrentTargetLabel</strong>
            </span>
            @if (_isDirty && !_autoSave)
            {
                <span class="api-client-toolbar__dirty-badge" title="Unsaved changes — press Ctrl+S to save">
                    ● Unsaved
                </span>
            }
            @if (_linkedSaveConflict is not null)
            {
                <div class="api-client-conflict-banner">
                    <span>@_linkedSaveConflict.Message</span>
                    <button type="button" class="api-client-secret-warning__btn" @onclick="ReloadLinkedConflictAsync">Reload from disk</button>
                    <button type="button" class="api-client-secret-warning__btn" @onclick="KeepMineLinkedConflictAsync">Keep mine</button>
                    <button type="button" class="api-client-secret-warning__btn" @onclick="SaveLinkedConflictAsCopyAsync">Save as copy</button>
                </div>
            }
            @if (_linkedSaveError is not null)
            {
                <span class="api-client-toolbar__warning-badge" title="@_linkedSaveError">
                    @_linkedSaveError
                </span>
            }
            @if (_workflowMessage is not null)
            {
                <span class="api-client-toolbar__warning-badge @(_workflowMessageIsError ? "" : "api-client-toolbar__warning-badge--ok")" title="@_workflowMessage">
                    @_workflowMessage
                </span>
            }
        </div>

        <div class="api-client-toolbar__right">
            @if (_activeCollection is not null)
            {
                <button type="button"
                        class="api-client-toolbar-btn @(_worksheetMode == WorksheetRunner ? "api-client-toolbar-btn--active" : "")"
                        title="Run active collection"
                        @onclick="RunActiveCollectionAsync">Run</button>
                <button type="button"
                        class="api-client-toolbar-btn @(_worksheetMode == WorksheetVars ? "api-client-toolbar-btn--active" : "")"
                        title="Edit collection variables"
                        @onclick="@(() => _worksheetMode = _worksheetMode == WorksheetVars ? null : WorksheetVars)">⚙
                    Vars</button>
                    <button type="button" class="api-client-toolbar-btn" title="Export / Import"
                            @onclick="() => _showExportDialog = true">⬆⬇ Export / Import</button>
                }
                    @if (_selectedRequest is not null)
                    {
                    <button type="button" class="api-client-toolbar-btn" title="Pin request"
                        @onclick="TogglePinnedRequestAsync">@(IsSelectedRequestPinned ? "Unpin" : "Pin")</button>
                    <button type="button" class="api-client-toolbar-btn" title="Copy request as cURL"
                        @onclick="CopyCurlAsync">Copy cURL</button>
                    <button type="button"
                        class="api-client-toolbar-btn @(_worksheetMode == WorksheetVariables ? "api-client-toolbar-btn--active" : "")"
                        title="Inspect variables used by this request"
                        @onclick="OpenVariableInspectorAsync">Variables</button>
                    }
                <button type="button"
                        class="api-client-toolbar-btn @(_worksheetMode == WorksheetEnvs ? "api-client-toolbar-btn--active" : "")"
                        title="Manage environments"
                        @onclick="@(() => _worksheetMode = _worksheetMode == WorksheetEnvs ? null : WorksheetEnvs)">🌍
                    Envs</button>
                    <span class="api-client-toolbar__env-label">Env:</span>
                    <div class="api-client-env-picker">
                        <button type="button" class="api-client-env-picker__btn"
                                @onclick="() => _showEnvPicker = !_showEnvPicker">
                            <span>@(ActiveEnvironment?.Name ?? "— None —")</span>
                            <span class="api-client-env-picker__chevron">▾</span>
                        </button>
                        @if (_showEnvPicker)
                        {
                            <div class="ctx-backdrop" @onclick="() => _showEnvPicker = false"></div>
                            <div class="api-client-env-picker__dropdown">
                                <button type="button" class="ctx-item @(_activeEnvironmentId is null ? "ctx-item--active" : "")"
                                        @onclick="() => SelectEnvAsync(null)">— None —</button>
                                @foreach (var env in _environments)
                                {
                                    <button type="button" class="ctx-item @(env.Id == _activeEnvironmentId ? "ctx-item--active" : "")"
                                            @onclick="() => SelectEnvAsync(env.Id)">@env.Name</button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* ── Main split: collection tree + request workspace ── *@
            <div class="api-client-body">

                @* Left: collection tree *@
                <div class="api-client-tree-panel">
                    @if (_loadingCollections)
                    {
                        <div class="api-client-tree-panel__loading">
                            <LoadingSpinner Message="Loading collections…" />
                        </div>
                    }
                    else if (_collections.Count == 0 && _linkedRootInfos.Count == 0)
                    {
                        <div class="api-client-tree-panel__empty">
                            <EmptyState Icon="📦" Title="No collections yet"
                                        Subtitle="Create a local collection or add a Git-backed API repository.">
                                <Actions>
                                    <button type="button" class="api-client-empty-action-btn" @onclick="AddCollectionAsync">
                                        + New Collection
                                    </button>
                                    <button type="button" class="api-client-empty-action-btn" @onclick="OpenLinkedRootDialog">
                                        Add API Repo
                                    </button>
                                </Actions>
                            </EmptyState>
                        </div>
                    }
                    else
                    {
                        <CollectionTree Collections="@_collections" LinkedRoots="@_linkedRootInfos"
                                        SelectedRequestId="@_selectedRequestId" ActiveCollectionId="@_activeCollection?.Id" ActiveLinkedRootId="@_activeLinkedRootId"
                                        OnRequestSelected="OnRequestSelectedAsync" OnCollectionSelected="OnCollectionSelectedAsync"
                                        OnAddFolder="OnAddFolderAsync" OnAddRequest="OnAddRequestInFolderAsync" OnRenameNode="OnRenameNodeAsync"
                                        OnDeleteNode="OnDeleteNodeAsync" OnLinkedRootSelected="OnLinkedRootSelectedAsync" OnRenameCollection="OnRenameCollectionAsync"
                                        OnDeleteCollection="OnDeleteCollectionAsync" />
                    }
                </div>

                @* Right: request builder + response viewer OR management screens *@
                <div class="api-client-workspace">
                    @if (_pinnedRequestIds.Count > 0)
                    {
                        <div class="api-client-pinned-tabs">
                            @foreach (var pinnedId in _pinnedRequestIds)
                            {
                                var pinned = FindCollectionAndRequest(pinnedId);
                                if (pinned.Request is not null)
                                {
                                    <button type="button"
                                            class="api-client-pinned-tab @(pinnedId == _selectedRequestId ? "api-client-pinned-tab--active" : "")"
                                            @onclick="() => SelectPinnedRequestAsync(pinnedId)">
                                        <span>@pinned.Request.Name</span>
                                        @if (_dirtyByRequestId.GetValueOrDefault(pinnedId))
                                        {
                                            <strong>*</strong>
                                        }
                                    </button>
                                    <button type="button" class="api-client-pinned-tab__close" title="Unpin request"
                                            @onclick="() => UnpinRequestAsync(pinnedId)">x</button>
                                }
                            }
                        </div>
                    }
                    @if (_worksheetMode == WorksheetEnvs)
                    {
                        <div class="api-client-management-screen">
                            <div class="api-client-management-screen__header">
                                <button type="button" class="api-client-management-screen__back"
                                        @onclick="() => _worksheetMode = null">← Back to requests</button>
                                <span class="api-client-management-screen__title">Environments</span>
                            </div>
                            <EnvironmentManagerPanel OnChanged="@OnEnvironmentsChangedAsync" />
                        </div>
                    }
                    else if (_worksheetMode == WorksheetVars && _activeCollection is not null)
                    {
                        <div class="api-client-management-screen">
                            <div class="api-client-management-screen__header">
                                <button type="button" class="api-client-management-screen__back"
                                        @onclick="() => _worksheetMode = null">← Back to requests</button>
                                <span class="api-client-management-screen__title">Collection Variables —
                                    @_activeCollection.Name</span>
                                </div>
                                <CollectionVariableEditor Collection="@_activeCollection" OnSaved="@OnCollVarEditorSavedAsync"
                                                          OnCancelled="@(() => _worksheetMode = null)" />
                            </div>
                        }
                    else if (_worksheetMode == WorksheetVariables && _selectedRequest is not null)
                    {
                        <div class="api-client-management-screen">
                            <div class="api-client-management-screen__header">
                                <button type="button" class="api-client-management-screen__back"
                                        @onclick="() => _worksheetMode = null">← Back to requests</button>
                                <span class="api-client-management-screen__title">Variables — @_selectedRequest.Name</span>
                            </div>
                            <div class="api-client-inspector">
                                @if (_variableInspectorLoading)
                                {
                                    <LoadingSpinner Message="Resolving variables…" />
                                }
                                else if (_variableInspectionItems.Count == 0)
                                {
                                    <div class="api-client-linked-roots__empty">No variables found in this request.</div>
                                }
                                else
                                {
                                    @foreach (var item in _variableInspectionItems)
                                    {
                                        <div class="api-client-inspector__row @(item.IsResolved ? "" : "api-client-inspector__row--unresolved")">
                                            <span class="api-client-inspector__key">{{@item.Key}}</span>
                                            <span class="api-client-inspector__source">@item.Source</span>
                                            <span class="api-client-inspector__value">@(item.DisplayValue ?? "unresolved")</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                    else if (_worksheetMode == WorksheetRunner)
                    {
                        <div class="api-client-management-screen">
                            <div class="api-client-management-screen__header">
                                <button type="button" class="api-client-management-screen__back"
                                        @onclick="() => _worksheetMode = null">← Back to requests</button>
                                <span class="api-client-management-screen__title">Collection Runner — @(_activeCollection?.Name ?? "No collection")</span>
                                @if (_runnerRunning)
                                {
                                    <button type="button" class="api-client-toolbar-btn api-client-toolbar-btn--danger"
                                            @onclick="CancelRunnerAsync">Cancel</button>
                                }
                            </div>
                            <div class="api-client-runner">
                                @if (_runnerResults.Count == 0 && !_runnerRunning)
                                {
                                    <div class="api-client-linked-roots__empty">No runner results yet.</div>
                                }
                                @if (_runnerRunning)
                                {
                                    <div class="api-client-git-panel__message">Running collection…</div>
                                }
                                @foreach (var item in _runnerResults)
                                {
                                    <div class="api-client-runner__row">
                                        <span class="api-client-runner__method">@GetMethodLabel(item.Method)</span>
                                        <span class="api-client-runner__name">@item.RequestName</span>
                                        <span class="api-client-runner__status">@(item.ErrorMessage ?? item.Result?.StatusText ?? "pending")</span>
                                        <span class="api-client-runner__elapsed">@FormatElapsed(item.Elapsed)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
            else if (_worksheetMode == WorksheetLinkedRoots)
                        {
                            <div class="api-client-management-screen">
                                <div class="api-client-management-screen__header">
                                    <button type="button" class="api-client-management-screen__back"
                                            @onclick="() => _worksheetMode = null">← Back to requests</button>
                                    <span class="api-client-management-screen__title">API Repositories</span>
                                </div>
                                <div class="api-client-linked-roots">
                                    @if (_linkedRootResults.Count == 0)
                                    {
                                        <div class="api-client-linked-roots__empty">No API repositories configured.</div>
                                    }
                                    @foreach (var root in _linkedRootResults)
                                    {
                                        <div class="api-client-linked-root-card">
                                            <div class="api-client-linked-root-card__main">
                                                <div class="api-client-linked-root-card__name">@root.DisplayName</div>
                                                <div class="api-client-linked-root-card__path">@root.ApiRootPath</div>
                                                <div class="api-client-linked-root-card__meta">
                                                    <span>@(root.GitStatus.IsGitRepository ? root.GitStatus.Branch ?? "detached" : "not a Git repo")</span>
                                                    <span>@(root.GitStatus.ChangedFileCount > 0 ? $"{root.GitStatus.ChangedFileCount} changed" : "clean")</span>
                                                    @if (root.Diagnostics.Count > 0)
                                                    {
                                                        <span>@root.Diagnostics.Count diagnostic(s)</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="api-client-linked-root-card__actions">
                                                <button type="button" class="api-client-toolbar-btn"
                                                        @onclick="LoadLinkedRootsAsync">Refresh</button>
                                                <button type="button" class="api-client-toolbar-btn"
                                                        @onclick="() => OpenGitPanelAsync(root.Config.Id)">Git</button>
                                                <button type="button" class="api-client-toolbar-btn"
                                                        @onclick="() => RemoveLinkedRootAsync(root.Config.Id)">Remove</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else if (_worksheetMode == WorksheetGit && ActiveGitRoot is not null)
                        {
                            <div class="api-client-management-screen">
                                <div class="api-client-management-screen__header">
                                    <button type="button" class="api-client-management-screen__back"
                                            @onclick="() => _worksheetMode = WorksheetLinkedRoots">← Back to API repos</button>
                                    <span class="api-client-management-screen__title">Git — @ActiveGitRoot.DisplayName</span>
                                </div>
                                <div class="api-client-git-panel">
                                    @{
                                        var stagedGitFiles = GetStagedGitFiles();
                                        var unstagedGitFiles = GetUnstagedGitFiles();
                                    }
                                    <div class="api-client-git-panel__summary">
                                        <span>Branch: @(ActiveGitRoot.GitStatus.Branch ?? "—")</span>
                                        <span>Changed API files: @ActiveGitRoot.GitStatus.ChangedFileCount</span>
                                        @if (stagedGitFiles.Count > 0)
                                        {
                                            <span>staged changes ready</span>
                                        }
                                    </div>
                                    @if (_gitMessage is not null)
                                    {
                                        <div
                                            class="api-client-git-panel__message @(_gitMessageIsError ? "api-client-git-panel__message--error" : "")">
                                            @_gitMessage</div>
                                        }
                                        @if (stagedGitFiles.Count > 0)
                                        {
                                            <div class="api-client-git-panel__commit-preview">
                                                <div class="api-client-git-panel__section-title">Commit preview</div>
                                                <div class="api-client-git-panel__summary">
                                                    <span>Branch: @(ActiveGitRoot.GitStatus.Branch ?? "—")</span>
                                                    <span>Remote: @(_gitRemoteUrl ?? "origin remote unavailable")</span>
                                                    <span>@stagedGitFiles.Count staged API file(s)</span>
                                                </div>
                                                <div class="api-client-git-panel__preview-files">
                                                    @foreach (var file in stagedGitFiles)
                                                    {
                                                        <span>@file.Path</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        <div class="api-client-git-panel__row">
                                            <input class="api-client-dialog__input" placeholder="branch name" value="@_gitBranchName"
                                                   @oninput="e => _gitBranchName = e.Value?.ToString() ?? string.Empty" />
                                            <button type="button" class="api-client-toolbar-btn" @onclick="CreateGitBranchAsync">Create
                                                branch</button>
                                                </div>
                                                <div class="api-client-git-panel__row">
                                                    <select class="api-client-dialog__input api-client-git-panel__branch-select" value="@_gitBranchToSwitch"
                                                            @onchange="e => _gitBranchToSwitch = e.Value?.ToString() ?? string.Empty">
                                                        @foreach (var branch in _gitBranches)
                                                        {
                                                            <option value="@branch.Name">@(branch.IsCurrent ? $"{branch.Name} (current)" : branch.Name)</option>
                                                        }
                                                    </select>
                                                    <button type="button" class="api-client-toolbar-btn" disabled="@string.IsNullOrWhiteSpace(_gitBranchToSwitch)"
                                                            @onclick="SwitchGitBranchAsync">Switch branch</button>
                                                </div>
                                                <div class="api-client-git-panel__row">
                                                        <button type="button" class="api-client-toolbar-btn" disabled="@(unstagedGitFiles.Count == 0)"
                                                            @onclick="StageAllGitFilesAsync">Stage all</button>
                                                        <button type="button" class="api-client-toolbar-btn" disabled="@(stagedGitFiles.Count == 0)"
                                                            @onclick="UnstageAllGitFilesAsync">Unstage all</button>
                                                    <input class="api-client-dialog__input" placeholder="commit message" value="@_gitCommitMessage"
                                                           @oninput="e => _gitCommitMessage = e.Value?.ToString() ?? string.Empty" />
                                                        <button type="button" class="api-client-toolbar-btn" disabled="@(stagedGitFiles.Count == 0 || string.IsNullOrWhiteSpace(_gitCommitMessage))"
                                                            @onclick="CommitGitChangesAsync">Commit staged</button>
                                                        <button type="button" class="api-client-toolbar-btn" @onclick="PushGitBranchAsync">Push</button>
                                                        <button type="button" class="api-client-toolbar-btn" @onclick="OpenRemoteCompareAsync">Open remote
                                                            compare</button>
                                                        </div>
                                                        <div class="api-client-git-panel__files">
                                                            @if (ActiveGitRoot.GitStatus.ChangedFileDetails.Count == 0)
                                                            {
                                                                <div class="api-client-git-panel__file api-client-git-panel__file--empty">No changed API files.</div>
                                                            }

                                                            <div class="api-client-git-panel__section-title">Staged</div>
                                                            @if (stagedGitFiles.Count == 0)
                                                            {
                                                                <div class="api-client-git-panel__file api-client-git-panel__file--empty">No staged API files.</div>
                                                            }
                                                            @foreach (var file in stagedGitFiles)
                                                            {
                                                                <div class="api-client-git-panel__file">
                                                                    <div class="api-client-git-panel__file-main">
                                                                        <span class="api-client-git-panel__file-status">@file.StatusLabel</span>
                                                                        <span class="api-client-git-panel__file-path">@file.Path</span>
                                                                    </div>
                                                                    <div class="api-client-git-panel__file-actions">
                                                                        <button type="button" class="api-client-toolbar-btn" @onclick="() => LoadGitDiffAsync(file.Path)">Review</button>
                                                                        <button type="button" class="api-client-toolbar-btn" @onclick="() => UnstageGitFileAsync(file.Path)">Unstage</button>
                                                                        <button type="button" class="api-client-toolbar-btn api-client-toolbar-btn--danger"
                                                                                @onclick="() => QueueRevertGitFile(file.Path)">Revert</button>
                                                                    </div>
                                                                </div>
                                                            }

                                                            <div class="api-client-git-panel__section-title">Unstaged</div>
                                                            @if (unstagedGitFiles.Count == 0)
                                                            {
                                                                <div class="api-client-git-panel__file api-client-git-panel__file--empty">No unstaged API files.</div>
                                                            }
                                                            @foreach (var file in unstagedGitFiles)
                                                            {
                                                                <div class="api-client-git-panel__file">
                                                                    <div class="api-client-git-panel__file-main">
                                                                        <span class="api-client-git-panel__file-status">@file.StatusLabel</span>
                                                                        <span class="api-client-git-panel__file-path">@file.Path</span>
                                                                    </div>
                                                                    <div class="api-client-git-panel__file-actions">
                                                                        <button type="button" class="api-client-toolbar-btn" @onclick="() => LoadGitDiffAsync(file.Path)">Review</button>
                                                                        <button type="button" class="api-client-toolbar-btn" @onclick="() => StageGitFileAsync(file.Path)">Stage</button>
                                                                        <button type="button" class="api-client-toolbar-btn api-client-toolbar-btn--danger"
                                                                                @onclick="() => QueueRevertGitFile(file.Path)">Revert</button>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="api-client-git-panel__diff">
                                                            @if (_gitDiffLoading)
                                                            {
                                                                <div class="api-client-git-panel__file api-client-git-panel__file--empty">Loading diff preview…</div>
                                                            }
                                                            else if (_gitDiff is not null)
                                                            {
                                                                <div class="api-client-git-panel__diff-header">
                                                                    <span>Diff preview — @_gitDiff.Path</span>
                                                                    <button type="button" class="api-client-toolbar-btn" @onclick="() => _gitDiff = null">Close</button>
                                                                </div>
                                                                @if (!_gitDiff.IsSuccess)
                                                                {
                                                                    <div class="api-client-git-panel__message api-client-git-panel__message--error">@_gitDiff.ErrorMessage</div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="api-client-git-panel__diff-grid">
                                                                        <div>
                                                                            <div class="api-client-git-panel__section-title">Original</div>
                                                                            <pre>@GetDiffPreviewText(_gitDiff.OriginalContent)</pre>
                                                                        </div>
                                                                        <div>
                                                                            <div class="api-client-git-panel__section-title">Current</div>
                                                                            <pre>@GetDiffPreviewText(_gitDiff.CurrentContent)</pre>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
            else if (_selectedRequest is null)
                                            {
                                                <div class="api-client-workspace__empty">
                                                    <EmptyState Icon="🌐" Title="No request selected"
                                                                Subtitle="Select a request from the collection tree, or create a new one.">
                                                        <Actions>
                                                            <button type="button" class="api-client-empty-action-btn"
                                                                    disabled="@(_activeCollection is null)" @onclick="AddRequestAsync">
                                                                + New Request
                                                            </button>
                                                        </Actions>
                                                    </EmptyState>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="api-client-workspace__panels">
                                                    <div class="api-client-workspace__builder" @ref="_builderPanelEl">
                                                        @if (MissingSecretNames.Count > 0)
                                                        {
                                                            <div class="api-client-secret-warning">
                                                                Missing secret reference(s): @string.Join(", ", MissingSecretNames).
                                                                <button type="button" class="api-client-secret-warning__btn"
                                                                        @onclick="OpenConfigureSecretDialog">Configure</button>
                                                            </div>
                                                        }
                                                        <RequestBuilderPanel Request="@_selectedRequest" Collection="@(_activeCollection!)"
                                                                             ActiveEnvironment="@ActiveEnvironment" AllEnvironments="@_environments"
                                                                             ScopeVersion="@_scopeVersion" IsDirty="@_isDirty" OnChanged="@OnRequestChangedAsync"
                                                                             OnResult="@OnRequestResultAsync" OnSubscriptionMessage="@OnSubscriptionMessageAsync"
                                                                             OnSubscriptionStopped="@OnSubscriptionStoppedAsync" />
                                                    </div>
                                                    <div class="api-client-workspace__splitter" @ref="_splitterEl"></div>
                                                    <div class="api-client-workspace__response">
                                                        <ResponseViewerPanel Result="@_lastResult" SubscriptionMessages="@_subscriptionMessages"
                                                                             HistoryEntries="@GetHistoryForSelected()"
                                                                             ResponseExamples="@(_selectedRequest?.ResponseExamples ?? [])"
                                                                             OnResend="@OnResendHistoryEntryAsync"
                                                                             OnSaveExample="@SaveResponseExampleAsync" />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                @* ── New collection dialog ── *@
                                @if (_showNewCollectionDialog)
                                {
                                    <div class="api-client-dialog-backdrop" @onclick="() => _showNewCollectionDialog = false"></div>
                                    <div class="api-client-dialog" role="dialog" aria-modal="true" aria-label="New Collection">
                                        <div class="api-client-dialog__title">New Collection</div>
                                        <input type="text" class="api-client-dialog__input" placeholder="Collection name…" value="@_newCollectionName"
                                               @oninput="e => _newCollectionName = e.Value?.ToString() ?? string.Empty"
                                               @onkeydown="OnNewCollectionKeyDownAsync" @ref="_newCollectionInput" />
                                        <div class="api-client-dialog__actions">
                                            <button type="button" class="api-client-dialog__btn api-client-dialog__btn--primary"
                                                    disabled="@string.IsNullOrWhiteSpace(_newCollectionName)"
                                                    @onclick="ConfirmNewCollectionAsync">Create</button>
                                            <button type="button" class="api-client-dialog__btn"
                                                    @onclick="() => _showNewCollectionDialog = false">Cancel</button>
                                        </div>
                                    </div>
                                }

                                @* ── Add API repo dialog ── *@
                                @if (_showLinkedRootDialog)
                                {
                                    <div class="api-client-dialog-backdrop" @onclick="() => _showLinkedRootDialog = false"></div>
                                    <div class="api-client-dialog api-client-dialog--wide" role="dialog" aria-modal="true" aria-label="Add API Repository">
                                        <div class="api-client-dialog__title">Add API Repository</div>
                                        <div class="api-client-dialog__hint">
                                            Choose a Git repository folder, or an existing .swebkit-api folder. SwebKit keeps API request files there so they can be committed with that repo.
                                        </div>
                                        <input type="text" class="api-client-dialog__input" placeholder="Display name (optional)"
                                               value="@_newLinkedRootName" @oninput="e => _newLinkedRootName = e.Value?.ToString() ?? string.Empty" />
                                        <input type="text" class="api-client-dialog__input" placeholder="Path to Git repo or .swebkit-api folder"
                                               value="@_newLinkedRootPath" @oninput="e => _newLinkedRootPath = e.Value?.ToString() ?? string.Empty"
                                               @ref="_newLinkedRootInput" />
                                        @if (_linkedRootError is not null)
                                        {
                                            <div class="api-client-dialog__error">@_linkedRootError</div>
                                        }
                                        <div class="api-client-dialog__actions">
                                            <button type="button" class="api-client-dialog__btn api-client-dialog__btn--primary"
                                                    disabled="@string.IsNullOrWhiteSpace(_newLinkedRootPath)" @onclick="ConfirmLinkedRootAsync">Add repo</button>
                                            <button type="button" class="api-client-dialog__btn"
                                                    @onclick="() => _showLinkedRootDialog = false">Cancel</button>
                                        </div>
                                    </div>
                                }

                                @if (_showConfigureSecretDialog)
                                {
                                    <div class="api-client-dialog-backdrop" @onclick="() => _showConfigureSecretDialog = false"></div>
                                    <div class="api-client-dialog" role="dialog" aria-modal="true" aria-label="Configure linked secret">
                                        <div class="api-client-dialog__title">Configure Secret</div>
                                        <div class="api-client-dialog__hint">@(_secretNameToConfigure ?? "Select a missing secret")</div>
                                        <input type="password" class="api-client-dialog__input" placeholder="Secret value stored locally"
                                               value="@_secretValueToConfigure"
                                               @oninput="e => _secretValueToConfigure = e.Value?.ToString() ?? string.Empty" />
                                        @if (_secretConfigError is not null)
                                        {
                                            <div class="api-client-dialog__error">@_secretConfigError</div>
                                        }
                                        <div class="api-client-dialog__actions">
                                            <button type="button" class="api-client-dialog__btn api-client-dialog__btn--primary"
                                                    disabled="@(string.IsNullOrWhiteSpace(_secretNameToConfigure) || string.IsNullOrEmpty(_secretValueToConfigure))"
                                                    @onclick="SaveConfiguredSecretAsync">Save Secret</button>
                                            <button type="button" class="api-client-dialog__btn"
                                                    @onclick="() => _showConfigureSecretDialog = false">Cancel</button>
                                        </div>
                                    </div>
                                }

                                @if (_showCurlImportDialog)
                                {
                                    <div class="api-client-dialog-backdrop" @onclick="() => _showCurlImportDialog = false"></div>
                                    <div class="api-client-dialog api-client-dialog--wide" role="dialog" aria-modal="true" aria-label="Import cURL">
                                        <div class="api-client-dialog__title">Import cURL</div>
                                        <div class="api-client-dialog__hint">Paste a cURL command. SwebKit will create a request in the active collection.</div>
                                        <textarea class="api-client-dialog__textarea" placeholder="curl https://api.example.com ..."
                                                  value="@_curlImportText" @oninput="e => _curlImportText = e.Value?.ToString() ?? string.Empty"></textarea>
                                        @if (_curlImportError is not null)
                                        {
                                            <div class="api-client-dialog__error">@_curlImportError</div>
                                        }
                                        <div class="api-client-dialog__actions">
                                            <button type="button" class="api-client-dialog__btn api-client-dialog__btn--primary"
                                                    disabled="@(string.IsNullOrWhiteSpace(_curlImportText) || _activeCollection is null)"
                                                    @onclick="ImportCurlAsync">Import</button>
                                            <button type="button" class="api-client-dialog__btn"
                                                    @onclick="() => _showCurlImportDialog = false">Cancel</button>
                                        </div>
                                    </div>
                                }

@* ── Delete collection confirm ── *@
<ConfirmDialog Visible="@(_pendingDeleteCollectionId is not null)" Title="Delete collection?"
               Message="@($"Delete \"{_pendingDeleteCollectionName}\" and all its requests? This cannot be undone.")"
               ConfirmLabel="Delete" OnConfirm="ConfirmDeleteCollectionAsync"
               OnCancel="@(() => { _pendingDeleteCollectionId = null; _pendingDeleteCollectionName = null; })" />

<ConfirmDialog Visible="@(_pendingRevertGitFilePath is not null)" Title="Revert API file?"
               Message="@($"Discard changes in {_pendingRevertGitFilePath}? This cannot be undone.")"
               ConfirmLabel="Revert" OnConfirm="ConfirmRevertGitFileAsync"
               OnCancel="@(() => _pendingRevertGitFilePath = null)" />

                                @* ── Export / Import dialog ── *@
                                <CollectionExportDialog Visible="@_showExportDialog" Collection="@_activeCollection" Environments="@_environments"
                                                        OnClose="@(() => _showExportDialog = false)" OnImported="@OnCollectionImportedAsync" />

@code {
    // ── State ─────────────────────────────────────────────────────────────────
    private bool _loadingCollections = true;
    private List<ApiCollection> _collections = [];
    private readonly List<LinkedCollectionRootLoadResult> _linkedRootResults = [];
    private IReadOnlyList<LinkedCollectionTreeInfo> _linkedRootInfos = [];
    private List<ApiEnvironment> _environments = [];
    private ApiCollection? _activeCollection;
    private string? _selectedRequestId;
    private HttpRequestEntry? _selectedRequest;
    private string? _activeEnvironmentId;
    private bool _isDirty;
    private bool _autoSave;
    private string? _linkedSaveError;
    private LinkedSaveConflict? _linkedSaveConflict;
    private string? _activeLinkedRootId;
    private string? _activeGitRootId;
    private IReadOnlyList<LinkedGitBranch> _gitBranches = [];
    private string? _gitRemoteUrl;
    private string? _gitCompareUrl;
    private LinkedGitFileDiff? _gitDiff;
    private bool _gitDiffLoading;
    private string _gitBranchToSwitch = string.Empty;
    private string _gitBranchName = string.Empty;
    private string _gitCommitMessage = string.Empty;
    private string? _gitMessage;
    private bool _gitMessageIsError;
    private string? _pendingRevertGitFilePath;
    private bool _showConfigureSecretDialog;
    private string? _secretNameToConfigure;
    private string _secretValueToConfigure = string.Empty;
    private string? _secretConfigError;
    private string? _workflowMessage;
    private bool _workflowMessageIsError;
    private bool _showCurlImportDialog;
    private string _curlImportText = string.Empty;
    private string? _curlImportError;
    private IReadOnlyList<VariableInspectionItem> _variableInspectionItems = [];
    private bool _variableInspectorLoading;
    private readonly List<string> _pinnedRequestIds = [];
    private readonly Dictionary<string, bool> _dirtyByRequestId = new(StringComparer.Ordinal);
    private readonly Dictionary<string, HttpRequestResult> _lastResultByRequestId = new(StringComparer.Ordinal);
    private readonly Dictionary<string, List<GraphQlSubscriptionMessage>> _subscriptionMessagesByRequestId = new(StringComparer.Ordinal);
    private readonly List<CollectionRunItemResult> _runnerResults = [];
    private bool _runnerRunning;
    private CancellationTokenSource? _runnerCts;

    // Phase 2 — execution state
    private HttpRequestResult? _lastResult;

    // Phase 8 — request history (last 20 per request, in-memory only)
    private readonly Dictionary<string, List<HttpRequestResult>> _requestHistory = new(StringComparer.Ordinal);
    private const int HistoryCap = 20;

    // Phase 5 — subscription state (capped at 1 000; oldest entry dropped when full)
    private readonly List<GraphQlSubscriptionMessage> _subscriptionMessages = [];
    private const int SubscriptionMessageCap = 1_000;

    // Worksheet mode constants
    private const string WorksheetEnvs = "envs";
    private const string WorksheetVars = "vars";
    private const string WorksheetLinkedRoots = "linked-roots";
    private const string WorksheetGit = "git";
    private const string WorksheetVariables = "variables";
    private const string WorksheetRunner = "runner";

    // Worksheet mode: null = request, WorksheetVars = collection variable editor, WorksheetEnvs = environment manager
    private string? _worksheetMode;
    // Scope version: incremented when collection variables are saved so RequestBuilderPanel rebuilds its resolved scope
    private int _scopeVersion;

    // New-collection dialog state
    private bool _showNewCollectionDialog;
    private string _newCollectionName = string.Empty;
    private ElementReference _newCollectionInput;
    private bool _shouldFocusNewCollectionInput;

    // Add linked root dialog state
    private bool _showLinkedRootDialog;
    private string _newLinkedRootName = string.Empty;
    private string _newLinkedRootPath = string.Empty;
    private string? _linkedRootError;
    private ElementReference _newLinkedRootInput;
    private bool _shouldFocusLinkedRootInput;

    // Delete-collection confirm state
    private string? _pendingDeleteCollectionId;
    private string? _pendingDeleteCollectionName;

    // Export / import dialog
    private bool _showExportDialog;

    // Splitter drag
    private ElementReference _splitterEl;
    private ElementReference _builderPanelEl;
    private IJSObjectReference? _splitterHandle;
    private string? _lastSplitterRequestId;

    // Auto-save debounce
    private System.Timers.Timer? _autoSaveTimer;
    private const int AutoSaveDebounceMs = 500;

    // ── Computed ──────────────────────────────────────────────────────────────
    private ApiEnvironment? ActiveEnvironment =>
        _environments.FirstOrDefault(e => e.Id == _activeEnvironmentId);

    private LinkedCollectionRootLoadResult? ActiveGitRoot =>
        _linkedRootResults.FirstOrDefault(root => root.Config.Id == _activeGitRootId);

    private LinkedCollectionRootLoadResult? ActiveLinkedRoot =>
        _linkedRootResults.FirstOrDefault(root => root.Config.Id == _activeLinkedRootId);

    private LinkedCollectionRootLoadResult? CurrentTargetLinkedRoot =>
        ActiveLinkedRoot ?? (_activeCollection is not null ? FindLinkedRootForCollection(_activeCollection.Id) : null);

    private string CurrentTargetLabel => CurrentTargetLinkedRoot is { } linkedRoot
        ? $"Repo — {linkedRoot.DisplayName}"
        : _activeCollection is not null
            ? $"Local — {_activeCollection.Name}"
            : "Local collections";

    private string CurrentTargetHint => CurrentTargetLinkedRoot is { } linkedRoot
        ? $"New collections are created in {linkedRoot.ApiRootPath}. New requests require a collection inside that linked repo."
        : _activeCollection is not null
            ? $"New requests are created in local collection '{_activeCollection.Name}'."
            : "New collections are created in local SwebKit storage.";

    private IReadOnlyList<string> MissingSecretNames =>
        _selectedRequest is not null && _activeCollection is not null && IsLinkedCollection(_activeCollection.Id)
            ? GetMissingSecretNames(_selectedRequest, ActiveEnvironment)
            : [];

    private bool IsSelectedRequestPinned =>
        _selectedRequestId is not null && _pinnedRequestIds.Contains(_selectedRequestId);

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _autoSave = UserSettings.Settings.AutoSaveRequests;

        // Kick Monaco asset load in the background so it is ready before the user opens a GQL request.
        // Fire-and-forget: failures are handled inside monacoLoader.js.
        _ = JS.InvokeVoidAsync("SwebKitUi.ensureMonacoLoaded").AsTask();

        // Register keyboard shortcuts in the command palette
        RegisterApiClientCommands();

        // Subscribe to keyboard shortcut events published by MainLayout
        Events.Subscribe<ApiClientShortcutEvent>(OnApiClientShortcut);

        // Load local collections/environments first, then merge linked roots into the collection list.
        await Task.WhenAll(LoadCollectionsAsync(), LoadEnvironmentsAsync());
        await LoadLinkedRootsAsync();

        _loadingCollections = false;
    }

    private async Task LoadCollectionsAsync()
    {
        try
        {
            await CollectionRepo.LoadAsync();
            _collections = BuildCombinedCollections();
            _activeCollection = _collections.FirstOrDefault();

            // Restore last selected request for the active collection
            if (_activeCollection is not null &&
                EnvironmentRepo.UiState.LastSelectedRequestIdByCollection
                    .TryGetValue(_activeCollection.Id, out var lastId))
            {
                RestoreSelectedRequest(lastId);
            }
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load collections");
            _collections = [];
        }
    }

    private async Task LoadLinkedRootsAsync()
    {
        try
        {
            await LinkedRootRepo.LoadAsync();
            _linkedRootResults.Clear();
            var linkedCollections = new List<ApiCollection>();

            foreach (var root in LinkedRootRepo.Roots.Where(static r => r.IsEnabled))
            {
                var result = await LinkedFileService.LoadRootAsync(root);
                _linkedRootResults.Add(result);
                linkedCollections.AddRange(result.Collections);
            }

            _collections = CollectionRepo.Collections.Concat(linkedCollections).ToList();
            _environments = EnvironmentRepo.Environments.Concat(_linkedRootResults.SelectMany(result =>
result.Environments)).ToList();
            _linkedRootInfos = _linkedRootResults.Select(result => new LinkedCollectionTreeInfo
            {
                Id = result.Config.Id,
                Name = result.DisplayName,
                Path = result.ApiRootPath,
                Branch = result.GitStatus.Branch,
                ChangedFileCount = result.GitStatus.ChangedFileCount,
                IsGitRepository = result.GitStatus.IsGitRepository,
                IsValid = result.IsValid,
                CollectionIds = result.Collections.Select(c => c.Id).ToList(),
            }).ToList();

            _activeCollection ??= _collections.FirstOrDefault();
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load linked collection roots");
            _linkedRootInfos = [];
        }
    }

    private async Task LoadEnvironmentsAsync()
    {
        try
        {
            await EnvironmentRepo.LoadAsync();
            _environments = BuildCombinedEnvironments();
            _activeEnvironmentId = EnvironmentRepo.UiState.ActiveEnvironmentId;
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load environments");
            _environments = [];
        }
    }

    private void RestoreSelectedRequest(string requestId)
    {
        if (_activeCollection is null) return;
        var (_, request) = CollectionRepo.FindRequest(requestId);
        if (request is not null)
        {
            _selectedRequestId = requestId;
            _selectedRequest = request;
        }
    }

    // ── Toolbar actions ───────────────────────────────────────────────────────

    private void OpenNewCollectionDialog()
    {
        _newCollectionName = string.Empty;
        _showNewCollectionDialog = true;
        _shouldFocusNewCollectionInput = true;
    }

    private void OpenLinkedRootDialog()
    {
        _newLinkedRootName = string.Empty;
        _newLinkedRootPath = string.Empty;
        _linkedRootError = null;
        _showLinkedRootDialog = true;
        _shouldFocusLinkedRootInput = true;
    }

    private void OpenCurlImportDialog()
    {
        _curlImportText = string.Empty;
        _curlImportError = null;
        _showCurlImportDialog = true;
    }

    private async Task ImportCurlAsync()
    {
        if (_activeCollection is null) return;

        var result = WorkflowService.ImportCurl(_curlImportText);
        if (!result.IsSuccess || result.Request is null)
        {
            _curlImportError = result.ErrorMessage ?? "Could not import the cURL command.";
            return;
        }

        var request = result.Request;
        _activeCollection.Nodes.Add(new ApiCollectionNode
        {
            Id = Guid.NewGuid().ToString("N"),
            Type = ApiCollectionNodeType.Request,
            Name = request.Name,
            Request = request,
        });
        _selectedRequest = request;
        _selectedRequestId = request.Id;
        _showCurlImportDialog = false;
        _workflowMessage = "Imported cURL request.";
        _workflowMessageIsError = false;

        if (await SaveActiveCollectionAsync())
        {
            _isDirty = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task CopyCurlAsync()
    {
        if (_selectedRequest is null || _activeCollection is null) return;

        var curl = await WorkflowService.BuildCurlAsync(_selectedRequest, _activeCollection, ActiveEnvironment);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", curl);
            _workflowMessage = "Copied masked cURL command.";
            _workflowMessageIsError = false;
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            _workflowMessage = "Clipboard copy failed.";
            _workflowMessageIsError = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenVariableInspectorAsync()
    {
        _worksheetMode = _worksheetMode == WorksheetVariables ? null : WorksheetVariables;
        if (_worksheetMode != WorksheetVariables || _selectedRequest is null || _activeCollection is null)
        {
            return;
        }

        _variableInspectorLoading = true;
        await InvokeAsync(StateHasChanged);
        _variableInspectionItems = await WorkflowService.InspectVariablesAsync(_selectedRequest, _activeCollection, ActiveEnvironment);
        _variableInspectorLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmLinkedRootAsync()
    {
        if (string.IsNullOrWhiteSpace(_newLinkedRootPath)) return;

        try
        {
            var path = _newLinkedRootPath.Trim();
            var name = string.IsNullOrWhiteSpace(_newLinkedRootName) ? null : _newLinkedRootName.Trim();
            await LinkedFileService.EnsureRootAsync(path, name ?? string.Empty);
            await LinkedRootRepo.AddRootAsync(path, name);
            await LoadLinkedRootsAsync();
            _showLinkedRootDialog = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            _linkedRootError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RemoveLinkedRootAsync(string rootId)
    {
        await LinkedRootRepo.RemoveRootAsync(rootId);
        if (_activeGitRootId == rootId)
            _activeGitRootId = null;
        await LoadLinkedRootsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenGitPanelAsync(string rootId)
    {
        _activeGitRootId = rootId;
        _gitMessage = null;
        _gitMessageIsError = false;
        _worksheetMode = WorksheetGit;
        await RefreshGitBranchesAsync();
    }

    private async Task CreateGitBranchAsync()
    {
        if (ActiveGitRoot is null) return;
        await ApplyGitResultAsync(await LinkedGit.CreateBranchAsync(ActiveGitRoot.ApiRootPath, _gitBranchName));
        if (!_gitMessageIsError)
        {
            _gitBranchName = string.Empty;
        }
    }

    private async Task SwitchGitBranchAsync()
    {
        if (ActiveGitRoot is null) return;
        await ApplyGitResultAsync(await LinkedGit.SwitchBranchAsync(ActiveGitRoot.ApiRootPath, ActiveGitRoot.ApiRootPath,
_gitBranchToSwitch));
    }

    private async Task CommitGitChangesAsync()
    {
        if (ActiveGitRoot is null) return;
        await ApplyGitResultAsync(await LinkedGit.CommitStagedApiFilesAsync(ActiveGitRoot.ApiRootPath, ActiveGitRoot.ApiRootPath,
_gitCommitMessage));
        if (!_gitMessageIsError)
        {
            _gitCommitMessage = string.Empty;
        }
    }

    private async Task StageAllGitFilesAsync()
    {
        if (ActiveGitRoot is null) return;
        await ApplyGitResultAsync(await LinkedGit.StageAllApiFilesAsync(ActiveGitRoot.ApiRootPath, ActiveGitRoot.ApiRootPath));
    }

    private async Task UnstageAllGitFilesAsync()
    {
        if (ActiveGitRoot is null) return;
        await ApplyGitResultAsync(await LinkedGit.UnstageAllApiFilesAsync(ActiveGitRoot.ApiRootPath, ActiveGitRoot.ApiRootPath));
    }

    private async Task StageGitFileAsync(string path)
    {
        if (ActiveGitRoot is null) return;
        await ApplyGitResultAsync(await LinkedGit.StageFileAsync(ActiveGitRoot.ApiRootPath, ActiveGitRoot.ApiRootPath, path));
    }

    private async Task UnstageGitFileAsync(string path)
    {
        if (ActiveGitRoot is null) return;
        await ApplyGitResultAsync(await LinkedGit.UnstageFileAsync(ActiveGitRoot.ApiRootPath, ActiveGitRoot.ApiRootPath, path));
    }

    private async Task LoadGitDiffAsync(string path)
    {
        if (ActiveGitRoot is null) return;

        _gitDiffLoading = true;
        _gitDiff = null;
        await InvokeAsync(StateHasChanged);

        _gitDiff = await LinkedGit.GetFileDiffAsync(ActiveGitRoot.ApiRootPath, ActiveGitRoot.ApiRootPath, path);
        _gitDiffLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void QueueRevertGitFile(string path)
    {
        _pendingRevertGitFilePath = path;
    }

    private async Task ConfirmRevertGitFileAsync()
    {
        if (ActiveGitRoot is null || _pendingRevertGitFilePath is null) return;
        var path = _pendingRevertGitFilePath;
        _pendingRevertGitFilePath = null;
        await ApplyGitResultAsync(await LinkedGit.RevertFileAsync(ActiveGitRoot.ApiRootPath, ActiveGitRoot.ApiRootPath, path));
    }

    private async Task PushGitBranchAsync()
    {
        if (ActiveGitRoot is null) return;
        await ApplyGitResultAsync(await LinkedGit.PushCurrentBranchAsync(ActiveGitRoot.ApiRootPath));
    }

    private async Task OpenRemoteCompareAsync()
    {
        if (ActiveGitRoot is null) return;
        var url = _gitCompareUrl ?? await LinkedGit.GetRemoteCompareUrlAsync(ActiveGitRoot.ApiRootPath);
        if (url is null)
        {
            _gitMessage = "Could not infer a GitHub or Azure DevOps compare URL from the origin remote.";
            _gitMessageIsError = true;
            return;
        }

        await JS.InvokeVoidAsync("open", url, "_blank");
        _gitMessage = "Opened compare view in the browser.";
        _gitMessageIsError = false;
    }

    private async Task ApplyGitResultAsync(LinkedGitCommandResult result)
    {
        _gitMessage = result.IsSuccess ? result.Message : result.ErrorMessage;
        _gitMessageIsError = !result.IsSuccess;
        _gitDiff = null;
        await LoadLinkedRootsAsync();
        await RefreshGitBranchesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshGitBranchesAsync()
    {
        if (ActiveGitRoot is null)
        {
            _gitBranches = [];
            _gitBranchToSwitch = string.Empty;
            return;
        }

        _gitBranches = await LinkedGit.GetBranchesAsync(ActiveGitRoot.ApiRootPath);
        _gitRemoteUrl = await LinkedGit.GetOriginRemoteUrlAsync(ActiveGitRoot.ApiRootPath);
        _gitCompareUrl = await LinkedGit.GetRemoteCompareUrlAsync(ActiveGitRoot.ApiRootPath);
        var current = _gitBranches.FirstOrDefault(static branch => branch.IsCurrent)?.Name ?? ActiveGitRoot.GitStatus.Branch;
        if (string.IsNullOrWhiteSpace(_gitBranchToSwitch) || !_gitBranches.Any(branch => branch.Name.Equals(_gitBranchToSwitch, StringComparison.OrdinalIgnoreCase)))
        {
            _gitBranchToSwitch = current ?? _gitBranches.FirstOrDefault()?.Name ?? string.Empty;
        }
    }

    private async Task ConfirmNewCollectionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCollectionName)) return;
        var collection = await CreateCollectionForCurrentTargetAsync(_newCollectionName.Trim());
        _activeCollection = collection;
        _showNewCollectionDialog = false;
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task OnNewCollectionKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmNewCollectionAsync();
        else if (e.Key == "Escape") _showNewCollectionDialog = false;
    }

    private async Task AddCollectionAsync()
    {
        var collection = await CreateCollectionForCurrentTargetAsync("New Collection");
        _activeCollection = collection;
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task<ApiCollection> CreateCollectionForCurrentTargetAsync(string name)
    {
        if (ActiveLinkedRoot is not null)
        {
            var rootId = ActiveLinkedRoot.Config.Id;
            var collectionId = await LinkedFileService.CreateCollectionAsync(ActiveLinkedRoot.ApiRootPath, name);
            await LoadLinkedRootsAsync();
            _activeLinkedRootId = rootId;
            return _collections.First(collection => collection.Id == collectionId);
        }

        var collection = await CollectionRepo.AddCollectionAsync(name);
        _collections = BuildCombinedCollections();
        _activeLinkedRootId = null;
        return collection;
    }

    private async Task AddRequestAsync()
    {
        if (_activeCollection is null) return;

        var request = new HttpRequestEntry
        {
            Id = Guid.NewGuid().ToString("N"),
            Name = "New Request",
            Method = ApiRequestMethod.Get,
            Url = string.Empty,
            CreatedAt = DateTimeOffset.UtcNow,
            UpdatedAt = DateTimeOffset.UtcNow,
        };

        _activeCollection.Nodes.Add(new ApiCollectionNode
        {
            Id = Guid.NewGuid().ToString("N"),
            Type = ApiCollectionNodeType.Request,
            Name = request.Name,
            Request = request,
        });

