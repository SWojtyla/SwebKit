    private async Task OnRequestSelectedAsync(HttpRequestEntry request)
    {
        _selectedRequest = request;
        _selectedRequestId = request.Id;
        _isDirty = _dirtyByRequestId.GetValueOrDefault(request.Id);
        _linkedSaveError = null;
        _linkedSaveConflict = null;
        _lastResult = _lastResultByRequestId.GetValueOrDefault(request.Id);
        _subscriptionMessages.Clear();
        if (_subscriptionMessagesByRequestId.TryGetValue(request.Id, out var messages))
        {
            _subscriptionMessages.AddRange(messages);
        }

        if (_activeCollection is not null)
        {
            // Fire-and-forget persistence of last selection; non-blocking
            _ = PersistLastSelectionAsync(_activeCollection.Id, request.Id);
