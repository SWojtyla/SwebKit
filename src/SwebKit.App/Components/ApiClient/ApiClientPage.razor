    // ── Splitter (JS drag) ─────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus the new-collection dialog input when it opens
        if (_shouldFocusNewCollectionInput)
        {
            _shouldFocusNewCollectionInput = false;
            try { await _newCollectionInput.FocusAsync(); } catch { }
        }

        if (_shouldFocusLinkedRootInput)
        {
            _shouldFocusLinkedRootInput = false;
            try { await _newLinkedRootInput.FocusAsync(); }
            catch { }
        }

        // Init the splitter whenever the panels become visible for a new request.
        // _lastSplitterRequestId tracks which request the current JS handle was set up for.
        if (_selectedRequest is not null && _lastSplitterRequestId != _selectedRequestId)
        {
            await DisposeSplitterAsync();
            _lastSplitterRequestId = _selectedRequestId;
            _splitterHandle = await JS.InvokeAsync<IJSObjectReference>(
                "SwebKitSplitter.init",
                _splitterEl,
                _builderPanelEl,
                new { leftPane = true, minWidth = 250, maxWidth = 1600 });
        }
        else if (_selectedRequest is null && _splitterHandle is not null)
        {
            await DisposeSplitterAsync();
            _lastSplitterRequestId = null;
        }
    }

    private async Task DisposeSplitterAsync()
    {
        if (_splitterHandle is null) return;
        try { await _splitterHandle.InvokeVoidAsync("dispose"); } catch { /* ignore teardown errors */ }
        try { await _splitterHandle.DisposeAsync(); } catch { }
        _splitterHandle = null;
    }

    // ── Keyboard shortcut event handler ─────────────────────────────────────────

    private void OnApiClientShortcut(ApiClientShortcutEvent e)
    {
        _ = InvokeAsync(async () =>
        {
            switch (e.Action)
            {
                case "NewRequest":
                    if (_activeCollection is not null)
                        await AddRequestAsync();
                    break;
                case "NewCollection":
                    OpenNewCollectionDialog();
                    break;
                case "EnvManager":
                    _worksheetMode = _worksheetMode == WorksheetEnvs ? null : WorksheetEnvs;
                    break;
            }
            await InvokeAsync(StateHasChanged); // BL-2
        });
    }

    private void RegisterApiClientCommands()
    {
        Commands.Register(new AppCommand
        {
            Id = "api-new-request",
            Label = "API Client: New Request",
            Category = "API Client",
            Icon = "＋",
            Shortcut = "Ctrl+N",
            AreaScope = "api-client",
            Execute = async () => { if (_activeCollection is not null) await AddRequestAsync(); },
        });
        Commands.Register(new AppCommand
        {
            Id = "api-new-collection",
            Label = "API Client: New Collection",
            Category = "API Client",
            Icon = "📦",
            Shortcut = "Ctrl+Shift+N",
            AreaScope = "api-client",
            Execute = () => { OpenNewCollectionDialog(); return Task.CompletedTask; },
        });
        Commands.Register(new AppCommand
        {
            Id = "api-env-manager",
            Label = "API Client: Manage Environments",
            Category = "API Client",
            Icon = "🌍",
            Shortcut = "Ctrl+E",
            AreaScope = "api-client",
            Execute = () =>
            {
                _worksheetMode = _worksheetMode == WorksheetEnvs ? null : WorksheetEnvs;
                return InvokeAsync(StateHasChanged);
            },
        });
        Commands.Register(new AppCommand
        {
            Id = "api-quick-nav",
            Label = "API Client: Quick Nav (Request Picker)",
            Category = "API Client",
            Icon = "⌕",
            Shortcut = "Ctrl+P",
            AreaScope = "api-client",
            Execute = () => Task.CompletedTask, // handled by global Ctrl+P → CommandPalette
        });
    }

    // ── IAsyncDisposable ───────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        Events.Unsubscribe<ApiClientShortcutEvent>(OnApiClientShortcut);
        Commands.Unregister("api-new-request");
        Commands.Unregister("api-new-collection");
        Commands.Unregister("api-env-manager");
        Commands.Unregister("api-quick-nav");
        _runnerCts?.Cancel();
        _runnerCts?.Dispose();
        _autoSaveTimer?.Stop();
        _autoSaveTimer?.Dispose();
        await DisposeSplitterAsync();
    }

    private LinkedCollectionRootLoadResult? FindLinkedRootForCollection(string collectionId) =>
        _linkedRootResults.FirstOrDefault(root => root.Collections.Any(collection => collection.Id == collectionId));

    private (LinkedCollectionRootLoadResult Root, LinkedEnvironmentFileState EnvironmentFile)?
FindLinkedRootForEnvironment(string environmentId)
    {
        foreach (var root in _linkedRootResults)
        {
            var environmentFile = root.EnvironmentFiles.FirstOrDefault(file => file.EnvironmentId == environmentId);
            if (environmentFile is not null)
                return (root, environmentFile);
        }

        return null;
    }

    private LinkedRequestFileState? FindLinkedRequestFileState(string requestId) =>
        _linkedRootResults.SelectMany(root => root.RequestFiles).FirstOrDefault(file => file.RequestId == requestId);

    private (ApiCollection? Collection, HttpRequestEntry? Request) FindCollectionAndRequest(string requestId)
    {
        foreach (var collection in _collections)
        {
            var request = FindRequestInNodes(collection.Nodes, requestId);
            if (request is not null)
            {
                return (collection, request);
            }
        }

        return (null, null);
    }

    private static string FormatElapsed(TimeSpan elapsed)
    {
        if (elapsed == TimeSpan.Zero)
        {
            return "—";
        }

        return elapsed.TotalSeconds >= 1
            ? $"{elapsed.TotalSeconds:F2} s"
            : $"{elapsed.TotalMilliseconds:F0} ms";
    }

    private IReadOnlyList<LinkedGitChangedFile> GetStagedGitFiles() =>
        ActiveGitRoot?.GitStatus.ChangedFileDetails.Where(static file => file.IsStaged).ToList() ?? [];

    private IReadOnlyList<LinkedGitChangedFile> GetUnstagedGitFiles() =>
        ActiveGitRoot?.GitStatus.ChangedFileDetails.Where(static file => file.HasUnstagedChanges).ToList() ?? [];

    private static string GetDiffPreviewText(string text)
    {
        const int MaxDiffPreviewChars = 40_000;
        return text.Length <= MaxDiffPreviewChars
            ? text
            : string.Concat(text.AsSpan(0, MaxDiffPreviewChars), "\n... diff preview truncated ...");
    }

    private sealed record LinkedSaveConflict(
        string RootId,
        string CollectionId,
        string RequestId,
        string? RequestFilePath,
        string Message);

    private List<ApiCollection> BuildCombinedCollections() =>
        CollectionRepo.Collections.Concat(_linkedRootResults.SelectMany(root => root.Collections)).ToList();

    private List<ApiEnvironment> BuildCombinedEnvironments() =>
        EnvironmentRepo.Environments.Concat(_linkedRootResults.SelectMany(root => root.Environments)).ToList();
}
