    }

    private async Task<bool> SaveActiveCollectionAsync(bool forceLinkedOverwrite = false)
    {
        if (_activeCollection is null || _selectedRequest is null) return false;

        var linkedRoot = FindLinkedRootForCollection(_activeCollection.Id);
        if (linkedRoot is not null)
        {
            var savedRequestId = _selectedRequest.Id;
            var expectedStamp = forceLinkedOverwrite ? null : FindLinkedRequestFileState(savedRequestId)?.ContentStamp;
            var saveResult = await LinkedFileService.SaveRequestAsync(linkedRoot.ApiRootPath, _activeCollection, _selectedRequest,
expectedStamp);
            if (!saveResult.IsSuccess)
            {
                if (saveResult.HasConflict)
                {
                    _linkedSaveConflict = new LinkedSaveConflict(
                        linkedRoot.Config.Id,
                        _activeCollection.Id,
                        savedRequestId,
                        saveResult.RequestFilePath,
                        saveResult.ErrorMessage ?? "The linked request changed on disk.");
                    _linkedSaveError = null;
                }
                else
                {
                    _linkedSaveError = saveResult.ErrorMessage;
                    _linkedSaveConflict = null;
                }

                return false;
            }

            _linkedSaveError = null;
            _linkedSaveConflict = null;
            await LoadLinkedRootsAsync();
            var refreshed = _collections.FirstOrDefault(collection => collection.Id == _activeCollection.Id);
            _activeCollection = refreshed ?? _activeCollection;
            _selectedRequest = FindRequestInNodes(_activeCollection.Nodes, savedRequestId);
            _selectedRequestId = _selectedRequest?.Id;
            _dirtyByRequestId[savedRequestId] = false;
            return true;
        }

        await CollectionRepo.UpdateCollectionAsync(_activeCollection);
        _collections = CollectionRepo.Collections.Concat(_linkedRootResults.SelectMany(r => r.Collections)).ToList();
        _linkedSaveError = null;
        _linkedSaveConflict = null;
        if (_selectedRequestId is not null)
        {
            _dirtyByRequestId[_selectedRequestId] = false;
        }
        return true;
    }

    private async Task ReloadLinkedConflictAsync()
    {
        if (_linkedSaveConflict is null) return;

        var conflict = _linkedSaveConflict;
        await LoadLinkedRootsAsync();
        _activeLinkedRootId = conflict.RootId;
        _activeCollection = _collections.FirstOrDefault(collection => collection.Id == conflict.CollectionId);
        _selectedRequest = _activeCollection is not null ? FindRequestInNodes(_activeCollection.Nodes, conflict.RequestId) : null;
        _selectedRequestId = _selectedRequest?.Id;
        _linkedSaveConflict = null;
        _linkedSaveError = null;
        _isDirty = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task KeepMineLinkedConflictAsync()
    {
        if (_linkedSaveConflict is null || _activeCollection is null || _selectedRequest is null) return;

        if (await SaveActiveCollectionAsync(forceLinkedOverwrite: true))
        {
            _isDirty = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveLinkedConflictAsCopyAsync()
    {
        if (_linkedSaveConflict is null || _activeCollection is null || _selectedRequest is null) return;

        var copy = CloneRequestAsCopy(_selectedRequest);
        _activeCollection.Nodes.Add(new ApiCollectionNode
        {
            Id = Guid.NewGuid().ToString("N"),
            Type = ApiCollectionNodeType.Request,
            Name = copy.Name,
            Request = copy,
        });
        _selectedRequest = copy;
        _selectedRequestId = copy.Id;

        if (await SaveActiveCollectionAsync(forceLinkedOverwrite: true))
        {
            _isDirty = false;
        }

        await InvokeAsync(StateHasChanged);
    }

