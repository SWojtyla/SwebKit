    private async Task OnRenameNodeAsync((ApiCollectionNode Node, string NewName) args)
    {
        if (_activeCollection is null) return;
        if (IsLinkedCollection(_activeCollection.Id) && args.Node.Type == ApiCollectionNodeType.Folder)
            return;

        RenameNodeInTree(_activeCollection.Nodes, args.Node.Id, args.NewName);
        if (args.Node.Request is not null)
            args.Node.Request.Name = args.NewName;
        _selectedRequest = args.Node.Request ?? _selectedRequest;
        if (IsLinkedCollection(_activeCollection.Id) && args.Node.Request is not null)
            await SaveActiveCollectionAsync();
        else
            await CollectionRepo.UpdateCollectionAsync(_activeCollection);
        _collections = CollectionRepo.Collections.Concat(_linkedRootResults.SelectMany(r => r.Collections)).ToList();
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task OnDeleteNodeAsync(ApiCollectionNode node)
    {
        if (_activeCollection is null) return;
        if (IsLinkedCollection(_activeCollection.Id))
            return;

        RemoveNodeFromTree(_activeCollection.Nodes, node.Id);

        if (_selectedRequestId is not null &&
            (node.Request?.Id == _selectedRequestId ||
             ContainsRequest(node.Children, _selectedRequestId)))
        {
            _selectedRequest = null;
            _selectedRequestId = null;
            _isDirty = false;
        }

        await CollectionRepo.UpdateCollectionAsync(_activeCollection);
        _collections = BuildCombinedCollections();
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task OnRenameCollectionAsync((string CollectionId, string NewName) args)
    {
        var collection = _collections.FirstOrDefault(c => c.Id == args.CollectionId);
        if (collection is null) return;
        if (IsLinkedCollection(collection.Id))
            return;

        collection.Name = args.NewName;
        await CollectionRepo.UpdateCollectionAsync(collection);
        _collections = BuildCombinedCollections();
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private Task OnDeleteCollectionAsync(string collectionId)
    {
        if (IsLinkedCollection(collectionId))
            return Task.CompletedTask;

        var collection = _collections.FirstOrDefault(c => c.Id == collectionId);
        _pendingDeleteCollectionId = collectionId;
        _pendingDeleteCollectionName = collection?.Name ?? "this collection";
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteCollectionAsync()
    {
        if (_pendingDeleteCollectionId is null) return;
        var id = _pendingDeleteCollectionId;
        _pendingDeleteCollectionId = null;
        _pendingDeleteCollectionName = null;
        await CollectionRepo.DeleteCollectionAsync(id);
        _collections = BuildCombinedCollections();
        if (_activeCollection?.Id == id)
        {
            _activeCollection = _collections.FirstOrDefault();
            _selectedRequest = null;
            _selectedRequestId = null;
            _isDirty = false;
        }
        await InvokeAsync(StateHasChanged); // BL-2
    }

    // ── Tree helpers ───────────────────────────────────────────────────────────

    private static void SyncNodeName(List<ApiCollectionNode> nodes, string requestId, string name)
    {
        foreach (var node in nodes)
        {
            if (node.Request?.Id == requestId) { node.Name = name; return; }
            if (node.Type == ApiCollectionNodeType.Folder) SyncNodeName(node.Children, requestId, name);
        }
    }

    private static bool AddNodeToParent(List<ApiCollectionNode> nodes, string parentId, ApiCollectionNode newNode)
    {
        foreach (var node in nodes)
        {
            if (node.Id == parentId && node.Type == ApiCollectionNodeType.Folder)
            {
                node.Children.Add(newNode);
                return true;
            }
            if (node.Type == ApiCollectionNodeType.Folder && AddNodeToParent(node.Children, parentId, newNode))
                return true;
        }
        return false;
    }

    private static bool RenameNodeInTree(List<ApiCollectionNode> nodes, string nodeId, string newName)
    {
        foreach (var node in nodes)
        {
            if (node.Id == nodeId) { node.Name = newName; return true; }
            if (node.Type == ApiCollectionNodeType.Folder && RenameNodeInTree(node.Children, nodeId, newName))
                return true;
        }
        return false;
    }

    private static bool RemoveNodeFromTree(List<ApiCollectionNode> nodes, string nodeId)
    {
        var idx = nodes.FindIndex(n => n.Id == nodeId);
        if (idx >= 0) { nodes.RemoveAt(idx); return true; }

        foreach (var node in nodes.Where(n => n.Type == ApiCollectionNodeType.Folder))
        {
            if (RemoveNodeFromTree(node.Children, nodeId))
                return true;
        }
        return false;
    }

    private static bool ContainsRequest(List<ApiCollectionNode> nodes, string requestId)
    {
        foreach (var node in nodes)
        {
            if (node.Type == ApiCollectionNodeType.Request && node.Request?.Id == requestId) return true;
            if (node.Type == ApiCollectionNodeType.Folder && ContainsRequest(node.Children, requestId)) return true;
        }
        return false;
    }

    private static HttpRequestEntry? FindRequestInNodes(List<ApiCollectionNode> nodes, string requestId)
    {
        foreach (var node in nodes)
        {
            if (node.Type == ApiCollectionNodeType.Request && node.Request?.Id == requestId)
                return node.Request;

            if (node.Type == ApiCollectionNodeType.Folder)
            {
                var found = FindRequestInNodes(node.Children, requestId);
                if (found is not null)
                    return found;
            }
        }

        return null;
    }

    private static HttpRequestEntry CloneRequestAsCopy(HttpRequestEntry request)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(request);
        var copy = System.Text.Json.JsonSerializer.Deserialize<HttpRequestEntry>(json) ?? new HttpRequestEntry();
        var now = DateTimeOffset.UtcNow;
        copy.Id = Guid.NewGuid().ToString("N");
        copy.Name = $"{request.Name} copy";
        copy.CreatedAt = now;
        copy.UpdatedAt = now;
        return copy;
    }

    private bool IsLinkedCollection(string collectionId) =>
        _linkedRootResults.Any(root => root.Collections.Any(collection => collection.Id == collectionId));

    private IReadOnlyList<string> GetMissingSecretNames(HttpRequestEntry request, ApiEnvironment? activeEnvironment)
    {
        var allSecretNames = ExtractSecretNames(request);
        if (allSecretNames.Count == 0)
            return [];

        if (activeEnvironment is null)
            return allSecretNames;

        return allSecretNames.Where(name => !IsSecretConfigured(activeEnvironment, name)).ToList();
    }

    private bool IsSecretConfigured(ApiEnvironment activeEnvironment, string secretName)
    {
        var variable = activeEnvironment.Variables.FirstOrDefault(v => string.Equals(v.Key, $"secret:{secretName}",
StringComparison.OrdinalIgnoreCase));
        if (variable is null || !variable.IsEnabled)
            return false;

        if (variable.SecretSource == EnvironmentVariableSecretSource.AzureKeyVault)
            return !string.IsNullOrWhiteSpace(variable.CredentialKey);

        return !string.IsNullOrWhiteSpace(variable.CredentialKey) && CredentialStore.Get(variable.CredentialKey) is not null;
    }

    private static IReadOnlyList<string> ExtractSecretNames(HttpRequestEntry request)
    {
        var values = new List<string?>
        {
            request.Url,
            request.Body.RawContent,
            request.GraphQlQuery,
            request.GraphQlVariables,
        };
        values.AddRange(request.Headers.Select(header => header.Value));
        values.AddRange(request.QueryParams.Select(param => param.Value));

        return values
            .Where(static value => !string.IsNullOrWhiteSpace(value))
            .SelectMany(static value => System.Text.RegularExpressions.Regex.Matches(value!,
"\\{\\{secret:([^}]+)\\}\\}").Select(match => match.Groups[1].Value.Trim()))
            .Where(static value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(static value => value, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string GetMethodLabel(ApiRequestMethod method) => method switch
    {
        ApiRequestMethod.Get => "GET",
        ApiRequestMethod.Post => "POST",
        ApiRequestMethod.Put => "PUT",
        ApiRequestMethod.Patch => "PATCH",
        ApiRequestMethod.Delete => "DEL",
        ApiRequestMethod.Head => "HEAD",
        ApiRequestMethod.Options => "OPT",
        ApiRequestMethod.GraphQl => "GQL",
        ApiRequestMethod.WebSocket => "WS",
        _ => "GET",
    };

    // ── Request change + auto-save ─────────────────────────────────────────────

    private async Task OnRequestChangedAsync()
    {
        _isDirty = true;
        _linkedSaveError = null;

        if (_selectedRequestId is not null)
        {
            _dirtyByRequestId[_selectedRequestId] = true;
        }

        // Sync ApiCollectionNode.Name from the live request name so the tree view reflects renames
        if (_selectedRequest is not null && _activeCollection is not null)
            SyncNodeName(_activeCollection.Nodes, _selectedRequest.Id, _selectedRequest.Name);

        if (_autoSave)
        {
            _autoSaveTimer?.Stop();
            _autoSaveTimer ??= new System.Timers.Timer(AutoSaveDebounceMs) { AutoReset = false };
            _autoSaveTimer.Elapsed -= OnAutoSaveElapsed;
            _autoSaveTimer.Elapsed += OnAutoSaveElapsed;
            _autoSaveTimer.Start();
        }

        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async void OnAutoSaveElapsed(object? sender, System.Timers.ElapsedEventArgs e)
    {
        if (_activeCollection is null || _selectedRequest is null) return;
        try
        {
            if (await SaveActiveCollectionAsync())
            {
                _isDirty = false;
            }
            await InvokeAsync(StateHasChanged); // BL-2
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Auto-save failed");
        }
    }

    // ── Request result ─────────────────────────────────────────────────────────

    private async Task OnRequestResultAsync(HttpRequestResult result)
    {
        // Clear any previous subscription messages when a normal request completes
        _subscriptionMessages.Clear();
        _lastResult = result;

        // Record in history for the active request
        if (_selectedRequest is not null)
        {
            _lastResultByRequestId[_selectedRequest.Id] = result;
            if (!_requestHistory.TryGetValue(_selectedRequest.Id, out var hist))
            {
                hist = [];
                _requestHistory[_selectedRequest.Id] = hist;
            }
            // Prepend so newest is first; cap at HistoryCap
            hist.Insert(0, result);
            if (hist.Count > HistoryCap)
                hist.RemoveAt(hist.Count - 1);
        }

        await InvokeAsync(StateHasChanged); // BL-2
    }

    // ── Subscription callbacks ─────────────────────────────────────────────────

    private async Task OnSubscriptionMessageAsync(GraphQlSubscriptionMessage msg)
    {
        // Clear the last HTTP result when subscription starts
        if (_subscriptionMessages.Count == 0)
            _lastResult = null;

        // Drop oldest when cap reached to prevent unbounded memory growth
        if (_subscriptionMessages.Count >= SubscriptionMessageCap)
            _subscriptionMessages.RemoveAt(0);

        _subscriptionMessages.Add(msg);
        if (_selectedRequestId is not null)
        {
            if (!_subscriptionMessagesByRequestId.TryGetValue(_selectedRequestId, out var messages))
            {
                messages = [];
                _subscriptionMessagesByRequestId[_selectedRequestId] = messages;
            }

            if (messages.Count >= SubscriptionMessageCap)
            {
                messages.RemoveAt(0);
            }

            messages.Add(msg);
        }
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private Task OnSubscriptionStoppedAsync()
    {
        // Nothing extra; the subscription message list persists until the next send
        return Task.CompletedTask;
    }

    private IReadOnlyList<HttpRequestResult> GetHistoryForSelected() =>
        _selectedRequest is not null && _requestHistory.TryGetValue(_selectedRequest.Id, out var hist)
            ? hist
            : [];

    private Task OnResendHistoryEntryAsync(HttpRequestResult entry)
    {
        // Load the historical result back into the viewer — does not re-execute the request
        _lastResult = entry;
        _subscriptionMessages.Clear();
        return InvokeAsync(StateHasChanged);
    }

    private async Task SaveResponseExampleAsync(HttpRequestResult result)
    {
        if (_selectedRequest is null || _activeCollection is null) return;

        var example = WorkflowService.CreateResponseExample(
            result,
            string.Empty,
            ActiveEnvironment?.Name);
        _selectedRequest.ResponseExamples.Insert(0, example);
        if (await SaveActiveCollectionAsync())
        {
            _workflowMessage = "Saved response example.";
            _workflowMessageIsError = false;
        }
        else
        {
            _workflowMessage = "Response example needs conflict resolution before it can be saved.";
            _workflowMessageIsError = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RunActiveCollectionAsync()
    {
        if (_activeCollection is null || _runnerRunning) return;

        _worksheetMode = WorksheetRunner;
        _runnerResults.Clear();
        _runnerRunning = true;
        _runnerCts?.Dispose();
        _runnerCts = new CancellationTokenSource();
        await InvokeAsync(StateHasChanged);

        try
        {
            await RunnerService.RunAsync(
                _activeCollection,
                ActiveEnvironment,
                async item =>
                {
                    _runnerResults.Add(item);
                    await InvokeAsync(StateHasChanged);
                },
                _runnerCts.Token);

            _workflowMessage = "Collection run completed.";
            _workflowMessageIsError = false;
        }
        catch (OperationCanceledException)
        {
            _workflowMessage = "Collection run cancelled.";
            _workflowMessageIsError = true;
        }
        finally
        {
            _runnerRunning = false;
            _runnerCts?.Dispose();
            _runnerCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task CancelRunnerAsync()
    {
        _runnerCts?.Cancel();
        return Task.CompletedTask;
    }

