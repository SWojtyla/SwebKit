@page "/api-client"
@inject CollectionRepository CollectionRepo
@inject EnvironmentRepository EnvironmentRepo
@inject UserSettingsRepository UserSettings
@inject NavigationManager Nav
@inject ILogger<ApiClientPage> Logger
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="api-client-page">

    @* ── Toolbar ── *@
    <div class="api-client-toolbar">
        <div class="api-client-toolbar__left">
            <button type="button" class="api-client-toolbar-btn" title="New collection (Ctrl+Shift+N)"
                    @onclick="OpenNewCollectionDialog">
                <FluentIcon Value="@(new Icons.Regular.Size16.AddSquare())" Width="14px" />
                <span>New Collection</span>
            </button>
            <button type="button" class="api-client-toolbar-btn" title="New request (Ctrl+N)"
                    disabled="@(_activeCollection is null)" @onclick="AddRequestAsync">
                <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Width="14px" />
                <span>New Request</span>
            </button>
            @if (_isDirty && !_autoSave)
            {
                <button type="button" class="api-client-toolbar-btn api-client-toolbar-btn--save"
                        title="Save request (Ctrl+S)" @onclick="SaveRequestAsync">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Save())" Width="14px" />
                    <span>Save</span>
                </button>
            }
        </div>

        <div class="api-client-toolbar__center">
            @if (_isDirty && !_autoSave)
            {
                <span class="api-client-toolbar__dirty-badge" title="Unsaved changes — press Ctrl+S to save">
                    ● Unsaved
                </span>
            }
        </div>

        <div class="api-client-toolbar__right">
            @if (_activeCollection is not null)
            {
                <button type="button"
                        class="api-client-toolbar-btn @(_worksheetMode == WorksheetVars ? "api-client-toolbar-btn--active" : "")"
                        title="Edit collection variables"
                        @onclick="@(() => _worksheetMode = _worksheetMode == WorksheetVars ? null : WorksheetVars)">⚙ Vars</button>
            }
            <button type="button"
                    class="api-client-toolbar-btn @(_worksheetMode == WorksheetEnvs ? "api-client-toolbar-btn--active" : "")"
                    title="Manage environments"
                    @onclick="@(() => _worksheetMode = _worksheetMode == WorksheetEnvs ? null : WorksheetEnvs)">🌍 Envs</button>
            <span class="api-client-toolbar__env-label">Env:</span>
            <div class="api-client-env-picker">
                <button type="button" class="api-client-env-picker__btn"
                        @onclick="() => _showEnvPicker = !_showEnvPicker">
                    <span>@(ActiveEnvironment?.Name ?? "— None —")</span>
                    <span class="api-client-env-picker__chevron">▾</span>
                </button>
                @if (_showEnvPicker)
                {
                    <div class="ctx-backdrop" @onclick="() => _showEnvPicker = false"></div>
                    <div class="api-client-env-picker__dropdown">
                        <button type="button" class="ctx-item @(_activeEnvironmentId is null ? "ctx-item--active" : "")"
                                @onclick="() => SelectEnvAsync(null)">— None —</button>
                        @foreach (var env in _environments)
                        {
                            <button type="button" class="ctx-item @(env.Id == _activeEnvironmentId ? "ctx-item--active" : "")"
                                    @onclick="() => SelectEnvAsync(env.Id)">@env.Name</button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Main split: collection tree + request workspace ── *@
    <div class="api-client-body">

        @* Left: collection tree *@
        <div class="api-client-tree-panel">
            @if (_loadingCollections)
            {
                <div class="api-client-tree-panel__loading">
                    <LoadingSpinner Message="Loading collections…" />
                </div>
            }
            else if (_collections.Count == 0)
            {
                <div class="api-client-tree-panel__empty">
                    <EmptyState Icon="📦" Title="No collections yet"
                                Subtitle="Create a collection to organise your requests.">
                        <Actions>
                            <button type="button" class="api-client-empty-action-btn" @onclick="AddCollectionAsync">
                                + New Collection
                            </button>
                        </Actions>
                    </EmptyState>
                </div>
            }
            else
            {
                <CollectionTree Collections="@_collections" SelectedRequestId="@_selectedRequestId"
                                ActiveCollectionId="@_activeCollection?.Id" OnRequestSelected="OnRequestSelectedAsync"
                                OnCollectionSelected="OnCollectionSelectedAsync" OnAddFolder="OnAddFolderAsync"
                                OnAddRequest="OnAddRequestInFolderAsync" OnRenameNode="OnRenameNodeAsync"
                                OnDeleteNode="OnDeleteNodeAsync" OnRenameCollection="OnRenameCollectionAsync"
                                OnDeleteCollection="OnDeleteCollectionAsync" />
            }
        </div>

        @* Right: request builder + response viewer OR management screens *@
        <div class="api-client-workspace">
            @if (_worksheetMode == WorksheetEnvs)
            {
                <div class="api-client-management-screen">
                    <div class="api-client-management-screen__header">
                        <button type="button" class="api-client-management-screen__back"
                                @onclick="() => _worksheetMode = null">← Back to requests</button>
                        <span class="api-client-management-screen__title">Environments</span>
                    </div>
                    <EnvironmentManagerPanel OnChanged="@OnEnvironmentsChangedAsync" />
                </div>
            }
            else if (_worksheetMode == WorksheetVars && _activeCollection is not null)
            {
                <div class="api-client-management-screen">
                    <div class="api-client-management-screen__header">
                        <button type="button" class="api-client-management-screen__back"
                                @onclick="() => _worksheetMode = null">← Back to requests</button>
                        <span class="api-client-management-screen__title">Collection Variables —
                            @_activeCollection.Name</span>
                        </div>
                        <CollectionVariableEditor Collection="@_activeCollection" OnSaved="@OnCollVarEditorSavedAsync"
                                                  OnCancelled="@(() => _worksheetMode = null)" />
                    </div>
                }
            else if (_selectedRequest is null)
                {
                    <div class="api-client-workspace__empty">
                        <EmptyState Icon="🌐" Title="No request selected"
                                    Subtitle="Select a request from the collection tree, or create a new one.">
                            <Actions>
                                <button type="button" class="api-client-empty-action-btn"
                                        disabled="@(_activeCollection is null)" @onclick="AddRequestAsync">
                                    + New Request
                                </button>
                            </Actions>
                        </EmptyState>
                    </div>
                }
                else
                {
                    <div class="api-client-workspace__panels">
                        <div class="api-client-workspace__builder" @ref="_builderPanelEl">
                            <RequestBuilderPanel Request="@_selectedRequest" Collection="@(_activeCollection!)"
                                                 ActiveEnvironment="@ActiveEnvironment" AllEnvironments="@_environments"
                                                 ScopeVersion="@_scopeVersion" IsDirty="@_isDirty" OnChanged="@OnRequestChangedAsync"
                                                 OnResult="@OnRequestResultAsync"
                                                 OnSubscriptionMessage="@OnSubscriptionMessageAsync"
                                                 OnSubscriptionStopped="@OnSubscriptionStoppedAsync" />
                        </div>
                        <div class="api-client-workspace__splitter" @ref="_splitterEl"></div>
                        <div class="api-client-workspace__response">
                            <ResponseViewerPanel Result="@_lastResult" SubscriptionMessages="@_subscriptionMessages" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── New collection dialog ── *@
    @if (_showNewCollectionDialog)
    {
        <div class="api-client-dialog-backdrop" @onclick="() => _showNewCollectionDialog = false"></div>
        <div class="api-client-dialog" role="dialog" aria-modal="true" aria-label="New Collection">
            <div class="api-client-dialog__title">New Collection</div>
            <input type="text" class="api-client-dialog__input" placeholder="Collection name…" value="@_newCollectionName"
                   @oninput="e => _newCollectionName = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnNewCollectionKeyDownAsync" @ref="_newCollectionInput" />
            <div class="api-client-dialog__actions">
                <button type="button" class="api-client-dialog__btn api-client-dialog__btn--primary"
                        disabled="@string.IsNullOrWhiteSpace(_newCollectionName)"
                        @onclick="ConfirmNewCollectionAsync">Create</button>
                <button type="button" class="api-client-dialog__btn"
                        @onclick="() => _showNewCollectionDialog = false">Cancel</button>
            </div>
        </div>
    }

@* ── Delete collection confirm ── *@
<ConfirmDialog Visible="@(_pendingDeleteCollectionId is not null)" Title="Delete collection?"
               Message="@($"Delete \"{_pendingDeleteCollectionName}\" and all its requests? This cannot be undone.")"
               ConfirmLabel="Delete" OnConfirm="ConfirmDeleteCollectionAsync"
               OnCancel="@(() => { _pendingDeleteCollectionId = null; _pendingDeleteCollectionName = null; })" />

@code {
    // ── State ─────────────────────────────────────────────────────────────────
    private bool _loadingCollections = true;
    private List<ApiCollection> _collections = [];
    private List<ApiEnvironment> _environments = [];
    private ApiCollection? _activeCollection;
    private string? _selectedRequestId;
    private HttpRequestEntry? _selectedRequest;
    private string? _activeEnvironmentId;
    private bool _isDirty;
    private bool _autoSave;

    // Phase 2 — execution state
    private HttpRequestResult? _lastResult;

    // Phase 5 — subscription state (capped at 1 000; oldest entry dropped when full)
    private readonly List<GraphQlSubscriptionMessage> _subscriptionMessages = [];
    private const int SubscriptionMessageCap = 1_000;

    // Worksheet mode constants
    private const string WorksheetEnvs = "envs";
    private const string WorksheetVars = "vars";

    // Worksheet mode: null = request, WorksheetVars = collection variable editor, WorksheetEnvs = environment manager
    private string? _worksheetMode;
    // Scope version: incremented when collection variables are saved so RequestBuilderPanel rebuilds its resolved scope
    private int _scopeVersion;

    // New-collection dialog state
    private bool _showNewCollectionDialog;
    private string _newCollectionName = string.Empty;
    private ElementReference _newCollectionInput;
    private bool _shouldFocusNewCollectionInput;

    // Delete-collection confirm state
    private string? _pendingDeleteCollectionId;
    private string? _pendingDeleteCollectionName;

    // Splitter drag
    private ElementReference _splitterEl;
    private ElementReference _builderPanelEl;
    private IJSObjectReference? _splitterHandle;
    private string? _lastSplitterRequestId;

    // Auto-save debounce
    private System.Timers.Timer? _autoSaveTimer;
    private const int AutoSaveDebounceMs = 500;

    // ── Computed ──────────────────────────────────────────────────────────────
    private ApiEnvironment? ActiveEnvironment =>
        _environments.FirstOrDefault(e => e.Id == _activeEnvironmentId);

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _autoSave = UserSettings.Settings.AutoSaveRequests;

        // Load both repositories concurrently — they are independent files
        await Task.WhenAll(LoadCollectionsAsync(), LoadEnvironmentsAsync());

        _loadingCollections = false;
    }

    private async Task LoadCollectionsAsync()
    {
        try
        {
            await CollectionRepo.LoadAsync();
            _collections = CollectionRepo.Collections.ToList();
            _activeCollection = _collections.FirstOrDefault();

            // Restore last selected request for the active collection
            if (_activeCollection is not null &&
                EnvironmentRepo.UiState.LastSelectedRequestIdByCollection
                    .TryGetValue(_activeCollection.Id, out var lastId))
            {
                RestoreSelectedRequest(lastId);
            }
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load collections");
            _collections = [];
        }
    }

    private async Task LoadEnvironmentsAsync()
    {
        try
        {
            await EnvironmentRepo.LoadAsync();
            _environments = EnvironmentRepo.Environments.ToList();
            _activeEnvironmentId = EnvironmentRepo.UiState.ActiveEnvironmentId;
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load environments");
            _environments = [];
        }
    }

    private void RestoreSelectedRequest(string requestId)
    {
        if (_activeCollection is null) return;
        var (_, request) = CollectionRepo.FindRequest(requestId);
        if (request is not null)
        {
            _selectedRequestId = requestId;
            _selectedRequest = request;
        }
    }

    // ── Toolbar actions ───────────────────────────────────────────────────────

    private void OpenNewCollectionDialog()
    {
        _newCollectionName = string.Empty;
        _showNewCollectionDialog = true;
        _shouldFocusNewCollectionInput = true;
    }

    private async Task ConfirmNewCollectionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCollectionName)) return;
        var collection = await CollectionRepo.AddCollectionAsync(_newCollectionName.Trim());
        _collections = CollectionRepo.Collections.ToList();
        _activeCollection = collection;
        _showNewCollectionDialog = false;
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task OnNewCollectionKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmNewCollectionAsync();
        else if (e.Key == "Escape") _showNewCollectionDialog = false;
    }

    private async Task AddCollectionAsync()
    {
        var collection = await CollectionRepo.AddCollectionAsync("New Collection");
        _collections = CollectionRepo.Collections.ToList();
        _activeCollection = collection;
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task AddRequestAsync()
    {
        if (_activeCollection is null) return;

        var request = new HttpRequestEntry
        {
            Id = Guid.NewGuid().ToString("N"),
            Name = "New Request",
            Method = ApiRequestMethod.Get,
            Url = string.Empty,
            CreatedAt = DateTimeOffset.UtcNow,
            UpdatedAt = DateTimeOffset.UtcNow,
        };

        _activeCollection.Nodes.Add(new ApiCollectionNode
        {
            Id = Guid.NewGuid().ToString("N"),
            Type = ApiCollectionNodeType.Request,
            Name = request.Name,
            Request = request,
        });

        await CollectionRepo.UpdateCollectionAsync(_activeCollection);
        _collections = CollectionRepo.Collections.ToList();
        _selectedRequestId = request.Id;
        _selectedRequest = request;
        _isDirty = false;
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private bool _showEnvPicker;

    private async Task SelectEnvAsync(string? envId)
    {
        _showEnvPicker = false;
        _activeEnvironmentId = envId;
        await EnvironmentRepo.SetActiveEnvironmentAsync(envId);
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task OnEnvironmentsChangedAsync()
    {
        _environments = EnvironmentRepo.Environments.ToList();
        _worksheetMode = null;
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task OnCollVarEditorSavedAsync()
    {
        _scopeVersion++; // Force RequestBuilderPanel to rebuild resolved scope
        _worksheetMode = null;
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task SaveRequestAsync()
    {
        if (_activeCollection is null || _selectedRequest is null) return;
        await CollectionRepo.UpdateCollectionAsync(_activeCollection);
        _isDirty = false;
        await InvokeAsync(StateHasChanged); // BL-2
    }

    // ── Tree callbacks ─────────────────────────────────────────────────────────

    private Task OnCollectionSelectedAsync(string collectionId)
    {
        var collection = _collections.FirstOrDefault(c => c.Id == collectionId);
        if (collection is not null && !ReferenceEquals(collection, _activeCollection))
        {
            _activeCollection = collection;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private async Task OnRequestSelectedAsync(HttpRequestEntry request)
    {
        _selectedRequest = request;
        _selectedRequestId = request.Id;
        _isDirty = false;

        if (_activeCollection is not null)
        {
            // Fire-and-forget persistence of last selection; non-blocking
            _ = PersistLastSelectionAsync(_activeCollection.Id, request.Id);
        }

        await InvokeAsync(StateHasChanged); // BL-2
    }

    private Task PersistLastSelectionAsync(string collectionId, string requestId)
    {
        return EnvironmentRepo.SetLastSelectedRequestAsync(collectionId, requestId);
    }

    private async Task OnAddFolderAsync(ApiCollectionNode parentNode)
    {
        var folder = new ApiCollectionNode
        {
            Id = Guid.NewGuid().ToString("N"),
            Type = ApiCollectionNodeType.Folder,
            Name = "New Folder",
            IsExpanded = true,
        };

        if (_activeCollection is null) return;
        if (parentNode.Id.StartsWith("__col__", StringComparison.Ordinal))
            _activeCollection.Nodes.Add(folder);
        else
            AddNodeToParent(_activeCollection.Nodes, parentNode.Id, folder);
        await CollectionRepo.UpdateCollectionAsync(_activeCollection);
        _collections = CollectionRepo.Collections.ToList();
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task OnAddRequestInFolderAsync(ApiCollectionNode parentNode)
    {
        if (_activeCollection is null) return;

        var request = new HttpRequestEntry
        {
            Id = Guid.NewGuid().ToString("N"),
            Name = "New Request",
            Method = ApiRequestMethod.Get,
            Url = string.Empty,
            CreatedAt = DateTimeOffset.UtcNow,
            UpdatedAt = DateTimeOffset.UtcNow,
        };

        var node = new ApiCollectionNode
        {
            Id = Guid.NewGuid().ToString("N"),
            Type = ApiCollectionNodeType.Request,
            Name = request.Name,
            Request = request,
        };

        if (parentNode.Id.StartsWith("__col__", StringComparison.Ordinal))
            _activeCollection.Nodes.Add(node);
        else
            AddNodeToParent(_activeCollection.Nodes, parentNode.Id, node);
        await CollectionRepo.UpdateCollectionAsync(_activeCollection);
        _collections = CollectionRepo.Collections.ToList();
        _selectedRequestId = request.Id;
        _selectedRequest = request;
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task OnRenameNodeAsync((ApiCollectionNode Node, string NewName) args)
    {
        if (_activeCollection is null) return;
        RenameNodeInTree(_activeCollection.Nodes, args.Node.Id, args.NewName);
        if (args.Node.Request is not null)
            args.Node.Request.Name = args.NewName;
        await CollectionRepo.UpdateCollectionAsync(_activeCollection);
        _collections = CollectionRepo.Collections.ToList();
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task OnDeleteNodeAsync(ApiCollectionNode node)
    {
        if (_activeCollection is null) return;
        RemoveNodeFromTree(_activeCollection.Nodes, node.Id);

        if (_selectedRequestId is not null &&
            (node.Request?.Id == _selectedRequestId ||
             ContainsRequest(node.Children, _selectedRequestId)))
        {
            _selectedRequest = null;
            _selectedRequestId = null;
            _isDirty = false;
        }

        await CollectionRepo.UpdateCollectionAsync(_activeCollection);
        _collections = CollectionRepo.Collections.ToList();
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task OnRenameCollectionAsync((string CollectionId, string NewName) args)
    {
        var collection = _collections.FirstOrDefault(c => c.Id == args.CollectionId);
        if (collection is null) return;
        collection.Name = args.NewName;
        await CollectionRepo.UpdateCollectionAsync(collection);
        _collections = CollectionRepo.Collections.ToList();
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private Task OnDeleteCollectionAsync(string collectionId)
    {
        var collection = _collections.FirstOrDefault(c => c.Id == collectionId);
        _pendingDeleteCollectionId = collectionId;
        _pendingDeleteCollectionName = collection?.Name ?? "this collection";
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteCollectionAsync()
    {
        if (_pendingDeleteCollectionId is null) return;
        var id = _pendingDeleteCollectionId;
        _pendingDeleteCollectionId = null;
        _pendingDeleteCollectionName = null;
        await CollectionRepo.DeleteCollectionAsync(id);
        _collections = CollectionRepo.Collections.ToList();
        if (_activeCollection?.Id == id)
        {
            _activeCollection = _collections.FirstOrDefault();
            _selectedRequest = null;
            _selectedRequestId = null;
            _isDirty = false;
        }
        await InvokeAsync(StateHasChanged); // BL-2
    }

    // ── Tree helpers ───────────────────────────────────────────────────────────

    private static void SyncNodeName(List<ApiCollectionNode> nodes, string requestId, string name)
    {
        foreach (var node in nodes)
        {
            if (node.Request?.Id == requestId) { node.Name = name; return; }
            if (node.Type == ApiCollectionNodeType.Folder) SyncNodeName(node.Children, requestId, name);
        }
    }

    private static bool AddNodeToParent(List<ApiCollectionNode> nodes, string parentId, ApiCollectionNode newNode)
    {
        foreach (var node in nodes)
        {
            if (node.Id == parentId && node.Type == ApiCollectionNodeType.Folder)
            {
                node.Children.Add(newNode);
                return true;
            }
            if (node.Type == ApiCollectionNodeType.Folder && AddNodeToParent(node.Children, parentId, newNode))
                return true;
        }
        return false;
    }

    private static bool RenameNodeInTree(List<ApiCollectionNode> nodes, string nodeId, string newName)
    {
        foreach (var node in nodes)
        {
            if (node.Id == nodeId) { node.Name = newName; return true; }
            if (node.Type == ApiCollectionNodeType.Folder && RenameNodeInTree(node.Children, nodeId, newName))
                return true;
        }
        return false;
    }

    private static bool RemoveNodeFromTree(List<ApiCollectionNode> nodes, string nodeId)
    {
        var idx = nodes.FindIndex(n => n.Id == nodeId);
        if (idx >= 0) { nodes.RemoveAt(idx); return true; }

        foreach (var node in nodes.Where(n => n.Type == ApiCollectionNodeType.Folder))
        {
            if (RemoveNodeFromTree(node.Children, nodeId))
                return true;
        }
        return false;
    }

    private static bool ContainsRequest(List<ApiCollectionNode> nodes, string requestId)
    {
        foreach (var node in nodes)
        {
            if (node.Type == ApiCollectionNodeType.Request && node.Request?.Id == requestId) return true;
            if (node.Type == ApiCollectionNodeType.Folder && ContainsRequest(node.Children, requestId)) return true;
        }
        return false;
    }

    private static string GetMethodLabel(ApiRequestMethod method) => method switch
    {
        ApiRequestMethod.Get => "GET",
        ApiRequestMethod.Post => "POST",
        ApiRequestMethod.Put => "PUT",
        ApiRequestMethod.Patch => "PATCH",
        ApiRequestMethod.Delete => "DEL",
        ApiRequestMethod.Head => "HEAD",
        ApiRequestMethod.Options => "OPT",
        ApiRequestMethod.GraphQl => "GQL",
        ApiRequestMethod.WebSocket => "WS",
        _ => "GET",
    };

    // ── Request change + auto-save ─────────────────────────────────────────────

    private async Task OnRequestChangedAsync()
    {
        _isDirty = true;

        // Sync ApiCollectionNode.Name from the live request name so the tree view reflects renames
        if (_selectedRequest is not null && _activeCollection is not null)
            SyncNodeName(_activeCollection.Nodes, _selectedRequest.Id, _selectedRequest.Name);

        if (_autoSave)
        {
            _autoSaveTimer?.Stop();
            _autoSaveTimer ??= new System.Timers.Timer(AutoSaveDebounceMs) { AutoReset = false };
            _autoSaveTimer.Elapsed -= OnAutoSaveElapsed;
            _autoSaveTimer.Elapsed += OnAutoSaveElapsed;
            _autoSaveTimer.Start();
        }

        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async void OnAutoSaveElapsed(object? sender, System.Timers.ElapsedEventArgs e)
    {
        if (_activeCollection is null || _selectedRequest is null) return;
        try
        {
            await CollectionRepo.UpdateCollectionAsync(_activeCollection);
            _isDirty = false;
            await InvokeAsync(StateHasChanged); // BL-2
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Auto-save failed");
        }
    }

    // ── Request result ─────────────────────────────────────────────────────────

    private async Task OnRequestResultAsync(HttpRequestResult result)
    {
        // Clear any previous subscription messages when a normal request completes
        _subscriptionMessages.Clear();
        _lastResult = result;
        await InvokeAsync(StateHasChanged); // BL-2
    }

    // ── Subscription callbacks ─────────────────────────────────────────────────

    private async Task OnSubscriptionMessageAsync(GraphQlSubscriptionMessage msg)
    {
        // Clear the last HTTP result when subscription starts
        if (_subscriptionMessages.Count == 0)
            _lastResult = null;

        // Drop oldest when cap reached to prevent unbounded memory growth
        if (_subscriptionMessages.Count >= SubscriptionMessageCap)
            _subscriptionMessages.RemoveAt(0);

        _subscriptionMessages.Add(msg);
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private Task OnSubscriptionStoppedAsync()
    {
        // Nothing extra; the subscription message list persists until the next send
        return Task.CompletedTask;
    }

    // ── Splitter (JS drag) ─────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus the new-collection dialog input when it opens
        if (_shouldFocusNewCollectionInput)
        {
            _shouldFocusNewCollectionInput = false;
            try { await _newCollectionInput.FocusAsync(); } catch { }
        }

        // Init the splitter whenever the panels become visible for a new request.
        // _lastSplitterRequestId tracks which request the current JS handle was set up for.
        if (_selectedRequest is not null && _lastSplitterRequestId != _selectedRequestId)
        {
            await DisposeSplitterAsync();
            _lastSplitterRequestId = _selectedRequestId;
            _splitterHandle = await JS.InvokeAsync<IJSObjectReference>(
                "SwebKitSplitter.init",
                _splitterEl,
                _builderPanelEl,
                new { leftPane = true, minWidth = 250, maxWidth = 1600 });
        }
        else if (_selectedRequest is null && _splitterHandle is not null)
        {
            await DisposeSplitterAsync();
            _lastSplitterRequestId = null;
        }
    }

    private async Task DisposeSplitterAsync()
    {
        if (_splitterHandle is null) return;
        try { await _splitterHandle.InvokeVoidAsync("dispose"); } catch { /* ignore teardown errors */ }
        try { await _splitterHandle.DisposeAsync(); } catch { }
        _splitterHandle = null;
    }

    // ── IAsyncDisposable ───────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        _autoSaveTimer?.Stop();
        _autoSaveTimer?.Dispose();
        await DisposeSplitterAsync();
    }
}
