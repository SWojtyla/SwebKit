@inject IVariablePreviewService VariablePreview
@inject IVariableSubstitutionService VariableSubstitution

<div class="req-builder">

    @* ── Name row ────────────────────────────────────────────────────────────── *@
    <div class="req-builder__name-row">
        @if (_editingName)
        {
            <input class="req-builder__name-input" value="@Request.Name" @onblur="CommitNameAsync"
                   @onkeydown="OnNameKeyDown" @ref="_nameInputRef" />
        }
        else
        {
            <span class="req-builder__name-label" @ondblclick="BeginEditName">
                @Request.Name
            </span>
        }
        @if (IsDirty)
        {
            <span class="req-builder__dirty-dot" title="Unsaved changes">●</span>
        }
    </div>

    @* ── URL bar ─────────────────────────────────────────────────────────────── *@
    <div class="req-builder__url-bar">
        <select class="req-builder__method-select
            req-builder__method-select--@Request.Method.ToString().ToLowerInvariant()"
                value="@Request.Method.ToString()" @onchange="OnMethodChangedAsync">
            @foreach (var m in Enum.GetValues<ApiRequestMethod>())
            {
                <option value="@m.ToString()">@MethodLabel(m)</option>
            }
        </select>

        <div class="req-builder__url-wrap">
            <input class="req-builder__url-input" type="text" value="@Request.Url"
                   placeholder="https://api.example.com/{{base_path}}/endpoint" @oninput="OnUrlInputAsync"
                   @ref="_urlInputRef" />

            @if (_urlPreview.Count > 0)
            {
                <div class="req-builder__url-preview">
                    @foreach (var (key, value) in _urlPreview)
                    {
                        <span class="req-builder__url-token @(value is null ? "req-builder__url-token--unresolved" : "")">
                            <span class="req-builder__url-token-key">{{@key}}</span>
                            @if (value is not null)
                            {
                                <span class="req-builder__url-token-arrow"> → </span>
                                <span class="req-builder__url-token-value">@value</span>
                            }
                            else
                            {
                                <span class="req-builder__url-token-arrow"> unresolved</span>
                            }
                        </span>
                    }
                </div>
            }
        </div>

        <button type="button" class="req-builder__send-btn @(_executing ? "req-builder__send-btn--busy" : "")"
                @onclick="OnSendAsync" disabled="@(string.IsNullOrWhiteSpace(Request.Url) || _executing)">
            @if (_executing)
            {
                <span class="req-builder__send-spinner" />
                <span>Cancel</span>
            }
            else
            {
                <span>Send</span>
            }
        </button>

        @if (!UserSettings.Settings.VerifyApiClientSsl)
        {
            <span class="req-builder__ssl-badge" title="SSL verification is disabled — do not use in production">
                ⚠ SSL off
            </span>
        }
    </div>

    @* ── Tab strip ───────────────────────────────────────────────────────────── *@
    <div class="req-builder__tabs">
        @foreach (var tab in _tabs)
        {
            var t = tab;
            <button type="button" class="req-builder__tab @(_activeTab == t ? "req-builder__tab--active" : "")"
                    @onclick="() => _activeTab = t">
                @t
                @if (t == "Params" && Request.QueryParams.Any(p => p.IsEnabled))
                {
                    <span class="req-builder__tab-count">@Request.QueryParams.Count(p => p.IsEnabled)</span>
                }
                else if (t == "Headers" && Request.Headers.Any(h => h.IsEnabled))
                {
                    <span class="req-builder__tab-count">@Request.Headers.Count(h => h.IsEnabled)</span>
                }
            </button>
        }
    </div>

    @* ── Tab content ─────────────────────────────────────────────────────────── *@
    <div class="req-builder__tab-content">

        @if (_activeTab == "Params")
        {
            <KeyValueGrid Pairs="@Request.QueryParams" OnChanged="MarkDirtyAsync" />
        }
        else if (_activeTab == "Headers")
        {
            <KeyValueGrid Pairs="@Request.Headers" OnChanged="MarkDirtyAsync" />
        }
        else if (_activeTab == "Body")
        {
            <div class="req-builder__body-mode-strip">
                @foreach (var mode in Enum.GetValues<RequestBodyMode>())
                {
                    var m = mode;
                    <button type="button"
                            class="req-builder__body-mode-btn @(Request.Body.Mode == m ? "req-builder__body-mode-btn--active" : "")"
                            @onclick="() => SetBodyModeAsync(m)">
                        @mode.ToString()
                    </button>
                }
            </div>

            @if (Request.Body.Mode is RequestBodyMode.Json or RequestBodyMode.Xml or RequestBodyMode.Text)
            {
                <div class="req-builder__body-area-wrap">
                    @if (_bodyPreview.Count > 0)
                    {
                        <div class="req-builder__body-preview-strip">
                            @foreach (var (key, value) in _bodyPreview)
                            {
                                <span class="req-builder__url-token @(value is null ? "req-builder__url-token--unresolved" : "")">
                                    {{@key}}@(value is not null ? $" → {value}" : " unresolved")
                                </span>
                            }
                        </div>
                    }
                    <textarea class="req-builder__body-area" value="@Request.Body.RawContent"
                              placeholder="@BodyPlaceholder(Request.Body.Mode)" @oninput="OnBodyInputAsync"
                              spellcheck="false"></textarea>
                </div>
            }
            else if (Request.Body.Mode == RequestBodyMode.FormData)
            {
                <KeyValueGrid Pairs="@Request.Body.FormData" OnChanged="MarkDirtyAsync" />
            }
            else if (Request.Body.Mode == RequestBodyMode.Binary)
            {
                <div class="req-builder__binary-row">
                    <span class="req-builder__binary-path">@(Request.Body.FilePath ?? "No file selected")</span>
                    <button type="button" class="req-builder__binary-pick-btn" @onclick="PickFileAsync">
                        Choose File…
                    </button>
                </div>
            }
            else
            {
                <div class="req-builder__body-none">No body for this request.</div>
            }
        }
        else if (_activeTab == "Auth")
        {
            <div class="req-builder__auth-stub">
                <span class="req-builder__auth-stub-text">
                    Auth configuration coming in Phase 4.
                </span>
            </div>
        }
        else if (_activeTab == "Capture")
        {
            <PostRequestCaptureBuilder Request="@Request"
                                       AvailableEnvironments="@AllEnvironments"
                                       CaptureWarnings="@_captureWarnings"
                                       OnChanged="@MarkDirtyAsync" />
        }
    </div>

</div>

@code {
    [Parameter, EditorRequired] public HttpRequestEntry Request { get; set; } = default!;
    [Parameter, EditorRequired] public ApiCollection Collection { get; set; } = default!;
    [Parameter] public ApiEnvironment? ActiveEnvironment { get; set; }
    [Parameter] public IReadOnlyList<ApiEnvironment> AllEnvironments { get; set; } = [];
    [Parameter] public bool IsDirty { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<HttpRequestResult> OnResult { get; set; }

    [Inject] private IHttpRequestExecutor Executor { get; set; } = default!;
    [Inject] private UserSettingsRepository UserSettings { get; set; } = default!;

    private static readonly string[] _tabs = ["Params", "Headers", "Body", "Auth", "Capture"];
    private string _activeTab = "Params";

    private IReadOnlyList<string> _captureWarnings = [];
    private bool _executing;
    private CancellationTokenSource? _executionCts;

    private IReadOnlyDictionary<string, string?> _resolvedScope = new Dictionary<string, string?>();
    private IReadOnlyDictionary<string, string?> _urlPreview = new Dictionary<string, string?>();
    private IReadOnlyDictionary<string, string?> _bodyPreview = new Dictionary<string, string?>();

    private ElementReference _urlInputRef;
    private ElementReference _nameInputRef;
    private bool _editingName;

    // ── Parameter sync (BL-5 guard) ────────────────────────────────────────────

    private HttpRequestEntry? _lastRequest;
    private ApiCollection? _lastCollection;
    private ApiEnvironment? _lastEnvironment;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_lastRequest, Request) &&
            ReferenceEquals(_lastCollection, Collection) &&
            ReferenceEquals(_lastEnvironment, ActiveEnvironment))
            return;

        _lastRequest = Request;
        _lastCollection = Collection;
        _lastEnvironment = ActiveEnvironment;

        RefreshScope();
        _urlPreview = VariablePreview.Preview(Request.Url, _resolvedScope);
        _bodyPreview = Request.Body.RawContent is not null
            ? VariablePreview.Preview(Request.Body.RawContent, _resolvedScope)
            : new Dictionary<string, string?>();
    }

    private void RefreshScope()
    {
        _resolvedScope = VariableSubstitution.BuildScope(Collection.Variables, ActiveEnvironment);
    }

    // ── URL / name editing ─────────────────────────────────────────────────────

    private async Task OnUrlInputAsync(ChangeEventArgs e)
    {
        Request.Url = e.Value?.ToString() ?? string.Empty;
        _urlPreview = VariablePreview.Preview(Request.Url, _resolvedScope);
        await MarkDirtyAsync();
    }

    private async Task OnMethodChangedAsync(ChangeEventArgs e)
    {
        if (Enum.TryParse<ApiRequestMethod>(e.Value?.ToString(), out var method))
            Request.Method = method;
        await MarkDirtyAsync();
    }

    private void BeginEditName() => _editingName = true;

    private async Task CommitNameAsync(FocusEventArgs _)
    {
        _editingName = false;
        await MarkDirtyAsync();
    }

    private async Task OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "Escape")
        {
            _editingName = false;
            await MarkDirtyAsync();
        }
    }

    // ── Body editing ───────────────────────────────────────────────────────────

    private async Task OnBodyInputAsync(ChangeEventArgs e)
    {
        Request.Body.RawContent = e.Value?.ToString();
        if (Request.Body.RawContent is not null)
            _bodyPreview = VariablePreview.Preview(Request.Body.RawContent, _resolvedScope);
        await MarkDirtyAsync();
    }

    private async Task SetBodyModeAsync(RequestBodyMode mode)
    {
        if (Request.Body.Mode == mode) return;
        Request.Body.Mode = mode;
        await MarkDirtyAsync();
    }

    // ── File picker ────────────────────────────────────────────────────────────

    private async Task PickFileAsync()
    {
        // MAUI FilePicker
        try
        {
            var result = await FilePicker.Default.PickAsync();
            if (result is not null)
            {
                Request.Body.FilePath = result.FullPath;
                await MarkDirtyAsync();
            }
        }
        catch (OperationCanceledException) { }
    }

    // ── Send / cancel ──────────────────────────────────────────────────────────

    private async Task OnSendAsync()
    {
        if (_executing)
        {
            _executionCts?.Cancel();
            return;
        }

        _executing = true;
        _executionCts = new CancellationTokenSource();
        await InvokeAsync(StateHasChanged); // BL-2

        HttpRequestResult? result = null;
        try
        {
            result = await Executor.ExecuteAsync(
                Request, Collection, ActiveEnvironment, _executionCts.Token);
        }
        catch (OperationCanceledException)
        {
            result = new HttpRequestResult
            {
                ResolvedUrl = Request.Url,
                Method = Request.Method.ToString().ToUpperInvariant(),
                ErrorMessage = "Request cancelled.",
            };
        }
        catch (Exception ex)
        {
            result = new HttpRequestResult
            {
                ResolvedUrl = Request.Url,
                Method = Request.Method.ToString().ToUpperInvariant(),
                ErrorMessage = ex.Message,
            };
        }
        finally
        {
            _executing = false;
            _executionCts?.Dispose();
            _executionCts = null;
        }

        await OnResult.InvokeAsync(result);
        if (result is not null)
            _captureWarnings = result.CaptureWarnings;
        await InvokeAsync(StateHasChanged); // BL-2
    }

    // ── Dirty tracking ─────────────────────────────────────────────────────────

    private async Task MarkDirtyAsync()
    {
        await OnChanged.InvokeAsync();
        await InvokeAsync(StateHasChanged); // BL-2
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    private static string MethodLabel(ApiRequestMethod m) => m switch
    {
        ApiRequestMethod.GraphQl => "GQL",
        ApiRequestMethod.WebSocket => "WS",
        _ => m.ToString().ToUpperInvariant(),
    };

    private static string BodyPlaceholder(RequestBodyMode mode) => mode switch
    {
        RequestBodyMode.Json => "{ \"key\": \"value\" }",
        RequestBodyMode.Xml => "<root><element>value</element></root>",
        _ => "Request body…",
    };
}
