@using SwebKit.Core.Abstractions
@using SwebKit.Core.Models
@using BlazorMonaco
@using BlazorMonaco.Editor

<div class="obs-logs">
    <div class="obs-logs-layout">
        <!-- Left: preset + saved queries sidebar -->
        <div class="obs-logs-sidebar">
            <div class="obs-sidebar-section-title">Presets</div>
            @foreach (var preset in _presets)
            {
                <button class="obs-preset-item @(_activePresetId == preset.Id ? "active" : "")"
                        @onclick="() => ApplyPreset(preset)" title="@preset.Description">
                    @preset.Name
                </button>
            }

            @if (_savedQueries.Any())
            {
                <div class="obs-sidebar-section-title" style="margin-top:12px">Saved Queries</div>
                @foreach (var group in GroupedSavedQueries)
                {
                    @if (group.Key is not null)
                    {
                        <div class="obs-folder-header">📁 @group.Key</div>
                    }
                    @foreach (var sq in group)
                    {
                        <div class="obs-saved-query-row @(group.Key is not null ? "obs-folder-item" : "")">
                            <button class="obs-preset-item" @onclick="() => LoadSaved(sq)" title="@sq.Query">
                                @DisplayName(sq.Name)
                            </button>
                            <button class="obs-saved-query-delete" @onclick="() => DeleteSaved(sq)" title="Delete">✕</button>
                        </div>
                    }
                }
            }

            <button class="obs-save-query-btn" @onclick="SaveCurrentQuery"
                    disabled="@string.IsNullOrWhiteSpace(_query)">
                + Save Query
            </button>
        </div>

        <!-- Right: editor + results -->
        <div class="obs-logs-main">
            <div class="obs-query-toolbar">
                <div class="obs-monaco-wrapper">
                    <StandaloneCodeEditor @ref="_editor" ConstructionOptions="EditorConstructionOptions"
                                          OnDidInit="OnEditorInitAsync" />
                </div>
                <div class="obs-query-actions">
                    <FluentButton Appearance="Appearance.Accent" @onclick="RunQueryAsync" Disabled="_isRunning">
                        ▶ Run
                    </FluentButton>
                    @if (_result is not null)
                    {
                        <button class="obs-copy-btn" @onclick="CopyCsvAsync">📋 Copy CSV</button>
                        <button class="obs-copy-btn" @onclick="DownloadCsvAsync">⬇ CSV</button>
                        <button class="obs-copy-btn" @onclick="DownloadJsonAsync">⬇ JSON</button>
                    }
                </div>
            </div>

            @if (_queryError is not null)
            {
                <div class="obs-query-error">⚠ @_queryError</div>
            }

            @if (_isRunning)
            {
                <div class="obs-loading">
                    <FluentProgressRing /> Running query…
                </div>
            }
            else if (_error is not null)
            {
                <ErrorCallout Message="@_error" />
            }
            else if (_result is not null)
            {
                <div class="obs-results-header">
                    @_result.Rows.Count results
                    @if (_result.Truncated)
                    {
                        <span class="obs-truncated-badge">⚠ Truncated — showing first @_result.Rows.Count rows</span>
                    }
                    <span class="obs-exec-time">(@_result.ExecutionTime.TotalMilliseconds:F0 ms)</span>
                </div>

                <div class="obs-results-grid">
                    <FluentDataGrid Items="_result.Rows.AsQueryable()" TGridItem="LogRow">
                        @foreach (var col in _result.ColumnNames)
                        {
                            var colName = col;
                            <TemplateColumn Title="@colName">
                                <span class="obs-cell" title="@GetCell(context, colName)">
                                    @Truncate(GetCell(context, colName), 80)
                                </span>
                            </TemplateColumn>
                        }
                    </FluentDataGrid>
                </div>
            }
            else
            {
                <div class="obs-results-empty">Run a query to see results.</div>
            }
        </div>
    </div>
</div>

@if (_saveDialogOpen)
{
    <FluentDialog @bind-Hidden="_saveDialogHidden" Modal="true" TrapFocus="true">
        <FluentDialogHeader>Save Query</FluentDialogHeader>
        <FluentDialogBody>
            <FluentTextField @bind-Value="_saveQueryName" Label="Query Name"
                             Placeholder="folder/query-name (use / for folders)" Autofocus="true" />
        </FluentDialogBody>
        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Accent" @onclick="ConfirmSaveAsync">Save</FluentButton>
            <FluentButton @onclick="() => { _saveDialogOpen = false; _saveDialogHidden = true; }">Cancel</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@inject IJSRuntime JS
@inject INotificationService Notifications

@code {
    [Parameter] public IObservabilityProvider? Provider { get; set; }
    [Parameter] public TimeRange Range { get; set; } = TimeRange.Last24Hours;
    [Parameter] public int MaxRows { get; set; } = 500;
    [Parameter] public List<SwebKit.Core.Domain.SavedQuery> SavedQueries { get; set; } = [];
    [Parameter] public EventCallback<List<SwebKit.Core.Domain.SavedQuery>> SavedQueriesChanged { get; set; }

    private string _query = string.Empty;
    private LogQueryResult? _result;
    private bool _isRunning;
    private string? _error;
    private string? _queryError;
    private string? _activePresetId;
    private IReadOnlyList<QueryPreset> _presets = [];
    private List<SwebKit.Core.Domain.SavedQuery> _savedQueries = [];
    private CancellationTokenSource _cts = new();
    private StandaloneCodeEditor? _editor;

    // Save dialog
    private bool _saveDialogOpen;
    private bool _saveDialogHidden = true;
    private string _saveQueryName = string.Empty;

    // Saved query folder grouping
    private IEnumerable<IGrouping<string?, SwebKit.Core.Domain.SavedQuery>> GroupedSavedQueries =>
        _savedQueries.GroupBy(sq =>
        {
            var idx = sq.Name.IndexOf('/');
            return idx > 0 ? sq.Name[..idx] : (string?)null;
        }).OrderBy(g => g.Key ?? "zzz"); // ungrouped queries last

    private static string DisplayName(string name)
    {
        var idx = name.IndexOf('/');
        return idx > 0 ? name[(idx + 1)..] : name;
    }

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor) => new()
    {
        Language = "sql",
        Theme = "vs-dark",
        Value = _query,
        AutomaticLayout = true,
        Minimap = new EditorMinimapOptions { Enabled = false },
        ScrollBeyondLastLine = false,
        FontSize = 13,
        LineNumbers = "off",
        RenderLineHighlight = "none",
        OverviewRulerLanes = 0,
        Folding = false,
        GlyphMargin = false,
        Dimension = new Dimension { Height = 140 },
    };

    private async Task OnEditorInitAsync()
    {
        if (_editor is null) return;

        // Ctrl+Enter → Run query
        await _editor.AddAction("run-query", "Run Query",
            [(int)BlazorMonaco.KeyMod.CtrlCmd | (int)BlazorMonaco.KeyCode.Enter],
            null, null, "navigation", 1.0,
            async (_, _) => await RunQueryAsync());
    }

    protected override void OnParametersSet()
    {
        _presets = Provider?.GetPresets() ?? [];
        _savedQueries = SavedQueries;
    }

    /// <summary>Load a query from outside (e.g. "Drill to Logs" from Failures tab).</summary>
    public async Task LoadQueryAsync(string kql)
    {
        _query = kql;
        _activePresetId = null;
        if (_editor is not null)
            await _editor.SetValue(kql);
        await RunQueryAsync();
    }

    private async Task ApplyPreset(QueryPreset preset)
    {
        _query = preset.Query;
        _activePresetId = preset.Id;
        if (_editor is not null)
            await _editor.SetValue(preset.Query);
        _ = RunQueryAsync();
    }

    private async Task LoadSaved(SwebKit.Core.Domain.SavedQuery sq)
    {
        _query = sq.Query;
        _activePresetId = null;
        if (_editor is not null)
            await _editor.SetValue(sq.Query);
        _ = RunQueryAsync();
    }

    private async Task RunQueryAsync()
    {
        if (Provider is null) return;

        // Sync query from editor
        if (_editor is not null)
            _query = await _editor.GetValue();

        if (string.IsNullOrWhiteSpace(_query)) return;

        _cts.Cancel();
        _cts = new CancellationTokenSource();
        _isRunning = true;
        _error = null;
        _queryError = null;
        _result = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            _result = await Provider.RunQueryAsync(_query, Range, MaxRows, _cts.Token);
        }
        catch (OperationCanceledException) { throw; }
        catch (global::Azure.RequestFailedException rfe) when (rfe.ErrorCode == "BadArgumentError")
        {
            _queryError = rfe.Message;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _isRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string BuildCsvContent()
    {
        if (_result is null) return "";
        var lines = new List<string> { string.Join(",", _result.ColumnNames) };
        lines.AddRange(_result.Rows.Select(r =>
            string.Join(",", _result.ColumnNames.Select(c =>
            {
                var v = GetCell(r, c);
                return v.Contains(',') || v.Contains('"') ? $"\"{v.Replace("\"", "\"\"")}\"" : v;
            }))));
        return string.Join("\n", lines);
    }

    private async Task CopyCsvAsync()
    {
        if (_result is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", BuildCsvContent());
        Notifications.ShowSuccess("Copied!");
    }

    private async Task DownloadCsvAsync()
    {
        if (_result is null) return;
        var ts = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        await JS.InvokeVoidAsync("SwebKit.downloadText", $"query-{ts}.csv", "text/csv", BuildCsvContent());
        Notifications.ShowSuccess($"Exported CSV");
    }

    private async Task DownloadJsonAsync()
    {
        if (_result is null) return;
        var rows = _result.Rows.Select(r =>
            _result.ColumnNames.ToDictionary(c => c, c => (object)GetCell(r, c))).ToList();
        var json = System.Text.Json.JsonSerializer.Serialize(rows,
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        var ts = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        await JS.InvokeVoidAsync("SwebKit.downloadText", $"query-{ts}.json", "application/json", json);
        Notifications.ShowSuccess($"Exported {rows.Count} rows");
    }

    private void SaveCurrentQuery()
    {
        _saveQueryName = string.Empty;
        _saveDialogOpen = true;
        _saveDialogHidden = false;
    }

    private async Task ConfirmSaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_saveQueryName)) return;

        // Sync query from editor before saving
        if (_editor is not null)
            _query = await _editor.GetValue();

        var sq = new SwebKit.Core.Domain.SavedQuery
        {
            Name = _saveQueryName.Trim(),
            Query = _query
        };
        _savedQueries.Add(sq);
        await SavedQueriesChanged.InvokeAsync(_savedQueries);
        _saveDialogOpen = false;
        _saveDialogHidden = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteSaved(SwebKit.Core.Domain.SavedQuery sq)
    {
        _savedQueries.Remove(sq);
        await SavedQueriesChanged.InvokeAsync(_savedQueries);
        await InvokeAsync(StateHasChanged);
    }

    private static string GetCell(LogRow row, string col) =>
        row.Columns.TryGetValue(col, out var v) ? v?.ToString() ?? string.Empty : string.Empty;

    private static string Truncate(string s, int max) =>
        s.Length > max ? s[..max] + "…" : s;
}
