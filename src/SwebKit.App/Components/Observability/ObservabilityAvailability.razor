@using ApexCharts
@using SwebKit.Core.Abstractions
@using SwebKit.Core.Models
@implements IDisposable

<div class="obs-availability">
    @if (_isLoading && !_results.Any())
    {
        <div class="obs-loading">
            <FluentProgressRing /> Loading availability data…
        </div>
    }
    else if (_error is not null)
    {
        <ErrorCallout Message="@_error" />
    }
    else
    {
        <div class="obs-avail-summary">
            Overall: <strong class="@OverallClass()">@OverallFmt()</strong>
            &nbsp;·&nbsp;
            @PassCount passes, @FailCount failures
            <span style="margin-left:auto;">
                <FluentButton Appearance="Appearance.Lightweight"
                              @onclick="() => { _heatmapView = !_heatmapView; StateHasChanged(); }">
                    @(_heatmapView ? "📋 List" : "🗓 Heatmap")
                </FluentButton>
            </span>
        </div>

        @if (_heatmapView)
        {
            <div class="obs-chart-panel">
                <div class="obs-chart-title">Availability Heatmap (% per hour)</div>
                <ApexChart TItem="HeatmapCell" Options="_heatmapOptions">
                    @foreach (var series in _heatmapData)
                    {
                        <ApexPointSeries TItem="HeatmapCell" Items="series.Data" SeriesType="SeriesType.Heatmap" Name="@series.Name"
                                         XValue="@(c => c.Hour)" YValue="@(c => (decimal)c.AvailabilityPct)" />
                    }
                </ApexChart>
            </div>
        }
        else
        {
            <div class="obs-split-layout">
                <div class="obs-list-panel">
                    <FluentDataGrid Items="_results.AsQueryable()" TGridItem="AvailabilityResult"
                                    RowClass="@(r => r == _selected ? "selected-row" : "")"
                                    OnRowClick="@(r => { _selected = r.Item; StateHasChanged(); })">
                        <TemplateColumn Title="Test">@context.TestName</TemplateColumn>
                        <TemplateColumn Title="Location">@context.Location</TemplateColumn>
                        <TemplateColumn Title="Result">
                            <span class="@(context.Success ? "obs-avail-pass" : "obs-avail-fail")">
                                @(context.Success ? "✓ Pass" : "✗ Fail")
                            </span>
                        </TemplateColumn>
                        <TemplateColumn Title="Duration">@FormatMs(context.DurationMs)</TemplateColumn>
                        <TemplateColumn Title="Time">@FormatAge(context.Timestamp)</TemplateColumn>
                    </FluentDataGrid>
                </div>

                <div class="obs-detail-panel">
                    @if (_selected is null)
                    {
                        <div class="obs-detail-empty">Select a test result to view details.</div>
                    }
                    else
                    {
                        <div class="obs-detail-header">
                            <div class="obs-detail-title">@_selected.TestName</div>
                            <div class="obs-detail-meta">@_selected.Location ·
                                @_selected.Timestamp.ToOffset(TimeSpan.FromMinutes(TzOffsetMinutes)).ToString("g")
                            </div>
                        </div>

                        <div class="obs-perf-stats">
                            <div class="obs-stat">
                                <span class="obs-stat-label">Result</span>
                                <span class="obs-stat-val @(_selected.Success ? "obs-green" : "obs-red")">
                                    @(_selected.Success ? "Pass" : "Fail")
                                </span>
                            </div>
                            <div class="obs-stat">
                                <span class="obs-stat-label">Duration</span>
                                <span class="obs-stat-val">@FormatMs(_selected.DurationMs)</span>
                            </div>
                        </div>

                        @if (!_selected.Success && _selected.FailureMessage is not null)
                        {
                            <div class="obs-detail-section-title">Failure Message</div>
                            <div class="obs-detail-message obs-red">@_selected.FailureMessage</div>
                        }
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public IObservabilityProvider? Provider { get; set; }
    [Parameter] public TimeRange Range { get; set; } = TimeRange.Last24Hours;
    [Parameter] public int TzOffsetMinutes { get; set; }

    private readonly List<AvailabilityResult> _results = [];
    private AvailabilityResult? _selected;
    private bool _isLoading;
    private string? _error;
    private bool _heatmapView;
    private CancellationTokenSource _cts = new();
    private IObservabilityProvider? _loadedProvider;
    private TimeRange? _loadedRange;
    private bool _disposed;

    // Cached aggregates — rebuilt once after each load, not recomputed on every render
    private double _overallAvailability = 100;
    private int _passCount;
    private int _failCount;

    private double OverallAvailability => _overallAvailability;
    private int PassCount => _passCount;
    private int FailCount => _failCount;

    // Heatmap data
    private List<HeatmapSeries> _heatmapData = [];

    private record HeatmapCell(string Hour, double AvailabilityPct);
    private record HeatmapSeries(string Name, List<HeatmapCell> Data);

    private ApexChartOptions<HeatmapCell> _heatmapOptions = new()
    {
        Chart = new Chart
        {
            Type = ChartType.Heatmap,
            Height = 280,
            Toolbar = new Toolbar { Show = false },
            Animations = new Animations { Enabled = false },
        },
        PlotOptions = new PlotOptions
        {
            Heatmap = new PlotOptionsHeatmap
            {
                ColorScale = new PlotOptionsHeatmapColorScale
                {
                    Ranges = new List<PlotOptionsHeatmapColorScaleRange>
                    {
                        new() { From = 0, To = 90, Color = "#c8002a", Name = "< 90%" },
                        new() { From = 90, To = 99, Color = "#e08000", Name = "90\u201399%" },
                        new() { From = 99, To = 100, Color = "#22c55e", Name = "\u2265 99%" },
                    }
                }
            }
        },
        Legend = new Legend { Show = false },
    };

    private string OverallClass()
    {
        var pct = OverallAvailability;
        if (pct < 95) return "obs-red";
        if (pct < 99) return "obs-amber";
        return "obs-green";
    }

    private string OverallFmt() => $"{OverallAvailability:F1}%";

    protected override async Task OnParametersSetAsync()
    {
        if (Provider is null) return;

        if (ReferenceEquals(_loadedProvider, Provider) &&
            _loadedRange == Range)
            return;

        await LoadAsync();
    }

    public async Task RefreshAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (Provider is null) return;

        _loadedProvider = Provider;
        _loadedRange = Range;

        var loadCts = BeginLoadCycle();
        _isLoading = true;
        _error = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var data = await Provider.GetAvailabilityAsync(Range, loadCts.Token);
            _results.Clear();
            _results.AddRange(data);
            _selected = null;
            RebuildHeatmapData();
        }
        catch (OperationCanceledException) when (loadCts.IsCancellationRequested) { return; }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _isLoading = false;
            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private CancellationTokenSource BeginLoadCycle()
    {
        var previous = _cts;
        _cts = new CancellationTokenSource();
        previous.Cancel();
        previous.Dispose();
        return _cts;
    }

    public void Dispose()
    {
        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
    }

    private void RebuildHeatmapData()
    {
        // Recompute cached aggregates in one pass
        _passCount = _results.Count(r => r.Success);
        _failCount = _results.Count - _passCount;
        _overallAvailability = _results.Count == 0 ? 100 : _passCount * 100.0 / _results.Count;

        // Group by test name, then bucket by hour
        _heatmapData = _results
            .GroupBy(r => r.TestName)
            .Select(g => new HeatmapSeries(
                g.Key,
                g.GroupBy(r => r.Timestamp.ToOffset(TimeSpan.FromMinutes(TzOffsetMinutes)).ToString("MM/dd HH:00"))
                 .OrderBy(b => b.Key)
                 .Select(b => new HeatmapCell(
                     b.Key,
                     b.Count(r => r.Success) * 100.0 / b.Count()))
                 .ToList()))
            .ToList();
    }

    private static string FormatMs(double ms) =>
        ms == 0 ? "—" : ms >= 1000 ? $"{ms / 1000:F2}s" : $"{ms:F0}ms";

    private static string FormatAge(DateTimeOffset dt)
    {
        var age = DateTimeOffset.UtcNow - dt;
        if (age.TotalMinutes < 1) return "just now";
        if (age.TotalHours < 1) return $"{(int)age.TotalMinutes}m ago";
        if (age.TotalDays < 1) return $"{(int)age.TotalHours}h ago";
        return $"{(int)age.TotalDays}d ago";
    }
}
