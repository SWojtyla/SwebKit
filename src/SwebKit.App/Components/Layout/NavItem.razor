<div class="nav-item @(CurrentArea == Area ? "active" : "")"
     data-area="@Area"
     role="button"
     aria-label="@Label"
     aria-current="@(CurrentArea == Area ? "page" : null)"
     @onclick="Navigate"
     title="@(IsExpanded ? "" : Label)">
    <FluentIcon Value="@NavIcon" Width="20px" />
    @if (IsExpanded)
    {
        <span>@Label</span>
    }
</div>

@code {
    [Parameter] public Icon NavIcon { get; set; } = new Icons.Regular.Size24.Settings();
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Area { get; set; } = "";
    [Parameter] public bool IsExpanded { get; set; } = true;
    [Parameter] public string CurrentArea { get; set; } = "";
    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    private Task Navigate() => OnNavigate.InvokeAsync(Area);
}