@inherits SwebKit.App.Components.Shared.SwebKitLayoutBase
@using SwebKit.App.Components.Pages
@inject AppStateService AppState
@inject IAppEventBus Events
@inject TabService Tabs
@inject UiStateRepository UiState
@inject UserSettingsRepository UserSettings
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CommandRegistry Commands
@inject IShellErrorPresenter ShellErrors
@inject IConnectionWarmupService ConnectionWarmup
@inject Microsoft.Extensions.Logging.ILogger<MainLayout> Logger
@implements IDisposable

<FluentDesignTheme Mode="@CurrentDesignMode" />
<FluentMenuProvider />

<CascadingValue Value="AppState">
    <CascadingValue Value="this" Name="Layout">
        <a href="#main-content" class="skip-link">Skip to main content</a>

        <div class="app-shell @(IsNavExpanded ? "" : "nav-collapsed") @(AppState.Config.IsProduction ? "app-shell--production" : string.Empty) @(_isAgentPanelOpen ? "app-shell--agent-open" : "")"
             data-theme="@_currentTheme">
            <TopBar OnNavToggle="ToggleNavAsync" CurrentContext="@CurrentShellContext"
                    IsAgentPanelOpen="@_isAgentPanelOpen" OnAgentPanelToggle="ToggleAgentPanel" />
            @if (AppState.HasProfileLoadFailure)
            {
                <div class="demo-banner">
                    <span>@GetProfileLoadWarningText()</span>
                </div>
            }
            else if (AppState.HasProfileLoadRecovery)
            {
                <div class="demo-banner">
                    <span>@GetProfileLoadRecoveryText()</span>
                </div>
            }
            @if (AppState.UseDemoData)
            {
                <div class="demo-banner">
                    <span>&#9888; DEMO MODE — data is synthetic. No live connections are used.</span>
                    <button class="demo-banner-disable" @onclick="DisableDemoAsync"
                            aria-label="Disable demo mode">Disable</button>
                </div>
            }
            <LeftNav IsExpanded="IsNavExpanded" CurrentArea="@CurrentArea" OnNavigate="NavigateTo" />
            <main id="main-content" class="main-content" tabindex="-1">
                @if (AppState.IsInitialized)
                {
                    <AppErrorBoundary>
                        @Body
                    </AppErrorBoundary>
                }
                else
                {
                    <LoadingSpinner Message="Starting SwebKit\u2026" />
                }
            </main>
            @if (UserSettings.Settings.Agent.IsEnabled)
            {
                <AgentChatPanel IsOpen="@_isAgentPanelOpen" OnClose="ToggleAgentPanel" />
            }

            <StatusBar CurrentRoute="@CurrentRoute" />

            @* Overlays must live inside the themed container so CSS variables resolve correctly *@
            @if (IsCommandPaletteOpen)
            {
                <CommandPalette CurrentArea="@CurrentArea"
                                OnClose="@(() => { IsCommandPaletteOpen = false; StateHasChanged(); })" />
            }

            @if (_isShortcutsPanelOpen)
            {
                <KeyboardShortcutsPanel OnClose="@(() => { _isShortcutsPanelOpen = false; StateHasChanged(); })" />
            }

            <NotificationToast />
        </div>
    </CascadingValue>
</CascadingValue>

@code {
    private bool IsNavExpanded = true;
    private bool IsCommandPaletteOpen;
    private bool _isShortcutsPanelOpen;
    private bool _isAgentPanelOpen;
    // Tracks whether the nav was expanded before the API client auto-collapsed it, so it can be restored on exit.
    private bool _navExpandedBeforeApiClient = true;
    // True when the user explicitly toggled the nav (so auto-restore is suppressed if they collapsed it themselves).
    private bool _userToggledNavInApiClient;
    private DotNetObjectReference<MainLayout>? _jsRef;
    private string _currentTheme = "dark-studio-ledger";
    private ShellNavEntry _currentRoute = ShellNavigation.Dashboard;

    private const string StudioLedgerTheme = "dark-studio-ledger";
    private const string DefaultDarkTheme = StudioLedgerTheme;
    private const string CommandDeckTheme = "dark-command-deck";
    private const string LegacyPrecisionControlRoomTheme = "dark-control-room";
    private const string LegacyTechnicalEditorialTheme = "dark-technical-editorial";
    private const string DefaultLightTheme = "light-cloud-paper";
    private const string LegacyThemeStorageKey = "swebkit-ui-theme";
    private const string LegacyFluentThemeStorageKey = "swebkit-theme";

    private readonly System.Diagnostics.Stopwatch _shellStartupStopwatch = System.Diagnostics.Stopwatch.StartNew();
    private System.Diagnostics.Stopwatch? _pendingNavigationStopwatch;
    private string? _pendingNavigationArea;

    private static readonly HashSet<string> SupportedThemes = new(StringComparer.OrdinalIgnoreCase)
    {
        "dark-studio-ledger",
        "dark-iron-noir",
        "dark-command-deck",
        "light-cloud-paper",
        "light-sand-dune",
        "light-moss-amber",
        // legacy light themes kept for backward compat
        "light",
        "light-azure-bloom",
        "light-coral-studio",
        "light-forest-dev",
        "light-violet-cloud",
    };

    private string CurrentArea => _currentRoute.Area;
    private ShellNavEntry CurrentRoute => _currentRoute;
    private ShellRouteContext CurrentShellContext => ShellNavigation.CreateContext(_currentRoute,
AppState.Config.IsProduction, AppState.UseDemoData);
    private DesignThemeModes CurrentDesignMode => IsDarkTheme(_currentTheme)
        ? DesignThemeModes.Dark
        : DesignThemeModes.Light;

    protected override async Task OnInitializedAsync()
    {
        var essentialsStopwatch = System.Diagnostics.Stopwatch.StartNew();
        await AppState.InitializeEssentialsAsync();
        Logger.LogInformation("Perf shell essentials initialized in {ElapsedMs} ms",
essentialsStopwatch.Elapsed.TotalMilliseconds);
        PerformanceBaselineRecorder.Record(nameof(MainLayout), $"Perf shell essentials initialized in {essentialsStopwatch.Elapsed.TotalMilliseconds} ms");
        // Fire full init in background — shell renders immediately
        _ = InitializeInBackgroundAsync();
    }

    private async Task InitializeInBackgroundAsync()
    {
        var backgroundInitStopwatch = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            await AppState.InitializeAsync();
            Tabs.RestoreTabs(UiState.State.OpenTabs);
            RequestCoalescedRender();

            // Fire warmup in background — non-blocking, all failures are silent
            var openAreas = UiState.State.OpenTabs
                .Select(t => t.Area?.ToLowerInvariant())
                .Where(a => a is not null)
                .Distinct()
                .Cast<string>()
                .ToList();
            _ = ConnectionWarmup.WarmAsync(openAreas);
            Logger.LogInformation(
                "Perf shell background initialization completed in {ElapsedMs} ms with {OpenAreaCount} warm area(s)",
                backgroundInitStopwatch.Elapsed.TotalMilliseconds,
                openAreas.Count);
            PerformanceBaselineRecorder.Record(
                nameof(MainLayout),
                $"Perf shell background initialization completed in {backgroundInitStopwatch.Elapsed.TotalMilliseconds} ms with {openAreas.Count} warm area(s)");
        }
        catch (OperationCanceledException)
        {
            throw; // CS-2: never swallow cancellation
        }
        catch (Exception ex)
        {
            ShellErrors.PresentBackgroundInitializationFailure(ex);
        }
    }

    private async Task DisableDemoAsync()
    {
        await AppState.SetDemoModeAsync(false);
        NavigateTo("dashboard");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            RegisterDefaultCommands();
            _jsRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("SwebKit.registerKeyboardShortcuts", _jsRef);
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception ex)
            {
                ShellErrors.PresentKeyboardShortcutRegistrationFailure(ex);
            }

            await LoadThemeAsync();

            RequestCoalescedRender();
            Logger.LogInformation("Perf shell first render ready in {ElapsedMs} ms",
_shellStartupStopwatch.Elapsed.TotalMilliseconds);
            PerformanceBaselineRecorder.Record(nameof(MainLayout), $"Perf shell first render ready in {_shellStartupStopwatch.Elapsed.TotalMilliseconds} ms");
            return;
        }

        if (_pendingNavigationStopwatch is not null)
        {
            Logger.LogInformation(
                "Perf route {Area} rendered in {ElapsedMs} ms",
                _pendingNavigationArea ?? CurrentArea,
                _pendingNavigationStopwatch.Elapsed.TotalMilliseconds);
            PerformanceBaselineRecorder.Record(
                nameof(MainLayout),
                $"Perf route {_pendingNavigationArea ?? CurrentArea} rendered in {_pendingNavigationStopwatch.Elapsed.TotalMilliseconds} ms");

            _pendingNavigationStopwatch = null;
            _pendingNavigationArea = null;
        }
    }

    public async Task SetThemeAsync(string theme)
    {
        _currentTheme = NormalizeTheme(theme);
        await PersistThemeAsync();
        await ClearLegacyThemeStorageAsync();

        RequestCoalescedRender();
    }

    public string CurrentTheme => _currentTheme;

    protected override void OnInitialized()
    {
        UpdateCurrentRoute(Nav.Uri);
        Events.Subscribe<NavigateToAreaEvent>(OnNavigateToArea);
        Events.Subscribe<CommandPaletteRequestedEvent>(OnCommandPaletteRequested);
        AppState.DemoModeChanged += OnDemoModeChanged;
        AppState.Initialized += OnAppStateInitialized;
        AppState.ConfigChanged += OnConfigChanged;
        Nav.LocationChanged += OnLocationChanged;
        UserSettings.Changed += OnUserSettingsChanged;
    }

    private void OnAppStateInitialized()
    {
        // Invalidate warm clients on re-init — credentials may have changed
        ConnectionWarmup.InvalidateCaches();
        RequestCoalescedRender();
    }

    private void OnUserSettingsChanged()
    {
        // If agent is disabled while panel is open, close the panel
        if (UserSettings.Settings.Agent?.IsEnabled != true && _isAgentPanelOpen)
        {
            _isAgentPanelOpen = false;
        }
        RequestCoalescedRender();
    }

    private void ToggleAgentPanel()
    {
        _isAgentPanelOpen = !_isAgentPanelOpen;
        RequestCoalescedRender();
    }

    private void OnDemoModeChanged() => RequestCoalescedRender();

    private void OnConfigChanged() => ConnectionWarmup.InvalidateCaches();

    private string GetProfileLoadWarningText()
    {
        var fileLabel = string.IsNullOrWhiteSpace(AppState.ProfileLoadResult.FilePath)
            ? "profiles.json"
            : AppState.ProfileLoadResult.FilePath;

        return $"Configuration failed to load from {fileLabel}. Changes will stay in memory only until the file is repaired. {AppState.ProfileLoadResult.ErrorMessage}".Trim();
    }

    private string GetProfileLoadRecoveryText()
    {
        var fileLabel = string.IsNullOrWhiteSpace(AppState.ProfileLoadResult.FilePath)
            ? "profiles.json"
            : AppState.ProfileLoadResult.FilePath;

        if (string.IsNullOrWhiteSpace(AppState.ProfileLoadResult.ErrorMessage))
        {
            return $"Configuration was recovered from the last known good backup because {fileLabel} was missing.";
        }

        return $"Configuration was recovered from the last known good backup after {fileLabel} failed to load. The primary file will be refreshed on the next successful save. {AppState.ProfileLoadResult.ErrorMessage}".Trim();
    }

    private Task ToggleNavAsync()
    {
        IsNavExpanded = !IsNavExpanded;
        // Track manual toggles while in the API client so we don't override the user's intent on exit
        if (string.Equals(CurrentArea, "api-client", StringComparison.OrdinalIgnoreCase))
            _userToggledNavInApiClient = true;
        RequestCoalescedRender();
        return Task.CompletedTask;
    }

    private void NavigateTo(string area)
    {
        Nav.NavigateTo(ShellNavigation.ForArea(area).Href);
    }

    private void OnNavigateToArea(NavigateToAreaEvent e) => InvokeAsync(() => NavigateTo(e.Area));

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var previousArea = _currentRoute.Area;
        UpdateCurrentRoute(e.Location);
        var newArea = _currentRoute.Area;

        // Auto-collapse the global nav when entering the API client (DEC-5)
        var enteringApiClient = string.Equals(newArea, "api-client", StringComparison.OrdinalIgnoreCase);
        var leavingApiClient = string.Equals(previousArea, "api-client", StringComparison.OrdinalIgnoreCase);

        if (enteringApiClient && !string.Equals(previousArea, "api-client", StringComparison.OrdinalIgnoreCase))
        {
            _navExpandedBeforeApiClient = IsNavExpanded;
            _userToggledNavInApiClient = false;
            IsNavExpanded = false;
        }
        else if (leavingApiClient && !_userToggledNavInApiClient)
        {
            // Restore the expansion state the user had before entering the API client
            IsNavExpanded = _navExpandedBeforeApiClient;
        }

        _pendingNavigationArea = _currentRoute.Area;
        _pendingNavigationStopwatch = System.Diagnostics.Stopwatch.StartNew();
        // Use eager render for route changes so the TopBar context updates immediately,
        // bypassing the coalescing gate that would defer the update until any pending render fires.
        RequestRender();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnCommandPaletteRequested(CommandPaletteRequestedEvent _) =>
        InvokeAsync(() =>
        {
            IsCommandPaletteOpen = true;
            RequestCoalescedRender();
        });

    private void RegisterDefaultCommands()
    {
        if (Commands.Commands.Count > 0) return;

        Commands.Register(new AppCommand
        {
            Id = "navigate-dashboard",
            Label = "Go to Dashboard",
            Category = "Navigation",
            Icon = "🏠",
            Shortcut = "Ctrl+1",
            Execute = () => { NavigateTo("dashboard"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-service-bus",
            Label = "Go to Service Bus",
            Category = "Navigation",
            Icon = "📨",
            Shortcut = "Ctrl+2",
            Execute = () => { NavigateTo("service-bus"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-aks",
            Label = "Go to AKS",
            Category = "Navigation",
            Icon = "☸",
            Shortcut = "Ctrl+3",
            Execute = () => { NavigateTo("aks"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-redis",
            Label = "Go to Redis",
            Category = "Navigation",
            Icon = "⚡",
            Shortcut = "Ctrl+4",
            Execute = () => { NavigateTo("redis"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-storage",
            Label = "Go to Storage",
            Category = "Navigation",
            Icon = "📁",
            Shortcut = "Ctrl+5",
            Execute = () => { NavigateTo("storage"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-pipelines",
            Label = "Go to Pipelines",
            Category = "Navigation",
            Icon = "🚀",
            Shortcut = "Ctrl+6",
            Execute = () => { NavigateTo("pipelines"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-observability",
            Label = "Go to Observability",
            Category = "Navigation",
            Icon = "📊",
            Shortcut = "Ctrl+7",
            Execute = () => { NavigateTo("observability"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-incident-timeline",
            Label = "Go to Incident Timeline",
            Category = "Navigation",
            Icon = "🕒",
            Shortcut = "Ctrl+8",
            Execute = () => { NavigateTo("incident-timeline"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-settings",
            Label = "Go to Settings",
            Category = "Navigation",
            Icon = "⚙",
            Shortcut = "Ctrl+,",
            Execute = () => { NavigateTo("settings"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-api-client",
            Label = "Go to API Client",
            Category = "Navigation",
            Icon = "🌐",
            Execute = () => { NavigateTo("api-client"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "refresh-current-area",
            Label = "Refresh",
            Category = "Actions",
            Icon = "↻",
            Shortcut = "F5",
            Execute = () =>
            {
                Events.Publish(new RefreshRequestedEvent(CurrentArea));
                return Task.CompletedTask;
            }
        });

        Commands.Register(new AppCommand
        {
            Id = "toggle-command-palette",
            Label = "Open Command Palette",
            Category = "Actions",
            Icon = "⌕",
            Shortcut = "Ctrl+P",
            Execute = () =>
            {
                IsCommandPaletteOpen = true;
                RequestCoalescedRender();
                return Task.CompletedTask;
            }
        });

        Commands.Register(new AppCommand
        {
            Id = "open-keyboard-shortcuts",
            Label = "Keyboard Shortcuts",
            Category = "Actions",
            Icon = "⌨",
            Shortcut = "Ctrl+/",
            Execute = () =>
            {
                _isShortcutsPanelOpen = true;
                RequestCoalescedRender();
                return Task.CompletedTask;
            }
        });

        Commands.Register(new AppCommand
        {
            Id = "toggle-nav",
            Label = "Toggle Sidebar",
            Category = "Actions",
            Execute = ToggleNavAsync
        });
    }

    private void UpdateCurrentRoute(string location)
    {
        _currentRoute = ShellNavigation.ResolveUri(Nav.ToBaseRelativePath(location));
    }

    private static string NormalizeTheme(string? theme)
    {
        if (string.IsNullOrWhiteSpace(theme))
            return DefaultDarkTheme;

        var candidate = theme.Trim();

        // Migrate legacy aliases
        if (candidate.Equals(LegacyPrecisionControlRoomTheme, StringComparison.OrdinalIgnoreCase))
            return CommandDeckTheme;
        if (candidate.Equals(LegacyTechnicalEditorialTheme, StringComparison.OrdinalIgnoreCase))
            return StudioLedgerTheme;
        if (candidate.Equals("light", StringComparison.OrdinalIgnoreCase) ||
            candidate.Equals("light-azure-bloom", StringComparison.OrdinalIgnoreCase))
            return DefaultLightTheme;

        return SupportedThemes.Contains(candidate) ? candidate : DefaultDarkTheme;
    }

    private static bool IsDarkTheme(string theme) => theme.StartsWith("dark", StringComparison.OrdinalIgnoreCase);

    private async Task LoadThemeAsync()
    {
        try
        {
            await UserSettings.LoadAsync();
            if (!string.IsNullOrWhiteSpace(UserSettings.Settings.Theme))
            {
                _currentTheme = NormalizeTheme(UserSettings.Settings.Theme);
            }
            // Initialize agent panel state - open by default if agent is enabled
            if (UserSettings.Settings.Agent?.IsEnabled == true)
            {
                _isAgentPanelOpen = true;
            }
            return;
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
        }

        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", LegacyThemeStorageKey);
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _currentTheme = NormalizeTheme(stored);
                await PersistThemeAsync();
                await ClearLegacyThemeStorageAsync();
                return;
            }

            _currentTheme = NormalizeTheme(await JS.InvokeAsync<string?>("SwebKit.getSystemTheme"));
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
            _currentTheme = DefaultDarkTheme;
        }
    }

    private async Task PersistThemeAsync()
    {
        try
        {
            UserSettings.Settings.Theme = _currentTheme;
            await UserSettings.SaveAsync();
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
        }
    }

    private async Task ClearLegacyThemeStorageAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", LegacyThemeStorageKey);
            await JS.InvokeVoidAsync("localStorage.removeItem", LegacyFluentThemeStorageKey);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
        }
    }

    [JSInvokable]
    public async Task OnShortcut(string shortcut)
    {
        switch (shortcut)
        {
            case "CommandPalette":
                IsCommandPaletteOpen = !IsCommandPaletteOpen;
                _isShortcutsPanelOpen = false;
                break;
            case "KeyboardShortcuts":
                _isShortcutsPanelOpen = !_isShortcutsPanelOpen;
                IsCommandPaletteOpen = false;
                break;
            case "NavDashboard": NavigateTo("dashboard"); break;
            case "NavServiceBus": NavigateTo("service-bus"); break;
            case "NavAks": NavigateTo("aks"); break;
            case "NavRedis": NavigateTo("redis"); break;
            case "NavStorage": NavigateTo("storage"); break;
            case "NavReleases": NavigateTo("pipelines"); break;
            case "NavObservability": NavigateTo("observability"); break;
            case "NavSettings": NavigateTo("settings"); break;
            case "TabNext": Tabs.SetActive(GetNextTabId(1) ?? ""); break;
            case "TabPrev": Tabs.SetActive(GetNextTabId(-1) ?? ""); break;
            case "TabClose": if (Tabs.ActiveTab is not null) Tabs.CloseTab(Tabs.ActiveTab.Id); break;
            case "Escape":
                IsCommandPaletteOpen = false;
                _isShortcutsPanelOpen = false;
                break;
            case "Refresh": Events.Publish(new RefreshRequestedEvent(CurrentArea)); break;
            case "FocusFilter": Events.Publish(new FocusFilterRequestedEvent(CurrentArea)); break;
            case "SbEditResubmit": Events.Publish(new ServiceBusShortcutEvent("Edit")); break;
            case "SbReplay": Events.Publish(new ServiceBusShortcutEvent("Replay")); break;
            case "SbSchedule": Events.Publish(new ServiceBusShortcutEvent("Schedule")); break;
            case "SbPeek": Events.Publish(new ServiceBusShortcutEvent("Peek")); break;
            case "ApiNewRequest": Events.Publish(new ApiClientShortcutEvent("NewRequest")); break;
            case "ApiNewCollection": Events.Publish(new ApiClientShortcutEvent("NewCollection")); break;
            case "ApiEnvManager": Events.Publish(new ApiClientShortcutEvent("EnvManager")); break;
            case "ApiSaveRequest": Events.Publish(new ApiClientShortcutEvent("SaveRequest")); break;
            case "ApiTabClose": Events.Publish(new ApiClientShortcutEvent("TabClose")); break;
            case "ApiTabNext": Events.Publish(new ApiClientShortcutEvent("TabNext")); break;
            case "ApiTabPrev": Events.Publish(new ApiClientShortcutEvent("TabPrev")); break;
            case "AksJumpLogs": Events.Publish(new AksShortcutEvent("JumpLogs")); break;
            case "AksFocusTabs": Events.Publish(new AksShortcutEvent("FocusTabs")); break;
            case "AksFocusGrid": Events.Publish(new AksShortcutEvent("FocusGrid")); break;
            case "AksCloseDetail": Events.Publish(new AksShortcutEvent("CloseDetail")); break;
        }
        RequestCoalescedRender();
    }

    private string? GetNextTabId(int direction)
    {
        var tabs = Tabs.Tabs;
        if (tabs.Count == 0) return null;
        var current = Tabs.ActiveTab;
        if (current is null) return tabs[0].Id;
        var idx = tabs.ToList().IndexOf(current);
        var next = (idx + direction + tabs.Count) % tabs.Count;
        return tabs[next].Id;
    }

    public void Dispose()
    {
        Events.Unsubscribe<NavigateToAreaEvent>(OnNavigateToArea);
        Events.Unsubscribe<CommandPaletteRequestedEvent>(OnCommandPaletteRequested);
        AppState.DemoModeChanged -= OnDemoModeChanged;
        AppState.Initialized -= OnAppStateInitialized;
        AppState.ConfigChanged -= OnConfigChanged;
        Nav.LocationChanged -= OnLocationChanged;
        UserSettings.Changed -= OnUserSettingsChanged;
        _jsRef?.Dispose();
    }
}
