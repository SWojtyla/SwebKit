@inherits LayoutComponentBase
@inject AppStateService AppState
@inject IAppEventBus Events
@inject TabService Tabs
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CommandRegistry Commands
@implements IDisposable

<FluentDesignTheme StorageName="swebkit-theme"
                   Mode="@(_currentTheme == "dark" ? DesignThemeModes.Dark : DesignThemeModes.Light)" />

<CascadingValue Value="AppState">
    <CascadingValue Value="this" Name="Layout">
        <a href="#main-content" class="skip-link">Skip to main content</a>

        <div class="app-shell @(IsNavExpanded ? "" : "nav-collapsed")" data-theme="@_currentTheme">
            <TopBar OnNavToggle="ToggleNav" />
            @if (AppState.UseDemoData)
            {
                <div class="demo-banner">
                    <span>&#9888; DEMO MODE — data is synthetic. No live connections are used.</span>
                    <button class="demo-banner-disable" @onclick="DisableDemoAsync">Disable</button>
                </div>
            }
            <LeftNav IsExpanded="IsNavExpanded" CurrentArea="@CurrentArea" OnNavigate="NavigateTo" />
            <main id="main-content" class="main-content" tabindex="-1">
                @if (AppState.IsInitialized)
                {
                    @Body
                }
                else
                {
                    <LoadingSpinner Message="Starting SwebKit\u2026" />
                }
            </main>
            <StatusBar />

            @* Overlays must live inside the themed container so CSS variables resolve correctly *@
            @if (IsCommandPaletteOpen)
            {
                <CommandPalette CurrentArea="@CurrentArea"
                                OnClose="@(() => { IsCommandPaletteOpen = false; StateHasChanged(); })" />
            }

            @if (_isShortcutsPanelOpen)
            {
                <KeyboardShortcutsPanel OnClose="@(() => { _isShortcutsPanelOpen = false; StateHasChanged(); })" />
            }

            <NotificationToast />
        </div>
    </CascadingValue>
</CascadingValue>

@code {
    private bool IsNavExpanded = true;
    private bool IsCommandPaletteOpen;
    private bool _isShortcutsPanelOpen;
    private string CurrentArea = "dashboard";
    private DotNetObjectReference<MainLayout>? _jsRef;
    private string _currentTheme = "dark";

    protected override async Task OnInitializedAsync()
    {
        await AppState.InitializeEssentialsAsync();
        // Fire full init in background — shell renders immediately
        _ = InitializeInBackgroundAsync();
    }

    private async Task InitializeInBackgroundAsync()
    {
        try
        {
            await AppState.InitializeAsync();
            await InvokeAsync(StateHasChanged); // BL-2: dispatch on Blazor thread
        }
        catch (OperationCanceledException)
        {
            throw; // CS-2: never swallow cancellation
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[SwebKit] Background initialization failed: {ex.Message}");
        }
    }

    private async Task DisableDemoAsync()
    {
        await AppState.SetDemoModeAsync(false);
        NavigateTo("dashboard");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        RegisterDefaultCommands();
        _jsRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("SwebKit.registerKeyboardShortcuts", _jsRef);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[SwebKit] Keyboard shortcuts registration failed: {ex.Message}");
        }

        // Load persisted theme preference (BL-6: must run in OnAfterRenderAsync)
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "swebkit-ui-theme");
            if (!string.IsNullOrWhiteSpace(stored))
                _currentTheme = stored;
        }
        catch
        {
            // localStorage unavailable — keep default dark theme
        }

        StateHasChanged();
    }

    public async Task SetThemeAsync(string theme)
    {
        _currentTheme = theme;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "swebkit-ui-theme", theme);
        }
        catch { /* ignore */ }
        await InvokeAsync(StateHasChanged);
    }

    public string CurrentTheme => _currentTheme;

    protected override void OnInitialized()
    {
        Events.Subscribe<NavigateToAreaEvent>(OnNavigateToArea);
        Events.Subscribe<CommandPaletteRequestedEvent>(OnCommandPaletteRequested);
        Tabs.TabsChanged += StateHasChanged;
        AppState.DemoModeChanged += OnDemoModeChanged;
        AppState.Initialized += OnAppStateInitialized;
    }

    private void OnAppStateInitialized() => InvokeAsync(StateHasChanged);

    private void OnDemoModeChanged() => InvokeAsync(StateHasChanged);

    private void ToggleNav() { IsNavExpanded = !IsNavExpanded; StateHasChanged(); }

    private void NavigateTo(string area)
    {
        CurrentArea = area;
        Nav.NavigateTo($"/{area}");
        StateHasChanged();
    }

    private void OnNavigateToArea(NavigateToAreaEvent e) => InvokeAsync(() => NavigateTo(e.Area));

    private void OnCommandPaletteRequested(CommandPaletteRequestedEvent _) =>
        InvokeAsync(() =>
        {
            IsCommandPaletteOpen = true;
            StateHasChanged();
        });

    private void RegisterDefaultCommands()
    {
        if (Commands.Commands.Count > 0) return;

        Commands.Register(new AppCommand
        {
            Id = "navigate-dashboard",
            Label = "Go to Dashboard",
            Category = "Navigation",
            Icon = "🏠",
            Shortcut = "Ctrl+1",
            Execute = () => { NavigateTo("dashboard"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-service-bus",
            Label = "Go to Service Bus",
            Category = "Navigation",
            Icon = "📨",
            Shortcut = "Ctrl+2",
            Execute = () => { NavigateTo("service-bus"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-aks",
            Label = "Go to AKS",
            Category = "Navigation",
            Icon = "☸",
            Shortcut = "Ctrl+3",
            Execute = () => { NavigateTo("aks"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-redis",
            Label = "Go to Redis",
            Category = "Navigation",
            Icon = "⚡",
            Shortcut = "Ctrl+4",
            Execute = () => { NavigateTo("redis"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-storage",
            Label = "Go to Storage",
            Category = "Navigation",
            Icon = "📁",
            Shortcut = "Ctrl+5",
            Execute = () => { NavigateTo("storage"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-pipelines",
            Label = "Go to Pipelines",
            Category = "Navigation",
            Icon = "🚀",
            Shortcut = "Ctrl+6",
            Execute = () => { NavigateTo("pipelines"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-observability",
            Label = "Go to Observability",
            Category = "Navigation",
            Icon = "📊",
            Shortcut = "Ctrl+7",
            Execute = () => { NavigateTo("observability"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "navigate-settings",
            Label = "Go to Settings",
            Category = "Navigation",
            Icon = "⚙",
            Shortcut = "Ctrl+,",
            Execute = () => { NavigateTo("settings"); return Task.CompletedTask; }
        });

        Commands.Register(new AppCommand
        {
            Id = "refresh-current-area",
            Label = "Refresh",
            Category = "Actions",
            Icon = "↻",
            Shortcut = "F5",
            Execute = () =>
            {
                Events.Publish(new RefreshRequestedEvent(CurrentArea));
                return Task.CompletedTask;
            }
        });

        Commands.Register(new AppCommand
        {
            Id = "toggle-command-palette",
            Label = "Open Command Palette",
            Category = "Actions",
            Icon = "⌕",
            Shortcut = "Ctrl+P",
            Execute = () =>
            {
                IsCommandPaletteOpen = true;
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            }
        });

        Commands.Register(new AppCommand
        {
            Id = "open-keyboard-shortcuts",
            Label = "Keyboard Shortcuts",
            Category = "Actions",
            Icon = "⌨",
            Shortcut = "?",
            Execute = () =>
            {
                _isShortcutsPanelOpen = true;
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            }
        });

        Commands.Register(new AppCommand
        {
            Id = "toggle-nav",
            Label = "Toggle Sidebar",
            Category = "Actions",
            Execute = () => { ToggleNav(); return Task.CompletedTask; }
        });
    }

    [JSInvokable]
    public async Task OnShortcut(string shortcut)
    {
        switch (shortcut)
        {
            case "CommandPalette":
                IsCommandPaletteOpen = !IsCommandPaletteOpen;
                _isShortcutsPanelOpen = false;
                break;
            case "KeyboardShortcuts":
                _isShortcutsPanelOpen = !_isShortcutsPanelOpen;
                IsCommandPaletteOpen = false;
                break;
            case "NavDashboard": NavigateTo("dashboard"); break;
            case "NavServiceBus": NavigateTo("service-bus"); break;
            case "NavAks": NavigateTo("aks"); break;
            case "NavRedis": NavigateTo("redis"); break;
            case "NavStorage": NavigateTo("storage"); break;
            case "NavReleases": NavigateTo("pipelines"); break;
            case "NavObservability": NavigateTo("observability"); break;
            case "NavSettings": NavigateTo("settings"); break;
            case "TabNext": Tabs.SetActive(GetNextTabId(1) ?? ""); break;
            case "TabPrev": Tabs.SetActive(GetNextTabId(-1) ?? ""); break;
            case "TabClose": if (Tabs.ActiveTab is not null) Tabs.CloseTab(Tabs.ActiveTab.Id); break;
            case "Escape":
                IsCommandPaletteOpen = false;
                _isShortcutsPanelOpen = false;
                break;
            case "Refresh": Events.Publish(new RefreshRequestedEvent(CurrentArea)); break;
            case "FocusFilter": Events.Publish(new FocusFilterRequestedEvent(CurrentArea)); break;
            case "SbEditResubmit": Events.Publish(new ServiceBusShortcutEvent("Edit")); break;
            case "SbReplay": Events.Publish(new ServiceBusShortcutEvent("Replay")); break;
            case "SbSchedule": Events.Publish(new ServiceBusShortcutEvent("Schedule")); break;
            case "SbPeek": Events.Publish(new ServiceBusShortcutEvent("Peek")); break;
        }
        await InvokeAsync(StateHasChanged);
    }

    private string? GetNextTabId(int direction)
    {
        var tabs = Tabs.Tabs;
        if (tabs.Count == 0) return null;
        var current = Tabs.ActiveTab;
        if (current is null) return tabs[0].Id;
        var idx = tabs.ToList().IndexOf(current);
        var next = (idx + direction + tabs.Count) % tabs.Count;
        return tabs[next].Id;
    }

    public void Dispose()
    {
        Events.Unsubscribe<NavigateToAreaEvent>(OnNavigateToArea);
        Events.Unsubscribe<CommandPaletteRequestedEvent>(OnCommandPaletteRequested);
        Tabs.TabsChanged -= StateHasChanged;
        AppState.DemoModeChanged -= OnDemoModeChanged;
        AppState.Initialized -= OnAppStateInitialized;
        _jsRef?.Dispose();
    }
}
