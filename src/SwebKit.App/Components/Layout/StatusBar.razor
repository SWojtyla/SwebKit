@inject ITaskQueue TaskQueue
@implements IDisposable

<div class="status-bar">
    <span style="color: var(--color-text-muted);">SwebKit</span>
    <span style="margin-left: auto; display: flex; align-items: center; gap: 8px;">
        @{
            var running = TaskQueue.Tasks.Count(t => t.Status == BackgroundTaskStatus.Running);
        }
        @if (running > 0)
        {
            <span style="display: flex; align-items: center; gap: 4px; color: var(--color-accent);">
                <FluentProgressRing Width="12px" />
                @running task@(running == 1 ? "" : "s") running
            </span>
        }
    </span>
</div>

@code {
    protected override void OnInitialized() => TaskQueue.TasksChanged += OnTasksChanged;
    private void OnTasksChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => TaskQueue.TasksChanged -= OnTasksChanged;
}
