@inherits SwebKit.App.Components.Shared.SwebKitComponentBase
@inject ITaskQueue TaskQueue
@inject IPortForwardSessionService SessionService
@inject IConnectionStateService ConnState
@inject IAppEventBus EventBus
@implements IDisposable

<div class="status-bar" aria-label="Shell status">

    @* ── Connection dots ── *@
    <span class="status-section status-connections" aria-label="Connection status by area">
        @foreach (var (area, shortLabel) in _areas)
        {
            ConnState.States.TryGetValue(area, out var s);
            var css = s?.State switch
            {
                ConnectionState.Connected => "dot-connected",
                ConnectionState.Error => "dot-error",
                ConnectionState.NotConfigured => "dot-not-configured",
                _ => "dot-unknown"
            } ?? "dot-unknown";
            var route = ShellNavigation.ForArea(area);
            var tooltip = s?.State switch
            {
                ConnectionState.Error when s.ErrorMessage is not null => $"{route.Label}: {s.ErrorMessage}",
                ConnectionState.Error => $"{route.Label}: Needs attention",
                ConnectionState.Connected => $"{route.Label}: Connected",
                ConnectionState.NotConfigured => $"{route.Label}: Not configured",
                _ => $"{route.Label}: Not ready"
            };
            <span class="connection-indicator @(area == CurrentArea ? "active" : string.Empty)" title="@tooltip"
                  role="status" aria-label="@tooltip">
                <span class="connection-dot @css">@(s?.State switch
                    {
                        ConnectionState.Connected => "✓",
                        ConnectionState.Error => "✗",
                        ConnectionState.NotConfigured => "!",
                        _ => "·"
                    } ?? "·")</span>
                    <span class="connection-label">@shortLabel</span>
                </span>
            }
        </span>

        @if (!string.IsNullOrWhiteSpace(CurrentAreaStatusText))
        {
            <span class="status-section status-current-area" role="status">@CurrentAreaStatusText</span>
        }

        @* ── Spacer ── *@
        <span class="status-spacer"></span>

        @* ── Last refresh timestamp ── *@
        @if (_lastRefresh is not null)
        {
            <span class="status-section status-refresh" title="Most recent shell refresh request">
                @FormatRefresh(_lastRefresh.Value, _lastRefreshArea)
            </span>
        }

        @* ── Port-forward count ── *@
        @if (_activePortForwardCount > 0)
        {
            <button class="status-bar-btn" title="Open port-forward sessions panel"
                    aria-label="Open port-forward sessions panel" @onclick="OpenPortForwardPanel">
                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowForward())" Width="12px" />
                @_activePortForwardCount pf
            </button>
        }

        @* ── Background tasks ── *@
        @if (_runningTasks.Count == 1)
        {
            <span class="status-section status-task" title="@_runningTasks[0].Title">
                <FluentProgressRing Width="12px" />
                @_runningTasks[0].Title
                @if (_runningTasks[0].Total is > 0)
                {
                    <span class="status-progress">@_runningTasks[0].Progress / @_runningTasks[0].Total</span>
                    <progress value="@_runningTasks[0].Progress" max="@_runningTasks[0].Total"
                              style="width:60px; height:6px; margin-left:4px;" />
                }
            </span>
        }
        else if (_runningTasks.Count > 1)
        {
            var totalDone = _runningTasksTotalDone;
            var totalWork = _runningTasksTotalWork;
            <span class="status-section status-task">
                <FluentProgressRing Width="12px" />
                @_runningTasks.Count tasks running
                @if (totalWork > 0)
                {
                    <span class="status-progress">@totalDone / @totalWork</span>
                }
            </span>
        }

    </div>

@code {
    [Parameter] public ShellNavEntry CurrentRoute { get; set; } = ShellNavigation.Dashboard;

    private static readonly (string area, string shortLabel)[] _areas =
    [
        ("service-bus", "SB"),
        ("aks", "AKS"),
        ("observability", "Obs"),
        ("incident-timeline", "Incident"),
        ("redis", "Redis"),
        ("storage", "Storage"),
        ("pipelines", "Pipelines"),
    ];

    private DateTime? _lastRefresh;
    private string? _lastRefreshArea;
    private PeriodicTimer? _clockTimer;
    private CancellationTokenSource _cts = new();
    private string CurrentArea => CurrentRoute.Area;

    // Cached render state — updated in OnChanged to avoid LINQ in the render loop
    private int _activePortForwardCount;
    private IReadOnlyList<BackgroundTask> _runningTasks = [];
    private int _runningTasksTotalDone;
    private int _runningTasksTotalWork;

    // Cached — updated in OnChanged and OnParametersSet to avoid ConnState dictionary snapshot per render
    private string? _currentAreaStatusText;

    private void UpdateCachedState()
    {
        _activePortForwardCount = SessionService.Sessions.Count(
            s => s.Status is PortForwardStatus.Starting or PortForwardStatus.Active);
        _runningTasks = TaskQueue.Tasks.Where(t => t.Status == BackgroundTaskStatus.Running).ToList();
        _runningTasksTotalDone = _runningTasks.Sum(t => t.Progress ?? 0);
        _runningTasksTotalWork = _runningTasks.Sum(t => t.Total ?? 0);
    }

    private void UpdateAreaStatusText()
    {
        ConnState.States.TryGetValue(CurrentArea, out var state);
        _currentAreaStatusText = state?.State switch
        {
            ConnectionState.Connected => $"{CurrentRoute.Label} ready",
            ConnectionState.Error => $"{CurrentRoute.Label} needs attention",
            ConnectionState.NotConfigured => $"{CurrentRoute.Label} not configured",
            _ => $"{CurrentRoute.Label} starting"
        };
    }

    private string? CurrentAreaStatusText => _currentAreaStatusText;

    protected override void OnParametersSet()
    {
        UpdateAreaStatusText();
        UpdateCachedState();
    }

    protected override void OnInitialized()
    {
        UpdateCachedState();
        TaskQueue.TasksChanged += OnChanged;
        SessionService.SessionsChanged += OnChanged;
        ConnState.StatesChanged += OnChanged;
        EventBus.Subscribe<RefreshRequestedEvent>(OnRefreshRequested);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _clockTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = TickClockAsync(_cts.Token);
    }

    private async Task TickClockAsync(CancellationToken ct)
    {
        try
        {
            while (await _clockTimer!.WaitForNextTickAsync(ct))
                RequestCoalescedRender();
        }
        catch (OperationCanceledException) { }
    }

    private void OnChanged()
    {
        UpdateAreaStatusText();
        UpdateCachedState();
        RequestCoalescedRender();
    }

    private void OnRefreshRequested(RefreshRequestedEvent refresh)
    {
        _lastRefresh = DateTime.UtcNow;
        _lastRefreshArea = refresh.Area;
        RequestCoalescedRender();
    }

    private static string FormatRefresh(DateTime utc, string? area)
    {
        var label = ShellNavigation.ForArea(area).Label;
        var elapsed = DateTime.UtcNow - utc;
        if (elapsed.TotalSeconds < 5) return $"{label} refresh requested just now";
        if (elapsed.TotalSeconds < 60) return $"{label} refresh requested {(int)elapsed.TotalSeconds}s ago";
        if (elapsed.TotalMinutes < 60) return $"{label} refresh requested {(int)elapsed.TotalMinutes}m ago";
        return $"{label} refresh requested {(int)elapsed.TotalHours}h ago";
    }

    private void OpenPortForwardPanel()
    {
        EventBus.Publish(new NavigateToAreaEvent("aks"));
        EventBus.Publish(new OpenPortForwardPanelEvent());
    }

    public override void Dispose()
    {
        TaskQueue.TasksChanged -= OnChanged;
        SessionService.SessionsChanged -= OnChanged;
        ConnState.StatesChanged -= OnChanged;
        EventBus.Unsubscribe<RefreshRequestedEvent>(OnRefreshRequested);
        _cts.Cancel();
        _cts.Dispose();
        _clockTimer?.Dispose();
        base.Dispose();
    }
}
