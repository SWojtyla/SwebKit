@inject AppStateService AppState

<nav class="left-nav">
    <div class="nav-section" style="padding: 8px 0; border-bottom: 1px solid var(--color-border);">
        @if (IsExpanded && AppState.CurrentProject is not null)
        {
            <div style="padding: 6px 14px; font-size: 11px; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">
                @AppState.CurrentProject.Name
            </div>
        }
    </div>

    <div class="nav-section">
        <NavItem Icon="📁" Label="Projects" Area="projects" IsExpanded="IsExpanded" CurrentArea="CurrentArea"
                 OnNavigate="OnNavigate" />
        <NavItem Icon="⇔" Label="Service Bus" Area="service-bus" IsExpanded="IsExpanded" CurrentArea="CurrentArea"
                 OnNavigate="OnNavigate" />
        <NavItem Icon="📈" Label="Observability" Area="observability" IsExpanded="IsExpanded" CurrentArea="CurrentArea"
                 OnNavigate="OnNavigate" />
        <NavItem Icon="☸" Label="AKS" Area="aks" IsExpanded="IsExpanded" CurrentArea="CurrentArea"
                 OnNavigate="OnNavigate" />
        <NavItem Icon="🧰" Label="Redis" Area="redis" IsExpanded="IsExpanded" CurrentArea="CurrentArea"
             OnNavigate="OnNavigate" />
        <NavItem Icon="☁" Label="Storage" Area="storage" IsExpanded="IsExpanded" CurrentArea="CurrentArea"
             OnNavigate="OnNavigate" />
        <NavItem Icon="🚀" Label="Releases" Area="releases" IsExpanded="IsExpanded" CurrentArea="CurrentArea"
             OnNavigate="OnNavigate" />
    </div>

    <div class="nav-section" style="margin-top: auto; border-top: 1px solid var(--color-border);">
        <NavItem Icon="⚙" Label="Settings" Area="settings" IsExpanded="IsExpanded" CurrentArea="CurrentArea"
                 OnNavigate="OnNavigate" />
    </div>
</nav>

@code {
    [Parameter] public bool IsExpanded { get; set; } = true;
    [Parameter] public string CurrentArea { get; set; } = "projects";
    [Parameter] public EventCallback<string> OnNavigate { get; set; }
}