<nav class="left-nav" aria-label="Primary navigation">
    @foreach (var group in ShellNavigation.Groups)
    {
        <section class="nav-group @(group.StickToBottom ? "nav-group--footer" : string.Empty)"
                 aria-labelledby="@GetGroupId(group.Label)">
            <h2 id="@GetGroupId(group.Label)" class="nav-group-label @(IsExpanded ? string.Empty : "visually-hidden")">
                @group.Label</h2>

                <ul class="nav-section" role="list">
                    @foreach (var item in group.Items)
                    {
                        <li class="nav-section-item">
                            <NavItem NavIcon="@item.Icon" Label="@item.Label" Area="@item.Area" GroupLabel="@group.Label"
                                     IsExpanded="IsExpanded" CurrentArea="@CurrentArea" OnNavigate="OnNavigate" />
                        </li>
                    }
                </ul>
            </section>
        }
    </nav>

@code {
    [Parameter] public bool IsExpanded { get; set; } = true;
    [Parameter] public string CurrentArea { get; set; } = "service-bus";
    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    private static string GetGroupId(string label)
    {
        var normalized = string.Concat(label.Where(char.IsLetterOrDigit));
        return $"nav-group-{normalized.ToLowerInvariant()}";
    }
}