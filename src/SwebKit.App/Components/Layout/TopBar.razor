@inherits SwebKit.App.Components.Shared.SwebKitComponentBase
@inject AppStateService AppState
@inject IAppEventBus Events
@inject CommandRegistry Commands
@inject INotificationService Notifications
@inject IConnectionStateService ConnectionStateService
@inject OperatorWorkspaceService Workspaces
@inject UserSettingsRepository UserSettings
@implements IDisposable

<div class="top-bar">
    <div class="top-bar__start">
        <button type="button" class="nav-toggle" @onclick="OnNavToggle" title="Toggle navigation"
                aria-label="Toggle sidebar">&#9776;</button>
        <span class="app-logo-text @(_logoEasterEggActive ? "app-logo-text--sweb" : "")" @onclick="OnLogoClick"
              style="cursor:default;user-select:none;">
            @(_logoEasterEggActive ? "SWEBkit 👋" : "SwebKit")
        </span>
        <div class="top-bar__context" aria-live="polite">
            <span class="top-bar__context-eyebrow">@CurrentContext.GroupLabel</span>
            <span class="top-bar__context-title">@CurrentContext.Title</span>
            <span class="top-bar__context-summary">@CurrentContext.Summary</span>
        </div>
    </div>

    <div class="top-bar__spacer"></div>

    <div class="top-bar__badges" aria-label="Page status">
        @if (!string.IsNullOrWhiteSpace(ConnectionBadgeText))
        {
            <span class="shell-pill @ConnectionBadgeClass">@ConnectionBadgeText</span>
        }
        @if (CurrentContext.IsProduction)
        {
            <span class="shell-pill shell-pill--danger">Production</span>
        }
        @if (AppState.UseDemoData)
        {
            <span class="shell-pill shell-pill--warning">Demo</span>
        }
    </div>

    <div class="top-bar__popover-anchor">
        <button class="top-bar-icon-btn" @onclick="ToggleWorkspaceHub" title="Resources and favorites"
                aria-label="Resources and favorites" aria-expanded="@_isWorkspaceHubOpen" aria-haspopup="dialog">
            <span aria-hidden="true">⌘</span>
        </button>
        @if (_isWorkspaceHubOpen)
        {
            <div class="top-bar-popover top-bar-popover--workspace">
                <div class="workspace-hub">
                    <div class="workspace-hub__section">
                        <div class="workspace-hub__section-title">Current</div>
                        @if (CurrentSnapshot is null)
                        {
                            <div class="workspace-hub__empty">Open a resource to save it as a favorite.</div>
                        }
                        else
                        {
                            <div class="workspace-hub__resource-card">
                                <div class="workspace-hub__resource-title">@(CurrentSnapshot.Resource.DisplayPath ??
                                                                                                                                                                                                                CurrentSnapshot.Resource.DisplayName)</div>
                                    <div class="workspace-hub__resource-summary">@BuildResourceSummary(CurrentSnapshot)</div>
                                    <div class="workspace-hub__save-row">
                                        <input class="workspace-hub__input" placeholder="Name favorite as" value="@_favoriteName"
                                               @oninput="OnFavoriteNameChanged" />
                                        <button class="workspace-hub__action-btn workspace-hub__action-btn--primary"
                                                @onclick="SaveFavoriteAsync">
                                            @(IsCurrentFavorite ? "Update" : "Save")
                                        </button>
                                    </div>
                                    <div class="workspace-hub__resource-actions">
                                        <button class="workspace-hub__action-btn" @onclick="OpenCurrentResourceAsync">Open</button>
                                        @if (IsCurrentFavorite)
                                        {
                                            <button class="workspace-hub__delete-btn"
                                                    @onclick="RemoveCurrentFavoriteAsync">Remove</button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="workspace-hub__section">
                            <div class="workspace-hub__section-title">Favorites</div>
                            @if (FavoriteResources.Count == 0)
                            {
                                <div class="workspace-hub__empty">No favorites saved yet.</div>
                            }
                            else
                            {
                                @foreach (var favorite in FavoriteResources)
                                {
                                    <div class="workspace-hub__list-row">
                                        <button class="workspace-hub__list-item" @onclick="() => OpenFavoriteAsync(favorite)">
                                            <span class="workspace-hub__list-title">@GetFavoriteTitle(favorite)</span>
                                            <span class="workspace-hub__list-summary">@BuildFavoriteSummary(favorite)</span>
                                        </button>
                                        <button class="workspace-hub__delete-btn" title="Remove favorite"
                                                aria-label="Remove favorite @GetFavoriteTitle(favorite)"
                                                @onclick="() => RemoveFavoriteAsync(favorite)">
                                            ✕
                                        </button>
                                    </div>
                                }
                            }
                        </div>

                        <div class="workspace-hub__section">
                            <div class="workspace-hub__section-title">Recent</div>
                            @if (RecentResources.Count == 0)
                            {
                                <div class="workspace-hub__empty">No recent resources yet.</div>
                            }
                            else
                            {
                                @foreach (var recent in RecentResources)
                                {
                                    <button class="workspace-hub__list-item" @onclick="() => OpenRecentAsync(recent)">
                                        <span class="workspace-hub__list-title">@(recent.Snapshot.Resource.DisplayPath ??
                                                                                                                                                                                                                                                            recent.Snapshot.Resource.DisplayName)</span>
                                            <span class="workspace-hub__list-summary">@recent.AccessedAt.ToLocalTime().ToString("g")</span>
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!AppState.UseDemoData)
            {
                <div class="top-bar__popover-anchor">
                    <button class="demo-toggle-btn" @onclick="ShowDemoConfirm" title="Enable demo mode"
                            aria-label="Enable demo mode">Demo</button>
                    @if (_showDemoConfirm)
                    {
                        <div class="demo-confirm-popover">
                            <div class="demo-confirm-title">Enable demo mode?</div>
                            <div class="demo-confirm-copy">
                                Live connections will be replaced with synthetic data.
                            </div>
                            <div class="demo-confirm-actions">
                                <button class="demo-confirm-cancel" @onclick="HideDemoConfirm">Cancel</button>
                                <button class="demo-confirm-enable" @onclick="EnableDemoAsync">Enable</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="top-bar__popover-anchor">
                <button class="top-bar-icon-btn" @onclick="ToggleHistory" title="Notifications"
                        aria-label="@NotificationButtonLabel" aria-expanded="@_isHistoryOpen" aria-haspopup="dialog">
                    <span aria-hidden="true">🔔</span>
                    @if (UnreadCount > 0)
                    {
                        <span class="top-bar-icon-badge">@UnreadCount</span>
                    }
                </button>
                @if (_isHistoryOpen)
                {
                    <div class="top-bar-popover top-bar-popover--history">
                        <NotificationHistory OnClose="CloseHistory" />
                    </div>
                }
            </div>

            <button class="cmd-palette-btn" @onclick="OpenCommandPalette" aria-label="Open command palette">
                &gt;_ Command Palette <kbd>Ctrl+P</kbd>
            </button>

            @if (UserSettings.Settings?.Agent?.IsEnabled == true)
            {
                <button class="top-bar-icon-btn @(IsAgentPanelOpen ? "top-bar-icon-btn--active" : "")" @onclick="OnAgentPanelToggle"
                        title="@(IsAgentPanelOpen ? "Close AI Agent panel" : "Open AI Agent panel")"
                        aria-label="@(IsAgentPanelOpen ? "Close AI Agent panel" : "Open AI Agent panel")"
                        aria-pressed="@IsAgentPanelOpen">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Bot())" Width="16px" />
                </button>
            }
        </div>

@code {
    [Parameter] public EventCallback OnNavToggle { get; set; }
    [Parameter] public bool IsAgentPanelOpen { get; set; }
    [Parameter] public EventCallback OnAgentPanelToggle { get; set; }
    [Parameter]
    public ShellRouteContext CurrentContext { get; set; } =
ShellNavigation.CreateContext(ShellNavigation.Dashboard, false, false);





    private bool _isHistoryOpen;
    private bool _isWorkspaceHubOpen;
    private bool _showDemoConfirm;
    private string _favoriteName = string.Empty;
    private int _lastSeenCount;

    // Cached to avoid ConnState dictionary snapshot on every render (each call does new Dictionary<>)
    private AreaConnectionState? _currentAreaState;

    // Cached workspace lists — rebuilt only in OnWorkspaceChanged, not on every render
    private IReadOnlyList<FavoriteResource> _favoriteResources = [];
    private IReadOnlyList<RecentResourceEntry> _recentResources = [];

    private AreaConnectionState? CurrentAreaState => _currentAreaState;
    private WorkspaceSnapshot? CurrentSnapshot => Workspaces.GetCurrentSnapshot(CurrentContext.Area);
    private FavoriteResource? CurrentFavorite => CurrentSnapshot is null
        ? null
        : Workspaces.GetFavoriteResource(CurrentSnapshot.Resource.Key);
    private bool IsCurrentFavorite => CurrentFavorite is not null;
    private IReadOnlyList<FavoriteResource> FavoriteResources => _favoriteResources;
    private IReadOnlyList<RecentResourceEntry> RecentResources => _recentResources;
    private int UnreadCount => Math.Max(0, Notifications.All.Count - _lastSeenCount);
    private string NotificationButtonLabel => UnreadCount > 0
        ? $"Notifications, {UnreadCount} unread"
        : "Notifications";
    private string? ConnectionBadgeText => _currentAreaState?.State switch
    {
        ConnectionState.Connected => "Connected",
        ConnectionState.Error => "Needs attention",
        ConnectionState.NotConfigured => "Needs setup",
        _ => null,
    };
    private string ConnectionBadgeClass => _currentAreaState?.State switch
    {
        ConnectionState.Connected => "shell-pill--success",
        ConnectionState.Error => "shell-pill--warning",
        ConnectionState.NotConfigured => "shell-pill--muted",
        _ => "shell-pill--muted",
    };

    private void RefreshAreaState()
    {
        ConnectionStateService.States.TryGetValue(CurrentContext.Area, out var state);
        _currentAreaState = state;
    }

    protected override void OnParametersSet() => RefreshAreaState();

    protected override void OnInitialized()
    {
        RefreshAreaState();
        _favoriteResources = Workspaces.GetFavoriteResources().Take(5).ToList();
        _recentResources = Workspaces.GetRecentResources().Take(5).ToList();
        Notifications.NotificationsChanged += OnNotificationsChanged;
        AppState.DemoModeChanged += OnDemoModeChanged;
        ConnectionStateService.StatesChanged += OnConnectionStateChanged;
        Workspaces.Changed += OnWorkspaceChanged;
        UserSettings.Changed += OnUserSettingsChanged;
    }

    private void OnNotificationsChanged()
    {
        if (_lastSeenCount > Notifications.All.Count)
        {
            _lastSeenCount = Notifications.All.Count;
        }

        RequestCoalescedRender();
    }

    private void OnConnectionStateChanged()
    {
        RefreshAreaState();
        RequestCoalescedRender();
    }

    private void OnDemoModeChanged() => RequestCoalescedRender();

    private void OnWorkspaceChanged()
    {
        _favoriteResources = Workspaces.GetFavoriteResources().Take(5).ToList();
        _recentResources = Workspaces.GetRecentResources().Take(5).ToList();
        if (_isWorkspaceHubOpen)
        {
            SyncFavoriteName();
        }

        RequestCoalescedRender();
    }

    private void OnUserSettingsChanged() => RequestCoalescedRender();

    private void ToggleHistory()
    {
        _isHistoryOpen = !_isHistoryOpen;
        _isWorkspaceHubOpen = false;
        _showDemoConfirm = false;
        if (_isHistoryOpen)
        {
            _lastSeenCount = Notifications.All.Count;
        }

        RequestRender();
    }

    private void ToggleWorkspaceHub()
    {
        _isWorkspaceHubOpen = !_isWorkspaceHubOpen;
        _isHistoryOpen = false;
        _showDemoConfirm = false;
        if (_isWorkspaceHubOpen)
        {
            SyncFavoriteName();
        }

        RequestRender();
    }

    private void CloseHistory()
    {
        _isHistoryOpen = false;
        RequestRender();
    }

    private void ShowDemoConfirm()
    {
        _isWorkspaceHubOpen = false;
        _isHistoryOpen = false;
        _showDemoConfirm = true;
        RequestRender();
    }

    private void HideDemoConfirm()
    {
        _showDemoConfirm = false;
        RequestRender();
    }

    private async Task EnableDemoAsync()
    {
        _showDemoConfirm = false;
        RequestRender();
        await AppState.SetDemoModeAsync(true);
    }

    private void OpenCommandPalette()
    {
        _isWorkspaceHubOpen = false;
        _isHistoryOpen = false;
        _showDemoConfirm = false;
        RequestRender();
        Events.Publish(new CommandPaletteRequestedEvent());
    }

    private void OnFavoriteNameChanged(ChangeEventArgs args)
    {
        _favoriteName = args.Value?.ToString() ?? string.Empty;
    }

    private async Task SaveFavoriteAsync()
    {
        if (CurrentSnapshot is null)
        {
            return;
        }

        await Workspaces.SaveFavoriteAsync(CurrentSnapshot, _favoriteName);
        SyncFavoriteName();
    }

    private async Task RemoveCurrentFavoriteAsync()
    {
        if (CurrentSnapshot is null)
        {
            return;
        }

        await Workspaces.RemoveFavoriteAsync(CurrentSnapshot.Resource.Key);
        SyncFavoriteName();
    }

    private Task OpenCurrentResourceAsync() => CurrentSnapshot is null
        ? Task.CompletedTask
        : OpenSnapshotAsync(CurrentSnapshot);

    private Task OpenFavoriteAsync(FavoriteResource favorite) => OpenSnapshotAsync(favorite.Snapshot);

    private Task RemoveFavoriteAsync(FavoriteResource favorite) =>
        Workspaces.RemoveFavoriteAsync(favorite.Snapshot.Resource.Key);

    private Task OpenRecentAsync(RecentResourceEntry recent) => OpenSnapshotAsync(recent.Snapshot);

    private async Task OpenSnapshotAsync(WorkspaceSnapshot snapshot)
    {
        _isWorkspaceHubOpen = false;
        RequestRender();
        await Workspaces.OpenSnapshotAsync(snapshot, recordRecent: true);
    }

    private void SyncFavoriteName()
    {
        if (CurrentSnapshot is null)
        {
            _favoriteName = string.Empty;
            return;
        }

        _favoriteName = GetEffectiveFavoriteName(CurrentFavorite, CurrentSnapshot);
    }

    private static string GetFavoriteTitle(FavoriteResource favorite)
    {
        var configuredName = favorite.Name.Trim();
        return string.IsNullOrWhiteSpace(configuredName)
            ? favorite.Snapshot.Resource.DisplayPath ?? favorite.Snapshot.Resource.DisplayName
            : configuredName;
    }

    private static string GetEffectiveFavoriteName(FavoriteResource? favorite, WorkspaceSnapshot snapshot)
    {
        var configuredName = favorite?.Name?.Trim();
        return string.IsNullOrWhiteSpace(configuredName)
            ? snapshot.Resource.DisplayPath ?? snapshot.Resource.DisplayName
            : configuredName;
    }

    private static string BuildFavoriteSummary(FavoriteResource favorite)
    {
        var resourceLabel = favorite.Snapshot.Resource.DisplayPath ?? favorite.Snapshot.Resource.DisplayName;
        var resourceSummary = BuildResourceSummary(favorite.Snapshot);
        return string.Equals(GetFavoriteTitle(favorite), resourceLabel, StringComparison.Ordinal)
            ? resourceSummary
            : $"{resourceLabel} | {resourceSummary}";
    }

    private static string BuildResourceSummary(WorkspaceSnapshot snapshot)
    {
        var areaLabel = ShellNavigation.ForArea(snapshot.Resource.Area).Label;
        return string.IsNullOrWhiteSpace(snapshot.Resource.Summary)
            ? areaLabel
            : $"{areaLabel} | {snapshot.Resource.Summary}";
    }

    // ── Easter egg: logo ───────────────────────────────────────────────────────
    private int _logoClickCount;
    private DateTime _firstLogoClickAt;
    private bool _logoEasterEggActive;
    private System.Timers.Timer? _logoEasterEggTimer;

    private void OnLogoClick()
    {
        var now = DateTime.UtcNow;
        if (_logoClickCount == 0 || (now - _firstLogoClickAt).TotalSeconds > 2)
        {
            _logoClickCount = 1;
            _firstLogoClickAt = now;
        }
        else
        {
            _logoClickCount++;
        }

        if (_logoClickCount >= 7)
        {
            _logoClickCount = 0;
            _logoEasterEggActive = true;
            _logoEasterEggTimer?.Dispose();
            _logoEasterEggTimer = new System.Timers.Timer(3000) { AutoReset = false };
            _logoEasterEggTimer.Elapsed += (_, _) =>
            {
                _logoEasterEggTimer?.Dispose();
                _logoEasterEggTimer = null;
                _logoEasterEggActive = false;
                InvokeAsync(StateHasChanged);
            };
            _logoEasterEggTimer.Start();
        }
    }

    public void Dispose()
    {
        Notifications.NotificationsChanged -= OnNotificationsChanged;
        AppState.DemoModeChanged -= OnDemoModeChanged;
        ConnectionStateService.StatesChanged -= OnConnectionStateChanged;
        Workspaces.Changed -= OnWorkspaceChanged;
        UserSettings.Changed -= OnUserSettingsChanged;
        _logoEasterEggTimer?.Dispose();
    }
}