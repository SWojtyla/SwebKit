@inject AppStateService AppState
@inject IAppEventBus Events
@inject CommandRegistry Commands
@inject INotificationService Notifications
@implements IDisposable

<div class="top-bar" style="background: #1E1E2E;">
    <button class="nav-toggle" @onclick="OnNavToggle" title="Toggle navigation">&#9776;</button>
    <span class="app-logo" style="font-weight:700; font-size:15px; margin-right:8px;">SwebKit</span>

    <div style="display:flex; align-items:center; flex:1;"></div>

    @if (!AppState.UseDemoData)
    {
        <div style="position:relative; margin-right:8px;">
            <button class="demo-toggle-btn" @onclick="ShowDemoConfirm" title="Enable demo mode">Demo</button>
            @if (_showDemoConfirm)
            {
                <div class="demo-confirm-popover">
                    <div style="font-weight:600; margin-bottom:6px;">Enable demo mode?</div>
                    <div style="font-size:11px; color:rgba(255,255,255,0.7); margin-bottom:10px; line-height:1.4;">
                        Live connections will be replaced with synthetic data.
                    </div>
                    <div style="display:flex; gap:6px; justify-content:flex-end;">
                        <button class="demo-confirm-cancel" @onclick="HideDemoConfirm">Cancel</button>
                        <button class="demo-confirm-enable" @onclick="EnableDemoAsync">Enable</button>
                    </div>
                </div>
            }
        </div>
    }

    <div style="position:relative; margin-right:8px;">
        <button @onclick="ToggleHistory"
                style="background:transparent; border:none; color:white; font-size:18px; cursor:pointer; padding:4px 8px; position:relative; line-height:1;"
                title="Notifications">
            🔔
            @if (UnreadCount > 0)
            {
                <span
                style="position:absolute; top:0; right:0; background:#EF4444; color:white; font-size:9px; font-weight:700; border-radius:8px; padding:1px 4px; line-height:1.4; min-width:14px; text-align:center;">@UnreadCount</span>
            }
        </button>
        @if (_isHistoryOpen)
        {
            <div style="position:absolute; top:100%; right:0; z-index:8000;">
                <NotificationHistory />
            </div>
        }
    </div>

    <button class="cmd-palette-btn" @onclick="OpenCommandPalette"
            style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.2); border-radius:4px; padding:4px 10px; font-size:12px; cursor:pointer;">
        &gt;_ Command Palette &nbsp;<kbd>Ctrl+P</kbd>
    </button>
</div>

<style>
    .nav-toggle {
        background: transparent;
        border: none;
        color: white;
        font-size: 18px;
        cursor: pointer;
        padding: 4px 8px;
    }

    kbd {
        background: rgba(0, 0, 0, 0.3);
        padding: 1px 4px;
        border-radius: 2px;
        font-size: 10px;
    }

    .demo-toggle-btn {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 4px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 11px;
        padding: 3px 10px;
        cursor: pointer;
    }

    .demo-toggle-btn:hover {
        background: rgba(255, 255, 255, 0.18);
        color: white;
    }

    .demo-confirm-popover {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        background: #2a2a3e;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 6px;
        padding: 12px 14px;
        width: 230px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
        z-index: 9000;
        color: white;
        font-size: 12px;
    }

    .demo-confirm-cancel {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 3px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 11px;
        padding: 3px 10px;
        cursor: pointer;
    }

    .demo-confirm-enable {
        background: #d97706;
        border: none;
        border-radius: 3px;
        color: white;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        cursor: pointer;
    }
</style>

@code {
    [Parameter] public EventCallback OnNavToggle { get; set; }

    private bool _isHistoryOpen;
    private bool _showDemoConfirm;
    private int _lastSeenCount;
    private int UnreadCount => Math.Max(0, Notifications.All.Count - _lastSeenCount);

    protected override void OnInitialized()
    {
        Notifications.NotificationsChanged += OnNotificationsChanged;
        AppState.DemoModeChanged += OnDemoModeChanged;
    }

    private void OnNotificationsChanged() => InvokeAsync(StateHasChanged);
    private void OnDemoModeChanged() => InvokeAsync(StateHasChanged);

    private void ToggleHistory()
    {
        _isHistoryOpen = !_isHistoryOpen;
        if (_isHistoryOpen)
            _lastSeenCount = Notifications.All.Count;
    }

    private void ShowDemoConfirm()
    {
        _showDemoConfirm = true;
    }

    private void HideDemoConfirm()
    {
        _showDemoConfirm = false;
    }

    private async Task EnableDemoAsync()
    {
        _showDemoConfirm = false;
        await AppState.SetDemoModeAsync(true);
    }

    private void OpenCommandPalette() => Events.Publish(new CommandPaletteRequestedEvent());

    public void Dispose()
    {
        Notifications.NotificationsChanged -= OnNotificationsChanged;
        AppState.DemoModeChanged -= OnDemoModeChanged;
    }
}