@if (MutationsEnabled)
{
    <div class="storage-mutation-banner storage-mutation-banner--warning" role="status" aria-live="polite">
        <span class="storage-mutation-banner__icon" aria-hidden="true">⚠️</span>
        <span class="storage-mutation-banner__text">
            <strong>Mutation mode is active</strong> — uploads, copies, and write operations are permitted
            @if (!string.IsNullOrWhiteSpace(AccountName))
            {
                <span> for account <strong>@AccountName</strong></span>
            }
            .
            Write operations cannot be undone automatically.
        </span>
    </div>
}
else
{
    <div class="storage-mutation-banner storage-mutation-banner--info" role="status" aria-live="polite">
        <span class="storage-mutation-banner__text">Read-only — no write operations are permitted for this account.</span>
    </div>
}

@code {
    [Parameter] public bool MutationsEnabled { get; set; }
    [Parameter] public string? AccountName { get; set; }
}
