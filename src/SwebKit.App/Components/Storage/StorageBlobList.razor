@inject IJSRuntime JS
@inject INotificationService Notifications
@using System.IO.Compression

<div class="storage-blob-list">

    @* ── Breadcrumb ── *@
    <div class="storage-blob-list__breadcrumbs">
        @for (int i = 0; i < _breadcrumbs.Count; i++)
        {
            var crumb = _breadcrumbs[i];
            var isLast = i == _breadcrumbs.Count - 1;
            if (i > 0)
            {
                <span class="storage-blob-list__crumb-separator">/</span>
            }
            @if (isLast)
            {
                <span class="storage-blob-list__crumb-current">@crumb.Label</span>
            }
            else
            {
                <button class="storage-blob-list__crumb-button" @onclick="() => NavigateToCrumbAsync(crumb.Prefix)">@crumb.Label</button>
            }
        }
    </div>

    @* ── Content ── *@
    @if (_loading && _items.Count == 0)
    {
        <div class="storage-blob-list__loading">
            <FluentProgressRing />
        </div>
    }
    else if (_errorMessage is not null)
    {
        <div class="storage-blob-list__message storage-blob-list__message--error">@_errorMessage</div>
    }
    else
    {
        <div class="storage-blob-list__content" tabindex="0" @onkeydown="HandleBlobKeyDown"
             @onkeydown:preventDefault="_preventBlobKey">
            @if (_items.Count == 0 && !_loading)
            {
                <div class="storage-blob-list__message">No items in this folder.</div>
            }
            else
            {
                <div class="storage-blob-list__toolbar">
                    <input type="text" @bind="_blobFilter" @bind:event="oninput" placeholder="Filter blobs…"
                           class="storage-blob-list__filter-input" />
                    <span class="storage-blob-list__toolbar-count">@FilteredItems.Count of @_items.Count item(s)</span>
                    <button class="@(_multiSelectMode ? "storage-blob-list__select-toggle is-active" : "storage-blob-list__select-toggle")"
                            @onclick="ToggleMultiSelect">
                        ☑ Select
                    </button>
                </div>

                @* ── Bulk action bar ── *@
                @if (_multiSelectMode && _selectedBlobs.Count > 0)
                {
                    <div class="storage-blob-list__bulk-bar">
                        <span class="storage-blob-list__bulk-count">@_selectedBlobs.Count selected</span>
                        <FluentButton Appearance="Appearance.Accent" Disabled="@_bulkDownloading" @onclick="BulkDownloadAsync">
                            @(_bulkDownloading ? "Downloading…" : "Download as ZIP")
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Lightweight" @onclick="ClearSelection">Clear</FluentButton>
                    </div>
                }

                @if (_downloadState is not null)
                {
                    <div class="storage-blob-list__download-card">
                        <div class="storage-blob-list__download-header">
                            <span class="storage-blob-list__download-title">Downloading @GetDisplayName(_downloadState.BlobName)</span>
                            <span class="storage-blob-list__download-meta">@FormatDownloadProgress(_downloadState)</span>
                        </div>
                        @if (TryGetDownloadPercent(_downloadState, out var downloadPercent))
                        {
                            <div class="storage-blob-list__progress-track">
                                <div class="storage-blob-list__progress-fill" style="width:@($"{downloadPercent:F1}%");"></div>
                            </div>
                        }
                        else
                        {
                            <div class="storage-blob-list__progress-pending">
                                <FluentProgressRing Width="14px" Height="14px" />
                                <span>Waiting for total size…</span>
                            </div>
                        }
                    </div>
                }

                <ContextMenu @ref="_ctxMenu">
                    <button class="ctx-item" @onclick="() => CopyUrlAsync(_ctxItem!)"><span class="ctx-item-icon">🔗</span> Copy
                        URL</button>
                    <button class="ctx-item" @onclick="() => CopySasWithExpiryAsync(_ctxItem!, TimeSpan.FromHours(1))"><span
                            class="ctx-item-icon">🔑</span> Copy SAS URL (1 h)</button>
                    <button class="ctx-item" @onclick="() => CopySasWithExpiryAsync(_ctxItem!, TimeSpan.FromHours(8))"><span
                            class="ctx-item-icon">🔑</span> Copy SAS URL (8 h)</button>
                    <button class="ctx-item" @onclick="() => CopySasWithExpiryAsync(_ctxItem!, TimeSpan.FromHours(24))"><span
                            class="ctx-item-icon">🔑</span> Copy SAS URL (24 h)</button>
                    <button class="ctx-item" @onclick="() => CopySasWithExpiryAsync(_ctxItem!, TimeSpan.FromDays(7))"><span
                            class="ctx-item-icon">🔑</span> Copy SAS URL (7 d)</button>
                    <button class="ctx-item" @onclick="() => CopySasWithExpiryAsync(_ctxItem!, TimeSpan.FromDays(30))"><span
                            class="ctx-item-icon">🔑</span> Copy SAS URL (30 d)</button>
                    <button class="ctx-item" @onclick="() => ShowCustomSasDialog(_ctxItem!)"><span
                            class="ctx-item-icon">🔑</span> Copy SAS URL (custom…)</button>
                    <button class="ctx-item" @onclick="() => CopyRelativePathAsync(_ctxItem!)"><span
                            class="ctx-item-icon">📋</span> Copy
                        path</button>
                    <div class="ctx-separator"></div>
                    <button class="ctx-item" disabled="@(_downloadState is not null)"
                            @onclick="() => DownloadAsync(_ctxItem!)"><span class="ctx-item-icon">⬇</span>
                        @(_downloadState is null ? "Download" : "Downloading...")</button>
                </ContextMenu>

                @* ── Custom SAS dialog ── *@
                @if (_showCustomSasDialog)
                {
                    <div class="storage-blob-list__dialog-backdrop" @onclick="() => _showCustomSasDialog = false">
                        <div class="storage-blob-list__dialog" @onclick:stopPropagation="true">
                            <div class="storage-blob-list__dialog-title">Custom SAS expiry</div>
                            <div class="storage-blob-list__dialog-row">
                                <input type="number" min="1" max="8760" @bind="_customSasHours"
                                       class="storage-blob-list__dialog-input" />
                                <span>hours</span>
                            </div>
                            <div class="storage-blob-list__dialog-actions">
                                <FluentButton Appearance="Appearance.Lightweight" @onclick="() => _showCustomSasDialog = false">
                                    Cancel</FluentButton>
                                <FluentButton Appearance="Appearance.Accent" @onclick="ApplyCustomSasAsync">Copy SAS</FluentButton>
                            </div>
                        </div>
                    </div>
                }

                <table class="storage-blob-list__table">
                    <thead>
                        <tr>
                            @if (_multiSelectMode)
                            {
                                <th class="storage-blob-list__th storage-blob-list__th--check"></th>
                            }
                            <th class="storage-blob-list__th storage-blob-list__th--icon"></th>
                            <th class="storage-blob-list__th storage-blob-list__th--sortable" @onclick='() => SetSort("name")'>
                                <span class="storage-blob-list__sort-label">Name @SortIndicator("name")</span>
                            </th>
                            <th class="storage-blob-list__th storage-blob-list__th--sortable storage-blob-list__th--numeric" @onclick='() => SetSort("size")'>
                                <span class="storage-blob-list__sort-label">Size @SortIndicator("size")</span>
                            </th>
                            <th class="storage-blob-list__th">Content-Type</th>
                            <th class="storage-blob-list__th storage-blob-list__th--sortable" @onclick='() => SetSort("modified")'>
                                <span class="storage-blob-list__sort-label">Last Modified @SortIndicator("modified")</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in SortedFilteredItems)
                        {
                            var isSelected = !item.IsPrefix && item.Name == SelectedBlob?.Name;
                            var displayName = GetDisplayName(item.Name);
                            <tr class="@(isSelected ? "storage-blob-list__row is-selected" : "storage-blob-list__row")"
                                @onclick="() => OnRowClickAsync(item)" @oncontextmenu="e => OnRowContextMenu(e, item)"
                                @oncontextmenu:preventDefault="true">
                                @if (_multiSelectMode)
                                {
                                    <td class="storage-blob-list__td storage-blob-list__td--check">
                                        @if (!item.IsPrefix)
                                        {
                                            <input type="checkbox" checked="@_selectedBlobs.Contains(item.Name)"
                                                   @onclick:stopPropagation="true" @onchange="() => ToggleBlobSelection(item.Name)" />
                                        }
                                    </td>
                                }
                                <td class="storage-blob-list__td storage-blob-list__td--icon">@(item.IsPrefix ? "📁" : "📄")</td>
                                <td class="storage-blob-list__td" title="@item.Name">@displayName</td>
                                <td class="storage-blob-list__td storage-blob-list__td--numeric storage-blob-list__td--muted">
                                    @(item.IsPrefix ? "" : FormatSize(item.SizeBytes))</td>
                                <td class="storage-blob-list__td storage-blob-list__td--muted storage-blob-list__td--truncate">
                                    @(item.IsPrefix ? "" : (item.ContentType ?? ""))</td>
                                <td class="storage-blob-list__td storage-blob-list__td--muted storage-blob-list__td--time">@(item.IsPrefix ?
                                    "" : item.LastModified?.ToString("yyyy-MM-dd HH:mm"))</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (_hasMore)
                {
                    <div class="storage-blob-list__load-more">
                        <FluentButton Appearance="Appearance.Lightweight" Disabled="@_loading" @onclick="LoadMoreAsync">
                            @(_loading ? "Loading..." : "Load more")
                        </FluentButton>
                    </div>
                }
            }
        </div>
    }

    @if (_actionMessage is not null)
    {
        <div class="@(_actionOk ? "storage-blob-list__action-message is-success" : "storage-blob-list__action-message is-error")">
            @_actionMessage
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public IStorageClient Client { get; set; } = default!;
    [Parameter] public string ContainerName { get; set; } = string.Empty;
    [Parameter] public StorageBlobItem? SelectedBlob { get; set; }
    [Parameter] public EventCallback<StorageBlobItem?> SelectedBlobChanged { get; set; }

    private string _prefix = string.Empty;
    private List<(string Label, string Prefix)> _breadcrumbs = [];
    private List<StorageBlobItem> _items = [];
    private string? _continuationToken;
    private bool _loading;
    private bool _hasMore;
    private string? _errorMessage;
    private string? _actionMessage;
    private bool _actionOk;
    private string? _loadedContainerName;
    private ContextMenu _ctxMenu = default!;
    private StorageBlobItem? _ctxItem;
    private bool _preventBlobKey;
    private string _blobFilter = "";

    // STG-3: Multi-select bulk operations
    private bool _multiSelectMode;
    private HashSet<string> _selectedBlobs = new(StringComparer.Ordinal);
    private bool _bulkDownloading;

    // STG-4: Custom SAS dialog
    private bool _showCustomSasDialog;
    private int _customSasHours = 1;
    private StorageBlobItem? _customSasItem;

    private DownloadUiState? _downloadState;
    private long _lastDownloadUiBytes = -1;
    private DateTimeOffset _lastDownloadUiUpdate = DateTimeOffset.MinValue;

    // STG-9: Sorting
    private string _sortColumn = "name";
    private bool _sortAscending = true;

    private sealed class DownloadUiState
    {
        public required string BlobName { get; init; }
        public required string DestinationPath { get; init; }
        public long? TotalBytes { get; init; }
        public long BytesTransferred { get; set; }
    }

    private IReadOnlyList<StorageBlobItem> FilteredItems => string.IsNullOrEmpty(_blobFilter)
        ? _items
        : _items.Where(i => i.Name.Contains(_blobFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    private IReadOnlyList<StorageBlobItem> SortedFilteredItems
    {
        get
        {
            var filtered = FilteredItems;
            var folders = filtered.Where(i => i.IsPrefix);
            var blobs = filtered.Where(i => !i.IsPrefix);

            blobs = _sortColumn switch
            {
                "size" => _sortAscending
                    ? blobs.OrderBy(b => b.SizeBytes ?? 0)
                    : blobs.OrderByDescending(b => b.SizeBytes ?? 0),
                "modified" => _sortAscending
                    ? blobs.OrderBy(b => b.LastModified ?? DateTimeOffset.MinValue)
                    : blobs.OrderByDescending(b => b.LastModified ?? DateTimeOffset.MinValue),
                _ => _sortAscending
                    ? blobs.OrderBy(b => b.Name, StringComparer.OrdinalIgnoreCase)
                    : blobs.OrderByDescending(b => b.Name, StringComparer.OrdinalIgnoreCase),
            };

            return folders.Concat(blobs).ToList();
        }
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string SortIndicator(string column) =>
        _sortColumn != column ? "" : _sortAscending ? "↑" : "↓";

    private void ToggleMultiSelect()
    {
        _multiSelectMode = !_multiSelectMode;
        if (!_multiSelectMode)
            _selectedBlobs.Clear();
    }

    private void ToggleBlobSelection(string blobName)
    {
        if (!_selectedBlobs.Remove(blobName))
            _selectedBlobs.Add(blobName);
    }

    private void ClearSelection() => _selectedBlobs.Clear();

    private async Task BulkDownloadAsync()
    {
        if (_selectedBlobs.Count == 0) return;
        _bulkDownloading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var downloadsPath = System.IO.Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            var zipName = $"{ContainerName}_{DateTime.Now:yyyyMMdd_HHmmss}.zip";
            var zipPath = System.IO.Path.Combine(downloadsPath, zipName);

            await using var fs = System.IO.File.Create(zipPath);
            using var archive = new ZipArchive(fs, ZipArchiveMode.Create, leaveOpen: false);

            foreach (var blobName in _selectedBlobs)
            {
                var entryName = blobName.Replace('/', System.IO.Path.DirectorySeparatorChar);
                var entry = archive.CreateEntry(entryName, CompressionLevel.Fastest);
                await using var entryStream = entry.Open();
                await Client.DownloadBlobAsync(ContainerName, blobName, entryStream);
            }

            _actionOk = true;
            _actionMessage = $"Downloaded {_selectedBlobs.Count} blob(s) to: {zipPath}";
            Notifications.ShowSuccess("ZIP downloaded", zipName);
            _selectedBlobs.Clear();
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _actionOk = false;
            _actionMessage = $"Bulk download failed: {ex.Message}";
            Notifications.ShowError("Bulk download failed", ex: ex);
        }
        finally
        {
            _bulkDownloading = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedContainerName == ContainerName)
            return;

        _loadedContainerName = ContainerName;
        _prefix = string.Empty;
        _blobFilter = "";
        _items.Clear();
        _continuationToken = null;
        _breadcrumbs = BuildBreadcrumbs();
        _selectedBlobs.Clear();
        _multiSelectMode = false;
        await LoadPageAsync(reset: true);
    }

    private async Task NavigateToCrumbAsync(string prefix)
    {
        _prefix = prefix;
        _blobFilter = "";
        _breadcrumbs = BuildBreadcrumbs();
        _continuationToken = null;
        _items.Clear();
        _selectedBlobs.Clear();
        await SelectedBlobChanged.InvokeAsync(null);
        await LoadPageAsync(reset: true);
    }

    private async Task NavigateToFolderAsync(string folderPath)
    {
        _prefix = folderPath;
        _blobFilter = "";
        _breadcrumbs = BuildBreadcrumbs();
        _continuationToken = null;
        _items.Clear();
        _selectedBlobs.Clear();
        await SelectedBlobChanged.InvokeAsync(null);
        await LoadPageAsync(reset: true);
    }

    private async Task LoadPageAsync(bool reset = false)
    {
        _loading = true;
        _errorMessage = null;
        if (reset) await InvokeAsync(StateHasChanged);

        try
        {
            var page = await Client.ListBlobsAsync(ContainerName, _prefix, reset ? null : _continuationToken);
            if (reset)
                _items = new List<StorageBlobItem>(page.Items);
            else
                _items.AddRange(page.Items);
            _continuationToken = page.ContinuationToken;
            _hasMore = page.ContinuationToken is not null;
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadMoreAsync() => await LoadPageAsync(reset: false);

    private List<(string Label, string Prefix)> BuildBreadcrumbs()
    {
        var crumbs = new List<(string, string)> { (ContainerName, "") };
        if (!string.IsNullOrEmpty(_prefix))
        {
            var accumulated = string.Empty;
            foreach (var segment in _prefix.TrimEnd('/').Split('/'))
            {
                accumulated += segment + "/";
                crumbs.Add((segment, accumulated));
            }
        }
        return crumbs;
    }

    private string GetDisplayName(string fullName)
    {
        var rel = fullName.StartsWith(_prefix) ? fullName.Substring(_prefix.Length) : fullName;
        rel = rel.TrimEnd('/');
        var lastSlash = rel.LastIndexOf('/');
        return lastSlash >= 0 ? rel.Substring(lastSlash + 1) : rel;
    }

    private static string FormatSize(long? bytes)
    {
        if (bytes is null) return string.Empty;
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1_048_576) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1_073_741_824) return $"{bytes / 1_048_576.0:F1} MB";
        return $"{bytes / 1_073_741_824.0:F2} GB";
    }

    private void OnRowContextMenu(MouseEventArgs e, StorageBlobItem item)
    {
        if (item.IsPrefix) return;
        _ctxItem = item;
        _ctxMenu.Show(e.ClientX, e.ClientY);
    }

    private async Task OnRowClickAsync(StorageBlobItem item)
    {
        if (item.IsPrefix)
            await NavigateToFolderAsync(item.Name);
        else
            await SelectedBlobChanged.InvokeAsync(item);
    }

    private async Task HandleBlobKeyDown(KeyboardEventArgs e)
    {
        _preventBlobKey = e.Key is "ArrowUp" or "ArrowDown" or "Escape" or "Enter";
        switch (e.Key)
        {
            case "ArrowDown":
                SelectBlobRelative(+1);
                break;
            case "ArrowUp":
                SelectBlobRelative(-1);
                break;
            case "Escape":
                await SelectedBlobChanged.InvokeAsync(null);
                break;
            case "Enter":
                if (SelectedBlob is not null)
                {
                    await OnRowClickAsync(SelectedBlob);
                }
                else
                {
                    var firstBlob = _items.FirstOrDefault(i => !i.IsPrefix);
                    if (firstBlob is not null)
                        await SelectedBlobChanged.InvokeAsync(firstBlob);
                }
                break;
        }
    }

    private void SelectBlobRelative(int delta)
    {
        if (_items.Count == 0) return;
        var currentIdx = SelectedBlob is null
            ? -1
            : _items.FindIndex(i => !i.IsPrefix && i.Name == SelectedBlob.Name);
        var newIdx = Math.Max(0, Math.Min(currentIdx + delta, _items.Count - 1));
        var item = _items[newIdx];
        _ = OnRowClickAsync(item);
    }

    private async Task CopyUrlAsync(StorageBlobItem item)
    {
        var url = $"https://{Client.Config.AccountName}.blob.core.windows.net/{ContainerName}/{item.Name}";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            Notifications.ShowSuccess("Copied!");
            _actionOk = true;
            _actionMessage = "URL copied to clipboard.";
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _actionOk = false;
            _actionMessage = $"Copy failed: {ex.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CopyRelativePathAsync(StorageBlobItem item)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", item.Name);
            Notifications.ShowSuccess("Copied!");
            _actionOk = true;
            _actionMessage = "Path copied to clipboard.";
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _actionOk = false;
            _actionMessage = $"Copy failed: {ex.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    private static string FormatExpiry(TimeSpan expiry)
    {
        if (expiry.TotalHours < 24) return $"{(int)expiry.TotalHours} hour(s)";
        return $"{(int)expiry.TotalDays} day(s)";
    }

    private async Task CopySasWithExpiryAsync(StorageBlobItem item, TimeSpan expiry)
    {
        try
        {
            var url = await Client.GetBlobSasUrlAsync(ContainerName, item.Name, expiry);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _actionOk = true;
            _actionMessage = $"SAS URL copied (expires in {FormatExpiry(expiry)}).";
            Notifications.ShowSuccess("SAS URL copied", $"Expires in {FormatExpiry(expiry)}");
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _actionOk = false;
            _actionMessage = $"SAS copy failed: {ex.Message}";
            Notifications.ShowError("Failed to copy SAS URL", ex: ex);
        }
        await InvokeAsync(StateHasChanged);
    }

    private void ShowCustomSasDialog(StorageBlobItem item)
    {
        _customSasItem = item;
        _customSasHours = 1;
        _showCustomSasDialog = true;
    }

    private async Task ApplyCustomSasAsync()
    {
        _showCustomSasDialog = false;
        if (_customSasItem is not null && _customSasHours > 0)
            await CopySasWithExpiryAsync(_customSasItem, TimeSpan.FromHours(_customSasHours));
    }

    private async Task DownloadAsync(StorageBlobItem item)
    {
        if (_downloadState is not null)
            return;

        var destPath = BuildDownloadPath(item.Name);
        var downloadState = new DownloadUiState
        {
            BlobName = item.Name,
            DestinationPath = destPath,
            TotalBytes = item.SizeBytes > 0 ? item.SizeBytes : null,
            BytesTransferred = 0
        };

        try
        {
            _downloadState = downloadState;
            _actionMessage = null;
            _lastDownloadUiBytes = -1;
            _lastDownloadUiUpdate = DateTimeOffset.MinValue;
            await InvokeAsync(StateHasChanged);

            var progress = new Progress<long>(bytes => ReportDownloadProgress(downloadState, bytes));
            await using var fs = System.IO.File.Create(destPath);
            await Client.DownloadBlobAsync(ContainerName, item.Name, fs, progress: progress);
            _actionOk = true;
            _actionMessage = $"Downloaded to: {destPath}";
            Notifications.ShowSuccess("Blob downloaded", System.IO.Path.GetFileName(destPath));
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _actionOk = false;
            _actionMessage = $"Download failed: {ex.Message}";
            Notifications.ShowError("Download failed", ex: ex);
        }
        finally
        {
            _downloadState = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private static string BuildDownloadPath(string blobName)
    {
        var fileName = System.IO.Path.GetFileName(blobName.TrimEnd('/'));
        if (string.IsNullOrWhiteSpace(fileName))
            fileName = blobName.Replace('/', '_');

        foreach (var invalidChar in System.IO.Path.GetInvalidFileNameChars())
            fileName = fileName.Replace(invalidChar, '_');

        var downloadsPath = System.IO.Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
            "Downloads");
        Directory.CreateDirectory(downloadsPath);
        return System.IO.Path.Combine(downloadsPath, fileName);
    }

    private void ReportDownloadProgress(DownloadUiState state, long bytesTransferred)
    {
        state.BytesTransferred = bytesTransferred;

        if (!ShouldRefreshDownloadUi(state))
            return;

        _ = InvokeAsync(StateHasChanged);
    }

    private bool ShouldRefreshDownloadUi(DownloadUiState state)
    {
        if (state.BytesTransferred == _lastDownloadUiBytes)
            return false;

        var now = DateTimeOffset.UtcNow;
        var isComplete = state.TotalBytes is long total && total > 0 && state.BytesTransferred >= total;
        if (!isComplete && now - _lastDownloadUiUpdate < TimeSpan.FromMilliseconds(125))
            return false;

        _lastDownloadUiBytes = state.BytesTransferred;
        _lastDownloadUiUpdate = now;
        return true;
    }

    private static bool TryGetDownloadPercent(DownloadUiState state, out double percent)
    {
        if (state.TotalBytes is not long total || total <= 0)
        {
            percent = 0;
            return false;
        }

        percent = Math.Clamp((double)state.BytesTransferred / total * 100d, 0d, 100d);
        return true;
    }

    private static string FormatDownloadProgress(DownloadUiState state)
    {
        var transferred = FormatSize(state.BytesTransferred);
        if (state.TotalBytes is not long total || total <= 0)
            return transferred;

        return $"{transferred} / {FormatSize(total)}";
    }
}