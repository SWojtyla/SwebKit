@inject IJSRuntime JS
@inject INotificationService Notifications
@using System.Text.Json
@using SwebKit.Azure.Storage

<div style="display:flex; flex-direction:column; height:100%; overflow:hidden;">

    @if (_loadingProperties && _properties is null)
    {
        <div style="display:flex; justify-content:center; padding:20px;">
            <FluentProgressRing />
        </div>
    }
    else if (_propertiesError is not null)
    {
        <div style="padding:12px; font-size:12px; color:var(--color-error);">@_propertiesError</div>
    }
    else if (_properties is not null)
    {
        @* ── Tab bar ── *@
        <div style="display:flex; border-bottom:1px solid var(--color-border); flex-shrink:0;">
            <button
            style="padding:8px 16px; font-size:12px; font-weight:600; border:none; cursor:pointer; background:@(_activeTab == "properties" ? "var(--color-surface)" : "transparent"); color:@(_activeTab == "properties" ? "var(--color-accent)" : "var(--color-text-muted)"); border-bottom:@(_activeTab == "properties" ? "2px solid var(--color-accent)" : "2px solid transparent");"
            @onclick='() => _activeTab = "properties"'>Properties</button>
            <button
            style="padding:8px 16px; font-size:12px; font-weight:600; border:none; cursor:pointer; background:@(_activeTab == "versions" ? "var(--color-surface)" : "transparent"); color:@(_activeTab == "versions" ? "var(--color-accent)" : "var(--color-text-muted)"); border-bottom:@(_activeTab == "versions" ? "2px solid var(--color-accent)" : "2px solid transparent");"
            @onclick="SelectVersionsTabAsync">Versions</button>
        </div>

        @if (_downloadState is not null)
        {
            <div style="padding:10px 16px; border-bottom:1px solid var(--color-border); background:rgba(0,120,212,0.06);">
                <div
                    style="display:flex; align-items:center; justify-content:space-between; gap:8px; font-size:12px; margin-bottom:6px;">
                    <span
                    style="font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@_downloadState.Label</span>
                    <span
                    style="color:var(--color-text-muted); white-space:nowrap;">@FormatDownloadProgress(_downloadState)</span>
                </div>
                @if (TryGetDownloadPercent(_downloadState, out var downloadPercent))
                {
                    <div style="height:6px; border-radius:999px; overflow:hidden; background:rgba(127,127,127,0.16);">
                        <div style="height:100%; width:@($"{downloadPercent:F1}%"); background:var(--color-accent);"></div>
                    </div>
                }
                else
                {
                    <div style="display:flex; align-items:center; gap:8px; color:var(--color-text-muted); font-size:11px;">
                        <FluentProgressRing Width="14px" Height="14px" />
                        <span>Waiting for total size…</span>
                    </div>
                }
            </div>
        }

        @if (_actionMessage is not null)
        {
            <div
                style="padding:8px 16px; border-bottom:1px solid var(--color-border); font-size:12px; color:@(_actionOk ? "var(--color-success)" : "var(--color-error)");">
                @_actionMessage
            </div>
        }

        @if (_activeTab == "properties")
        {
            <div style="overflow-y:auto; flex:1; padding:16px;">

                @* ── Action bar ── *@
                <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; align-items:center;">
                    <FluentButton Appearance="Appearance.Accent" Disabled="@(_downloadState is not null)"
                                  @onclick="DownloadAsync">@(_downloadState is null ? "Download" : "Downloading...")</FluentButton>
                    <FluentButton Appearance="Appearance.Lightweight" @onclick="CopyUrlAsync">Copy URL</FluentButton>
                    <FluentButton Appearance="Appearance.Lightweight" @onclick="CopySasAsync">Copy SAS URL</FluentButton>
                </div>

                @* ── Properties table ── *@
                <div
                    style="font-size:11px; font-weight:600; color:var(--color-text-muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">
                    Properties</div>
                    <table style="width:100%; border-collapse:collapse; margin-bottom:16px;">
                        @foreach (var row in GetPropertyRows(_properties))
                        {
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td
                                    style="padding:5px 8px; color:var(--color-text-muted); width:160px; white-space:nowrap; font-size:12px; vertical-align:top;">
                                    @row.Key</td>
                                    <td style="padding:5px 8px; font-size:12px; word-break:break-all;">@row.Value</td>
                                </tr>
                            }
                        </table>

                        @* ── Metadata ── *@
                        <div style="margin-bottom:12px;">
                            <button
                                style="background:none; border:none; cursor:pointer; font-size:12px; font-weight:600; color:var(--color-text-muted); text-transform:uppercase; letter-spacing:0.5px; padding:4px 0; display:flex; align-items:center; gap:6px;"
                                @onclick="() => _showMetadata = !_showMetadata">
                                <span>@(_showMetadata ? "▼" : "▶")</span> Metadata
                            </button>
                            @if (_showMetadata)
                            {
                                <div style="margin-top:6px; padding-left:12px;">
                                    @if (_properties.Metadata.Count == 0)
                                    {
                                        <div style="font-size:12px; color:var(--color-text-muted);">No metadata.</div>
                                    }
                                    else
                                    {
                                        <table style="width:100%; border-collapse:collapse;">
                                            @foreach (var kv in _properties.Metadata)
                                            {
                                                <tr style="border-bottom:1px solid var(--color-border);">
                                                    <td
                                                        style="padding:5px 8px; color:var(--color-text-muted); width:160px; font-size:12px; white-space:nowrap; vertical-align:top;">
                                                        @kv.Key</td>
                                                        <td style="padding:5px 8px; font-size:12px; word-break:break-all;">@kv.Value</td>
                                                    </tr>
                                                }
                                            </table>
                                        }
                                    </div>
                                }
                            </div>

                            @* ── Tags ── *@
                            <div style="margin-bottom:16px;">
                                <button
                                    style="background:none; border:none; cursor:pointer; font-size:12px; font-weight:600; color:var(--color-text-muted); text-transform:uppercase; letter-spacing:0.5px; padding:4px 0; display:flex; align-items:center; gap:6px;"
                                    @onclick="() => _showTags = !_showTags">
                                    <span>@(_showTags ? "▼" : "▶")</span> Tags
                                </button>
                                @if (_showTags)
                                {
                                    <div style="margin-top:6px; padding-left:12px;">
                                        @if (_properties.Tags.Count == 0)
                                        {
                                            <div style="font-size:12px; color:var(--color-text-muted);">No tags.</div>
                                        }
                                        else
                                        {
                                            <table style="width:100%; border-collapse:collapse;">
                                                @foreach (var kv in _properties.Tags)
                                                {
                                                    <tr style="border-bottom:1px solid var(--color-border);">
                                                        <td
                                                            style="padding:5px 8px; color:var(--color-text-muted); width:160px; font-size:12px; white-space:nowrap; vertical-align:top;">
                                                            @kv.Key</td>
                                                            <td style="padding:5px 8px; font-size:12px; word-break:break-all;">@kv.Value</td>
                                                        </tr>
                                                    }
                                                </table>
                                            }
                                        </div>
                                    }
                                </div>

                                @* ── Content preview ── *@
                                <div
                                    style="font-size:11px; font-weight:600; color:var(--color-text-muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px;">
                                    Content Preview</div>

                                    @if (_loadingContent)
                                    {
                                        <div style="display:flex; justify-content:center; padding:12px;">
                                            <FluentProgressRing />
                                        </div>
                                    }
                                    else if (_content is null)
                                    {
                                        <div style="font-size:12px; color:var(--color-text-muted);">Loading content...</div>
                                    }
                                    else if (_content.IsBinary || _binaryOverride)
                                    {
                                        <div style="padding:10px; background:var(--color-surface); border:1px solid var(--color-border); border-radius:4px; font-size:12px; color:var(--color-text-muted);"
                                             title="@_binaryDetectionMethod">
                                            Binary content — use Download to inspect this blob. @if (_binaryDetectionMethod is not null) {
                                            <span
                                            style="font-size:10px; color:var(--color-text-muted);">(@_binaryDetectionMethod)</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @if (_content.WasTruncated && _content.TotalSizeBytes > 2_097_152)
                                    {
                                        <div
                                            style="padding:8px 10px; background:rgba(0,120,212,0.1); border:1px solid var(--color-border); border-radius:4px; font-size:12px; color:var(--color-text-muted); margin-bottom:8px;">
                                            Preview limited to 512 KB. Download for full content.
                                        </div>
                                    }
                                    else if (_content.WasTruncated)
                                    {
                                        <div
                                            style="padding:8px 10px; background:rgba(255,193,7,0.15); border:1px solid var(--color-border); border-radius:4px; font-size:12px; color:var(--color-text-muted); margin-bottom:8px; display:flex; align-items:center; gap:8px;">
                                            <span>This blob is @FormatSize(_content.TotalSizeBytes). Load full preview?</span>
                                            <FluentButton Appearance="Appearance.Lightweight" Disabled="@_loadingContent"
                                                          @onclick="LoadFullPreviewAsync">Load</FluentButton>
                                        </div>
                                    }
                                    <div style="display:flex; justify-content:flex-end; margin-bottom:4px;">
                                        <FluentButton Appearance="Appearance.Lightweight" @onclick="CopyContentAsync">Copy content</FluentButton>
                                    </div>
                                    <pre
                                    style="overflow:auto; max-height:400px; font-size:11px; font-family:Consolas,monospace; white-space:pre-wrap; word-break:break-all; background:var(--color-surface); border:1px solid var(--color-border); border-radius:4px; padding:10px; margin:0;">@_displayContent</pre>
                                }

                            </div>
                        }
        else
                        @* versions tab *@
                        {
                            <div style="overflow-y:auto; flex:1; padding:16px;">
                                @if (_loadingVersions)
                                {
                                    <div style="display:flex; justify-content:center; padding:20px;">
                                        <FluentProgressRing />
                                    </div>
                                }
                                else if (_versionsError is not null)
                                {
                                    <div style="padding:12px; font-size:12px; color:var(--color-text-muted);">@_versionsError</div>
                                }
                                else if (_versions is not null && _versions.Count > 0)
                                {
                                    <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                        <thead>
                                            <tr style="border-bottom:1px solid var(--color-border);">
                                                <th style="padding:6px 8px; text-align:left; font-weight:600; color:var(--color-text-muted);">
                                                    Version ID</th>
                                                    <th style="padding:6px 8px; text-align:left; font-weight:600; color:var(--color-text-muted);">
                                                        Created</th>
                                                        <th style="padding:6px 8px; text-align:right; font-weight:600; color:var(--color-text-muted);">Size
                                                        </th>
                                                        <th style="padding:6px 8px; text-align:center; font-weight:600; color:var(--color-text-muted);">
                                                            Current</th>
                                                            <th style="padding:6px 8px; width:80px;"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var v in _versions)
                                                        {
                                                            <tr style="border-bottom:1px solid var(--color-border);">
                                                                <td style="padding:5px 8px; font-size:11px; font-family:Consolas,monospace; max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                                                    title="@v.VersionId">@v.VersionId</td>
                                                                <td style="padding:5px 8px; white-space:nowrap;">@(v.CreatedOn?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                                                </td>
                                                                <td style="padding:5px 8px; text-align:right; white-space:nowrap;">@FormatSize(v.ContentLength ?? 0)
                                                                </td>
                                                                <td style="padding:5px 8px; text-align:center;">@(v.IsCurrentVersion ? "✔" : "")</td>
                                                                <td style="padding:5px 8px;">
                                                                    <FluentButton Appearance="Appearance.Lightweight" Disabled="@(_downloadState is not null)"
                                                                                  @onclick="() => DownloadVersionAsync(v)">@(IsDownloadingVersion(v) ? "Downloading..." : "⬇")
                                                                    </FluentButton>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                else
                                            {
                                                <div style="padding:12px; font-size:12px; color:var(--color-text-muted);">Versioning is not enabled on this
                                                    container.</div>
                                                }
                                            </div>
                                        }
                                    }

                                </div>

@code {
    [Parameter, EditorRequired] public IStorageClient Client { get; set; } = default!;
    [Parameter, EditorRequired] public string ContainerName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public StorageBlobItem Blob { get; set; } = default!;

    private BlobProperties? _properties;
    private StorageBlobContent? _content;
    private string? _displayContent;
    private bool _loadingProperties;
    private bool _loadingContent;
    private string? _propertiesError;
    private string? _actionMessage;
    private bool _actionOk;
    private bool _showMetadata;
    private bool _showTags;
    private string? _loadedBlobName;

    // STG-6: Versions tab
    private string _activeTab = "properties";
    private IReadOnlyList<BlobVersionItem>? _versions;
    private bool _loadingVersions;
    private string? _versionsError;

    // STG-7: Binary detection override
    private bool _binaryOverride;
    private string? _binaryDetectionMethod;

    private DownloadUiState? _downloadState;
    private long _lastDownloadUiBytes = -1;
    private DateTimeOffset _lastDownloadUiUpdate = DateTimeOffset.MinValue;

    private sealed class DownloadUiState
    {
        public required string Label { get; init; }
        public required string DestinationPath { get; init; }
        public string? VersionId { get; init; }
        public long? TotalBytes { get; init; }
        public long BytesTransferred { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedBlobName == Blob.Name)
            return;

        _loadedBlobName = Blob.Name;
        _properties = null;
        _content = null;
        _displayContent = null;
        _propertiesError = null;
        _actionMessage = null;
        _showMetadata = false;
        _showTags = false;
        _loadingProperties = true;
        _loadingContent = true;
        _activeTab = "properties";
        _versions = null;
        _versionsError = null;
        _binaryOverride = false;
        _binaryDetectionMethod = null;

        await InvokeAsync(StateHasChanged);
        await Task.WhenAll(LoadPropertiesAsync(), LoadContentAsync(524_288));
    }

    private async Task LoadPropertiesAsync()
    {
        try
        {
            _properties = await Client.GetBlobPropertiesAsync(ContainerName, Blob.Name);
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _propertiesError = ex.Message;
        }
        finally
        {
            _loadingProperties = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadContentAsync(int maxBytes)
    {
        try
        {
            var raw = await Client.GetBlobContentAsync(ContainerName, Blob.Name, maxBytes);
            _content = raw;

            // STG-7: Binary detection via magic bytes
            _binaryOverride = false;
            _binaryDetectionMethod = null;
            if (raw.IsBinary)
            {
                _binaryDetectionMethod = "Detected by content-type";
            }
            else if (!string.IsNullOrEmpty(raw.Content))
            {
                var sampleBytes = System.Text.Encoding.UTF8.GetBytes(
                    raw.Content.Length > 512 ? raw.Content[..512] : raw.Content);
                if (BinaryContentDetector.IsBinary(sampleBytes))
                {
                    _binaryOverride = true;
                    _binaryDetectionMethod = "Detected by magic bytes analysis";
                }
            }

            _displayContent = BuildDisplayContent(raw);
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _content = new StorageBlobContent(ContainerName, Blob.Name, $"Error: {ex.Message}", null, 0, false, false);
            _displayContent = _content.Content;
        }
        finally
        {
            _loadingContent = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadFullPreviewAsync()
    {
        _loadingContent = true;
        _content = null;
        await InvokeAsync(StateHasChanged);
        await LoadContentAsync(2_097_152);
    }

    private async Task SelectVersionsTabAsync()
    {
        _activeTab = "versions";
        if (_versions is null && !_loadingVersions)
            await LoadVersionsAsync();
    }

    private async Task LoadVersionsAsync()
    {
        _loadingVersions = true;
        _versionsError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            _versions = await Client.ListBlobVersionsAsync(ContainerName, Blob.Name);
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _versionsError = "Versioning is not enabled on this container.";
            _versions = [];
            _ = ex; // consumed
        }
        finally
        {
            _loadingVersions = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadVersionAsync(BlobVersionItem version)
    {
        if (_downloadState is not null)
            return;

        var destPath = BuildDownloadPath(Blob.Name, version.VersionId);
        var label = $"Downloading version {ShortVersionId(version.VersionId)}";
        var downloadState = new DownloadUiState
        {
            Label = label,
            DestinationPath = destPath,
            VersionId = version.VersionId,
            TotalBytes = version.ContentLength > 0 ? version.ContentLength : null,
            BytesTransferred = 0
        };

        try
        {
            _downloadState = downloadState;
            _actionMessage = null;
            _lastDownloadUiBytes = -1;
            _lastDownloadUiUpdate = DateTimeOffset.MinValue;
            await InvokeAsync(StateHasChanged);

            var progress = new Progress<long>(bytes => ReportDownloadProgress(downloadState, bytes));
            await using var fs = System.IO.File.Create(destPath);
            await Client.DownloadBlobAsync(ContainerName, Blob.Name, fs, progress: progress, versionId: version.VersionId);
            _actionOk = true;
            _actionMessage = $"Downloaded version to: {destPath}";
            Notifications.ShowSuccess("Version downloaded", System.IO.Path.GetFileName(destPath));
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _actionOk = false;
            _actionMessage = $"Download failed: {ex.Message}";
            Notifications.ShowError("Download failed", ex: ex);
        }
        finally
        {
            _downloadState = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private static string BuildDisplayContent(StorageBlobContent content)
    {
        if (content.IsBinary) return string.Empty;
        var isJson = content.ContentType?.StartsWith("application/json") == true
        || content.BlobName.EndsWith(".json", StringComparison.OrdinalIgnoreCase);
        if (isJson)
        {
            try
            {
                var elem = JsonSerializer.Deserialize<JsonElement>(content.Content);
                return JsonSerializer.Serialize(elem, new JsonSerializerOptions { WriteIndented = true });
            }
            catch { }
        }
        return content.Content;
    }

    private static IEnumerable<KeyValuePair<string, string>> GetPropertyRows(BlobProperties p)
    {
        yield return new("Name", p.Name);
        yield return new("Size", FormatSize(p.SizeBytes));
        yield return new("Content-Type", p.ContentType);
        yield return new("ETag", p.ETag);
        yield return new("Last Modified", p.LastModified.ToString("yyyy-MM-dd HH:mm:ss zzz"));
        if (p.AccessTier is not null) yield return new("Access Tier", p.AccessTier);
        if (p.AccessTierInferred is not null) yield return new("Tier Inferred", p.AccessTierInferred.Value.ToString());
        if (p.LeaseStatus is not null) yield return new("Lease Status", p.LeaseStatus);
        if (p.LeaseState is not null) yield return new("Lease State", p.LeaseState);
        if (p.ContentEncoding is not null) yield return new("Content-Encoding", p.ContentEncoding);
        if (p.ContentLanguage is not null) yield return new("Content-Language", p.ContentLanguage);
        if (p.CacheControl is not null) yield return new("Cache-Control", p.CacheControl);
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1_048_576) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1_073_741_824) return $"{bytes / 1_048_576.0:F1} MB";
        return $"{bytes / 1_073_741_824.0:F2} GB";
    }

    private async Task CopyUrlAsync()
    {
        var url = $"https://{Client.Config.AccountName}.blob.core.windows.net/{ContainerName}/{Blob.Name}";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            Notifications.ShowSuccess("Copied!");
            _actionOk = true;
            _actionMessage = "URL copied.";
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _actionOk = false;
            _actionMessage = $"Copy failed: {ex.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CopySasAsync()
    {
        try
        {
            var url = await Client.GetBlobSasUrlAsync(ContainerName, Blob.Name, TimeSpan.FromHours(24));
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _actionOk = true;
            _actionMessage = "SAS URL copied (expires 24 h).";
            Notifications.ShowSuccess("SAS URL copied", "Expires in 24 hours");
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _actionOk = false;
            _actionMessage = $"SAS failed: {ex.Message}";
            Notifications.ShowError("Failed to copy SAS URL", ex: ex);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CopyContentAsync()
    {
        if (_displayContent is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _displayContent);
            Notifications.ShowSuccess("Copied!");
            _actionOk = true;
            _actionMessage = "Content copied.";
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _actionOk = false;
            _actionMessage = $"Copy failed: {ex.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadAsync()
    {
        if (_downloadState is not null)
            return;

        var totalBytes = _properties?.SizeBytes > 0 ? _properties.SizeBytes : Blob.SizeBytes;
        var destPath = BuildDownloadPath(Blob.Name);
        var downloadState = new DownloadUiState
        {
            Label = $"Downloading {System.IO.Path.GetFileName(destPath)}",
            DestinationPath = destPath,
            TotalBytes = totalBytes > 0 ? totalBytes : null,
            BytesTransferred = 0
        };

        try
        {
            _downloadState = downloadState;
            _actionMessage = null;
            _lastDownloadUiBytes = -1;
            _lastDownloadUiUpdate = DateTimeOffset.MinValue;
            await InvokeAsync(StateHasChanged);

            var progress = new Progress<long>(bytes => ReportDownloadProgress(downloadState, bytes));
            await using var fs = System.IO.File.Create(destPath);
            await Client.DownloadBlobAsync(ContainerName, Blob.Name, fs, progress: progress);
            _actionOk = true;
            _actionMessage = $"Downloaded to: {destPath}";
            Notifications.ShowSuccess("Blob downloaded", System.IO.Path.GetFileName(destPath));
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _actionOk = false;
            _actionMessage = $"Download failed: {ex.Message}";
            Notifications.ShowError("Download failed", ex: ex);
        }
        finally
        {
            _downloadState = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private static string BuildDownloadPath(string blobName, string? versionId = null)
    {
        var baseName = System.IO.Path.GetFileName(blobName.TrimEnd('/'));
        if (string.IsNullOrWhiteSpace(baseName))
            baseName = blobName.Replace('/', '_');

        var extension = System.IO.Path.GetExtension(baseName);
        var stem = string.IsNullOrEmpty(extension)
            ? baseName
            : baseName[..^extension.Length];

        if (!string.IsNullOrWhiteSpace(versionId))
            stem = $"{stem}_{SanitizeFileNameSegment(versionId)}";

        var fileName = SanitizeFileNameSegment(stem) + extension;
        var downloadsPath = System.IO.Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
            "Downloads");
        Directory.CreateDirectory(downloadsPath);
        return System.IO.Path.Combine(downloadsPath, fileName);
    }

    private static string SanitizeFileNameSegment(string value)
    {
        var sanitized = value;
        foreach (var invalidChar in System.IO.Path.GetInvalidFileNameChars())
            sanitized = sanitized.Replace(invalidChar, '_');
        return sanitized;
    }

    private void ReportDownloadProgress(DownloadUiState state, long bytesTransferred)
    {
        state.BytesTransferred = bytesTransferred;

        if (!ShouldRefreshDownloadUi(state))
            return;

        _ = InvokeAsync(StateHasChanged);
    }

    private bool ShouldRefreshDownloadUi(DownloadUiState state)
    {
        if (state.BytesTransferred == _lastDownloadUiBytes)
            return false;

        var now = DateTimeOffset.UtcNow;
        var isComplete = state.TotalBytes is long total && total > 0 && state.BytesTransferred >= total;
        if (!isComplete && now - _lastDownloadUiUpdate < TimeSpan.FromMilliseconds(125))
            return false;

        _lastDownloadUiBytes = state.BytesTransferred;
        _lastDownloadUiUpdate = now;
        return true;
    }

    private static bool TryGetDownloadPercent(DownloadUiState state, out double percent)
    {
        if (state.TotalBytes is not long total || total <= 0)
        {
            percent = 0;
            return false;
        }

        percent = Math.Clamp((double)state.BytesTransferred / total * 100d, 0d, 100d);
        return true;
    }

    private static string FormatDownloadProgress(DownloadUiState state)
    {
        var transferred = FormatSize(state.BytesTransferred);
        if (state.TotalBytes is not long total || total <= 0)
            return transferred;

        return $"{transferred} / {FormatSize(total)}";
    }

    private bool IsDownloadingVersion(BlobVersionItem version) =>
        _downloadState is not null && string.Equals(_downloadState.VersionId, version.VersionId, StringComparison.Ordinal);

    private static string ShortVersionId(string versionId)
    {
        if (string.IsNullOrWhiteSpace(versionId))
            return "current blob";

        return versionId.Length <= 16 ? versionId : versionId[..16];
    }
}