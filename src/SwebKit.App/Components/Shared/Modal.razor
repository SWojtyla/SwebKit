@* Full-screen backdrop modal. Click backdrop to close; click content area does not close. *@
@inject IJSRuntime JS
@inject ILogger<Modal> Logger
@implements IAsyncDisposable

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="HandleBackdropClick">
        <div class="modal-container" @onclick:stopPropagation="true" @ref="_containerRef">
            @ChildContent
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Width { get; set; } = "520px";

    private ElementReference _containerRef;
    private bool _trapApplied;
    private bool _wasOpen;
    private IJSObjectReference? _savedFocusRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsOpen || _trapApplied) return;
        _trapApplied = true;
        try
        {
            _savedFocusRef = await JS.InvokeAsync<IJSObjectReference>("SwebKit.saveFocus");
            await JS.InvokeVoidAsync("SwebKit.trapFocus", _containerRef);
        }
        catch (Exception ex) { Logger.LogDebug(ex, "JS interop failed: {Method}", "SwebKit.trapFocus"); }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            if (_savedFocusRef is not null)
            {
                try { await JS.InvokeVoidAsync("SwebKit.restoreFocus", _savedFocusRef); }
                catch (Exception ex) { Logger.LogDebug(ex, "JS interop failed: {Method}", "SwebKit.restoreFocus"); }
                try { await _savedFocusRef.DisposeAsync(); }
                catch { }
                _savedFocusRef = null;
            }
        }

        if (!IsOpen) _trapApplied = false;
    }

    private async Task HandleBackdropClick() => await OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("SwebKit.releaseTrap", _containerRef); }
        catch (Exception ex) { Logger.LogDebug(ex, "JS interop failed: {Method}", "SwebKit.releaseTrap"); }
        if (_savedFocusRef is not null)
        {
            try { await _savedFocusRef.DisposeAsync(); }
            catch { }
        }
    }
}
