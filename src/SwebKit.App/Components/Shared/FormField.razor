<div class="@FieldClass">
    @if (HasLabel)
    {
        <label class="app-form-field__label" for="@LabelFor">
            <span>@Label</span>
            @if (Required)
            {
                <span class="app-form-field__required" aria-hidden="true">*</span>
            }
        </label>
    }

    <div class="app-form-field__control">
        @ChildContent
    </div>

    @if (HasHint)
    {
        <div id="@HintId" class="app-form-field__hint">@Hint</div>
    }

    @if (HasError)
    {
        <div id="@ErrorId" class="app-form-field__error" role="alert" aria-live="polite">@Error</div>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? For { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool HasLabel => !string.IsNullOrWhiteSpace(Label);
    private bool HasHint => !string.IsNullOrWhiteSpace(Hint);
    private bool HasError => !string.IsNullOrWhiteSpace(Error);

    private string? LabelFor => FirstNonEmpty(For, Id);
    private string? HintId => HasHint && !string.IsNullOrWhiteSpace(LabelFor) ? $"{LabelFor}-hint" : null;
    private string? ErrorId => HasError && !string.IsNullOrWhiteSpace(LabelFor) ? $"{LabelFor}-error" : null;

    private string FieldClass
    {
        get
        {
            var stateClasses = string.Join(' ', new[]
            {
                Required ? "app-form-field--required" : null,
                HasError ? "app-form-field--invalid" : null,
                CssClass
            }.Where(static cssClass => !string.IsNullOrWhiteSpace(cssClass)));

            return string.IsNullOrWhiteSpace(stateClasses)
                ? "app-form-field"
                : $"app-form-field {stateClasses}";
        }
    }

    private static string? FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(static value => !string.IsNullOrWhiteSpace(value));
}