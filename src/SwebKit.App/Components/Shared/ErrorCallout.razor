<div class="error-callout" role="alert">
    <div class="error-callout__copy">
        <strong class="error-callout__title">@(Title ?? "Error")</strong>
        <div class="error-callout__message">@Message</div>
        @if (Details is not null)
        {
            <details class="error-callout__details">
                <summary>Show details</summary>
                <div>@Details</div>
            </details>
        }
    </div>

    <div class="error-callout__actions">
        @if (OnRetry.HasDelegate)
        {
            <button class="error-callout-retry" disabled="@_retrying" @onclick="RetryAsync">
                @if (_retrying)
                {
                    <span>Retrying…</span>
                }
                else if (_attemptCount > 0)
                {
                    <span>Retry #@(_attemptCount + 1)</span>
                }
                else
                {
                    <span>Retry</span>
                }
            </button>
        }
        @if (OnDismiss.HasDelegate)
        {
            <button class="error-callout-dismiss" aria-label="Dismiss error"
                    @onclick="() => OnDismiss.InvokeAsync()">Dismiss</button>
        }
    </div>
</div>

@code {
    [Parameter] public string Message { get; set; } = "An error occurred.";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Details { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    private bool _retrying;
    private int _attemptCount;

    private async Task RetryAsync()
    {
        if (_retrying) return;
        _retrying = true;

        if (_attemptCount > 0)
        {
            var delayMs = Math.Min(1000 * (1 << (_attemptCount - 1)), 4000);
            await Task.Delay(delayMs);
        }

        try
        {
            await OnRetry.InvokeAsync();
        }
        finally
        {
            _attemptCount++;
            _retrying = false;
        }
    }
}
