<button @attributes="AdditionalAttributes"
        type="button"
        class="@ButtonClass"
        title="@ResolvedTitle"
        aria-label="@Label"
        aria-busy="@AriaBusy"
        disabled="@IsInteractionDisabled"
        @onclick="HandleClickAsync">
    @if (Loading)
    {
        <span class="app-icon-button__spinner" aria-hidden="true"></span>
    }
    else if (Icon is not null)
    {
        <span class="app-icon-button__icon" aria-hidden="true">@Icon</span>
    }
</button>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Variant { get; set; } = "Ghost";
    [Parameter] public string Size { get; set; } = "Medium";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsInteractionDisabled => Disabled || Loading;

    private string AriaBusy => Loading ? "true" : "false";

    private string ResolvedTitle => string.IsNullOrWhiteSpace(Title) ? Label! : Title!;

    private string ButtonClass
    {
        get
        {
            var variant = NormalizeVariant(Variant);
            var size = NormalizeSize(Size);
            var stateClasses = string.Join(' ', new[]
            {
                IsInteractionDisabled ? "app-icon-button--disabled" : null,
                Loading ? "app-icon-button--loading" : null,
                CssClass
            }.Where(static cssClass => !string.IsNullOrWhiteSpace(cssClass)));

            return string.IsNullOrWhiteSpace(stateClasses)
                ? $"app-icon-button app-icon-button--{variant} app-icon-button--{size}"
                : $"app-icon-button app-icon-button--{variant} app-icon-button--{size} {stateClasses}";
        }
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException("AppIconButton requires a non-empty Label for aria-label and title text.");
        }
    }

    private async Task HandleClickAsync(MouseEventArgs args)
    {
        if (IsInteractionDisabled)
        {
            return;
        }

        await OnClick.InvokeAsync(args);
    }

    private static string NormalizeVariant(string? variant)
        => variant?.Trim().ToLowerInvariant() switch
        {
            "subtle" => "subtle",
            "danger" => "danger",
            "primary" => "primary",
            _ => "ghost"
        };

    private static string NormalizeSize(string? size)
        => size?.Trim().ToLowerInvariant() switch
        {
            "small" => "small",
            _ => "medium"
        };
}