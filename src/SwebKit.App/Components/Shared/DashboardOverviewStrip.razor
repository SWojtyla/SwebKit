<section class="dashboard-overview-strip" aria-label="Dashboard overview">
    <div class="dashboard-overview-strip__lead">
        <div class="dashboard-overview-strip__copy">
            <div class="dashboard-overview-strip__heading">
                <span class="dashboard-overview-strip__eyebrow">Overview</span>
                <h2>@Title</h2>
            </div>
            <p>@Description</p>
        </div>

        <div class="dashboard-overview-strip__summary" aria-label="Dashboard summary">
            <article class="dashboard-overview-stat">
                <span>Attention</span>
                <strong>@AttentionCount</strong>
                <small>items worth checking now</small>
            </article>
            <article class="dashboard-overview-stat">
                <span>Widgets</span>
                <strong>@VisibleTileCount</strong>
                <small>visible on this view</small>
            </article>
            <article class="dashboard-overview-stat">
                <span>Resume</span>
                <strong>@ResumeCount</strong>
                <small>favorites and tabs ready</small>
            </article>
        </div>
    </div>

    <div class="dashboard-overview-strip__pills" aria-label="Dashboard scope and cadence">
        <span class="dashboard-overview-pill dashboard-overview-pill--accent">@Title</span>
        <span class="dashboard-overview-pill">@HomeModeLabel</span>
        <span class="dashboard-overview-pill">Area: @AreaLabel</span>
        <span class="dashboard-overview-pill">Focus: @FocusLabel</span>
        <span class="dashboard-overview-pill">Window: @TimeWindowLabel</span>
        <span class="dashboard-overview-pill">@ConnectedAreasCount connected areas</span>
        <span class="dashboard-overview-pill">@RefreshCadenceLabel</span>
        <span class="dashboard-overview-pill">@RecentResourceCount recent resource@(RecentResourceCount == 1 ?
                        string.Empty : "s")</span>
            @if (IsMonitoring)
            {
                <span class="dashboard-overview-pill dashboard-overview-pill--warning">@MonitoredNamespaceCount monitored
                    namespace@(MonitoredNamespaceCount == 1 ? string.Empty : "s")</span>
                }
            </div>

            @if (Controls is not null)
            {
                <section class="dashboard-overview-strip__section" aria-label="Dashboard controls">
                    @Controls
                </section>
            }

            @if (Actions is not null)
            {
                <div class="dashboard-overview-strip__section" aria-label="Dashboard actions">
                    @Actions
                </div>
            }
        </section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = "Live status, workspace resume, and fast drill-through shortcuts for the areas you use most.";
    [Parameter] public int AttentionCount { get; set; }
    [Parameter] public int VisibleTileCount { get; set; }
    [Parameter] public int ResumeCount { get; set; }
    [Parameter] public string HomeModeLabel { get; set; } = string.Empty;
    [Parameter] public string AreaLabel { get; set; } = string.Empty;
    [Parameter] public string FocusLabel { get; set; } = string.Empty;
    [Parameter] public string TimeWindowLabel { get; set; } = string.Empty;
    [Parameter] public int ConnectedAreasCount { get; set; }
    [Parameter] public string RefreshCadenceLabel { get; set; } = string.Empty;
    [Parameter] public int RecentResourceCount { get; set; }
    [Parameter] public bool IsMonitoring { get; set; }
    [Parameter] public int MonitoredNamespaceCount { get; set; }
    [Parameter] public RenderFragment? Controls { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
