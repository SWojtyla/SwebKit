@using SwebKit.App.Components.Layout

@if (ShowSupportingContent)
{
    <PageHeader Eyebrow="@ResolvedEyebrow" Title="@ResolvedTitle" Subtitle="@ResolvedSubtitle" Meta="@ResolvedMeta"
                Actions="@Actions" />
}
else if (Meta is not null || Actions is not null)
{
    <div class="page-support-strip">
        @if (Meta is not null)
        {
            <div class="page-support-strip__meta">@Meta</div>
        }

        @if (Actions is not null)
        {
            <div class="page-support-strip__actions">@Actions</div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public string Area { get; set; } = string.Empty;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Meta { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool ShowSupportingContent { get; set; }

    private ShellNavEntry Entry => ShellNavigation.ForArea(Area);
    private string ResolvedEyebrow => string.IsNullOrWhiteSpace(Eyebrow) ? Entry.Group : Eyebrow;
    private string ResolvedTitle => string.IsNullOrWhiteSpace(Title) ? Entry.Label : Title;
    private string? ResolvedSubtitle => Subtitle;
    private RenderFragment? ResolvedMeta => Meta;
}