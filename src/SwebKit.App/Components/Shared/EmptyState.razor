@* Displays a centred empty/placeholder state with an icon, title, and optional subtitle. *@

<div class="empty-state">
    <div class="empty-state-icon">
        @if (IconContent is not null)
        {
            @IconContent
        }
        else
        {
            @Icon
        }
    </div>
    <div class="empty-state-title">@Title</div>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <div class="empty-state-subtitle">@Subtitle</div>
    }
    @if (Actions is not null)
    {
        <div class="empty-state-actions">@Actions</div>
    }
</div>

@code {
    /// <summary>Emoji/text icon. Ignored when <see cref="IconContent"/> is supplied.</summary>
    [Parameter] public string Icon { get; set; } = "";
    /// <summary>Optional FluentIcon (or other markup) render fragment; takes precedence over <see cref="Icon"/>.</summary>
    [Parameter] public RenderFragment? IconContent { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
