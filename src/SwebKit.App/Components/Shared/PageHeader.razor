<header class="page-header page-header-shell">
    <div class="page-header-shell__copy">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <div class="page-eyebrow">@Eyebrow</div>
        }

        <div class="page-title-row">
            <h1 class="page-title">@Title</h1>
        </div>

        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="page-subtitle">@Subtitle</p>
        }

        @if (Meta is not null)
        {
            <div class="page-header-meta">@Meta</div>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="page-header-shell__actions">@Actions</div>
    }
</header>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Meta { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}