@if (ShouldRenderHeader)
{
    <header class="@HeaderClass">
        <div class="@CopyClass">
            @if (!string.IsNullOrWhiteSpace(Eyebrow))
            {
                <div class="page-eyebrow">@Eyebrow</div>
            }

            <div class="page-title-row">
                <h1 class="page-title">@Title</h1>
            </div>

            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="page-subtitle">@Subtitle</p>
            }

            @if (Meta is not null)
            {
                <div class="page-header-meta">@Meta</div>
            }
        </div>

        @if (Actions is not null)
        {
            <div class="page-header-shell__actions">@Actions</div>
        }
    </header>
}

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Meta { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool VisuallyHideCopy { get; set; }

    private bool ShouldRenderHeader => !VisuallyHideCopy || Actions is not null;

    private string HeaderClass => VisuallyHideCopy
        ? "page-header page-header-shell page-header-shell--context-hidden"
        : "page-header page-header-shell";

    private string CopyClass => VisuallyHideCopy
        ? "page-header-shell__copy visually-hidden"
        : "page-header-shell__copy";
}