<div style="display:flex; align-items:center; gap:10px; padding:16px; color:var(--color-text-muted); font-size:13px;">
    <FluentProgressRing Width="20px" />
    <span>@Message</span>
    @if (OnCancel.HasDelegate)
    {
        <button style="margin-left:8px; padding:2px 8px; font-size:11px; cursor:pointer;" @onclick="OnCancel">Cancel</button>
    }
</div>

@code {
    [Parameter] public string Message { get; set; } = "Loading...";
    [Parameter] public EventCallback OnCancel { get; set; }
}
