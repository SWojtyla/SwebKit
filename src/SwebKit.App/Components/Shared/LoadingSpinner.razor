@implements IDisposable

<div class="loading-state" role="status" aria-live="polite">
    <FluentProgressRing Width="20px" />
    <span class="loading-state__message">
        @if (_timedOut)
        {
            <span>Taking longer than expected…</span>
        }
        else
        {
            @Message
        }
    </span>
    @if (_timedOut && OnRetry.HasDelegate)
    {
        <button class="loading-state__button" @onclick="HandleRetry">Retry</button>
    }
    @if (OnCancel.HasDelegate)
    {
        <button class="loading-state__button" @onclick="OnCancel">Cancel</button>
    }
</div>

@code {
    [Parameter] public string Message { get; set; } = "Loading...";
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public TimeSpan Timeout { get; set; } = TimeSpan.FromSeconds(30);

    private bool _timedOut;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        _cts = new CancellationTokenSource();
        _ = StartTimeoutAsync(_cts.Token);
    }

    private async Task StartTimeoutAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(Timeout, ct);
            _timedOut = true;
            await InvokeAsync(StateHasChanged); // BL-2
        }
        catch (OperationCanceledException)
        {
            // Component disposed before timeout — expected
        }
    }

    private async Task HandleRetry()
    {
        _timedOut = false;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _ = StartTimeoutAsync(_cts.Token);
        await OnRetry.InvokeAsync();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
