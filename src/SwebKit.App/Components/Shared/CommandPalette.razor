@inject CommandRegistry Registry
@inject NavigationManager Nav
@inject IAppEventBus Events

<div class="command-palette-overlay" @onclick="Close">
    <div class="command-palette" @onclick:stopPropagation="true">
        <input type="text" placeholder="Type a command..." @bind-value="Query" @bind-value:event="oninput"
               @onkeydown="OnKeyDown" autofocus />
        <div>
            @{
                var results = Registry.Search(Query);
            }
            @if (!results.Any())
            {
                <div style="padding: 12px 16px; color: var(--color-text-muted); font-size: 12px;">No commands found</div>
            }
            @for (int i = 0; i < results.Count; i++)
            {
                var cmd = results[i];
                var idx = i;
                <div class="command-item @(idx == FocusedIndex ? "focused" : "")" @onclick="() => ExecuteAsync(cmd)">
                    @if (!string.IsNullOrEmpty(cmd.Category))
                    {
                        <span style="font-size: 10px; color: rgba(255,255,255,0.5); min-width: 80px;">@cmd.Category</span>
                    }
                    <span>@cmd.Label</span>
                    @if (!string.IsNullOrEmpty(cmd.Shortcut))
                    {
                        <span style="margin-left: auto; font-size: 10px; color: rgba(255,255,255,0.4);">@cmd.Shortcut</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string Query = "";
    private int FocusedIndex;

    private void Close() => OnClose.InvokeAsync();

    private async Task ExecuteAsync(AppCommand cmd)
    {
        await OnClose.InvokeAsync();
        await cmd.Execute();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        var results = Registry.Search(Query);
        switch (e.Key)
        {
            case "ArrowDown": FocusedIndex = Math.Min(FocusedIndex + 1, results.Count - 1); break;
            case "ArrowUp": FocusedIndex = Math.Max(FocusedIndex - 1, 0); break;
            case "Enter":
                if (FocusedIndex < results.Count) await ExecuteAsync(results[FocusedIndex]);
                break;
            case "Escape": await OnClose.InvokeAsync(); break;
        }
    }
}
