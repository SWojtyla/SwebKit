@inject CommandRegistry Registry
@inject IJSRuntime JS
@inject OperatorWorkspaceService Workspaces
@implements IAsyncDisposable

<div class="command-palette-overlay" @onclick="Close">
    <div class="command-palette" @onclick:stopPropagation="true" @ref="_paletteRef">

        <div class="cp-input-row">
            <span class="cp-search-icon">⌕</span>
            <input type="text" placeholder="Type a command or search…" value="@_query" @oninput="OnQueryInput"
                   @onkeydown="OnKeyDown" @ref="_inputRef" autofocus />
        </div>

        <div class="cp-results" @ref="_resultsRef">
            @{
                var sections = GetSections();
                var allItems = sections.SelectMany(s => s.Items).ToList();
                int renderIdx = 0;
            }
            @if (allItems.Count == 0 && !string.IsNullOrWhiteSpace(_query))
            {
                <div class="cp-empty">No commands match "<em>@_query</em>"</div>
            }
            @foreach (var grp in sections)
            {
                <div class="cp-section-header">@grp.Label</div>
                @foreach (var item in grp.Items)
                {
                    var idx = renderIdx++;
                    var itemCapture = item;
                    <div class="command-item @(idx == _focusedIndex ? "focused" : "")"
                         @onclick="() => ExecuteAsync(itemCapture)" @onmousemove="() => { _focusedIndex = idx; }">
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <span class="cp-cmd-icon">@item.Icon</span>
                        }
                        <div class="cp-cmd-body">
                            <span class="cp-cmd-label">@item.Label</span>
                            @if (!string.IsNullOrWhiteSpace(item.Summary))
                            {
                                <span class="cp-cmd-summary">@item.Summary</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(item.Shortcut))
                        {
                            <span class="cp-cmd-shortcut">
                                @foreach (var part in item.Shortcut.Split('+'))
                                {
                                    <kbd>@part.Trim()</kbd>
                                }
                            </span>
                        }
                    </div>
                }
            }
        </div>

        <div class="cp-footer">
            <span><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
            <span><kbd>↵</kbd> execute</span>
            <span><kbd>Esc</kbd> close</span>
        </div>

    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string? CurrentArea { get; set; }

    private sealed record PaletteItem(
        string Id,
        string Label,
        Func<Task> Execute,
        string? Icon = null,
        string? Shortcut = null,
        string? CommandId = null,
        string? Summary = null);

    private sealed record PaletteSection(string Label, IReadOnlyList<PaletteItem> Items);

    private string _query = "";
    private int _focusedIndex;
    private ElementReference _inputRef;
    private ElementReference _paletteRef;
    private ElementReference _resultsRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("SwebKit.trapFocus", _paletteRef); }
        catch { /* JS may not be ready in unit tests */ }
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task ExecuteAsync(PaletteItem item)
    {
        await OnClose.InvokeAsync();
        if (!string.IsNullOrWhiteSpace(item.CommandId))
        {
            await Registry.RecordUsedAsync(item.CommandId);
        }

        await item.Execute();
    }

    private void OnQueryInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _focusedIndex = 0;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        var allItems = GetSections().SelectMany(s => s.Items).ToList();

        switch (e.Key)
        {
            case "ArrowDown":
                _focusedIndex = allItems.Count == 0 ? 0 : (_focusedIndex + 1) % allItems.Count;
                await ScrollFocused();
                break;

            case "ArrowUp":
                _focusedIndex = allItems.Count == 0 ? 0 : (_focusedIndex - 1 + allItems.Count) % allItems.Count;
                await ScrollFocused();
                break;

            case "Enter":
                if (_focusedIndex < allItems.Count)
                    await ExecuteAsync(allItems[_focusedIndex]);
                break;

            case "Escape":
                await OnClose.InvokeAsync();
                break;
        }
    }

    private async Task ScrollFocused()
    {
        try { await JS.InvokeVoidAsync("SwebKit.scrollFocusedCommandIntoView"); }
        catch { }
    }

    private List<PaletteSection> GetSections()
    {
        var resourceOnlyMode = _query.StartsWith("go ", StringComparison.OrdinalIgnoreCase);
        var resourceQuery = resourceOnlyMode ? _query[3..].Trim() : _query.Trim();
        var available = Registry.GetAvailable(CurrentArea);
        var result = new List<PaletteSection>();

        if (string.IsNullOrWhiteSpace(resourceQuery))
        {
            var recentIds = Registry.RecentCommandIds;
            var recentCommands = recentIds
                .Select(id => available.FirstOrDefault(c => c.Id == id))
                .OfType<AppCommand>()
                .Select(CreateCommandItem)
                .ToList();

            if (recentCommands.Count > 0)
            {
                result.Add(new PaletteSection("Recent Commands", recentCommands));
            }

            var recentResources = Workspaces.GetRecentResources()
                .Select(entry => CreateSnapshotItem(entry.Snapshot, entry.AccessedAt.ToLocalTime().ToString("g")))
                .ToList();
            if (recentResources.Count > 0)
            {
                result.Add(new PaletteSection("Recent Resources", recentResources));
            }

            var favorites = Workspaces.GetFavoriteResources()
                .Select(favorite => CreateSnapshotItem(favorite.Snapshot, BuildResourceSummary(favorite.Snapshot)))
                .ToList();
            if (favorites.Count > 0)
            {
                result.Add(new PaletteSection("Favorites", favorites));
            }

            var workspaces = Workspaces.GetSavedWorkspaces()
                .Select(CreateWorkspaceItem)
                .ToList();
            if (workspaces.Count > 0)
            {
                result.Add(new PaletteSection("Workspaces", workspaces));
            }

            foreach (var group in available
                .Where(c => !recentIds.Contains(c.Id))
                .GroupBy(c => c.Category ?? "General")
                .OrderBy(g => CategoryOrder(g.Key)))
            {
                result.Add(new PaletteSection(group.Key, group.Select(CreateCommandItem).ToList()));
            }
        }
        else
        {
            var matchingResources = Workspaces.SearchResources(resourceQuery)
                .Select(snapshot => CreateSnapshotItem(snapshot, BuildResourceSummary(snapshot)))
                .ToList();
            if (matchingResources.Count > 0)
            {
                result.Add(new PaletteSection("Resources", matchingResources));
            }

            var matchingWorkspaces = Workspaces.SearchSavedWorkspaces(resourceQuery)
                .Select(CreateWorkspaceItem)
                .ToList();
            if (matchingWorkspaces.Count > 0)
            {
                result.Add(new PaletteSection("Workspaces", matchingWorkspaces));
            }

            if (!resourceOnlyMode)
            {
                var scoredCommands = available
                    .Select(command => (Command: command, Score: SearchScoring.FuzzyScore(resourceQuery, command.Label)))
                    .Where(candidate => candidate.Score > 0)
                    .OrderByDescending(candidate => candidate.Score)
                    .Select(candidate => candidate.Command)
                    .ToList();

                foreach (var group in scoredCommands
                    .GroupBy(command => command.Category ?? "General")
                    .OrderBy(group => CategoryOrder(group.Key)))
                {
                    result.Add(new PaletteSection(group.Key, group.Select(CreateCommandItem).ToList()));
                }
            }
        }

        return result;
    }

    private static PaletteItem CreateCommandItem(AppCommand command) => new(
        command.Id,
        command.Label,
        command.Execute,
        command.Icon,
        command.Shortcut,
        command.Id,
        command.Category);

    private PaletteItem CreateSnapshotItem(WorkspaceSnapshot snapshot, string? summary) => new(
        snapshot.Resource.Key,
        snapshot.Resource.DisplayPath ?? snapshot.Resource.DisplayName,
        () => Workspaces.OpenSnapshotAsync(snapshot, recordRecent: true),
        snapshot.Resource.Icon,
        null,
        null,
        summary);

    private PaletteItem CreateWorkspaceItem(SavedWorkspace workspace) => new(
        workspace.Id.ToString("N"),
        workspace.Name,
        () => Workspaces.OpenWorkspaceAsync(workspace.Id),
        workspace.Snapshot.Resource.Icon,
        null,
        null,
        workspace.Snapshot.Resource.DisplayPath ?? workspace.Snapshot.Resource.DisplayName);

    private static string BuildResourceSummary(WorkspaceSnapshot snapshot)
    {
        var areaLabel = SwebKit.App.Components.Layout.ShellNavigation.ForArea(snapshot.Resource.Area).Label;
        return string.IsNullOrWhiteSpace(snapshot.Resource.Summary)
            ? areaLabel
            : $"{areaLabel} | {snapshot.Resource.Summary}";
    }

    private static int CategoryOrder(string cat) => cat switch
    {
        "Navigation" => 0,
        "Actions" => 1,
        "General" => 2,
        _ => 99
    };

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("SwebKit.releaseTrap", _paletteRef); }
        catch { }
    }
}
