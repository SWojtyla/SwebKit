@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Visible)
{
    <div class="confirm-dialog-backdrop" @onkeydown="OnBackdropKeyDown">
        <div class="confirm-dialog" role="dialog" aria-modal="true" @ref="_dialogRef">
            @if (IsProduction)
            {
                <div class="confirm-dialog-production">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Width="16px" style="flex-shrink:0;" />
                    PRODUCTION — This action cannot be undone
                </div>
            }
            <h3 class="confirm-dialog-title">@Title</h3>
            <p class="confirm-dialog-message">@Message</p>

            @if (RequireTyping && IsProduction)
            {
                <div class="confirm-dialog-typing">
                    <p class="confirm-dialog-typing-copy">Type <strong>CONFIRM</strong> to proceed:</p>
                    <input type="text" @bind="TypingConfirm" class="confirm-dialog-input app-native-control" />
                </div>
            }

            <div class="confirm-dialog-actions">
                <button @onclick="Cancel" class="confirm-dialog-btn confirm-dialog-btn--secondary">Cancel</button>
                <button @onclick="Confirm" disabled="@IsConfirmDisabled"
                        class="confirm-dialog-btn confirm-dialog-btn--primary @(IsProduction ? "confirm-dialog-btn--prod" : string.Empty) @(IsConfirmDisabled ? "confirm-dialog-btn--disabled" : string.Empty)">
                    @ConfirmLabel
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm";
    [Parameter] public string Message { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmLabel { get; set; } = "Confirm";
    [Parameter] public bool IsProduction { get; set; }
    [Parameter] public bool RequireTyping { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string TypingConfirm = "";
    private bool IsConfirmDisabled => RequireTyping && IsProduction && TypingConfirm != "CONFIRM";
    private ElementReference _dialogRef;
    private bool _trapApplied;
    private bool _wasVisible;
    private IJSObjectReference? _savedFocusRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Visible || _trapApplied) return;
        _trapApplied = true;
        try
        {
            _savedFocusRef = await JS.InvokeAsync<IJSObjectReference>("SwebKit.saveFocus");
            await JS.InvokeVoidAsync("SwebKit.trapFocus", _dialogRef);
        }
        catch { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !_wasVisible)
        {
            _wasVisible = true;
        }
        else if (!Visible && _wasVisible)
        {
            _wasVisible = false;
            if (_savedFocusRef is not null)
            {
                try { await JS.InvokeVoidAsync("SwebKit.restoreFocus", _savedFocusRef); }
                catch { }
                try { await _savedFocusRef.DisposeAsync(); }
                catch { }
                _savedFocusRef = null;
            }
        }

        if (!Visible) _trapApplied = false;
    }

    private async Task OnBackdropKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Cancel();
        if (e.Key == "Enter" && !IsConfirmDisabled) await Confirm();
    }

    private Task Confirm() { TypingConfirm = ""; return OnConfirm.InvokeAsync(); }
    private Task Cancel() { TypingConfirm = ""; return OnCancel.InvokeAsync(); }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("SwebKit.releaseTrap", _dialogRef); }
        catch { }
        if (_savedFocusRef is not null)
        {
            try { await _savedFocusRef.DisposeAsync(); }
            catch { }
        }
    }
}
