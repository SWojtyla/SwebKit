@if (Visible)
{
    <div
        style="position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:500; display:flex; align-items:center; justify-content:center;">
        <div
            style="background:var(--color-surface-2); border:1px solid var(--color-border); border-radius:8px; padding:24px; max-width:440px; width:90%;">
            @if (IsProduction)
            {
                <div
                    style="background:var(--color-prod); color:white; padding:6px 12px; border-radius:4px; margin-bottom:16px; font-size:12px; font-weight:600;">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Width="16px" style="flex-shrink:0;" /> PRODUCTION
                    — This action cannot be undone
                </div>
            }
            <h3 style="margin:0 0 8px; font-size:15px;">@Title</h3>
            <p style="margin:0 0 16px; font-size:13px; color:var(--color-text-muted);">@Message</p>

            @if (RequireTyping && IsProduction)
            {
                <div style="margin-bottom:16px;">
                    <p style="font-size:12px; margin:0 0 6px;">Type <strong>CONFIRM</strong> to proceed:</p>
                    <input type="text" @bind="TypingConfirm"
                           style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px;" />
                </div>
            }

            <div style="display:flex; gap:8px; justify-content:flex-end;">
                <button @onclick="Cancel" style="padding:6px 16px; cursor:pointer;">Cancel</button>
                <button @onclick="Confirm" disabled="@IsConfirmDisabled"
                        style="padding:6px 16px; background:@(IsProduction ? "var(--color-prod)" : "var(--color-accent)"); color:white; border:none; border-radius:4px; cursor:pointer; @(IsConfirmDisabled ? "opacity:0.5;" : "")">
                    @ConfirmLabel
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm";
    [Parameter] public string Message { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmLabel { get; set; } = "Confirm";
    [Parameter] public bool IsProduction { get; set; }
    [Parameter] public bool RequireTyping { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string TypingConfirm = "";
    private bool IsConfirmDisabled => RequireTyping && IsProduction && TypingConfirm != "CONFIRM";

    private Task Confirm() { TypingConfirm = ""; return OnConfirm.InvokeAsync(); }
    private Task Cancel() { TypingConfirm = ""; return OnCancel.InvokeAsync(); }
}