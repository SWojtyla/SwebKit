@if (IsLoading && Error is null)
{
    @if (LoadingContent is not null)
    {
        @LoadingContent
    }
    else
    {
        <LoadingSpinner Message="Loading..." Timeout="@Timeout" OnRetry="@OnRetry" />
    }
}
else if (Error is not null)
{
    <div class="loading-container__error">
        <ErrorCallout Title="Unable to load content" Message="@Error" OnRetry="OnRetry" />
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public TimeSpan Timeout { get; set; } = TimeSpan.FromSeconds(30);
    [Parameter] public RenderFragment? LoadingContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
