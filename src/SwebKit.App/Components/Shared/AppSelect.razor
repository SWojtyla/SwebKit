@if (ShouldRenderField)
{
    <FormField Label="@Label"
               Required="@Required"
               Hint="@Hint"
               Error="@Error"
               Id="@ResolvedId">
        @SelectMarkup
    </FormField>
}
else
{
    @SelectMarkup
}

@code {
    private static int nextId;
    private readonly string generatedId = $"app-select-{Interlocked.Increment(ref nextId)}";

    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool ShouldRenderField => HasText(Label) || HasText(Hint) || HasText(Error);
    private bool HasError => HasText(Error);
    private string? ResolvedId => HasText(Id) ? Id : ShouldRenderField ? generatedId : null;
    private string? AriaInvalid => HasError ? "true" : null;
    private string? AriaDescribedBy => BuildAriaDescribedBy();

    private RenderFragment SelectMarkup => builder =>
    {
        builder.OpenElement(0, "select");
        builder.AddMultipleAttributes(1, AdditionalAttributes);
        builder.AddAttribute(2, "id", ResolvedId);
        builder.AddAttribute(3, "name", Name);
        builder.AddAttribute(4, "class", SelectClass);
        builder.AddAttribute(5, "value", Value);
        builder.AddAttribute(6, "disabled", Disabled);
        builder.AddAttribute(7, "required", Required);
        builder.AddAttribute(8, "aria-invalid", AriaInvalid);
        builder.AddAttribute(9, "aria-describedby", AriaDescribedBy);
        builder.AddAttribute(10, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, HandleChangeAsync));
        builder.AddContent(11, ChildContent);
        builder.CloseElement();
    };

    private string SelectClass
    {
        get
        {
            var stateClasses = string.Join(' ', new[]
            {
                HasError ? "app-select--invalid" : null,
                CssClass
            }.Where(static cssClass => !string.IsNullOrWhiteSpace(cssClass)));

            return string.IsNullOrWhiteSpace(stateClasses)
                ? "app-native-control app-native-select app-select"
                : $"app-native-control app-native-select app-select {stateClasses}";
        }
    }

    private Task HandleChangeAsync(ChangeEventArgs args)
    {
        if (!ValueChanged.HasDelegate)
        {
            return Task.CompletedTask;
        }

        return ValueChanged.InvokeAsync(args.Value?.ToString());
    }

    private string? BuildAriaDescribedBy()
    {
        if (!ShouldRenderField || string.IsNullOrWhiteSpace(ResolvedId))
        {
            return null;
        }

        var ids = new[]
        {
            HasText(Hint) ? $"{ResolvedId}-hint" : null,
            HasText(Error) ? $"{ResolvedId}-error" : null
        }.Where(static id => !string.IsNullOrWhiteSpace(id));

        var describedBy = string.Join(' ', ids);
        return string.IsNullOrWhiteSpace(describedBy) ? null : describedBy;
    }

    private static bool HasText(string? value) => !string.IsNullOrWhiteSpace(value);
}