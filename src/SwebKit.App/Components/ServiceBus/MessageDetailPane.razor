@inject IJSRuntime JS
@inject INotificationService Notifications
@inject AppStateService AppState
@inject IncidentInvestigationLauncher InvestigationLauncher

@if (Message is null)
{
    <div class="mdp-empty-state">
        Select a message to view details
    </div>
}
else
{
    <div class="mdp-host">
        <div class="mdp-header">
            <span class="mdp-message-id">@(Message.MessageId.Length > 16 ? Message.MessageId[..16] + "…" :
                            Message.MessageId)</span>
                <div class="mdp-actions">
                    @if (OnEdit.HasDelegate)
                    {
                        <AppButton OnClick="@(() => OnEdit.InvokeAsync(Message))" CssClass="mdp-btn"
                                   Size="Small" Variant="Secondary"
                                   Title="Edit message body/properties and re-send (Ctrl+E)">
                            Edit &amp; Resubmit
                        </AppButton>
                    }
                    @if (OnReplay.HasDelegate)
                    {
                        <AppButton OnClick="@(() => OnReplay.InvokeAsync(Message))" CssClass="mdp-btn"
                                   Size="Small" Variant="Secondary"
                                   Title="Replay this message to another namespace/entity">
                            Replay
                        </AppButton>
                    }
                    @if (OnSchedule.HasDelegate)
                    {
                        <AppButton OnClick="@(() => OnSchedule.InvokeAsync(Message))" CssClass="mdp-btn"
                                   Size="Small" Variant="Secondary"
                                   Title="Schedule this message for future delivery (Ctrl+Shift+S)">
                            Schedule
                        </AppButton>
                    }
                    <AppButton OnClick="CopyBody" CssClass="mdp-btn" Size="Small" Variant="Secondary"
                               Title="Copy message body to clipboard">
                        @(_copyFeedback == "body" ? "Copied!" : "Copy Body")
                    </AppButton>
                    <AppButton OnClick="CopyFullMessage" CssClass="mdp-btn" Size="Small" Variant="Secondary"
                               Title="Copy full message (all properties + body) as JSON">
                        @(_copyFeedback == "full" ? "Copied!" : "Copy Full Message")
                    </AppButton>
                    <AppButton OnClick="OpenSaveAsTemplate" CssClass="mdp-btn" Size="Small" Variant="Secondary"
                               Title="Save this message as a reusable template">
                        Save as Template
                    </AppButton>
                    <AppButton OnClick="Investigate" CssClass="mdp-btn" Size="Small" Variant="Secondary"
                               Title="Open in Incident Timeline">
                        Investigate
                    </AppButton>
                </div>
            </div>

            <FluentTabs class="mdp-tabs">
                <FluentTab Label="Body">
                    <div class="mdp-tab-pane mdp-tab-pane--body">
                        @FormatBody(Message.Body, Message.ContentType)
                    </div>
                </FluentTab>
                <FluentTab Label="Properties">
                    <div class="mdp-tab-pane">
                        @foreach (var (key, value) in Message.ApplicationProperties)
                        {
                            <div class="mdp-prop-row">
                                <span class="mdp-prop-key">@key</span>
                                <span class="mdp-prop-value">@value</span>
                            </div>
                        }
                        @if (!Message.ApplicationProperties.Any())
                        {
                            <span class="mdp-empty">No application properties</span>
                        }
                    </div>
                </FluentTab>
                <FluentTab Label="System">
                    <div class="mdp-tab-pane">
                        <PropRow Label="MessageId" Value="@Message.MessageId" />
                        <PropRow Label="CorrelationId" Value="@(Message.CorrelationId ?? "-")" />
                        <PropRow Label="Subject" Value="@(Message.Subject ?? "-")" />
                        <PropRow Label="ContentType" Value="@(Message.ContentType ?? "-")" />
                        <PropRow Label="DeliveryCount" Value="@Message.DeliveryCount.ToString()" />
                        <PropRow Label="EnqueuedAt" Value="@Message.EnqueuedAt.ToString("yyyy-MM-dd HH:mm:ss.fff zzz")" />
                        <PropRow Label="SequenceNumber" Value="@(Message.SequenceNumber?.ToString() ?? "-")" />
                        <PropRow Label="SessionId" Value="@(Message.SessionId ?? "-")" />
                        @if (!string.IsNullOrWhiteSpace(Message.SessionId) && OnFilterBySession.HasDelegate)
                        {
                            <div class="mdp-session-filter-cta">
                                <AppButton CssClass="mdp-btn" data-testid="filter-by-session-btn"
                                           OnClick="@(() => OnFilterBySession.InvokeAsync(Message.SessionId))"
                                           Size="Small" Variant="Secondary"
                                           Title="Filter the message list to only messages with this session ID">
                                    Filter list to this session
                                </AppButton>
                            </div>
                        }
                        <PropRow Label="PartitionKey" Value="@(Message.SystemProperties.PartitionKey ?? "-")" />
                        <PropRow Label="ExpiresAt" Value="@ExpiryDisplay(Message)" />
                        @if (Message.SystemProperties.LockedUntil.HasValue)
                        {
                            <PropRow Label="LockedUntil" Value="@Message.SystemProperties.LockedUntil.Value.ToString("yyyy-MM-dd HH:mm:ss.fff zzz")" />
                        }
                    </div>
                </FluentTab>
                @if (Message.DeadLetterReason is not null)
                {
                    <FluentTab Label="DLQ Info">
                        <div class="mdp-tab-pane">
                            <div class="mdp-dlq-callout">
                                <div class="mdp-dlq-reason">Reason: @Message.DeadLetterReason</div>
                                @if (!string.IsNullOrEmpty(Message.DeadLetterErrorDescription))
                                {
                                    <div class="mdp-dlq-desc">@Message.DeadLetterErrorDescription</div>
                                }
                                <div class="mdp-dlq-meta">
                                    <span>Delivery count: @Message.DeliveryCount</span>
                                    @if (Message.SystemProperties.ExpiresAt.HasValue)
                                    {
                                        <span>· Expires: @Message.SystemProperties.ExpiresAt.Value.ToString("yyyy-MM-dd HH:mm:ss zzz")</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </FluentTab>
                }
                <FluentTab Label="Trace Pivot" data-testid="trace-pivot-tab">
                    <div class="mdp-tab-pane mdp-tab-pane--trace">
                        <div class="mdp-trace-intro">
                            Trace pivots use explicit identifiers only. Each pivot shows which identifier was used and why it is a reasonable signal, not a guaranteed causal link.
                        </div>
                        @{
                            var tracePivots = BuildTracePivots(Message);
                        }
                        @foreach (var pivot in tracePivots)
                        {
                            <div class="mdp-trace-pivot" data-testid="trace-pivot-row">
                                <span class="mdp-trace-pivot-key">@pivot.Label</span>
                                <span class="mdp-trace-pivot-value">@pivot.Value</span>
                                <span class="mdp-trace-pivot-reason">@pivot.Reason</span>
                                <AppButton CssClass="mdp-btn"
                                           OnClick="@(() => InvestigateWithPivot(pivot))"
                                           Size="Small" Variant="Secondary"
                                           Title="Open this pivot in Incident Timeline">
                                    Investigate
                                </AppButton>
                                @if (OnApplyTracePivotFilter.HasDelegate)
                                {
                                    <AppButton CssClass="mdp-btn mdp-btn--secondary"
                                               data-testid="apply-pivot-filter"
                                               OnClick="@(() => OnApplyTracePivotFilter.InvokeAsync(pivot.Value))"
                                               Size="Small" Variant="Subtle"
                                               Title="Filter the message list to messages matching this identifier value">
                                        Filter list
                                    </AppButton>
                                }
                            </div>
                        }
                        @if (!tracePivots.Any())
                        {
                            <span class="mdp-empty">No explicit trace identifiers found on this message.</span>
                        }
                    </div>
                </FluentTab>
                </FluentTabs>
            </div>
        }

        @if (_showSaveTemplate)
        {
            <div class="mdp-save-overlay">
                <div class="mdp-save-dialog">
                    <h3 class="mdp-save-title">Save Message as Template</h3>
                    <input type="text" @bind="_templateName" placeholder="Template name…"
                           class="mdp-save-input app-native-control" />
                    <div class="mdp-save-copy">
                        Body, subject, content-type, correlation ID, and application properties will be saved.
                    </div>
                    <div class="mdp-save-actions">
                        <button @onclick="() => _showSaveTemplate = false"
                                class="mdp-modal-btn mdp-modal-btn--secondary">Cancel</button>
                        <button @onclick="SaveAsTemplate" disabled="@string.IsNullOrWhiteSpace(_templateName)"
                                class="mdp-modal-btn mdp-modal-btn--primary">Save</button>
                    </div>
                </div>
            </div>
        }

@code {
    [Parameter] public SbMessage? Message { get; set; }
    [Parameter] public string? EntityPath { get; set; }
    [Parameter] public EventCallback<SbMessage> OnEdit { get; set; }
    [Parameter] public EventCallback<SbMessage> OnReplay { get; set; }
    [Parameter] public EventCallback<SbMessage> OnSchedule { get; set; }
    [Parameter] public EventCallback<string> OnFilterBySession { get; set; }
    [Parameter] public EventCallback<string> OnApplyTracePivotFilter { get; set; }

    private string? _copyFeedback;

    private sealed record TracePivot(string Label, string Value, string Reason, string? OperationId, string? CorrelationId);

    private static readonly IReadOnlyList<string> KnownTraceAppPropertyKeys =
    [
        "operation_Id", "operationId", "traceparent", "traceId", "trace_id",
        "x-correlation-id", "correlationId", "correlation_id"
    ];

    private static IReadOnlyList<TracePivot> BuildTracePivots(SbMessage message)
    {
        var pivots = new List<TracePivot>();

        if (!string.IsNullOrWhiteSpace(message.CorrelationId))
        {
            pivots.Add(new TracePivot(
                "CorrelationId",
                message.CorrelationId,
                "Standard Service Bus correlation identifier. Useful for grouping related messages across a workflow.",
                null,
                message.CorrelationId));
        }

        if (!string.IsNullOrWhiteSpace(message.SessionId))
        {
            pivots.Add(new TracePivot(
                "SessionId",
                message.SessionId,
                "Session identifier. Groups all messages in this session for ordered or stateful processing.",
                null,
                null));
        }

        foreach (var key in KnownTraceAppPropertyKeys)
        {
            if (message.ApplicationProperties.TryGetValue(key, out var rawValue))
            {
                var value = rawValue?.ToString();
                if (!string.IsNullOrWhiteSpace(value))
                {
                    var isOperationId = key.Contains("operation", StringComparison.OrdinalIgnoreCase)
                                     || key.Equals("traceparent", StringComparison.OrdinalIgnoreCase)
                                     || key.Contains("trace", StringComparison.OrdinalIgnoreCase);
                    pivots.Add(new TracePivot(
                        key,
                        value,
                        $"Application property '{key}' is a known distributed tracing identifier.",
                        isOperationId ? value : null,
                        null));
                }
            }
        }

        return pivots;
    }

    private void Investigate()
    {
        if (Message is null) return;
        InvestigationLauncher.Launch(new IncidentInvestigationSeed
        {
            SourceArea = IncidentInvestigationSourceArea.ServiceBus,
            LaunchedAtUtc = DateTimeOffset.UtcNow,
            SelectedRange = TimeRange.Last24Hours,
            EvidenceRef = new IncidentSeedEvidenceRef
            {
                EntityPath = EntityPath,
                MessageId = Message.MessageId,
                CorrelationId = Message.CorrelationId
            }
        });
    }

    private void InvestigateWithPivot(TracePivot pivot)
    {
        if (Message is null) return;
        InvestigationLauncher.Launch(new IncidentInvestigationSeed
        {
            SourceArea = IncidentInvestigationSourceArea.ServiceBus,
            LaunchedAtUtc = DateTimeOffset.UtcNow,
            SelectedRange = TimeRange.Last24Hours,
            EvidenceRef = new IncidentSeedEvidenceRef
            {
                EntityPath = EntityPath,
                MessageId = Message.MessageId,
                CorrelationId = pivot.CorrelationId ?? pivot.Value,
                OperationId = pivot.OperationId
            }
        });
    }

    private static string ExpiryDisplay(SbMessage message)
    {
        var expiresAt = message.SystemProperties.ExpiresAt;
        if (!expiresAt.HasValue) return "-";
        var remaining = expiresAt.Value - DateTimeOffset.UtcNow;
        var formatted = expiresAt.Value.ToString("yyyy-MM-dd HH:mm:ss zzz");
        if (remaining <= TimeSpan.Zero) return $"{formatted} (expired)";
        if (remaining.TotalHours >= 1)
            return $"{formatted} ({(int)remaining.TotalHours}h {remaining.Minutes}m remaining)";
        if (remaining.TotalMinutes >= 1)
            return $"{formatted} ({(int)remaining.TotalMinutes}m {remaining.Seconds}s remaining)";
        return $"{formatted} ({(int)remaining.TotalSeconds}s remaining)";
    }
    private CancellationTokenSource? _feedbackCts;
    private bool _showSaveTemplate;
    private string _templateName = "";

    private async Task CopyBody()
    {
        if (Message is not null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Message.Body);
            Notifications.ShowSuccess("Copied!");
            await ShowFeedback("body");
        }
    }

    private async Task CopyFullMessage()
    {
        if (Message is null) return;
        var json = System.Text.Json.JsonSerializer.Serialize(new
        {
            messageId = Message.MessageId,
            correlationId = Message.CorrelationId,
            subject = Message.Subject,
            contentType = Message.ContentType,
            deliveryCount = Message.DeliveryCount,
            enqueuedAt = Message.EnqueuedAt,
            sequenceNumber = Message.SequenceNumber,
            sessionId = Message.SessionId,
            deadLetterReason = Message.DeadLetterReason,
            deadLetterErrorDescription = Message.DeadLetterErrorDescription,
            applicationProperties = Message.ApplicationProperties,
            body = Message.Body
        }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", json);
        Notifications.ShowSuccess("Copied!");
        await ShowFeedback("full");
    }

    private async Task ShowFeedback(string key)
    {
        _feedbackCts?.Cancel();
        _feedbackCts = new CancellationTokenSource();
        _copyFeedback = key;
        StateHasChanged();
        try
        {
            await Task.Delay(2000, _feedbackCts.Token);
            _copyFeedback = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void OpenSaveAsTemplate()
    {
        if (Message is null) return;
        _templateName = Message.Subject ?? "Untitled template";
        _showSaveTemplate = true;
    }

    private async Task SaveAsTemplate()
    {
        if (Message is null || string.IsNullOrWhiteSpace(_templateName)) return;

        var template = new SbMessageTemplate
        {
            Name = _templateName.Trim(),
            Body = Message.Body,
            ContentType = string.IsNullOrWhiteSpace(Message.ContentType) ? null : Message.ContentType,
            Subject = string.IsNullOrWhiteSpace(Message.Subject) ? null : Message.Subject,
            CorrelationId = string.IsNullOrWhiteSpace(Message.CorrelationId) ? null : Message.CorrelationId,
            Properties = Message.ApplicationProperties
                .ToDictionary(kvp => kvp.Key, kvp => kvp.Value?.ToString() ?? "")
        };

        await AppState.SaveMessageTemplateAsync(template);
        _showSaveTemplate = false;
    }

    private static string FormatBody(string body, string? contentType)
    {
        if (contentType?.Contains("json", StringComparison.OrdinalIgnoreCase) == true || body.TrimStart().StartsWith('{') ||
body.TrimStart().StartsWith('['))
        {
            try
            {
                var doc = System.Text.Json.JsonDocument.Parse(body);
                return System.Text.Json.JsonSerializer.Serialize(doc, new System.Text.Json.JsonSerializerOptions
                {
                    WriteIndented = true
                });
            }
            catch { }
        }
        return body;
    }
}
