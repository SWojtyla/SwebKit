<div style="display:flex; gap:8px; padding:4px 0; border-bottom:1px solid var(--color-border);">
    <span style="color:var(--color-text-muted); min-width:140px; flex-shrink:0;">@Label</span>
    <span style="word-break:break-all;">@Value</span>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
}
