@inject AppStateService AppState

<div class="template-picker__overlay">
    <div class="template-picker__dialog">
        <div class="template-picker__header">
            <h3 class="template-picker__title">Message Templates</h3>
            <span class="template-picker__count">@AppState.MessageTemplates.Count template(s)</span>
            <button @onclick="() => OnClose.InvokeAsync()" title="Close"
                    class="template-picker__close">&#x2715;</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_validationMessage))
        {
            <div data-testid="template-validation-message" class="template-picker__validation">
                @_validationMessage
            </div>
        }

        @if (!AppState.MessageTemplates.Any())
        {
            <div class="template-picker__empty">
                No templates saved yet.<br />
                <span class="template-picker__empty-copy">Use <strong>Save as Template</strong> in the composer or detail
                    pane to create one.</span>
                </div>
            }
        else
            {
                var visibleTemplates = FilteredTemplates;

                <div class="template-picker__search">
                    <input data-testid="template-search-input" type="text" @bind="_searchQuery" @bind:event="oninput"
                           placeholder="Search templates by name, subject, or content-type" aria-label="Search templates"
                           class="template-picker__search-input app-native-control" />
                    <span class="template-picker__search-count">@visibleTemplates.Count match(es)</span>
                </div>

                @if (!visibleTemplates.Any())
                {
                    <div class="template-picker__no-results">
                        No templates match "@_searchQuery".
                    </div>
                }
                else
                {
                    <div class="template-picker__list">
                        @foreach (var template in visibleTemplates)
                        {
                            var isSelected = _selectedTemplateId == template.Id;
                            <div data-testid="template-row" @onclick="() => SelectTemplate(template.Id)"
                                 class="template-picker__row @(isSelected ? "template-picker__row--selected" : null)">
                                <div class="template-picker__main">
                                    @if (_renamingId == template.Id)
                                    {
                                        <div class="template-picker__rename">
                                            <input data-testid="rename-template-input" type="text" @bind="_renameValue"
                                                   class="template-picker__inline-input app-native-control" />
                                            <button data-testid="confirm-rename-button" @onclick="() => ConfirmRename(template)"
                                                    @onclick:stopPropagation="true"
                                                    class="template-picker__small-btn template-picker__small-btn--primary">OK</button>
                                            <button @onclick="CancelRename" @onclick:stopPropagation="true"
                                                    class="template-picker__small-btn template-picker__small-btn--secondary">Cancel</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="template-picker__name">@template.Name</div>
                                    }
                                    <div class="template-picker__meta">
                                        @(template.ContentType ?? "no content-type")
                                        @if (!string.IsNullOrWhiteSpace(template.Subject))
                                        {
                                            <span> · @template.Subject</span>
                                        }
                                        @if (template.Properties.Count > 0)
                                        {
                                            <span> · @template.Properties.Count props</span>
                                        }
                                        <span> · @template.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                    </div>
                                </div>
                                <div class="template-picker__actions">
                                    <button type="button" data-testid="apply-template-button" class="template-picker__apply-btn"
                                            @onclick="() => ApplyTemplateAsync(template)">
                                        Apply
                                    </button>
                                    <button data-testid="rename-template-button" @onclick="() => StartRename(template)"
                                            @onclick:stopPropagation="true" title="Rename"
                                            class="template-picker__ghost-btn">Rename</button>
                                    <button @onclick="() => DuplicateAsync(template)" @onclick:stopPropagation="true"
                                            title="Duplicate template" class="template-picker__ghost-btn">Duplicate</button>
                                    <button data-testid="edit-template-button" @onclick="() => StartEdit(template)"
                                            @onclick:stopPropagation="true" title="Edit template body and properties"
                                            class="template-picker__ghost-btn">Edit</button>
                                    <button data-testid="delete-template-button" @onclick="() => DeleteTemplateAsync(template.Id)"
                                            @onclick:stopPropagation="true" title="Delete template"
                                            class="template-picker__ghost-btn template-picker__ghost-btn--danger">&#x2715;</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    @if (_editingTemplate is not null)
    {
        <div class="template-picker__edit-overlay">
            <div class="template-picker__edit-dialog">
                <h3 class="template-picker__edit-title">Edit Template: @_editingTemplate.Name</h3>

                <div class="template-picker__edit-body">
                    <div class="template-picker__grid">
                        <div class="template-picker__field">
                            <label class="template-picker__label">Subject</label>
                            <input type="text" @bind="_editSubject" class="template-picker__field-input app-native-control" />
                        </div>
                        <div class="template-picker__field">
                            <label class="template-picker__label">Content-Type</label>
                            <input type="text" @bind="_editContentType"
                                   class="template-picker__field-input app-native-control" />
                        </div>
                    </div>
                    <div class="template-picker__field">
                        <label class="template-picker__label">Correlation ID</label>
                        <input type="text" @bind="_editCorrelationId" class="template-picker__field-input app-native-control" />
                    </div>

                    <div>
                        <div class="template-picker__prop-header">
                            Application Properties
                            <button @onclick="EditAddProperty"
                                    class="template-picker__small-btn template-picker__small-btn--secondary">+ Add</button>
                        </div>
                        @for (var i = 0; i < _editProperties.Count; i++)
                        {
                            var idx = i;
                            <div class="template-picker__prop-row">
                                <input type="text" value="@_editProperties[idx].Key" placeholder="Key"
                                       @onchange="e => EditSetPropKey(idx, e.Value?.ToString() ?? string.Empty)"
                                       class="template-picker__prop-key app-native-control" />
                                <input type="text" value="@_editProperties[idx].Value" placeholder="Value"
                                       @onchange="e => EditSetPropValue(idx, e.Value?.ToString() ?? string.Empty)"
                                       class="template-picker__prop-value app-native-control" />
                                <button @onclick="() => _editProperties.RemoveAt(idx)" title="Remove"
                                        class="template-picker__ghost-btn">&#x2715;</button>
                            </div>
                        }
                    </div>

                    <div class="template-picker__field">
                        <label class="template-picker__label">Body</label>
                        <textarea data-testid="edit-template-body" @bind="_editBody" rows="8"
                                  class="template-picker__textarea app-native-control"></textarea>
                    </div>

                    <div class="template-picker__footer">
                        <button @onclick="CancelEdit"
                                class="template-picker__footer-btn template-picker__footer-btn--secondary">Cancel</button>
                        <button data-testid="save-edit-template-button" @onclick="SaveEdit"
                                class="template-picker__footer-btn template-picker__footer-btn--primary">Save Changes</button>
                    </div>
                </div>
            </div>
        </div>
    }

@code {
    [Parameter] public EventCallback<SbMessageTemplate> OnTemplateSelected { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Guid? _selectedTemplateId;
    private string _searchQuery = "";
    private string? _validationMessage;

    // Rename state
    private Guid? _renamingId;
    private string _renameValue = "";

    // Edit state
    private SbMessageTemplate? _editingTemplate;
    private string _editSubject = "";
    private string _editContentType = "";
    private string _editCorrelationId = "";
    private string _editBody = "";
    private List<(string Key, string Value)> _editProperties = [];

    private IReadOnlyList<SbMessageTemplate> FilteredTemplates
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchQuery))
                return AppState.MessageTemplates;

            var term = _searchQuery.Trim();
            return AppState.MessageTemplates
                .Where(t =>
                    t.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (t.Subject?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (t.ContentType?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }
    }

    private void SelectTemplate(Guid id)
    {
        _selectedTemplateId = id;
        _validationMessage = null;
    }

    private Task ApplyTemplateAsync(SbMessageTemplate template)
    {
        _selectedTemplateId = template.Id;
        _validationMessage = null;
        return OnTemplateSelected.InvokeAsync(template);
    }

    private void StartRename(SbMessageTemplate template)
    {
        _renamingId = template.Id;
        _renameValue = template.Name;
        _selectedTemplateId = template.Id;
        _validationMessage = null;
    }

    private void CancelRename()
    {
        _renamingId = null;
        _validationMessage = null;
    }

    private async Task ConfirmRename(SbMessageTemplate template)
    {
        var name = _renameValue.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            _validationMessage = "Template name is required.";
            return;
        }

        var duplicateNameExists = AppState.MessageTemplates.Any(t =>
            t.Id != template.Id &&
            string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase));
        if (duplicateNameExists)
        {
            _validationMessage = "Template name must be unique.";
            return;
        }

        template.Name = name;
        await AppState.SaveMessageTemplateAsync(template);
        _renamingId = null;
        _validationMessage = null;
        StateHasChanged();
    }

    private async Task DuplicateAsync(SbMessageTemplate source)
    {
        var copyNameBase = source.Name + " (copy)";
        var copyName = copyNameBase;
        var copySuffix = 2;
        while (AppState.MessageTemplates.Any(t => string.Equals(t.Name, copyName, StringComparison.OrdinalIgnoreCase)))
            copyName = $"{copyNameBase} {copySuffix++}";

        var copy = new SbMessageTemplate
        {
            Name = copyName,
            Body = source.Body,
            ContentType = source.ContentType,
            Subject = source.Subject,
            CorrelationId = source.CorrelationId,
            Properties = new Dictionary<string, string>(source.Properties)
        };
        await AppState.SaveMessageTemplateAsync(copy);
        _selectedTemplateId = copy.Id;
        _validationMessage = null;
        StateHasChanged();
    }

    private void StartEdit(SbMessageTemplate template)
    {
        _editingTemplate = template;
        _editSubject = template.Subject ?? "";
        _editContentType = template.ContentType ?? "";
        _editCorrelationId = template.CorrelationId ?? "";
        _editBody = template.Body;
        _editProperties = template.Properties.Select(kvp => (kvp.Key, kvp.Value)).ToList();
        _selectedTemplateId = template.Id;
        _validationMessage = null;
    }

    private void CancelEdit()
    {
        _editingTemplate = null;
        _validationMessage = null;
    }

    private void EditAddProperty() => _editProperties.Add(("", ""));
    private void EditSetPropKey(int idx, string key)
    {
        _editProperties[idx] = (key, _editProperties[idx].Value);
        StateHasChanged();
    }
    private void EditSetPropValue(int idx, string val)
    {
        _editProperties[idx] = (_editProperties[idx].Key, val);
        StateHasChanged();
    }

    private async Task SaveEdit()
    {
        if (_editingTemplate is null) return;

        var duplicatePropertyKey = _editProperties
            .Select(p => p.Key.Trim())
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .GroupBy(k => k, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault(g => g.Count() > 1)?
            .Key;
        if (!string.IsNullOrWhiteSpace(duplicatePropertyKey))
        {
            _validationMessage = $"Property key '{duplicatePropertyKey}' is duplicated.";
            return;
        }

        _editingTemplate.Subject = string.IsNullOrWhiteSpace(_editSubject) ? null : _editSubject;
        _editingTemplate.ContentType = string.IsNullOrWhiteSpace(_editContentType) ? null : _editContentType;
        _editingTemplate.CorrelationId = string.IsNullOrWhiteSpace(_editCorrelationId) ? null : _editCorrelationId;
        _editingTemplate.Body = _editBody;
        _editingTemplate.Properties = _editProperties
            .Where(p => !string.IsNullOrWhiteSpace(p.Key))
            .ToDictionary(p => p.Key, p => p.Value);
        await AppState.SaveMessageTemplateAsync(_editingTemplate);
        _editingTemplate = null;
        _validationMessage = null;
        StateHasChanged();
    }

    private async Task DeleteTemplateAsync(Guid id)
    {
        await AppState.DeleteMessageTemplateAsync(id);
        if (_selectedTemplateId == id)
            _selectedTemplateId = null;
        if (_renamingId == id)
            _renamingId = null;
        if (_editingTemplate?.Id == id)
            _editingTemplate = null;
        _validationMessage = null;
        StateHasChanged();
    }
}
