@inject AppStateService AppState

<div class="entity-tree">
    @if (IsLoading)
    {
        <SkeletonRows Count="5" />
    }
    else if (ErrorMessage is not null)
    {
        <ErrorCallout Message="@ErrorMessage" OnRetry="LoadAsync" />
    }
    else
    {
        @if (!Queues.Any() && !Topics.Any())
        {
            <div class="entity-tree-empty-hint">
                No queues or topics found. If you expect entities here, verify the namespace and that your connection string has
                Manage rights.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(OperationMessage))
        {
            <div class="entity-tree-operation-message">
                @OperationMessage
            </div>
        }

        <div class="entity-tree-action-bar @(SelectedEntity is null ? "empty" : string.Empty)" role="region" aria-label="Entity actions">
            @if (SelectedEntity is null)
            {
                <div class="entity-tree-action-empty">Select an entity to access actions.</div>
            }
            else
            {
                var selected = SelectedEntity;
                var statusLabel = GetStatusLabel(selected);
                var supportsMessageModes = SupportsMessageModes(selected);

                <div class="entity-tree-selected-name" title="@selected.Name">@selected.Name</div>
                <div class="entity-tree-selected-meta">
                    <span class="entity-status-dot @(selected.IsDisabled ? "disabled" : "active")"
                          role="img"
                          title="@($"Status: {statusLabel}")"
                          aria-label="@($"Status: {statusLabel}")"></span>
                    <span class="entity-tree-selected-status">@statusLabel</span>
                </div>
                <div class="entity-tree-action-buttons">
                    <button type="button"
                            class="entity-tree-action-btn"
                            disabled="@(IsMutating || IsLoading || !supportsMessageModes)"
                            title="@(supportsMessageModes ? $"Open active messages for '{selected.Name}'" : "Active mode is not available for topics")"
                            aria-label="@(supportsMessageModes ? $"Open active messages for {selected.Name}" : "Active mode is not available for topics")"
                            @onclick="() => OpenEntity(selected)">
                        Open Active
                    </button>
                    <button type="button"
                            class="entity-tree-action-btn"
                            disabled="@(IsMutating || IsLoading || !supportsMessageModes)"
                            title="@(supportsMessageModes ? $"Open dead-letter messages for '{selected.Name}'" : "Dead-letter mode is not available for topics")"
                            aria-label="@(supportsMessageModes ? $"Open dead-letter messages for {selected.Name}" : "Dead-letter mode is not available for topics")"
                            @onclick="() => OpenEntity(selected, true)">
                        Open DLQ
                    </button>
                    <button type="button"
                            class="entity-tree-action-btn"
                            disabled="@(IsMutating || IsLoading)"
                            title="@(selected.IsDisabled ? $"Enable '{selected.Name}'" : $"Disable '{selected.Name}'")"
                            aria-label="@(selected.IsDisabled ? $"Enable {selected.Name}" : $"Disable {selected.Name}")"
                            @onclick="() => ToggleEntityEnabledAsync(selected)">
                        @(selected.IsDisabled ? "Enable" : "Disable")
                    </button>
                </div>
            }
        </div>

        <div class="entity-tree-list">
            @foreach (var row in _flatRows)
            {
                @switch (row.Kind)
                {
                    case TreeRowKind.QueueHeader:
                        <div class="entity-tree-section-label">
                            Queues
                        </div>
                        <div class="entity-tree-section-help">
                            Click a queue or subscription to open Active messages. Use the selected action bar for DLQ and enable/disable.
                        </div>
                        break;

                    case TreeRowKind.Queue:
                        {
                            var q = row.Entity!;
                            var isLinked = IsEntityLinked(q.EntityPath);
                            <div @key="q.EntityPath" class="@GetEntityRowClass(q)" @onclick="() => OnEntityRowClickedAsync(q)">
                                <span class="entity-tree-glyph entity-tree-glyph-queue">Q</span>
                                <span class="entity-tree-name" title="@q.Name">@q.Name</span>
                                <div class="entity-row-actions">
                                    <span class="entity-active-chip"
                                          title="@($"Active messages in '{q.Name}'")"
                                          aria-label="@($"Active messages in {q.Name}: {FormatCount(q.Stats?.ActiveMessageCount)}")">
                                        <span class="entity-active-label">A</span>
                                        <span class="entity-active-count">@FormatCount(q.Stats?.ActiveMessageCount)</span>
                                    </span>
                                    <button type="button"
                                            class="entity-pin-btn entity-icon-btn @(isLinked ? "pinned" : string.Empty)"
                                            title="@(isLinked ? "Unpin from project" : "Pin to project")"
                                            aria-label="@(isLinked ? $"Unpin queue {q.Name} from project" : $"Pin queue {q.Name} to project")"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => ToggleLink(q.EntityPath)">
                                        <span aria-hidden="true">@(isLinked ? "*" : "o")</span>
                                    </button>
                                </div>
                            </div>
                            break;
                        }

                    case TreeRowKind.TopicHeader:
                        <div class="entity-tree-section-label entity-tree-section-label-topics">
                            Topics
                        </div>
                        break;

                    case TreeRowKind.Topic:
                        {
                            var t = row.Entity!;
                            <div @key="t.EntityPath" class="@GetEntityRowClass(t, "entity-tree-item entity-tree-topic")" @onclick="() => OnTopicRowClickedAsync(t)">
                                <span class="entity-tree-glyph entity-tree-glyph-topic">@(ExpandedTopics.Contains(t.Name) ? "-" : "+")</span>
                                <span class="entity-tree-name" title="@t.Name">@t.Name</span>
                            </div>
                            break;
                        }

                    case TreeRowKind.Subscription:
                        {
                            var s = row.Entity!;
                            var isLinked = IsEntityLinked(s.EntityPath);
                            <div @key="s.EntityPath" class="@GetEntityRowClass(s, "entity-tree-item entity-tree-subscription")" @onclick="() => OnEntityRowClickedAsync(s)">
                                <span class="entity-tree-glyph entity-tree-glyph-subscription">&gt;</span>
                                <span class="entity-tree-name" title="@s.Name">@s.Name</span>
                                <div class="entity-row-actions">
                                    <span class="entity-active-chip"
                                          title="@($"Active messages in '{s.Name}'")"
                                          aria-label="@($"Active messages in {s.Name}: {FormatCount(s.Stats?.ActiveMessageCount)}")">
                                        <span class="entity-active-label">A</span>
                                        <span class="entity-active-count">@FormatCount(s.Stats?.ActiveMessageCount)</span>
                                    </span>
                                    <button type="button"
                                            class="entity-pin-btn entity-icon-btn @(isLinked ? "pinned" : string.Empty)"
                                            title="@(isLinked ? "Unpin from project" : "Pin to project")"
                                            aria-label="@(isLinked ? $"Unpin subscription {s.Name} from project" : $"Pin subscription {s.Name} to project")"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => ToggleLink(s.EntityPath)">
                                        <span aria-hidden="true">@(isLinked ? "*" : "o")</span>
                                    </button>
                                </div>
                            </div>
                            break;
                        }
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public IServiceBusClient? Client { get; set; }
    [Parameter] public Guid NamespaceId { get; set; }
    [Parameter] public IReadOnlyList<SbEntityLink> LinkedEntities { get; set; } = [];
    [Parameter] public EventCallback<SbEntityInfo> OnEntitySelected { get; set; }
    [Parameter] public EventCallback<(SbEntityInfo Entity, bool IsDlq)> OnEntityModeSelected { get; set; }
    [Parameter] public EventCallback<SbEntityLink> OnEntityLinkToggled { get; set; }

    private bool IsLoading;
    private string? ErrorMessage;
    private List<SbEntityInfo> Queues = [];
    private List<SbEntityInfo> Topics = [];
    private Dictionary<string, List<SbEntityInfo>> Subscriptions = [];
    private HashSet<string> ExpandedTopics = [];
    private IServiceBusClient? _loadedClient;
    private List<TreeRow> _flatRows = [];
    private bool _needsRender = true;
    private bool IsMutating;
    private string? OperationMessage;
    private string? _selectedEntityPath;
    private SbEntityInfo? SelectedEntity;

    protected override bool ShouldRender()
    {
        if (!_needsRender) return false;
        _needsRender = false;
        return true;
    }

    enum TreeRowKind { QueueHeader, Queue, TopicHeader, Topic, Subscription }

    readonly record struct TreeRow(TreeRowKind Kind, SbEntityInfo? Entity = null);

    protected override async Task OnParametersSetAsync()
    {
        if (Client is null)
        {
            Queues = [];
            Topics = [];
            Subscriptions = [];
            ExpandedTopics = [];
            _flatRows = [];
            _loadedClient = null;
            _selectedEntityPath = null;
            SelectedEntity = null;
            _needsRender = true;
            return;
        }

        if (!ReferenceEquals(_loadedClient, Client))
        {
            _loadedClient = Client; // Set before await to prevent concurrent loads on parent re-render
            await LoadAsync();
        }
    }

    private void RebuildFlatRows()
    {
        _flatRows = new List<TreeRow>(Queues.Count + Topics.Count + 4);
        if (Queues.Count > 0)
        {
            _flatRows.Add(new TreeRow(TreeRowKind.QueueHeader));
            foreach (var q in Queues)
                _flatRows.Add(new TreeRow(TreeRowKind.Queue, q));
        }
        if (Topics.Count > 0)
        {
            _flatRows.Add(new TreeRow(TreeRowKind.TopicHeader));
            foreach (var t in Topics)
            {
                _flatRows.Add(new TreeRow(TreeRowKind.Topic, t));
                if (ExpandedTopics.Contains(t.Name) && Subscriptions.TryGetValue(t.Name, out var subs))
                {
                    foreach (var s in subs)
                        _flatRows.Add(new TreeRow(TreeRowKind.Subscription, s));
                }
            }
        }

        RefreshSelectedEntity();
    }

    private async Task LoadAsync()
    {
        if (Client is null) return;
        IsLoading = true; ErrorMessage = null;
        Subscriptions.Clear();
        ExpandedTopics.Clear();
        Queues = [];
        Topics = [];
        _flatRows = [];
        _needsRender = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            // Load queues first - show them immediately
            Queues = (await Client.ListQueuesAsync()).ToList();
            RebuildFlatRows();
            _needsRender = true;
            await InvokeAsync(StateHasChanged); // BL-2: progressive update - queues visible before topics load

            // Then load topics
            Topics = (await Client.ListTopicsAsync()).ToList();
            RebuildFlatRows();
        }
        catch (OperationCanceledException) { throw; } // CS-2
        catch (Exception ex)
        {
            var hint = ex.Message.Contains("401") || ex.Message.Contains("403") || ex.Message.Contains("Unauthorized") ||
ex.Message.Contains("Forbidden")
                ? " (Ensure your connection string has 'Manage' rights.)"
                : string.Empty;
            ErrorMessage = $"Failed to load queues/topics: {ex.Message}{hint}";
        }
        finally
        {
            IsLoading = false;
            _needsRender = true;
            await InvokeAsync(StateHasChanged); // BL-2
        }
    }

    private async Task ToggleTopic(string name)
    {
        if (ExpandedTopics.Contains(name))
        {
            ExpandedTopics.Remove(name); RebuildFlatRows(); _needsRender = true;
            await InvokeAsync(StateHasChanged);
            return;
        }
        ExpandedTopics.Add(name);
        if (!Subscriptions.ContainsKey(name) && Client is not null)
            Subscriptions[name] = (await Client.ListSubscriptionsAsync(name)).ToList();
        RebuildFlatRows();
        _needsRender = true;
        await InvokeAsync(StateHasChanged); // BL-2: use InvokeAsync after await
    }

    private async Task ToggleEntityEnabledAsync(SbEntityInfo entity)
    {
        if (Client is null || IsMutating) return;

        var shouldEnable = entity.IsDisabled;
        IsMutating = true;
        OperationMessage = null;
        _needsRender = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (entity.IsSubscription)
            {
                if (!TryResolveSubscription(entity, out var topicName, out var subscriptionName))
                {
                    throw new InvalidOperationException($"Unable to resolve topic/subscription for '{entity.EntityPath}'.");
                }

                await Client.SetSubscriptionEnabledAsync(topicName, subscriptionName, shouldEnable);
            }
            else if (entity.IsTopic)
            {
                await Client.SetTopicEnabledAsync(entity.Name, shouldEnable);
            }
            else
            {
                await Client.SetQueueEnabledAsync(entity.Name, shouldEnable);
            }

            OperationMessage = shouldEnable
                ? $"Enabled {entity.Name}."
                : $"Disabled {entity.Name}.";

            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            OperationMessage = $"Failed to update {entity.Name}: {ex.Message}";
            _needsRender = true;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            IsMutating = false;
            _needsRender = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnEntityRowClickedAsync(SbEntityInfo entity)
    {
        SelectEntity(entity);
        await OpenEntity(entity);
    }

    private async Task OnTopicRowClickedAsync(SbEntityInfo topic)
    {
        SelectEntity(topic);
        await ToggleTopic(topic.Name);
    }

    private void SelectEntity(SbEntityInfo entity)
    {
        _selectedEntityPath = entity.EntityPath;
        SelectedEntity = entity;
        _needsRender = true;
    }

    private void RefreshSelectedEntity()
    {
        if (string.IsNullOrWhiteSpace(_selectedEntityPath))
        {
            SelectedEntity = null;
            return;
        }

        SelectedEntity = FindEntityByPath(_selectedEntityPath);
        if (SelectedEntity is null)
        {
            _selectedEntityPath = null;
        }
    }

    private SbEntityInfo? FindEntityByPath(string entityPath)
    {
        var queue = Queues.FirstOrDefault(q => q.EntityPath == entityPath);
        if (queue is not null)
        {
            return queue;
        }

        var topic = Topics.FirstOrDefault(t => t.EntityPath == entityPath);
        if (topic is not null)
        {
            return topic;
        }

        foreach (var subs in Subscriptions.Values)
        {
            var subscription = subs.FirstOrDefault(s => s.EntityPath == entityPath);
            if (subscription is not null)
            {
                return subscription;
            }
        }

        return null;
    }

    private string GetEntityRowClass(SbEntityInfo entity, string baseClass = "entity-tree-item") =>
        string.Equals(_selectedEntityPath, entity.EntityPath, StringComparison.Ordinal)
            ? $"{baseClass} selected"
            : baseClass;

    private async Task OpenEntity(SbEntityInfo entity, bool isDlq = false)
    {
        if (OnEntityModeSelected.HasDelegate)
        {
            await OnEntityModeSelected.InvokeAsync((entity, isDlq));
            return;
        }

        await OnEntitySelected.InvokeAsync(entity);
    }

    private static string FormatCount(long? count) => (count ?? 0).ToString();

    private static string GetStatusLabel(SbEntityInfo entity) => entity.IsDisabled ? "Disabled" : "Active";

    private static bool SupportsMessageModes(SbEntityInfo entity) => !entity.IsTopic;

    private static bool TryResolveSubscription(SbEntityInfo entity, out string topicName, out string subscriptionName)
    {
        topicName = entity.TopicName ?? string.Empty;
        subscriptionName = entity.Name;

        if (!string.IsNullOrWhiteSpace(topicName) && !string.IsNullOrWhiteSpace(subscriptionName))
        {
            return true;
        }

        const string marker = "/subscriptions/";
        var markerIndex = entity.EntityPath.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (markerIndex <= 0)
        {
            return false;
        }

        topicName = entity.EntityPath[..markerIndex];
        subscriptionName = entity.EntityPath[(markerIndex + marker.Length)..];
        return !string.IsNullOrWhiteSpace(topicName) && !string.IsNullOrWhiteSpace(subscriptionName);
    }

    private bool IsEntityLinked(string entityPath) =>
        LinkedEntities.Any(l => l.NamespaceId == NamespaceId && l.EntityPath == entityPath);

    private Task ToggleLink(string entityPath) =>
        OnEntityLinkToggled.InvokeAsync(new SbEntityLink { NamespaceId = NamespaceId, EntityPath = entityPath });
}