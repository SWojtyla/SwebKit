@inject AppStateService AppState

<div class="entity-tree">
    @if (IsLoading)
    {
        <LoadingSpinner Message="Loading entities..." />
    }
    else if (ErrorMessage is not null)
    {
        <ErrorCallout Message="@ErrorMessage" OnRetry="LoadAsync" />
    }
    else
    {
        @if (!Queues.Any() && !Topics.Any())
        {
            <div style="padding:12px; font-size:12px; color:var(--color-text-muted);">
                No queues or topics found. If you expect entities here, verify the namespace and that your connection string has
                Manage rights.
            </div>
        }

        <Virtualize Items="@_flatRows" Context="row" ItemSize="36">
            @switch (row.Kind)
            {
                case TreeRowKind.QueueHeader:
                    <div
                        style="padding:6px 12px; font-size:10px; color:var(--color-text-muted); text-transform:uppercase; letter-spacing:0.5px;">
                        Queues</div>
                        <div style="padding:0 12px 6px; font-size:10px; color:var(--color-text-muted);">
                            Click row to open Active. Use Active/DLQ actions to pick a mode explicitly.
                        </div>
                        break;

                case TreeRowKind.Queue:
                            {
                                var q = row.Entity!;
                                var isLinked = IsEntityLinked(q.EntityPath);
                                <div @key="q.EntityPath" class="entity-tree-item" @onclick="() => OpenEntity(q)">
                                    <span class="entity-tree-glyph" style="font-size:14px;">Q</span>
                                    <span style="flex:1; overflow:hidden; text-overflow:ellipsis;">@q.Name</span>
                                    <div class="entity-mode-actions" aria-label="Open queue mode">
                                        <button type="button" class="entity-mode-btn active" title="Open active messages"
                                                @onclick:stopPropagation="true" @onclick="() => OpenEntity(q)">
                                            Active @FormatCount(q.Stats?.ActiveMessageCount)
                                        </button>
                                        <button type="button" class="entity-mode-btn dlq" title="Open dead-letter messages"
                                                @onclick:stopPropagation="true" @onclick="() => OpenEntity(q, true)">
                                            DLQ @FormatCount(q.Stats?.DeadLetterMessageCount)
                                        </button>
                                    </div>
                                    <span title="@(isLinked ? "Unpin from project" : "Pin to project")"
                                          style="margin-left:4px; cursor:pointer; font-size:12px; color:@(isLinked ? "var(--color-accent)" : "var(--color-text-muted)");"
                                          @onclick:stopPropagation="true" @onclick="() => ToggleLink(q.EntityPath)">@(isLinked ? "📌" :
                                        "📍")</span>
                                    </div>
                                    break;
                                }

                case TreeRowKind.TopicHeader:
                                    <div
                                        style="padding:6px 12px; font-size:10px; color:var(--color-text-muted); text-transform:uppercase; letter-spacing:0.5px; margin-top:4px;">
                                        Topics</div>
                                        break;

                case TreeRowKind.Topic:
                                            {
                                                var t = row.Entity!;
                                                <div @key="t.EntityPath" class="entity-tree-item entity-tree-topic" @onclick="() => ToggleTopic(t.Name)">
                                                    <span class="entity-tree-glyph" style="font-size:14px;">@(ExpandedTopics.Contains(t.Name) ? "▼" :
                                                              "▶")</span>
                                                        <span style="flex:1; overflow:hidden; text-overflow:ellipsis;">@t.Name</span>
                                                    </div>
                                                    break;
                                                }

                case TreeRowKind.Subscription:
                                                    {
                                                        var s = row.Entity!;
                                                        var isLinked = IsEntityLinked(s.EntityPath);
                                                        <div @key="s.EntityPath" class="entity-tree-item entity-tree-subscription" style="padding-left:28px;"
                                                             @onclick="() => OpenEntity(s)">
                                                            <span class="entity-tree-glyph" style="font-size:13px;">↳</span>
                                                            <span style="flex:1;">@s.Name</span>
                                                            <div class="entity-mode-actions" aria-label="Open subscription mode">
                                                                <button type="button" class="entity-mode-btn active" title="Open active messages"
                                                                        @onclick:stopPropagation="true" @onclick="() => OpenEntity(s)">
                                                                    Active @FormatCount(s.Stats?.ActiveMessageCount)
                                                                </button>
                                                                <button type="button" class="entity-mode-btn dlq" title="Open dead-letter messages"
                                                                        @onclick:stopPropagation="true" @onclick="() => OpenEntity(s, true)">
                                                                    DLQ @FormatCount(s.Stats?.DeadLetterMessageCount)
                                                                </button>
                                                            </div>
                                                            <span title="@(isLinked ? "Unpin from project" : "Pin to project")"
                                                                  style="margin-left:4px; cursor:pointer; font-size:12px; color:@(isLinked ? "var(--color-accent)" : "var(--color-text-muted)");"
                                                                  @onclick:stopPropagation="true" @onclick="() => ToggleLink(s.EntityPath)">@(isLinked ? "📌" :
                                                                "📍")</span>
                                                            </div>
                                                            break;
                                                        }
                                                    }
                                                </Virtualize>
                                            }
                                        </div>

@code {
    [Parameter] public IServiceBusClient? Client { get; set; }
    [Parameter] public Guid NamespaceId { get; set; }
    [Parameter] public IReadOnlyList<SbEntityLink> LinkedEntities { get; set; } = [];
    [Parameter] public EventCallback<SbEntityInfo> OnEntitySelected { get; set; }
    [Parameter] public EventCallback<(SbEntityInfo Entity, bool IsDlq)> OnEntityModeSelected { get; set; }
    [Parameter] public EventCallback<SbEntityLink> OnEntityLinkToggled { get; set; }

    private bool IsLoading;
    private string? ErrorMessage;
    private List<SbEntityInfo> Queues = [];
    private List<SbEntityInfo> Topics = [];
    private Dictionary<string, List<SbEntityInfo>> Subscriptions = [];
    private HashSet<string> ExpandedTopics = [];
    private IServiceBusClient? _loadedClient;
    private List<TreeRow> _flatRows = [];

    enum TreeRowKind { QueueHeader, Queue, TopicHeader, Topic, Subscription }

    readonly record struct TreeRow(TreeRowKind Kind, SbEntityInfo? Entity = null);

    protected override async Task OnParametersSetAsync()
    {
        if (Client is null)
        {
            Queues = [];
            Topics = [];
            Subscriptions = [];
            ExpandedTopics = [];
            _flatRows = [];
            _loadedClient = null;
            return;
        }

        if (!ReferenceEquals(_loadedClient, Client))
        {
            _loadedClient = Client; // Set before await to prevent concurrent loads on parent re-render
            await LoadAsync();
        }
    }

    private void RebuildFlatRows()
    {
        _flatRows = new List<TreeRow>(Queues.Count + Topics.Count + 4);
        if (Queues.Count > 0)
        {
            _flatRows.Add(new TreeRow(TreeRowKind.QueueHeader));
            foreach (var q in Queues)
                _flatRows.Add(new TreeRow(TreeRowKind.Queue, q));
        }
        if (Topics.Count > 0)
        {
            _flatRows.Add(new TreeRow(TreeRowKind.TopicHeader));
            foreach (var t in Topics)
            {
                _flatRows.Add(new TreeRow(TreeRowKind.Topic, t));
                if (ExpandedTopics.Contains(t.Name) && Subscriptions.TryGetValue(t.Name, out var subs))
                {
                    foreach (var s in subs)
                        _flatRows.Add(new TreeRow(TreeRowKind.Subscription, s));
                }
            }
        }
    }

    private async Task LoadAsync()
    {
        if (Client is null) return;
        IsLoading = true; ErrorMessage = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            Subscriptions.Clear();
            ExpandedTopics.Clear();
            Queues = (await Client.ListQueuesAsync()).ToList();
            Topics = (await Client.ListTopicsAsync()).ToList();
            RebuildFlatRows();
        }
        catch (Exception ex)
        {
            var hint = ex.Message.Contains("401") || ex.Message.Contains("403") || ex.Message.Contains("Unauthorized") ||
ex.Message.Contains("Forbidden")
                ? " (Ensure your connection string has 'Manage' rights.)"
                : string.Empty;
            ErrorMessage = $"Failed to load queues/topics: {ex.Message}{hint}";
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleTopic(string name)
    {
        if (ExpandedTopics.Contains(name)) { ExpandedTopics.Remove(name); RebuildFlatRows(); return; }
        ExpandedTopics.Add(name);
        if (!Subscriptions.ContainsKey(name) && Client is not null)
            Subscriptions[name] = (await Client.ListSubscriptionsAsync(name)).ToList();
        RebuildFlatRows();
        StateHasChanged();
    }

    private async Task OpenEntity(SbEntityInfo entity, bool isDlq = false)
    {
        if (OnEntityModeSelected.HasDelegate)
        {
            await OnEntityModeSelected.InvokeAsync((entity, isDlq));
            return;
        }

        await OnEntitySelected.InvokeAsync(entity);
    }

    private static string FormatCount(long? count) => (count ?? 0).ToString();

    private bool IsEntityLinked(string entityPath) =>
        LinkedEntities.Any(l => l.NamespaceId == NamespaceId && l.EntityPath == entityPath);

    private Task ToggleLink(string entityPath) =>
        OnEntityLinkToggled.InvokeAsync(new SbEntityLink { NamespaceId = NamespaceId, EntityPath = entityPath });
}