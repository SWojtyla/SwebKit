@implements IAsyncDisposable
@inject AppStateService AppState

<div class="eb">
    <!-- Toolbar: filter + refresh -->
    <div class="eb-toolbar">
        <input type="search" @bind="_filter" @bind:event="oninput" placeholder="Filter entities…" class="eb-filter"
               aria-label="Filter entities" />
        <button type="button" class="eb-refresh-btn @(IsLoading ? "eb-spinning" : "")" @onclick="RefreshAsync"
                disabled="@IsLoading" title="Refresh entity list" aria-label="Refresh entity list">↻</button>
    </div>

    @if (IsLoading && !Queues.Any() && !Topics.Any())
    {
        <SkeletonRows Count="8" />
    }
    else if (ErrorMessage is not null)
    {
        <ErrorCallout Message="@ErrorMessage" OnRetry="LoadAsync" />
    }
    else
    {
        var fq = FilteredQueues;
        var ft = FilteredTopics;

        @if (!fq.Any() && !ft.Any())
        {
            <div class="eb-empty">
                @if (!string.IsNullOrWhiteSpace(_filter))
                {
                    <span>No entities match "<strong>@_filter</strong>"</span>
                }
                else if (Client is not null)
                {
                    <span>No queues or topics.<br />Verify the namespace has Manage rights.</span>
                }
            </div>
        }

        @if (fq.Any())
        {
            <div class="eb-section">
                <span class="eb-section-label">Queues</span>
                <span class="eb-section-count">@fq.Count</span>
            </div>

            @foreach (var q in fq)
            {
                var qPinned = IsEntityLinked(q.EntityPath);
                <div @key="q.EntityPath"
                     class="eb-row @(_selectedPath == q.EntityPath ? "selected" : "") @(q.IsDisabled ? "eb-row-disabled" : "")"
                     @onclick="() => OnEntityRowClickedAsync(q)">
                    <span class="eb-icon eb-icon-q" title="@(q.IsDisabled ? "Queue (disabled)" : "Queue")">Q</span>
                    <span class="eb-name" title="@q.Name">@q.Name</span>
                    @RenderStatsBadges(q)
                    <div class="eb-acts">
                        <button type="button" class="eb-act eb-act-open" title="Open active messages for '@q.Name'"
                                aria-label="Open active messages for @q.Name" @onclick:stopPropagation="true"
                                @onclick="() => OpenEntity(q)">
                            ▷
                        </button>
                        <button type="button"
                                class="eb-act eb-act-dlq @(q.Stats?.DeadLetterMessageCount > 0 ? "eb-act-dlq-hot" : "")"
                                title="Open dead-letter queue for '@q.Name'" aria-label="Open DLQ for @q.Name"
                                @onclick:stopPropagation="true" @onclick="() => OpenEntity(q, true)">
                            DLQ
                        </button>
                        <button type="button" class="eb-act eb-act-toggle @(q.IsDisabled ? "eb-act-enable" : "eb-act-disable")"
                                title="@(q.IsDisabled ? "Enable queue" : "Disable queue")" disabled="@IsMutating"
                                @onclick:stopPropagation="true" @onclick="() => ToggleEntityEnabledAsync(q)">
                            @(q.IsDisabled ? "Enable" : "Disable")
                        </button>
                        <button type="button" class="eb-act eb-act-pin @(qPinned ? "pinned" : "")"
                                title="@(qPinned ? "Unpin from dashboard" : "Pin to dashboard")"
                                aria-label="@(qPinned ? $"Unpin {q.Name} from dashboard" : $"Pin {q.Name} to dashboard")"
                                @onclick:stopPropagation="true" @onclick="() => ToggleLink(q.EntityPath)">
                            @(qPinned ? "★" : "☆")
                        </button>
                    </div>
                </div>
            }
        }

        @if (ft.Any())
        {
            <div class="eb-section @(fq.Any() ? "eb-section--spaced" : "")">
                <span class="eb-section-label">Topics</span>
                <span class="eb-section-count">@ft.Count</span>
            </div>

            @foreach (var t in ft)
            {
                var isExpanded = ExpandedTopics.Contains(t.Name);
                <div @key="t.EntityPath" class="eb-row eb-row-topic @(_selectedPath == t.EntityPath ? "selected" : "")"
                     @onclick="() => OnTopicRowClickedAsync(t)">
                    <span class="eb-expand">@(isExpanded ? "▾" : "▸")</span>
                    <span class="eb-icon eb-icon-t">T</span>
                    <span class="eb-name" title="@t.Name">@t.Name</span>
                    <div class="eb-acts"></div>
                </div>

                @if (isExpanded)
                {
                    @if (_loadingTopics.Contains(t.Name))
                    {
                        <div class="eb-sub-loading">
                            <SkeletonRows Count="2" />
                        </div>
                    }
                    else if (Subscriptions.TryGetValue(t.Name, out var subs))
                    {
                        @foreach (var s in subs)
                        {
                            var sPinned = IsEntityLinked(s.EntityPath);
                            <div @key="s.EntityPath"
                                 class="eb-row eb-row-sub @(_selectedPath == s.EntityPath ? "selected" : "") @(s.IsDisabled ? "eb-row-disabled" : "")"
                                 @onclick="() => OnEntityRowClickedAsync(s)">
                                <span class="eb-sub-indent"></span>
                                <span class="eb-icon eb-icon-s" title="@(s.IsDisabled ? "Subscription (disabled)" : "Subscription")">S</span>
                                <span class="eb-name" title="@s.Name">@s.Name</span>
                                @RenderStatsBadges(s)
                                <div class="eb-acts">
                                    <button type="button" class="eb-act eb-act-open" title="Open active messages for '@s.Name'"
                                            aria-label="Open active messages for @s.Name" @onclick:stopPropagation="true"
                                            @onclick="() => OpenEntity(s)">
                                        ▷
                                    </button>
                                    <button type="button"
                                            class="eb-act eb-act-dlq @(s.Stats?.DeadLetterMessageCount > 0 ? "eb-act-dlq-hot" : "")"
                                            title="Open dead-letter queue for '@s.Name'" aria-label="Open DLQ for @s.Name"
                                            @onclick:stopPropagation="true" @onclick="() => OpenEntity(s, true)">
                                        DLQ
                                    </button>
                                    <button type="button" class="eb-act eb-act-toggle @(s.IsDisabled ? "eb-act-enable" : "eb-act-disable")"
                                            title="@(s.IsDisabled ? "Enable subscription" : "Disable subscription")" disabled="@IsMutating"
                                            @onclick:stopPropagation="true" @onclick="() => ToggleEntityEnabledAsync(s)">
                                        @(s.IsDisabled ? "Enable" : "Disable")
                                    </button>
                                    <button type="button" class="eb-act eb-act-pin @(sPinned ? "pinned" : "")"
                                            title="@(sPinned ? "Unpin from dashboard" : "Pin to dashboard")"
                                            aria-label="@(sPinned ? $"Unpin {s.Name}" : $"Pin {s.Name} to dashboard")"
                                            @onclick:stopPropagation="true" @onclick="() => ToggleLink(s.EntityPath)">
                                        @(sPinned ? "★" : "☆")
                                    </button>
                                </div>
                            </div>
                        }
                    }
                }
            }
        }

        @if (!string.IsNullOrWhiteSpace(OperationMessage))
        {
            <div class="eb-op-message">@OperationMessage</div>
        }
    }
</div>

@code {
    [Parameter] public IServiceBusClient? Client { get; set; }
    [Parameter] public Guid NamespaceId { get; set; }
    [Parameter] public IReadOnlyList<SbEntityLink> LinkedEntities { get; set; } = [];
    [Parameter] public EventCallback<SbEntityInfo> OnEntitySelected { get; set; }
    [Parameter] public EventCallback<(SbEntityInfo Entity, bool IsDlq)> OnEntityModeSelected { get; set; }
    [Parameter] public EventCallback<SbEntityLink> OnEntityLinkToggled { get; set; }

    private bool IsLoading;
    private string? ErrorMessage;
    private List<SbEntityInfo> Queues = [];
    private List<SbEntityInfo> Topics = [];
    private Dictionary<string, List<SbEntityInfo>> Subscriptions = [];
    private HashSet<string> ExpandedTopics = [];
    private HashSet<string> _loadingTopics = [];
    private IServiceBusClient? _loadedClient;
    private bool IsMutating;
    private string? OperationMessage;
    private string? _selectedPath;
    private string _filter = string.Empty;

    // Background stats — shared semaphore caps concurrent API calls across all open namespaces
    private CancellationTokenSource _statsCts = new();
    private static readonly SemaphoreSlim _statsGate = new(6, 6);

    private List<SbEntityInfo> FilteredQueues =>
        string.IsNullOrWhiteSpace(_filter)
            ? Queues
            : Queues.Where(q => q.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<SbEntityInfo> FilteredTopics =>
        string.IsNullOrWhiteSpace(_filter)
            ? Topics
            : Topics.Where(t => t.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (Client is null)
        {
            Queues = []; Topics = []; Subscriptions = [];
            ExpandedTopics = []; _loadingTopics = [];
            _loadedClient = null; _selectedPath = null;
            await CancelStatsCtsAsync();
            return;
        }

        if (!ReferenceEquals(_loadedClient, Client))
        {
            _loadedClient = Client;
            await LoadAsync();
        }
    }

    private async Task RefreshAsync()
    {
        Subscriptions.Clear();
        ExpandedTopics.Clear();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Client is null) return;

        await CancelStatsCtsAsync();
        var ct = _statsCts.Token;

        IsLoading = true; ErrorMessage = null;
        Queues = []; Topics = [];
        await InvokeAsync(StateHasChanged);
        try
        {
            Queues = (await Client.ListQueuesAsync(ct)).ToList();
            await InvokeAsync(StateHasChanged);

            Topics = (await Client.ListTopicsAsync(ct)).ToList();
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            var hint = ex.Message.Contains("401") || ex.Message.Contains("403") ||
                       ex.Message.Contains("Unauthorized") || ex.Message.Contains("Forbidden")
                ? " (Connection string needs Manage rights.)" : string.Empty;
            ErrorMessage = $"Failed to load: {ex.Message}{hint}";
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }

        // Fire background stats — intentionally not awaited
        _ = LoadStatsInBackgroundAsync(Queues, ct);
    }

    private async Task LoadStatsInBackgroundAsync(IReadOnlyList<SbEntityInfo> entities, CancellationToken ct)
    {
        var client = Client;
        if (client is null) return;

        var tasks = entities
            .Where(e => !e.IsTopic)
            .Select(async entity =>
            {
                if (ct.IsCancellationRequested) return;
                await _statsGate.WaitAsync(ct).ConfigureAwait(false);
                try
                {
                    if (ct.IsCancellationRequested) return;
                    entity.Stats = await client.GetEntityStatsAsync(entity.EntityPath, ct);
                    if (!ct.IsCancellationRequested)
                        await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException) { }
                catch { entity.Stats = new SbEntityStats(); }
                finally { _statsGate.Release(); }
            });

        await Task.WhenAll(tasks);
    }

    private async Task ToggleTopic(string name)
    {
        if (ExpandedTopics.Contains(name))
        {
            ExpandedTopics.Remove(name);
            await InvokeAsync(StateHasChanged);
            return;
        }
        ExpandedTopics.Add(name);

        if (!Subscriptions.ContainsKey(name) && Client is not null)
        {
            _loadingTopics.Add(name);
            await InvokeAsync(StateHasChanged);
            try
            {
                var subs = (await Client.ListSubscriptionsAsync(name, _statsCts.Token)).ToList();
                Subscriptions[name] = subs;
                _loadingTopics.Remove(name);
                await InvokeAsync(StateHasChanged);
                _ = LoadStatsInBackgroundAsync(subs, _statsCts.Token);
            }
            catch (OperationCanceledException)
            {
                _loadingTopics.Remove(name);
            }
            catch (Exception ex)
            {
                _loadingTopics.Remove(name);
                OperationMessage = $"Failed to load subscriptions for {name}: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleEntityEnabledAsync(SbEntityInfo entity)
    {
        if (Client is null || IsMutating) return;
        var shouldEnable = entity.IsDisabled;
        IsMutating = true; OperationMessage = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (entity.IsSubscription)
            {
                if (!TryResolveSubscription(entity, out var topicName, out var subName))
                    throw new InvalidOperationException($"Cannot resolve subscription path for '{entity.EntityPath}'.");
                await Client.SetSubscriptionEnabledAsync(topicName, subName, shouldEnable);
            }
            else if (entity.IsTopic)
                await Client.SetTopicEnabledAsync(entity.Name, shouldEnable);
            else
                await Client.SetQueueEnabledAsync(entity.Name, shouldEnable);

            entity.IsDisabled = !shouldEnable;
            OperationMessage = $"{(shouldEnable ? "Enabled" : "Disabled")} {entity.Name}.";
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex) { OperationMessage = $"Failed to update {entity.Name}: {ex.Message}"; }
        finally
        {
            IsMutating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnEntityRowClickedAsync(SbEntityInfo entity)
    {
        _selectedPath = entity.EntityPath;
        await OpenEntity(entity);
    }

    private async Task OnTopicRowClickedAsync(SbEntityInfo topic)
    {
        _selectedPath = topic.EntityPath;
        await ToggleTopic(topic.Name);
    }

    private async Task OpenEntity(SbEntityInfo entity, bool isDlq = false)
    {
        if (OnEntityModeSelected.HasDelegate)
        {
            await OnEntityModeSelected.InvokeAsync((entity, isDlq));
            return;
        }
        await OnEntitySelected.InvokeAsync(entity);
    }

    private RenderFragment RenderStatsBadges(SbEntityInfo entity) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "eb-badges");
        if (entity.Stats is null)
        {
            builder.OpenElement(2, "span");
            builder.AddAttribute(3, "class", "eb-badge-loading");
            builder.AddContent(4, "·");
            builder.CloseElement();
        }
        else
        {
            if (entity.Stats.ActiveMessageCount > 0)
            {
                builder.OpenElement(5, "span");
                builder.AddAttribute(6, "class", "eb-badge eb-badge-active");
                builder.AddAttribute(7, "title", $"{entity.Stats.ActiveMessageCount} active");
                builder.AddContent(8, $"● {entity.Stats.ActiveMessageCount}");
                builder.CloseElement();
            }
            if (entity.Stats.DeadLetterMessageCount > 0)
            {
                builder.OpenElement(9, "span");
                builder.AddAttribute(10, "class", "eb-badge eb-badge-dlq");
                builder.AddAttribute(11, "title", $"{entity.Stats.DeadLetterMessageCount} dead-lettered");
                builder.AddContent(12, $"⚠ {entity.Stats.DeadLetterMessageCount}");
                builder.CloseElement();
            }
            if (entity.Stats.ScheduledMessageCount > 0)
            {
                builder.OpenElement(13, "span");
                builder.AddAttribute(14, "class", "eb-badge eb-badge-sched");
                builder.AddAttribute(15, "title", $"{entity.Stats.ScheduledMessageCount} scheduled");
                builder.AddContent(16, $"⏱ {entity.Stats.ScheduledMessageCount}");
                builder.CloseElement();
            }
        }
        builder.CloseElement();
    };

    private static bool TryResolveSubscription(SbEntityInfo entity, out string topicName, out string subscriptionName)
    {
        topicName = entity.TopicName ?? string.Empty;
        subscriptionName = entity.Name;
        if (!string.IsNullOrWhiteSpace(topicName) && !string.IsNullOrWhiteSpace(subscriptionName)) return true;
        const string marker = "/subscriptions/";
        var idx = entity.EntityPath.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (idx <= 0) { topicName = string.Empty; subscriptionName = string.Empty; return false; }
        topicName = entity.EntityPath[..idx];
        subscriptionName = entity.EntityPath[(idx + marker.Length)..];
        return !string.IsNullOrWhiteSpace(topicName) && !string.IsNullOrWhiteSpace(subscriptionName);
    }

    private bool IsEntityLinked(string entityPath) =>
        LinkedEntities.Any(l => l.NamespaceId == NamespaceId && l.EntityPath == entityPath);

    private Task ToggleLink(string entityPath) =>
        OnEntityLinkToggled.InvokeAsync(new SbEntityLink { NamespaceId = NamespaceId, EntityPath = entityPath });

    private async Task CancelStatsCtsAsync()
    {
        try { await _statsCts.CancelAsync(); } catch { }
        _statsCts.Dispose();
        _statsCts = new CancellationTokenSource();
    }

    public async ValueTask DisposeAsync()
    {
        try { await _statsCts.CancelAsync(); } catch { }
        _statsCts.Dispose();
    }
}
