<div class="sb-entity-panel @(IsCollapsed ? "collapsed" : string.Empty)">
    <div class="sb-entity-panel-icon-strip">
        <button type="button" class="namespace-pane-toggle" title="Expand namespace panel"
                aria-label="Expand namespace panel" aria-expanded="false" @onclick="() => SetCollapsedAsync(false)">
            ▶
        </button>
        @foreach (var ns in NamespaceStates)
        {
            <button type="button" class="sb-ns-icon-badge" title="@ns.Namespace.Alias"
                    @onclick="() => ExpandNamespaceIconAsync(ns)">
                @(ns.Namespace.Alias.Length > 0 ? char.ToUpper(ns.Namespace.Alias[0]).ToString() : "?")
            </button>
        }
    </div>

    <div class="sb-entity-panel-body">
        <!-- Namespace panel header -->
        <div class="sb-ns-panel-header">
            <span class="sb-ns-panel-label">Namespaces</span>
            <div class="sb-ns-header-actions">
                <button type="button" class="sb-ns-header-btn sb-ns-header-btn-primary" @onclick="ToggleAddForm">+
                    Add</button>
                    <button type="button" class="namespace-pane-toggle sb-ns-header-btn sb-ns-header-btn-toggle"
                            title="Collapse namespace panel" aria-label="Collapse namespace panel" aria-expanded="true"
                            @onclick="() => SetCollapsedAsync(true)">
                        ◀
                    </button>
                </div>
            </div>

            <!-- Add namespace form -->
            @if (_showAddForm)
            {
                <div class="sb-add-form">
                    <div class="sb-add-form-field form-group">
                        <label class="sb-add-form-label form-label">Connection string</label>
                        @if (_showConnStr)
                        {
                            <textarea @bind="_addConnStr" rows="3"
                                      placeholder="Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=..."
                                      class="sb-add-form-input sb-add-form-textarea form-input" aria-label="Connection string" />
                        }
                        else
                        {
                            <PasswordField Value="@_addConnStr" ValueChanged="@(v => _addConnStr = v ?? string.Empty)"
                                           Label="Connection string"
                                           Placeholder="Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=..."
                                           InputClass="sb-add-form-input form-input" />
                        }
                        <div class="sb-add-form-hint">Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=...</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_addError))
                    {
                        <div class="sb-add-form-error">@_addError</div>
                    }
                    <div class="sb-add-form-actions">
                        <button type="button" class="sb-add-form-btn sb-add-form-btn-primary"
                                @onclick="HandleAddAsync">Add</button>
                        <button type="button" class="sb-add-form-btn sb-add-form-btn-secondary"
                                @onclick="() => _showConnStr = !_showConnStr"
                                title="@(_showConnStr ? "Hide connection string" : "Show connection string")">@(_showConnStr ?
                                                    "Hide" : "Show")</button>
                            <button type="button" class="sb-add-form-btn sb-add-form-btn-secondary"
                                    @onclick="CancelAdd">Cancel</button>
                        </div>
                    </div>
                }

                <!-- Namespace list -->
                <div class="sb-ns-list">
                    @if (!NamespaceStates.Any())
                    {
                        <div class="sb-empty-hint">
                            No namespaces added yet. Click <strong>+ Add</strong> and paste a connection string.
                        </div>
                    }

                    @foreach (var ns in NamespaceStates)
                    {
                        <!-- Namespace header row -->
                        <div class="sb-ns-row" @onclick="() => ToggleNamespace(ns.Namespace.Id)">
                            <div class="sb-ns-row-main">
                                <span class="sb-ns-row-chevron">@(ns.IsExpanded ? "▼" : "▶")</span>
                                <span class="sb-ns-row-alias"
                                      title="@ns.Namespace.FullyQualifiedNamespace">@ns.Namespace.Alias</span>
                            </div>

                            <div class="sb-ns-row-meta">
                                @if (ns.IsConnecting)
                                {
                                    <span class="sb-ns-row-status sb-ns-row-status-connecting">Connecting...</span>
                                }
                                else if (ns.Client is not null)
                                {
                                    <span class="sb-ns-row-status sb-ns-row-status-success" title="Connected">
                                        <FluentIcon Value="@(new Icons.Filled.Size12.Circle())" Width="10px" /> Connected
                                    </span>
                                }
                                else
                                {
                                    <span class="sb-ns-row-status sb-ns-row-status-error" title="@ns.ConnectionError">
                                        <FluentIcon Value="@(new Icons.Filled.Size12.Circle())" Width="10px" /> Error
                                    </span>
                                }
                            </div>

                            <div class="sb-ns-row-actions">
                                <button type="button" class="sb-ns-row-icon-btn" title="View scheduled messages for this namespace"
                                        aria-label="View scheduled messages for @ns.Namespace.Alias" @onclick:stopPropagation="true"
                                        @onclick="() => OnScheduledTabOpen.InvokeAsync(ns)">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Clock())" Width="14px" />
                                </button>
                                <button type="button" class="sb-ns-row-icon-btn sb-ns-row-icon-btn-danger" title="Remove namespace"
                                        aria-label="Remove namespace @ns.Namespace.Alias" @onclick:stopPropagation="true"
                                        @onclick="() => OnRemoveNamespace.InvokeAsync(ns.Namespace.Id)">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="12px" />
                                </button>
                            </div>
                        </div>

                        @if (ns.IsExpanded)
                        {
                            @if (ns.ConnectionError is not null && ns.Client is null)
                            {
                                <div class="sb-ns-error-message">@ns.ConnectionError</div>
                            }
                            else
                            {
                                <EntityTree Client="ns.Client" NamespaceId="ns.Namespace.Id" LinkedEntities="LinkedEntities"
                                            OnEntitySelected="entity => OnEntityTabOpen.InvokeAsync((ns, entity, false))"
                                            OnEntityModeSelected="selection => OnEntityTabOpen.InvokeAsync((ns, selection.Entity, selection.IsDlq))"
                                            OnEntityLinkToggled="link => OnEntityLinkToggled.InvokeAsync(link)" />
                            }
                        }
                    }
                </div>
            </div>
        </div>

@code {
    [Parameter] public List<NsState> NamespaceStates { get; set; } = [];
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public IReadOnlyList<SbEntityLink> LinkedEntities { get; set; } = [];
    [Parameter] public EventCallback<(NsState Ns, SbEntityInfo Entity, bool IsDlq)> OnEntityTabOpen { get; set; }
    [Parameter] public EventCallback<NsState> OnScheduledTabOpen { get; set; }
    [Parameter] public EventCallback<bool> OnCollapsedChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnRemoveNamespace { get; set; }
    [Parameter] public EventCallback<string> OnAddNamespace { get; set; }
    [Parameter] public EventCallback<SbEntityLink> OnEntityLinkToggled { get; set; }

    private bool _showAddForm;
    private string _addConnStr = string.Empty;
    private string? _addError;
    private bool _showConnStr;

    protected override void OnParametersSet()
    {
        if (IsCollapsed)
            _showAddForm = false;
    }

    private void ToggleAddForm()
    {
        _showAddForm = !_showAddForm;
        _addConnStr = string.Empty;
        _addError = null;
        _showConnStr = false;
    }

    private void CancelAdd()
    {
        _showAddForm = false;
        _addConnStr = string.Empty;
        _addError = null;
        _showConnStr = false;
    }

    private async Task SetCollapsedAsync(bool collapsed)
    {
        if (collapsed)
            _showAddForm = false;
        await OnCollapsedChanged.InvokeAsync(collapsed);
    }

    private async Task ExpandNamespaceIconAsync(NsState ns)
    {
        if (IsCollapsed)
            await OnCollapsedChanged.InvokeAsync(false);
        ns.IsExpanded = true;
    }

    private void ToggleNamespace(Guid id)
    {
        var ns = NamespaceStates.FirstOrDefault(s => s.Namespace.Id == id);
        if (ns is not null) ns.IsExpanded = !ns.IsExpanded;
    }

    private async Task HandleAddAsync()
    {
        _addError = null;
        var raw = _addConnStr.Trim();
        if (string.IsNullOrWhiteSpace(raw))
        {
            _addError = "Connection string is required.";
            return;
        }

        string fqns;
        try
        {
            var props = global::Azure.Messaging.ServiceBus.ServiceBusConnectionStringProperties.Parse(raw);
            fqns = props.FullyQualifiedNamespace;
            if (string.IsNullOrWhiteSpace(fqns))
                throw new FormatException("Could not determine namespace from connection string.");
        }
        catch (Exception ex)
        {
            _addError = $"Invalid connection string: {ex.Message}";
            return;
        }

        // Duplicate check using parameter data
        if (NamespaceStates.Any(n => n.Namespace.FullyQualifiedNamespace.Equals(fqns, StringComparison.OrdinalIgnoreCase)))
        {
            _addError = "This namespace is already added.";
            return;
        }

        await OnAddNamespace.InvokeAsync(raw);
        _showAddForm = false;
        _addConnStr = string.Empty;
        _showConnStr = false;
    }
}
