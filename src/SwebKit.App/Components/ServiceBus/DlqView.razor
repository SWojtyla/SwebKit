@inject AppStateService AppState
@inject ITaskQueue TaskQueue
@inject IJSRuntime JS
@inject ILogger<DlqView> Logger
@using SwebKit.Core.Models

<div style="display:flex; flex-direction:column; height:100%;">
    <div
        style="padding:6px 12px; background:rgba(229,57,53,0.1); border-bottom:1px solid var(--color-error); font-size:12px; color:#FF6B6B; font-weight:600;">
        <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Width="14px" style="vertical-align:middle;" />
        Dead-Letter Queue — @EntityPath
    </div>

    <div style="display:flex; flex:1; overflow:hidden;">
        <div style="flex:1; overflow:hidden; display:flex; flex-direction:column;">
            <MessageListView Client="Client" EntityPath="@EntityPath" IsDlqMode="true" ShowDlqColumns="true"
                             RefreshToken="@_refreshToken" MultiSelect="true" SelectedMessage="SelectedMessage"
                             TracePivotFilter="@_dlqPivotFilter"
                             OnMessageSelected="msg => { SelectedMessage = msg; StateHasChanged(); }"
                             OnMultiSelectionChanged="OnBatchSelectionChanged" />

            @if (_showBatchReplayPanel)
            {
                <div
                    style="border-top:1px solid var(--color-border); padding:12px; flex-shrink:0; overflow:auto; max-height:420px;">
                    <BatchReplayPanel Client="Client" SourceEntityPath="@EntityPath" Messages="@_batchSelected"
                                      AvailableNamespaces="@AvailableNamespaces" OnCancel="CloseBatchReplayPanel"
                                      OnCompleted="OnBatchReplayCompleted" />
                </div>
            }
            else if (_batchSelected.Count > 0)
            {
                <div
                    style="padding:6px 12px; background:rgba(0,112,204,0.1); border-top:1px solid var(--color-border); display:flex; gap:8px; align-items:center; flex-shrink:0;">
                    <span style="font-size:12px; color:var(--color-text-muted);">@_batchSelected.Count selected</span>
                    <FluentButton Appearance="Appearance.Accent" Disabled="@IsWorking" @onclick="OpenBatchReplayPanel"
                                  data-testid="batch-resubmit-btn">
                        Resubmit @_batchSelected.Count…
                    </FluentButton>
                    <FluentButton Disabled="@IsWorking" @onclick="CompleteBatch">
                        Delete @_batchSelected.Count
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Stealth" @onclick="ClearBatchSelection">
                        Clear
                    </FluentButton>
                    @if (_batchProgressMessage is not null)
                    {
                        <span style="font-size:12px; color:var(--color-text-muted);">@_batchProgressMessage</span>
                    }
                </div>
            }
            else
            {
                <div
                    style="padding:8px 12px; border-top:1px solid var(--color-border); display:flex; gap:8px; flex-shrink:0;">
                    <FluentButton Appearance="Appearance.Accent" Disabled="@(SelectedMessage is null || IsWorking)"
                                  @onclick="ResubmitOne">
                        Resubmit to @EntityPath
                    </FluentButton>
                    <FluentButton Disabled="@(SelectedMessage is null || IsWorking)" @onclick="CompleteOne">
                        Complete (Delete)
                    </FluentButton>
                </div>
            }
        </div>

        <div @ref="_dlqSplitterRef" class="pane-splitter"></div>
        <div @ref="_dlqDetailRef" class="details-pane">
            <MessageDetailPane Message="SelectedMessage" OnApplyTracePivotFilter="ApplyDlqPivotFilter" />
        </div>
    </div>
</div>

<ConfirmDialog Visible="ShowConfirm" Title="@ConfirmTitle" Message="@ConfirmMessage"
               IsProduction="@AppState.Config.IsProduction" RequireTyping="@AppState.Config.IsProduction" ConfirmLabel="Proceed"
               OnConfirm="ExecuteAction" OnCancel="() => ShowConfirm = false" />

@code {
    [Parameter] public IServiceBusClient? Client { get; set; }
    [Parameter] public string? EntityPath { get; set; }
    [Parameter] public IReadOnlyList<MessageComposer.NamespaceOption>? AvailableNamespaces { get; set; }

    private SbMessage? SelectedMessage;
    private bool IsWorking;
    private string? _batchProgressMessage;
    private bool ShowConfirm;
    private string ConfirmTitle = "";
    private string ConfirmMessage = "";
    private Func<Task>? PendingAction;
    private List<SbMessage> _batchSelected = [];
    private bool _showBatchReplayPanel;
    private ElementReference _dlqSplitterRef;
    private ElementReference _dlqDetailRef;
    private IJSObjectReference? _dlqSplitterHandle;
    private long _refreshToken;
    private string? _dlqPivotFilter;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _dlqSplitterHandle is null)
        {
            try
            {
                _dlqSplitterHandle = await JS.InvokeAsync<IJSObjectReference>(
                    "SwebKitSplitter.init", _dlqSplitterRef, _dlqDetailRef,
                    new { minWidth = 200, maxWidth = 700 });
            }
            catch (Exception ex) { Logger.LogDebug(ex, "JS interop failed: {Method}", "SwebKitSplitter.init"); }
        }
    }

    private void OnBatchSelectionChanged(List<SbMessage> messages)
    {
        _batchSelected = messages;
        StateHasChanged();
    }

    private void ApplyDlqPivotFilter(string value)
    {
        _dlqPivotFilter = value;
        StateHasChanged();
    }

    private void ClearBatchSelection()
    {
        _batchSelected = [];
        StateHasChanged();
    }

    // --- Single-message actions ---

    private void ResubmitOne()
    {
        if (SelectedMessage is null || Client is null || EntityPath is null) return;
        ConfirmTitle = "Resubmit Message";
        ConfirmMessage = $"Resubmit message '{SelectedMessage.MessageId[..Math.Min(16, SelectedMessage.MessageId.Length)]}' to {EntityPath}?";
        PendingAction = DoResubmit;
        ShowConfirm = true;
    }

    private void CompleteOne()
    {
        if (SelectedMessage is null) return;
        ConfirmTitle = "Complete Message";
        ConfirmMessage = "Permanently delete this message from the DLQ?";
        PendingAction = DoComplete;
        ShowConfirm = true;
    }

    // --- Batch actions ---

    private void OpenBatchReplayPanel()
    {
        if (_batchSelected.Count == 0 || Client is null || EntityPath is null) return;
        _showBatchReplayPanel = true;
        StateHasChanged();
    }

    private void CloseBatchReplayPanel()
    {
        _showBatchReplayPanel = false;
        StateHasChanged();
    }

    private async Task OnBatchReplayCompleted(BatchOperationResult result)
    {
        _showBatchReplayPanel = false;
        if (result.Succeeded > 0)
        {
            _batchSelected.Clear();
            SelectedMessage = null;
            await RefreshDlqListAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void CompleteBatch()
    {
        if (_batchSelected.Count == 0) return;
        ConfirmTitle = $"Delete {_batchSelected.Count} Messages";
        ConfirmMessage = $"Permanently delete {_batchSelected.Count} message(s) from the DLQ?";
        PendingAction = DoBatchComplete;
        ShowConfirm = true;
    }

    private async Task ExecuteAction()
    {
        ShowConfirm = false;
        if (PendingAction is not null) await PendingAction();
        PendingAction = null;
    }

    private async Task RefreshDlqListAsync()
    {
        _refreshToken++;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DoResubmit()
    {
        if (Client is null || EntityPath is null || SelectedMessage?.SequenceNumber is null) return;
        IsWorking = true;
        var task = TaskQueue.Enqueue("Resubmitting message", SelectedMessage.MessageId);
        try
        {
            await Client.ResubmitDeadLetterAsync(EntityPath, [SelectedMessage.SequenceNumber.Value.ToString()], null);
            TaskQueue.Complete(task.Id);
            SelectedMessage = null;
            await RefreshDlqListAsync();
        }
        catch (Exception ex)
        {
            TaskQueue.Update(task.Id, t => t.Detail = ex.Message);
            TaskQueue.Complete(task.Id, false);
        }
        finally { IsWorking = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task DoComplete()
    {
        if (Client is null || EntityPath is null || SelectedMessage?.SequenceNumber is null) return;
        IsWorking = true;
        var task = TaskQueue.Enqueue("Completing DLQ message", SelectedMessage.MessageId);
        try
        {
            await Client.CompleteDeadLetterAsync(EntityPath, [SelectedMessage.SequenceNumber.Value.ToString()]);
            TaskQueue.Complete(task.Id);
            SelectedMessage = null;
            await RefreshDlqListAsync();
        }
        catch (Exception ex)
        {
            TaskQueue.Update(task.Id, t => t.Detail = ex.Message);
            TaskQueue.Complete(task.Id, false);
        }
        finally { IsWorking = false; await InvokeAsync(StateHasChanged); }
    }



    private async Task DoBatchComplete()
    {
        if (Client is null || EntityPath is null) return;
        var seqNumbers = _batchSelected
            .Where(m => m.SequenceNumber is not null)
            .Select(m => m.SequenceNumber!.Value.ToString())
            .ToList();
        if (seqNumbers.Count == 0) return;

        IsWorking = true;
        var task = TaskQueue.Enqueue($"Completing {seqNumbers.Count} DLQ messages", EntityPath);
        try
        {
            if (seqNumbers.Count > 5)
            {
                var chunks = seqNumbers.Chunk(10).ToList();
                int done = 0;
                foreach (var chunk in chunks)
                {
                    await Client.CompleteDeadLetterAsync(EntityPath, chunk);
                    done += chunk.Length;
                    _batchProgressMessage = $"Deleting message {done} of {seqNumbers.Count}\u2026";
                    await InvokeAsync(StateHasChanged);
                }
            }
            else
            {
                await Client.CompleteDeadLetterAsync(EntityPath, seqNumbers);
            }
            TaskQueue.Complete(task.Id);
            _batchSelected.Clear();
            SelectedMessage = null;
            await RefreshDlqListAsync();
        }
        catch (Exception ex)
        {
            TaskQueue.Update(task.Id, t => t.Detail = ex.Message);
            TaskQueue.Complete(task.Id, false);
        }
        finally { IsWorking = false; _batchProgressMessage = null; await InvokeAsync(StateHasChanged); }
    }
}