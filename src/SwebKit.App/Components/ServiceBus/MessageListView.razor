    private string FilterScopeKey =>
        NamespaceId.HasValue && EntityPath is not null
            ? $"{NamespaceId.Value}:{EntityPath}"
            : EntityPath ?? "";

    private string PreferenceScopeKey =>
        string.IsNullOrWhiteSpace(FilterScopeKey)
            ? ""
            : $"{FilterScopeKey}:{(IsDlqMode ? "dlq" : "active")}";

    private IReadOnlyList<SavedFilter> SavedFilters =>
        string.IsNullOrWhiteSpace(FilterScopeKey) ? [] : UiState.GetFilters(FilterScopeKey);

    private IReadOnlyList<string> SuggestedCustomPropertyColumns => Messages
        .SelectMany(m => m.ApplicationProperties.Keys)
        .Where(key => !string.IsNullOrWhiteSpace(key))
        .Select(key => key.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Where(key => _customPropertyColumns.All(existing => !string.Equals(existing, key, StringComparison.OrdinalIgnoreCase)))
        .Take(8)
        .ToList();

    private List<SbMessage> FilteredMessages => ApplyFilters(Messages);

    private bool HasTextFilter => !string.IsNullOrWhiteSpace(TextFilter);
    private bool HasEnabledAdvancedRules => _advancedRules.Any(r => r.Enabled && IsRuleConfigured(r));
    private bool HasAnySavedCriteria => HasTextFilter || _advancedRules.Any(IsRuleConfigured);
    private bool IsFilteringActive => _filtersEnabled && (HasTextFilter || (_advancedFilterEnabled &&
HasEnabledAdvancedRules));
    private bool CanSaveCurrentFilter => HasAnySavedCriteria;
    private bool CanDeleteFilteredMessages =>
        !string.IsNullOrWhiteSpace(EntityPath)
        && IsFilteringActive
        && GetFilteredSequenceNumbers().Count > 0;
    private bool CanAddCustomPropertyColumn => !string.IsNullOrWhiteSpace(_newCustomPropertyColumn);

    private string NoMatchesSubtitle =>
        "No messages match the current filter criteria. Try a different rule or disable filters.";

    private string CurrentFilterSummary
    {
        get
        {
            var textPart = HasTextFilter ? $"Text: \"{TextFilter}\"" : "Text: (none)";
            var advancedCount = _advancedRules.Count(r => r.Enabled && IsRuleConfigured(r));
            var advancedPart = _advancedFilterEnabled
                ? $"Advanced: {advancedCount} enabled rule(s)"
                : "Advanced: off";
            var enabledPart = _filtersEnabled ? "Filters on" : "Filters off";

            return $"{enabledPart} · {textPart} · {advancedPart}";
        }
    }

    private static Dictionary<string, bool> CreateDefaultBuiltInColumnVisibility() => new(StringComparer.Ordinal)
    {
        [ColumnEnqueued] = true,
        [ColumnMessageId] = true,
        [ColumnCorrelationId] = true,
        [ColumnSubject] = true,
        [ColumnDelivery] = true,
        [ColumnExpires] = true,
        [ColumnContentType] = true,
        [ColumnSession] = true,
        [ColumnDeadLetterReason] = true
    };

    private static bool ParseCheckboxValue(ChangeEventArgs args)
    {
        if (args.Value is bool boolValue) return boolValue;
        return bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
    }

    private bool IsBuiltInColumnVisible(string columnKey)
    {
        if (_visibleBuiltInColumns.TryGetValue(columnKey, out var isVisible))
        {
            return isVisible;
        }

        return true;
    }

    private int ItemSize => _density switch
    {
        "compact" => 28,
        "comfort" => 44,
        _ => 36
    };

    private int CurrentWindowRequestCount =>
        _requestedWindowSize > 0 ? _requestedWindowSize : NormalizePeekCount(PeekCount);

    private bool CanLoadMore =>
        !IsLoading
        && !IsMutating
        && !string.IsNullOrWhiteSpace(EntityPath)
        && TotalAvailableCount is long total
        && Messages.Count < total;

    private bool IsAllMessagesLoaded =>
        TotalAvailableCount is long total
        && Messages.Count >= total
        && Messages.Count > 0;

    private string LoadMoreButtonLabel
    {
        get
        {
            if (_isLoadingMoreWindow && IsLoading)
            {
                return "Loading more...";
            }

            if (IsAllMessagesLoaded)
            {
                return "All Loaded";
            }

            return $"Load More (+{NormalizePeekCount(PeekCount)})";
        }
    }

    private string WindowStatusSummary
    {
        get
        {
            if (TotalAvailableCount is long total)
            {
                var loaded = Messages.Count;
                if (loaded >= total)
                {
                    return $"Window {loaded}/{total} loaded";
                }

                var nextTarget = Math.Min(total, (long)CurrentWindowRequestCount + NormalizePeekCount(PeekCount));
                return $"Window {loaded}/{total} loaded · next target {nextTarget}";
            }

            return $"Window {Messages.Count} loaded";
        }
    }

    private static int NormalizePeekCount(int count) => count > 0 ? count : 1;

    private static int ExpandWindowSize(int currentWindowSize, int pageSize)
    {
        var expanded = (long)currentWindowSize + pageSize;
        return expanded >= int.MaxValue ? int.MaxValue : (int)expanded;
    }

    private string GetRowClass(SbMessage m)
    {
        if (MultiSelect && _selection.Any && _selection.IsSelected(m.MessageId))
            return "selected-row";
        if (!MultiSelect && SelectedMessage?.MessageId == m.MessageId)
            return "selected-row";
        return "";
    }

    private async Task ToggleSelection(SbMessage msg, bool selected)
    {
        _selection.Toggle(msg.MessageId, selected);
        var batch = Messages.Where(m => _selection.IsSelected(m.MessageId)).ToList();
        await OnMultiSelectionChanged.InvokeAsync(batch);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSelectAll()
    {
        if (_selection.Count == Messages.Count && Messages.Count > 0)
            _selection.Clear();
        else
            _selection.SelectAll(Messages.Select(m => m.MessageId));

        var batch = Messages.Where(m => _selection.IsSelected(m.MessageId)).ToList();
        await OnMultiSelectionChanged.InvokeAsync(batch);
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyAutoRefresh()
    {
        _autoRefresh.SetInterval(_autoRefreshSeconds, async () =>
        {
            await InvokeAsync(LoadAsync);
        });
    }

    private async Task LoadInitialWindowAsync()
    {
        _requestedWindowSize = NormalizePeekCount(PeekCount);
        _isLoadingMoreWindow = false;
        await LoadAsync();
    }

    private async Task LoadMoreAsync()
    {
        if (!CanLoadMore)
        {
            return;
        }

        _requestedWindowSize = ExpandWindowSize(CurrentWindowRequestCount, NormalizePeekCount(PeekCount));
        _isLoadingMoreWindow = true;
        await LoadAsync();
    }

    private async Task OnComposerSent()
    {
        _showComposer = false;
        await LoadAsync();
    }

    private void ToggleFiltersEnabled()
    {
        _filtersEnabled = !_filtersEnabled;
    }

    private void ToggleAdvancedFilterEnabled()
    {
        if (!_filtersEnabled) return;
        _advancedFilterEnabled = !_advancedFilterEnabled;
        if (_advancedFilterEnabled && _advancedRules.Count == 0)
        {
            AddAdvancedRule();
        }
    }

    private void AddAdvancedRule()
    {
        _advancedRules.Add(new AdvancedFilterRule());
    }

    private void RemoveAdvancedRule(Guid ruleId)
    {
        _advancedRules.RemoveAll(r => r.Id == ruleId);
    }

    private void ChangeRuleField(AdvancedFilterRule rule, string? field)
    {
        if (rule is null || string.IsNullOrWhiteSpace(field)) return;
        rule.Field = NormalizeField(field);
        rule.Operator = DefaultOperatorForField(rule.Field);
        if (!RequiresPropertyName(rule.Field))
        {
            rule.PropertyName = "";
        }
    }

    private static void ChangeRuleOperator(AdvancedFilterRule rule, string? op)
    {
        if (rule is null || string.IsNullOrWhiteSpace(op)) return;
        rule.Operator = op;
    }

    private void ToggleColumnChooser()
    {
        _showColumnChooser = !_showColumnChooser;
    }

    private async Task SetBuiltInColumnVisibleAsync(string columnKey, bool isVisible)
    {
        _visibleBuiltInColumns[columnKey] = isVisible;
        await PersistMessageListPreferencesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddCustomPropertyColumnAsync()
    {
        await AddCustomPropertyColumnAsync(_newCustomPropertyColumn);
    }

    private async Task AddCustomPropertyColumnAsync(string? columnName)
    {
        var normalized = NormalizeCustomPropertyColumnName(columnName);
        if (normalized is null)
        {
            return;
        }

        if (_customPropertyColumns.Any(existing => string.Equals(existing, normalized, StringComparison.OrdinalIgnoreCase)))
        {
            _newCustomPropertyColumn = "";
            return;
        }

        _customPropertyColumns.Add(normalized);
        _newCustomPropertyColumn = "";
        await PersistMessageListPreferencesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveCustomPropertyColumnAsync(string columnName)
    {
        _customPropertyColumns.RemoveAll(existing => string.Equals(existing, columnName, StringComparison.OrdinalIgnoreCase));
        await PersistMessageListPreferencesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetColumnPreferencesAsync()
    {
        _density = "default";
        _visibleBuiltInColumns = CreateDefaultBuiltInColumnVisibility();
        _customPropertyColumns.Clear();
        _newCustomPropertyColumn = "";
        _showColumnChooser = false;

        if (!string.IsNullOrWhiteSpace(PreferenceScopeKey))
        {
            await UiState.ResetMessageListPreferencesAsync(PreferenceScopeKey);
        }

        await InvokeAsync(StateHasChanged);
    }

    private static string? NormalizeCustomPropertyColumnName(string? columnName)
    {
        if (string.IsNullOrWhiteSpace(columnName))
        {
            return null;
        }

        return columnName.Trim();
    }

    private static string GetCustomPropertyValue(SbMessage message, string propertyName)
    {
        if (message.ApplicationProperties is null || string.IsNullOrWhiteSpace(propertyName))
        {
            return "-";
        }

        if (message.ApplicationProperties.TryGetValue(propertyName, out var directValue))
        {
            return Convert.ToString(directValue, CultureInfo.InvariantCulture) ?? "-";
        }

        foreach (var kvp in message.ApplicationProperties)
        {
            if (string.Equals(kvp.Key, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                return Convert.ToString(kvp.Value, CultureInfo.InvariantCulture) ?? "-";
            }
        }

        return "-";
    }

    private bool CanDeleteSelectedMessage =>
        !IsDlqMode
        && !string.IsNullOrWhiteSpace(EntityPath)
        && SelectedMessage?.SequenceNumber is long;

    private string CountSummary
    {
        get
        {
            var filteredCount = FilteredMessages.Count;
            var loadedCount = Messages.Count;
            var hasFilter = IsFilteringActive;
            var selectedInfo = MultiSelect && _selection.Any ? $" · {_selection.Count} selected" : "";
            var refreshInfo = _autoRefreshSeconds > 0 ? $" · auto-refresh {_autoRefreshSeconds}s" : "";

            if (TotalAvailableCount is long total)
            {
                if (hasFilter)
                    return total > loadedCount
                        ? $"Showing {filteredCount} filtered of {loadedCount} loaded ({total} total){selectedInfo}{refreshInfo}"
                        : $"Showing {filteredCount} filtered of {loadedCount} loaded{selectedInfo}{refreshInfo}";

                return total > loadedCount
                    ? $"Showing {loadedCount} of {total} message(s){selectedInfo}{refreshInfo}"
                    : $"Showing {loadedCount} message(s){selectedInfo}{refreshInfo}";
            }

            return hasFilter
                ? $"Showing {filteredCount} filtered of {loadedCount} loaded{selectedInfo}{refreshInfo}"
                : $"Showing {loadedCount} message(s){selectedInfo}{refreshInfo}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Client is null || string.IsNullOrWhiteSpace(EntityPath))
        {
            Messages = [];
            TotalAvailableCount = null;
            ErrorMessage = null;
            IsLoading = false;
            _isLoadingMoreWindow = false;
            _requestedWindowSize = NormalizePeekCount(PeekCount);
            return;
        }

        var clientChanged = !ReferenceEquals(_loadedClient, Client);
        var entityChanged = !string.Equals(_loadedEntityPath, EntityPath, StringComparison.Ordinal);
        var modeChanged = _loadedIsDlqMode != IsDlqMode;
        var namespaceChanged = _loadedNamespaceId != NamespaceId;
        var refreshRequested = _loadedRefreshToken != RefreshToken;

        var shouldReload = clientChanged || entityChanged || modeChanged || namespaceChanged || refreshRequested;

        if (!shouldReload) return;

        _loadedClient = Client;
        _loadedEntityPath = EntityPath;
        _loadedIsDlqMode = IsDlqMode;
        _loadedNamespaceId = NamespaceId;
        _loadedRefreshToken = RefreshToken;

        if (clientChanged || entityChanged || modeChanged || namespaceChanged)
        {
            _selection.Clear();
            _isLoadingMoreWindow = false;
            _requestedWindowSize = NormalizePeekCount(PeekCount);
            LoadMessageListPreferences();
        }

        await LoadAsync();
    }

    private async Task SetDensityAsync(string density)
    {
        if (density is not ("compact" or "default" or "comfort")) return;
        _density = density;
        await PersistMessageListPreferencesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void LoadMessageListPreferences()
    {
        if (string.IsNullOrWhiteSpace(PreferenceScopeKey))
        {
            _loadedPreferenceScopeKey = null;
            _density = "default";
            _visibleBuiltInColumns = CreateDefaultBuiltInColumnVisibility();
            _customPropertyColumns.Clear();
            return;
        }

        if (string.Equals(_loadedPreferenceScopeKey, PreferenceScopeKey, StringComparison.Ordinal))
        {
            return;
        }

        _loadedPreferenceScopeKey = PreferenceScopeKey;

        var preference = UiState.GetMessageListPreferences(PreferenceScopeKey);

        _density = preference.RowDensity is "compact" or "default" or "comfort"
            ? preference.RowDensity
            : "default";

        var visibleColumns = CreateDefaultBuiltInColumnVisibility();
        foreach (var kvp in preference.BuiltInColumns)
        {
            if (visibleColumns.ContainsKey(kvp.Key))
            {
                visibleColumns[kvp.Key] = kvp.Value;
            }
        }

        _visibleBuiltInColumns = visibleColumns;

        _customPropertyColumns.Clear();
        foreach (var columnName in preference.CustomPropertyColumns)
        {
            var normalized = NormalizeCustomPropertyColumnName(columnName);
            if (normalized is null)
            {
                continue;
            }

            if (_customPropertyColumns.Any(existing => string.Equals(existing, normalized, StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }

            _customPropertyColumns.Add(normalized);
        }

        _newCustomPropertyColumn = "";
        _showColumnChooser = false;
    }

    private async Task PersistMessageListPreferencesAsync()
    {
        if (string.IsNullOrWhiteSpace(PreferenceScopeKey))
        {
            return;
        }

        await UiState.SaveMessageListPreferencesAsync(PreferenceScopeKey, new MessageListPreferences
        {
            RowDensity = _density,
            BuiltInColumns = new Dictionary<string, bool>(_visibleBuiltInColumns, StringComparer.Ordinal),
            CustomPropertyColumns = _customPropertyColumns.ToList()
        });
    }

    private async Task LoadAsync()
    {
        if (Client is null || EntityPath is null) return;

        var requestVersion = Interlocked.Increment(ref _loadVersion);
        var requestCount = CurrentWindowRequestCount;
        IsLoading = true;
        ErrorMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            long? totalAvailableCount = null;

            var loadedMessages = (IsDlqMode
                ? (await Client.PeekDeadLetterAsync(EntityPath, requestCount)).ToList()
                : (await Client.PeekMessagesAsync(EntityPath, requestCount)).ToList());

            try
            {
                var stats = await Client.GetEntityStatsAsync(EntityPath);
                totalAvailableCount = IsDlqMode ? stats.DeadLetterMessageCount : stats.ActiveMessageCount;
            }
            catch
            {
                totalAvailableCount = null;
            }

            if (requestVersion == _loadVersion)
            {
                var currentIds = loadedMessages.Select(m => m.MessageId).ToHashSet();
                foreach (var id in _selection.Selected.ToList())
                    if (!currentIds.Contains(id)) _selection.Toggle(id, false);
                Messages = loadedMessages;
                TotalAvailableCount = totalAvailableCount;
            }
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            if (requestVersion == _loadVersion)
            {
                ErrorMessage = ex.Message;
                Messages = [];
                TotalAvailableCount = null;
            }
        }
        finally
        {
            if (requestVersion == _loadVersion)
            {
                IsLoading = false;
                _isLoadingMoreWindow = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private Task OnRowClickedAsync(SbMessage? msg)
    {
        _showFilterMenu = false;
        _showColumnChooser = false;
        if (msg is null) return Task.CompletedTask;
        return OnMessageSelected.InvokeAsync(msg);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var items = FilteredMessages;
        if (items.Count == 0) return;

        _preventKeyDefault = e.Key is "ArrowUp" or "ArrowDown" or "Escape";

        if (e.Key == "Escape")
        {
            await OnMessageSelected.InvokeAsync(null);
            return;
        }

        if (e.Key is not ("ArrowUp" or "ArrowDown")) return;

        var currentIdx = SelectedMessage is null
            ? -1
            : items.FindIndex(m => m.MessageId == SelectedMessage.MessageId);

        var newIdx = e.Key == "ArrowDown"
            ? Math.Min(currentIdx + 1, items.Count - 1)
            : Math.Max(currentIdx - 1, 0);

        if (newIdx >= 0 && newIdx < items.Count)
            await OnMessageSelected.InvokeAsync(items[newIdx]);
    }

    private void ConfirmDeleteSelectedMessage()
    {
        if (!CanDeleteSelectedMessage || SelectedMessage is null) return;

        var shortMessageId = SelectedMessage.MessageId.Length > 24
            ? $"{SelectedMessage.MessageId[..24]}..."
            : SelectedMessage.MessageId;

        _confirmTitle = "Delete Message";
        _confirmMessage = $"Permanently delete active message '{shortMessageId}'?";
        _confirmLabel = "Delete";
        _requireTypedConfirm = false;
        _pendingMutationAction = DeleteSelectedMessageAsync;
        _showMutationConfirm = true;
    }

    private void ConfirmDeleteFilteredMessages()
    {
        if (Client is null || string.IsNullOrWhiteSpace(EntityPath)) return;

        var sequenceNumbers = GetFilteredSequenceNumbers();
        if (sequenceNumbers.Count == 0) return;

        var filteredCount = FilteredMessages.Count;
        var modeLabel = IsDlqMode ? "DLQ" : "active";
        _confirmTitle = IsDlqMode ? "Delete Filtered DLQ Messages" : "Delete Filtered Active Messages";
        _confirmMessage =
            $"Delete {sequenceNumbers.Count} filtered message(s) from {modeLabel} mode for '{EntityPath}'? " +
            $"({filteredCount} currently visible match(es))";
        _confirmLabel = "Delete Filtered";
        _requireTypedConfirm = AppState.Config.IsProduction;
        _pendingMutationAction = DeleteFilteredMessagesAsync;
        _showMutationConfirm = true;
    }

    private void ConfirmPurgeAllMessages()
    {
        if (Client is null || string.IsNullOrWhiteSpace(EntityPath)) return;

        var modeLabel = IsDlqMode ? "dead-letter queue" : "active queue";
        _confirmTitle = IsDlqMode ? "Purge DLQ Messages" : "Purge Active Messages";
        _confirmMessage = $"Permanently delete all currently available messages from the {modeLabel} for '{EntityPath}'?";
        _confirmLabel = "Purge";
        _requireTypedConfirm = AppState.Config.IsProduction;
        _pendingMutationAction = PurgeAllMessagesAsync;
        _showMutationConfirm = true;
    }

    private Task CancelPendingMutationAsync()
    {
        _showMutationConfirm = false;
        _pendingMutationAction = null;
        return Task.CompletedTask;
    }

    private async Task ExecutePendingMutationAsync()
    {
        _showMutationConfirm = false;
        if (_pendingMutationAction is null) return;

        var pendingAction = _pendingMutationAction;
        _pendingMutationAction = null;
        await pendingAction();
    }

    private async Task DeleteSelectedMessageAsync()
    {
        if (Client is null || string.IsNullOrWhiteSpace(EntityPath) || SelectedMessage?.SequenceNumber is not long
sequenceNumber)
        {
            return;
        }

        var messageId = SelectedMessage.MessageId;
        await ExecuteMutationAsync(async () =>
        {
            var deleted = await Client.CompleteMessagesAsync(EntityPath, [sequenceNumber]);
            await OnMessageSelected.InvokeAsync(null);

            return deleted > 0
                ? $"Deleted message '{messageId}'."
                : $"No message was deleted for sequence #{sequenceNumber}. It may already be completed.";
        });
    }

    private async Task DeleteFilteredMessagesAsync()
    {
        if (Client is null || string.IsNullOrWhiteSpace(EntityPath))
        {
            return;
        }

        var sequenceNumbers = GetFilteredSequenceNumbers();
        if (sequenceNumbers.Count == 0)
        {
            return;
        }

        await ExecuteMutationAsync(async () =>
        {
            int deleted;
            if (IsDlqMode)
            {
                var dlqSequenceNumbers = sequenceNumbers
                    .Select(n => n.ToString(CultureInfo.InvariantCulture))
                    .ToList();
                await Client.CompleteDeadLetterAsync(EntityPath, dlqSequenceNumbers);
                deleted = dlqSequenceNumbers.Count;
            }
            else
            {
                deleted = await Client.CompleteMessagesAsync(EntityPath, sequenceNumbers);
            }

            _selection.Clear();
            await OnMultiSelectionChanged.InvokeAsync([]);
            await OnMessageSelected.InvokeAsync(null);

            var modeLabel = IsDlqMode ? "DLQ" : "active";
            return deleted > 0
                ? $"Deleted {deleted} filtered {modeLabel} message(s)."
                : $"No filtered {modeLabel} messages were deleted.";
        });
    }

    private async Task PurgeAllMessagesAsync()
    {
        if (Client is null || string.IsNullOrWhiteSpace(EntityPath))
        {
            return;
        }

        await ExecuteMutationAsync(async () =>
        {
            var deleted = await Client.PurgeMessagesAsync(EntityPath, IsDlqMode);

            _selection.Clear();
            await OnMessageSelected.InvokeAsync(null);
            await OnMultiSelectionChanged.InvokeAsync([]);

            var modeLabel = IsDlqMode ? "DLQ" : "active";
            return deleted > 0
                ? $"Purged {deleted} {modeLabel} message(s)."
                : $"No {modeLabel} messages were available to purge.";
        });
    }

    private async Task ExecuteMutationAsync(Func<Task<string>> mutation)
    {
        if (IsMutating) return;

        IsMutating = true;
        _operationFailed = false;
        ErrorMessage = null;
        OperationMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            OperationMessage = await mutation();
            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            OperationMessage = $"Operation failed: {ex.Message}";
            _operationFailed = true;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            IsMutating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Saved filters ────────────────────────────────────────────────────────

    private async Task ApplySavedFilter(SavedFilter f)
    {
        TextFilter = f.Value;
        _filtersEnabled = f.FiltersEnabled;
        _advancedFilterEnabled = f.AdvancedFilterEnabled;
        _advancedRules.Clear();
        if (f.AdvancedRules.Count > 0)
        {
            foreach (var savedRule in f.AdvancedRules)
            {
                _advancedRules.Add(FromSavedRule(savedRule));
            }
        }
        _showFilterMenu = false;
        await InvokeAsync(StateHasChanged);
    }

    private void SaveCurrentFilter()
    {
        _saveFilterName = "";
        _showSaveFilterDialog = true;
        _showFilterMenu = false;
    }

    private async Task ConfirmSaveFilter()
    {
        var name = _saveFilterName.Trim();
        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(FilterScopeKey)) return;

        var filter = new SavedFilter
        {
            Name = name,
            Value = TextFilter,
            FiltersEnabled = _filtersEnabled,
            AdvancedFilterEnabled = _advancedFilterEnabled,
            AdvancedRules = _advancedRules.Select(ToSavedRule).ToList()
        };

        await UiState.SaveFilterAsync(FilterScopeKey, filter);
        _showSaveFilterDialog = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteSavedFilter(string filterName)
    {
        if (string.IsNullOrWhiteSpace(FilterScopeKey)) return;
        await UiState.DeleteFilterAsync(FilterScopeKey, filterName);
        await InvokeAsync(StateHasChanged);
    }

    private static SavedAdvancedFilterRule ToSavedRule(AdvancedFilterRule rule) =>
        new()
        {
            Enabled = rule.Enabled,
            Field = rule.Field,
            Operator = rule.Operator,
            PropertyName = string.IsNullOrWhiteSpace(rule.PropertyName) ? null : rule.PropertyName.Trim(),
            Value = rule.Value
        };

    private static AdvancedFilterRule FromSavedRule(SavedAdvancedFilterRule savedRule)
    {
        var field = NormalizeField(savedRule.Field);
        var op = savedRule.Operator;
        var supportedOps = GetOperatorOptions(field).Select(o => o.Value).ToHashSet(StringComparer.Ordinal);
        if (!supportedOps.Contains(op))
        {
            op = DefaultOperatorForField(field);
        }

        return new AdvancedFilterRule
        {
            Enabled = savedRule.Enabled,
            Field = field,
            Operator = op,
            PropertyName = savedRule.PropertyName ?? "",
            Value = savedRule.Value ?? ""
        };
    }

    private string GetSavedFilterTooltip(SavedFilter filter)
    {
        var advancedCount = filter.AdvancedRules.Count(r => r.Enabled);
        var enabledLabel = filter.FiltersEnabled ? "on" : "off";
        var advancedLabel = filter.AdvancedFilterEnabled ? $"{advancedCount} advanced" : "advanced off";
        return $"{filter.Value} · filters {enabledLabel} · {advancedLabel}";
    }

    // ── Export ───────────────────────────────────────────────────────────────

    private async Task ExportFilteredJsonAsync()
    {
        var messages = FilteredMessages;
        if (messages.Count == 0) return;

        var ts = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        var entitySlug = (EntityPath ?? "messages").Replace('/', '-');

        var content = System.Text.Json.JsonSerializer.Serialize(messages,
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        var fileName = $"{entitySlug}-{ts}.json";
        const string mimeType = "application/json";

        try
        {
            await JS.InvokeVoidAsync("SwebKit.downloadText", fileName, mimeType, content);
        }
        catch (Exception ex)
        {
            // Log but don't crash — download is a non-critical operation
            Console.Error.WriteLine($"Download failed: {ex.Message}");
        }
    }

    // ── Filtering engine ─────────────────────────────────────────────────────

    private List<SbMessage> ApplyFilters(IReadOnlyList<SbMessage> source)
    {
        if (!_filtersEnabled) return source.ToList();

        IEnumerable<SbMessage> query = source;

        if (HasTextFilter)
        {
            query = query.Where(MatchesTextFilter);
        }

        if (_advancedFilterEnabled)
        {
            var enabledRules = _advancedRules
                .Where(r => r.Enabled && IsRuleConfigured(r))
                .ToList();

            if (enabledRules.Count > 0)
            {
                query = query.Where(message => enabledRules.All(rule => MatchesAdvancedRule(message, rule)));
            }
        }

        return query.ToList();
    }

    private bool MatchesTextFilter(SbMessage message)
    {
        return message.MessageId.Contains(TextFilter, StringComparison.OrdinalIgnoreCase)
            || message.CorrelationId?.Contains(TextFilter, StringComparison.OrdinalIgnoreCase) == true
            || message.Subject?.Contains(TextFilter, StringComparison.OrdinalIgnoreCase) == true
            || message.Body.Contains(TextFilter, StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsRuleConfigured(AdvancedFilterRule rule)
    {
        if (string.IsNullOrWhiteSpace(rule.Value)) return false;
        if (RequiresPropertyName(rule.Field) && string.IsNullOrWhiteSpace(rule.PropertyName)) return false;
        return true;
    }

    private static string NormalizeField(string? field) => field switch
    {
        FieldEnqueuedTime => FieldEnqueuedTime,
        FieldDeliveryCount => FieldDeliveryCount,
        FieldSequenceNumber => FieldSequenceNumber,
        _ => FieldApplicationProperty
    };

    private static string DefaultOperatorForField(string field) => field switch
    {
        FieldEnqueuedTime => OperatorAfter,
        FieldDeliveryCount => OperatorGreaterThanOrEqual,
        FieldSequenceNumber => OperatorGreaterThanOrEqual,
        _ => OperatorContains
    };

    private static IReadOnlyList<FilterOperatorOption> GetOperatorOptions(string field) => field switch
    {
        FieldEnqueuedTime => DateOperatorOptions,
        FieldDeliveryCount => NumericOperatorOptions,
        FieldSequenceNumber => NumericOperatorOptions,
        _ => TextOperatorOptions
    };

    private static bool RequiresPropertyName(string field) => field == FieldApplicationProperty;

    private static string GetValuePlaceholder(string field) => field switch
    {
        FieldEnqueuedTime => "Date/time (for example 2026-03-28T12:00:00Z)",
        FieldDeliveryCount => "Number",
        FieldSequenceNumber => "Number",
        _ => "Value"
    };

    private bool MatchesAdvancedRule(SbMessage message, AdvancedFilterRule rule)
    {
        var rawValue = rule.Value.Trim();
        if (string.IsNullOrWhiteSpace(rawValue)) return true;

        switch (rule.Field)
        {
            case FieldApplicationProperty:
                if (!TryGetApplicationPropertyValue(message, rule.PropertyName.Trim(), out var propertyValue))
                    return false;
                return EvaluateTextOperator(propertyValue, rawValue, rule.Operator);

            case FieldDeliveryCount:
                if (!TryParseLong(rawValue, out var expectedDeliveryCount)) return false;
                return EvaluateNumericOperator(message.DeliveryCount, expectedDeliveryCount, rule.Operator);

            case FieldSequenceNumber:
                if (message.SequenceNumber is not long sequenceNumber) return false;
                if (!TryParseLong(rawValue, out var expectedSequence)) return false;
                return EvaluateNumericOperator(sequenceNumber, expectedSequence, rule.Operator);

            case FieldEnqueuedTime:
                if (!TryParseDate(rawValue, out var expectedTime)) return false;
                return EvaluateDateOperator(message.EnqueuedAt, expectedTime, rule.Operator);

            default:
                return true;
        }
    }

    private static bool TryGetApplicationPropertyValue(SbMessage message, string propertyName, out string value)
    {
        value = string.Empty;
        if (string.IsNullOrWhiteSpace(propertyName) || message.ApplicationProperties is null)
            return false;

        if (message.ApplicationProperties.TryGetValue(propertyName, out var directValue))
        {
            value = Convert.ToString(directValue, CultureInfo.InvariantCulture) ?? string.Empty;
            return true;
        }

        foreach (var kvp in message.ApplicationProperties)
        {
            if (string.Equals(kvp.Key, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                value = Convert.ToString(kvp.Value, CultureInfo.InvariantCulture) ?? string.Empty;
                return true;
            }
        }

        return false;
    }

    private static bool EvaluateTextOperator(string actual, string expected, string op)
    {
        return op switch
        {
            OperatorEquals => string.Equals(actual, expected, StringComparison.OrdinalIgnoreCase),
            OperatorNotEquals => !string.Equals(actual, expected, StringComparison.OrdinalIgnoreCase),
            OperatorRegex => SafeRegexMatch(actual, expected),
            _ => actual.Contains(expected, StringComparison.OrdinalIgnoreCase)
        };
    }

    private static bool SafeRegexMatch(string value, string pattern)
    {
        try
        {
            return Regex.IsMatch(value, pattern, RegexOptions.IgnoreCase | RegexOptions.CultureInvariant,
                TimeSpan.FromMilliseconds(150));
        }
        catch (ArgumentException)
        {
            return false;
        }
        catch (RegexMatchTimeoutException)
        {
            return false;
        }
    }

    private static bool EvaluateNumericOperator(long actual, long expected, string op)
    {
        return op switch
        {
            OperatorEquals => actual == expected,
            OperatorNotEquals => actual != expected,
            OperatorGreaterThan => actual > expected,
            OperatorGreaterThanOrEqual => actual >= expected,
            OperatorLessThan => actual < expected,
            OperatorLessThanOrEqual => actual <= expected,
            _ => false
        };
    }

    private static bool TryParseLong(string value, out long parsed) =>
        long.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out parsed);

    private static bool TryParseDate(string value, out DateTimeOffset parsed)
    {
        return DateTimeOffset.TryParse(value, CultureInfo.InvariantCulture,
                   DateTimeStyles.AllowWhiteSpaces | DateTimeStyles.AssumeUniversal,
                   out parsed)
               || DateTimeOffset.TryParse(value, CultureInfo.CurrentCulture,
                   DateTimeStyles.AllowWhiteSpaces | DateTimeStyles.AssumeUniversal,
                   out parsed);
    }

    private static bool EvaluateDateOperator(DateTimeOffset actual, DateTimeOffset expected, string op)
    {
        return op switch
        {
            OperatorEquals => actual.UtcDateTime == expected.UtcDateTime,
            OperatorBefore => actual.UtcDateTime < expected.UtcDateTime,
            OperatorOnOrBefore => actual.UtcDateTime <= expected.UtcDateTime,
            OperatorAfter => actual.UtcDateTime > expected.UtcDateTime,
            OperatorOnOrAfter => actual.UtcDateTime >= expected.UtcDateTime,
            _ => false
        };
    }

    private List<long> GetFilteredSequenceNumbers() =>
        FilteredMessages
            .Where(m => m.SequenceNumber is long)
            .Select(m => m.SequenceNumber!.Value)
            .Distinct()
            .ToList();

    public async ValueTask DisposeAsync()
    {
        await _autoRefresh.DisposeAsync();
    }
}
