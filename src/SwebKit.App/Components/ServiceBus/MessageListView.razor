@using System.Globalization
@using System.Text.RegularExpressions
@implements IAsyncDisposable
@inject AppStateService AppState
@inject UiStateRepository UiState
@inject IJSRuntime JS

<div class="message-list-host message-list-view">
    @if (_showComposer && ShowCompose)
    {
        <div class="message-list-view__composer-shell">
            <MessageComposer Client="Client" EntityPath="@EntityPath" IsProduction="false"
                             OnSent="@((_) => OnComposerSent())" OnClose="@(() => _showComposer = false)" />
        </div>
    }

    <div class="filter-bar message-list-view__toolbar">
        <span class="view-mode-badge @(IsDlqMode ? "dlq" : "peek")" aria-label="Message list mode">
            @(IsDlqMode ? "DLQ mode" : "Peek mode")
        </span>
        @if (!string.IsNullOrWhiteSpace(PinnedSessionId))
        {
            <span class="view-mode-badge message-list-view__session-pin" data-testid="pinned-session-badge"
                  title="Message list is filtered to session: @PinnedSessionId">
                Session: @PinnedSessionId
            </span>
        }
        <select data-testid="peek-count-select" @bind="PeekCount"
                class="message-list-view__toolbar-select app-native-control app-native-select">
            <option value="5">5 messages</option>
            <option value="10">10 messages</option>
            <option value="50">50 messages</option>
            <option value="100">100 messages</option>
            <option value="200">200 messages</option>
        </select>
        <select @bind="_autoRefreshSeconds" @bind:after="ApplyAutoRefresh" title="Auto-refresh interval"
                class="message-list-view__toolbar-select app-native-control app-native-select">
            <option value="0">No auto-refresh</option>
            <option value="10">Refresh 10 s</option>
            <option value="30">Refresh 30 s</option>
            <option value="60">Refresh 60 s</option>
        </select>
        <div class="density-toggle" title="Row density" aria-label="Row density">
            <button type="button" class="density-btn @(_density == "compact" ? "active" : "")"
                    @onclick='() => SetDensityAsync("compact")'>Compact</button>
            <button type="button" class="density-btn @(_density == "default" ? "active" : "")"
                    @onclick='() => SetDensityAsync("default")'>Default</button>
            <button type="button" class="density-btn @(_density == "comfort" ? "active" : "")"
                    @onclick='() => SetDensityAsync("comfort")'>Comfort</button>
        </div>
        <div class="message-list-view__menu-anchor">
            <button type="button" data-testid="column-chooser-toggle" title="Configure visible columns"
                    @onclick="ToggleColumnChooser" class="message-list-view__toolbar-button">
                Columns
            </button>
            @if (_showColumnChooser)
            {
                <div data-testid="column-chooser-menu" class="message-list-view__menu message-list-view__menu--chooser">
                    <div class="message-list-view__menu-heading">Built-in columns</div>
                    @foreach (var option in BuiltInColumnOptions)
                    {
                        if (!option.DlqOnly || ShowDlqColumns)
                        {
                            <label data-testid="built-in-column-option" data-column-key="@option.Key"
                                   class="message-list-view__chooser-option">
                                <span>@option.Label</span>
                                <input type="checkbox" checked="@IsBuiltInColumnVisible(option.Key)"
                                       @onchange="args => SetBuiltInColumnVisibleAsync(option.Key, ParseCheckboxValue(args))" />
                            </label>
                        }
                    }

                    <div class="message-list-view__menu-divider"></div>
                    <div class="message-list-view__menu-heading">Custom property columns</div>

                    <div class="message-list-view__custom-column-row">
                        <input type="text" data-testid="custom-column-input" @bind="_newCustomPropertyColumn"
                               @bind:event="oninput" placeholder="Application property key"
                               class="message-list-view__custom-column-input app-native-control" />
                        <button type="button" data-testid="add-custom-column" @onclick="AddCustomPropertyColumnAsync"
                                disabled="@(!CanAddCustomPropertyColumn)" class="message-list-view__toolbar-button">
                            Add
                        </button>
                    </div>

                    @if (_customPropertyColumns.Count == 0)
                    {
                        <div class="message-list-view__helper-copy">No custom columns configured.</div>
                    }
                    else
                    {
                        @foreach (var customColumn in _customPropertyColumns)
                        {
                            <div data-testid="custom-column-item" data-column-name="@customColumn"
                                 class="message-list-view__custom-column-item">
                                <span class="message-list-view__custom-column-name">@customColumn</span>
                                <button type="button" data-testid="remove-custom-column" data-column-name="@customColumn"
                                        title="Remove custom column" @onclick="() => RemoveCustomPropertyColumnAsync(customColumn)"
                                        class="message-list-view__toolbar-button message-list-view__toolbar-button--subtle message-list-view__custom-column-remove">
                                    ✕
                                </button>
                            </div>
                        }
                    }

                    @if (SuggestedCustomPropertyColumns.Count > 0)
                    {
                        <div class="message-list-view__helper-copy">From loaded messages:</div>
                        <div class="message-list-view__suggestions">
                            @foreach (var suggestion in SuggestedCustomPropertyColumns)
                            {
                                <button type="button" data-testid="custom-column-suggestion" data-column-name="@suggestion"
                                        @onclick="() => AddCustomPropertyColumnAsync(suggestion)"
                                        class="message-list-view__suggestion-chip">
                                    @suggestion
                                </button>
                            }
                        </div>
                    }

                    <div class="message-list-view__menu-footer">
                        <button type="button" data-testid="reset-column-preferences"
                                title="Reset columns and density to defaults" @onclick="ResetColumnPreferencesAsync"
                                class="message-list-view__toolbar-button">
                            Reset Defaults
                        </button>
                        <button type="button" title="Close column chooser" @onclick="() => _showColumnChooser = false"
                                class="message-list-view__toolbar-button message-list-view__toolbar-button--subtle">
                            Close
                        </button>
                    </div>
                </div>
            }
        </div>
        @if (MultiSelect && Messages.Count > 0)
        {
            <button type="button" @onclick="ToggleSelectAll" class="message-list-view__toolbar-button"
                    title="Select / deselect all visible messages">
                @(_selection.Count == Messages.Count ? "Deselect all" : "Select all")
            </button>
        }
        <div class="message-list-view__filter-group">
            <input type="text" @bind="TextFilter" @bind:event="oninput" placeholder="Filter messages..."
                   class="message-list-view__filter-input app-native-control" />
            @if (CanSaveCurrentFilter)
            {
                <button type="button" @onclick="SaveCurrentFilter" title="Save current filter"
                        class="message-list-view__filter-addon">
                    💾
                </button>
            }
            <div class="message-list-view__menu-anchor message-list-view__menu-anchor--right">
                <button type="button" @onclick="() => _showFilterMenu = !_showFilterMenu" title="Saved filters"
                        class="message-list-view__filter-addon message-list-view__filter-addon--menu"
                        disabled="@(SavedFilters.Count == 0)">▾</button>
                @if (_showFilterMenu && SavedFilters.Count > 0)
                {
                    <div class="message-list-view__menu message-list-view__menu--saved">
                        @foreach (var f in SavedFilters)
                        {
                            <div data-testid="saved-filter-item" data-filter-name="@f.Name"
                                 class="message-list-view__saved-filter-item" @onclick="() => ApplySavedFilter(f)">
                                <span class="message-list-view__saved-filter-name"
                                      title="@GetSavedFilterTooltip(f)">@f.Name</span>
                                <button type="button" @onclick:stopPropagation="true" @onclick="() => DeleteSavedFilter(f.Name)"
                                        title="Remove filter" class="message-list-view__saved-filter-remove">✕</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        <button type="button" data-testid="filters-toggle" title="Toggle all filters on or off"
                class="message-list-view__state-toggle @(_filtersEnabled ? "is-active" : null)"
                aria-pressed="@_filtersEnabled" @onclick="ToggleFiltersEnabled">
            @(_filtersEnabled ? "Filters: On" : "Filters: Off")
        </button>
        <button type="button" data-testid="advanced-toggle" title="Toggle advanced rule filtering"
                class="message-list-view__state-toggle message-list-view__state-toggle--advanced @(_advancedFilterEnabled && _filtersEnabled ? "is-active" : null)"
                aria-pressed="@(_advancedFilterEnabled && _filtersEnabled)" @onclick="ToggleAdvancedFilterEnabled"
                disabled="@(!_filtersEnabled)">
            @(_advancedFilterEnabled ? "Advanced: On" : "Advanced: Off")
        </button>
        @if (_advancedFilterEnabled)
        {
            <button type="button" data-testid="add-rule" title="Add advanced filter rule" @onclick="AddAdvancedRule"
                    class="message-list-view__toolbar-button">
                + Rule
            </button>
        }
        @if (IsDetailPaneOpen && OnCloseDetails.HasDelegate)
        {
            <button type="button" @onclick="OnCloseDetails" class="message-list-view__toolbar-button"
                    title="Close message details">
                Close Details
            </button>
        }
        @if (!IsDlqMode)
        {
            <button type="button" @onclick="ConfirmDeleteSelectedMessage"
                    class="message-list-view__toolbar-button message-list-view__toolbar-button--danger"
                    disabled="@(IsLoading || IsMutating || !CanDeleteSelectedMessage)" title="Delete selected active message">
                Delete Selected
            </button>
        }
        <button type="button" @onclick="ConfirmDeleteFilteredMessages"
                class="message-list-view__toolbar-button message-list-view__toolbar-button--danger"
                disabled="@(IsLoading || IsMutating || !CanDeleteFilteredMessages)"
                title="Delete currently filtered messages in the current mode">
            Delete Filtered
        </button>
        <button type="button" @onclick="ConfirmPurgeAllMessages"
                class="message-list-view__toolbar-button message-list-view__toolbar-button--danger"
                disabled="@(IsLoading || IsMutating || string.IsNullOrWhiteSpace(EntityPath))"
                title="Permanently delete all messages in the current mode">
            Purge All
        </button>
        @if (ShowCompose && !IsDlqMode && Client is not null)
        {
            <button type="button" @onclick="@(() => _showComposer = !_showComposer)"
                    class="message-list-view__toolbar-button message-list-view__toolbar-button--compose @(_showComposer ? "message-list-view__toolbar-button--active" : "")"
                    title="Compose and send a new message">
                ✉ Send
            </button>
        }
        <button type="button" @onclick="ExportFilteredJsonAsync" class="message-list-view__toolbar-button"
                disabled="@(FilteredMessages.Count == 0)" title="Export currently visible messages as JSON">
            ⬇ Export JSON
        </button>
        <button type="button" @onclick="ToggleNsbMode"
                class="message-list-view__toolbar-button message-list-view__toolbar-button--nsb @(_nsbMode ? "message-list-view__toolbar-button--active" : "")"
                title="Toggle NServiceBus view — shows endpoint, message type, conversation ID">
            NSB
        </button>
        <button type="button" data-testid="peek-button" @onclick="LoadInitialWindowAsync"
                class="message-list-view__toolbar-button message-list-view__toolbar-button--primary" disabled="@IsLoading">
            @(IsLoading ? "Loading…" : "↺ Peek")
        </button>
    </div>

    @if (_advancedFilterEnabled)
    {
        <div data-testid="advanced-filter-panel" class="message-list-view__advanced-panel">
            @if (_advancedRules.Count == 0)
            {
                <div class="message-list-view__helper-copy">No advanced rules. Add a rule to refine the filtered
                    result set.</div>
                }
            else
                {
                    @for (var i = 0; i < _advancedRules.Count; i++)
                    {
                        var rule = _advancedRules[i];
                        <div data-testid="advanced-rule" data-rule-index="@i" class="message-list-view__advanced-rule">
                            <label class="message-list-view__advanced-rule-enabled">
                                <input type="checkbox" @bind="rule.Enabled" />
                                On
                            </label>
                            <select data-testid="rule-field" value="@rule.Field"
                                    @onchange="e => ChangeRuleField(rule, e.Value?.ToString())"
                                    class="message-list-view__rule-select app-native-control app-native-select">
                                <option value="application-property">Application Property</option>
                                <option value="enqueued-time">Enqueued Time</option>
                                <option value="delivery-count">Delivery Count</option>
                                <option value="sequence-number">Sequence Number</option>
                            </select>
                            <select data-testid="rule-operator" value="@rule.Operator"
                                    @onchange="e => ChangeRuleOperator(rule, e.Value?.ToString())"
                                    class="message-list-view__rule-select app-native-control app-native-select">
                                @foreach (var op in GetOperatorOptions(rule.Field))
                                {
                                    <option value="@op.Value">@op.Label</option>
                                }
                            </select>
                            @if (RequiresPropertyName(rule.Field))
                            {
                                <input type="text" data-testid="rule-property" @bind="rule.PropertyName" @bind:event="oninput"
                                       placeholder="Property name"
                                       class="message-list-view__rule-input message-list-view__rule-input--property app-native-control" />
                            }
                            <input type="text" data-testid="rule-value" @bind="rule.Value" @bind:event="oninput"
                                   placeholder="@GetValuePlaceholder(rule.Field)"
                                   class="message-list-view__rule-input message-list-view__rule-input--value app-native-control" />
                            <button type="button" data-testid="rule-remove" title="Remove rule"
                                    @onclick="() => RemoveAdvancedRule(rule.Id)" class="message-list-view__rule-remove">
                                ✕
                            </button>
                        </div>
                    }
                }
                <div class="message-list-view__helper-copy">
                    Advanced rules use logical AND over enabled rules.
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(OperationMessage))
        {
            <div class="message-list-view__operation-message @(_operationFailed ? "is-error" : null)">
                @OperationMessage
            </div>
        }

        @if (ErrorMessage is not null)
        {
            <ErrorCallout Message="@ErrorMessage" OnRetry="LoadAsync" />
        }

        @if (IsLoading)
        {
            <LoadingSpinner Message="Peeking messages..." />
        }
        else if (FilteredMessages.Count == 0)
        {
            @if (Messages.Count == 0)
            {
                <EmptyState Icon="📭" Title="No messages" Subtitle="Click Peek to load messages from the queue." />
            }
            else
            {
                <EmptyState Icon="🔍" Title="No matches" Subtitle="@NoMatchesSubtitle" />
            }
        }
        else
        {
            <div class="data-table-container message-grid-scroll message-grid-host message-list-view__grid-shell density-@_density"
                 tabindex="0" @onkeydown="HandleKeyDown" @onkeydown:preventDefault="@_preventKeyDefault"
                 aria-label="Message list scroll container">
                <FluentDataGrid Items="@FilteredMessages.AsQueryable()" TGridItem="SbMessage" Class="message-grid"
                                ResizableColumns="true" Virtualize="true" ItemSize="@ItemSize" RowClass="@(m => GetRowClass(m))"
                                OnRowClick="@(e => OnRowClickedAsync(e.Item))">
                    @if (MultiSelect)
                    {
                        <TemplateColumn Title="" Width="40px">
                            <input type="checkbox" checked="@_selection.IsSelected(context.MessageId)"
                                   class="message-list-view__row-select" @onclick:stopPropagation="true"
                                   @onchange="async e => await ToggleSelection(context, (bool)e.Value!)" />
                        </TemplateColumn>
                    }
                    @if (IsBuiltInColumnVisible(ColumnEnqueued))
                    {
                        <PropertyColumn Property="m => m.EnqueuedAt" Title="Enqueued" Format="HH:mm:ss.fff" Width="120px"
                                        Sortable="true" IsDefaultSortColumn="true" InitialSortDirection="SortDirection.Descending" />
                    }
                    @if (IsBuiltInColumnVisible(ColumnMessageId))
                    {
                        <TemplateColumn Title="Message ID" Width="220px"
                                        SortBy="@(GridSort<SbMessage>.ByAscending(m => m.MessageId))">
                            <span class="cell-truncate" title="@context.MessageId">@context.MessageId</span>
                        </TemplateColumn>
                    }
                    @if (IsBuiltInColumnVisible(ColumnCorrelationId))
                    {
                        <TemplateColumn Title="Correlation ID" Width="180px"
                                        SortBy="@(GridSort<SbMessage>.ByAscending(m => m.CorrelationId))">
                            <span class="cell-truncate" title="@(context.CorrelationId ?? "-")">@(context.CorrelationId ??
                                                                                                                                                                                                                                                                           "-")</span>
                            </TemplateColumn>
                        }
                        @if (IsBuiltInColumnVisible(ColumnSubject))
                        {
                            <TemplateColumn Title="Subject" SortBy="@(GridSort<SbMessage>.ByAscending(m => m.Subject))">
                                <span class="cell-truncate" title="@(context.Subject ?? "-")">@(context.Subject ?? "-")</span>
                            </TemplateColumn>
                        }
                        @if (IsBuiltInColumnVisible(ColumnDelivery))
                        {
                            <TemplateColumn Title="Delivery" Width="72px"
                                            SortBy="@(GridSort<SbMessage>.ByDescending(m => m.DeliveryCount))">@context.DeliveryCount
                            </TemplateColumn>
                        }
                        @if (!IsDetailPaneOpen && IsBuiltInColumnVisible(ColumnExpires))
                        {
                            <TemplateColumn Title="Expires" Width="130px"
                                            SortBy="@(GridSort<SbMessage>.ByAscending(m => m.SystemProperties.ExpiresAt))">
                                <span class="cell-truncate" title="@(context.SystemProperties.ExpiresAt?.ToString("O") ?? "-")">
                                    @(context.SystemProperties.ExpiresAt?.ToString("HH:mm:ss") ?? "-")
                                </span>
                            </TemplateColumn>
                        }
                        @if (!IsDetailPaneOpen && IsBuiltInColumnVisible(ColumnContentType))
                        {
                            <TemplateColumn Title="Content Type" Width="110px"
                                            SortBy="@(GridSort<SbMessage>.ByAscending(m => m.ContentType))">
                                <span class="cell-truncate" title="@(context.ContentType ?? "-")">@(context.ContentType ?? "-")</span>
                            </TemplateColumn>
                        }
                        @if (!IsDetailPaneOpen && IsBuiltInColumnVisible(ColumnSession))
                        {
                            <TemplateColumn Title="Session" Width="130px" SortBy="@(GridSort<SbMessage>.ByAscending(m => m.SessionId))">
                                <span class="cell-truncate" title="@(context.SessionId ?? "-")">@(context.SessionId ?? "-")</span>
                            </TemplateColumn>
                        }
                        @if (!IsDetailPaneOpen && IsBuiltInColumnVisible(ColumnPartitionKey))
                        {
                            <TemplateColumn Title="Partition Key" Width="130px"
                                            SortBy="@(GridSort<SbMessage>.ByAscending(m => m.SystemProperties.PartitionKey))">
                                <span class="cell-truncate"
                                      title="@(context.SystemProperties.PartitionKey ?? "-")">@(context.SystemProperties.PartitionKey ??
                                                                                                                                                                                                                                                                                                                     "-")</span>
                                </TemplateColumn>
                            }
                            @if (ShowDlqColumns && IsBuiltInColumnVisible(ColumnDeadLetterReason))
                            {
                                <TemplateColumn Title="DLQ Reason" SortBy="@(GridSort<SbMessage>.ByAscending(m => m.DeadLetterReason))">
                                    <span class="cell-truncate" title="@(context.DeadLetterReason ?? "-")">@(context.DeadLetterReason ??
                                                                                                                                                                                                                                                                                                                                         "-")</span>
                                    </TemplateColumn>
                                }
                                @foreach (var customColumn in _customPropertyColumns)
                                {
                                    var customColumnName = customColumn;
                                    <TemplateColumn Title="@customColumnName" Width="160px">
                                        <span class="cell-truncate" title="@GetCustomPropertyValue(context, customColumnName)">
                                            @GetCustomPropertyValue(context, customColumnName)
                                        </span>
                                    </TemplateColumn>
                                }
                                @if (_nsbMode)
                                {
                                    <TemplateColumn Title="NSB Endpoint" Width="200px"
                                                    SortBy="@(GridSort<SbMessage>.ByAscending(m => GetNsbProp(m, "NServiceBus.OriginatingEndpoint")))">
                                        <span class="cell-truncate" title="@GetNsbProp(context, "NServiceBus.OriginatingEndpoint")">
                                            @GetNsbProp(context, "NServiceBus.OriginatingEndpoint")
                                        </span>
                                    </TemplateColumn>
                                    <TemplateColumn Title="NSB Message Type">
                                        <span class="cell-truncate nsb-type-cell"
                                              title="@GetNsbProp(context, "NServiceBus.EnclosedMessageTypes")">
                                            @TruncateNsbType(GetNsbProp(context, "NServiceBus.EnclosedMessageTypes"))
                                        </span>
                                    </TemplateColumn>
                                    <TemplateColumn Title="NSB Time Sent" Width="150px"
                                                    SortBy="@(GridSort<SbMessage>.ByAscending(m => GetNsbProp(m, "NServiceBus.TimeSent")))">
                                        <span class="cell-truncate" title="@GetNsbProp(context, "NServiceBus.TimeSent")">
                                            @GetNsbProp(context, "NServiceBus.TimeSent")
                                        </span>
                                    </TemplateColumn>
                                    <TemplateColumn Title="NSB Conversation" Width="200px"
                                                    SortBy="@(GridSort<SbMessage>.ByAscending(m => GetNsbProp(m, "NServiceBus.ConversationId")))">
                                        <span class="cell-truncate" title="@GetNsbProp(context, "NServiceBus.ConversationId")">
                                            @GetNsbProp(context, "NServiceBus.ConversationId")
                                        </span>
                                    </TemplateColumn>
                                }
                            </FluentDataGrid>
                        </div>
                        <div class="message-list-view__summary-bar">
                            <span data-testid="window-status">@WindowStatusSummary</span>
                            @if (Messages.Count >= LargeWindowThreshold)
                            {
                                <span class="message-list-view__large-window-cue" data-testid="large-window-cue"
                                      title="The loaded window is large. Filtering and scroll performance may be impacted.">
                                    Large window
                                </span>
                            }
                            <button type="button" data-testid="load-more-button" @onclick="LoadMoreAsync"
                                    class="message-list-view__toolbar-button" disabled="@(!CanLoadMore)"
                                    title="Load additional messages into the current window">
                                @LoadMoreButtonLabel
                            </button>
                        </div>
                        <div class="message-list-view__summary-bar message-list-view__summary-bar--secondary">
                            @CountSummary
                        </div>
                    }

                    <Modal IsOpen="@_showSaveFilterDialog" OnClose="@(() => _showSaveFilterDialog = false)">
                        <div class="message-list-view__save-filter-dialog">
                            <h3 class="message-list-view__dialog-title">Save Filter</h3>
                            <div class="message-list-view__dialog-copy">@CurrentFilterSummary</div>
                            <input type="text" @bind="_saveFilterName" placeholder="Filter name…"
                                   class="message-list-view__dialog-input app-native-control" />
                            <div class="message-list-view__dialog-actions">
                                <button type="button" @onclick="() => _showSaveFilterDialog = false"
                                        class="message-list-view__dialog-button message-list-view__dialog-button--secondary">Cancel</button>
                                <button type="button" @onclick="ConfirmSaveFilter"
                                        disabled="@string.IsNullOrWhiteSpace(_saveFilterName)"
                                        class="message-list-view__dialog-button message-list-view__dialog-button--primary">Save</button>
                            </div>
                        </div>
                    </Modal>

                    <ConfirmDialog Visible="@_showMutationConfirm" Title="@_confirmTitle" Message="@_confirmMessage"
                                   ConfirmLabel="@_confirmLabel" IsProduction="@AppState.Config.IsProduction" RequireTyping="@_requireTypedConfirm"
                                   OnConfirm="ExecutePendingMutationAsync" OnCancel="CancelPendingMutationAsync" />

                </div>

@code {
    private sealed class AdvancedFilterRule
    {
        public Guid Id { get; init; } = Guid.NewGuid();
        public bool Enabled { get; set; } = true;
        public string Field { get; set; } = FieldApplicationProperty;
        public string Operator { get; set; } = OperatorContains;
        public string PropertyName { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private sealed record FilterOperatorOption(string Value, string Label);
    private sealed record BuiltInColumnOption(string Key, string Label, bool DlqOnly = false);

    private const string FieldApplicationProperty = "application-property";
    private const string FieldEnqueuedTime = "enqueued-time";
    private const string FieldDeliveryCount = "delivery-count";
    private const string FieldSequenceNumber = "sequence-number";

    private const string ColumnEnqueued = "enqueued";
    private const string ColumnMessageId = "message-id";
    private const string ColumnCorrelationId = "correlation-id";
    private const string ColumnSubject = "subject";
    private const string ColumnDelivery = "delivery";
    private const string ColumnExpires = "expires";
    private const string ColumnContentType = "content-type";
    private const string ColumnSession = "session";
    private const string ColumnPartitionKey = "partition-key";
    private const string ColumnDeadLetterReason = "dead-letter-reason";

    private const int LargeWindowThreshold = 200;

    private static readonly IReadOnlyList<BuiltInColumnOption> BuiltInColumnOptions =
    [
        new(ColumnEnqueued, "Enqueued"),
        new(ColumnMessageId, "Message ID"),
        new(ColumnCorrelationId, "Correlation ID"),
        new(ColumnSubject, "Subject"),
        new(ColumnDelivery, "Delivery"),
        new(ColumnExpires, "Expires"),
        new(ColumnContentType, "Content Type"),
        new(ColumnSession, "Session"),
        new(ColumnPartitionKey, "Partition Key"),
        new(ColumnDeadLetterReason, "DLQ Reason", DlqOnly: true)
    ];

    private const string OperatorContains = "contains";
    private const string OperatorEquals = "equals";
    private const string OperatorNotEquals = "not-equals";
    private const string OperatorRegex = "regex";
    private const string OperatorBefore = "before";
    private const string OperatorOnOrBefore = "on-or-before";
    private const string OperatorAfter = "after";
    private const string OperatorOnOrAfter = "on-or-after";
    private const string OperatorGreaterThan = "gt";
    private const string OperatorGreaterThanOrEqual = "gte";
    private const string OperatorLessThan = "lt";
    private const string OperatorLessThanOrEqual = "lte";

    private static readonly IReadOnlyList<FilterOperatorOption> TextOperatorOptions =
    [
        new(OperatorContains, "Contains"),
        new(OperatorEquals, "Equals"),
        new(OperatorNotEquals, "Not equals"),
        new(OperatorRegex, "Regex")
    ];

    private static readonly IReadOnlyList<FilterOperatorOption> NumericOperatorOptions =
