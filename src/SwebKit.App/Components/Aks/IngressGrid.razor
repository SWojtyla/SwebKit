@* Renders the Ingresses FluentDataGrid. *@

<FluentDataGrid Items="@FilteredItems" TGridItem="IngressInfo"
                RowClass="@(i => HasSameIdentity(i, SelectedIngress) ? "selected-row" : "")"
                OnRowClick="@(r => { if (r.Item is not null) OnSelectRow.InvokeAsync(r.Item); })">
    <TemplateColumn Title="Name" SortBy="@(GridSort<IngressInfo>.ByAscending(i => i.Name))">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            <span class="aks-resource-name">@context.Name</span>
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Class" Width="100px"
                    SortBy="@(GridSort<IngressInfo>.ByAscending(i => i.IngressClass ?? ""))">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            @context.IngressClass
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Hosts">
        <div class="aks-row-ctx aks-ingress-hosts-cell" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            @foreach (var host in GetHosts(context))
            {
                var url = BuildIngressUrl(host);
                <button class="aks-ingress-url-btn" @key="url" @onclick="() => OnOpenUrl.InvokeAsync(url)"
                        @onclick:stopPropagation title="Open @url">
                    @host
                </button>
            }
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Address" Width="140px"
                    SortBy="@(GridSort<IngressInfo>.ByAscending(i => string.Join(",", i.Addresses)))">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            @string.Join(", ", context.Addresses)
        </div>
    </TemplateColumn>
</FluentDataGrid>

@code {
    [Parameter] public IQueryable<IngressInfo> FilteredItems { get; set; } = Enumerable.Empty<IngressInfo>().AsQueryable();
    [Parameter] public IngressInfo? SelectedIngress { get; set; }
    [Parameter] public EventCallback<IngressInfo> OnSelectRow { get; set; }
    [Parameter] public EventCallback<(MouseEventArgs, IngressInfo)> OnContextMenu { get; set; }
    [Parameter] public EventCallback<string> OnOpenUrl { get; set; }

    private static string BuildIngressUrl(string host)
    {
        if (host.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            host.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return host;
        if (System.Net.IPAddress.TryParse(host, out _))
            return $"http://{host}";
        return $"https://{host}";
    }

    private static bool HasSameIdentity(IngressInfo candidate, IngressInfo? selected) =>
        selected is not null
        && string.Equals(candidate.Name, selected.Name, StringComparison.Ordinal)
        && string.Equals(candidate.Namespace, selected.Namespace, StringComparison.Ordinal);

    private static IReadOnlyList<string> GetHosts(IngressInfo ingress) => ingress.Rules
        .Select(rule => rule.Host)
        .Where(host => !string.IsNullOrWhiteSpace(host))
        .Select(host => host!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
}
