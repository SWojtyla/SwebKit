@* Renders the StatefulSets FluentDataGrid. *@

<FluentDataGrid Items="@FilteredItems" TGridItem="StatefulSetInfo" Virtualize="true" ItemSize="36"
                RowClass="@(ss => StatefulSetRowClass(ss, SelectedStatefulSet))"
                OnRowClick="@(r => { if (r.Item is not null) OnSelectRow.InvokeAsync(r.Item); })">
    <TemplateColumn Title="Name" SortBy="@(GridSort<StatefulSetInfo>.ByAscending(s => s.Name))">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            <span class="aks-resource-name">@context.Name</span>
        </div>
    </TemplateColumn>
    @if (IsMultiNamespace)
    {
        <TemplateColumn Title="Namespace" Width="130px" SortBy="@(GridSort<StatefulSetInfo>.ByAscending(s => s.Namespace))">
            <span class="aks-ns-cell"
                  @onclick="() => OnNamespaceClick.InvokeAsync(context.Namespace)">@context.Namespace</span>
        </TemplateColumn>
    }
    <TemplateColumn Title="Ready" Width="90px" SortBy="@(GridSort<StatefulSetInfo>.ByAscending(s => s.ReadyReplicas))">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            <span class="aks-ready-badge @(context.ReadyReplicas == context.Replicas ? "healthy" : "degraded")">
                @context.ReadyReplicas / @context.Replicas
            </span>
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Revision" Width="130px"
                    SortBy="@(GridSort<StatefulSetInfo>.ByAscending(s => s.CurrentRevision ?? ""))">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            <span class="aks-text-muted">@context.CurrentRevision</span>
        </div>
    </TemplateColumn>
    <TemplateColumn Title="HPA" Width="110px">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            @{
                var ssHpa = Hpas.FirstOrDefault(h => h.TargetName == context.Name && h.TargetKind == "StatefulSet");
            }
            @if (ssHpa is not null)
            {
                <button class="aks-hpa-badge @(ssHpa.CurrentReplicas == ssHpa.DesiredReplicas ? "" : "hpa-scaling")"
                        @onclick="() => OnOpenHpa.InvokeAsync(ssHpa)" @onclick:stopPropagation>
                    <span class="hpa-icon">⇅</span>
                    <span class="hpa-replicas">@ssHpa.CurrentReplicas / @ssHpa.MaxReplicas</span>
                    @if (ssHpa.CurrentCpuUtilizationPercent.HasValue)
                    {
                        <span class="hpa-cpu">@($"{ssHpa.CurrentCpuUtilizationPercent:F0}%")</span>
                    }
                </button>
            }
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Network" Width="110px">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            <button class="aks-analysis-btn" @onclick="() => OnOpenNetworkAnalysis.InvokeAsync(context)"
                    @onclick:stopPropagation>
                Inspect
            </button>
        </div>
    </TemplateColumn>
</FluentDataGrid>

@code {
    [Parameter]
    public IQueryable<StatefulSetInfo> FilteredItems { get; set; } =
Enumerable.Empty<StatefulSetInfo>().AsQueryable();
    [Parameter] public List<HpaInfo> Hpas { get; set; } = [];
    [Parameter] public bool IsMultiNamespace { get; set; }
    [Parameter] public StatefulSetInfo? SelectedStatefulSet { get; set; }
    [Parameter] public EventCallback<StatefulSetInfo> OnSelectRow { get; set; }
    [Parameter] public EventCallback<(MouseEventArgs, StatefulSetInfo)> OnContextMenu { get; set; }
    [Parameter] public EventCallback<HpaInfo> OnOpenHpa { get; set; }
    [Parameter] public EventCallback<StatefulSetInfo> OnOpenNetworkAnalysis { get; set; }
    [Parameter] public EventCallback<string> OnNamespaceClick { get; set; }

    private static string StatefulSetRowClass(StatefulSetInfo ss, StatefulSetInfo? selected)
    {
        var tint = ss switch
        {
            { Replicas: > 0, ReadyReplicas: 0 } => "row-critical",
            var x when x.ReadyReplicas < x.Replicas && x.ReadyReplicas > 0 => "row-degraded",
            _ => ""
        };
        var selection = ss.Name == selected?.Name ? "selected-row" : "";
        return $"{tint} {selection}".Trim();
    }
}
