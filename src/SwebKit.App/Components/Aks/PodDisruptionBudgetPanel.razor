@implements IDisposable

<div class="pdb-panel">
    @if (_isLoading)
    {
        <LoadingSpinner Message="Loading pod disruption budgets..." />
    }
    else if (_error is not null)
    {
        <div class="pdb-panel-error">@_error</div>
    }
    else if (_pdbs is null || _pdbs.Count == 0)
    {
        <div class="pdb-panel-empty">No pod disruption budgets found.</div>
    }
    else
    {
        <div class="pdb-panel-toolbar">
            <FluentButton Appearance="Appearance.Stealth" @onclick="ReloadAsync">Refresh</FluentButton>
        </div>

        <table class="pdb-panel-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Min Available</th>
                    <th>Max Unavailable</th>
                    <th>Current / Expected</th>
                    <th>Disruptions Allowed</th>
                    <th>Allowed Disruptions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pdb in _pdbs)
                {
                    var badgeClass = pdb.DisruptionsAllowed && pdb.AllowedDisruptions > 0
                        ? "pdb-badge pdb-badge-ok"
                        : "pdb-badge pdb-badge-warn";
                    <tr>
                        <td>@pdb.Name</td>
                        <td>@(pdb.MinAvailable ?? "—")</td>
                        <td>@(pdb.MaxUnavailable ?? "—")</td>
                        <td>@pdb.CurrentHealthy / @pdb.ExpectedPods</td>
                        <td><span class="@badgeClass">@(pdb.DisruptionsAllowed ? "Yes" : "No")</span></td>
                        <td>@pdb.AllowedDisruptions</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter] public IAksClient? Client { get; set; }
    [Parameter] public string Namespace { get; set; } = "default";

    private IReadOnlyList<PodDisruptionBudgetInfo>? _pdbs;
    private bool _isLoading;
    private string? _error;
    private CancellationTokenSource? _cts;
    private string? _loadedKey;

    protected override async Task OnParametersSetAsync()
    {
        var key = Namespace;
        if (_loadedKey == key) return;

        _loadedKey = key;
        await LoadAsync();
    }

    private Task ReloadAsync()
    {
        _loadedKey = null;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Client is null)
        {
            _pdbs = null;
            _error = null;
            return;
        }

        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _isLoading = true;
        _error = null;
        _pdbs = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            _pdbs = await Client.GetPodDisruptionBudgetsAsync(Namespace, _cts.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
