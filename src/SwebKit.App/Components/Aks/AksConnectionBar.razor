@* ── Toolbar ── *@
@inject IJSRuntime JS
<div class="aks-toolbar">

    @* ── Row 1: connection + actions ── *@
    <div class="aks-toolbar-row">
        <span class="connection-dot @(IsConnected ? "dot-ok" : "dot-unknown")"></span>

        @* ── Context custom picker ── *@
        @if (_ctxDropOpen)
        {
            <div class="aks-ns-backdrop" @onclick="CloseCtxDrop"></div>
        }
        <label class="aks-ns-label">Context</label>
        <div class="aks-ns-picker">
            <input class="aks-ns-select aks-ns-search app-native-control"
                   value="@(_ctxDropOpen ? _ctxSearchText : ActiveContext)"
                   placeholder="@(_ctxDropOpen ? "Filter…" : (string.IsNullOrWhiteSpace(ActiveContext) ? "default" : ActiveContext))"
                   @onfocus="OpenCtxDrop" @oninput="OnCtxSearchInput" readonly="@(!_ctxDropOpen)"
                   @onkeydown="OnCtxKeyDown" />
            @if (_ctxDropOpen)
            {
                <div class="aks-ns-dropdown">
                    @foreach (var ctx in CtxFiltered)
                    {
                        var ctxLocal = ctx;
                        <div class="aks-ns-option @(ctxLocal.Name == ActiveContext ? "current" : "")"
                             @onclick="() => SelectCtx(ctxLocal.Name)">
                            @ctxLocal.Name@(ctxLocal.Name == DefaultContext ? " (default)" : "")
                        </div>
                    }
                </div>
            }
        </div>

        <span class="aks-toolbar-divider"></span>

        @* ── Namespace searchable picker ── *@
        @if (_nsDropOpen)
        {
            <div class="aks-ns-backdrop" @onclick="CloseNsDrop"></div>
        }
        <label class="aks-ns-label">Namespace</label>
        <button class="aks-ns-all-chip @(CurrentNamespace == "*" ? "active" : "")" title="All namespaces"
                @onclick="SelectAllNamespaces">*</button>
        <div class="aks-ns-picker">
            <input class="aks-ns-select aks-ns-search app-native-control"
                   value="@(_nsDropOpen ? _nsSearchText : NamespaceSelectionText)"
                   placeholder="@(_nsDropOpen ? "Filter…" : NamespaceSelectionText)" title="@NamespaceSelectionTitle"
                   @onfocus="OpenNsDrop" @oninput="OnNsSearchInput" readonly="@(!_nsDropOpen)" @onkeydown="OnNsKeyDown" />
            @if (_nsDropOpen)
            {
                var filteredNamespaces = OrderNamespaces(NsFiltered).ToList();
                <div class="aks-ns-dropdown aks-ns-dropdown--multi" @ref="_nsDropdownRef">
                    <div class="aks-ns-list-scroll" @onkeydown="OnNsListKeyDown">
                        @if (filteredNamespaces.Count == 0)
                        {
                            <div class="aks-ns-empty">No namespaces match</div>
                        }
                        else
                        {
                            @foreach (var ns in filteredNamespaces)
                            {
                                var nsLocal = ns;
                                var checkedNamespace = IsPendingNamespace(nsLocal);
                                <label class="aks-ns-option aks-ns-option-check @(checkedNamespace ? "current" : "")">
                                    <input type="checkbox" checked="@checkedNamespace"
                                           @onchange="e => TogglePendingNamespace(nsLocal, e.Value is true)" aria-label="@nsLocal" />
                                    <span>@nsLocal</span>
                                </label>
                            }
                        }
                    </div>
                    <div class="aks-ns-dropdown-actions">
                        <button type="button" class="aks-ns-action" @onclick="SelectAllNamespaces">All</button>
                        <button type="button" class="aks-ns-action" @onclick="ClearNamespaceSelection">None</button>
                        <button type="button" class="aks-ns-action aks-ns-apply" @onclick="ApplyNamespaceSelectionAsync">
                            Apply
                        </button>
                    </div>
                </div>
            }
        </div>

        <span class="aks-toolbar-spacer"></span>

        <button class="aks-events-toggle @(ShowEvents ? "active" : "")" @onclick="HandleToggleEvents"
                title="Toggle events panel">
            <FluentIcon Value="@_iconWarning" Width="14px" style="vertical-align:middle;" />
            @(EventWarningCount > 0 ? $" {EventWarningCount}" : " Events")
        </button>

        <button class="aks-events-toggle @(ShowPortForwardSessions ? "active" : "")"
                @onclick="HandleTogglePortForwardSessions" title="Toggle port-forward sessions panel">
            <FluentIcon Value="@_iconArrowForward" Width="14px" style="vertical-align:middle;" />
            @(ActivePortForwardCount > 0 ? $" {ActivePortForwardCount} pf" : " Sessions")
        </button>

        <AutoRefreshToggle OnRefresh="OnRefresh" Paused="@AutoRefreshPaused" InitialInterval="10"
                           InitialEnabled="true" />

        <FluentButton Appearance="Appearance.Stealth" Disabled="@IsLoading" @onclick="OnRefresh" Title="Refresh (F5)">
            @(IsLoading ? "Loading…" : "↻ Refresh")
        </FluentButton>
    </div>

    @* ── Row 2: primary resource tabs ── *@
    <div class="aks-tab-bar">
        @foreach (var rt in DirectResourceTypes)
        {
            <button class="aks-resource-tab @(rt == ActiveResourceType ? "active" : "")"
                    @onclick="() => SelectDirectResourceTypeAsync(rt)">
                @rt
            </button>
        }

        <button
            class="aks-resource-tab aks-resource-tab--toggle @((IsNetworkResourceType(ActiveResourceType) || _networkMenuOpen) ? "active" : "")"
            aria-expanded="@_networkMenuOpen" @onclick="ToggleNetworkMenu">
            Network
            <span class="aks-resource-tab-caret">▾</span>
        </button>
    </div>

    @* ── Row 3: expandable network submenu ── *@
    @if (_networkMenuOpen)
    {
        <div class="aks-network-tab-bar">
            <span class="aks-network-tab-label">Network</span>
            @foreach (var rt in NetworkResourceTypes)
            {
                <button class="aks-resource-subtab @(rt == ActiveResourceType ? "active" : "")"
                        @onclick="() => SelectNetworkResourceTypeAsync(rt)">
                    @rt
                </button>
            }
        </div>
    }

</div>

@code {
    private static readonly string[] DirectResourceTypes = ["Deployments", "StatefulSets", "Pods", "ConfigMaps", "Secrets",
        "Helm", "Jobs", "CronJobs"];
    private static readonly string[] NetworkResourceTypes = ["Services", "Ingresses", "GatewayClasses", "Gateways",
"HTTPRoutes"];
    private static readonly Icon _iconWarning = new Icons.Regular.Size16.Warning();
    private static readonly Icon _iconArrowForward = new Icons.Regular.Size16.ArrowForward();

    [Parameter] public List<KubeContextInfo> Contexts { get; set; } = [];
    [Parameter] public string ActiveContext { get; set; } = "";
    [Parameter] public string? DefaultContext { get; set; }
    [Parameter] public List<string> Namespaces { get; set; } = [];
    [Parameter] public string CurrentNamespace { get; set; } = string.Empty;
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsConnected { get; set; }
    [Parameter] public string ActiveResourceType { get; set; } = "Deployments";
    [Parameter] public bool ShowEvents { get; set; }
    [Parameter] public bool ShowPortForwardSessions { get; set; }
    [Parameter] public int EventWarningCount { get; set; }
    [Parameter] public int ActivePortForwardCount { get; set; }
    [Parameter] public bool AutoRefreshPaused { get; set; }

    [Parameter] public EventCallback<string> OnContextChanged { get; set; }
    [Parameter] public EventCallback<string> OnNamespaceChanged { get; set; }
    [Parameter] public EventCallback<string> OnResourceTypeChanged { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback<bool> OnToggleEvents { get; set; }
    [Parameter] public EventCallback<bool> OnTogglePortForwardSessions { get; set; }

    // ── Context picker internal state ──
    private bool _ctxDropOpen;
    private string _ctxSearchText = string.Empty;

    // ── Namespace picker internal state ──
    private bool _nsDropOpen;
    private string _nsSearchText = string.Empty;
    private HashSet<string> _pendingNamespaces = new(StringComparer.Ordinal);
    private ElementReference _nsDropdownRef;
    private int _nsFocusIndex = -1;
    private bool _networkMenuOpen;
    private string _lastActiveResourceType = string.Empty;

    protected override void OnParametersSet()
    {
        if (!string.Equals(_lastActiveResourceType, ActiveResourceType, StringComparison.Ordinal))
        {
            _networkMenuOpen = IsNetworkResourceType(ActiveResourceType);
            _lastActiveResourceType = ActiveResourceType;
        }
    }

    private IEnumerable<KubeContextInfo> CtxFiltered
    {
        get
        {
            return string.IsNullOrWhiteSpace(_ctxSearchText)
                ? Contexts
                : Contexts.Where(c => c.Name.Contains(_ctxSearchText, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void OpenCtxDrop()
    {
        _ctxSearchText = string.Empty;
        _ctxDropOpen = true;
        StateHasChanged();
    }

    private void CloseCtxDrop()
    {
        _ctxDropOpen = false;
        _ctxSearchText = string.Empty;
        StateHasChanged();
    }

    private void OnCtxSearchInput(ChangeEventArgs e)
    {
        _ctxSearchText = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private void OnCtxKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseCtxDrop();
    }

    private async Task SelectCtx(string name)
    {
        _ctxDropOpen = false;
        _ctxSearchText = string.Empty;
        await OnContextChanged.InvokeAsync(name);
    }

    private IEnumerable<string> NsFiltered
    {
        get
        {
            var all = Namespaces
                .Where(ns => !string.IsNullOrWhiteSpace(ns))
                .Distinct(StringComparer.Ordinal);

            return string.IsNullOrWhiteSpace(_nsSearchText)
                ? all
                : all.Where(n => n.Contains(_nsSearchText, StringComparison.OrdinalIgnoreCase));
        }
    }

    private string NamespaceSelectionText
    {
        get
        {
            var scope = GetNamespaceScope();
            if (!string.IsNullOrWhiteSpace(scope.DisplayText))
            {
                return scope.DisplayText;
            }

            return string.IsNullOrWhiteSpace(CurrentNamespace) ? "Select namespaces" : CurrentNamespace;
        }
    }

    private string NamespaceSelectionTitle => GetNamespaceScope().DisplayTitle;

    private void OpenNsDrop()
    {
        _nsSearchText = string.Empty;
        _pendingNamespaces = GetNamespaceScope().Namespaces.ToHashSet(StringComparer.Ordinal);
        _nsFocusIndex = -1;
        _nsDropOpen = true;
        StateHasChanged();
    }

    private void CloseNsDrop()
    {
        _nsDropOpen = false;
        _nsSearchText = string.Empty;
        _nsFocusIndex = -1;
        StateHasChanged();
    }

    private void OnNsSearchInput(ChangeEventArgs e)
    {
        _nsSearchText = e.Value?.ToString() ?? string.Empty;
        _nsFocusIndex = -1;
        StateHasChanged();
    }

    private void OnNsKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                CloseNsDrop();
                break;
            case "Enter":
                _ = ApplyNamespaceSelectionAsync();
                break;
            case "ArrowDown":
                // Move focus from the search input into the option list.
                _ = MoveNsFocusAsync(1);
                break;
        }
    }

    // Handles arrow navigation while focus is on an option checkbox. Space is
    // left to the native checkbox toggle; Enter applies; Escape cancels.
    private void OnNsListKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                _ = MoveNsFocusAsync(1);
                break;
            case "ArrowUp":
                _ = MoveNsFocusAsync(-1);
                break;
            case "Enter":
                _ = ApplyNamespaceSelectionAsync();
                break;
            case "Escape":
                CloseNsDrop();
                break;
        }
    }

    private async Task MoveNsFocusAsync(int delta)
    {
        var count = OrderNamespaces(NsFiltered).Count();
        if (count == 0)
        {
            return;
        }

        var next = _nsFocusIndex + delta;
        if (next < 0)
        {
            next = 0;
        }
        else if (next >= count)
        {
            next = count - 1;
        }

        _nsFocusIndex = next;
        try { await JS.InvokeVoidAsync("SwebKit.focusNamespaceOption", _nsDropdownRef, _nsFocusIndex); }
        catch (OperationCanceledException) { throw; }
        catch { /* focus is best-effort */ }
    }

    private async Task SelectNs(string ns)
    {
        _nsDropOpen = false;
        _nsSearchText = string.Empty;
        await OnNamespaceChanged.InvokeAsync(ns);
    }

    private Task SelectAllNamespaces() => SelectNs("*");

    private void ClearNamespaceSelection() => _pendingNamespaces.Clear();

    private bool IsPendingNamespace(string ns)
        => _pendingNamespaces.Contains(ns);

    private void TogglePendingNamespace(string ns, bool selected)
    {
        if (selected)
        {
            _pendingNamespaces.Add(ns);
        }
        else
        {
            _pendingNamespaces.Remove(ns);
        }
    }

    private async Task ApplyNamespaceSelectionAsync()
    {
        var selection = _pendingNamespaces.Count == 0
            ? string.Empty
            : AksNamespaceScope.FromNamespaces(OrderNamespaces(_pendingNamespaces)).SelectionToken;
        await SelectNs(selection);
    }

    private AksNamespaceScope GetNamespaceScope()
        => AksNamespaceScope.FromSelection(CurrentNamespace, Namespaces);

    private IEnumerable<string> OrderNamespaces(IEnumerable<string> namespaces)
        => namespaces
            .Where(ns => !string.IsNullOrWhiteSpace(ns))
            .Distinct(StringComparer.Ordinal)
            // Hoist the currently pending (in-flight) selection to the top so it is easy to
            // review/deselect. Ordering reflects the live pending set, reordering as the user
            // toggles. Within each group, keep a stable order (server index, then name).
            .OrderBy(ns => _pendingNamespaces.Contains(ns) ? 0 : 1)
            .ThenBy(GetNamespaceSortIndex)
            .ThenBy(ns => ns, StringComparer.Ordinal);

    private int GetNamespaceSortIndex(string ns)
    {
        var index = Namespaces.IndexOf(ns);
        return index >= 0 ? index : int.MaxValue;
    }

    private static bool IsNetworkResourceType(string resourceType)
        => NetworkResourceTypes.Contains(resourceType, StringComparer.Ordinal);

    private void ToggleNetworkMenu()
    {
        _networkMenuOpen = !_networkMenuOpen;
    }

    private async Task SelectDirectResourceTypeAsync(string resourceType)
    {
        _networkMenuOpen = false;
        await OnResourceTypeChanged.InvokeAsync(resourceType);
    }

    private async Task SelectNetworkResourceTypeAsync(string resourceType)
    {
        _networkMenuOpen = true;
        await OnResourceTypeChanged.InvokeAsync(resourceType);
    }

    private async Task HandleToggleEvents()
    {
        await OnToggleEvents.InvokeAsync(!ShowEvents);
    }

    private async Task HandleTogglePortForwardSessions()
    {
        await OnTogglePortForwardSessions.InvokeAsync(!ShowPortForwardSessions);
    }
}
