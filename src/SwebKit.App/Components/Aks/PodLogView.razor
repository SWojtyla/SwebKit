@using SwebKit.Core.Constants
@inject IJSRuntime JS
@inject INotificationService Notify
@inherits SwebKit.App.Components.Shared.SwebKitComponentAsyncBase

<div class="log-viewer">
    <div class="log-toolbar">
        <label class="log-live-toggle">
            <input type="checkbox" @bind="IsLive" @bind:after="OnLiveToggle" disabled="@IsPreviousContainerSelected" />
            <span class="log-live-dot @(IsLive && IsLoading ? "active" : "")"></span>
            Live
        </label>
        @if (Containers.Count > 1)
        {
            <select class="log-container-select app-native-control app-native-select" value="@_selectedContainer"
                    @onchange="OnContainerChanged">
                @foreach (var c in Containers)
                {
                    <option @key="c" value="@c" selected="@(c == _selectedContainer)">@c</option>
                }
            </select>
        }
        <select class="log-range-select app-native-control app-native-select" @bind="_selectedRange"
                @bind:after="OnRangeChanged" aria-label="Log range">
            <option value="@LogRange.Last5m">Last 5m</option>
            <option value="@LogRange.Last10m">Last 10m</option>
            <option value="@LogRange.Last1h">Last 1h</option>
            <option value="@LogRange.All">All</option>
            <option value="@LogRange.PreviousContainer">Previous container</option>
        </select>
        <input type="text" @bind="TextFilter" @bind:event="oninput" @bind:after="InvalidateFilter" placeholder="Filter…"
               class="log-filter-input app-native-control" />
        <span class="log-line-count">@WindowSummaryText</span>

        <div class="log-toolbar-actions">
            @* Navigation cluster — browse the buffered window *@
            <div class="log-btn-group" role="group" aria-label="Navigate log window">
                <FluentButton Appearance="Appearance.Stealth" IconStart="@_iconOlder" @onclick="ShowOlder"
                              Disabled="@(!CanShowOlder)" Title="Show older buffered lines">Older</FluentButton>
                <FluentButton Appearance="Appearance.Stealth" IconStart="@_iconNewer" @onclick="ShowNewer"
                              Disabled="@(!CanShowNewer)" Title="Show newer buffered lines">Newer</FluentButton>
                <FluentButton Appearance="Appearance.Stealth" IconStart="@_iconLatest" @onclick="JumpToLatest"
                              Disabled="@(!CanJumpToLatest)" Title="Jump back to the newest buffered lines">@LatestButtonText</FluentButton>
            </div>

            <span class="log-toolbar-sep" aria-hidden="true"></span>

            @* State cluster — one-click tail + pause *@
            <div class="log-btn-group" role="group" aria-label="Live tailing state">
                <FluentButton Appearance="Appearance.Accent" IconStart="@_iconTail"
                              Class="@TailButtonClass"
                              @onclick="GoLiveTailAsync" Disabled="@IsPreviousContainerSelected"
                              Title="Resume live tailing and jump to the newest lines">
                    @(IsTailingLive ? "Live" : "Go to live")
                </FluentButton>
                @if (IsLive && IsLoading)
                {
                    <FluentButton Appearance="Appearance.Stealth" IconStart="@_iconPause" @onclick="TogglePause"
                                  Title="@(_paused ? "Resume tailing" : "Pause tailing")">
                        @(_paused ? "Resume" : "Pause")
                    </FluentButton>
                }
            </div>

            <span class="log-toolbar-sep" aria-hidden="true"></span>

            @* Data cluster — copy / export / load / clear *@
            <div class="log-btn-group" role="group" aria-label="Log data actions">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CopyVisibleLogsAsync"
                              Disabled="@(VisibleLines.Count == 0)"
                              Title="Copy the currently visible log window to the clipboard">Copy visible</FluentButton>
                <FluentButton Appearance="Appearance.Stealth" @onclick="ExportAllLogsAsync"
                              Disabled="@(Client is null || Namespace is null || PodName is null || _exportingAllLogs)"
                              Title="Export the full pod log stream as text">
                    @(_exportingAllLogs ? "Exporting…" : "Export all")
                </FluentButton>
                @if (CanLoadOlderHistory)
                {
                    <FluentButton Appearance="Appearance.Stealth" @onclick="LoadOlderHistoryAsync" Disabled="@_historyReloading"
                                  Title="Request more All-history lines from Kubernetes">
                        @(_historyReloading ? "Loading older…" : $"Load older +{HistoryExpansionLabel}")
                    </FluentButton>
                }
                <FluentButton Appearance="Appearance.Stealth" @onclick="ClearLogs" Title="Clear log buffer">Clear</FluentButton>
            </div>
        </div>
        </div>

        <div class="log-status-bar">
            <span>@BufferSummaryText</span>
            @if (IsAllRangeSelected)
            {
                <span>Requested tail: @_requestedTailLines:N0 lines</span>
            }
            @if (_paused)
            {
                <span>Paused: new lines are buffered until you resume or jump latest</span>
            }
            else if (_pageIndexFromNewest > 0)
            {
                <span>Browsing history: latest lines are buffered in the background</span>
            }
            @if (_pendingNewLineCount > 0 && CanJumpToLatest)
            {
                <button type="button" class="log-jump-btn" @onclick="JumpToLatest">@PendingLinesSummary</button>
            }
        </div>

        <div class="log-output" @ref="_logContainer">
            @if (VisibleLines.Count == 0 && !IsLoading)
            {
                <div class="log-empty">@EmptyStateText</div>
            }
            else
            {
                <Virtualize Items="@VisibleLines" Context="entry" ItemSize="22">
                    <div class="log-line @entry.CssClass">@entry.Line</div>
                </Virtualize>
                @if (IsLive && IsLoading && _pageIndexFromNewest == 0)
                {
                    <div class="log-tailing">
                        <FluentProgressRing Width="12px" /> @(_paused ? "Live stream buffered" : "Tailing latest…")
                    </div>
                }
            }
        </div>

        <div class="log-status-footer log-follow-@FollowStateCss">
            <span class="log-follow-dot" aria-hidden="true"></span>
            <span class="log-follow-text">@FollowStateText</span>
        </div>
    </div>

@code {
    [Parameter] public IAksClient? Client { get; set; }
    [Parameter] public string? Namespace { get; set; }
    [Parameter] public string? PodName { get; set; }
    [Parameter] public IReadOnlyList<string> Containers { get; set; } = [];
    [Parameter] public int BufferSize { get; set; } = Limits.LogBufferMaxLines;

    private readonly record struct LogEntry(string Line, string CssClass);
    private enum LogRange { Last5m, Last10m, Last1h, All, PreviousContainer }

    // C1: follow-state model for the one-click tail affordance + sticky status footer.
    internal enum LogFollowState { Live, Paused, Historical }

    private static readonly Icon _iconOlder = new Icons.Regular.Size16.ChevronUp();
    private static readonly Icon _iconNewer = new Icons.Regular.Size16.ChevronDown();
    private static readonly Icon _iconLatest = new Icons.Regular.Size16.ArrowDown();
    private static readonly Icon _iconTail = new Icons.Regular.Size16.Play();
    private static readonly Icon _iconPause = new Icons.Regular.Size16.Pause();

    // Pure selector — clean seam for unit testing (mirrors GetLineClass).
    internal static LogFollowState ResolveFollowState(bool isLive, bool isLoading, bool paused, int pageIndexFromNewest)
    {
        if (pageIndexFromNewest > 0)
            return LogFollowState.Historical;
        if (isLive && isLoading && !paused)
            return LogFollowState.Live;
        return LogFollowState.Paused;
    }

    private LogFollowState CurrentFollowState => ResolveFollowState(IsLive, IsLoading, _paused, _pageIndexFromNewest);
    private bool IsTailingLive => CurrentFollowState == LogFollowState.Live;
    private string TailButtonClass => IsTailingLive ? "log-tail-btn armed" : "log-tail-btn cta";

    private string FollowStateCss => CurrentFollowState switch
    {
        LogFollowState.Live => "live",
        LogFollowState.Historical => "historical",
        _ => "paused"
    };

    private string FollowStateText => CurrentFollowState switch
    {
        LogFollowState.Live => "Live • tailing",
        LogFollowState.Historical => "Historical (older loaded)",
        _ => $"Paused at line {GetFollowLineNumber():N0}"
    };

    private int GetFollowLineNumber()
    {
        var total = FilteredLines.Count;
        if (total == 0)
            return 0;
        var (_, endExclusive) = GetVisibleBounds(total);
        return endExclusive;
    }

    private Queue<string> Lines = new();
    private bool IsLive = true;
    private bool IsLoading;
    private string TextFilter = "";
    private CancellationTokenSource? _cts;
    private ElementReference _logContainer;
    private Task? _streamTask;
    private LogRange _selectedRange = LogRange.Last5m;
    private string _selectedContainer = string.Empty;
    private bool _paused;
    private bool _historyReloading;
    private bool _exportingAllLogs;
    private string? _activeStreamSignature;
    private int _requestedTailLines = Limits.LogTailInitialLines;
    private int _pageIndexFromNewest;
    private int _pendingNewLineCount;
    private int? _frozenFilteredLineCount;
    private bool _frozenAnchorNeedsRefresh;
    private bool IsPreviousContainerSelected => _selectedRange == LogRange.PreviousContainer;
    private bool IsAllRangeSelected => _selectedRange == LogRange.All;
    private bool IsWindowFrozen => _paused || _pageIndexFromNewest > 0;

    // PERF2-3: Cached filtered lines — recomputed only when dirty
    private List<LogEntry> _filteredLinesCache = [];
    private List<LogEntry> _visibleLineCache = [];
    private bool _filterDirty = true;
    private bool _visibleLineDirty = true;
    private volatile bool _forceScrollToBottom;
    private volatile bool _hasScrolledToBottom;
    private int _lastFilteredLineCount;
    private string _lastFilterText = "";
    private readonly Lock _linesLock = new();

    private List<LogEntry> FilteredLines
    {
        get
        {
            var filterText = TextFilter;
            string[] snapshot;

            lock (_linesLock)
            {
                if (!_filterDirty && Lines.Count == _lastFilteredLineCount && filterText == _lastFilterText)
                {
                    return _filteredLinesCache;
                }

                snapshot = [.. Lines];
                _lastFilteredLineCount = snapshot.Length;
                _lastFilterText = filterText;
                _filterDirty = false;
            }

            var source = string.IsNullOrEmpty(filterText)
                ? snapshot.AsEnumerable()
                : snapshot.Where(line => line.Contains(filterText, StringComparison.OrdinalIgnoreCase));

            _filteredLinesCache = source.Select(line => new LogEntry(line, GetLineClass(line))).ToList();
            ClampPageIndex(_filteredLinesCache.Count);
            return _filteredLinesCache;
        }
    }

    private List<LogEntry> VisibleLines
    {
        get
        {
            if (!_visibleLineDirty)
                return _visibleLineCache;

            var filtered = FilteredLines;
            if (filtered.Count == 0)
            {
                _visibleLineCache = [];
                _visibleLineDirty = false;
                return _visibleLineCache;
            }

            var (start, endExclusive) = GetVisibleBounds(filtered.Count);
            _visibleLineCache = filtered.GetRange(start, endExclusive - start);
            _visibleLineDirty = false;
            return _visibleLineCache;
        }
    }

    private string WindowSummaryText
    {
        get
        {
            var total = FilteredLines.Count;
            if (total == 0)
                return "0 lines";

            var (start, endExclusive) = GetVisibleBounds(total);
            return $"Showing {start + 1:N0}-{endExclusive:N0} of {total:N0}";
        }
    }

    private string BufferSummaryText
    {
        get
        {
            var bufferedCount = GetBufferedLineCount();
            if (bufferedCount >= EffectiveBufferSize)
                return $"Buffer holding newest {bufferedCount:N0} lines";

            return $"Buffer holding {bufferedCount:N0} lines";
        }
    }

    private string PendingLinesSummary
        => _pendingNewLineCount == 1
            ? "1 newer line buffered"
            : $"{_pendingNewLineCount:N0} newer lines buffered";

    private string LatestButtonText
        => _pendingNewLineCount > 0 ? $"Latest ({_pendingNewLineCount:N0})" : "Latest";

    private string HistoryExpansionLabel => $"{Limits.LogHistoryExpansionLines:N0}";

    private bool CanShowOlder => _pageIndexFromNewest < GetMaxPageIndex(FilteredLines.Count);
    private bool CanShowNewer => _pageIndexFromNewest > 0;
    private bool CanJumpToLatest => _pageIndexFromNewest > 0 || _pendingNewLineCount > 0;
    private bool CanLoadOlderHistory =>
        IsAllRangeSelected
        && _requestedTailLines < Limits.LogHistoryHardCapLines
        && Client is not null
        && Namespace is not null
        && PodName is not null;

    private string EmptyStateText
        => string.IsNullOrWhiteSpace(TextFilter)
            ? "No log lines yet"
            : "No log lines match the current filter";

    private int EffectiveBufferSize =>
        Math.Min(Math.Max(BufferSize, _requestedTailLines + Limits.LogVisibleWindowLines), Limits.LogHistoryHardCapLines);

    private void InvalidateFilter()
    {
        _filterDirty = true;
        _visibleLineDirty = true;
        RequestFrozenAnchorRefresh();
    }

    // PERF2-2: Render-batching timer state
    private PeriodicTimer? _renderTimer;
    private Task? _renderTimerTask;
    private volatile bool _linesDirty;

    protected override async Task OnParametersSetAsync()
    {
        if (Containers.Count > 0 && (string.IsNullOrEmpty(_selectedContainer) || !Containers.Contains(_selectedContainer)))
            _selectedContainer = Containers[0];

        if (Client is null || PodName is null || Namespace is null)
        {
            _activeStreamSignature = null;
            StopTailing();
            return;
        }

        var signature = BuildStreamSignature();
        if (!string.Equals(_activeStreamSignature, signature, StringComparison.Ordinal))
            await StartTailingAsync();
    }

    private async Task OnLiveToggle()
    {
        if (IsPreviousContainerSelected)
        {
            IsLive = false;
            _paused = false;
            return;
        }

        if (IsLive) await StartTailingAsync();
        else
        {
            StopTailing();
            IsLoading = false;
            _paused = false;
            _activeStreamSignature = BuildStreamSignature();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnContainerChanged(ChangeEventArgs e)
    {
        _selectedContainer = e.Value?.ToString() ?? string.Empty;
        if (Client is null || Namespace is null || PodName is null)
            return;
        await StartTailingAsync();
    }

    private async Task OnRangeChanged()
    {
        if (IsPreviousContainerSelected)
        {
            IsLive = false;
            _paused = false;
        }

        if (!IsAllRangeSelected)
            _requestedTailLines = Limits.LogTailInitialLines;

        if (Client is null || Namespace is null || PodName is null)
            return;
        await StartTailingAsync();
    }

    private void TogglePause()
    {
        _paused = !_paused;
        if (_paused)
        {
            CaptureVisibleWindowAnchor();
        }
        else if (_pageIndexFromNewest == 0)
        {
            _pendingNewLineCount = 0;
            _forceScrollToBottom = true;
            ReleaseVisibleWindowAnchor();
        }

        _visibleLineDirty = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadOlderHistoryAsync()
    {
        if (!CanLoadOlderHistory || _historyReloading)
            return;

        _historyReloading = true;
        _requestedTailLines = Math.Min(
            Limits.LogHistoryHardCapLines,
            _requestedTailLines + Limits.LogHistoryExpansionLines);

        try
        {
            await StartTailingAsync(preserveView: true);
        }
        finally
        {
            _historyReloading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartTailingAsync(bool preserveView = false)
    {
        _activeStreamSignature = BuildStreamSignature();

        // PERF2-4: Interlocked swap for thread-safe CTS lifecycle
        var newCts = new CancellationTokenSource();
        var oldCts = Interlocked.Exchange(ref _cts, newCts);
        oldCts?.Cancel();
        oldCts?.Dispose();
        var token = newCts.Token;

        IsLoading = true;
        _paused = false;
        _forceScrollToBottom = true;
        _hasScrolledToBottom = false;
        ReleaseVisibleWindowAnchor();
        if (!preserveView)
        {
            _pageIndexFromNewest = 0;
            _pendingNewLineCount = 0;
        }
        ClearLineBuffer();
        _linesDirty = false;
        _filterDirty = true;
        _visibleLineDirty = true;
        await InvokeAsync(StateHasChanged);

        StopRenderTimer();
        StartRenderTimer(token);

        _streamTask = Task.Run(() => StreamLogsAsync(token));
    }

    private void StopTailing()
    {
        var oldCts = Interlocked.Exchange(ref _cts, null);
        oldCts?.Cancel();
        oldCts?.Dispose();
        StopRenderTimer();
    }

    // PERF2-2: Timer-driven render loop — caps at ~10 renders/sec
    private void StartRenderTimer(CancellationToken token)
    {
        var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(Limits.LogRenderBatchIntervalMs));
        _renderTimer = timer;
        _renderTimerTask = Task.Run(async () =>
        {
            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    if (!_linesDirty) continue;
                    _linesDirty = false;
                    await InvokeAsync(() => { _filterDirty = true; _visibleLineDirty = true; StateHasChanged(); });
                    if (IsLive && !_paused && _pageIndexFromNewest == 0)
                    {
                        if (_forceScrollToBottom)
                        {
                            _forceScrollToBottom = false;
                            _hasScrolledToBottom = true;
                            await JS.InvokeVoidAsync("SwebKit.scrollToBottom", _logContainer);
                        }
                        else if (_hasScrolledToBottom)
                        {
                            var atBottom = await JS.InvokeAsync<bool>("SwebKit.scrollToBottomIfNearBottom", _logContainer, 80);
                            if (!atBottom)
                                await InvokeAsync(() => { CaptureVisibleWindowAnchor(); _paused = true; _visibleLineDirty = true; StateHasChanged(); });
                        }
                    }
                }
            }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
        });
    }

    private void StopRenderTimer()
    {
        var timer = Interlocked.Exchange(ref _renderTimer, null);
        timer?.Dispose();
    }

    private async Task StreamLogsAsync(CancellationToken token)
    {
        try
        {
            var opts = BuildLogStreamOptions();
            var container = _selectedContainer;
            await foreach (var line in Client!.StreamPodLogsAsync(Namespace!, PodName!, container, opts, token))
            {
                if (!IsCurrentSession(token)) break;
                AppendLine(line);
                _linesDirty = true;
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (IsCurrentSession(token))
            {
                // Final flush after stream ends
                _linesDirty = false;
                _filterDirty = true;
                StopRenderTimer();
                await InvokeAsync(() => { IsLoading = false; _paused = false; _visibleLineDirty = true; StateHasChanged(); });
            }
        }
    }

    private void AppendLine(string line)
    {
        lock (_linesLock)
        {
            Lines.Enqueue(line);
            while (Lines.Count > EffectiveBufferSize)
                Lines.Dequeue();
        }

        if (IsWindowFrozen)
            Interlocked.Increment(ref _pendingNewLineCount);
    }

    private void ClearLineBuffer()
    {
        lock (_linesLock)
        {
            Lines.Clear();
        }
    }

    private bool IsCurrentSession(CancellationToken token)
        => _cts?.Token.Equals(token) == true;

    private LogStreamOptions BuildLogStreamOptions()
    {
        var opts = new LogStreamOptions { Follow = IsLive };

        switch (_selectedRange)
        {
            case LogRange.Last5m:
                opts.SinceSeconds = 5 * 60;
                break;
            case LogRange.Last10m:
                opts.SinceSeconds = 10 * 60;
                break;
            case LogRange.Last1h:
                opts.SinceSeconds = 60 * 60;
                break;
            case LogRange.All:
                opts.TailLines = _requestedTailLines;
                break;
            case LogRange.PreviousContainer:
                opts.PreviousContainer = true;
                opts.Follow = false;
                break;
        }

        return opts;
    }

    private LogStreamOptions BuildExportOptions()
    {
        if (IsPreviousContainerSelected)
        {
            return new LogStreamOptions
            {
                Follow = false,
                PreviousContainer = true
            };
        }

        return new LogStreamOptions
        {
            Follow = false
        };
    }

    private void ClearLogs()
    {
        ClearLineBuffer();
        _filterDirty = true;
        _visibleLineDirty = true;
        _pageIndexFromNewest = 0;
        _pendingNewLineCount = 0;
        _forceScrollToBottom = true;
        ReleaseVisibleWindowAnchor();
        StateHasChanged();
    }

    private void ShowOlder()
    {
        CaptureVisibleWindowAnchor();
        var maxPageIndex = GetMaxPageIndex(FilteredLines.Count);
        if (_pageIndexFromNewest >= maxPageIndex)
            return;

        _pageIndexFromNewest++;
        _visibleLineDirty = true;
        StateHasChanged();
    }

    private void ShowNewer()
    {
        if (_pageIndexFromNewest == 0)
            return;

        _pageIndexFromNewest--;
        if (_pageIndexFromNewest == 0 && !_paused)
        {
            _pendingNewLineCount = 0;
            _forceScrollToBottom = true;
            ReleaseVisibleWindowAnchor();
        }

        _visibleLineDirty = true;
        StateHasChanged();
    }

    private void JumpToLatest()
    {
        _pageIndexFromNewest = 0;
        _pendingNewLineCount = 0;
        _forceScrollToBottom = true;
        if (_paused)
            CaptureVisibleWindowAnchor();
        else
            ReleaseVisibleWindowAnchor();
        _visibleLineDirty = true;
        StateHasChanged();
    }

    // C1: one-click "go to live / tail" — resumes live, resets to newest, and pins to bottom
    // via the existing SwebKit.scrollToBottom interop path (single click, not a per-append scroll).
    private async Task GoLiveTailAsync()
    {
        if (IsPreviousContainerSelected)
            return;

        var wasStopped = !IsLive || !IsLoading;

        IsLive = true;
        _paused = false;
        _pageIndexFromNewest = 0;
        _pendingNewLineCount = 0;
        ReleaseVisibleWindowAnchor();
        _visibleLineDirty = true;

        if (wasStopped && Client is not null && Namespace is not null && PodName is not null)
        {
            // Stream was stopped/ended — restart it; the render timer forces the first scroll.
            await StartTailingAsync();
            return;
        }

        // Already streaming (was paused or scrolled up) — pin to bottom now and let the
        // throttled render loop keep it near-bottom on subsequent flushes.
        _forceScrollToBottom = false;
        _hasScrolledToBottom = true;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("SwebKit.scrollToBottom", _logContainer);
    }

    private async Task CopyVisibleLogsAsync()
    {
        if (VisibleLines.Count == 0)
            return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", FormatVisibleLinesForClipboard());
            Notify.ShowSuccess("Copied visible log window", $"{VisibleLines.Count:N0} lines");
        }
        catch (Exception ex)
        {
            Notify.ShowError("Copy failed", ex.Message);
        }
    }

    private async Task ExportAllLogsAsync()
    {
        if (Client is null || Namespace is null || PodName is null || _exportingAllLogs)
            return;

        var ns = Namespace;
        var podName = PodName;
        _exportingAllLogs = true;
        await InvokeAsync(StateHasChanged);

        var ts = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        var podSlug = podName.Replace('/', '-');
        var fileName = $"{podSlug}-{ts}.log";

        try
        {
            var downloads = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            Directory.CreateDirectory(downloads);
            var filePath = Path.Combine(downloads, fileName);

            var lineCount = 0;
            var opts = BuildExportOptions();
            var container = ResolveSelectedContainer();

            await using (var writer = new StreamWriter(filePath, append: false, System.Text.Encoding.UTF8))
            {
                await foreach (var line in Client.StreamPodLogsAsync(ns, podName, container, opts))
                {
                    await writer.WriteLineAsync(line);
                    lineCount++;
                }
            }

            Notify.ShowSuccess($"Exported {lineCount:N0} lines to {filePath}");
        }
        catch (OperationCanceledException)
        {
            Notify.ShowWarning("Export cancelled");
        }
        catch (Exception ex)
        {
            Notify.ShowError("Export failed", ex.Message);
        }
        finally
        {
            _exportingAllLogs = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string ResolveSelectedContainer()
        => !string.IsNullOrWhiteSpace(_selectedContainer)
            ? _selectedContainer
            : Containers.FirstOrDefault() ?? string.Empty;

    private string FormatVisibleLinesForClipboard()
        => string.Join('\n', VisibleLines.Select(entry => entry.Line));

    private string BuildStreamSignature()
        => $"{Namespace}|{PodName}|{ResolveSelectedContainer()}|{_selectedRange}|{IsLive}|{_requestedTailLines}";

    private static int GetMaxPageIndex(int totalLineCount)
        => totalLineCount == 0 ? 0 : (totalLineCount - 1) / Limits.LogVisibleWindowLines;

    private void ClampPageIndex(int totalLineCount)
    {
        var maxPageIndex = GetMaxPageIndex(GetReferenceLineCount(totalLineCount));
        if (_pageIndexFromNewest > maxPageIndex)
            _pageIndexFromNewest = maxPageIndex;
    }

    private (int Start, int EndExclusive) GetVisibleBounds(int totalLineCount)
    {
        ClampPageIndex(totalLineCount);

        var referenceCount = GetReferenceLineCount(totalLineCount);
        var endExclusive = Math.Max(0, referenceCount - (_pageIndexFromNewest * Limits.LogVisibleWindowLines));
        var start = Math.Max(0, endExclusive - Limits.LogVisibleWindowLines);
        return (start, endExclusive);
    }

    private int GetReferenceLineCount(int totalLineCount)
    {
        if (!IsWindowFrozen)
            return totalLineCount;

        if (_frozenAnchorNeedsRefresh || _frozenFilteredLineCount is null)
        {
            _frozenFilteredLineCount = totalLineCount;
            _frozenAnchorNeedsRefresh = false;
        }

        return Math.Min(_frozenFilteredLineCount.Value, totalLineCount);
    }

    private void CaptureVisibleWindowAnchor()
    {
        _frozenFilteredLineCount = FilteredLines.Count;
        _frozenAnchorNeedsRefresh = false;
    }

    private void ReleaseVisibleWindowAnchor()
    {
        _frozenFilteredLineCount = null;
        _frozenAnchorNeedsRefresh = false;
    }

    private void RequestFrozenAnchorRefresh()
    {
        if (IsWindowFrozen)
            _frozenAnchorNeedsRefresh = true;
    }

    private int GetBufferedLineCount()
    {
        lock (_linesLock)
        {
            return Lines.Count;
        }
    }

    internal static string GetLineClass(string line)
    {
        if (line.Length == 0 || line[0] == '{')
            return "log-level-default";
        var window = line.Length > 120 ? line[..120] : line;
        if (window.Contains("[ERR]", StringComparison.OrdinalIgnoreCase) ||
            window.Contains("[FATAL]", StringComparison.OrdinalIgnoreCase) ||
            window.Contains("[CRIT]", StringComparison.OrdinalIgnoreCase) ||
            window.Contains("ERROR", StringComparison.OrdinalIgnoreCase) ||
            window.Contains("FATAL", StringComparison.OrdinalIgnoreCase) ||
            window.Contains("CRITICAL", StringComparison.OrdinalIgnoreCase))
            return "log-level-error";
        if (window.Contains("[WRN]", StringComparison.OrdinalIgnoreCase) ||
            window.Contains("[WARN]", StringComparison.OrdinalIgnoreCase) ||
            window.Contains("WARN", StringComparison.OrdinalIgnoreCase) ||
            window.Contains("WARNING", StringComparison.OrdinalIgnoreCase))
            return "log-level-warn";
        if (window.Contains("[DBG]", StringComparison.OrdinalIgnoreCase) ||
            window.Contains("[TRC]", StringComparison.OrdinalIgnoreCase) ||
            window.Contains("[VRB]", StringComparison.OrdinalIgnoreCase) ||
            window.Contains("DEBUG", StringComparison.OrdinalIgnoreCase) ||
            window.Contains("TRACE", StringComparison.OrdinalIgnoreCase))
            return "log-level-debug";
        return "log-level-default";
    }

    public override async ValueTask DisposeAsync()
    {
        // PERF2-4: Thread-safe CTS teardown
        var cts = Interlocked.Exchange(ref _cts, null);
        cts?.Cancel();
        cts?.Dispose();
        _activeStreamSignature = null;

        StopRenderTimer();

        if (_streamTask is not null)
        {
            try { await _streamTask.WaitAsync(TimeSpan.FromSeconds(2)); }
            catch (OperationCanceledException) { }
            catch (TimeoutException) { }
        }

        await base.DisposeAsync();
    }
}
