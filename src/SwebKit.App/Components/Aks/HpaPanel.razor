@* Renders the HPA detail panel content. Wrapping header/pane is owned by AksPage. *@

<div class="aks-yaml-content">
    <div class="aks-hpa-detail">

        @* ── Refresh button ── *@
        <div style="display:flex; justify-content:flex-end; margin-bottom:8px;">
            <FluentButton Appearance="Appearance.Stealth" @onclick="OnRefreshRequested" Title="Refresh HPA data">
                ↻ Refresh
            </FluentButton>
        </div>

        @* ── Target ── *@
        <div class="aks-hpa-row">
            <span class="aks-hpa-label">Target</span>
            <span class="aks-hpa-value">
                <span class="aks-hpa-kind-badge">@Hpa.TargetKind</span>
                @Hpa.TargetName
            </span>
        </div>

        @* ── Replica overview card ── *@
        <div class="aks-hpa-replica-card">
            <div class="aks-hpa-replica-stats">
                <div class="aks-hpa-stat">
                    <span class="aks-hpa-stat-num current">@Hpa.CurrentReplicas</span>
                    <span class="aks-hpa-stat-lbl">Current</span>
                </div>
                <div class="aks-hpa-stat-arrow">→</div>
                <div class="aks-hpa-stat">
                    <span class="aks-hpa-stat-num @(Hpa.DesiredReplicas == Hpa.CurrentReplicas ? "desired-stable" : "desired-scaling")">
                        @Hpa.DesiredReplicas
                    </span>
                    <span class="aks-hpa-stat-lbl">Desired</span>
                </div>
            </div>
            <div class="aks-hpa-replica-bounds">
                <span>min <strong>@Hpa.MinReplicas</strong></span>
                <div class="aks-hpa-replica-track">
                    <div class="aks-hpa-replica-fill"
                         style="width: @(Math.Round(100.0 * Hpa.CurrentReplicas / Math.Max(Hpa.MaxReplicas, 1)))%">
                    </div>
                </div>
                <span>max <strong>@Hpa.MaxReplicas</strong></span>
            </div>
        </div>

        @* ── Metrics ── *@
        @if (Hpa.Metrics.Count > 0)
        {
            <div class="aks-hpa-section-label">Metrics</div>
            <table class="aks-hpa-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Current</th>
                        <th>Target</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Hpa.Metrics)
                    {
                        var pct = m.CurrentValue.HasValue && m.TargetValue.HasValue
                            ? (double)m.CurrentValue.Value / m.TargetValue.Value
                            : (double?)null;
                        <tr>
                            <td class="aks-hpa-metric-name">@m.Name</td>
                            <td><span class="aks-hpa-type-badge">@m.Type</span></td>
                            <td class="@(pct > 0.9 ? "metric-high" : pct > 0.7 ? "metric-med" : "metric-ok")">
                                @(m.CurrentValue.HasValue ? $"{m.CurrentValue:F0}%" : "—")
                            </td>
                            <td class="aks-hpa-target-val">@(m.TargetValue.HasValue ? $"{m.TargetValue:F0}%" : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @* ── Conditions ── *@
        @if (Hpa.Conditions.Count > 0)
        {
            <div class="aks-hpa-section-label">Conditions</div>
            <div class="aks-hpa-conditions">
                @foreach (var cond in Hpa.Conditions)
                {
                    <div class="aks-hpa-condition @(cond.Status == "True" ? "cond-ok" : "cond-warn")">
                        <div class="aks-hpa-condition-header">
                            <span class="aks-hpa-cond-dot"></span>
                            <span class="aks-hpa-cond-type">@cond.Type</span>
                            <span class="aks-ready-badge @(cond.Status == "True" ? "healthy" : "degraded")">@cond.Status</span>
                        </div>
                        @if (!string.IsNullOrEmpty(cond.Reason))
                        {
                            <div class="aks-hpa-cond-reason">@cond.Reason</div>
                        }
                    </div>
                }
            </div>
        }

    </div>
</div>

@code {
    [Parameter, EditorRequired] public HpaInfo Hpa { get; set; } = default!;
    [Parameter] public EventCallback OnRefreshRequested { get; set; }
}
