@* Renders the Secrets FluentDataGrid. *@

<FluentDataGrid Items="@FilteredItems" TGridItem="SecretInfo" Virtualize="true" ItemSize="36"
                RowClass="@(s => s.Name == SelectedSecret?.Name ? "selected-row" : "")"
                OnRowClick="@(r => { if (r.Item is not null) OnSelectRow.InvokeAsync(r.Item); })">
    <TemplateColumn Title="Name">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            <span class="aks-resource-name">@context.Name</span>
        </div>
    </TemplateColumn>
    @if (IsMultiNamespace)
    {
        <TemplateColumn Title="Namespace" Width="130px">
            <span class="aks-ns-cell">@context.Namespace</span>
        </TemplateColumn>
    }
    <TemplateColumn Title="Type" Width="160px">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            <span class="aks-text-muted">@context.Type</span>
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Keys" Width="70px">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            <span class="aks-section-count">@context.Keys.Count</span>
        </div>
    </TemplateColumn>
</FluentDataGrid>

@code {
    [Parameter] public IQueryable<SecretInfo> FilteredItems { get; set; } = Enumerable.Empty<SecretInfo>().AsQueryable();
    [Parameter] public bool IsMultiNamespace { get; set; }
    [Parameter] public SecretInfo? SelectedSecret { get; set; }
    [Parameter] public EventCallback<SecretInfo> OnSelectRow { get; set; }
    [Parameter] public EventCallback<(MouseEventArgs, SecretInfo)> OnContextMenu { get; set; }
}
