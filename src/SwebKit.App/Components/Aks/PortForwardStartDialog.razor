@if (Visible)
{
    <div class="port-forward-start__backdrop">
        <div class="port-forward-start__dialog" role="dialog" aria-modal="true">
            <h3 class="port-forward-start__title">
                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowForward())" Width="16px" />
                Start Port-Forward
            </h3>

            <div class="port-forward-start__grid">
                <span class="port-forward-start__label">Pod</span>
                <span class="port-forward-start__value port-forward-start__value--strong">@PodName</span>

                <span class="port-forward-start__label">Namespace</span>
                <span class="port-forward-start__value">@Namespace</span>

                <span class="port-forward-start__label">Remote port</span>
                <span class="port-forward-start__value">@RemotePort</span>

                <span class="port-forward-start__label">Local port</span>
                <input type="number" min="1024" max="65535" @bind="LocalPort" @bind:event="oninput"
                       class="port-forward-start__input app-native-control" />
            </div>

            @if (_error is not null)
            {
                <p class="port-forward-start__message port-forward-start__message--error">@_error</p>
            }
            @if (_portWarning is not null)
            {
                <p class="port-forward-start__message port-forward-start__message--warning">⚠ @_portWarning</p>
            }

            <div class="port-forward-start__actions">
                <button @onclick="Cancel" class="port-forward-start__btn port-forward-start__btn--secondary">Cancel</button>
                <button @onclick="Start" disabled="@(!IsValid)"
                        class="port-forward-start__btn port-forward-start__btn--primary @(!IsValid ? "port-forward-start__btn--disabled" : string.Empty)">
                    Start
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string PodName { get; set; } = "";
    [Parameter] public string Namespace { get; set; } = "";
    [Parameter] public int RemotePort { get; set; }
    [Parameter] public EventCallback<int> OnStart { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private int LocalPort;
    private string? _error;
    private string? _portWarning;

    private bool IsValid => LocalPort is >= 1024 and <= 65535;

    protected override void OnParametersSet()
    {
        // Pre-fill local port with remote port each time the dialog opens
        if (Visible) LocalPort = RemotePort;
        _error = null;
        _portWarning = null;
    }

    private async Task Start()
    {
        if (!IsValid) { _error = "Local port must be between 1024 and 65535."; return; }

        // AKS-15: Check if local port is free
        _portWarning = null;
        try
        {
            using var listener = new System.Net.Sockets.TcpListener(System.Net.IPAddress.Loopback, LocalPort);
            listener.Start();
            listener.Stop();
        }
        catch (System.Net.Sockets.SocketException)
        {
            _portWarning = $"Port {LocalPort} appears to be in use.";
            // Suggest next available port
            for (int p = LocalPort + 1; p <= Math.Min(LocalPort + 10, 65535); p++)
            {
                try
                {
                    using var probe = new System.Net.Sockets.TcpListener(System.Net.IPAddress.Loopback, p);
                    probe.Start();
                    probe.Stop();
                    _portWarning += $" Try port {p} instead.";
                    break;
                }
                catch (System.Net.Sockets.SocketException) { }
            }
            StateHasChanged();
            return;
        }

        await OnStart.InvokeAsync(LocalPort);
    }

    private Task Cancel() => OnCancel.InvokeAsync();
}
