@if (Visible)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:500; display:flex; align-items:center; justify-content:center;">
        <div style="background:var(--color-surface-2); border:1px solid var(--color-border); border-radius:8px; padding:24px; max-width:400px; width:90%;">
            <h3 style="margin:0 0 16px; font-size:15px; display:flex; align-items:center; gap:8px;">
                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowForward())" Width="16px" />
                Start Port-Forward
            </h3>

            <div style="display:grid; grid-template-columns:auto 1fr; gap:8px 12px; align-items:center; margin-bottom:20px; font-size:13px;">
                <span style="color:var(--color-text-muted);">Pod</span>
                <span style="font-weight:500;">@PodName</span>

                <span style="color:var(--color-text-muted);">Namespace</span>
                <span>@Namespace</span>

                <span style="color:var(--color-text-muted);">Remote port</span>
                <span>@RemotePort</span>

                <span style="color:var(--color-text-muted);">Local port</span>
                <input type="number" min="1024" max="65535" @bind="LocalPort" @bind:event="oninput"
                       style="padding:5px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px; width:120px;" />
            </div>

            @if (_error is not null)
            {
                <p style="color:var(--color-error, #f44); font-size:12px; margin:0 0 12px;">@_error</p>
            }

            <div style="display:flex; gap:8px; justify-content:flex-end;">
                <button @onclick="Cancel" style="padding:6px 16px; cursor:pointer;">Cancel</button>
                <button @onclick="Start" disabled="@(!IsValid)"
                        style="padding:6px 16px; background:var(--color-accent); color:white; border:none; border-radius:4px; cursor:pointer; @(!IsValid ? "opacity:0.5;" : "")">
                    Start
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string PodName { get; set; } = "";
    [Parameter] public string Namespace { get; set; } = "";
    [Parameter] public int RemotePort { get; set; }
    [Parameter] public EventCallback<int> OnStart { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private int LocalPort;
    private string? _error;

    private bool IsValid => LocalPort is >= 1024 and <= 65535;

    protected override void OnParametersSet()
    {
        // Pre-fill local port with remote port each time the dialog opens
        if (Visible) LocalPort = RemotePort;
        _error = null;
    }

    private async Task Start()
    {
        if (!IsValid) { _error = "Local port must be between 1024 and 65535."; return; }
        await OnStart.InvokeAsync(LocalPort);
    }

    private Task Cancel() => OnCancel.InvokeAsync();
}
