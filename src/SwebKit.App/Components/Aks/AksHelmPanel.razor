@inject IJSRuntime JS

@* ── Helm History ── *@
@if (_historyTarget is not null)
{
    <div class="aks-panel-pane">
        <div class="aks-section-header">
            <span class="aks-section-title">@(_rollbackMode ? "Rollback" : "History"):
                @_historyTarget</span>
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseHistory" Title="Close">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                </FluentButton>
            </div>
            @if (_rollbackMode)
            {
                <div class="aks-rollback-hint">Select a revision to rollback to:</div>
                @if (_rollbackInProgress && _rollbackRevisionInProgress.HasValue)
                {
                    <div class="aks-rollback-hint">Rolling back to revision @_rollbackRevisionInProgress.Value...</div>
                }
            }
            <div class="aks-yaml-content">
                @if (_historyLoading)
                {
                    <LoadingSpinner Message="Loading history…" />
                }
                else
                {
                    <table class="aks-history-table">
                        <thead>
                            <tr>
                                <th class="sortable-th" @onclick='() => SetSort("rev")'>Rev @SortIndicator("rev")</th>
                                <th class="sortable-th" @onclick='() => SetSort("status")'>Status @SortIndicator("status")</th>
                                <th class="sortable-th" @onclick='() => SetSort("chart")'>Chart @SortIndicator("chart")</th>
                                <th class="sortable-th" @onclick='() => SetSort("appver")'>App Version @SortIndicator("appver")</th>
                                <th class="sortable-th" @onclick='() => SetSort("updated")'>Updated @SortIndicator("updated")</th>
                                <th>Description</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rev in SortedHistory)
                            {
                                <tr class="@(rev.Status == "deployed" ? "aks-rev-current" : "")">
                                    <td>@rev.Revision</td>
                                    <td><span
                                        class="aks-status @(rev.Status == "deployed" ? "running" : rev.Status == "failed" ? "error" : "other")">@rev.Status</span>
                                    </td>
                                    <td>@rev.Chart</td>
                                    <td>@rev.AppVersion</td>
                                    <td>@rev.Updated?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@rev.Description</td>
                                    <td>
                                        @if (!_rollbackMode && rev.Status != "deployed")
                                        {
                                            var r = rev;
                                            <button class="ctx-item aks-rollback-btn"
                                                    style="display:inline-flex; align-items:center; gap:4px;"
                                                    disabled="@_rollbackInProgress"
                                                    @onclick="() => OnPreviewRollbackToRevision(r)">
                                                <FluentIcon Value="@(new Icons.Regular.Size16.SplitHorizontal())" Width="14px" />
                                                Diff
                                            </button>
                                        }
                                        else if (_rollbackMode && rev.Status == "superseded")
                                        {
                                            var r = rev;
                                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                                <button class="ctx-item aks-rollback-btn"
                                                        style="display:inline-flex; align-items:center; gap:4px;"
                                                        disabled="@_rollbackInProgress"
                                                        @onclick="() => OnPreviewRollbackToRevision(r)">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Eye())" Width="14px" />
                                                    Preview
                                                </button>
                                                <button class="ctx-item destructive aks-rollback-btn"
                                                        style="display:inline-flex; align-items:center; gap:4px;"
                                                        disabled="@_rollbackInProgress"
                                                        @onclick="() => OnRollbackToRevision(r)">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowCounterclockwise())" Width="14px" />
                                                    @(_rollbackInProgress && _rollbackRevisionInProgress == r.Revision ? "Rolling back..." : "Rollback")
                                                </button>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    @* ── Helm Values ── *@
    @if (_valuesTarget is not null && _historyTarget is null)
    {
        <div class="aks-panel-pane">
            <div class="aks-section-header">
                <span class="aks-section-title">Values: @_valuesTarget</span>
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseValues" Title="Close">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                </FluentButton>
            </div>
            <div class="aks-yaml-content">
                @if (_valuesLoading)
                {
                    <LoadingSpinner Message="Loading values…" />
                }
                else
                {
                    <pre class="aks-yaml-pre">@_valuesHighlighted</pre>
                }
            </div>
        </div>
    }

@code {
    [Parameter] public IAksClient? Client { get; set; }
    [Parameter] public string Namespace { get; set; } = "default";
    [Parameter] public bool IsProduction { get; set; }
    [Parameter] public AksConfirmBar Confirm { get; set; } = default!;
    [Parameter] public INotificationService Notifications { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public EventCallback<(string ReleaseName, string Namespace, int Revision)> OnPreviewRollback { get; set; }

    // History state
    private string? _historyTarget;
    private List<HelmRevisionInfo> _history = [];
    private bool _historyLoading;
    private bool _rollbackMode;
    private bool _rollbackInProgress;
    private int? _rollbackRevisionInProgress;
    private string _sortColumn = "rev";
    private bool _sortAscending = false;

    private IEnumerable<HelmRevisionInfo> SortedHistory =>
        _sortColumn switch
        {
            "status" => _sortAscending ? _history.OrderBy(r => r.Status) : _history.OrderByDescending(r => r.Status),
            "chart" => _sortAscending ? _history.OrderBy(r => r.Chart ?? "") : _history.OrderByDescending(r => r.Chart ?? ""),
            "appver" => _sortAscending ? _history.OrderBy(r => r.AppVersion ?? "") : _history.OrderByDescending(r => r.AppVersion ??
""),
            "updated" => _sortAscending ? _history.OrderBy(r => r.Updated ?? DateTimeOffset.MinValue) : _history.OrderByDescending(r
=> r.Updated ?? DateTimeOffset.MinValue),
            _ => _sortAscending ? _history.OrderBy(r => r.Revision) : _history.OrderByDescending(r => r.Revision),
        };

    private void SetSort(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
    }

    private string SortIndicator(string column) =>
        _sortColumn != column ? "" : _sortAscending ? "↑" : "↓";
    // Values state
    private string? _valuesTarget;
    private string? _valuesText;
    private bool _valuesLoading;
    private MarkupString _valuesHighlighted;

    // Public properties
    public bool IsHistoryOpen => _historyTarget is not null;
    public bool IsValuesOpen => _valuesTarget is not null;
    public bool IsOpen => IsHistoryOpen || IsValuesOpen;

    // ── Public methods (called by parent via @ref) ──

    public async Task ShowHistoryAsync(string releaseName)
    {
        if (Client is null) return;
        CloseValues();
        ResetHistoryState();
        _historyTarget = releaseName;
        _historyLoading = true;
        StateHasChanged();

        try
        {
            _history = (await Client.GetHelmReleaseHistoryAsync(Namespace, releaseName)).ToList();
        }
        catch (Exception ex) { await OnError.InvokeAsync(ex.Message); }
        finally { _historyLoading = false; await InvokeAsync(StateHasChanged); }
    }

    public async Task ShowValuesAsync(string releaseName)
    {
        if (Client is null) return;
        CloseHistory();
        _valuesTarget = releaseName;
        _valuesLoading = true;
        _valuesText = null;
        StateHasChanged();

        try
        {
            _valuesText = await Client.GetHelmReleaseValuesAsync(Namespace, releaseName);
            _valuesHighlighted = await HighlightAsync(_valuesText);
        }
        catch (Exception ex) { await OnError.InvokeAsync(ex.Message); }
        finally { _valuesLoading = false; await InvokeAsync(StateHasChanged); }
    }

    public async Task ShowRollbackAsync(string releaseName)
    {
        if (Client is null) return;
        CloseValues();
        ResetHistoryState();
        _historyTarget = releaseName;
        _rollbackMode = true;
        _historyLoading = true;
        StateHasChanged();

        try
        {
            _history = (await Client.GetHelmReleaseHistoryAsync(Namespace, releaseName)).ToList();
            var hasPrevious = _history.Any(r => r.Status == "superseded");
            if (!hasPrevious)
            {
                await OnError.InvokeAsync($"No previous revisions available for \"{releaseName}\".");
                CloseHistory();
                return;
            }
        }
        catch (Exception ex) { await OnError.InvokeAsync(ex.Message); CloseHistory(); return; }
        finally { _historyLoading = false; await InvokeAsync(StateHasChanged); }
    }

    public void CloseHistory()
    {
        ResetHistoryState();
        _rollbackInProgress = false;
        _rollbackRevisionInProgress = null;
        StateHasChanged();
    }

    private void ResetHistoryState()
    {
        _historyTarget = null;
        _history = [];
        _rollbackMode = false;
    }

    public void CloseValues()
    {
        _valuesTarget = null;
        _valuesText = null;
        StateHasChanged();
    }

    // ── Private methods ──

    private async Task OnPreviewRollbackToRevision(HelmRevisionInfo rev)
    {
        if (_historyTarget is null) return;
        await OnPreviewRollback.InvokeAsync((_historyTarget, Namespace, rev.Revision));
    }

    private async Task OnRollbackToRevision(HelmRevisionInfo rev)
    {
        if (_historyTarget is null || Client is null || _rollbackInProgress) return;
        var releaseName = _historyTarget;

        var confirmed = await Confirm.ShowAsync(
            $"Rollback \"{releaseName}\" to revision {rev.Revision} ({rev.Chart})?",
            releaseName,
            requireTypedName: IsProduction);
        if (!confirmed) return;

        _rollbackInProgress = true;
        _rollbackRevisionInProgress = rev.Revision;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Client.RollbackHelmReleaseAsync(Namespace, releaseName, rev.Revision);
            Notifications.ShowSuccess("Helm rollback complete", $"{releaseName} → revision {rev.Revision}");
            ResetHistoryState();

            try
            {
                await OnDataChanged.InvokeAsync();
            }
            catch (OperationCanceledException) { throw; }
            catch (Exception ex)
            {
                await OnError.InvokeAsync(ex.Message);
                Notifications.ShowWarning("Helm rollback complete, refresh failed", ex.Message);
            }
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
            Notifications.ShowError("Helm rollback failed", ex: ex);
        }
        finally
        {
            _rollbackInProgress = false;
            _rollbackRevisionInProgress = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<MarkupString> HighlightAsync(string? text)
    {
        if (string.IsNullOrEmpty(text)) return default;
        var clean = string.Join('\n', text.ReplaceLineEndings("\n")
            .Split('\n')
            .Where(static l => !string.IsNullOrWhiteSpace(l)));
        var html = await JS.InvokeAsync<string>("yamlHighlight.highlight", clean);
        return (MarkupString)html;
    }
}
