    private async Task CloseEvents()
    {
        await OnShowEventsChanged.InvokeAsync();
        await OnPanelStateChanged.InvokeAsync();
    }

    private async Task OnChildPanelClosed()
    {
        UpdateOpenTabs();
        await InvokeAsync(StateHasChanged); // BL-2
        await OnPanelStateChanged.InvokeAsync();
    }

    private void NotifyPanelStateChanged()
    {
        StateHasChanged();
        _ = OnPanelStateChanged.InvokeAsync();
        _ = OnIsOpenChanged.InvokeAsync(IsOpen);
    }

    private void ResetTransientPanels()
    {
        _yamlViewer?.Close();
        _logPodName = null;
        _logPodNamespace = null;
        _logDeploymentName = null;
        _logDeploymentNamespace = null;
        _logPodContainers = [];
        _containerDetailPodName = null;
        _containerDetailNamespace = null;
        _configMapDetailTarget = null;
        _secretDetailTarget = null;
        _hpaDetailTarget = null;
        _scaleTarget = null;
        _scaleNamespace = null;
    }

    private static string TruncatePodName(string name)
        => name.Length > 36 ? name[..18] + "…" + name[^14..] : name;

    // ── Tab management methods ──
    private bool ShouldShowTabs => _openTabs.Count > 1;

    private string GetLogsTabTitle()
    {
        if (_logPodName is not null) return "Logs: " + TruncatePodName(_logPodName);
        if (_logDeploymentName is not null) return "All-pod logs: " + _logDeploymentName;
        return "Logs";
    }

    private string GetContainerTabTitle()
    {
        if (_containerDetailPodName is not null) return "Containers: " + TruncatePodName(_containerDetailPodName);
        return "Containers";
    }

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
        StateHasChanged();
    }

    private void ActivateLogsTab() => SetActiveTab("logs");
    private void ActivateContainersTab() => SetActiveTab("containers");
    private void ActivateHpaTab() => SetActiveTab("hpa");
    private void ActivateYamlTab() => SetActiveTab("yaml");
    private void CloseLogsFromTab() { CloseLogs(); }
    private void CloseContainerDetailFromTab() { CloseContainerDetail(); }
    private void CloseHpaDetailFromTab() { CloseHpaDetail(); }
    private void CloseYamlFromTab() { CloseYaml(); }

    /// <summary>True when the HPA detail panel and its YAML view are both open for the same
    /// resource — in that case they render as two tabs in one pane instead of one replacing the other.</summary>
    private bool IsHpaYamlPairActive =>
        _hpaDetailTarget is not null &&
        _yamlViewer?.IsOpen == true &&
        string.Equals(_yamlViewer.TargetKind, "HPA", StringComparison.OrdinalIgnoreCase);

    private void UpdateOpenTabs()
    {
        var tabs = new List<string>();
        if (_logPodName is not null || _logDeploymentName is not null)
            tabs.Add("logs");
        if (_containerDetailPodName is not null)
            tabs.Add("containers");
        if (IsHpaYamlPairActive)
        {
            tabs.Add("hpa");
            tabs.Add("yaml");
        }
        _openTabs = tabs;

        // Self-heal: if the active tab no longer exists (its panel was closed), fall back to
        // whatever is still open instead of leaving every pane hidden.
        if (tabs.Count > 0 && !tabs.Contains(_activeTab))
        {
            _activeTab = tabs[0];
        }
    }
