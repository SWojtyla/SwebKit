    private Task OpenHpaYamlAsync(bool editMode)
    {
        if (_hpaDetailTarget is null)
        {
            return Task.CompletedTask;
        }

        return OpenYamlAsync("HPA", _hpaDetailTarget.Name, editMode, _hpaDetailTarget.Namespace);
    }

    private async Task RefreshHpaDetailAsync()
    {
        if (Client is null || _hpaDetailTarget is null)
            return;

        try
        {
            var target = _hpaDetailTarget;
            var hpas = await Client.GetHpasAsync(target.Namespace);
            _hpaDetailTarget = hpas.FirstOrDefault(h => h.Name == target.Name && h.Namespace == target.Namespace) ?? target;
            await OnDataChanged.InvokeAsync();
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
            Notifications.ShowError("Failed to refresh HPA", ex: ex);
        }

        await InvokeAsync(StateHasChanged);
    }

