@* ── AksDetailPanels: Hosts all right-side detail panels for the AKS page ── *@

@if (HasOpenPanel)
{
    <SidePanel Visible="true" ShowHeader="false" DefaultWidth="620" MinWidth="320" MaxWidth="1600">
        <div class="aks-panels-col">

            @* ── Tab Bar (when multiple panels are open) ── *@
            @if (ShouldShowTabs)
            {
                <div class="aks-tab-bar">
                    @if (_logPodName != null || _logDeploymentName != null)
                    {
                        <div class="aks-tab @(_activeTab == "logs" ? "active" : string.Empty)" @onclick="ActivateLogsTab">
                            <span class="aks-tab-title">@GetLogsTabTitle()</span>
                            <button class="aks-tab-close" @onclick="CloseLogsFromTab" title="Close">
                                <FluentIcon Value="@_iconClose" Width="14px" />
                            </button>
                        </div>
                    }
                    @if (_containerDetailPodName != null)
                    {
                        <div class="aks-tab @(_activeTab == "containers" ? "active" : string.Empty)"
                             @onclick="ActivateContainersTab">
                            <span class="aks-tab-title">@GetContainerTabTitle()</span>
                            <button class="aks-tab-close" @onclick="CloseContainerDetailFromTab" title="Close">
                                <FluentIcon Value="@_iconClose" Width="14px" />
                            </button>
                        </div>
                    }
                    @if (IsHpaYamlPairActive)
                    {
                        <div class="aks-tab @(_activeTab == "hpa" ? "active" : string.Empty)" @onclick="ActivateHpaTab">
                            <span class="aks-tab-title">HPA</span>
                            <button class="aks-tab-close" @onclick="CloseHpaDetailFromTab" title="Close">
                                <FluentIcon Value="@_iconClose" Width="14px" />
                            </button>
                        </div>
                        <div class="aks-tab @(_activeTab == "yaml" ? "active" : string.Empty)" @onclick="ActivateYamlTab">
                            <span class="aks-tab-title">YAML</span>
                            <button class="aks-tab-close" @onclick="CloseYamlFromTab" title="Close">
                                <FluentIcon Value="@_iconClose" Width="14px" />
                            </button>
                        </div>
                    }
                </div>
            }

            @* ── YAML viewer / editor ── *@
            @* When paired with the HPA detail panel, only one of the two tabs is visible at a time —
               toggle CSS visibility (BL-4 pattern) instead of unmounting so state/scroll survive tab switches.
               Also hide whenever the viewer has no open target — otherwise this always-mounted flex:1 host
               keeps claiming half the panel height even while empty, starving whichever other pane (e.g. logs)
               is actually showing. *@
            <div class="aks-yaml-host"
                 hidden="@(_yamlViewer?.IsOpen != true || (IsHpaYamlPairActive && _activeTab != "yaml"))">
                <AksYamlViewer @ref="_yamlViewer" Client="Client" Namespace="@Namespace" IsProduction="@IsProduction"
                               Confirm="Confirm" Notifications="Notifications" OnClose="OnChildPanelClosed" OnError="OnError"
                               OnYamlApplied="OnDataChanged" />
            </div>

            @* ── Helm History / Values / Rollback ── *@
            <AksHelmPanel @ref="_helmPanel" Client="Client" Namespace="@Namespace" IsProduction="@IsProduction"
                          Confirm="Confirm" Notifications="Notifications" OnClose="OnChildPanelClosed" OnError="OnError"
                          OnDataChanged="OnDataChanged" OnPreviewRollback="OnHelmPreviewRollback" />

            @* ── Scale ── *@
            @if (_scaleTarget is not null && _yamlViewer?.IsOpen != true && _logPodName is null)
            {
                <div class="aks-panel-pane">
                    <div class="aks-section-header">
                        <span class="aks-section-title" title="@_scaleTarget">Scale: @_scaleTarget</span>
                        <FluentButton Appearance="Appearance.Stealth" @onclick="CancelScale" Title="Cancel">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                        </FluentButton>
                    </div>
                    <div class="aks-scale-panel">
                        <div class="aks-scale-label">Desired replicas</div>
                        <div class="aks-scale-stepper">
                            <button class="aks-scale-step-btn"
                                    @onclick="() => _scaleReplicas = Math.Max(0, _scaleReplicas - 1)">−</button>
                            <input type="number" class="aks-scale-input app-native-control" min="0" max="100"
                                   @bind="_scaleReplicas" @bind:event="oninput" />
                            <button class="aks-scale-step-btn"
                                    @onclick="() => _scaleReplicas = Math.Min(100, _scaleReplicas + 1)">+</button>
                        </div>
                        <div class="aks-scale-current">Currently: @(_scaleIsStatefulSet
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ? (StatefulSets.FirstOrDefault(s => s.Name == _scaleTarget)?.Replicas ?? 0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                : (Deployments.FirstOrDefault(d => d.Name == _scaleTarget)?.Replicas ?? 0)) replicas</div>
                            <div class="aks-scale-actions">
                                <button class="confirm-btn confirm-yes" @onclick="OnScaleConfirm">Apply</button>
                                <button class="confirm-btn confirm-no" @onclick="CancelScale">Cancel</button>
                            </div>
                        </div>
                    </div>
                }

                @* ── Pod logs ── *@
                @if (_logPodName is not null && _yamlViewer?.IsOpen != true && (_activeTab == "logs" || !ShouldShowTabs))
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header aks-log-header">
                            <span class="aks-section-title" title="@_logPodName">Logs: @TruncatePodName(_logPodName)</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseLogs" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <PodLogView Client="Client" Namespace="@(_logPodNamespace ?? Namespace)" PodName="@_logPodName"
                                    Containers="@_logPodContainers" />
                    </div>
                }

                @* ── Multi-pod logs ── *@
                @if (_logDeploymentName is not null && _logPodName is null && _yamlViewer?.IsOpen != true && (_activeTab ==
     "logs" || !ShouldShowTabs))
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header aks-log-header">
                            <span class="aks-section-title">All-pod logs: @_logDeploymentName</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseDeploymentLogs" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <MultiPodLogView Client="Client" Namespace="@(_logDeploymentNamespace ?? Namespace)"
                                         DeploymentName="@_logDeploymentName" />
                    </div>
                }

                @* ── Container details ── *@
                @if (_containerDetailPodName is not null && _yamlViewer?.IsOpen != true && (_activeTab == "containers" ||
        !ShouldShowTabs))
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header">
                            <span class="aks-section-title">Containers: @TruncatePodName(_containerDetailPodName)</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseContainerDetail" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <div class="aks-yaml-content">
                            <ContainerDetailPanel Client="Client" Namespace="@(_containerDetailNamespace ?? Namespace)"
                                                  PodName="@_containerDetailPodName" />
                        </div>
                    </div>
                }

                @* ── ConfigMap detail ── *@
                @if (_configMapDetailTarget is not null && _yamlViewer?.IsOpen != true)
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header">
                            <span class="aks-section-title">ConfigMap: @_configMapDetailTarget.Name</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseConfigMapDetail" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <ConfigMapDetailPanel ConfigMap="_configMapDetailTarget" />
                    </div>
                }

                @* ── Secret detail ── *@
                @if (_secretDetailTarget is not null && _yamlViewer?.IsOpen != true)
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header">
                            <span class="aks-section-title">Secret: @_secretDetailTarget.Name</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseSecretDetail" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <SecretDetailPanel Client="Client" Namespace="@Namespace" Secret="_secretDetailTarget" />
                    </div>
                }

                @* ── HPA detail ── *@
                @if (_hpaDetailTarget is not null && (_yamlViewer?.IsOpen != true || (IsHpaYamlPairActive && _activeTab ==
  "hpa")))
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header">
                            <span class="aks-detail-title-stack" title="@_hpaDetailTarget.Name">
                                <span class="aks-section-title">HPA</span>
                                <span class="aks-detail-subtitle">@_hpaDetailTarget.TargetKind @_hpaDetailTarget.TargetName</span>
                            </span>
                            <span class="aks-detail-header-spacer"></span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="RefreshHpaDetailAsync" Title="Refresh HPA data">
                                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowClockwise())" Width="16px" />
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="() => OpenHpaYamlAsync(false)"
                                          Title="View YAML">
                                YAML
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="() => OpenHpaYamlAsync(true)" Title="Edit YAML">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Width="16px" />
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseHpaDetail" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <HpaPanel Hpa="_hpaDetailTarget" />
                    </div>
                }

                @* ── Ingress analysis ── *@
                @if (_ingressAnalysisTarget is not null && _yamlViewer?.IsOpen != true && _logPodName is null &&
                                                                    _logDeploymentName is null)
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header">
                            <span class="aks-section-title">Ingress Analysis: @_ingressAnalysisTarget.Name</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseIngressAnalysis" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <div class="aks-yaml-content">
                            <IngressAnalysisPanel Client="Client" Namespace="@_ingressAnalysisTarget.Namespace"
                                                  IngressName="@_ingressAnalysisTarget.Name" />
                        </div>
                    </div>
                }

                @* ── Network policy analysis ── *@
                @if (_networkPolicyAnalysisTarget is not null && _yamlViewer?.IsOpen != true && _logPodName is null &&
                                                                    _logDeploymentName is null)
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header">
                            <span class="aks-section-title">Network Policies: @_networkPolicyAnalysisTarget.WorkloadName</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseNetworkPolicyAnalysis" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <div class="aks-yaml-content">
                            <NetworkPolicyAnalysisPanel Client="Client" Namespace="@_networkPolicyAnalysisTarget.Namespace"
                                                        WorkloadKind="@_networkPolicyAnalysisTarget.WorkloadKind"
                                                        WorkloadName="@_networkPolicyAnalysisTarget.WorkloadName" />
                        </div>
                    </div>
                }

                @* ── Namespace quota ── *@
                @if (_namespaceQuotaTarget is not null && _yamlViewer?.IsOpen != true && _logPodName is null &&
                                                                    _logDeploymentName is null)
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header">
                            <span class="aks-section-title">Namespace Quotas: @_namespaceQuotaTarget.Namespace</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseNamespaceQuota" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <div class="aks-yaml-content">
                            <NamespaceQuotaPanel Client="Client" Namespace="@_namespaceQuotaTarget.Namespace" />
                        </div>
                    </div>
                }

                @* ── Pod disruption budgets ── *@
                @if (_pdbTarget is not null && _yamlViewer?.IsOpen != true && _logPodName is null &&
                                                                    _logDeploymentName is null)
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header">
                            <span class="aks-section-title">Pod Disruption Budgets: @_pdbTarget.Namespace</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="ClosePodDisruptionBudgets" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <div class="aks-yaml-content">
                            <PodDisruptionBudgetPanel Client="Client" Namespace="@_pdbTarget.Namespace" />
                        </div>
                    </div>
                }

                @* ── Probe failure summary ── *@
                @if (_probeFailureTarget is not null && _yamlViewer?.IsOpen != true && _logPodName is null &&
                                                                    _logDeploymentName is null)
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header">
                            <span class="aks-section-title">Probe Failures: @_probeFailureTarget.WorkloadName</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseProbeFailures" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <div class="aks-yaml-content">
                            <ProbeFailurePanel Client="Client" Namespace="@_probeFailureTarget.Namespace"
                                               WorkloadKind="@_probeFailureTarget.WorkloadKind" WorkloadName="@_probeFailureTarget.WorkloadName" />
                        </div>
                    </div>
                }

                @* ── Placement constraints ── *@
                @if (_placementTarget is not null && _yamlViewer?.IsOpen != true && _logPodName is null &&
                                                                    _logDeploymentName is null)
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header">
                            <span class="aks-section-title">Placement: @_placementTarget.WorkloadName</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="ClosePlacementAnalysis" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <div class="aks-yaml-content">
                            <PlacementConstraintsPanel Client="Client" Namespace="@_placementTarget.Namespace"
                                                       WorkloadKind="@_placementTarget.WorkloadKind" WorkloadName="@_placementTarget.WorkloadName" />
                        </div>
                    </div>
                }

                @* ── Helm diff preview ── *@
                @if (_helmDiffPreviewTarget is not null && _yamlViewer?.IsOpen != true && _logPodName is null &&
                                                                    _logDeploymentName is null)
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header">
                            <span class="aks-section-title">Helm Preview: @_helmDiffPreviewTarget.ReleaseName</span>
                            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseHelmDiffPreview" Title="Close">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                            </FluentButton>
                        </div>
                        <div class="aks-yaml-content">
                            <HelmDiffPreviewPanel Client="Client" Namespace="@_helmDiffPreviewTarget.Namespace"
                                                  ReleaseName="@_helmDiffPreviewTarget.ReleaseName" />
                        </div>
                    </div>
                }

                @* ── Helm rollback diff preview ── *@
                @if (_helmRollbackPreviewTarget is not null && _yamlViewer?.IsOpen != true && _logPodName is null &&
                                                                    _logDeploymentName is null)
                {
                    <div class="aks-panel-pane">
                        <div class="aks-section-header">
                            <span class="aks-section-title">Rollback Preview: @_helmRollbackPreviewTarget.ReleaseName → rev
                                @_helmRollbackPreviewTarget.Revision</span>
                                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseHelmRollbackPreview" Title="Close">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                                </FluentButton>
                            </div>
                            <div class="aks-yaml-content">
                                <HelmRollbackPreviewPanel Client="Client" Namespace="@_helmRollbackPreviewTarget.Namespace"
                                                          ReleaseName="@_helmRollbackPreviewTarget.ReleaseName"
                                                          Revision="@_helmRollbackPreviewTarget.Revision" />
                            </div>
                        </div>
                    }

                    @* ── Events panel ── *@
                    @if (ShowEvents)
                    {
                        <div class="aks-panel-pane">
                            <div class="aks-section-header">
                                <span class="aks-section-title">Events</span>
                                <span class="aks-section-count">@Events.Count</span>
                                @if (_warningEventCount > 0)
                                {
                                    <span class="aks-event-warn-badge" style="display:inline-flex; align-items:center; gap:4px;">
                                        <FluentIcon Value="@_iconWarning" Width="14px" /> @_warningEventCount
                                    </span>
                                }
                                <span class="aks-toolbar-spacer"></span>
                                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseEvents" Title="Close">
                                    <FluentIcon Value="@_iconDismissEvt" Width="16px" />
                                </FluentButton>
                            </div>
                            <div class="aks-events-filter-bar">
                                <button class="aks-evt-filter-chip @(_eventTypeFilter == EventTypeFilter.All ? "active" : "")"
                                        @onclick="() => SetEventFilter(EventTypeFilter.All)">All</button>
                                <button class="aks-evt-filter-chip @(_eventTypeFilter == EventTypeFilter.Warning ? "active" : "")"
                                        @onclick="() => SetEventFilter(EventTypeFilter.Warning)">Warning</button>
                                <button class="aks-evt-filter-chip @(_eventTypeFilter == EventTypeFilter.Normal ? "active" : "")"
                                        @onclick="() => SetEventFilter(EventTypeFilter.Normal)">Normal</button>
                            </div>
                            <div class="aks-events-list">
                                @if (_filteredEvents.Count == 0)
                                {
                                    <div class="aks-events-empty">No recent events</div>
                                }
                                else
                                {
                                    @foreach (var evt in _filteredEvents)
                                    {
                                        <div class="aks-event-item @(evt.Type == "Warning" ? "warning" : "")">
                                            <div class="aks-event-header">
                                                @if (evt.Type == "Warning")
                                                {
                                                    <span class="aks-event-icon warning" style="display:inline-flex; align-items:center;">
                                                        <FluentIcon Value="@_iconWarning" Width="14px" />
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="aks-event-icon normal" style="display:inline-flex; align-items:center;">
                                                        <FluentIcon Value="@_iconCircle" Width="10px" />
                                                    </span>
                                                }
                                                <span class="aks-event-reason">@evt.Reason</span>
                                                @if (evt.Count > 1)
                                                {
                                                    <span class="aks-event-count">×@evt.Count</span>
                                                }
                                                <span class="aks-event-time">@evt.LastTimestamp?.ToString("HH:mm:ss")</span>
                                                @{
                                                    var jumpableKinds = new[] { "Deployment", "Pod", "StatefulSet", "CronJob", "Job" };
                                                    var canJump = jumpableKinds.Contains(evt.InvolvedObjectKind) && evt.InvolvedObjectName is not
                            null;
                                                    var resourceExists = canJump && ResourceExistsForEvent(evt);
                                                }
                                                @if (canJump)
                                                {
                                                    var capturedEvt = evt;
                                                    <button class="aks-evt-jump-btn" disabled="@(!resourceExists)"
                                                            title="@(resourceExists ? $"Go to {capturedEvt.InvolvedObjectKind} {capturedEvt.InvolvedObjectName}" : "Resource not currently loaded")"
                                                            @onclick="() => OnJumpToResource.InvokeAsync(capturedEvt)"
                                                            @onclick:stopPropagation>→</button>
                                                }
                                            </div>
                                            <div class="aks-event-detail">
                                                <span class="aks-event-object">@evt.InvolvedObjectName</span>
                                                @evt.Message
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }

                </div>
            </SidePanel>
        }

@code {
    // ── Parameters ──
    [Parameter] public IAksClient? Client { get; set; }
    [Parameter] public string Namespace { get; set; } = "default";
    [Parameter] public bool IsProduction { get; set; }
    [Parameter] public INotificationService Notifications { get; set; } = default!;
    [Parameter] public AksConfirmBar Confirm { get; set; } = default!;
    [Parameter] public List<KubernetesEvent> Events { get; set; } = [];
    [Parameter] public List<DeploymentInfo> Deployments { get; set; } = [];
    [Parameter] public List<StatefulSetInfo> StatefulSets { get; set; } = [];
    [Parameter] public List<PodInfo> Pods { get; set; } = [];
    [Parameter] public bool ShowEvents { get; set; }
    [Parameter] public EventCallback OnShowEventsChanged { get; set; }
    [Parameter] public EventCallback<KubernetesEvent> OnJumpToResource { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public EventCallback OnPanelStateChanged { get; set; }
    [Parameter] public EventCallback<bool> OnIsOpenChanged { get; set; }

    // ── Child refs ──
    private AksYamlViewer _yamlViewer = default!;
    private AksHelmPanel _helmPanel = default!;

    // ── Icon cache — stable references eliminate FluentIcon re-renders on every parent render ──
    private static readonly Icon _iconDismissEvt = new Icons.Regular.Size16.Dismiss();
    private static readonly Icon _iconWarning = new Icons.Regular.Size16.Warning();
    private static readonly Icon _iconCircle = new Icons.Filled.Size12.Circle();
    private static readonly Icon _iconClose = new Icons.Regular.Size16.Dismiss();

    // ── Tab state for multiple panels ──
    private string _activeTab = "logs";
    private List<string> _openTabs = new();

    // ── Event filter ──
    private enum EventTypeFilter { All, Warning, Normal }
    private EventTypeFilter _eventTypeFilter = EventTypeFilter.All;
    private List<KubernetesEvent> _filteredEvents = [];
    private int _warningEventCount;
    private List<KubernetesEvent>? _eventsRef; // reference guard for OnParametersSet

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_eventsRef, Events))
        {
            _eventsRef = Events;
            _warningEventCount = Events.Count(e => e.Type == "Warning");
            RebuildFilteredEvents();
        }
    }

    private void SetEventFilter(EventTypeFilter filter)
    {
        _eventTypeFilter = filter;
        RebuildFilteredEvents();
    }

    private void RebuildFilteredEvents()
    {
        _filteredEvents = _eventTypeFilter switch
        {
            EventTypeFilter.Warning => Events.Where(e => e.Type == "Warning").ToList(),
            EventTypeFilter.Normal => Events.Where(e => e.Type == "Normal").ToList(),
            _ => Events
        };
    }

    private bool ResourceExistsForEvent(KubernetesEvent evt) => evt.InvolvedObjectKind switch
    {
        "Deployment" => Deployments.Any(d => d.Name == evt.InvolvedObjectName),
        "StatefulSet" => StatefulSets.Any(s => s.Name == evt.InvolvedObjectName),
        "Pod" => Pods.Any(p => p.Name == evt.InvolvedObjectName),
        _ => false // Jobs and CronJobs — not currently checked
    };

    // ── Pending-open state (BL-6: @ref inside @if cannot be used until after first render) ──
    private enum HelmPendingAction { History, Values, Rollback }
    private sealed record IngressAnalysisTarget(string Name, string Namespace);
    private sealed record NetworkPolicyAnalysisTarget(string WorkloadKind, string WorkloadName, string Namespace);
    private sealed record NamespaceQuotaTarget(string Namespace);
    private sealed record PodDisruptionBudgetTarget(string Namespace);
    private sealed record ProbeFailureTarget(string WorkloadKind, string WorkloadName, string Namespace);
    private sealed record PlacementTarget(string WorkloadKind, string WorkloadName, string Namespace);
    private sealed record HelmDiffPreviewTarget(string ReleaseName, string Namespace);
    private sealed record HelmRollbackPreviewTarget(string ReleaseName, string Namespace, int Revision);
    private (string Kind, string Name, bool EditMode, string? Namespace)? _pendingYamlOpen;
    private (string ReleaseName, HelmPendingAction Action)? _pendingHelmOpen;

    // ── Internal state ──
    private string? _logPodName;
    private string? _logPodNamespace;
    private string? _logDeploymentName;
    private string? _logDeploymentNamespace;
    private IReadOnlyList<string> _logPodContainers = [];
    private string? _containerDetailPodName;
    private string? _containerDetailNamespace;
    private ConfigMapInfo? _configMapDetailTarget;
    private SecretInfo? _secretDetailTarget;
    private HpaInfo? _hpaDetailTarget;
    private IngressAnalysisTarget? _ingressAnalysisTarget;
    private NetworkPolicyAnalysisTarget? _networkPolicyAnalysisTarget;
    private NamespaceQuotaTarget? _namespaceQuotaTarget;
    private PodDisruptionBudgetTarget? _pdbTarget;
    private ProbeFailureTarget? _probeFailureTarget;
    private PlacementTarget? _placementTarget;
    private HelmDiffPreviewTarget? _helmDiffPreviewTarget;
    private HelmRollbackPreviewTarget? _helmRollbackPreviewTarget;
    private string? _scaleTarget;
    private string? _scaleNamespace;
    private int _scaleReplicas;
    private bool _scaleIsStatefulSet;

    // ── Public state ──
    public bool IsOpen => HasOpenPanel;
    public bool IsYamlOpen => _yamlViewer?.IsOpen == true;
    public bool IsYamlEditing => _yamlViewer?.IsEditing == true;

    private bool HasOpenPanel =>
        _pendingYamlOpen.HasValue ||
        _pendingHelmOpen.HasValue ||
        _logPodName is not null ||
        _logDeploymentName is not null ||
        _yamlViewer?.IsOpen == true ||
        _scaleTarget is not null ||
        _helmPanel?.IsOpen == true ||
        _configMapDetailTarget is not null ||
        _secretDetailTarget is not null ||
        _containerDetailPodName is not null ||
        _hpaDetailTarget is not null ||
        _ingressAnalysisTarget is not null ||
        _networkPolicyAnalysisTarget is not null ||
        _namespaceQuotaTarget is not null ||
        _pdbTarget is not null ||
        _probeFailureTarget is not null ||
        _placementTarget is not null ||
        _helmDiffPreviewTarget is not null ||
        _helmRollbackPreviewTarget is not null ||
        _yamlViewer?.IsEditing == true ||
        ShowEvents;

    // ── Public methods (called by parent via @ref) ──

    // YAML
    // Always go through the pending path so AksDetailPanels re-renders its @if(HasOpenPanel) block.
    // A direct call on _yamlViewer would bypass this component's StateHasChanged and leave the
    // panel collapsed even though the child's _target is set. (BL-6 variant)
    public async Task OpenYamlAsync(string kind, string name, bool editMode = false, string? targetNamespace = null)
    {
        _pendingYamlOpen = (kind, name, editMode, targetNamespace);
        await InvokeAsync(StateHasChanged);
    }

    public void CloseYaml() => _yamlViewer?.Close();

    public void ResetAllPanels()
    {
        _pendingYamlOpen = null;
        _pendingHelmOpen = null;
        _yamlViewer?.Close();
        _helmPanel?.CloseHistory();
        _helmPanel?.CloseValues();
        _scaleTarget = null;
        _scaleNamespace = null;
        _scaleReplicas = 0;
        _scaleIsStatefulSet = false;
        CloseLogs();
        _containerDetailPodName = null;
        _containerDetailNamespace = null;
        _configMapDetailTarget = null;
        _secretDetailTarget = null;
        _hpaDetailTarget = null;
        _ingressAnalysisTarget = null;
        _networkPolicyAnalysisTarget = null;
        _namespaceQuotaTarget = null;
        _pdbTarget = null;
        _probeFailureTarget = null;
        _placementTarget = null;
        _helmDiffPreviewTarget = null;
        _helmRollbackPreviewTarget = null;
        _activeTab = "logs";
        _openTabs.Clear();
        NotifyPanelStateChanged();
    }

