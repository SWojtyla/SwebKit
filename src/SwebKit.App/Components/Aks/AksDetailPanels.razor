    // ── Lifecycle ──

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingYamlOpen.HasValue && _yamlViewer is not null)
        {
            var (kind, name, editMode, targetNamespace) = _pendingYamlOpen.Value;
            _pendingYamlOpen = null;
            await _yamlViewer.OpenAsync(kind, name, targetNamespace, startInEditMode: editMode);

            // PERF/BUG: the child's own StateHasChanged only refreshes its own render tree — it does
            // NOT re-evaluate this parent's @if conditions (e.g. the HPA pane's `_yamlViewer?.IsOpen`
            // check). Without re-rendering here, the previously-open panel (HPA, etc.) stayed visible
            // on screen at the same time as the newly-opened YAML pane ("mixed panes" bug).
            if (string.Equals(kind, "HPA", StringComparison.OrdinalIgnoreCase) && _hpaDetailTarget is not null)
            {
                _activeTab = "yaml";
            }
            UpdateOpenTabs();
            await InvokeAsync(StateHasChanged); // BL-2
        }

        if (_pendingHelmOpen.HasValue && _helmPanel is not null)
        {
            var (releaseName, action) = _pendingHelmOpen.Value;
            _pendingHelmOpen = null;
            await (action switch
            {
                HelmPendingAction.History => _helmPanel.ShowHistoryAsync(releaseName),
                HelmPendingAction.Values => _helmPanel.ShowValuesAsync(releaseName),
                HelmPendingAction.Rollback => _helmPanel.ShowRollbackAsync(releaseName),
                _ => Task.CompletedTask
            });
            await InvokeAsync(StateHasChanged); // BL-2 — same parent re-render fix as above
        }
    }

    // ── Internal handlers ──

    private async Task OnScaleConfirm()
    {
        if (_scaleTarget is null || Client is null) return;
        var name = _scaleTarget;
        var ns = _scaleNamespace ?? Namespace;
        var replicas = _scaleReplicas;
        var isStatefulSet = _scaleIsStatefulSet;
        _scaleTarget = null;
        _scaleNamespace = null;
        StateHasChanged();

        if (IsProduction)
        {
            var confirmed = await Confirm.ShowAsync(
                $"Scale \"{name}\" to {replicas} replicas in production?",
                name,
                requireTypedName: true);
            if (!confirmed) return;
        }

        try
        {
            if (isStatefulSet)
                await Client.ScaleStatefulSetAsync(ns, name, replicas);
            else
                await Client.ScaleDeploymentAsync(ns, name, replicas);
            await OnDataChanged.InvokeAsync();
            Notifications.ShowSuccess("Scaled", $"{name} → {replicas} replica{(replicas == 1 ? "" : "s")}");
        }
        catch (OperationCanceledException) { throw; } // CS-2
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
            Notifications.ShowError("Failed to scale", ex: ex);
        }
        await InvokeAsync(StateHasChanged); // BL-2
        await OnPanelStateChanged.InvokeAsync();
    }

