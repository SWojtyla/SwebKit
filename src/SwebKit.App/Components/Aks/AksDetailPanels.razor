    // Pod logs
    public void ShowPodLogs(string podName, IReadOnlyList<string>? containers = null, string? targetNamespace = null)
    {
        _yamlViewer?.Close();
        _logPodName = podName;
        _logPodNamespace = targetNamespace
            ?? Pods.FirstOrDefault(p => string.Equals(p.Name, podName, StringComparison.Ordinal))?.Namespace
            ?? Namespace;
        _logPodContainers = containers?.Count > 0
            ? [.. containers]
            : [.. Pods.FirstOrDefault(p => string.Equals(p.Name, podName, StringComparison.Ordinal))?.Containers ?? []];

        // Set active tab to logs if both logs and containers are open
        if (_containerDetailPodName is not null)
        {
            _activeTab = "logs";
        }

        UpdateOpenTabs();
        NotifyPanelStateChanged();
    }

