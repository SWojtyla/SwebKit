@implements IDisposable

<div class="secret-panel">
    @if (Secret is null)
    {
        <div class="secret-empty">No secret selected.</div>
    }
    else
    {
        <div class="secret-toolbar">
            <span class="secret-type">Type: @Secret.Type</span>
            <button class="secret-reveal-all" @onclick="ToggleRevealAll">
                @(_revealAll ? "Hide all" : "Reveal all")
            </button>
        </div>

        @if (_loadError is not null)
        {
            <div class="secret-error">@_loadError</div>
        }

        <table class="secret-table">
            <thead>
                <tr>
                    <th>Key</th>
                    <th>Value</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var key in Secret.Keys)
                {
                    var k = key;
                    var isRevealed = _revealedValues.ContainsKey(k);
                    <tr>
                        <td class="secret-key">@k</td>
                        <td class="secret-value">
                            @if (_isFetching && !isRevealed)
                            {
                                <FluentProgressRing Width="12px" />
                            }
                            else if (isRevealed)
                            {
                                <code class="secret-decoded">@_revealedValues[k]</code>
                            }
                            else
                            {
                                <span class="secret-masked">•••••••</span>
                            }
                        </td>
                        <td class="secret-action">
                            <button class="secret-eye-btn" title="@(isRevealed ? "Hide" : "Reveal")"
                                    @onclick="() => ToggleReveal(k)">
                                @(isRevealed ? "🙈" : "👁")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter] public IAksClient? Client { get; set; }
    [Parameter] public string? Namespace { get; set; }
    [Parameter] public SecretInfo? Secret { get; set; }

    private readonly Dictionary<string, string> _revealedValues = [];
    private Dictionary<string, string>? _fetchedAll;
    private bool _isFetching;
    private bool _revealAll;
    private string? _loadError;
    private CancellationTokenSource? _cts;

    protected override void OnParametersSet()
    {
        // Reset when secret changes
        _revealedValues.Clear();
        _fetchedAll = null;
        _revealAll = false;
        _loadError = null;
    }

    private async Task ToggleReveal(string key)
    {
        if (_revealedValues.ContainsKey(key))
        {
            _revealedValues.Remove(key);
            StateHasChanged();
            return;
        }

        await EnsureFetchedAsync();
        if (_fetchedAll is not null && _fetchedAll.TryGetValue(key, out var val))
        {
            _revealedValues[key] = val;
            StateHasChanged();
        }
    }

    private async Task ToggleRevealAll()
    {
        _revealAll = !_revealAll;
        if (_revealAll)
        {
            await EnsureFetchedAsync();
            if (_fetchedAll is not null)
            {
                foreach (var kv in _fetchedAll)
                    _revealedValues[kv.Key] = kv.Value;
            }
        }
        else
        {
            _revealedValues.Clear();
        }
        StateHasChanged();
    }

    private async Task EnsureFetchedAsync()
    {
        if (_fetchedAll is not null || Client is null || Secret is null || Namespace is null) return;

        _isFetching = true;
        _loadError = null;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            _fetchedAll = await Client.GetSecretValuesAsync(Namespace, Secret.Name, _cts.Token);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to fetch secret values: {ex.Message}";
        }
        finally
        {
            _isFetching = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}