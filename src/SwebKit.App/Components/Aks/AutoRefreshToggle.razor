@implements IDisposable

<div class="auto-refresh-toggle">
    <button class="auto-refresh-btn @(IsActive ? "active" : "")" @onclick="Toggle"
            title="@(IsActive ? $"Auto-refresh every {IntervalSeconds}s" : "Auto-refresh off")">
        @if (IsActive)
        {
            <span class="auto-refresh-dot"></span>
        }
        <span>Auto</span>
    </button>
    @if (IsActive)
    {
        <select class="auto-refresh-select" value="@IntervalSeconds" @onchange="OnIntervalChanged">
            <option value="10">10s</option>
            <option value="30">30s</option>
            <option value="60">60s</option>
        </select>
    }
</div>

@code {
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public bool Paused { get; set; }

    private bool IsActive;
    private int IntervalSeconds = 30;
    private System.Threading.Timer? _timer;

    private void Toggle()
    {
        IsActive = !IsActive;
        if (IsActive)
            StartTimer();
        else
            StopTimer();
        StateHasChanged();
    }

    private void OnIntervalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            IntervalSeconds = val;
            if (IsActive)
            {
                StopTimer();
                StartTimer();
            }
        }
    }

    private void StartTimer()
    {
        _timer = new System.Threading.Timer(async _ =>
        {
            if (Paused) return;
            await InvokeAsync(async () =>
            {
                await OnRefresh.InvokeAsync();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(IntervalSeconds), TimeSpan.FromSeconds(IntervalSeconds));
    }

    private void StopTimer()
    {
        _timer?.Dispose();
        _timer = null;
    }

    public void Dispose()
    {
        StopTimer();
    }
}
