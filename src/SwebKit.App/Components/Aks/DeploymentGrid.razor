@* Renders the Deployments FluentDataGrid. All context-menu wiring and HPA interaction
   is surfaced to the parent via EventCallbacks so AksPage keeps all state. *@

<FluentDataGrid Items="@FilteredItems" TGridItem="DeploymentInfo" Virtualize="true" ItemSize="36"
                RowClass="@(d => DeploymentRowClass(d, SelectedDeployment))"
                OnRowClick="@(r => { if (r.Item is not null) OnSelectRow.InvokeAsync(r.Item); })">
    <TemplateColumn Title="Name" SortBy="@(GridSort<DeploymentInfo>.ByAscending(d => d.Name))">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            <span class="aks-resource-name">@context.Name</span>
        </div>
    </TemplateColumn>
    @if (IsMultiNamespace)
    {
        <TemplateColumn Title="Namespace" Width="130px" SortBy="@(GridSort<DeploymentInfo>.ByAscending(d => d.Namespace))">
            <span class="aks-ns-cell" @onclick="() => OnNamespaceClick.InvokeAsync(context.Namespace)">
                @context.Namespace
            </span>
        </TemplateColumn>
    }
    <TemplateColumn Title="Ready" Width="90px" SortBy="@(GridSort<DeploymentInfo>.ByAscending(d => d.ReadyReplicas))">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            <span class="aks-ready-badge @(context.ReadyReplicas == context.Replicas ? "healthy" : "degraded")">
                @context.ReadyReplicas / @context.Replicas
            </span>
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Status" Width="100px" SortBy="@(GridSort<DeploymentInfo>.ByAscending(d => d.Status))">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            <span class="aks-status @(context.Status is "Running" or "Available" ? "running" : "other")">
                @context.Status
            </span>
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Version" Width="130px" SortBy="@(GridSort<DeploymentInfo>.ByAscending(d => d.ImageTag ?? ""))">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            @if (context.ImageTag is not null)
            {
                <span class="aks-image-tag" title="@context.ImageTag">@context.ImageTag</span>
            }
            else
            {
                <span class="aks-text-muted">—</span>
            }
        </div>
    </TemplateColumn>
    <TemplateColumn Title="HPA" Width="110px">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            @{
                var depHpa = Hpas.FirstOrDefault(h => h.TargetName == context.Name && h.TargetKind == "Deployment");
            }
            @if (depHpa is not null)
            {
                <button class="aks-hpa-badge @HpaBadgeClass(depHpa)"
                        title="@(depHpa.IsScalingDisabled ? "Autoscaling disabled" : null)"
                        @onclick="() => OnOpenHpa.InvokeAsync(depHpa)" @onclick:stopPropagation>
                    <span class="hpa-icon">@(depHpa.IsScalingDisabled ? "⏸" : "⇅")</span>
                    <span class="hpa-replicas">@depHpa.CurrentReplicas / @depHpa.MaxReplicas</span>
                    @if (depHpa.CurrentCpuUtilizationPercent.HasValue)
                    {
                        <span class="hpa-cpu">@($"{depHpa.CurrentCpuUtilizationPercent:F0}%")</span>
                    }
                </button>
            }
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Network" Width="110px">
        <div class="aks-row-ctx" @oncontextmenu="e => OnContextMenu.InvokeAsync((e, context))"
             @oncontextmenu:preventDefault>
            <button class="aks-analysis-btn" @onclick="() => OnOpenNetworkAnalysis.InvokeAsync(context)"
                    @onclick:stopPropagation>
                Inspect
            </button>
        </div>
    </TemplateColumn>
</FluentDataGrid>

@code {
    [Parameter]
    public IQueryable<DeploymentInfo> FilteredItems { get; set; } =
Enumerable.Empty<DeploymentInfo>().AsQueryable();
    [Parameter] public List<HpaInfo> Hpas { get; set; } = [];
    [Parameter] public bool IsMultiNamespace { get; set; }
    [Parameter] public DeploymentInfo? SelectedDeployment { get; set; }
    [Parameter] public EventCallback<(MouseEventArgs, DeploymentInfo)> OnContextMenu { get; set; }
    [Parameter] public EventCallback<DeploymentInfo> OnSelectRow { get; set; }
    [Parameter] public EventCallback<HpaInfo> OnOpenHpa { get; set; }
    [Parameter] public EventCallback<DeploymentInfo> OnOpenNetworkAnalysis { get; set; }
    [Parameter] public EventCallback<string> OnNamespaceClick { get; set; }

    private static string HpaBadgeClass(HpaInfo hpa)
    {
        if (hpa.IsScalingDisabled) return "hpa-disabled";
        return hpa.CurrentReplicas == hpa.DesiredReplicas ? "" : "hpa-scaling";
    }

    private static string DeploymentRowClass(DeploymentInfo d, DeploymentInfo? selected)
    {
        var tint = d switch
        {
            { Replicas: > 0, ReadyReplicas: 0 } => "row-critical",
            var x when x.ReadyReplicas < x.Replicas && x.ReadyReplicas > 0 => "row-degraded",
            _ => ""
        };
        var selection = d.Name == selected?.Name ? "selected-row" : "";
        return $"{tint} {selection}".Trim();
    }
}
