@inject IJSRuntime JS

@if (_target is not null)
{
    <div class="aks-panel-pane">
        <div class="aks-section-header">
            <span class="aks-section-title" title="@_target.Value.Kind/@_target.Value.Name">
                @(_editMode ? "Edit" : "") @_target.Value.Kind: @_target.Value.Name
            </span>
            @if (!_loading && _error is null && IsEditable && !_editMode)
            {
                <FluentButton Appearance="Appearance.Stealth" @onclick="OnEditToggle" Title="Edit YAML">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Width="16px" />
                </FluentButton>
            }
            @if (!_loading && _error is null)
            {
                <button class="aks-search-toggle-btn @(_showSearch ? "active" : "")"
                        @onclick="() => { _showSearch = !_showSearch; if (!_showSearch) _ = ClearSearch(); StateHasChanged(); }"
                        title="Search in YAML">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Width="16px" />
                </button>
            }
            @if (_editMode)
            {
                <FluentButton Appearance="Appearance.Accent" Disabled="@_applying" @onclick="OnSave" Title="Apply YAML">
                    @(_applying ? "Saving…" : "Save")
                </FluentButton>
                <FluentButton Appearance="Appearance.Stealth" Disabled="@_applying" @onclick="OnCancelEdit" Title="Cancel edit">
                    Cancel</FluentButton>
                }
                <FluentButton Appearance="Appearance.Stealth" @onclick="Close" Title="Close">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" />
                </FluentButton>
            </div>
            @if (_showSearch)
            {
                <div class="aks-yaml-search-bar">
                    <input type="text" class="aks-yaml-search-input app-native-control" placeholder="Search in YAML…"
                           value="@_search" @oninput="OnSearchInput" autofocus />
                    @if (!string.IsNullOrEmpty(_search))
                    {
                        <span class="aks-yaml-search-count">@_searchCount match@(_searchCount != 1 ? "es" :
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "")</span>
                            <button class="aks-yaml-search-clear" @onclick="ClearSearch" title="Clear">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="14px" />
                            </button>
                        }
                        @if (_editMode && !string.IsNullOrEmpty(_search))
                        {
                            <input type="text" class="aks-yaml-search-input app-native-control" placeholder="Replace with…" @bind="_replace"
                                   @bind:event="oninput" />
                            <button class="aks-yaml-replace-btn" @onclick="OnReplaceAll" title="Replace all">Replace
                                all</button>
                            }
                        </div>
                    }
                    @if (_validationError is not null)
                    {
                        <div class="aks-yaml-validation-error">⚠ @_validationError</div>
                    }
                    @if (_validationWarning is not null && _validationError is null)
                    {
                        <div class="aks-yaml-validation-warning">
                            <span>⚠ @_validationWarning</span>
                            <div class="aks-yaml-warning-actions">
                                <FluentButton Appearance="Appearance.Accent" Disabled="@_applying" @onclick="ApplyAnyway">Apply anyway
                                </FluentButton>
                                <FluentButton Appearance="Appearance.Stealth"
                                              @onclick="() => { _validationWarning = null; _bypassValidation = false; StateHasChanged(); }">Fix first
                                </FluentButton>
                            </div>
                        </div>
                    }
                    <div class="aks-yaml-content">
                        @if (_loading)
                        {
                            <LoadingSpinner Message="Loading YAML…" />
                        }
                        else if (_error is not null)
                        {
                            <div class="aks-yaml-error">@_error</div>
                        }
                        else if (_editMode)
                        {
                            <div class="aks-yaml-edit-wrap" @key="_editKey">
                                <pre class="aks-yaml-pre aks-yaml-edit-bg" @ref="_editPre"></pre>
                                <textarea class="aks-yaml-edit" spellcheck="false" @ref="_editTextarea"></textarea>
                            </div>
                        }
                        else
                        {
                            <pre class="aks-yaml-pre" @ref="_yamlViewPre">@_highlighted</pre>
                        }
                    </div>
                </div>
            }

@code {
    [Parameter] public IAksClient? Client { get; set; }
    [Parameter] public string Namespace { get; set; } = "default";
    [Parameter] public bool IsProduction { get; set; }
    [Parameter] public AksConfirmBar Confirm { get; set; } = default!;
    [Parameter] public INotificationService Notifications { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    [Parameter] public EventCallback OnYamlApplied { get; set; }

    // YAML viewer/editor state
    private (string Kind, string Name)? _target;
    private string? _text;
    private string? _error;
    private bool _loading;
    private bool _editMode;
    private string _editText = string.Empty;
    private bool _applying;
    private string? _targetNamespace;

    // Highlighted markup for YAML panels
    private MarkupString _highlighted;

    // Edit overlay refs & lifecycle flags
    private ElementReference _editTextarea;
    private ElementReference _editPre;
    private ElementReference _yamlViewPre;
    private bool _initEditOverlay;
    private int _editKey;

    // YAML search state
    private string _search = string.Empty;
    private int _searchCount;
    private bool _showSearch;
    private string _replace = string.Empty;
    private string? _validationError;
    private string? _validationWarning;
    private bool _bypassValidation;

    /// <summary>Whether the YAML panel is currently showing.</summary>
    public bool IsOpen => _target is not null;

    /// <summary>The resource kind currently displayed, if any (e.g. "HPA", "Deployment").</summary>
    public string? TargetKind => _target?.Kind;

    /// <summary>Whether the YAML panel is in edit mode.</summary>
    public bool IsEditing => _editMode;

    private static readonly HashSet<string> EditableKinds = new(StringComparer.OrdinalIgnoreCase)
    {
        "Deployment",
        "Ingress",
        "StatefulSet",
        "ConfigMap",
        "Secret",
        "HPA",
        "HorizontalPodAutoscaler"
    };

    // Only these resource types are editable
    private bool IsEditable => _target is not null && EditableKinds.Contains(_target.Value.Kind);

    /// <summary>Opens the YAML viewer for the given resource, optionally starting in edit mode.</summary>
    public async Task OpenAsync(string kind, string name, string? targetNamespace = null, bool startInEditMode = false)
    {
        _target = (kind, name);
        _targetNamespace = targetNamespace;
        _text = null;
        _error = null;
        _loading = true;
        _editMode = false;
        _editText = string.Empty;
        _applying = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var resourceNamespace = _targetNamespace ?? Namespace;
            _text = await Client!.GetResourceYamlAsync(resourceNamespace, kind, name);
            _highlighted = await HighlightAsync(_text);
            if (startInEditMode && IsEditable)
            {
                _editMode = true;
                _editText = _text ?? string.Empty;
                _editKey++;
                _initEditOverlay = true;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Closes the YAML panel and resets all state.</summary>
    public void Close()
    {
        _target = null;
        _targetNamespace = null;
        _text = null;
        _error = null;
        _editMode = false;
        _editText = string.Empty;
        _applying = false;
        _search = string.Empty;
        _searchCount = 0;
        _showSearch = false;
        _replace = string.Empty;
        _validationError = null;
        _validationWarning = null;
        _bypassValidation = false;
        StateHasChanged();
        _ = OnClose.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_initEditOverlay)
        {
            _initEditOverlay = false;
            await JS.InvokeVoidAsync("yamlHighlight.initEditor", _editTextarea, _editPre, _editText);
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        if (_editMode)
        {
            var currentText = await JS.InvokeAsync<string>("yamlHighlight.getEditorValue", _editTextarea);
            _searchCount = string.IsNullOrEmpty(_search) ? 0
                : CountOccurrences(currentText, _search);
            StateHasChanged();
            return;
        }
        if (_yamlViewPre.Id is null) { StateHasChanged(); return; }
        _searchCount = await JS.InvokeAsync<int>("yamlHighlight.searchInPre", _yamlViewPre, _search);
        StateHasChanged();
    }

    private async Task ClearSearch()
    {
        _search = string.Empty;
        _searchCount = 0;
        if (_yamlViewPre.Id is not null)
            await JS.InvokeVoidAsync("yamlHighlight.clearSearch", _yamlViewPre);
        StateHasChanged();
    }

    private async Task OnEditToggle()
    {
        _editMode = true;
        _editText = _text ?? string.Empty;
        _editKey++;
        _initEditOverlay = true;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void OnCancelEdit()
    {
        _editMode = false;
        _editText = string.Empty;
        _validationError = null;
        _validationWarning = null;
        _bypassValidation = false;
        _replace = string.Empty;
        StateHasChanged();
    }

    private async Task OnSave()
    {
        if (_target is null || Client is null) return;

        // JS owns the textarea value — read it back before validating or applying.
        _editText = await JS.InvokeAsync<string>("yamlHighlight.getEditorValue", _editTextarea);

        _validationError = ValidateYaml(_editText);
        if (_validationError is not null) { _validationWarning = null; _bypassValidation = false; StateHasChanged(); return; }

        _validationWarning = _bypassValidation ? null : CheckYamlStructure(_editText);
        if (_validationWarning is not null && !_bypassValidation) { StateHasChanged(); return; }

        _bypassValidation = false;
        _applying = true;
        StateHasChanged();

        try
        {
            if (IsProduction)
            {
                var confirmed = await Confirm.ShowAsync(
                $"Apply YAML changes to {_target.Value.Kind} \"{_target.Value.Name}\" in production?",
                _target.Value.Name,
                requireTypedName: true);
                if (!confirmed) { _applying = false; StateHasChanged(); return; }
            }

            var resourceNamespace = _targetNamespace ?? Namespace;
            await Client.ApplyResourceYamlAsync(resourceNamespace, _target.Value.Kind, _target.Value.Name, _editText);
            _text = _editText;
            _highlighted = await HighlightAsync(_text);
            _editMode = false;
            _editText = string.Empty;
            StateHasChanged();
            Notifications.ShowSuccess("YAML applied", $"{_target.Value.Kind} {_target.Value.Name}");
            await OnYamlApplied.InvokeAsync();
        }
        catch (OperationCanceledException) { throw; } // CS-2
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
            Notifications.ShowError("Failed to apply YAML", ex: ex);
        }
        finally { _applying = false; await InvokeAsync(StateHasChanged); } // BL-2
    }

    private async Task OnReplaceAll()
    {
        if (string.IsNullOrEmpty(_search) || !_editMode) return;
        // Read the live value from JS before replacing.
        _editText = await JS.InvokeAsync<string>("yamlHighlight.getEditorValue", _editTextarea);
        _editText = _editText.Replace(_search, _replace, StringComparison.Ordinal);
        _validationError = null;
        _validationWarning = null;
        _bypassValidation = false;
        // Push the new value back to the textarea and highlight pre via JS — no Blazor re-key needed.
        await JS.InvokeVoidAsync("yamlHighlight.setEditorValue", _editTextarea, _editPre, _editText);
        _searchCount = CountOccurrences(_editText, _search);
        await InvokeAsync(StateHasChanged); // BL-2
    }

    private async Task<MarkupString> HighlightAsync(string? text)
    {
        if (string.IsNullOrEmpty(text)) return default;
        // Normalize line endings and strip blank lines before passing to the highlighter
        var clean = string.Join('\n', text.ReplaceLineEndings("\n")
        .Split('\n')
        .Where(static l => !string.IsNullOrWhiteSpace(l)));
        var html = await JS.InvokeAsync<string>("yamlHighlight.highlight", clean);
        return (MarkupString)html;
    }

    private static string? ValidateYaml(string yaml)
    {
        try
        {
            var deserializer = new YamlDotNet.Serialization.DeserializerBuilder().Build();
            deserializer.Deserialize<object>(yaml);
            return null;
        }
        catch (YamlDotNet.Core.YamlException ex)
        {
            return $"YAML parse error at line {ex.Start.Line}: {ex.Message}";
        }
    }

    private static string? CheckYamlStructure(string yaml)
    {
        try
        {
            var deserializer = new YamlDotNet.Serialization.DeserializerBuilder().Build();
            var obj = deserializer.Deserialize<Dictionary<object, object>>(yaml);
            if (obj is null) return null;

            var missing = new List<string>();
            if (!obj.ContainsKey("apiVersion")) missing.Add("apiVersion");
            if (!obj.ContainsKey("kind")) missing.Add("kind");
            if (!obj.TryGetValue("metadata", out var meta) ||
                meta is not Dictionary<object, object> metaDict ||
                !metaDict.ContainsKey("name"))
                missing.Add("metadata.name");

            return missing.Count == 0 ? null : $"Missing required fields: {string.Join(", ", missing)}";
        }
        catch
        {
            return null; // Parsing already handled by ValidateYaml
        }
    }

    private async Task ApplyAnyway()
    {
        _bypassValidation = true;
        _validationWarning = null;
        await OnSave();
    }

    private static int CountOccurrences(string text, string search)
    {
        if (string.IsNullOrEmpty(text) || string.IsNullOrEmpty(search)) return 0;
        int count = 0, idx = 0;
        while ((idx = text.IndexOf(search, idx, StringComparison.Ordinal)) >= 0)
        {
            count++;
            idx += search.Length;
        }
        return count;
    }
}
