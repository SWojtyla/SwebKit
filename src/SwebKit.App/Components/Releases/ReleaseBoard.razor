@inject ReleaseRepository ReleaseRepo

<div>
    @if (Release is null)
    {
        <div style="color:var(--color-text-muted); font-size:13px; padding:20px 0;">
            No release selected. Click <strong>New Release</strong> to create one, or select an existing release.
        </div>
    }
    else if (IsLoading)
    {
        <LoadingSpinner Message="Loading deployment status from ADO..." />
    }
    else if (ErrorMessage is not null)
    {
        <ErrorCallout Message="@ErrorMessage" OnRetry="LoadBoardAsync" />
    }
    else
    {
        @* ── Release header ── *@
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
            <h3 style="margin:0; font-size:16px;">@Release.Name</h3>
            <span class="status-badge @Release.Status.ToString().ToLower()">@Release.Status</span>
            @if (Release.SprintNumber.HasValue)
            {
                <span style="font-size:12px; color:var(--color-text-muted);">Sprint @Release.SprintNumber</span>
            }
            @if (Release.Label is not null)
            {
                <span style="font-size:12px; color:var(--color-text-muted);">@Release.Label</span>
            }

            <div style="margin-left:auto;">
                <ReadinessGate Components="@ScopedComponents" BoardData="@BoardData" />
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Release.Notes))
        {
            <div
                style="font-size:12px; color:var(--color-text-muted); margin-bottom:12px; padding:8px; background:var(--color-surface); border-radius:4px;">
                @Release.Notes
            </div>
        }

        @if (ScopedComponents.Count == 0)
        {
            <div style="color:var(--color-text-muted); font-size:13px; padding:20px 0;">
                No components in scope. Click <strong>Edit Components</strong> to add repos and pipelines to this release.
            </div>
        }
        else
        {
            @* ── Component x Environment matrix ── *@
            <div style="overflow-x:auto;">
                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                    <thead>
                        <tr style="border-bottom:2px solid var(--color-border);">
                            <th style="text-align:left; padding:8px; min-width:180px;">Component</th>
                            <th style="text-align:center; padding:8px; min-width:80px;">Tag</th>
                            @foreach (var env in DiscoveredEnvironments)
                            {
                                <th style="text-align:center; padding:8px; min-width:100px;">@env</th>
                            }
                            <th style="text-align:center; padding:8px; min-width:80px;">Ready</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comp in ScopedComponents)
                        {
                            var compData = BoardData.GetValueOrDefault(comp.ComponentName);
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:8px;">
                                    <div style="font-family:Consolas,monospace;">@comp.ComponentName</div>
                                    @{
                                        var runName = RunNames.GetValueOrDefault(comp.ComponentName);
                                    }
                                    @if (runName is not null)
                                    {
                                        <div style="font-size:10px; color:var(--color-accent); font-family:Consolas,monospace;">
                                            #@runName</div>
                                        }
                                    </td>
                                    <td style="padding:8px; text-align:center;">
                                        @if (comp.TagConfirmed)
                                        {
                                            <span style="color:var(--color-success);" title="Tag confirmed">@comp.TargetTag</span>
                                        }
                                        else if (!string.IsNullOrEmpty(comp.TargetTag))
                                        {
                                            <span style="color:var(--color-text-muted);">@comp.TargetTag</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--color-text-muted);">—</span>
                                        }
                                    </td>
                                    @foreach (var env in DiscoveredEnvironments)
                                    {
                                        var cell = compData?.GetValueOrDefault(env);
                                        <td style="padding:8px; text-align:center;">
                                            @if (cell is not null)
                                            {
                                                <a href="@cell.WebUrl" target="_blank" title="@cell.State / @cell.Result"
                                                       style="text-decoration:none;">
                                                    <span class="pipeline-status @cell.CssClass">@cell.DisplayText</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <span style="color:var(--color-text-muted);">—</span>
                                            }
                                        </td>
                                    }
                                    <td style="padding:8px; text-align:center;">
                                        @{
                                            var readiness = ComputeReadiness(comp, compData);
                                        }
                                        <span title="@readiness.Tooltip" style="display:inline-flex; align-items:center;">
                                            <FluentIcon Value="@readiness.Icon" Width="14px" />
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>

    <style>
        .status-badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-badge.draft {
            background: rgba(128, 128, 128, 0.2);
            color: var(--color-text-muted);
        }

        .status-badge.inprogress {
            background: rgba(0, 120, 212, 0.2);
            color: var(--color-accent);
        }

        .status-badge.completed {
            background: rgba(67, 160, 71, 0.2);
            color: var(--color-success);
        }

        .pipeline-status {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 500;
        }

        .pipeline-status.succeeded {
            background: rgba(67, 160, 71, 0.2);
            color: var(--color-success);
        }

        .pipeline-status.failed {
            background: rgba(200, 0, 42, 0.2);
            color: var(--color-error);
        }

        .pipeline-status.running {
            background: rgba(0, 120, 212, 0.2);
            color: var(--color-accent);
        }

        .pipeline-status.notdeployed {
            color: var(--color-text-muted);
        }

        .pipeline-status.waiting {
            background: rgba(255, 152, 0, 0.2);
            color: #FF9800;
        }
    </style>

@code {
    [Parameter] public ReleaseRecord? Release { get; set; }
    [CascadingParameter(Name = "DevOpsClient")] public IDevOpsClient DevOpsClient { get; set; } = default!;

    private bool IsLoading;
    private string? ErrorMessage;
    private List<string> DiscoveredEnvironments = [];
    private List<ComponentScope> ScopedComponents => Release?.Components.Where(c => c.InScope).ToList() ?? [];

    // ComponentName -> EnvironmentName -> CellData
    public Dictionary<string, Dictionary<string, CellData>> BoardData = new();
    // ComponentName -> build number / run name (e.g. "1.2.1_1")
    private Dictionary<string, string> RunNames = new();

    public record CellData(string State, string Result, string DisplayText, string CssClass, string? WebUrl);

    protected override async Task OnParametersSetAsync()
    {
        if (Release is not null && ScopedComponents.Count > 0)
            await LoadBoardAsync();
    }

    public async Task LoadBoardAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        BoardData.Clear();
        RunNames.Clear();
        DiscoveredEnvironments = [];

        try
        {
            // Discover environments across all projects used by components
            var projectNames = ScopedComponents.Select(c => c.ProjectName).Distinct().ToList();
            var allEnvs = new HashSet<string>();
            foreach (var proj in projectNames)
            {
                try
                {
                    var envs = await DevOpsClient.GetEnvironmentsAsync(proj);
                    foreach (var env in envs)
                        allEnvs.Add(env.Name);
                }
                catch { /* Some projects may not have environments */ }
            }
            DiscoveredEnvironments = allEnvs.ToList();

            // Load pipeline runs per component
            foreach (var comp in ScopedComponents)
            {
                if (comp.PipelineId == 0) continue;

                try
                {
                    var runs = await DevOpsClient.GetPipelineRunsAsync(comp.ProjectName, comp.PipelineId, top: 5);
                    var latestRun = runs.FirstOrDefault();
                    if (latestRun is null) continue;

                    // Get stage details if not already populated
                    if (latestRun.Stages.Count == 0)
                    {
                        try
                        {
                            latestRun = await DevOpsClient.GetPipelineRunAsync(comp.ProjectName, comp.PipelineId, latestRun.Id);
                        }
                        catch { /* Use run without stages */ }
                    }

                    // Detect stages waiting for approval
                    var waitingStageNames = new HashSet<string>();
                    if (latestRun.State != "completed")
                    {
                        try
                        {
                            var waiting = await DevOpsClient.GetWaitingStagesAsync(comp.ProjectName, latestRun.Id);
                            foreach (var w in waiting)
                                waitingStageNames.Add(w.StageName);
                        }
                        catch { }
                    }

                    // Store the build number / run name
                    if (!string.IsNullOrEmpty(latestRun.Name))
                        RunNames[comp.ComponentName] = latestRun.Name;

                    var envMap = new Dictionary<string, CellData>();
                    foreach (var stage in latestRun.Stages)
                    {
                        var envName = ResolveEnvironmentName(stage, DiscoveredEnvironments);
                        if (envName is null) continue; // Skip non-deployment stages (e.g. "Setup")
                        var isWaiting = waitingStageNames.Contains(stage.Name);

                        var (display, css) = (stage.State, isWaiting) switch
                        {
                            (_, true) => ("Awaiting Approval", "waiting"),
                            ("completed", _) when stage.Result == "succeeded" => ("Deployed", "succeeded"),
                            ("completed", _) when stage.Result == "failed" => ("Failed", "failed"),
                            ("inProgress", _) => ("Running", "running"),
                            _ => ("Pending", "notdeployed")
                        };
                        envMap[envName] = new CellData(stage.State, stage.Result, display, css, latestRun.WebUrl);
                    }
                    BoardData[comp.ComponentName] = envMap;
                }
                catch { /* Skip failed components */ }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    /// <summary>
    /// Matches a pipeline stage to a discovered environment name.
    /// Handles common naming patterns: "Deploy: dev-weu", "Deploy to DEV", "deploy_dev_weu", etc.
    /// Returns null for non-deployment stages (e.g. "Setup", "Build").
    /// </summary>
    private static string? ResolveEnvironmentName(AdoPipelineStage stage, List<string> environments)
    {
        // 1. Direct match on EnvironmentName (identifier from timeline)
        if (stage.EnvironmentName is not null)
        {
            var direct = environments.FirstOrDefault(e =>
            string.Equals(e, stage.EnvironmentName, StringComparison.OrdinalIgnoreCase));
            if (direct is not null) return direct;
        }

        // 2. Check if any environment name is contained in the stage name
        // e.g. stage "Deploy: dev-weu" contains environment "dev-weu"
        var byContains = environments.FirstOrDefault(e =>
        stage.Name.Contains(e, StringComparison.OrdinalIgnoreCase));
        if (byContains is not null) return byContains;

        // 3. Check with underscores replaced (timeline identifiers use underscores)
        // e.g. identifier "Deploy_dev_weu" should match "dev-weu"
        if (stage.EnvironmentName is not null)
        {
            var normalized = stage.EnvironmentName.Replace('_', '-');
            var byNormalized = environments.FirstOrDefault(e =>
            string.Equals(e, normalized, StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains(e, StringComparison.OrdinalIgnoreCase));
            if (byNormalized is not null) return byNormalized;
        }

        // No match — likely a non-deployment stage (Setup, Build, Test, etc.)
        return null;
    }

    private (Icon Icon, string Tooltip) ComputeReadiness(ComponentScope comp, Dictionary<string, CellData>? envData)
    {
        if (envData is null)
            return (new Icons.Regular.Size16.CircleOff(), "No deployment data");

        var hasFailed = envData.Values.Any(c => c.CssClass == "failed");
        if (hasFailed)
            return (new Icons.Filled.Size16.DismissCircle(), "Pipeline has failed stages");

        var hasWaiting = envData.Values.Any(c => c.CssClass == "waiting");
        if (hasWaiting)
            return (new Icons.Regular.Size16.LockClosed(), "Waiting for approval");

        var hasRunning = envData.Values.Any(c => c.CssClass == "running");
        if (hasRunning)
            return (new Icons.Regular.Size16.Clock(), "Pipeline is running");

        if (!comp.TagConfirmed)
            return (new Icons.Regular.Size16.Warning(), "Tag not yet confirmed");

        var allSucceeded = envData.Values.All(c => c.CssClass is "succeeded" or "notdeployed");
        if (allSucceeded && comp.TagConfirmed)
            return (new Icons.Filled.Size16.CheckmarkCircle(), "Ready for release");

        return (new Icons.Regular.Size16.CircleOff(), "Unknown state");
    }
}