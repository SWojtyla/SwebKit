@inject ReleaseRepository ReleaseRepo

@if (Visible && Release is not null)
{
    <div
        style="position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:500; display:flex; align-items:center; justify-content:center;">
        <div
            style="background:var(--color-surface-2); border:1px solid var(--color-border); border-radius:8px; max-width:700px; width:95%; max-height:80vh; display:flex; flex-direction:column;">

            @* ── Sticky header ── *@
            <div style="padding:20px 24px 12px; border-bottom:1px solid var(--color-border); flex-shrink:0;">
                <h3 style="margin:0; font-size:15px;">Components — @Release.Name</h3>
                <p style="margin:6px 0 0; font-size:12px; color:var(--color-text-muted);">Select pipelines to include in
                    this release.</p>
                </div>

                @* ── Scrollable content ── *@
                <div style="overflow-y:auto; padding:16px 24px; flex:1;">
                    @if (IsLoading)
                    {
                        <LoadingSpinner Message="Loading pipelines from ADO..." />
                    }
                    else
                    {
                        @foreach (var project in ProjectData)
                        {
                            <div style="margin-bottom:16px;">
                                <div style="font-size:13px; font-weight:600; margin-bottom:8px; color:var(--color-text);">@project.Name
                                </div>

                                @foreach (var pipeline in project.Pipelines)
                                {
                                    var existing = Release.Components.FirstOrDefault(c =>
                                        c.PipelineId == pipeline.Id && c.ProjectName == project.Name);
                                    var isChecked = existing?.InScope ?? false;
                                    var matchingRepo = project.Repos.FirstOrDefault(r =>
                                        pipeline.Name.Contains(r.Name, StringComparison.OrdinalIgnoreCase));

                                    <div
                                        style="border:1px solid var(--color-border); border-radius:4px; margin-bottom:4px; background:@(isChecked ? "var(--color-surface)" : "transparent"); overflow:hidden;">
                                        @* ── Main row: checkbox / name / ID / tag ── *@
                                        <div style="display:flex; align-items:center; gap:8px; padding:8px 10px;">
                                            <input type="checkbox" checked="@isChecked"
                                                   @onchange="@(e => ToggleComponent(project.Name, pipeline, matchingRepo, (bool)(e.Value ?? false)))" />

                                            <div style="flex:1; min-width:0;">
                                                <div
                                                    style="font-size:12px; font-family:Consolas,monospace; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                                    @pipeline.Name</div>
                                                    @if (!string.IsNullOrEmpty(pipeline.Folder) && pipeline.Folder != "\\")
                                                    {
                                                        <div style="font-size:10px; color:var(--color-text-muted);">@pipeline.Folder</div>
                                                    }
                                                </div>

                                                <span style="font-size:11px; color:var(--color-text-muted); white-space:nowrap;">ID:
                                                    @pipeline.Id</span>

                                                    @if (isChecked && existing is not null)
                                                    {
                                                        <input type="text" value="@existing.TargetTag"
                                                               @onchange="@(e => { existing.TargetTag = e.Value?.ToString(); })" placeholder="v1.5.0"
                                                               style="width:80px; padding:2px 6px; font-size:11px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:3px;" />
                                                    }
                                                </div>

                                                @* ── Runtime binding row (only when in scope) ── *@
                                                @if (isChecked && existing is not null)
                                                {
                                                    existing.RuntimeBinding ??= new();
                                                    <div
                                                        style="display:flex; align-items:center; gap:6px; padding:6px 10px 8px 34px; border-top:1px solid var(--color-border); background:var(--color-surface-2);">
                                                        <span
                                                        style="font-size:10px; color:var(--color-text-muted); white-space:nowrap; margin-right:2px;">Runtime:</span>
                                                        <input type="text" value="@existing.RuntimeBinding.Namespace"
                                                               @onchange="@(e => { existing.RuntimeBinding.Namespace = e.Value?.ToString(); })"
                                                               placeholder="namespace" title="Kubernetes namespace"
                                                               style="width:100px; padding:2px 6px; font-size:11px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:3px;" />
                                                        <span style="font-size:10px; color:var(--color-text-muted);">/</span>
                                                        <input type="text" value="@existing.RuntimeBinding.WorkloadName"
                                                               @onchange="@(e => { existing.RuntimeBinding.WorkloadName = e.Value?.ToString(); })"
                                                               placeholder="workload-name" title="Deployment or StatefulSet name"
                                                               style="width:130px; padding:2px 6px; font-size:11px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:3px;" />
                                                        <input type="text" value="@existing.RuntimeBinding.ContainerName"
                                                               @onchange="@(e => { existing.RuntimeBinding.ContainerName = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString(); })"
                                                               placeholder="container (auto)"
                                                               title="Container name — leave blank to use the first container"
                                                               style="width:120px; padding:2px 6px; font-size:11px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:3px;" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>

                        @* ── Sticky footer ── *@
                        <div
                            style="padding:12px 24px; border-top:1px solid var(--color-border); display:flex; gap:8px; justify-content:flex-end; flex-shrink:0;">
                            <button @onclick="Close" style="padding:6px 16px; cursor:pointer;">Cancel</button>
                            <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync">Save</FluentButton>
                        </div>
                    </div>
                </div>
            }

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public ReleaseRecord? Release { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [CascadingParameter(Name = "DevOpsClient")] public IDevOpsClient DevOpsClient { get; set; } = default!;

    private bool IsLoading;
    private List<ProjectPipelineData> ProjectData = [];

    private record ProjectPipelineData(string Name, List<AdoPipeline> Pipelines, List<AdoRepository> Repos);

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && ProjectData.Count == 0)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        try
        {
            var projects = await DevOpsClient.GetProjectsAsync();
            ProjectData = [];

            foreach (var project in projects)
            {
                var pipelines = await DevOpsClient.GetPipelinesAsync(project.Name);
                var repos = await DevOpsClient.GetRepositoriesAsync(project.Name);
                ProjectData.Add(new ProjectPipelineData(project.Name, pipelines, repos));
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ToggleComponent(string projectName, AdoPipeline pipeline, AdoRepository? repo, bool inScope)
    {
        if (Release is null) return;

        var existing = Release.Components.FirstOrDefault(c =>
            c.PipelineId == pipeline.Id && c.ProjectName == projectName);

        if (inScope)
        {
            if (existing is null)
            {
                Release.Components.Add(new ComponentScope
                {
                    ComponentName = pipeline.Name,
                    ProjectName = projectName,
                    RepositoryId = repo?.Id ?? "",
                    PipelineId = pipeline.Id,
                    InScope = true
                });
            }
            else
            {
                existing.InScope = true;
            }
        }
        else if (existing is not null)
        {
            existing.InScope = false;
            // Clear runtime binding when removed so stale data is not persisted.
            existing.RuntimeBinding = null;
        }
    }

    private async Task SaveAsync()
    {
        if (Release is null) return;
        // Remove unchecked components entirely to keep the list clean.
        Release.Components.RemoveAll(c => !c.InScope);
        // Normalize empty runtime bindings so they are not persisted as empty objects.
        foreach (var comp in Release.Components)
        {
            if (comp.RuntimeBinding is { } rb
                && string.IsNullOrWhiteSpace(rb.Namespace)
                && string.IsNullOrWhiteSpace(rb.WorkloadName))
            {
                comp.RuntimeBinding = null;
            }
        }
        await ReleaseRepo.UpdateReleaseAsync(Release);
        await OnSaved.InvokeAsync();
    }

    private Task Close() => OnClose.InvokeAsync();
}
