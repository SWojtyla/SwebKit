@inject ReleaseRepository ReleaseRepo

@if (Visible)
{
    <div class="release-editor__dialog-backdrop">
        <div class="release-editor__dialog" role="dialog" aria-modal="true" aria-labelledby="release-editor-title">
            <h3 id="release-editor-title" class="release-editor__title">@(IsEdit ? "Edit Release" : "New Release")</h3>

            <div class="release-editor__form">
                <div class="release-editor__field">
                    <label class="form-label" for="release-editor-name">Release Name</label>
                    <input id="release-editor-name" class="form-input release-editor__input" type="text" @bind="Name"
                           @bind:event="oninput" placeholder="e.g. Sprint 42 Release" />
                </div>

                <div class="release-editor__row">
                    <div class="release-editor__field release-editor__field--grow">
                        <label class="form-label" for="release-editor-sprint">Sprint Number (optional)</label>
                        <input id="release-editor-sprint" class="form-input release-editor__input" type="number"
                               @bind="SprintNumber" />
                    </div>
                    <div class="release-editor__field release-editor__field--grow">
                        <label class="form-label" for="release-editor-label">Label (optional)</label>
                        <input id="release-editor-label" class="form-input release-editor__input" type="text" @bind="Label"
                               @bind:event="oninput" placeholder="e.g. Hotfix 3.2.1" />
                    </div>
                </div>

                <div class="release-editor__field">
                    <label class="form-label" for="release-editor-notes">Notes</label>
                    <textarea id="release-editor-notes" class="form-input release-editor__input release-editor__textarea"
                              @bind="Notes" @bind:event="oninput" rows="3"
                              placeholder="Release notes or description..."></textarea>
                </div>

                @if (IsEdit)
                {
                    <div class="release-editor__field">
                        <label class="form-label" for="release-editor-status">Status</label>
                        <select id="release-editor-status" class="form-input release-editor__input" @bind="SelectedStatus">
                            <option value="Draft">Draft</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                }
            </div>

            <div class="release-editor__actions">
                <button type="button" class="release-editor__cancel" @onclick="Cancel">Cancel</button>
                <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync"
                              Disabled="@(string.IsNullOrWhiteSpace(Name))">
                    @(IsEdit ? "Save" : "Create")
                </FluentButton>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public ReleaseRecord? Release { get; set; }
    [Parameter] public EventCallback<ReleaseRecord> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string Name = string.Empty;
    private int? SprintNumber;
    private string? Label;
    private string? Notes;
    private string SelectedStatus = "Draft";
    private bool IsEdit => Release is not null;

    protected override void OnParametersSet()
    {
        if (Release is not null)
        {
            Name = Release.Name;
            SprintNumber = Release.SprintNumber;
            Label = Release.Label;
            Notes = Release.Notes;
            SelectedStatus = Release.Status.ToString();
        }
        else if (Visible)
        {
            Name = string.Empty;
            SprintNumber = null;
            Label = null;
            Notes = null;
            SelectedStatus = "Draft";
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Name)) return;

        ReleaseRecord record;
        if (Release is not null)
        {
            Release.Name = Name.Trim();
            Release.SprintNumber = SprintNumber;
            Release.Label = string.IsNullOrWhiteSpace(Label) ? null : Label.Trim();
            Release.Notes = string.IsNullOrWhiteSpace(Notes) ? null : Notes.Trim();
            Release.Status = Enum.Parse<ReleaseStatus>(SelectedStatus);
            await ReleaseRepo.UpdateReleaseAsync(Release);
            record = Release;
        }
        else
        {
            record = new ReleaseRecord
            {
                Name = Name.Trim(),
                SprintNumber = SprintNumber,
                Label = string.IsNullOrWhiteSpace(Label) ? null : Label.Trim(),
                Notes = string.IsNullOrWhiteSpace(Notes) ? null : Notes.Trim()
            };
            await ReleaseRepo.AddReleaseAsync(record);
        }

        await OnSaved.InvokeAsync(record);
    }

    private Task Cancel() => OnCancel.InvokeAsync();
}
