@inject ReleaseRepository ReleaseRepo

@if (Visible)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:500; display:flex; align-items:center; justify-content:center;">
        <div style="background:var(--color-surface-2); border:1px solid var(--color-border); border-radius:8px; padding:24px; max-width:500px; width:90%;">
            <h3 style="margin:0 0 16px; font-size:15px;">@(IsEdit ? "Edit Release" : "New Release")</h3>

            <div style="display:grid; gap:12px;">
                <div style="display:grid; gap:4px;">
                    <label style="font-size:12px; color:var(--color-text-muted);">Release Name</label>
                    <input type="text" @bind="Name" @bind:event="oninput"
                           style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px;"
                           placeholder="e.g. Sprint 42 Release" />
                </div>

                <div style="display:flex; gap:12px;">
                    <div style="display:grid; gap:4px; flex:1;">
                        <label style="font-size:12px; color:var(--color-text-muted);">Sprint Number (optional)</label>
                        <input type="number" @bind="SprintNumber"
                               style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px;" />
                    </div>
                    <div style="display:grid; gap:4px; flex:1;">
                        <label style="font-size:12px; color:var(--color-text-muted);">Label (optional)</label>
                        <input type="text" @bind="Label" @bind:event="oninput"
                               style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px;"
                               placeholder="e.g. Hotfix 3.2.1" />
                    </div>
                </div>

                <div style="display:grid; gap:4px;">
                    <label style="font-size:12px; color:var(--color-text-muted);">Notes</label>
                    <textarea @bind="Notes" @bind:event="oninput" rows="3"
                              style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px; resize:vertical;"
                              placeholder="Release notes or description..."></textarea>
                </div>

                @if (IsEdit)
                {
                    <div style="display:grid; gap:4px;">
                        <label style="font-size:12px; color:var(--color-text-muted);">Status</label>
                        <select @bind="SelectedStatus"
                                style="padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px;">
                            <option value="Draft">Draft</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                }
            </div>

            <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:16px;">
                <button @onclick="Cancel" style="padding:6px 16px; cursor:pointer;">Cancel</button>
                <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync" Disabled="@(string.IsNullOrWhiteSpace(Name))">
                    @(IsEdit ? "Save" : "Create")
                </FluentButton>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public ReleaseRecord? Release { get; set; }
    [Parameter] public EventCallback<ReleaseRecord> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string Name = string.Empty;
    private int? SprintNumber;
    private string? Label;
    private string? Notes;
    private string SelectedStatus = "Draft";
    private bool IsEdit => Release is not null;

    protected override void OnParametersSet()
    {
        if (Release is not null)
        {
            Name = Release.Name;
            SprintNumber = Release.SprintNumber;
            Label = Release.Label;
            Notes = Release.Notes;
            SelectedStatus = Release.Status.ToString();
        }
        else if (Visible)
        {
            Name = string.Empty;
            SprintNumber = null;
            Label = null;
            Notes = null;
            SelectedStatus = "Draft";
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Name)) return;

        ReleaseRecord record;
        if (Release is not null)
        {
            Release.Name = Name.Trim();
            Release.SprintNumber = SprintNumber;
            Release.Label = string.IsNullOrWhiteSpace(Label) ? null : Label.Trim();
            Release.Notes = string.IsNullOrWhiteSpace(Notes) ? null : Notes.Trim();
            Release.Status = Enum.Parse<ReleaseStatus>(SelectedStatus);
            await ReleaseRepo.UpdateReleaseAsync(Release);
            record = Release;
        }
        else
        {
            record = new ReleaseRecord
            {
                Name = Name.Trim(),
                SprintNumber = SprintNumber,
                Label = string.IsNullOrWhiteSpace(Label) ? null : Label.Trim(),
                Notes = string.IsNullOrWhiteSpace(Notes) ? null : Notes.Trim()
            };
            await ReleaseRepo.AddReleaseAsync(record);
        }

        await OnSaved.InvokeAsync(record);
    }

    private Task Cancel() => OnCancel.InvokeAsync();
}
