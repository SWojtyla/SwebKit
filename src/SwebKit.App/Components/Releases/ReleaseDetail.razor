@inject ReleaseRepository ReleaseRepo

<div class="release-detail">
    @if (Release is null)
    {
        <div class="release-detail__empty-state text-muted">
            Select a release from the list, or create a new one.
        </div>
    }
    else if (_isLoading)
    {
        <LoadingSpinner Message="Loading deployment status from ADO..." />
    }
    else if (_errorMessage is not null)
    {
        <ErrorCallout Message="@_errorMessage" OnRetry="LoadAsync" />
    }
    else
    {
        @* ── Release header ── *@
        <div class="release-detail__header">
            <div class="release-detail__title-row">
                <h3 class="release-detail__name">@Release.Name</h3>
                <span class="status-badge @StatusClass(Release.Status)">@StatusLabel(Release.Status)</span>
                @if (Release.SprintNumber.HasValue)
                {
                    <span class="text-muted text-sm">Sprint @Release.SprintNumber</span>
                }
                @if (Release.Label is not null)
                {
                    <span class="text-muted text-sm">@Release.Label</span>
                }
                <div class="release-detail__readiness">
                    @{
                        var readiness = ComputeReadiness();
                    }
                    <span class="release-detail__readiness-badge @readiness.ToneClass">
                        <FluentIcon Value="@readiness.Icon" Width="14px" />
                        <span class="release-detail__readiness-label">@readiness.Label</span>
                    </span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Release.Notes))
            {
                <div class="release-detail__notes">@Release.Notes</div>
            }

            @* ── Action bar ── *@
            @if (!IsDemoOnly)
            {
                <div class="release-detail__actions">
                    <span class="release-detail__action">
                        <FluentButton Appearance="Appearance.Lightweight" @onclick="@(() => OnEditComponents.InvokeAsync())">
                            Manage Scope</FluentButton>
                        </span>
                        <span class="release-detail__action">
                            <FluentButton Appearance="Appearance.Lightweight" @onclick="ToggleTagManager">Tag Manager</FluentButton>
                        </span>
                        <span class="release-detail__action">
                            <FluentButton Appearance="Appearance.Lightweight" @onclick="@(() => OnEditRelease.InvokeAsync())">Edit
                            </FluentButton>
                        </span>
                        <span class="release-detail__action release-detail__action--danger">
                            <FluentButton Appearance="Appearance.Lightweight" @onclick="@(() => OnDeleteRelease.InvokeAsync())">
                                Delete</FluentButton>
                            </span>
                        </div>
                    }
                </div>

                @* ── Component × Environment matrix ── *@
                @if (_scopedComponents.Count == 0)
                {
                    <div class="release-detail__empty-scope text-muted text-sm">
                        No components in scope. Click <strong>Manage Scope</strong> to add repos and pipelines.
                    </div>
                }
                else
                {
                    <div class="release-detail__matrix-shell" tabindex="0" @onkeydown="HandleMatrixKeyDown"
                         @onkeydown:preventDefault="_preventMatrixKey">
                        <table class="release-matrix">
                            <thead>
                                <tr>
                                    <th class="release-matrix__header release-matrix__header--component">Component</th>
                                    <th class="release-matrix__header release-matrix__header--tag">Tag</th>
                                    @foreach (var env in _discoveredEnvironments)
                                    {
                                        <th class="release-matrix__header release-matrix__header--environment">@env</th>
                                    }
                                    <th class="release-matrix__header release-matrix__header--ready">Ready</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int idx = 0; idx < _scopedComponents.Count; idx++)
                                {
                                    var comp = _scopedComponents[idx];
                                    var compData = _boardData.GetValueOrDefault(comp.ComponentName);
                                    var runName = _runNames.GetValueOrDefault(comp.ComponentName);
                                    var isRowSelected = idx == _selectedComponentIdx;
                                    <tr
                                        class="@(isRowSelected ? "release-matrix__row release-matrix__row--selected" : "release-matrix__row")">
                                        <td>
                                            <div class="release-matrix-comp-name">@comp.ComponentName</div>
                                            @if (runName is not null)
                                            {
                                                <div class="release-matrix-run">#@runName</div>
                                            }
                                        </td>
                                        <td>
                                            @if (comp.TagConfirmed)
                                            {
                                                <span class="release-matrix-tag--confirmed">@comp.TargetTag</span>
                                            }
                                            else if (!string.IsNullOrEmpty(comp.TargetTag))
                                            {
                                                <span class="text-muted">@comp.TargetTag</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        @foreach (var env in _discoveredEnvironments)
                                        {
                                            var cell = compData?.GetValueOrDefault(env);
                                            <td>
                                                @if (cell is not null)
                                                {
                                                    <a class="release-matrix__status-link" href="@cell.WebUrl" target="_blank"
                                                           title="@cell.State / @cell.Result">
                                                        <span class="pipeline-status @cell.CssClass">@cell.DisplayText</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        }
                                        <td>
                                            @{
                                                var (icon, tooltip) = ComponentReadiness(comp, compData);
                                            }
                                            <span class="release-matrix__readiness-icon" title="@tooltip">
                                                <FluentIcon Value="@icon" Width="14px" />
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* ── Tag Manager (inline toggle) ── *@
                @if (_showTagManager)
                {
                    <div class="pipeline-section release-detail__tag-manager">
                        <h4 class="pipeline-section-title">Tag Manager</h4>
                        <TagManager Release="Release" />
                    </div>
                }
            }
        </div>


@code {
    [Parameter] public ReleaseRecord? Release { get; set; }
    [Parameter] public bool IsDemoOnly { get; set; }
    [Parameter] public EventCallback OnEditRelease { get; set; }
    [Parameter] public EventCallback OnEditComponents { get; set; }
    [Parameter] public EventCallback OnDeleteRelease { get; set; }
    [CascadingParameter(Name = "DevOpsClient")] public IDevOpsClient DevOpsClient { get; set; } = default!;

    private bool _isLoading;
    private string? _errorMessage;
    private bool _showTagManager;
    private int _selectedComponentIdx = -1;
    private bool _preventMatrixKey;

    private List<string> _discoveredEnvironments = [];
    private List<ComponentScope> _scopedComponents => Release?.Components.Where(c => c.InScope).ToList() ?? [];
    private Dictionary<string, Dictionary<string, CellData>> _boardData = new();
    private Dictionary<string, string> _runNames = new();

    public record CellData(string State, string Result, string DisplayText, string CssClass, string? WebUrl);

    protected override async Task OnParametersSetAsync()
    {
        if (Release is not null && _scopedComponents.Count > 0)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _boardData.Clear();
        _runNames.Clear();
        _discoveredEnvironments = [];

        try
        {
            var projectNames = _scopedComponents.Select(c => c.ProjectName).Distinct().ToList();
            var allEnvs = new HashSet<string>();
            foreach (var proj in projectNames)
            {
                try
                {
                    var envs = await DevOpsClient.GetEnvironmentsAsync(proj);
                    foreach (var env in envs) allEnvs.Add(env.Name);
                }
                catch { }
            }
            _discoveredEnvironments = [.. allEnvs];

            foreach (var comp in _scopedComponents)
            {
                if (comp.PipelineId == 0) continue;
                try
                {
                    var runs = await DevOpsClient.GetPipelineRunsAsync(comp.ProjectName, comp.PipelineId, top: 5);
                    var latestRun = runs.FirstOrDefault();
                    if (latestRun is null) continue;

                    if (latestRun.Stages.Count == 0)
                    {
                        try { latestRun = await DevOpsClient.GetPipelineRunAsync(comp.ProjectName, comp.PipelineId, latestRun.Id); }
                        catch { }
                    }

                    var waitingStageNames = new HashSet<string>();
                    if (latestRun.State != "completed")
                    {
                        try
                        {
                            var waiting = await DevOpsClient.GetWaitingStagesAsync(comp.ProjectName, latestRun.Id);
                            foreach (var w in waiting) waitingStageNames.Add(w.StageName);
                        }
                        catch { }
                    }

                    if (!string.IsNullOrEmpty(latestRun.Name))
                        _runNames[comp.ComponentName] = latestRun.Name;

                    var envMap = new Dictionary<string, CellData>();
                    foreach (var stage in latestRun.Stages)
                    {
                        var envName = ResolveEnvironmentName(stage, _discoveredEnvironments);
                        if (envName is null) continue;
                        var isWaiting = waitingStageNames.Contains(stage.Name);

                        var (display, css) = (stage.State, isWaiting) switch
                        {
                            (_, true) => ("Awaiting Approval", "waiting"),
                            ("completed", _) when stage.Result == "succeeded" => ("Deployed", "succeeded"),
                            ("completed", _) when stage.Result == "failed" => ("Failed", "failed"),
                            ("inProgress", _) => ("Running", "running"),
                            _ => ("Pending", "notdeployed")
                        };
                        envMap[envName] = new CellData(stage.State, stage.Result, display, css, latestRun.WebUrl);
                    }
                    _boardData[comp.ComponentName] = envMap;
                }
                catch { }
            }
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _isLoading = false; }
    }

    private static string? ResolveEnvironmentName(AdoPipelineStage stage, List<string> environments)
    {
        if (stage.EnvironmentName is not null)
        {
            var direct = environments.FirstOrDefault(e =>
                string.Equals(e, stage.EnvironmentName, StringComparison.OrdinalIgnoreCase));
            if (direct is not null) return direct;
        }

        var byContains = environments.FirstOrDefault(e =>
            stage.Name.Contains(e, StringComparison.OrdinalIgnoreCase));
        if (byContains is not null) return byContains;

        if (stage.EnvironmentName is not null)
        {
            var normalized = stage.EnvironmentName.Replace('_', '-');
            var byNormalized = environments.FirstOrDefault(e =>
                string.Equals(e, normalized, StringComparison.OrdinalIgnoreCase) ||
                normalized.Contains(e, StringComparison.OrdinalIgnoreCase));
            if (byNormalized is not null) return byNormalized;
        }

        return null;
    }

    private (Icon Icon, string Tooltip) ComponentReadiness(ComponentScope comp, Dictionary<string, CellData>? envData)
    {
        if (envData is null) return (new Icons.Regular.Size16.CircleOff(), "No deployment data");
        if (envData.Values.Any(c => c.CssClass == "failed")) return (new Icons.Filled.Size16.DismissCircle(), "Pipeline has failed stages");
        if (envData.Values.Any(c => c.CssClass == "waiting")) return (new Icons.Regular.Size16.LockClosed(), "Waiting for approval");
        if (envData.Values.Any(c => c.CssClass == "running")) return (new Icons.Regular.Size16.Clock(), "Pipeline is running");
        if (!comp.TagConfirmed) return (new Icons.Regular.Size16.Warning(), "Tag not yet confirmed");
        if (envData.Values.All(c => c.CssClass is "succeeded" or "notdeployed") && comp.TagConfirmed)
            return (new Icons.Filled.Size16.CheckmarkCircle(), "Ready for release");
        return (new Icons.Regular.Size16.CircleOff(), "Unknown state");
    }

    private (Icon Icon, string Label, string ToneClass) ComputeReadiness()
    {
        if (_scopedComponents.Count == 0)
            return (new Icons.Regular.Size16.CircleOff(), "No components", "release-detail__readiness-badge--muted");

        var hasFailure = false;
        var hasPending = false;
        var allReady = true;

        foreach (var comp in _scopedComponents)
        {
            var envData = _boardData.GetValueOrDefault(comp.ComponentName);
            if (envData is null) { allReady = false; continue; }
            if (envData.Values.Any(c => c.CssClass == "failed")) { hasFailure = true; allReady = false; }
            if (envData.Values.Any(c => c.CssClass == "running")) { hasPending = true; allReady = false; }
            if (!comp.TagConfirmed) allReady = false;
        }

        if (hasFailure) return (new Icons.Filled.Size16.DismissCircle(), "Not Ready",
"release-detail__readiness-badge--danger");
        if (hasPending) return (new Icons.Regular.Size16.Clock(), "In Progress", "release-detail__readiness-badge--accent");
        if (allReady) return (new Icons.Filled.Size16.CheckmarkCircle(), "Release Ready",
"release-detail__readiness-badge--success");
        return (new Icons.Regular.Size16.Warning(), "Partially Ready", "release-detail__readiness-badge--warning");
    }

    private static string StatusClass(ReleaseStatus s) => s switch
    {
        ReleaseStatus.Draft => "draft",
        ReleaseStatus.InProgress => "inprogress",
        ReleaseStatus.Completed => "completed",
        _ => ""
    };

    private static string StatusLabel(ReleaseStatus s) => s switch
    {
        ReleaseStatus.InProgress => "In Progress",
        _ => s.ToString()
    };

    private void ToggleTagManager() => _showTagManager = !_showTagManager;

    private void HandleMatrixKeyDown(KeyboardEventArgs e)
    {
        if (_scopedComponents.Count == 0) return;
        _preventMatrixKey = e.Key is "ArrowUp" or "ArrowDown" or "Escape";
        switch (e.Key)
        {
            case "ArrowDown":
                _selectedComponentIdx = Math.Min(_selectedComponentIdx + 1, _scopedComponents.Count - 1);
                break;
            case "ArrowUp":
                _selectedComponentIdx = Math.Max(_selectedComponentIdx - 1, 0);
                break;
            case "Escape":
                _selectedComponentIdx = -1;
                break;
        }
    }
}
