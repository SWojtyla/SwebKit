@using static ReleaseBoard

<div style="display:flex; align-items:center; gap:8px;">
    @{
        var (icon, label, color) = ComputeGlobalReadiness();
    }
    <span style="color:@color; display:inline-flex; align-items:center;">
        <FluentIcon Value="@icon" Width="16px" />
    </span>
    <span style="font-size:12px; font-weight:600; color:@color;">@label</span>
</div>

@code {
    [Parameter] public List<ComponentScope> Components { get; set; } = [];
    [Parameter] public Dictionary<string, Dictionary<string, CellData>> BoardData { get; set; } = new();

    private (Icon Icon, string Label, string Color) ComputeGlobalReadiness()
    {
        if (Components.Count == 0)
            return (new Icons.Regular.Size16.CircleOff(), "No components", "var(--color-text-muted)");

        var hasFailure = false;
        var hasPending = false;
        var allReady = true;

        foreach (var comp in Components)
        {
            var envData = BoardData.GetValueOrDefault(comp.ComponentName);
            if (envData is null)
            {
                allReady = false;
                continue;
            }

            if (envData.Values.Any(c => c.CssClass == "failed"))
            {
                hasFailure = true;
                allReady = false;
            }

            if (envData.Values.Any(c => c.CssClass == "running"))
            {
                hasPending = true;
                allReady = false;
            }

            if (!comp.TagConfirmed)
                allReady = false;
        }

        if (hasFailure)
            return (new Icons.Filled.Size16.DismissCircle(), "Not Ready", "var(--color-error)");

        if (hasPending)
            return (new Icons.Regular.Size16.Clock(), "In Progress", "var(--color-accent)");

        if (allReady)
            return (new Icons.Filled.Size16.CheckmarkCircle(), "Release Ready", "var(--color-success)");

        return (new Icons.Regular.Size16.Warning(), "Partially Ready", "var(--color-text-muted)");
    }
}