@implements IDisposable

<div>
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
        <FluentButton Appearance="Appearance.Lightweight" @onclick="LoadAsync">Refresh</FluentButton>
        <AutoRefreshToggle OnRefresh="LoadAsync" />
    </div>

    @if (Release is null)
    {
        <div style="color:var(--color-text-muted); font-size:13px; padding:20px 0;">
            Select a release to see pending approvals.
        </div>
    }
    else if (IsLoading)
    {
        <LoadingSpinner Message="Checking pipelines for pending approvals..." />
    }
    else if (ErrorMessage is not null)
    {
        <ErrorCallout Message="@ErrorMessage" OnRetry="LoadAsync" />
    }
    else if (PendingItems.Count == 0)
    {
        <div style="color:var(--color-text-muted); font-size:13px; padding:20px 0;">
            No pending approvals for the components in this release.
        </div>
    }
    else
    {
        <div style="display:grid; gap:12px;">
            @foreach (var item in PendingItems)
            {
                <div style="padding:12px; border:1px solid var(--color-border); border-radius:6px; background:var(--color-surface);">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                        <div>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <span style="font-size:14px; font-weight:600;">@item.ComponentName</span>
                                @if (!string.IsNullOrEmpty(item.RunName))
                                {
                                    <span style="font-size:12px; color:var(--color-accent); font-family:Consolas,monospace;">#@item.RunName</span>
                                }
                            </div>
                            <div style="font-size:12px; color:var(--color-text-muted);">
                                @item.ProjectName — waiting at <strong>@item.StageName</strong>
                                @if (item.TriggeredBy is not null)
                                {
                                    <text> — triggered by @item.TriggeredBy</text>
                                }
                            </div>
                        </div>
                        <div style="display:flex; gap:6px; align-items:center;">
                            @if (item.IsProd)
                            {
                                <span style="font-size:10px; padding:2px 6px; background:rgba(200,0,42,0.2); color:var(--color-error); border-radius:4px; font-weight:600;">PROD</span>
                            }
                            @if (item.ApprovalId is not null)
                            {
                                <FluentButton Appearance="Appearance.Accent" @onclick="@(() => StartApprove(item))">Approve</FluentButton>
                                <FluentButton @onclick="@(() => StartReject(item))">Reject</FluentButton>
                            }
                            else if (item.WebUrl is not null)
                            {
                                <a href="@item.WebUrl" target="_blank"
                                   style="padding:6px 12px; font-size:12px; color:var(--color-accent); text-decoration:none; border:1px solid var(--color-border); border-radius:4px;">
                                    Review in ADO
                                </a>
                            }
                        </div>
                    </div>
                    <div style="font-size:11px; color:var(--color-text-muted);">
                        Run started @item.CreatedDate.LocalDateTime.ToString("g")
                        — Branch: @item.SourceBranch
                        @if (item.WebUrl is not null && item.ApprovalId is not null)
                        {
                            <text> — </text>
                            <a href="@item.WebUrl" target="_blank" style="color:var(--color-accent);">View in ADO</a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ── Comment + confirm dialog ── *@
@if (ActionTarget is not null)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:500; display:flex; align-items:center; justify-content:center;">
        <div style="background:var(--color-surface-2); border:1px solid var(--color-border); border-radius:8px; padding:24px; max-width:440px; width:90%;">
            @if (ActionTarget.IsProd)
            {
                <div style="background:var(--color-prod, #C8002A); color:white; padding:6px 12px; border-radius:4px; margin-bottom:16px; font-size:12px; font-weight:600;">
                    &#9888; PRODUCTION — This approval will deploy to a production environment
                </div>
            }
            <h3 style="margin:0 0 8px; font-size:15px;">@(IsApproving ? "Approve" : "Reject") — @ActionTarget.ComponentName</h3>
            <p style="margin:0 0 4px; font-size:13px; color:var(--color-text-muted);">
                @ActionTarget.ProjectName — @ActionTarget.StageName
            </p>
            @if (!string.IsNullOrEmpty(ActionTarget.RunName))
            {
                <p style="margin:0 0 12px; font-size:12px; color:var(--color-accent); font-family:Consolas,monospace;">#@ActionTarget.RunName</p>
            }

            <div style="display:grid; gap:4px; margin-bottom:12px;">
                <label style="font-size:12px; color:var(--color-text-muted);">Comment (optional)</label>
                <textarea @bind="ActionComment" @bind:event="oninput" rows="2"
                          style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px; resize:vertical;"></textarea>
            </div>

            @if (ActionTarget.IsProd)
            {
                <div style="margin-bottom:12px;">
                    <p style="font-size:12px; margin:0 0 6px;">Type <strong>CONFIRM</strong> to proceed:</p>
                    <input type="text" @bind="TypingConfirm" @bind:event="oninput"
                           style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px;" />
                </div>
            }

            @if (ActionError is not null)
            {
                <div style="font-size:12px; color:var(--color-error); margin-bottom:8px;">@ActionError</div>
            }

            <div style="display:flex; gap:8px; justify-content:flex-end;">
                <button @onclick="CancelAction" style="padding:6px 16px; cursor:pointer;">Cancel</button>
                <button @onclick="ExecuteAction" disabled="@IsActionDisabled"
                        style="padding:6px 16px; background:@(IsApproving ? "var(--color-accent)" : "var(--color-error)"); color:white; border:none; border-radius:4px; cursor:pointer; @(IsActionDisabled ? "opacity:0.5;" : "")">
                    @(IsApproving ? "Approve" : "Reject")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public ReleaseRecord? Release { get; set; }
    [CascadingParameter(Name = "DevOpsClient")] public IDevOpsClient DevOpsClient { get; set; } = default!;

    private bool IsLoading;
    private string? ErrorMessage;
    private List<PendingApprovalItem> PendingItems = [];

    // Action state
    private PendingApprovalItem? ActionTarget;
    private bool IsApproving;
    private string ActionComment = string.Empty;
    private string TypingConfirm = string.Empty;
    private string? ActionError;
    private bool IsActionDisabled => ActionTarget?.IsProd == true && TypingConfirm != "CONFIRM";

    private List<ComponentScope> ScopedComponents =>
        Release?.Components.Where(c => c.InScope && c.PipelineId > 0).ToList() ?? [];

    private record PendingApprovalItem(
        string ComponentName,
        string ProjectName,
        string StageName,
        string? RunName,
        string SourceBranch,
        string? TriggeredBy,
        string? ApprovalId,
        string? WebUrl,
        DateTimeOffset CreatedDate,
        bool IsProd);

    protected override async Task OnInitializedAsync()
    {
        if (Release is not null)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Release is null || ScopedComponents.Count == 0)
        {
            PendingItems = [];
            return;
        }

        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var items = new List<PendingApprovalItem>();

            foreach (var comp in ScopedComponents)
            {
                try
                {
                    var runs = await DevOpsClient.GetPipelineRunsAsync(comp.ProjectName, comp.PipelineId, top: 1);
                    var latestRun = runs.FirstOrDefault();
                    if (latestRun is null || latestRun.State == "completed") continue;

                    var waitingStages = await DevOpsClient.GetWaitingStagesAsync(
                        comp.ProjectName, latestRun.Id);

                    if (waitingStages.Count == 0) continue;

                    foreach (var stage in waitingStages)
                    {
                        // Name-based production detection
                        var isProd = IsProdStage(stage.StageName);

                        items.Add(new PendingApprovalItem(
                            comp.ComponentName,
                            comp.ProjectName,
                            stage.StageName,
                            latestRun.Name,
                            latestRun.SourceBranch,
                            latestRun.TriggeredBy,
                            stage.ApprovalId,
                            latestRun.WebUrl,
                            latestRun.CreatedDate,
                            isProd));
                    }
                }
                catch { /* Skip components that fail */ }
            }

            PendingItems = items.OrderBy(i => i.CreatedDate).ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Detects production stages by name rather than by position.
    /// </summary>
    private static bool IsProdStage(string stageName)
    {
        var lower = stageName.ToLowerInvariant();
        return lower.Contains("prd") || lower.Contains("prod") || lower.Contains("production");
    }

    private void StartApprove(PendingApprovalItem item)
    {
        ActionTarget = item;
        IsApproving = true;
        ActionComment = string.Empty;
        TypingConfirm = string.Empty;
        ActionError = null;
    }

    private void StartReject(PendingApprovalItem item)
    {
        ActionTarget = item;
        IsApproving = false;
        ActionComment = string.Empty;
        TypingConfirm = string.Empty;
        ActionError = null;
    }

    private void CancelAction()
    {
        ActionTarget = null;
        ActionComment = string.Empty;
        TypingConfirm = string.Empty;
        ActionError = null;
    }

    private async Task ExecuteAction()
    {
        if (ActionTarget?.ApprovalId is null) return;
        var comment = string.IsNullOrWhiteSpace(ActionComment) ? null : ActionComment.Trim();

        try
        {
            if (IsApproving)
                await DevOpsClient.ApproveAsync(ActionTarget.ProjectName, ActionTarget.ApprovalId, comment);
            else
                await DevOpsClient.RejectAsync(ActionTarget.ProjectName, ActionTarget.ApprovalId, comment);

            CancelAction();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ActionError = $"Failed: {ex.Message}";
        }
    }

    public void Dispose() { }
}
