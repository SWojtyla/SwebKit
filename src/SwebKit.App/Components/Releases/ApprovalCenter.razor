@implements IDisposable
@inject INotificationService Notifications
@inject ApprovalAgingPolicy AgingPolicy

<div class="approval-center">

    @* ── Toolbar ── *@
    <div class="approval-toolbar">
        <div class="filter-select-wrap">
            <select class="filter-select" @bind="_filterProject">
                <option value="">All Projects</option>
                @foreach (var p in _projects)
                {
                    <option value="@p">@p</option>
                }
            </select>
        </div>
        <FluentButton Appearance="Appearance.Lightweight" @onclick="LoadAsync">Refresh</FluentButton>
        <AutoRefreshToggle OnRefresh="LoadAsync" />
    </div>

    @* ── Content ── *@
    @if (_isLoading)
    {
        <LoadingSpinner Message="Checking for pending approvals..." />
    }
    else if (_errorMessage is not null)
    {
        <ErrorCallout Message="@_errorMessage" OnRetry="LoadAsync" />
    }
    else if (FilteredItems.Count == 0)
    {
        <div class="approval-empty">
            <div>No pending approvals across all projects.</div>
            <div class="approval-empty__hint text-muted text-sm" style="margin-top:6px;">
                If you see <em>Awaiting Approval</em> on a pipeline stage, the approval may be assigned
                to a different user or role — open the run directly in ADO to approve it.
            </div>
        </div>
    }
    else
    {
        <div class="approval-list">
            @foreach (var item in FilteredItems)
            {
                <div class="approval-card">
                    <div class="approval-card__header">
                        <div class="approval-card__meta">
                            <span class="approval-card__pipeline-name">@item.Approval.PipelineName</span>
                            <span class="approval-card__project-badge">@item.ProjectName</span>
                            @if (item.IsProd)
                            {
                                <span class="approval-prod-badge">PROD</span>
                            }
                        </div>
                        <div class="approval-card__actions">
                            <FluentButton Appearance="Appearance.Accent" @onclick="@(() => StartApprove(item))">Approve
                            </FluentButton>
                            <FluentButton @onclick="@(() => StartReject(item))">Reject</FluentButton>
                            @if (item.Approval.WebUrl is not null)
                            {
                                <a href="@item.Approval.WebUrl" target="_blank" class="approval-ado-link">ADO ↗</a>
                            }
                        </div>
                    </div>
                    <div class="approval-card__info">
                        @(item.Approval.EnvironmentName ?? item.Approval.StageName)
                        @if (item.Approval.TriggeredBy is not null)
                        {
                            <text> — triggered by @item.Approval.TriggeredBy</text>
                        }
                    </div>
                    <div class="approval-card__time">
                        @if (_ageResults.TryGetValue(item.Approval.Id, out var ageResult))
                        {
                            <span class="approval-age-badge approval-age-badge--@ageResult.State.ToString().ToLowerInvariant()"
                                  data-testid="approval-age-badge">
                                @FormatAge(ageResult.Age) — @ageResult.State
                            </span>
                        }
                        @item.Approval.CreatedOn.LocalDateTime.ToString("g")
                    </div>
                </div>
            }
        </div>
    }

</div>

@* ── Approve / Reject dialog ── *@
@if (_actionTarget is not null)
{
    <div class="approval-dialog-overlay">
        <div class="approval-dialog">
            @if (_actionTarget.IsProd)
            {
                <div class="approval-dialog__prod-warning">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Width="16px" />
                    PRODUCTION — This approval will deploy to a production environment
                </div>
            }
            <h3 class="approval-dialog__title">@(_isApproving ? "Approve" : "Reject") — @_actionTarget.Approval.PipelineName
            </h3>
            <p class="approval-dialog__subtitle">
                @_actionTarget.ProjectName — @(_actionTarget.Approval.EnvironmentName ?? _actionTarget.Approval.StageName)
            </p>

            <div class="approval-dialog__field">
                <label class="form-label">Comment (optional)</label>
                <textarea class="form-input" @bind="_actionComment" @bind:event="oninput" rows="2"
                          style="resize:vertical;"></textarea>
            </div>

            @if (_actionTarget.IsProd)
            {
                <div class="approval-dialog__field">
                    <p class="approval-dialog__confirm-prompt">Type <strong>CONFIRM</strong> to proceed:</p>
                    <input type="text" class="form-input" @bind="_typingConfirm" @bind:event="oninput" />
                </div>
            }

            @if (_actionError is not null)
            {
                <div class="approval-dialog__error">@_actionError</div>
            }

            <div class="approval-dialog__actions">
                <button class="approval-btn-cancel" @onclick="CancelAction">Cancel</button>
                <button class="approval-btn-confirm @(_isApproving ? "approve" : "reject")" @onclick="ExecuteAction"
                        disabled="@IsActionDisabled">
                    @(_isApproving ? "Approve" : "Reject")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter(Name = "DevOpsClient")] public IDevOpsClient DevOpsClient { get; set; } = default!;
    [Parameter] public EventCallback<int> OnCountChanged { get; set; }
    [Parameter] public List<string> PinnedProjects { get; set; } = [];

    private bool _isLoading;
    private string? _errorMessage;
    private string _filterProject = string.Empty;
    private List<string> _projects = [];
    private List<ProjectApproval> _allItems = [];
    private Dictionary<string, ApprovalAgeResult> _ageResults = [];

    // Action state
    private ProjectApproval? _actionTarget;
    private bool _isApproving;
    private string _actionComment = string.Empty;
    private string _typingConfirm = string.Empty;
    private string? _actionError;
    private bool IsActionDisabled => _actionTarget?.IsProd == true && _typingConfirm != "CONFIRM";

    private List<ProjectApproval> FilteredItems => string.IsNullOrEmpty(_filterProject)
        ? _allItems
        : _allItems.Where(i => i.ProjectName == _filterProject).ToList();

    private record ProjectApproval(string ProjectName, AdoApproval Approval, bool IsProd);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var all = await DevOpsClient.GetProjectsAsync();
            var projects = PinnedProjects.Count > 0
                ? all.Where(p => PinnedProjects.Contains(p.Name)).ToList()
                : all;
            _projects = projects.Select(p => p.Name).ToList();

            var items = new List<ProjectApproval>();
            foreach (var project in projects)
            {
                try
                {
                    var approvals = await DevOpsClient.GetPendingApprovalsAsync(project.Name);
                    items.AddRange(approvals.Select(a => new ProjectApproval(
                        project.Name, a, IsProdApproval(a))));
                }
                catch { }
            }

            _allItems = items.OrderBy(i => i.Approval.CreatedOn).ToList();
            var now = DateTimeOffset.UtcNow;
            _ageResults = _allItems.ToDictionary(
                i => i.Approval.Id,
                i => AgingPolicy.Evaluate(i.Approval, now));
            await OnCountChanged.InvokeAsync(_allItems.Count);
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string FormatAge(TimeSpan age) =>
        age.TotalHours >= 1
            ? $"{(int)age.TotalHours}h {age.Minutes}m"
            : $"{(int)age.TotalMinutes}m";

    private static bool IsProdApproval(AdoApproval a)
    {
        var name = ((a.EnvironmentName ?? string.Empty) + " " + (a.StageName ?? string.Empty)).ToLowerInvariant();
        return name.Contains("prd") || name.Contains("prod") || name.Contains("production");
    }

    private void StartApprove(ProjectApproval item)
    {
        _actionTarget = item; _isApproving = true; _actionComment = "";
        _typingConfirm = ""; _actionError = null;
    }
    private void StartReject(ProjectApproval item)
    {
        _actionTarget = item; _isApproving = false; _actionComment = "";
        _typingConfirm = ""; _actionError = null;
    }
    private void CancelAction() { _actionTarget = null; _actionComment = ""; _typingConfirm = ""; _actionError = null; }

    private async Task ExecuteAction()
    {
        if (_actionTarget is null) return;
        var comment = string.IsNullOrWhiteSpace(_actionComment) ? null : _actionComment.Trim();

        try
        {
            if (_isApproving)
                await DevOpsClient.ApproveAsync(_actionTarget.ProjectName, _actionTarget.Approval.Id, comment);
            else
                await DevOpsClient.RejectAsync(_actionTarget.ProjectName, _actionTarget.Approval.Id, comment);

            Notifications.ShowSuccess(_isApproving ? "Approval submitted" : "Approval rejected");
            CancelAction();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = $"Failed: {ex.Message}";
            Notifications.ShowError("Action failed", ex: ex);
        }
    }

    public void Dispose() { }
}
