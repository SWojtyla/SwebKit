@implements IDisposable
@inject INotificationService Notifications

<div>
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
        <select class="activity-filter-select" @bind="_filterProject">
            <option value="">All Projects</option>
            @foreach (var p in _projects)
            {
                <option value="@p">@p</option>
            }
        </select>
        <FluentButton Appearance="Appearance.Lightweight" @onclick="LoadAsync">Refresh</FluentButton>
        <AutoRefreshToggle OnRefresh="LoadAsync" />
    </div>

    @if (_isLoading)
    {
        <LoadingSpinner Message="Checking for pending approvals..." />
    }
    else if (_errorMessage is not null)
    {
        <ErrorCallout Message="@_errorMessage" OnRetry="LoadAsync" />
    }
    else if (FilteredItems.Count == 0)
    {
        <div style="color:var(--color-text-muted); font-size:13px; padding:20px 0;">
            No pending approvals across all projects.
        </div>
    }
    else
    {
        <div style="display:grid; gap:12px;">
            @foreach (var item in FilteredItems)
            {
                <div style="padding:12px; border:1px solid var(--color-border); border-radius:6px; background:var(--color-surface);">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                        <div>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <span style="font-size:14px; font-weight:600;">@item.Approval.PipelineName</span>
                                <span style="font-size:11px; color:var(--color-text-muted); padding:1px 6px; border:1px solid var(--color-border); border-radius:4px;">@item.ProjectName</span>
                            </div>
                            <div style="font-size:12px; color:var(--color-text-muted);">
                                @(item.Approval.EnvironmentName ?? item.Approval.StageName)
                                @if (item.Approval.TriggeredBy is not null)
                                {
                                    <text> — triggered by @item.Approval.TriggeredBy</text>
                                }
                            </div>
                        </div>
                        <div style="display:flex; gap:6px; align-items:center;">
                            @if (item.IsProd)
                            {
                                <span style="font-size:10px; padding:2px 6px; background:rgba(200,0,42,0.2); color:var(--color-error); border-radius:4px; font-weight:600;">PROD</span>
                            }
                            <FluentButton Appearance="Appearance.Accent" @onclick="@(() => StartApprove(item))">Approve</FluentButton>
                            <FluentButton @onclick="@(() => StartReject(item))">Reject</FluentButton>
                            @if (item.Approval.WebUrl is not null)
                            {
                                <a href="@item.Approval.WebUrl" target="_blank"
                                   style="padding:6px 12px; font-size:12px; color:var(--color-accent); text-decoration:none; border:1px solid var(--color-border); border-radius:4px;">
                                    ADO ↗
                                </a>
                            }
                        </div>
                    </div>
                    <div style="font-size:11px; color:var(--color-text-muted);">
                        @item.Approval.CreatedOn.LocalDateTime.ToString("g")
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ── Comment + confirm dialog ── *@
@if (_actionTarget is not null)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:500; display:flex; align-items:center; justify-content:center;">
        <div style="background:var(--color-surface-2); border:1px solid var(--color-border); border-radius:8px; padding:24px; max-width:440px; width:90%;">
            @if (_actionTarget.IsProd)
            {
                <div style="background:var(--color-prod, #C8002A); color:white; padding:6px 12px; border-radius:4px; margin-bottom:16px; font-size:12px; font-weight:600;">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Width="16px" style="flex-shrink:0;" /> PRODUCTION — This approval will deploy to a production environment
                </div>
            }
            <h3 style="margin:0 0 8px; font-size:15px;">@(_isApproving ? "Approve" : "Reject") — @_actionTarget.Approval.PipelineName</h3>
            <p style="margin:0 0 4px; font-size:13px; color:var(--color-text-muted);">
                @_actionTarget.ProjectName — @(_actionTarget.Approval.EnvironmentName ?? _actionTarget.Approval.StageName)
            </p>

            <div style="display:grid; gap:4px; margin-bottom:12px;">
                <label style="font-size:12px; color:var(--color-text-muted);">Comment (optional)</label>
                <textarea @bind="_actionComment" @bind:event="oninput" rows="2"
                          style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px; resize:vertical;"></textarea>
            </div>

            @if (_actionTarget.IsProd)
            {
                <div style="margin-bottom:12px;">
                    <p style="font-size:12px; margin:0 0 6px;">Type <strong>CONFIRM</strong> to proceed:</p>
                    <input type="text" @bind="_typingConfirm" @bind:event="oninput"
                           style="width:100%; padding:6px 8px; background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border); border-radius:4px;" />
                </div>
            }

            @if (_actionError is not null)
            {
                <div style="font-size:12px; color:var(--color-error); margin-bottom:8px;">@_actionError</div>
            }

            <div style="display:flex; gap:8px; justify-content:flex-end;">
                <button @onclick="CancelAction" style="padding:6px 16px; cursor:pointer;">Cancel</button>
                <button @onclick="ExecuteAction" disabled="@IsActionDisabled"
                        style="padding:6px 16px; background:@(_isApproving ? "var(--color-accent)" : "var(--color-error)"); color:white; border:none; border-radius:4px; cursor:pointer; @(IsActionDisabled ? "opacity:0.5;" : "")">
                    @(_isApproving ? "Approve" : "Reject")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter(Name = "DevOpsClient")] public IDevOpsClient DevOpsClient { get; set; } = default!;
    [Parameter] public EventCallback<int> OnCountChanged { get; set; }

    private bool _isLoading;
    private string? _errorMessage;
    private string _filterProject = string.Empty;
    private List<string> _projects = [];
    private List<ProjectApproval> _allItems = [];

    // Action state
    private ProjectApproval? _actionTarget;
    private bool _isApproving;
    private string _actionComment = string.Empty;
    private string _typingConfirm = string.Empty;
    private string? _actionError;
    private bool IsActionDisabled => _actionTarget?.IsProd == true && _typingConfirm != "CONFIRM";

    private List<ProjectApproval> FilteredItems => string.IsNullOrEmpty(_filterProject)
        ? _allItems
        : _allItems.Where(i => i.ProjectName == _filterProject).ToList();

    private record ProjectApproval(string ProjectName, AdoApproval Approval, bool IsProd);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var projects = await DevOpsClient.GetProjectsAsync();
            _projects = projects.Select(p => p.Name).ToList();

            var items = new List<ProjectApproval>();
            foreach (var project in projects)
            {
                try
                {
                    var approvals = await DevOpsClient.GetPendingApprovalsAsync(project.Name);
                    items.AddRange(approvals.Select(a => new ProjectApproval(
                        project.Name, a, IsProdApproval(a))));
                }
                catch { }
            }

            _allItems = items.OrderBy(i => i.Approval.CreatedOn).ToList();
            await OnCountChanged.InvokeAsync(_allItems.Count);
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static bool IsProdApproval(AdoApproval a)
    {
        var name = ((a.EnvironmentName ?? string.Empty) + " " + (a.StageName ?? string.Empty)).ToLowerInvariant();
        return name.Contains("prd") || name.Contains("prod") || name.Contains("production");
    }

    private void StartApprove(ProjectApproval item) { _actionTarget = item; _isApproving = true; _actionComment = ""; _typingConfirm = ""; _actionError = null; }
    private void StartReject(ProjectApproval item) { _actionTarget = item; _isApproving = false; _actionComment = ""; _typingConfirm = ""; _actionError = null; }
    private void CancelAction() { _actionTarget = null; _actionComment = ""; _typingConfirm = ""; _actionError = null; }

    private async Task ExecuteAction()
    {
        if (_actionTarget is null) return;
        var comment = string.IsNullOrWhiteSpace(_actionComment) ? null : _actionComment.Trim();

        try
        {
            if (_isApproving)
                await DevOpsClient.ApproveAsync(_actionTarget.ProjectName, _actionTarget.Approval.Id, comment);
            else
                await DevOpsClient.RejectAsync(_actionTarget.ProjectName, _actionTarget.Approval.Id, comment);

            Notifications.ShowSuccess(_isApproving ? "Approval submitted" : "Approval rejected");
            CancelAction();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = $"Failed: {ex.Message}";
            Notifications.ShowError("Action failed", ex: ex);
        }
    }

    public void Dispose() { }
}
