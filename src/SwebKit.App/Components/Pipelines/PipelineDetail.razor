@inject INotificationService Notifications
@inject IncidentInvestigationLauncher InvestigationLauncher

<div class="pipeline-detail">

    @* ── Header ── *@
    <div class="pipeline-detail__header">
        <div>
            <h3 class="pipeline-detail__name">@Pipeline.Name</h3>
            <div class="text-muted text-sm">@Project.Name &nbsp;·&nbsp; Pipeline #@Pipeline.Id</div>
        </div>
        <div class="pipeline-detail__actions">
            @if (!string.IsNullOrEmpty(Pipeline.Url))
            {
                <a href="@Pipeline.Url" target="_blank" class="btn-link-sm">Open in ADO ↗</a>
            }
            <FluentButton Appearance="Appearance.Lightweight" @onclick="ToggleTrigger">
                <FluentIcon Value="@(new Icons.Regular.Size16.Play())" Width="12px" /> Trigger Run
            </FluentButton>
            <FluentButton Appearance="Appearance.Lightweight" @onclick="Investigate">
                Investigate
            </FluentButton>
        </div>
    </div>

    @* ── Trigger panel (inline) ── *@
    @if (_showTrigger)
    {
        <div class="pipeline-trigger-panel">
            <div class="trigger-panel__header">
                <span class="trigger-panel__title">Trigger Run</span>
                <button class="trigger-panel__close" @onclick="ToggleTrigger" title="Close">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="14px" />
                </button>
            </div>
            <div class="pipeline-trigger-row">
                <div class="form-group trigger-form__branch">
                    <label class="form-label">Branch</label>
                    @if (_branches is { Count: > 0 })
                    {
                        <select class="form-input" @bind="_branch">
                            @foreach (var b in _branches)
                            {
                                <option value="@b">@b</option>
                            }
                        </select>
                    }
                    else if (_loadingBranches)
                    {
                        <select class="form-input" disabled>
                            <option>Loading branches…</option>
                        </select>
                    }
                    else
                    {
                        <input type="text" class="form-input" @bind="_branch" placeholder="main" />
                    }
                </div>
                <div class="form-group trigger-form__params">
                    <label class="form-label">Template Parameters <span class="text-muted">(key=val, ...)</span></label>
                    <input type="text" class="form-input" @bind="_templateParams" placeholder="optional" />
                </div>
                <div class="trigger-form__actions">
                    <FluentButton Appearance="Appearance.Accent" @onclick="OpenTriggerConfirm" Disabled="@_triggering">
                        @(_triggering ? "Running…" : "Run")
                    </FluentButton>
                </div>
            </div>
        </div>

        <ConfirmDialog Visible="@_showTriggerConfirm" Title="Run Pipeline"
                       Message="@($"Trigger {Pipeline.Name} on branch '{_branch}'?")" ConfirmLabel="Run" OnConfirm="ExecuteTrigger"
                       OnCancel="@(() => _showTriggerConfirm = false)" />
    }

    @* ── Content ── *@
    @if (_isLoading)
    {
        <LoadingSpinner Message="Loading pipeline status..." />
    }
    else if (_error is not null)
    {
        <ErrorCallout Message="@_error" OnRetry="LoadAsync" />
    }
    else
    {
        @* ── Environment status ── *@
        @if (_envStatus.Count > 0)
        {
            <div class="pipeline-section">
                <h4 class="pipeline-section-title">Environments</h4>
                <FluentDataGrid Items="@(_envStatus.AsQueryable())" TGridItem="PipelineEnvironmentStatus">
                    <TemplateColumn Title="Environment"
                                    SortBy="@(GridSort<PipelineEnvironmentStatus>.ByAscending(e => e.EnvironmentName))">
                        <span class="env-name">@context.EnvironmentName</span>
                    </TemplateColumn>
                    <TemplateColumn Title="Status" Width="160px">
                        @if (context.WaitingForApproval)
                        {
                            <span class="pipeline-status waiting">Awaiting Approval</span>
                        }
                        else
                        {
                            <span class="pipeline-status @EnvStatusCss(context)">@EnvStatusText(context)</span>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="Run" Width="130px"
                                    SortBy="@(GridSort<PipelineEnvironmentStatus>.ByAscending(e => e.RunName ?? $"#{e.LatestRunId}"))">
                        <span class="text-mono text-sm">@(context.RunName ?? $"#{context.LatestRunId}")</span>
                    </TemplateColumn>
                    <TemplateColumn Title="When" Width="110px"
                                    SortBy="@(GridSort<PipelineEnvironmentStatus>.ByDescending(e => e.FinishedAt ?? DateTimeOffset.MinValue))">
                        <span class="text-muted text-sm">@(context.FinishedAt.HasValue ? RelativeTime(context.FinishedAt.Value)
                                                                    : "—")</span>
                        </TemplateColumn>
                        <TemplateColumn Title="Triggered by" Width="140px">
                            <span class="text-muted text-sm">@(context.TriggeredBy ?? "—")</span>
                        </TemplateColumn>
                    </FluentDataGrid>
                </div>
            }

            @* ── Recent runs ── *@
            <div class="pipeline-section">
                <h4 class="pipeline-section-title">Recent Runs</h4>
                @if (_recentRuns.Count == 0)
                {
                    <div class="text-muted text-sm">No runs yet.</div>
                }
                else
                {
                    <div class="pipeline-runs-list">
                        @foreach (var run in _recentRuns)
                        {
                            <div class="pipeline-run-row">
                                <span class="run-dot @RunDotClass(run)" title="@RunTitle(run)"></span>
                                <span class="text-mono text-sm pipeline-run-name">@run.Name</span>
                                <span class="text-muted text-sm pipeline-run-branch">@FormatBranch(run.SourceBranch)</span>
                                <span class="text-muted text-sm">@RelativeTime(run.CreatedDate)</span>
                                @if (run.TriggeredBy is not null)
                                {
                                    <span class="text-muted text-sm">by @run.TriggeredBy</span>
                                }
                                @if (run.FinishedDate.HasValue && run.State == "completed")
                                {
                                    var duration = run.FinishedDate.Value - run.CreatedDate;
                                    <span class="text-muted text-sm">@FormatDuration(duration)</span>
                                }
                                @if (run.WebUrl is not null)
                                {
                                    <a href="@run.WebUrl" target="_blank" class="btn-link-sm" style="margin-left:auto;">↗</a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

@code {
    [CascadingParameter(Name = "DevOpsClient")] public IDevOpsClient DevOpsClient { get; set; } = default!;
    [Parameter] public AdoProject Project { get; set; } = default!;
    [Parameter] public AdoPipeline Pipeline { get; set; } = default!;

    private bool _isLoading;
    private string? _error;
    private List<PipelineEnvironmentStatus> _envStatus = [];
    private List<AdoPipelineRun> _recentRuns = [];
    // Trigger state
    private bool _showTrigger;
    private bool _showTriggerConfirm;
    private bool _triggering;
    private string _branch = "main";
    private string _templateParams = string.Empty;
    private List<string>? _branches;
    private bool _loadingBranches;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var envTask = DevOpsClient.GetEnvironmentStatusAsync(Project.Name, Pipeline.Id);
            var runsTask = DevOpsClient.GetPipelineRunsAsync(Project.Name, Pipeline.Id, top: 10);
            await Task.WhenAll(envTask, runsTask);

            _envStatus = await envTask;
            _recentRuns = await runsTask;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _isLoading = false; }
    }

    private void Investigate()
    {
        var mostRecent = _recentRuns.Count > 0 ? _recentRuns[0] : null;
        var range = mostRecent is not null
            ? new TimeRange(mostRecent.CreatedDate, mostRecent.FinishedDate ?? DateTimeOffset.UtcNow)
            : TimeRange.Last24Hours;

        InvestigationLauncher.Launch(new IncidentInvestigationSeed
        {
            SourceArea = IncidentInvestigationSourceArea.Pipelines,
            LaunchedAtUtc = DateTimeOffset.UtcNow,
            SelectedRange = range,
            EvidenceRef = new IncidentSeedEvidenceRef
            {
                PipelineId = Pipeline.Id,
                RunId = mostRecent?.Id,
                ProjectName = Project.Name,
                RunDisplayName = mostRecent?.Name
            }
        });
    }

    private void ToggleTrigger()
    {
        _showTrigger = !_showTrigger;
        _showTriggerConfirm = false;
        if (_showTrigger && _branches is null)
            _ = LoadBranchesAsync();
    }

    private async Task LoadBranchesAsync()
    {
        _loadingBranches = true;
        StateHasChanged();
        try
        {
            var repos = await DevOpsClient.GetRepositoriesAsync(Project.Name);
            if (repos.Count > 0)
            {
                var branchTasks = repos.Select(r => DevOpsClient.GetBranchesAsync(Project.Name, r.Id));
                var results = await Task.WhenAll(branchTasks);
                _branches = results
                    .SelectMany(b => b)
                    .Distinct()
                    .OrderBy(b => b)
                    .ToList();

                // Pre-select the most recently used branch if it exists in the list
                var lastBranch = _recentRuns.FirstOrDefault()?.SourceBranch;
                if (lastBranch is not null && _branches.Contains(lastBranch))
                    _branch = lastBranch;
                else if (_branches.Contains("main"))
                    _branch = "main";
                else if (_branches.Count > 0)
                    _branch = _branches[0];
            }
            else
            {
                _branches = [];
            }
        }
        catch
        {
            _branches = [];
        }
        finally
        {
            _loadingBranches = false;
            StateHasChanged();
        }
    }

    private void OpenTriggerConfirm() => _showTriggerConfirm = true;

    private async Task ExecuteTrigger()
    {
        _showTriggerConfirm = false;
        _triggering = true;
        try
        {
            Dictionary<string, string>? templateParams = null;
            if (!string.IsNullOrWhiteSpace(_templateParams))
            {
                templateParams = _templateParams
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(kv => kv.Split('=', 2))
                    .Where(parts => parts.Length == 2)
                    .ToDictionary(parts => parts[0].Trim(), parts => parts[1].Trim());
            }

            var run = await DevOpsClient.TriggerPipelineRunAsync(Project.Name, Pipeline.Id, _branch, templateParams);
            _recentRuns.Insert(0, run);
            _showTrigger = false;
            Notifications.ShowSuccess("Pipeline triggered", Pipeline.Name);
        }
        catch (Exception ex)
        {
            Notifications.ShowError("Failed to trigger pipeline", ex: ex);
        }
        finally
        {
            _triggering = false;
            StateHasChanged();
        }
    }

    private static string EnvStatusCss(PipelineEnvironmentStatus env) =>
        (env.State, env.Result) switch
        {
            ("completed", "succeeded") => "succeeded",
            ("completed", "failed") => "failed",
            ("inProgress", _) => "running",
            ("pending", _) => "notdeployed",
            _ => "notdeployed"
        };

    private static string EnvStatusText(PipelineEnvironmentStatus env) =>
        (env.State, env.Result) switch
        {
            ("completed", "succeeded") => "Deployed",
            ("completed", "failed") => "Failed",
            ("inProgress", _) => "Running",
            ("pending", _) => "Pending",
            _ => "—"
        };

    private static string RunDotClass(AdoPipelineRun run) =>
        run.Result switch
        {
            "succeeded" => "run-dot--success",
            "failed" => "run-dot--failed",
            _ when run.State == "inProgress" => "run-dot--running",
            _ => "run-dot--none"
        };

    private static string RunTitle(AdoPipelineRun run) =>
        run.State == "inProgress" ? "Running" :
        run.Result == "succeeded" ? "Succeeded" :
        run.Result == "failed" ? "Failed" : run.State;

    private static string RelativeTime(DateTimeOffset dt)
    {
        var ago = DateTimeOffset.UtcNow - dt;
        if (ago.TotalMinutes < 2) return "just now";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}h ago";
        return $"{(int)ago.TotalDays}d ago";
    }

    private static string FormatDuration(TimeSpan ts)
    {
        if (ts.TotalMinutes < 1) return $"{(int)ts.TotalSeconds}s";
        if (ts.TotalHours < 1) return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
        return $"{(int)ts.TotalHours}h {ts.Minutes}m";
    }

    private static string FormatBranch(string? branch) =>
        branch?.Replace("refs/heads/", "") ?? "";
}
