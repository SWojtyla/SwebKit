# Build output
bin/
obj/

# User-specific files
*.user
*.suo
.vs/
*.userprefs

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

# OS
.DS_Store
Thumbs.db

# Rider
.idea/

# VS Code
.vscode/

# App data (runtime)
*.log

# Copilot local validation output
artifacts/copilot-build/
artifacts/copilot-obj/

# Code coverage report output (dotnet test --collect:"XPlat Code Coverage")
artifacts/coverage/
artifacts/coverage*/

# MSIX build output

# Script output (scripts/logs/*.log is already covered by *.log above; the
# throwaway AppData root used by scripts/tauri/test-frontend.ps1 is not)
scripts/.test-appdata/
scripts/logs/

# Throwaway appdata roots created by e2e runs
src-sidecar/.e2e-appdata*/

# Playwright
**/test-results/
**/playwright-report/

# TypeScript
*.tsbuildinfo

# Tauri / Rust
src-tauri/target/
src-tauri/binaries/
app-icon.png

# Ad-hoc local build logs (repo root)
build_log.txt
build_stdout.txt
build_stderr.txt
tauri_build_out.txt
tauri_build_err.txt

# Root-level node_modules (holds only the @tauri-apps/cli dev dependency used
# to drive `tauri dev`/`tauri build` from the repo root) — regenerate with
# `npm install`, don't commit it.
/node_modules/


# Literal file created when a Git Bash redirect uses `> nul` (Windows null device
# name is not special under Git Bash) — never a real artifact.
nul
