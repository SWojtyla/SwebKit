<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SwebKit.Sidecar</RootNamespace>
    <!-- Mirrors src-tauri/tauri.conf.json and src-tauri/Cargo.toml — bump all three together.
         GetHealth() in SystemEndpoints.cs reads this at runtime rather than hardcoding a string,
         so the status bar version can't silently drift from the app version again. -->
    <Version>0.2.0</Version>
    <!-- English-only tool: keep non-English satellite resource assemblies out of the publish.
         ScriptDom ships zh-Hant/zh-Hans/etc. resources, and WiX light.exe derives the MSI
         File.Language column from their version info — zh-Hant is not a valid MSI language id,
         so the MSI link dies on ICE03 "Invalid Language Id". -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <ProjectReference Include="..\src\SwebKit.Core\SwebKit.Core.csproj" />
    <ProjectReference Include="..\src\SwebKit.Azure\SwebKit.Azure.csproj" />
    <ProjectReference Include="..\src\SwebKit.Kubernetes\SwebKit.Kubernetes.csproj" />
    <ProjectReference Include="..\src\SwebKit.Redis\SwebKit.Redis.csproj" />
    <ProjectReference Include="..\src\SwebKit.Agents\SwebKit.Agents.csproj" />
    <ProjectReference Include="..\src\SwebKit.Observability\SwebKit.Observability.csproj" />
    <ProjectReference Include="..\src\SwebKit.Sql\SwebKit.Sql.csproj" />
    <PackageReference Include="keyring-dotnet" />
  </ItemGroup>
  <!--
    SwebKit.Observability was dropped from the Tauri rewrite as a *browsing UI* (product decision,
    2026-07-26) — no Observability page/nav item, no KQL browser, no SLO tracking panel. That part
    still stands. What changed (workspace-intelligence plan, 2026-08-03): the underlying Application
    Insights querying capability is now wired in as an agent-tool-only capability
    (`get_metrics`/`query_logs`, FeatureArea.Observability) — the data is valuable context for the
    AI agent even without a dedicated place to browse it yourself. SwebKit.DevOps/Pipelines remains
    fully dropped; nothing here reverses that.
  -->

</Project>
