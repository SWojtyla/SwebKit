<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SwebKit.Sidecar</RootNamespace>
    <!-- Mirrors src-tauri/tauri.conf.json and src-tauri/Cargo.toml — bump all three together.
         GetHealth() in SystemEndpoints.cs reads this at runtime rather than hardcoding a string,
         so the status bar version can't silently drift from the app version again. -->
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\SwebKit.Core\SwebKit.Core.csproj" />
    <ProjectReference Include="..\src\SwebKit.DevOps\SwebKit.DevOps.csproj" />
    <ProjectReference Include="..\src\SwebKit.Azure\SwebKit.Azure.csproj" />
    <ProjectReference Include="..\src\SwebKit.Kubernetes\SwebKit.Kubernetes.csproj" />
    <ProjectReference Include="..\src\SwebKit.Redis\SwebKit.Redis.csproj" />
    <ProjectReference Include="..\src\SwebKit.Agents\SwebKit.Agents.csproj" />
    <ProjectReference Include="..\src\SwebKit.Observability\SwebKit.Observability.csproj" />
    <PackageReference Include="keyring-dotnet" />
  </ItemGroup>
  <!--
    SwebKit.Observability was dropped from the Tauri rewrite as a *browsing UI* (product decision,
    2026-07-26). SwebKit.DevOps/Pipelines was also excluded as a generic browsing UI, but the focused
    Release Train Cockpit feature (2026-08-07) now reuses SwebKit.DevOps for release-train workflow
    support only — not a MAUI pipeline browser port.
  -->

</Project>
